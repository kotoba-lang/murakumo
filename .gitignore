.cpcache/
.DS_Store
__pycache__/
*.pyc
*.log
;; npm deps for the nbb overlay files (witness_dial.cljs etc.) -- see
;; package.json. package-lock.json IS tracked (reproducible installs).
/node_modules/
/store/
/.murakumo/
;; The pinned binaries are large and machine-built — never commit them. But the
;; BUILD.edn manifest IS tracked: it pins the fleet's expected kotoba version
;; (git sha / version / features), so the binary is distributed separately while
;; "which version the fleet runs" stays auditable in git.
/bin/*
!/bin/BUILD.edn
.murakumo-peers.edn
;; local operational state (which nodes are kekkai-authorized) — see
;; kekkai-tailnet.edn.example for the tracked template.
/kekkai-tailnet.edn
murakumo-*.png
.murakumo-infer-runs.edn

;; per-operator task-run history (append-only, machine-local — `task report` reads it)
.murakumo-task-ledger.edn

# nbb dependency cache (jars + an embedded git checkout) — build output, not source
.nbb/

;; `amu compile --target js` の perf 成果物（.perf.mjs と、その inputs /
;; manifest / provenance サイドカー）。source は kotoba/*.kotoba の方で、
;; これは機械が吐いた出力。一度も commit されたことが無いのに untracked と
;; して残り続け、cleanup の走査のたびに「未着地の新規ファイル」として
;; 着地候補に上がっていた（2026-08-18 実測、5 件）。
/kotoba/*.perf.mjs
/kotoba/*.perf.mjs.*
