(ns murakumo.engine.profile
  (:require [murakumo.engine.base :as b]))

;; Model profiles (docs/engine-profiles.md): built from the GGUF at load time, refused outside the envelope the
;; kernels support. A profile is a vector: 24 slots per layer, then globals.
;;   slot 0 attn_norm  1 post-attention (FFN) norm  2 kind (0 Gated DeltaNet, 1 gated full attention)  3 ordinal of
;;   the layer among its kind (its conv/state or KV-cache slot)  4/5 ffn_gate off/dtype  6/7 ffn_up  8/9 ffn_down
;;   DeltaNet: 10/11 attn_qkv  12/13 attn_gate (z)  14/15 ssm_alpha  16/17 ssm_beta  18 ssm_conv1d  19 ssm_a
;;             20 ssm_dt.bias  21 ssm_norm  22/23 ssm_out
;;   attention: 10/11 attn_q (q | gate)  12/13 attn_k  14/15 attn_v  16 attn_q_norm  17 attn_k_norm  22/23 attn_output
;;   globals (gbase): +0/+1 token_embd off/dtype  +2 output_norm  +3 epsilon bits  +4 rope base bits  +5 layers
;;   +6 vocabulary
;; Offsets are data-region byte offsets; dtypes are the file's own (a Q4_K_M file mixes them per tensor).

(defn slots [] :i64 24)
(defn ps [l :i64 s :i64] :i64 (+ (* l 24) s))

;; the qwen35 envelope this library runs: Qwen3.5-4B's dims
(defn q35-layers [] :i64 32)
(defn q35-vocab [] :i64 248320)
(defn gbase [] :i64 (* (q35-layers) 24))

(defn- need-u32 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 KI :vector-i64 nk :i64 key :string want :i64] :i64
  (if (= (b/kv-u32 f R p KI nk key 4) want) 0
    (let [w (b/wr-text f R (string-concat "refused: " (string-concat key (string-concat " is not " (string-concat (string-from-i64 want) "\n")))))]
      (vector-at [0] 1))))

(defn- put-q [P :vector-i64 i :i64 od :vector-i64] :i64
  (let [a (vector-assoc! P i (vector-at od 0)) c (vector-assoc! P (+ i 1) (vector-at od 1))] 0))

;; the profile of a qwen35 file; refuses another architecture, other dims, or a tensor of another shape, dtype or span
(defn qwen35 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 KI :vector-i64 nk :i64 TI :vector-i64 nt :i64 dlen :i64] :vector-i64
  (let [arch (b/kv-str-is f R p KI nk "general.architecture" "qwen35")
        u0 (if (= arch 1) 0 (let [w (b/wr-text f R "refused: general.architecture is not qwen35\n")] (vector-at [0] 1)))
        c0 (need-u32 f R p KI nk "qwen35.block_count" (q35-layers))
        c1 (need-u32 f R p KI nk "qwen35.embedding_length" 2560)
        c2 (need-u32 f R p KI nk "qwen35.feed_forward_length" 9216)
        c3 (need-u32 f R p KI nk "qwen35.attention.head_count" 16)
        c4 (need-u32 f R p KI nk "qwen35.attention.head_count_kv" 4)
        c5 (need-u32 f R p KI nk "qwen35.attention.key_length" 256)
        c6 (need-u32 f R p KI nk "qwen35.attention.value_length" 256)
        c7 (need-u32 f R p KI nk "qwen35.rope.dimension_count" 64)
        c8 (need-u32 f R p KI nk "qwen35.ssm.conv_kernel" 4)
        c9 (need-u32 f R p KI nk "qwen35.ssm.state_size" 128)
        c10 (need-u32 f R p KI nk "qwen35.ssm.group_count" 16)
        c11 (need-u32 f R p KI nk "qwen35.ssm.time_step_rank" 32)
        c12 (need-u32 f R p KI nk "qwen35.ssm.inner_size" 4096)
        c13 (need-u32 f R p KI nk "qwen35.full_attention_interval" 4)
        eps (b/kv-u32 f R p KI nk "qwen35.attention.layer_norm_rms_epsilon" 6)
        base (b/kv-u32 f R p KI nk "qwen35.rope.freq_base" 6)
        P (vector-alloc (+ (gbase) 8))
        lf (loop [l 0 na 0 nd 0]
             (if (= l (q35-layers)) 0
               (let [pre (string-concat "blk." (string-concat (string-from-i64 l) "."))
                     att (if (= (rem (+ l 1) 4) 0) 1 0)
                     i (ps l 0)
                     a0 (vector-assoc! P i (b/t-find f R p TI nt (string-concat pre "attn_norm.weight") 0 2560 1 dlen))
                     a1 (vector-assoc! P (+ i 1) (b/t-find f R p TI nt (string-concat pre "post_attention_norm.weight") 0 2560 1 dlen))
                     a2 (vector-assoc! P (+ i 2) att)
                     a3 (vector-assoc! P (+ i 3) (if (= att 1) na nd))
                     a4 (put-q P (+ i 4) (b/t-quant f R p TI nt (string-concat pre "ffn_gate.weight") 2560 9216 dlen))
                     a6 (put-q P (+ i 6) (b/t-quant f R p TI nt (string-concat pre "ffn_up.weight") 2560 9216 dlen))
                     a8 (put-q P (+ i 8) (b/t-quant f R p TI nt (string-concat pre "ffn_down.weight") 9216 2560 dlen))
                     body (if (= att 1)
                            (let [q (put-q P (+ i 10) (b/t-quant f R p TI nt (string-concat pre "attn_q.weight") 2560 8192 dlen))
                                  k (put-q P (+ i 12) (b/t-quant f R p TI nt (string-concat pre "attn_k.weight") 2560 1024 dlen))
                                  v (put-q P (+ i 14) (b/t-quant f R p TI nt (string-concat pre "attn_v.weight") 2560 1024 dlen))
                                  qn (vector-assoc! P (+ i 16) (b/t-find f R p TI nt (string-concat pre "attn_q_norm.weight") 0 256 1 dlen))
                                  kn (vector-assoc! P (+ i 17) (b/t-find f R p TI nt (string-concat pre "attn_k_norm.weight") 0 256 1 dlen))
                                  o (put-q P (+ i 22) (b/t-quant f R p TI nt (string-concat pre "attn_output.weight") 4096 2560 dlen))]
                              0)
                            (let [q (put-q P (+ i 10) (b/t-quant f R p TI nt (string-concat pre "attn_qkv.weight") 2560 8192 dlen))
                                  z (put-q P (+ i 12) (b/t-quant f R p TI nt (string-concat pre "attn_gate.weight") 2560 4096 dlen))
                                  al (put-q P (+ i 14) (b/t-quant f R p TI nt (string-concat pre "ssm_alpha.weight") 2560 32 dlen))
                                  be (put-q P (+ i 16) (b/t-quant f R p TI nt (string-concat pre "ssm_beta.weight") 2560 32 dlen))
                                  cv (vector-assoc! P (+ i 18) (b/t-find f R p TI nt (string-concat pre "ssm_conv1d.weight") 0 4 8192 dlen))
                                  sa (vector-assoc! P (+ i 19) (b/t-find f R p TI nt (string-concat pre "ssm_a") 0 32 1 dlen))
                                  dt (vector-assoc! P (+ i 20) (b/t-find f R p TI nt (string-concat pre "ssm_dt.bias") 0 32 1 dlen))
                                  sn (vector-assoc! P (+ i 21) (b/t-find f R p TI nt (string-concat pre "ssm_norm.weight") 0 128 1 dlen))
                                  o (put-q P (+ i 22) (b/t-quant f R p TI nt (string-concat pre "ssm_out.weight") 4096 2560 dlen))]
                              0))]
                 (recur (+ l 1) (+ na att) (+ nd (- 1 att))))))
        g (gbase)
        e0 (put-q P g (b/t-quant f R p TI nt "token_embd.weight" 2560 (q35-vocab) dlen))
        e2 (vector-assoc! P (+ g 2) (b/t-find f R p TI nt "output_norm.weight" 0 2560 1 dlen))
        e3 (vector-assoc! P (+ g 3) eps)
        e4 (vector-assoc! P (+ g 4) base)
        e5 (vector-assoc! P (+ g 5) (q35-layers))
        e6 (vector-assoc! P (+ g 6) (q35-vocab))]
    P))
