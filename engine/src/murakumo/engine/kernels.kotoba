(ns murakumo.engine.kernels
  (:require [murakumo.engine.kernels.quant :as quant]
            [murakumo.engine.kernels.norm :as norm]
            [murakumo.engine.kernels.deltanet :as dnet]
            [murakumo.engine.kernels.attn :as attn]
            [murakumo.engine.kernels.head :as head]
            [murakumo.engine.kernels.dflash :as dflash]))

;; The kernel library: one MSL source of every kernel the plans use, and the pipeline order (kernel ids):
;;   0..3 mv_q8_0 mvk_q4_k mvk_q5_k mv_q6_k  4..7 emb_q8_0 emb_q4_k emb_q5_k emb_q6_k  8 rms1  9 swiglu
;;   10 dnf (fused Gated DeltaNet)  11 qkr  12 attd  13 argmax  14..17 mv2_q8_0 mvk2_q4_k mvk2_q5_k mv2_q6_k (two tokens)
;;   18 mv_bf16  19 mv2_bf16  20 bfq8 (BF16 rows to Q8_0, at load)
;;   21..25 mm_q8_0 mm_q4_k mm_q5_k mm_q6_k mm_bf16 (up to 16 tokens, simdgroup matrices)  26 dnfn (Gated DeltaNet over
;;   the tokens of a pass)  27 mmr (adds mm's k-split partial sums)  28 dnr (replays dnfn's saved delta-rule inputs)
;;   29 cpy  30 qkn (Qwen3 q/k norm + RoPE)  31 attb (block attention): the DFlash drafter
;;   32..35 mm8_q8_0 mm8_q4_k mm8_q5_k mm8_q6_k (up to 8 tokens)
;; Every kernel takes (W bytes, A floats, P sixteen uints).
(defn header [] :string
  "#include <metal_stdlib>
using namespace metal;
#define FU _Pragma(\"clang loop unroll(full)\")
struct P { uint a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, q; };
")

(defn source [] :string
  (string-concat (header) (string-concat (quant/source) (string-concat (norm/source)
    (string-concat (dnet/source) (string-concat (attn/source) (string-concat (head/source) (dflash/source))))))))

(defn k-rms1 [] :i64 8)
(defn k-swiglu [] :i64 9)
(defn k-dnf [] :i64 10)
(defn k-qkr [] :i64 11)
(defn k-attd [] :i64 12)
(defn k-argmax [] :i64 13)
(defn k-mv [dt :i64] :i64 (quant/mv-id dt))
(defn k-emb [dt :i64] :i64 (quant/emb-id dt))
(defn k-mv2 [dt :i64] :i64 (quant/mv2-id dt))
(defn k-bfq8 [] :i64 20)
(defn k-mm [dt :i64 n :i64] :i64 (quant/mm-idn dt n))
(defn k-dnfn [] :i64 26)
(defn k-mmr [] :i64 27)
(defn k-dnr [] :i64 28)
(defn k-cpy [] :i64 29)
(defn k-qkn [] :i64 30)
(defn k-attb [] :i64 31)
