(ns murakumo.engine.kernels.deltanet)

;; Gated DeltaNet layer kernel (decode, one token): the causal depthwise conv1d with its 3-step state, the delta-rule
;; state update and readout, and the gated RMSNorm, fused into one threadgroup per value head. Layout as the qwen35
;; GGUF stores it (bench/results/2026-11-15-qwen35-oracle): q | k | v channels, 16 key heads of 128, 32 value heads
;; of 128 tiled onto the key heads (key head = value head mod 16).
(defn source [] :string
  "
// one 1024-thread threadgroup per value head hv: a ssm_a off (F32 [32] in W, = -exp(A_log)), b dt bias off (F32 [32] in
// W), c conv weight off (F32 [8192][4] in W), d alpha off (32 floats, then beta 32), e state off (32 x 128 x 128,
// [hv][dv][dk], read), f y off (32 x 128), g conv state read off, h conv state write off (3 floats per channel, oldest first;
// separate slots, so the value heads hv and hv + 16 that read the same key head's q and k channels never see the
// other's write), i gated-norm weight off (F32 [128] in W), j z off, k gated-norm epsilon bits, l q|k|v
// projection off, m state write off (the read and write states are separate slots, so a rejected draft token's
// state is never written over the one before it).
// 1. conv: threads 0..383 take the head's q, k (key head) and v (value head) channels: out = silu(w0 s0 + w1 s1 +
//    w2 s2 + w3 x), the state shifts in x (q and k states are written by the value head below 16 only).
// 2. q and k are RMS-normalised per head (eps 1e-6) and scaled by 1/128 and 1/sqrt(128).
// 3. delta rule: simdgroup s takes dv rows 4 s .. 4 s + 3; lane l holds dk 4l .. 4l+3.
// 4. gated RMSNorm of the head's 128 outputs: y = rms(y) * w * silu(z).
kernel void dnf(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                uint hv [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  threadgroup float4 tq[32], tk[32], tv[32], ty[32];
  threadgroup float red[4];
  uint hk = hv % 16;
  if (t < 384) {
    uint part = t / 128, i = t % 128;
    uint c = part == 0 ? hk * 128 + i : (part == 1 ? 2048 + hk * 128 + i : 4096 + hv * 128 + i);
    device const float *w = (device const float *)(W + p.c) + c * 4;
    device const float *s = A + p.g + c * 3;
    float x = A[p.l + c];
    float o = w[0] * s[0] + w[1] * s[1] + w[2] * s[2] + w[3] * x;
    if (part == 2 || hv < 16) { device float *n = A + p.h + c * 3; n[0] = s[1]; n[1] = s[2]; n[2] = x; }
    o = o / (1.0f + precise::exp(-o));
    threadgroup float *dst = (threadgroup float *)(part == 0 ? tq : (part == 1 ? tk : tv));
    dst[i] = o;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (sg < 2) {
    float4 v = sg == 0 ? tq[ln] : tk[ln];
    float n = simd_sum(dot(v, v));
    if (ln == 0) red[sg] = n;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float4 q = tq[ln] * ((1.0f / precise::sqrt(red[0] / 128.0f + 1e-6f)) * (1.0f / 128.0f));
  float4 k = tk[ln] * ((1.0f / precise::sqrt(red[1] / 128.0f + 1e-6f)) * (1.0f / precise::sqrt(128.0f)));
  float al = A[p.d + hv] + ((device const float *)(W + p.b))[hv];
  float sp = al > 20.0f ? al : precise::log(1.0f + precise::exp(al));
  float g = precise::exp(((device const float *)(W + p.a))[hv] * sp);
  float beta = 1.0f / (1.0f + precise::exp(-A[p.d + 32 + hv]));
  FU for (uint r = 0; r < 4; r++) {
    uint dv = sg * 4 + r;
    uint so = (hv * 128 + dv) * 128 + ln * 4;
    float4 s = *(device const float4 *)(A + p.e + so) * g;
    float kvm = simd_sum(dot(s, k));
    float delta = (((threadgroup float *)tv)[dv] - kvm) * beta;
    s += k * delta;
    *(device float4 *)(A + p.m + so) = s;
    float y = simd_sum(dot(s, q));
    if (ln == 0) ((threadgroup float *)ty)[dv] = y;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (sg == 0) {
    float4 v = ty[ln];
    float n = simd_sum(dot(v, v));
    if (ln == 0) red[2] = n;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (t < 128) {
    float r = 1.0f / precise::sqrt(red[2] / 128.0f + as_type<float>(p.k));
    float w = ((device const float *)(W + p.i))[t];
    float z = A[p.j + hv * 128 + t];
    A[p.f + hv * 128 + t] = ((threadgroup float *)ty)[t] * r * w * (z / (1.0f + exp(-z)));
  }
}
// dnf for n tokens in one dispatch: the conv window and the delta-rule state stay in registers across the tokens, so
// the state is read once (slot e, conv g) and written once after the last token (slot m, conv h; the write slots must
// differ from the read ones). Fields as dnf, plus n the token stride (token j's d, f, j, l at + j n) and o the token
// count (low 8 bits; bits 8 .. 15: a branch length l > 0 makes every l-th token start again from the read state and
// window, for a pass of branches from the same position), q the save area (0: none; else token j's inputs of the delta rule at q + 16448 j: q [16][128] | k [16][128]
// | v [32][128] | g [32] | beta [32] | the conv input x [8192], which dnr replays). 512 threads (the state held across the tokens needs the registers of two 1024-thread lanes): simdgroup s
// takes dv rows 8 s .. 8 s + 7.
kernel void dnfn(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                 uint hv [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                 uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  threadgroup float4 tq[32], tk[32], tv[32], ty[32];
  threadgroup float red[4];
  uint hk = hv % 16;
  uint part = t / 128, i = t % 128;
  uint c = part == 0 ? hk * 128 + i : (part == 1 ? 2048 + hk * 128 + i : 4096 + hv * 128 + i);
  // the conv weights and the norm weight are reloaded per token (from cache) so the kernel fits 1024 threads
  device const float *w = (device const float *)(W + p.c) + c * 4;
  float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f;
  if (t < 384) {
    device const float *s = A + p.g + c * 3;
    s0 = s[0]; s1 = s[1]; s2 = s[2];
  }
  float4 st[8];
  FU for (uint r = 0; r < 8; r++) st[r] = *(device const float4 *)(A + p.e + (hv * 128 + sg * 8 + r) * 128 + ln * 4);
  uint cnt = p.o & 255u, bl = p.o >> 8;
  for (uint j = 0; j < cnt; j++) {
    uint jo = j * p.n;
    if (bl > 0u && j > 0u && j % bl == 0u) {
      FU for (uint r = 0; r < 8; r++) st[r] = *(device const float4 *)(A + p.e + (hv * 128 + sg * 8 + r) * 128 + ln * 4);
      if (t < 384) { device const float *s = A + p.g + c * 3; s0 = s[0]; s1 = s[1]; s2 = s[2]; }
    }
    if (t < 384) {
      float x = A[p.l + jo + c];
      if (p.q != 0 && (part == 2 || hv < 16)) A[p.q + j * 16448 + 8256 + c] = x;
      float o = w[0] * s0 + w[1] * s1 + w[2] * s2 + w[3] * x;
      s0 = s1; s1 = s2; s2 = x;
      o = o / (1.0f + precise::exp(-o));
      threadgroup float *dst = (threadgroup float *)(part == 0 ? tq : (part == 1 ? tk : tv));
      dst[i] = o;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sg < 2) {
      float4 v = sg == 0 ? tq[ln] : tk[ln];
      float n = simd_sum(dot(v, v));
      if (ln == 0) red[sg] = n;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float4 q = tq[ln] * ((1.0f / precise::sqrt(red[0] / 128.0f + 1e-6f)) * (1.0f / 128.0f));
    float4 k = tk[ln] * ((1.0f / precise::sqrt(red[1] / 128.0f + 1e-6f)) * (1.0f / precise::sqrt(128.0f)));
    float al = A[p.d + jo + hv] + ((device const float *)(W + p.b))[hv];
    float sp = al > 20.0f ? al : precise::log(1.0f + precise::exp(al));
    float g = precise::exp(((device const float *)(W + p.a))[hv] * sp);
    float beta = 1.0f / (1.0f + precise::exp(-A[p.d + jo + 32 + hv]));
    if (p.q != 0) {
      device float *sv = A + p.q + j * 16448;
      if (sg == 0 && hv < 16) { *(device float4 *)(sv + hk * 128 + ln * 4) = q; *(device float4 *)(sv + 2048 + hk * 128 + ln * 4) = k; }
      if (t < 128) sv[4096 + hv * 128 + t] = ((threadgroup float *)tv)[t];
      if (t == 0) { sv[8192 + hv] = g; sv[8224 + hv] = beta; }
    }
    FU for (uint r = 0; r < 8; r++) {
      uint dv = sg * 8 + r;
      float4 s = st[r] * g;
      float kvm = simd_sum(dot(s, k));
      float delta = (((threadgroup float *)tv)[dv] - kvm) * beta;
      s += k * delta;
      st[r] = s;
      float y = simd_sum(dot(s, q));
      if (ln == 0) ((threadgroup float *)ty)[dv] = y;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sg == 0) {
      float4 v = ty[ln];
      float n = simd_sum(dot(v, v));
      if (ln == 0) red[2] = n;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (t < 128) {
      float r = 1.0f / precise::sqrt(red[2] / 128.0f + as_type<float>(p.k));
      float z = A[p.j + jo + hv * 128 + t];
      A[p.f + jo + hv * 128 + t] = ((threadgroup float *)ty)[t] * r * ((device const float *)(W + p.i))[t] * (z / (1.0f + exp(-z)));
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  FU for (uint r = 0; r < 8; r++) *(device float4 *)(A + p.m + (hv * 128 + sg * 8 + r) * 128 + ln * 4) = st[r];
  if (t < 384 && (part == 2 || hv < 16)) { device float *n = A + p.h + c * 3; n[0] = s0; n[1] = s1; n[2] = s2; }
}

// replay of the first o tokens a dnfn pass saved (q: its save area): the delta-rule state from slot e (the one that
// pass read) is advanced over them with the same arithmetic and written to slot m; the conv window from g, shifted
// over their inputs, to h. A drafted block whose first o tokens are accepted leaves the state after them.
kernel void dnr(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                uint hv [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  uint hk = hv % 16;
  float4 st[8];
  FU for (uint r = 0; r < 8; r++) st[r] = *(device const float4 *)(A + p.e + (hv * 128 + sg * 8 + r) * 128 + ln * 4);
  for (uint j = 0; j < p.o; j++) {
    device const float *sv = A + p.q + j * 16448;
    float4 k = *(device const float4 *)(sv + 2048 + hk * 128 + ln * 4);
    float g = sv[8192 + hv], beta = sv[8224 + hv];
    FU for (uint r = 0; r < 8; r++) {
      uint dv = sg * 8 + r;
      float4 s = st[r] * g;
      float kvm = simd_sum(dot(s, k));
      float delta = (sv[4096 + hv * 128 + dv] - kvm) * beta;
      s += k * delta;
      st[r] = s;
    }
  }
  FU for (uint r = 0; r < 8; r++) *(device float4 *)(A + p.m + (hv * 128 + sg * 8 + r) * 128 + ln * 4) = st[r];
  uint part = t / 128, i = t % 128;
  if (t < 384 && (part == 2 || hv < 16)) {
    uint c = part == 0 ? hk * 128 + i : (part == 1 ? 2048 + hk * 128 + i : 4096 + hv * 128 + i);
    device const float *s = A + p.g + c * 3;
    float s0 = s[0], s1 = s[1], s2 = s[2];
    for (uint j = 0; j < p.o; j++) { s0 = s1; s1 = s2; s2 = A[p.q + j * 16448 + 8256 + c]; }
    device float *n = A + p.h + c * 3; n[0] = s0; n[1] = s1; n[2] = s2;
  }
}
")