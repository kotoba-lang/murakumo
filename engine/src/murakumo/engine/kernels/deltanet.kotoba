(ns murakumo.engine.kernels.deltanet)

;; Gated DeltaNet layer kernel (decode, one token): the causal depthwise conv1d with its 3-step state, the delta-rule
;; state update and readout, and the gated RMSNorm, fused into one threadgroup per value head. Layout as the qwen35
;; GGUF stores it (bench/results/2026-11-15-qwen35-oracle): q | k | v channels, 16 key heads of 128, 32 value heads
;; of 128 tiled onto the key heads (key head = value head mod 16).
(defn source [] :string
  "
// one 1024-thread threadgroup per value head hv: a ssm_a off (F32 [32] in W, = -exp(A_log)), b dt bias off (F32 [32] in
// W), c conv weight off (F32 [8192][4] in W), d alpha off (32 floats, then beta 32), e state off (32 x 128 x 128,
// [hv][dv][dk]), f y off (32 x 128), g conv state read off, h conv state write off (3 floats per channel, oldest first;
// the two copies swap every token, so the value heads hv and hv + 16 that read the same key head's q and k channels
// never see the other's write), i gated-norm weight off (F32 [128] in W), j z off, k gated-norm epsilon bits, l q|k|v
// projection off.
// 1. conv: threads 0..383 take the head's q, k (key head) and v (value head) channels: out = silu(w0 s0 + w1 s1 +
//    w2 s2 + w3 x), the state shifts in x (q and k states are written by the value head below 16 only).
// 2. q and k are RMS-normalised per head (eps 1e-6) and scaled by 1/128 and 1/sqrt(128).
// 3. delta rule: simdgroup s takes dv rows 4 s .. 4 s + 3; lane l holds dk 4l .. 4l+3.
// 4. gated RMSNorm of the head's 128 outputs: y = rms(y) * w * silu(z).
kernel void dnf(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                uint hv [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  threadgroup float4 tq[32], tk[32], tv[32], ty[32];
  threadgroup float red[4];
  uint hk = hv % 16;
  if (t < 384) {
    uint part = t / 128, i = t % 128;
    uint c = part == 0 ? hk * 128 + i : (part == 1 ? 2048 + hk * 128 + i : 4096 + hv * 128 + i);
    device const float *w = (device const float *)(W + p.c) + c * 4;
    device const float *s = A + p.g + c * 3;
    float x = A[p.l + c];
    float o = w[0] * s[0] + w[1] * s[1] + w[2] * s[2] + w[3] * x;
    if (part == 2 || hv < 16) { device float *n = A + p.h + c * 3; n[0] = s[1]; n[1] = s[2]; n[2] = x; }
    o = o / (1.0f + precise::exp(-o));
    threadgroup float *dst = (threadgroup float *)(part == 0 ? tq : (part == 1 ? tk : tv));
    dst[i] = o;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (sg < 2) {
    float4 v = sg == 0 ? tq[ln] : tk[ln];
    float n = simd_sum(dot(v, v));
    if (ln == 0) red[sg] = n;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float4 q = tq[ln] * ((1.0f / precise::sqrt(red[0] / 128.0f + 1e-6f)) * (1.0f / 128.0f));
  float4 k = tk[ln] * ((1.0f / precise::sqrt(red[1] / 128.0f + 1e-6f)) * (1.0f / precise::sqrt(128.0f)));
  float al = A[p.d + hv] + ((device const float *)(W + p.b))[hv];
  float sp = al > 20.0f ? al : precise::log(1.0f + precise::exp(al));
  float g = precise::exp(((device const float *)(W + p.a))[hv] * sp);
  float beta = 1.0f / (1.0f + precise::exp(-A[p.d + 32 + hv]));
  FU for (uint r = 0; r < 4; r++) {
    uint dv = sg * 4 + r;
    device float4 *S = (device float4 *)(A + p.e + (hv * 128 + dv) * 128 + ln * 4);
    float4 s = *S * g;
    float kvm = simd_sum(dot(s, k));
    float delta = (((threadgroup float *)tv)[dv] - kvm) * beta;
    s += k * delta;
    *S = s;
    float y = simd_sum(dot(s, q));
    if (ln == 0) ((threadgroup float *)ty)[dv] = y;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (sg == 0) {
    float4 v = ty[ln];
    float n = simd_sum(dot(v, v));
    if (ln == 0) red[2] = n;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (t < 128) {
    float r = 1.0f / precise::sqrt(red[2] / 128.0f + as_type<float>(p.k));
    float w = ((device const float *)(W + p.i))[t];
    float z = A[p.j + hv * 128 + t];
    A[p.f + hv * 128 + t] = ((threadgroup float *)ty)[t] * r * w * (z / (1.0f + exp(-z)));
  }
}
")
