(ns murakumo.engine.model.qwen35
  (:require [murakumo.engine.base :as b]
            [murakumo.engine.metal :as m]
            [murakumo.engine.kernels :as k]
            [murakumo.engine.profile :as pr]))

;; Qwen3.5 (qwen35) on the Metal route, decode one token per command buffer (AWAI-2938 slice 2/3): the step encoder
;; walks the profile's layers and picks each matvec's kernel from that tensor's dtype (docs/engine-profiles.md).
;; Gated DeltaNet layer: RMSNorm; q|k|v, z, alpha, beta matvecs; one fused kernel per value head (conv1d + SiLU with
;; its state, delta rule, gated RMSNorm); out matvec into the residual. Gated attention layer: RMSNorm; q|gate, k, v matvecs; q/k norm + RoPE + KV
;; store; attention times sigmoid(gate); output matvec into the residual. Then RMSNorm, gate and up matvecs, SwiGLU,
;; down matvec into the residual. Final RMSNorm, the tied head over the embedding table, argmax.

;; arena A offsets (floats; every one a multiple of 4). oX .. oLG are token 0's activations; token j of a multi-token
;; pass has its own copy at + j (ts).
(defn oX [] :i64 0)
(defn oH [] :i64 2560)
(defn oQ [] :i64 5120)
(defn oZ [] :i64 13312)
(defn oAB [] :i64 17408)
(defn oCO [] :i64 17472)
(defn oY [] :i64 25664)
(defn oK [] :i64 29760)
(defn oV [] :i64 30784)
(defn oFG [] :i64 31808)
(defn oFU [] :i64 41024)
(defn oG2 [] :i64 50240)
(defn oLG [] :i64 59456)
;; the main model's hidden rows after layers 1, 5, .., 29 (8 x 2560), the DFlash drafter's input
(defn oCT [] :i64 307776)
;; one token's activations
(defn ts [] :i64 328256)
;; tokens a pass takes at most
(defn nb [] :i64 16)
;; argmax words (token j's at + j; 32 words), then the position log
(defn oTOK [] :i64 5252096)
(defn oLOG [] :i64 5252128)
(defn oKC [] :i64 5253152)
(defn oVC [] :i64 9447456)
;; the recurrent states in three slots: a pass of n tokens reads slot c and writes c + 1 .. c + n (mod 3), so the
;; state after every token of the pass survives it (the caller keeps the slot of the last accepted token)
(defn oCONV [s :i64] :i64 (+ 13641760 (* s 589824)))
(defn oSSM [s :i64] :i64 (+ 15411232 (* s 12582912)))
;; the MTP head's activations (two rows, row j at + j (ts), the layout of a token's) and its KV cache ([pos][1024])
(defn oM [] :i64 53159968)
(defn oMK [] :i64 53816480)
(defn oMV [] :i64 54340768)
;; mm's k-split partial sums: four regions (one per matvec of a group) of 327680 floats
(defn oPS [] :i64 54865056)
;; the DFlash drafter's KV caches (6 layers of [pos][1024]) and the delta-rule inputs a verify pass saves for replay
;; (24 delta-net layers x 16 tokens x 16448)
(defn oDK [] :i64 56175776)
(defn oDV [] :i64 59321504)
(defn oSV [] :i64 62467232)
(defn arena-floats [] :i64 68783264)
;; the argmax word of the MTP head's draft (oTOK + 16)
(defn wD [] :i64 16)
;; positions the KV cache and the position log hold
(defn tmax [] :i64 512)

;; the parameter vector padded to the 16 words of struct P
(defn p16 [v :vector-i64] :vector-i64
  (let [o (vector-alloc 16)
        u (loop [i 0] (if (= i 16) 0 (let [w (vector-assoc! o i (if (< i (vector-count v)) (vector-at v i) 0))] (recur (+ i 1)))))]
    o))

(defn- d [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 kid :i64 pv :vector-i64 gx :i64 tx :i64] :i64
  (m/disp f R en X PL kid (p16 pv) gx tx))

;; d over a grid of gx x gy threadgroups (gy: the tokens of a pass)
(defn- dy [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 kid :i64 pv :vector-i64 gx :i64 gy :i64 tx :i64] :i64
  (m/disp-y f R en X PL kid (p16 pv) gx gy tx))

;; Y (rows) = W X (cols) for the n tokens of the pass with the kernel for dtype dt; add 1 adds into Y
;; Threadgroups of 4 simdgroups, each simdgroup 4 rows over the whole row (no threadgroup reduction); Q8_0 and Q6_K
;; rows longer than 12 steps of 256 values are split between 2 simdgroups (ks). Q4_K and Q5_K use mvk (16-byte loads).
;; Two tokens read the weights once (the mv2 kernels); three or more use simdgroup matrices (mm: 64 rows per
;; threadgroup, up to 16 tokens).
(defn- mv [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 woff :i64 dt :i64 rows :i64 cols :i64 xo :i64 yo :i64 add :i64 n :i64] :i64
  (if (> n 2)
    (d f R en X PL (k/k-mm dt n) (vector-i64 woff rows cols n (if (= add 1) 2 0) xo yo (ts) 1 0) (quot (+ rows 63) 64) 128)
    (let [ks (if (or (= dt 12) (= dt 13) (<= cols 3072)) 1 2) rpt (* 4 (quot 4 ks))]
      (d f R en X PL (if (= n 1) (k/k-mv dt) (k/k-mv2 dt)) (vector-i64 woff rows cols ks (if (= add 1) 2 0) xo yo (ts)) (quot (+ rows (- rpt 1)) rpt) 128))))

;; a barrier in a concurrent encoder
(defn- bar [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64] :i64 (m/barrier! f R en))

;; k splits of a multi-token matvec: enough 64-row threadgroups to fill the GPU (about 256), each split at least 4
;; steps of 64 values
(defn- ksplit [rows :i64 cols :i64] :i64
  (let [tiles (quot (+ rows 63) 64) a (quot (quot cols 64) 4) b (quot (+ 255 tiles) tiles) s (if (< a b) a b)]
    (if (< s 1) 1 s)))

;; a group of matvecs that read the same activations (spec k: weight off, dtype, rows, cols, x off, y off, add at
;; 7 k ..), then a barrier. Over two tokens each matvec is split along k into partial region k (oPS) and the partials
;; are added up after the barrier (then another barrier).
(defn- grp! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 sp :vector-i64 n :i64] :i64
  (let [nm (quot (vector-count sp) 7)
        a (loop [i 0] (if (= i nm) 0
            (let [o (* 7 i) dt (vector-at sp (+ o 1)) rows (vector-at sp (+ o 2)) cols (vector-at sp (+ o 3)) ks (ksplit rows cols)
                  ov (if (> (* ks (* 16 rows)) 327680) (let [w (b/wr-text f R "refused: k-split partials exceed their region\n")] (vector-at [0] 1)) 0)
                  u (if (and (> n 2) (> ks 1))
                      (dy f R en X PL (k/k-mm dt n) (vector-i64 (vector-at sp o) rows cols n 0 (vector-at sp (+ o 4)) 0 (ts) ks (+ (oPS) (* i 327680))) (quot (+ rows 63) 64) ks 128)
                      (mv f R en X PL (vector-at sp o) dt rows cols (vector-at sp (+ o 4)) (vector-at sp (+ o 5)) (vector-at sp (+ o 6)) n))]
              (recur (+ i 1)))))
        b (bar f R en)]
    (if (<= n 2) 0
      (let [c (loop [i 0] (if (= i nm) 0
                (let [o (* 7 i) rows (vector-at sp (+ o 2)) ks (ksplit rows (vector-at sp (+ o 3)))
                      u (if (> ks 1)
                          (dy f R en X PL (k/k-mmr) (vector-i64 0 rows 0 n (if (= (vector-at sp (+ o 6)) 1) 2 0) 0 (vector-at sp (+ o 5)) (ts) ks (+ (oPS) (* i 327680))) (quot (+ rows 255) 256) n 256)
                          0)]
                  (recur (+ i 1)))))]
        (bar f R en)))))

;; RMSNorm of each token's row
(defn- rms [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 w :i64 xo :i64 yo :i64 eps :i64 n :i64] :i64
  (dy f R en X PL (k/k-rms1) (vector-i64 w (ts) 2560 0 0 xo yo eps) 1 n 1024))

;; cap 1 copies the residual rows after layers 1, 5, .., 29 into oCT (the DFlash drafter's input); sv 1 makes the
;; multi-token delta net save its inputs for replay (oSV)
(defn- layer! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 P :vector-i64 l :i64 pos :i64 n :i64 slot :i64 cap :i64 sv :i64] :i64
  (let [g (pr/gbase)
        eps (vector-at P (+ g 3))
        base (vector-at P (+ g 4))
        ord (vector-at P (pr/ps l 3))
        r1 (rms f R en X PL (vector-at P (pr/ps l 0)) (oX) (oH) eps n)
        b1 (bar f R en)
        body (if (= (vector-at P (pr/ps l 2)) 0)
               (let [b2 (grp! f R en X PL (vector-i64 (vector-at P (pr/ps l 10)) (vector-at P (pr/ps l 11)) 8192 2560 (oH) (oQ) 0
                                                     (vector-at P (pr/ps l 12)) (vector-at P (pr/ps l 13)) 4096 2560 (oH) (oZ) 0
                                                     (vector-at P (pr/ps l 14)) (vector-at P (pr/ps l 15)) 32 2560 (oH) (oAB) 0
                                                     (vector-at P (pr/ps l 16)) (vector-at P (pr/ps l 17)) 32 2560 (oH) (+ (oAB) 32) 0) n)
                     ;; one or two tokens: token j reads state slot slot + j and writes slot + j + 1, after token j - 1's
                     ;; write; more: every token in one dispatch, reading slot and writing slot + 1 after the last
                     dn (if (> n 2)
                          (d f R en X PL (k/k-dnfn) (vector-i64 (vector-at P (pr/ps l 19)) (vector-at P (pr/ps l 20)) (vector-at P (pr/ps l 18)) (oAB)
                                                                  (+ (oSSM slot) (* ord 524288)) (oY) (+ (oCONV slot) (* ord 24576)) (+ (oCONV (rem (+ slot 1) 3)) (* ord 24576))
                                                                  (vector-at P (pr/ps l 21)) (oZ) eps (oQ) (+ (oSSM (rem (+ slot 1) 3)) (* ord 524288)) (ts) n (if (= sv 1) (+ (oSV) (* ord 263168)) 0)) 32 512)
                         (loop [j 0]
                          (if (= j n) 0
                            (let [sr (rem (+ slot j) 3) sw (rem (+ slot (+ j 1)) 3) o (* j (ts))
                                  bj (if (> j 0) (bar f R en) 0)
                                  u (d f R en X PL (k/k-dnf) (vector-i64 (vector-at P (pr/ps l 19)) (vector-at P (pr/ps l 20)) (vector-at P (pr/ps l 18)) (+ (oAB) o)
                                                                       (+ (oSSM sr) (* ord 524288)) (+ (oY) o) (+ (oCONV sr) (* ord 24576)) (+ (oCONV sw) (* ord 24576))
                                                                       (vector-at P (pr/ps l 21)) (+ (oZ) o) eps (+ (oQ) o) (+ (oSSM sw) (* ord 524288))) 32 1024)]
                              (recur (+ j 1))))))
                     b3 (bar f R en)]
                 (grp! f R en X PL (vector-i64 (vector-at P (pr/ps l 22)) (vector-at P (pr/ps l 23)) 2560 4096 (oY) (oX) 1) n))
               (let [kc (+ (oKC) (* ord (* (tmax) 1024)))
                     vc (+ (oVC) (* ord (* (tmax) 1024)))
                     b2 (grp! f R en X PL (vector-i64 (vector-at P (pr/ps l 10)) (vector-at P (pr/ps l 11)) 8192 2560 (oH) (oQ) 0
                                                     (vector-at P (pr/ps l 12)) (vector-at P (pr/ps l 13)) 1024 2560 (oH) (oK) 0
                                                     (vector-at P (pr/ps l 14)) (vector-at P (pr/ps l 15)) 1024 2560 (oH) (oV) 0) n)
                     qk (dy f R en X PL (k/k-qkr) (vector-i64 (vector-at P (pr/ps l 16)) (vector-at P (pr/ps l 17)) pos (oQ) (oK) (oV) kc vc base eps (ts)) 20 n 32)
                     b3 (bar f R en)
                     at (dy f R en X PL (k/k-attd) (vector-i64 0 (ts) (+ pos 1) (oQ) 0 (oY) kc vc) 16 n 256)
                     b4 (bar f R en)]
                 (grp! f R en X PL (vector-i64 (vector-at P (pr/ps l 22)) (vector-at P (pr/ps l 23)) 2560 4096 (oY) (oX) 1) n)))
        r2 (rms f R en X PL (vector-at P (pr/ps l 1)) (oX) (oH) eps n)
        b7 (bar f R en)
        b8 (grp! f R en X PL (vector-i64 (vector-at P (pr/ps l 4)) (vector-at P (pr/ps l 5)) 9216 2560 (oH) (oFG) 0
                                        (vector-at P (pr/ps l 6)) (vector-at P (pr/ps l 7)) 9216 2560 (oH) (oFU) 0) n)
        sw (dy f R en X PL (k/k-swiglu) (vector-i64 0 (ts) 9216 0 (oFU) (oFG) (oG2) 0) 36 n 256)
        b9 (bar f R en)
        dn2 (grp! f R en X PL (vector-i64 (vector-at P (pr/ps l 8)) (vector-at P (pr/ps l 9)) 2560 9216 (oG2) (oX) 1) n)]
    (if (and (= cap 1) (= (rem l 4) 1))
      (dy f R en X PL (k/k-cpy) (vector-i64 0 (ts) 2560 0 (ts) (oX) (+ (oCT) (* (quot l 4) 2560)) 0) 10 n 256)
      0)))

;; n tokens (at positions pos ..) through the model into the open encoder en: token j is toks j, or when that is
;; negative the arena's argmax word oTOK + (-1 - it); the recurrent states are read from slot and written to slot + 1
;; .. slot + n (n of 1 or 2), or to slot + 1 (n over 2: the state after the last token only). Tokens h0 .. n - 1 go
;; through the head: token j's argmax lands in word oTOK + j and in the position log at pos + j. Token j's final-norm
;; hidden stays in oH + j (ts).
(defn step-body! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 P :vector-i64 toks :vector-i64 n :i64 pos :i64 slot :i64 nl :i64 h0 :i64 cap :i64 sv :i64] :i64
  (let [g (pr/gbase)
        e0 (loop [j 0] (if (= j n) 0
             (let [tk (vector-at toks j)
                   u (d f R en X PL (k/k-emb (vector-at P (+ g 1))) (vector-i64 (vector-at P g) (if (< tk 0) 0 tk) 2560 (if (< tk 0) 1 0) (+ (oTOK) (- -1 tk)) 0 (+ (oX) (* j (ts))) 0) 10 256)]
               (recur (+ j 1)))))
        eb (bar f R en)
        ly (loop [l 0] (if (= l nl) 0 (let [u (layer! f R en X PL P l pos n slot cap sv)] (recur (+ l 1)))))
        fr (rms f R en X PL (vector-at P (+ g 2)) (oX) (oH) (vector-at P (+ g 3)) n)
        fb (bar f R en)
        nh (- n h0)
        hd (if (= nh 0) 0 (mv f R en X PL (vector-at P g) (vector-at P (+ g 1)) (pr/q35-vocab) 2560 (+ (oH) (* h0 (ts))) (+ (oLG) (* h0 (ts))) 0 nh))
        hb (bar f R en)
        am (if (= nh 0) 0 (dy f R en X PL (k/k-argmax) (vector-i64 0 (ts) (pr/q35-vocab) 0 (+ pos h0) (+ (oLG) (* h0 (ts))) (+ (oTOK) h0) (oLOG)) 1 nh 1024))]
    (bar f R en)))

;; step-body! in its own command buffer (committed)
(defn step-enc! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 X :vector-i64 PL :vector-i64 P :vector-i64 toks :vector-i64 n :i64 pos :i64 slot :i64 nl :i64 h0 :i64] :i64
  (let [t0 (b/cc f (vector-at X 10) 0 0 0 0 0)
        ce (m/open-enc-c f R X)
        u (step-body! f R (vector-at ce 1) X PL P toks n pos slot nl h0 0 0)]
    (m/commit! f R X ce t0)))

;; bind buffer w at index 0 (the weights the following dispatches read)
(defn- bindw! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 w :i64] :i64
  (b/cc f (vector-at R 0) en (vector-at X 8) w 0 0))

;; The MTP head (pr/q35-mtp profile M, weights W2, its matrices as the Q8_0 copies) over n rows at positions pos ..:
;; row j joins the final-norm hidden the main pass left in oH + j (ts) with the embedding of toks j (the token after
;; position pos + j; a negative one is the arena word oTOK + (-1 - it)):
;; x = fc([rms(e) | rms(h)]); x += attention(rms(x)) (its own KV cache); x += MLP(rms(x)). With head 1 the last row
;; goes through the final norm, the tied head and argmax into word oTOK + wD: the draft for position pos + n + 1.
(defn mtp-body! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 P :vector-i64 M :vector-i64 W2 :i64 toks :vector-i64 n :i64 pos :i64 head :i64] :i64
  (let [g (pr/gbase)
        eps (vector-at P (+ g 3))
        base (vector-at P (+ g 4))
        mb (oM)
        e0 (loop [j 0] (if (= j n) 0
             (let [tk (vector-at toks j)
                   u (d f R en X PL (k/k-emb (vector-at P (+ g 1))) (vector-i64 (vector-at P g) (if (< tk 0) 0 tk) 2560 (if (< tk 0) 1 0) (+ (oTOK) (- -1 tk)) 0 (+ mb (+ (oX) (* j (ts)))) 0) 10 256)]
               (recur (+ j 1)))))
        b0 (bar f R en)
        w2 (bindw! f R en X W2)
        r0 (rms f R en X PL (vector-at M 13) (+ mb (oX)) (+ mb (oQ)) eps n)
        r1 (rms f R en X PL (vector-at M 14) (oH) (+ mb (+ (oQ) 2560)) eps n)
        b1 (bar f R en)
        fc (mv f R en X PL (vector-at M 32) 8 2560 5120 (+ mb (oQ)) (+ mb (oX)) 0 n)
        b2 (bar f R en)
        r2 (rms f R en X PL (vector-at M 1) (+ mb (oX)) (+ mb (oH)) eps n)
        b3 (bar f R en)
        q (mv f R en X PL (vector-at M 42) 8 8192 2560 (+ mb (oH)) (+ mb (oQ)) 0 n)
        kk (mv f R en X PL (vector-at M 39) 8 1024 2560 (+ mb (oH)) (+ mb (oK)) 0 n)
        vv (mv f R en X PL (vector-at M 43) 8 1024 2560 (+ mb (oH)) (+ mb (oV)) 0 n)
        b4 (bar f R en)
        qk (loop [j 0] (if (= j n) 0
             (let [o (+ mb (* j (ts)))
                   u (d f R en X PL (k/k-qkr) (vector-i64 (vector-at M 9) (vector-at M 6) (+ pos j) (+ (oQ) o) (+ (oK) o) (+ (oV) o) (oMK) (oMV) base eps) 20 32)]
               (recur (+ j 1)))))
        b5 (bar f R en)
        at (loop [j 0] (if (= j n) 0
             (let [o (+ mb (* j (ts)))
                   u (d f R en X PL (k/k-attd) (vector-i64 0 0 (+ pos (+ j 1)) (+ (oQ) o) 0 (+ (oY) o) (oMK) (oMV)) 16 256)]
               (recur (+ j 1)))))
        b6 (bar f R en)
        op (mv f R en X PL (vector-at M 40) 8 2560 4096 (+ mb (oY)) (+ mb (oX)) 1 n)
        b7 (bar f R en)
        r3 (rms f R en X PL (vector-at M 5) (+ mb (oX)) (+ mb (oH)) eps n)
        b8 (bar f R en)
        fg (mv f R en X PL (vector-at M 35) 8 9216 2560 (+ mb (oH)) (+ mb (oFG)) 0 n)
        fu (mv f R en X PL (vector-at M 36) 8 9216 2560 (+ mb (oH)) (+ mb (oFU)) 0 n)
        b9 (bar f R en)
        sw (loop [j 0] (if (= j n) 0
             (let [o (+ mb (* j (ts))) u (d f R en X PL (k/k-swiglu) (vector-i64 0 0 9216 0 (+ (oFU) o) (+ (oFG) o) (+ (oG2) o) 0) 36 256)] (recur (+ j 1)))))
        b10 (bar f R en)
        dn (mv f R en X PL (vector-at M 34) 8 2560 9216 (+ mb (oG2)) (+ mb (oX)) 1 n)
        b11 (bar f R en)
        hd (if (= head 0) 0
             (let [lb (+ mb (* (- n 1) (ts)))
                   r4 (rms f R en X PL (vector-at M 12) (+ lb (oX)) (+ lb (oH)) eps 1)
                   b12 (bar f R en)
                   w1 (bindw! f R en X (vector-at X 5))
                   h (mv f R en X PL (vector-at P g) (vector-at P (+ g 1)) (pr/q35-vocab) 2560 (+ lb (oH)) (+ lb (oLG)) 0 1)
                   b13 (bar f R en)]
               (d f R en X PL (k/k-argmax) (vector-i64 0 0 (pr/q35-vocab) 0 0 (+ lb (oLG)) (+ (oTOK) (wD)) (+ (oTOK) (wD))) 1 1024)))
        w3 (bindw! f R en X (vector-at X 5))]
    (bar f R en)))

;; debug: the first 6 floats of the residual (oX) and of oH as float bits
(defn- dump [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 X :vector-i64 blk :i64] :i64
  (let [ac (+ (vector-at X 7) (* 4 (* blk (ts))))
        s (loop [i 0 acc "dump-x"] (if (= i 6) acc (recur (+ i 1) (string-concat acc (string-concat " " (string-from-i64 (bit-and (b/peek f (+ ac (* 4 i))) 4294967295)))))))
        t (loop [i 0 acc " h"] (if (= i 6) acc (recur (+ i 1) (string-concat acc (string-concat " " (string-from-i64 (bit-and (b/peek f (+ ac (* 4 (+ (oH) i)))) 4294967295)))))))]
    (b/wr-text f R (string-concat s (string-concat t "\n")))))

;; the pipelines in kernel-id order (murakumo.engine.kernels)
(defn pipelines [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 lib :i64 errp :i64] :vector-i64
  (vector-i64 (m/pipeline f R dev lib errp "mv_q8_0") (m/pipeline f R dev lib errp "mvk_q4_k")
              (m/pipeline f R dev lib errp "mvk_q5_k") (m/pipeline f R dev lib errp "mv_q6_k")
              (m/pipeline f R dev lib errp "emb_q8_0") (m/pipeline f R dev lib errp "emb_q4_k")
              (m/pipeline f R dev lib errp "emb_q5_k") (m/pipeline f R dev lib errp "emb_q6_k")
              (m/pipeline f R dev lib errp "rms1") (m/pipeline f R dev lib errp "swiglu")
              (m/pipeline f R dev lib errp "dnf") (m/pipeline f R dev lib errp "qkr")
              (m/pipeline f R dev lib errp "attd") (m/pipeline f R dev lib errp "argmax")
              (m/pipeline f R dev lib errp "mv2_q8_0") (m/pipeline f R dev lib errp "mvk2_q4_k")
              (m/pipeline f R dev lib errp "mvk2_q5_k") (m/pipeline f R dev lib errp "mv2_q6_k")
              (m/pipeline f R dev lib errp "mv_bf16") (m/pipeline f R dev lib errp "mv2_bf16")
              (m/pipeline f R dev lib errp "bfq8") (m/pipeline f R dev lib errp "mm_q8_0")
              (m/pipeline f R dev lib errp "mm_q4_k") (m/pipeline f R dev lib errp "mm_q5_k")
              (m/pipeline f R dev lib errp "mm_q6_k") (m/pipeline f R dev lib errp "mm_bf16")
              (m/pipeline f R dev lib errp "dnfn") (m/pipeline f R dev lib errp "mmr")
              (m/pipeline f R dev lib errp "dnr") (m/pipeline f R dev lib errp "cpy")
              (m/pipeline f R dev lib errp "qkn") (m/pipeline f R dev lib errp "attb")
              (m/pipeline f R dev lib errp "mm8_q8_0") (m/pipeline f R dev lib errp "mm8_q4_k")
              (m/pipeline f R dev lib errp "mm8_q5_k") (m/pipeline f R dev lib errp "mm8_q6_k")))

;; threads per threadgroup each pipeline's dispatches use (kernel-id order)
(defn- threads [] :vector-i64
  (vector-i64 128 128 128 128 256 256 256 256 1024 256 1024 32 256 1024 128 128 128 128 128 128 256 128 128 128 128 128 512 256 512 256 32 128 128 128 128 128))

;; the MTP head file (safetensors, pinned by digest like the model): the profile pr/q35-mtp with the weight buffer at
;; index 31
(defn- load-mtp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 X :vector-i64 PL :vector-i64 path :string expect :string] :vector-i64
  (let [fd (b/cc f (b/sym f "open") (b/cstr f (vector-at R 3) path) 0 0 0 0)
        u0 (if (< fd 0) (let [w (b/wr-text f R "refused: cannot open the MTP head\n")] (vector-at [0] 1)) 0)
        shv (b/sha-verify! f R fd expect)
        total (b/cc f (b/sym f "lseek") fd 0 2 0 0)
        lb (b/cc f (vector-at R 3) 16 0 0 0 0)
        g0 (b/cc f (b/sym f "pread") fd lb 8 0 0)
        hl (b/peek f lb)
        u1 (if (or (or (< g0 8) (> g0 8)) (or (< hl 2) (or (> hl 1048576) (> (+ hl 8) total)))) (let [w (b/wr-text f R "refused: bad MTP header length\n")] (vector-at [0] 1)) 0)
        hbuf (b/cc f (vector-at R 3) hl 0 0 0 0)
        g1 (b/cc f (b/sym f "pread") fd hbuf hl 8 0)
        u2 (if (= g1 hl) 0 (let [w (b/wr-text f R "refused: short read\n")] (vector-at [0] 1)))
        dstart (+ 8 hl)
        dlen (- total dstart)
        u3 (if (= (rem dlen 16) 0) 0 (let [w (b/wr-text f R "refused: MTP data length\n")] (vector-at [0] 1)))
        M (pr/q35-mtp f R hbuf hl dlen)
        W2 (b/msg f R dev "newBufferWithLength:options:" (+ dlen (+ (pr/mtp-extra) (pr/mtp-q8-bytes))) 0 0)
        u4 (if (= W2 0) (let [w (b/wr-text f R "refused: no memory for the MTP head\n")] (vector-at [0] 1)) 0)
        wd (b/msg f R W2 "contents" 0 0 0)
        prd (b/sym f "pread")
        got (loop [o 0]
              (if (>= o dlen) o
                (let [want (if (< (- dlen o) 8388608) (- dlen o) 8388608)
                      gg (b/cc f prd fd (+ wd o) want (+ dstart o) 0)]
                  (if (= gg want) (recur (+ o want))
                    (let [w (b/wr-text f R "refused: short read in the MTP data\n")] (vector-at [0] 1))))))
        u5 (if (= got dlen) (b/stamp-same! f R fd shv) (vector-at [0] 1))
        nm (pr/mtp-norms! f wd M)
        z (vector-assoc! M 31 W2)
        ;; the matrices to Q8_0 (half the bytes the MTP head reads per pass), once, on the GPU
        ce (m/open-enc-c f R X)
        en (vector-at ce 1)
        w2 (bindw! f R en X W2)
        cv (loop [k 0]
             (if (= k 8) 0
               (let [s (vector-at (pr/mtp-mats) (* 2 k))
                     nb32 (quot (vector-at (pr/mtp-mats) (+ (* 2 k) 1)) 32)
                     u (d f R en X PL (k/k-bfq8) (vector-i64 (vector-at M s) (vector-at M (+ 32 s)) nb32 0) (quot (+ nb32 255) 256) 256)]
                 (recur (+ k 1)))))
        cw (m/wait! f R X (m/commit! f R X ce (b/cc f (vector-at X 10) 0 0 0 0 0)))]
    M))

;; plain greedy decode: the prompt up to 16 tokens per pass (only the last token through the head), then one token
;; per buffer (pipelined); returns [t0 t1 t2]
(defn- plain-gen [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 X :vector-i64 PL :vector-i64 P :vector-i64 ids :vector-i64 steps :i64 nl :i64 out :vector-i64 now :i64] :vector-i64
  (let [np (vector-count ids)
        t0 (b/cc f now 0 0 0 0 0)
        ;; prompt: up to 16 tokens per pass (the weights are read once for all); a pass of n moves the state from
        ;; slot c to c + n (one or two tokens) or c + 1 (more)
        pp (loop [i 0 last 1 sl 0 lg "q35-passes"]
              (if (>= i np) (let [w (b/wr-text f R (string-concat lg "\n"))] (vector-i64 last sl))
                (let [n (if (>= (- np i) (nb)) (nb) (- np i))
                      tv (vector-alloc n)
                      fl (loop [j 0] (if (= j n) 0 (let [z (vector-assoc! tv j (vector-at ids (+ i j)))] (recur (+ j 1)))))
                      ta (b/cc f now 0 0 0 0 0)
                      cb (step-enc! f R X PL P tv n i sl nl (if (>= (+ i n) np) (- n 1) n))
                      w (m/wait! f R X cb)
                      tb (b/cc f now 0 0 0 0 0)]
                  (recur (+ i n) n (rem (+ sl (if (> n 2) 1 n)) 3)
                         (string-concat lg (string-concat " " (string-concat (string-from-i64 n) (string-concat ":" (string-from-i64 (m/ticks-ns f (- tb ta)))))))))))
        pr0 (vector-at pp 0)
        sb (vector-at pp 1)
        dbg (if (< nl (pr/q35-layers)) (dump f R X (- pr0 1)) 0)
        t1 (b/cc f now 0 0 0 0 0)
        o0 (vector-assoc! out 0 (m/arena-u32 f X (+ (oLOG) (- np 1))))
        ;; decode: step s's buffer (whose embedding reads the token the previous argmax left in the arena) is committed
        ;; before the CPU waits for step s - 1's, so the GPU never idles between tokens; each token is read back as
        ;; soon as its own buffer completes
        gen (loop [s 1 prev 0]
              (if (= s steps)
                (if (= prev 0) 0
                  (let [w (m/wait! f R X prev)
                        a (vector-assoc! out (- s 1) (m/arena-u32 f X (+ (oLOG) (+ np (- s 2)))))] 0))
                ;; the first step reads the last prompt token's argmax (word pr0 - 1), later ones word 0
                (let [cb (step-enc! f R X PL P (vector-i64 (if (= s 1) (- 0 pr0) -1)) 1 (+ np (- s 1)) (rem (+ sb (- s 1)) 3) nl 0)
                      a (if (= prev 0) 0
                          (let [w (m/wait! f R X prev)
                                v (vector-assoc! out (- s 1) (m/arena-u32 f X (+ (oLOG) (+ np (- s 2)))))] 0))]
                  (recur (+ s 1) cb))))
        t2 (b/cc f now 0 0 0 0 0)]
    (vector-i64 t0 t1 t2 0 0)))

;; one draft-and-verify cycle, encoded but not committed: the MTP head over acc rows at positions p .. with the next
;; tokens nx (drafting into word oTOK + wD), then the two-token pass [tp, draft] at p + acc from state slot; returns
;; the command buffer
(defn- cycle-enc! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 X :vector-i64 PL :vector-i64 P :vector-i64 M :vector-i64 W2 :i64 nx :vector-i64 acc :i64 p :i64 tp :i64 slot :i64 nl :i64] :i64
  (let [t0 (b/cc f (vector-at X 10) 0 0 0 0 0)
        ce (m/open-enc-c f R X)
        en (vector-at ce 1)
        mt (mtp-body! f R en X PL P M W2 nx acc p 1)
        sb (step-body! f R en X PL P (vector-i64 tp (- -1 (wD))) 2 (+ p acc) slot nl 0 0 0)
        z (b/msg f R en "endEncoding" 0 0 0)
        t1 (b/cc f (vector-at X 10) 0 0 0 0 0)
        ac (vector-at X 9)
        k (b/poke f ac (+ (b/peek f ac) (- t1 t0)))]
    (vector-at ce 0)))

;; greedy decode with MTP drafts (lossless: every token emitted is the main model's argmax). Each command buffer first
;; runs the MTP head over the rows the previous pass accepted (their final-norm hidden still in the main blocks), which
;; drafts the next token into word oTOK + wD, then verifies [last token, draft] in one two-token pass. The draft is
;; accepted when the first verify argmax equals it: then both argmaxes are emitted and the state advances two slots,
;; else only the first and one slot (the next cycle's two possible buffers are encoded while this one runs). The prompt goes two tokens per pass with the MTP head over the previous pass's
;; rows (no draft). Returns [t0 t1 t2 cycles accepted].
(defn- spec-gen [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 X :vector-i64 PL :vector-i64 P :vector-i64 M :vector-i64 ids :vector-i64 steps :i64 nl :i64 out :vector-i64 now :i64] :vector-i64
  (let [np (vector-count ids)
        W2 (vector-at M 31)
        t0 (b/cc f now 0 0 0 0 0)
        pr (loop [i 0 pn 0]
             (if (>= i np) pn
               (let [n (if (>= (- np i) 2) 2 (- np i))
                     tv (if (= n 1) (vector-i64 (vector-at ids i)) (vector-i64 (vector-at ids i) (vector-at ids (+ i 1))))
                     nx (if (< pn 2) (vector-i64 (vector-at ids i)) (vector-i64 (vector-at ids (- i 1)) (vector-at ids i)))
                     te (b/cc f (vector-at X 10) 0 0 0 0 0)
                     ce (m/open-enc-c f R X)
                     en (vector-at ce 1)
                     mt (if (> pn 0) (mtp-body! f R en X PL P M W2 nx pn (- i pn) 0) 0)
                     sb (step-body! f R en X PL P tv n i (rem i 3) nl 0 0 0)
                     cb (m/commit! f R X ce te)
                     w (m/wait! f R X cb)]
                 (recur (+ i n) n))))
        a (m/arena-u32 f X (+ (oLOG) (- np 1)))
        o0 (vector-assoc! out 0 a)
        t1 (b/cc f now 0 0 0 0 0)
        ;; cycle k's buffer runs while both of cycle k + 1's are encoded (accept: MTP rows [word 0, word 1], last token
        ;; word 1, two slots on; reject: row [word 0], last token word 0, one slot on), so the GPU only waits for the
        ;; CPU to read three words and commit the one that applies
        c0 (cycle-enc! f R X PL P M W2 (if (= pr 1) (vector-i64 a) (vector-i64 (vector-at ids (- np 1)) a)) pr (- np pr) a (rem np 3) nl)
        k0 (b/msg f R c0 "commit" 0 0 0)
        g (loop [cnt 1 cur c0 q np slot (rem np 3) cyc 0 nacc 0]
            (if (>= cnt steps) (let [w (m/wait! f R X cur)] (vector-i64 cyc nacc))
              (let [ca (cycle-enc! f R X PL P M W2 (vector-i64 -1 -2) 2 q -2 (rem (+ slot 2) 3) nl)
                    cr (cycle-enc! f R X PL P M W2 (vector-i64 -1) 1 q -1 (rem (+ slot 1) 3) nl)
                    w (m/wait! f R X cur)
                    dr (m/arena-u32 f X (+ (oTOK) (wD)))
                    a0 (m/arena-u32 f X (oTOK))
                    a1 (m/arena-u32 f X (+ (oTOK) 1))
                    ok (if (= a0 dr) 1 0)
                    e1 (vector-assoc! out cnt a0)
                    e2 (if (and (= ok 1) (< (+ cnt 1) steps)) (let [z (vector-assoc! out (+ cnt 1) a1)] 0) 0)
                    nc (+ cnt (+ 1 ok))
                    nxt (if (= ok 1) ca cr)
                    ;; the buffer that does not apply is released uncommitted (a queue holds at most 64 live buffers)
                    rl (b/msg f R (if (= ok 1) cr ca) "release" 0 0 0)
                    k1 (if (< nc steps) (b/msg f R nxt "commit" 0 0 0) (b/msg f R nxt "release" 0 0 0))]
                (recur nc (if (< nc steps) nxt cur) (+ q (+ 1 ok)) (rem (+ slot (+ 1 ok)) 3) (+ cyc 1) (+ nacc ok)))))
        t2 (b/cc f now 0 0 0 0 0)]
    (vector-i64 t0 t1 t2 (vector-at g 0) (vector-at g 1))))

;; ---- DFlash block drafter (pr/dflash profile D; its weights in buffer D 159, the matrices as Q8_0 copies) ----

;; drafter layers
(defn- df-layers [] :i64 (pr/df-layers))
;; drafter constants: RoPE base 1e7 and epsilon 1e-6 (float bits), the mask token
(defn- df-rope [] :i64 1259902592)
(defn- df-eps [] :i64 897988541)
(defn- df-mask [] :i64 248077)

;; the drafter's context: the m captured rows in oCT of blocks 0 .. m - 1 (main-model positions pos ..) through fc and
;; hidden_norm, then each layer's k (k_norm, RoPE) and v into its KV cache at those positions
(defn- dctx! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 D :vector-i64 m :i64 pos :i64] :i64
  (let [w3 (bindw! f R en X (vector-at D 159))
        fc (grp! f R en X PL (vector-i64 (vector-at D 48) 8 2560 20480 (oCT) (oX) 0) m)
        hn (rms f R en X PL (vector-at D 96) (oX) (oH) (df-eps) m)
        b0 (bar f R en)
        kv (loop [l 0]
             (if (= l (df-layers)) 0
               (let [a (+ 49 (* 7 l)) c (+ 49 (* 7 (+ l 1)))
                     u (grp! f R en X PL (vector-i64 (vector-at D (+ a 1)) 8 1024 2560 (oH) (+ (oFG) (* l 1024)) 0
                                                    (vector-at D (+ a 2)) 8 1024 2560 (oH) (+ (oFU) (* l 1024)) 0
                                                    (vector-at D (+ c 1)) 8 1024 2560 (oH) (+ (oFG) (* (+ l 1) 1024)) 0
                                                    (vector-at D (+ c 2)) 8 1024 2560 (oH) (+ (oFU) (* (+ l 1) 1024)) 0) m)]
                 (recur (+ l 2)))))
        qk (loop [l 0]
             (if (= l (df-layers)) 0
               (let [u (dy f R en X PL (k/k-qkn) (vector-i64 0 (vector-at D (+ 96 (+ 5 (* 4 l)))) pos 0 (+ (oFG) (* l 1024)) (+ (oFU) (* l 1024))
                                                              (+ (oDK) (* l (* (tmax) 1024))) (+ (oDV) (* l (* (tmax) 1024))) (df-rope) (df-eps) (ts) 0 0) 8 m 32)]
                 (recur (+ l 1)))))
        b1 (bar f R en)]
    (bindw! f R en X (vector-at X 5))))


;; the drafted block of bs rows: tok at position pos, then bs - 1 mask tokens; every row attends to the whole context, and to the
;; block causally in the sliding-window layers 0 .. 4 and fully in layer 5 (as z-lab/dflash's model.py: a layer is
;; causal when its type is sliding_attention). The rows 1 .. bs - 1 go through the final norm, the tied head and argmax: draft j (position pos + j) in
;; word oTOK + 16 + j.
(defn- dblock! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 P :vector-i64 D :vector-i64 tok :i64 pos :i64 bs :i64] :i64
  (let [g (pr/gbase)
        e0 (loop [j 0] (if (= j bs) 0
             (let [u (d f R en X PL (k/k-emb (vector-at P (+ g 1))) (vector-i64 (vector-at P g) (if (= j 0) tok (df-mask)) 2560 0 0 0 (* j (ts)) 0) 10 256)]
               (recur (+ j 1)))))
        eb (bar f R en)
        w3 (bindw! f R en X (vector-at D 159))
        ly (loop [l 0]
             (if (= l (df-layers)) 0
               (let [a (+ 48 (+ 1 (* 7 l)))
                     nn (+ 96 (+ 2 (* 4 l)))
                     kc (+ (oDK) (* l (* (tmax) 1024)))
                     vc (+ (oDV) (* l (* (tmax) 1024)))
                     r1 (rms f R en X PL (vector-at D nn) (oX) (oH) (df-eps) bs)
                     b1 (bar f R en)
                     qkv (grp! f R en X PL (vector-i64 (vector-at D a) 8 4096 2560 (oH) (oQ) 0
                                                      (vector-at D (+ a 1)) 8 1024 2560 (oH) (oK) 0
                                                      (vector-at D (+ a 2)) 8 1024 2560 (oH) (oV) 0) bs)
                     qk (dy f R en X PL (k/k-qkn) (vector-i64 (vector-at D (+ nn 2)) (vector-at D (+ nn 3)) pos (oQ) (oK) (oV) kc vc (df-rope) (df-eps) (ts) 0 32) 40 bs 32)
                     b2 (bar f R en)
                     ;; layers 0 .. 4 are sliding-window attention, which the drafter runs causally; layer 5 is full
                     at (dy f R en X PL (k/k-attb) (vector-i64 bs (ts) (+ pos bs) (oQ) (if (< l 5) 1 0) (oY) kc vc) 32 bs 128)
                     b3 (bar f R en)
                     op (grp! f R en X PL (vector-i64 (vector-at D (+ a 3)) 8 2560 4096 (oY) (oX) 1) bs)
                     r2 (rms f R en X PL (vector-at D (+ nn 1)) (oX) (oH) (df-eps) bs)
                     b4 (bar f R en)
                     gu (grp! f R en X PL (vector-i64 (vector-at D (+ a 4)) 8 9216 2560 (oH) (oFG) 0
                                                     (vector-at D (+ a 5)) 8 9216 2560 (oH) (oFU) 0) bs)
                     sw (dy f R en X PL (k/k-swiglu) (vector-i64 0 (ts) 9216 0 (oFU) (oFG) (oG2) 0) 36 bs 256)
                     b5 (bar f R en)
                     dn (grp! f R en X PL (vector-i64 (vector-at D (+ a 6)) 8 2560 9216 (oG2) (oX) 1) bs)]
                 (recur (+ l 1)))))
        fr (rms f R en X PL (vector-at D 97) (oX) (oH) (df-eps) bs)
        fb (bar f R en)
        w1 (bindw! f R en X (vector-at X 5))
        hd (mv f R en X PL (vector-at P g) (vector-at P (+ g 1)) (pr/q35-vocab) 2560 (+ (oH) (ts)) (+ (oLG) (ts)) 0 (- bs 1))
        hb (bar f R en)
        am (dy f R en X PL (k/k-argmax) (vector-i64 0 (ts) (pr/q35-vocab) 0 0 (+ (oLG) (ts)) (+ (oTOK) 17) (+ (oLOG) 600)) 1 (- bs 1) 1024)]
    (bar f R en)))

;; the delta-net states after the first cnt tokens of the last verify pass (which read slot): dnr from slot into
;; slot + 1 for every delta-net layer
(defn- replay! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 X :vector-i64 PL :vector-i64 P :vector-i64 cnt :i64 slot :i64 nl :i64] :i64
  (let [s1 (rem (+ slot 1) 3)
        u (loop [l 0]
            (if (= l nl) 0
              (let [ord (vector-at P (pr/ps l 3))
                    v (if (= (vector-at P (pr/ps l 2)) 0)
                        (d f R en X PL (k/k-dnr) (vector-i64 0 0 0 0 (+ (oSSM slot) (* ord 524288)) 0 (+ (oCONV slot) (* ord 24576)) (+ (oCONV s1) (* ord 24576))
                                                             0 0 0 0 (+ (oSSM s1) (* ord 524288)) 0 cnt (+ (oSV) (* ord 263168))) 32 512)
                        0)]
                (recur (+ l 1)))))]
    (bar f R en)))

;; the DFlash drafter file (safetensors, pinned by digest): the profile pr/dflash with its weight buffer at D 159
(defn- load-dflash [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 X :vector-i64 PL :vector-i64 path :string expect :string] :vector-i64
  (let [fd (b/cc f (b/sym f "open") (b/cstr f (vector-at R 3) path) 0 0 0 0)
        u0 (if (< fd 0) (let [w (b/wr-text f R "refused: cannot open the DFlash drafter\n")] (vector-at [0] 1)) 0)
        shv (b/sha-verify! f R fd expect)
        total (b/cc f (b/sym f "lseek") fd 0 2 0 0)
        lb (b/cc f (vector-at R 3) 16 0 0 0 0)
        g0 (b/cc f (b/sym f "pread") fd lb 8 0 0)
        hl (b/peek f lb)
        u1 (if (or (or (< g0 8) (> g0 8)) (or (< hl 2) (or (> hl 1048576) (> (+ hl 8) total)))) (let [w (b/wr-text f R "refused: bad DFlash header length\n")] (vector-at [0] 1)) 0)
        hbuf (b/cc f (vector-at R 3) hl 0 0 0 0)
        g1 (b/cc f (b/sym f "pread") fd hbuf hl 8 0)
        u2 (if (= g1 hl) 0 (let [w (b/wr-text f R "refused: short read\n")] (vector-at [0] 1)))
        dstart (+ 8 hl)
        dlen (- total dstart)
        u3 (if (= (rem dlen 16) 0) 0 (let [w (b/wr-text f R "refused: DFlash data length\n")] (vector-at [0] 1)))
        D (pr/dflash f R hbuf hl dlen)
        W3 (b/msg f R dev "newBufferWithLength:options:" (+ dlen (+ (pr/df-extra) (pr/df-q8-bytes))) 0 0)
        u4 (if (= W3 0) (let [w (b/wr-text f R "refused: no memory for the DFlash drafter\n")] (vector-at [0] 1)) 0)
        wd (b/msg f R W3 "contents" 0 0 0)
        prd (b/sym f "pread")
        got (loop [o 0]
              (if (>= o dlen) o
                (let [want (if (< (- dlen o) 8388608) (- dlen o) 8388608)
                      gg (b/cc f prd fd (+ wd o) want (+ dstart o) 0)]
                  (if (= gg want) (recur (+ o want))
                    (let [w (b/wr-text f R "refused: short read in the DFlash data\n")] (vector-at [0] 1))))))
        u5 (if (= got dlen) (b/stamp-same! f R fd shv) (vector-at [0] 1))
        nm (pr/df-norms! f wd D)
        z (vector-assoc! D 159 W3)
        ce (m/open-enc-c f R X)
        en (vector-at ce 1)
        w2 (bindw! f R en X W3)
        cv (loop [k 0]
             (if (= k 43) 0
               (let [nb32 (quot (pr/df-mvals k) 32)
                     u (d f R en X PL (k/k-bfq8) (vector-i64 (vector-at D k) (vector-at D (+ 48 k)) nb32 0) (quot (+ nb32 255) 256) 256)]
                 (recur (+ k 1)))))
        cw (m/wait! f R X (m/commit! f R X ce (b/cc f (vector-at X 10) 0 0 0 0 0)))]
    D))

;; greedy decode with DFlash drafts (lossless: every token emitted is the main model's argmax). The prompt goes 16
;; tokens per pass, its hidden rows into the drafter's context. Each cycle is one command buffer: the delta-net
;; states replayed over the tokens the last cycle accepted and those tokens' rows into the drafter's context; the
;; drafted block of bs (the last token, then bs - 1 drafts); the bs-token verify pass, which captures its rows and saves its
;; delta-rule inputs. Draft j + 1 is accepted while it equals the verify argmax j; the cycle emits the verify argmaxes
;; up to the first rejected draft's position. Returns [t0 t1 t2 cycles accepted].
(defn- dflash-gen [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 X :vector-i64 PL :vector-i64 P :vector-i64 D :vector-i64 ids :vector-i64 steps :i64 nl :i64 out :vector-i64 now :i64 bs :i64] :vector-i64
  (let [np (vector-count ids)
        t0 (b/cc f now 0 0 0 0 0)
        pp (loop [i 0 last 1 sl 0]
              (if (>= i np) (vector-i64 last sl)
                (let [n (if (>= (- np i) (nb)) (nb) (- np i))
                      tv (vector-alloc n)
                      fl (loop [j 0] (if (= j n) 0 (let [z (vector-assoc! tv j (vector-at ids (+ i j)))] (recur (+ j 1)))))
                      te (b/cc f (vector-at X 10) 0 0 0 0 0)
                      ce (m/open-enc-c f R X)
                      en (vector-at ce 1)
                      sb (step-body! f R en X PL P tv n i sl nl (if (>= (+ i n) np) (- n 1) n) 1 0)
                      dc (dctx! f R en X PL D n i)
                      cb (m/commit! f R X ce te)
                      w (m/wait! f R X cb)]
                  (recur (+ i n) n (rem (+ sl (if (> n 2) 1 n)) 3)))))
        a0 (m/arena-u32 f X (+ (oTOK) (- (vector-at pp 0) 1)))
        o0 (vector-assoc! out 0 a0)
        t1 (b/cc f now 0 0 0 0 0)
        g (loop [cnt 1 tok a0 pos np slot (vector-at pp 1) acc -1 cyc 0 nacc 0]
            (if (>= cnt steps) (vector-i64 cyc nacc)
              (let [te (b/cc f (vector-at X 10) 0 0 0 0 0)
                    ce (m/open-enc-c f R X)
                    en (vector-at ce 1)
                    ;; the last cycle accepted acc drafts: its first acc + 1 tokens (positions pos - acc - 1 ..)
                    rp (if (< acc 0) 0 (let [r (replay! f R en X PL P (+ acc 1) (rem (+ slot 2) 3) nl)] (dctx! f R en X PL D (+ acc 1) (- pos (+ acc 1)))))
                    db (dblock! f R en X PL P D tok pos bs)
                    toks (vector-alloc bs)
                    tf (loop [j 0] (if (= j bs) 0 (let [z (vector-assoc! toks j (if (= j 0) tok (- -17 j)))] (recur (+ j 1)))))
                    vb (step-body! f R en X PL P toks bs pos slot nl 0 1 1)
                    cb (m/commit! f R X ce te)
                    w (m/wait! f R X cb)
                    na (loop [j 0] (if (= j (- bs 1)) j (if (= (m/arena-u32 f X (+ (oTOK) (+ 17 j))) (m/arena-u32 f X (+ (oTOK) j))) (recur (+ j 1)) j)))
                    em (loop [j 0 c cnt] (if (or (> j na) (>= c steps)) c
                         (let [z (vector-assoc! out c (m/arena-u32 f X (+ (oTOK) j)))] (recur (+ j 1) (+ c 1)))))]
                (recur em (m/arena-u32 f X (+ (oTOK) na)) (+ pos (+ na 1)) (rem (+ slot 1) 3) na (+ cyc 1) (+ nacc na)))))
        t2 (b/cc f now 0 0 0 0 0)]
    (vector-i64 t0 t1 t2 (vector-at g 0) (vector-at g 1))))

;; load the pinned file, build the profile, run the prompt ids and steps greedy tokens: spec 0 plain, 1 drafted by
;; the MTP head file mpath, 2 drafted by the DFlash drafter file mpath in blocks of bs (3 .. 16) (either pinned by
;; mexpect); prints `greedy ...`
;; and `q35-ns ...` on stderr (drafted also `q35-spec cycles ... accepted ...`)
(defn run [f [:fn [[:i64 :i64 :i64] :i64]] path :string expect :string ids :vector-i64 steps :i64 nl :i64 mpath :string mexpect :string spec :i64 bs :i64] :i64
  (let [dlopen (b/sym f "dlopen")
        h1 (b/open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (b/open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        R (vector-i64 (b/sym f "objc_msgSend") (b/sym f "sel_registerName") (b/sym f "objc_getClass") (b/sym f "malloc"))
        now (b/sym f "mach_absolute_time")
        device (b/cc f (b/sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        fd (b/cc f (b/sym f "open") (b/cstr f (vector-at R 3) path) 0 0 0 0)
        u0 (if (< fd 0) (let [w (b/wr-text f R "refused: cannot open the model\n")] (vector-at [0] 1)) 0)
        shv (b/sha-verify! f R fd expect)
        total (b/cc f (b/sym f "lseek") fd 0 2 0 0)
        u1 (if (< total 24) (let [w (b/wr-text f R "refused: truncated header\n")] (vector-at [0] 1)) 0)
        hb (if (> total 67108864) 67108864 total)
        fbuf (b/cc f (vector-at R 3) hb 0 0 0 0)
        got (b/cc f (b/sym f "pread") fd fbuf hb 0 0)
        u2 (if (= got hb) 0 (let [w (b/wr-text f R "refused: short read\n")] (vector-at [0] 1)))
        mg (if (= (+ (+ (+ (bit-xor (b/byte-at f fbuf) 71) (bit-xor (b/byte-at f (+ fbuf 1)) 71)) (bit-xor (b/byte-at f (+ fbuf 2)) 85)) (bit-xor (b/byte-at f (+ fbuf 3)) 70)) 0) 0 (let [w (b/wr-text f R "refused: bad magic\n")] (vector-at [0] 1)))
        u3 (if (= (b/u32le f fbuf 4) 3) 0 (let [w (b/wr-text f R "refused: bad version\n")] (vector-at [0] 1)))
        nt (b/peek f (+ fbuf 8))
        nk (b/peek f (+ fbuf 16))
        u4 (if (or (<= nt 0) (< nk 0)) (let [w (b/wr-text f R "refused: bad counts\n")] (vector-at [0] 1)) 0)
        KI (b/kv-index f fbuf nk hb)
        TI (b/t-index f fbuf (vector-at KI (* 4 nk)) nt hb)
        tpos (vector-at TI (* 7 nt))
        r (rem tpos 32)
        dstart (if (= r 0) tpos (+ tpos (- 32 r)))
        u5 (if (> dstart total) (let [w (b/wr-text f R "refused: data region starts past the end of the file\n")] (vector-at [0] 1)) 0)
        dlen (- total dstart)
        P (pr/qwen35 f R fbuf KI nk TI nt dlen)
        W (b/msg f R dev "newBufferWithLength:options:" dlen 0 0)
        u6 (if (= W 0) (let [w (b/wr-text f R "refused: no memory for the weights\n")] (vector-at [0] 1)) 0)
        wdata (b/msg f R W "contents" 0 0 0)
        prd (b/sym f "pread")
        got2 (loop [o 0]
               (if (>= o dlen) o
                 (let [want (if (< (- dlen o) 8388608) (- dlen o) 8388608)
                       gg (b/cc f prd fd (+ wdata o) want (+ dstart o) 0)]
                   (if (= gg want) (recur (+ o want))
                     (let [w (b/wr-text f R "refused: short read in the data region\n")] (vector-at [0] 1))))))
        u7 (if (= got2 dlen) (b/stamp-same! f R fd shv) (vector-at [0] 1))
        A (b/msg f R dev "newBufferWithLength:options:" (* 4 (arena-floats)) 0 0)
        u8 (if (= A 0) (vector-at [0] 1) 0)
        queue (b/msg f R dev "newCommandQueue" 0 0 0)
        acc (b/cc f (vector-at R 3) 16 0 0 0 0)
        a0 (b/poke f acc 0)
        a1 (b/poke f (+ acc 8) 0)
        errp (+ (b/scratch f) 184)
        lib (m/library f R dev (k/source) errp)
        PL (pipelines f R dev lib errp)
        ;; a pipeline that cannot take the threadgroup size its dispatches use is refused (the GPU would run it
        ;; partly, silently)
        tw (loop [i 0] (if (= i (vector-count PL)) 0
             (if (< (b/msg f R (vector-at PL i) "maxTotalThreadsPerThreadgroup" 0 0 0) (vector-at (threads) i))
               (let [w (b/wr-text f R (string-concat "refused: pipeline " (string-concat (string-from-i64 i) " takes fewer threads than its dispatches\n")))] (vector-at [0] 1))
               (recur (+ i 1)))))
        X (vector-i64 (b/sel f R "setComputePipelineState:") (b/sel f R "setBytes:length:atIndex:")
                      (b/sel f R "dispatchThreadgroups:threadsPerThreadgroup:")
                      (b/cc f (vector-at R 3) 160 0 0 0 0) queue W A (b/msg f R A "contents" 0 0 0)
                      (b/sel f R "setBuffer:offset:atIndex:") acc now)
        np (vector-count ids)
        u9 (if (> (+ np steps) (tmax)) (let [w (b/wr-text f R "refused: prompt and steps exceed the KV cache\n")] (vector-at [0] 1)) 0)
        u11 (if (and (= spec 2) (or (< bs 3) (> bs 16))) (let [w (b/wr-text f R "refused: DFlash block size outside 3 .. 16\n")] (vector-at [0] 1)) 0)
        u10 (if (and (> spec 0) (> (+ np (+ steps 16)) (tmax))) (let [w (b/wr-text f R "refused: prompt and steps exceed the KV cache\n")] (vector-at [0] 1)) 0)
        M (cond (= spec 1) (load-mtp f R dev X PL mpath mexpect) (= spec 2) (load-dflash f R dev X PL mpath mexpect) :else (vector-i64 0))
        out (vector-alloc steps)
        res (cond (= spec 1) (spec-gen f R X PL P M ids steps nl out now) (= spec 2) (dflash-gen f R X PL P M ids steps nl out now bs) :else (plain-gen f R X PL P ids steps nl out now))
        t0 (vector-at res 0)
        t1 (vector-at res 1)
        t2 (vector-at res 2)
        text (loop [s 0 accs "greedy"]
               (if (= s steps) (string-concat accs "\n")
                 (recur (+ s 1) (string-concat accs (string-concat " " (string-from-i64 (vector-at out s)))))))
        w1 (b/wr-text f R text)
        w2 (b/wr-text f R (string-concat "q35-ns prompt-tokens " (string-concat (string-from-i64 np)
             (string-concat " prompt " (string-concat (string-from-i64 (m/ticks-ns f (- t1 t0)))
             (string-concat " decode-steps " (string-concat (string-from-i64 (- steps 1))
             (string-concat " decode " (string-concat (string-from-i64 (m/ticks-ns f (- t2 t1))) "\n")))))))))
        w3 (b/wr-text f R (string-concat "q35-split encode " (string-concat (string-from-i64 (m/ticks-ns f (b/peek f acc)))
             (string-concat " gpu-wait " (string-concat (string-from-i64 (m/ticks-ns f (b/peek f (+ acc 8)))) "\n")))))
        w4 (if (> spec 0) (b/wr-text f R (string-concat "q35-spec cycles " (string-concat (string-from-i64 (vector-at res 3))
             (string-concat " accepted " (string-concat (string-from-i64 (vector-at res 4)) "\n"))))) 0)]
    0))
