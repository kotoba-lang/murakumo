(ns cron-controller-fixture (:export [main]))
(defn- cp-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- cp-text [b :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 b)))
(defn- cp-fs [op :string path :string tail :string] :string
  (let [r (typed-cap-call 35 :string :string (str "\u0000FS2\u0000" op path "\u0000" tail))]
    (if (and (>= (string-byte-length r) 5) (= (string-substring r 0 5) "\u0000FS2\u0000")) (string-substring r 5 (string-length r)) "")))
(defn- cp-exists? [p :string] :bool (= (cp-fs "D" p "") "1"))
(defn- cp-absent? [p :string] :bool (= (cp-fs "D" p "") "0"))
(defn- cp-read [p :string] :vector-i64 (cp-bytes (cp-fs "A" p "")))
(defn- cp-write [p :string b :vector-i64] :bool (= (cp-fs "B" p (cp-text b)) (cp-text b)))
(defn- cp-parent-dir [p :string] :string "/work")
(defn- cp-safe-absolute? [s :string] :bool (and (> (string-length s) 1) (= (string-substring s 0 1) "/")))
(defn- cp-str [cfg :vector-i64 i :i64 key :string] :string
 (cond (= key "head") "/work/head" (= key "request") "/work/request"
       (= key "archiveAck") "/work/ack" :else ""))
(defn- cp-num [b :vector-i64 i :i64 key :string] :i64 0)
(defn- cp-hex? [s :string n :i64] :bool (= (string-length s) n))
(defn- rt-now [] :i64 120000)
(defn- br-problem [cfg :vector-i64 definition :vector-i64 pin :string cursor :vector-i64 source :vector-i64 now :i64] :string
  (if (= (vector-at cfg 0) 5) "cursor/idle" "bridge/ok"))
(defn- br-slot [definition :vector-i64 cursor :vector-i64] :i64 60000)
(defn- verified-cron-job-id [active :bool now :i64 previous :i64 slot :i64 pin :string definition :vector-i64] :string
  "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(defn- rt-refresh [cfg :vector-i64] :string (if (= (vector-at cfg 0) 1) "resident/head-refused" "resident/retention-ready"))
(defn- rt-archive-native [cfg :vector-i64 work :string repo :string gh :string] :string
  (if (or (and (= (vector-at cfg 0) 2) (= work "/work/work1"))
          (and (= (vector-at cfg 0) 4) (= work "/work/work2"))) "resident-archive/unconfirmed"
      "resident-archive/confirmed root tree"))
(defn- rt-read-head [cfg :vector-i64 path :string] :vector-i64 (vector-alloc 0))
(defn- br-request [definition :vector-i64 pin :string cursor :vector-i64 now :i64] :vector-i64 (cp-bytes "request"))
(defn- br-head-problem [cfg :vector-i64 head :vector-i64] :string "bridge/head-ready")
(defn- br-completed? [head :vector-i64 request :vector-i64] :bool (cp-exists? "/work/completed"))
(defn- br-install [cfg :vector-i64 head :vector-i64 request :vector-i64] :string "bridge/request-ready")
(defn- rt-cycle [cfg :vector-i64] :string
 (let [called (cp-fs "C" "/work/called" "x")]
  (if (= (vector-at cfg 0) 3) "resident/quorum-unavailable"
    (let [done (cp-write "/work/completed" (cp-bytes "done"))] "resident/published 1 root"))))
(defn- rt-status [cfg :vector-i64 phase :string] :i64 0)
(defn- cc-advance [path :string original :vector-i64 pin :string slot :i64] :string
 (if (cp-write path (cp-bytes "advanced")) "cursor/advanced" "cursor/write-unknown"))
(defn- ln-field [s :string k :i64] :string
 (let [b (cp-bytes s)]
  (loop [i 0 start 0 n 0]
   (cond (= i (vector-count b)) (if (= n k) (string-substring s start i) "")
         (= (vector-at b i) 32) (if (= n k) (string-substring s start i) (recur (+ i 1) (+ i 1) (+ n 1)))
         :else (recur (+ i 1) start n)))))
(defn- cp-arg [i :i64] :string (typed-cap-call 38 :string :string (string-from-i64 i)))
(defn- cp-say [s :string] :i64 (let [x (typed-cap-call 37 :string :string (str s "\n"))] 0))
(defn- br-cursor-clear? [path :string] :bool
  (and (= (cp-fs "D" (str path ".pending") "") "0")
       (= (cp-fs "D" (str path ".intent") "") "0")))

(defn- br-command [cfg :vector-i64] :i64
  (let [mode (cp-arg 0) cfgpath (cp-arg 1) definition-path (cp-arg 2)
        pin (cp-arg 3) cursor-path (cp-arg 4) source-path (cp-arg 5)]
    (if (or (not (cp-safe-absolute? cfgpath)) (not (cp-safe-absolute? definition-path))
            (not (cp-safe-absolute? cursor-path)) (not (cp-safe-absolute? source-path))
            (not (cp-exists? cfgpath)) (not (cp-exists? definition-path))
            (not (cp-exists? cursor-path)) (not (cp-exists? source-path)))
      (let [x (cp-say "bridge/input-unavailable")] 2)
      (if (not (br-cursor-clear? cursor-path))
        (let [x (cp-say "bridge/cursor-unknown")] 1)
      (let [definition (cp-read definition-path) cursor (cp-read cursor-path)
            source (cp-read source-path) now (rt-now) problem (br-problem cfg definition pin cursor source now)]
        (if (or (not (= problem "bridge/ok"))
                (= (cp-str cfg 0 "request") cfgpath) (= (cp-str cfg 0 "request") definition-path)
                (= (cp-str cfg 0 "request") cursor-path) (= (cp-str cfg 0 "request") source-path)
                (= (cp-str cfg 0 "request") (str cursor-path ".pending"))
                (= (cp-str cfg 0 "request") (str cursor-path ".intent"))
                (= (cp-str cfg 0 "request") (str cursor-path ".last"))
                (= (str (cp-str cfg 0 "request") ".tmp") cursor-path)
                (= (str (cp-str cfg 0 "request") ".tmp") (str cursor-path ".pending"))
                (= (str (cp-str cfg 0 "request") ".tmp") (str cursor-path ".intent"))
                (= (str (cp-str cfg 0 "request") ".tmp") (str cursor-path ".last")))
          (let [x (cp-say (if (= problem "bridge/ok") "bridge/path-conflict" problem))] 1)
          (let [head-path (cp-str cfg 0 "head") head (rt-read-head cfg head-path)
                h (br-head-problem cfg head) request (br-request definition pin cursor now)]
            (if (not (= h "bridge/head-ready")) (let [x (cp-say h)] 1)
              (cond (= mode "prepare") (let [result (br-install cfg head request) x (cp-say result)]
                                         (if (= result "bridge/request-ready") 0 1))
                    (= mode "complete") (let [completed (br-completed? head request)
                                               x (cp-say (if completed "bridge/completed" "bridge/not-completed"))]
                                           (if completed 0 1))
                    :else (let [x (cp-say "bridge/command-refused")] 2))))))))))


(defn main [] :i64 (br-command [5]))
