+    ;; Expiry or an unknown clock is not proof that the unit stopped. The
+    ;; caller keeps the busy marker and requires host reconciliation.
+    (if (< (pr-window-seconds started deadline (pr-wall-ms) seconds) 1) -1
+      (let [state (pr-unit-code unit)]
+        (cond (= state 1) (pr-count-value (pr-read-bounded response 1024))
+              (or (= state -1) (> i 900)) -1
+              :else (let [z (pr-pause)] (if z (recur (+ i 1)) -1)))))))
@@ -5690 +5693 @@
-      (if submitted (pr-count-wait unit response) -1))))
+      (if submitted (pr-count-wait unit response started deadline seconds) -1))))
