--- awai-flint-count-expired.kotoba
+++ awai-flint-count-expired.kotoba
@@ -5400 +5400 @@
-    (if (and (= result "profile/budget-refused") (= called "0") (= busy "1")) 0 3)
+    (if (and (= result "profile/context-budget-unknown-or-insufficient") (= called "0") (= busy "1")) 0 3)
@@ -5638 +5638 @@
-(defn- pr-count-wait [unit :string response :string] :i64
+(defn- pr-count-wait [unit :string response :string started :i64 deadline :i64 seconds :i64] :i64
@@ -5640,4 +5640,7 @@
-    (let [state (pr-unit-code unit)]
-      (cond (= state 1) (pr-count-value (pr-read-bounded response 1024))
