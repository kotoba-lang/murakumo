(ns cron-controller-fixture (:export [main]))
(defn- cp-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- cp-text [b :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 b)))
(defn- cp-fs [op :string path :string tail :string] :string
 (if (= op "D") (if (>= (string-index-of path ".intent") 0) "1" "0") ""))
(defn- cp-exists? [p :string] :bool true)
(defn- cp-read [p :string] :vector-i64 (vector-alloc 0))
(defn- cp-write [p :string b :vector-i64] :bool (= (cp-fs "B" p (cp-text b)) (cp-text b)))
(defn- cp-parent-dir [p :string] :string "/var/tmp/awai150-controller")
(defn- cp-safe-absolute? [s :string] :bool (and (> (string-length s) 1) (= (string-substring s 0 1) "/")))
(defn- cp-str [cfg :vector-i64 i :i64 key :string] :string
 (cond (= key "runtimeRoot") "/var/tmp/awai150-controller/runtime" (= key "cache") (if (= (vector-at cfg 0) 7) "" "/var/tmp/awai150-controller/cache") (= key "store") "/var/tmp/awai150-controller/store" (= key "head") "/var/tmp/awai150-controller/head" (= key "request") "/var/tmp/awai150-controller/request"
       (= key "archiveAck") (if (= (vector-at cfg 0) 6) "/var/tmp/awai150-controller/head" "/var/tmp/awai150-controller/ack") :else ""))
(defn- cp-num [b :vector-i64 i :i64 key :string] :i64 60000)
(defn- cp-hex? [s :string n :i64] :bool (= (string-length s) n))
(defn- rt-now [] :i64 120000)
(defn- br-problem [cfg :vector-i64 definition :vector-i64 pin :string cursor :vector-i64 source :vector-i64 now :i64] :string
  (if (= (vector-at cfg 0) 5) "cursor/idle" "bridge/ok"))
(defn- br-slot [definition :vector-i64 cursor :vector-i64] :i64 60000)
(defn- verified-cron-job-id [active :bool now :i64 previous :i64 slot :i64 pin :string definition :vector-i64] :string
  "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(defn- rt-refresh [cfg :vector-i64] :string (if (= (vector-at cfg 0) 1) "resident/head-refused" "resident/retention-ready"))
(defn- rt-archive-native [cfg :vector-i64 work :string repo :string gh :string] :string "resident-archive/unconfirmed")
(defn- rt-read-head [cfg :vector-i64 path :string] :vector-i64 (vector-alloc 0))
(defn- br-request [definition :vector-i64 pin :string cursor :vector-i64 now :i64] :vector-i64 (cp-bytes "request"))
(defn- br-head-problem [cfg :vector-i64 head :vector-i64] :string "bridge/head-ready")
(defn- br-completed? [head :vector-i64 request :vector-i64] :bool (cp-exists? "/var/tmp/awai150-controller/completed"))
(defn- br-install [cfg :vector-i64 head :vector-i64 request :vector-i64] :string "bridge/request-ready")
(defn- rt-cycle [cfg :vector-i64] :string
 (let [called (cp-fs "C" "/var/tmp/awai150-controller/called" "x")]
  (if (= (vector-at cfg 0) 3) "resident/quorum-unavailable"
    (let [done (cp-write "/var/tmp/awai150-controller/completed" (cp-bytes "done"))] "resident/published 1 root"))))
(defn- rt-status [cfg :vector-i64 phase :string] :i64 0)
(defn- cc-advance [path :string original :vector-i64 pin :string slot :i64] :string
 (if (cp-write path (cp-bytes "advanced")) "cursor/advanced" "cursor/write-unknown"))
(defn- ln-field [s :string k :i64] :string
 (let [b (cp-bytes s)]
  (loop [i 0 start 0 n 0]
   (cond (= i (vector-count b)) (if (= n k) (string-substring s start i) "")
         (= (vector-at b i) 32) (if (= n k) (string-substring s start i) (recur (+ i 1) (+ i 1) (+ n 1)))
         :else (recur (+ i 1) start n)))))

(defn- cp-absent? [p :string] :bool false)
(defn- br-cursor-clear? [path :string] :bool true)
(defn- rt-ack-safe? [cfg :vector-i64 path :string] :bool true)
(defn- cc-cursor [pin :string slot :i64] :vector-i64 [0])
(defn- cc-cursor-problem [cursor :vector-i64 pin :string now :i64] :string "cursor/ok")
(defn- rt-admitted-head? [cfg :vector-i64 head :vector-i64] :bool true)
(defn- cc-recovery-ready? [path :string cursor :vector-i64] :bool true)
(defn- cc-recover [path :string cursor :vector-i64] :string "cursor/recovered")
(defn- nc-path-or-tmp? [p :string base :string] :bool
  (or (= p base) (= p (str base ".tmp"))))

(defn- nc-resident-path? [cfg :vector-i64 p :string] :bool
  (or (nc-path-or-tmp? p (cp-str cfg 0 "head")) (= p (cp-str cfg 0 "store"))
      (= p (cp-str cfg 0 "runtimeRoot")) (= p (cp-str cfg 0 "cache"))
      (nc-path-or-tmp? p (cp-str cfg 0 "request")) (nc-path-or-tmp? p (cp-str cfg 0 "status"))
      (nc-path-or-tmp? p (cp-str cfg 0 "candidateHead")) (nc-path-or-tmp? p (cp-str cfg 0 "leaseFile"))
      (= p (cp-str cfg 0 "key"))
      (= p (cp-str cfg 0 "tokenFile")) (= p (cp-str cfg 0 "policyFile"))
      (= p (cp-str cfg 0 "environmentFile")) (= p (cp-str cfg 0 "runtimeFile"))
      (= p (str (cp-str cfg 0 "head") ".resident-lockfile"))))

(defn- nc-sensitive-path? [cfg :vector-i64 config :string definition :string cursor :string source :string p :string] :bool
  (or (= p config) (= p definition) (= p cursor) (= p source)
      (= p (cp-str cfg 0 "archiveAck")) (nc-resident-path? cfg p)))

;; The archive publisher replaces both ack and its temporary path. Reject
;; exact conflicts before acquiring the lock or touching resident state.
(defn- nc-ack-safe? [cfg :vector-i64 config :string] :bool
  (let [ack (cp-str cfg 0 "archiveAck") tmp (str ack ".tmp")]
    (and (rt-ack-safe? cfg config) (not (= ack config)) (not (= tmp config))
         (not (nc-resident-path? cfg ack)) (not (nc-resident-path? cfg tmp)))))

;; Archive staging directories must not consume each other or a path needed
;; for dispatch/cursor/archive recovery. Compare path components, not textual
;; prefixes ("/work-a" is separate from "/work"). The host still prevents
;; symlinks, hard links and concurrent modification of its private scope.
(defn- nc-path-overlap? [a :string b :string] :bool
  (or (= a b) (= (string-index-of a (str b "/")) 0)
      (= (string-index-of b (str a "/")) 0)))

;; Archive staging must not add or replace files inside the live runtime,
;; cache, or checkpoint store, including when a parent is proposed as work.
;; Path aliases remain the private host's responsibility.
(defn- nc-work-resident-safe? [cfg :vector-i64 work :string] :bool
  (let [runtime (cp-str cfg 0 "runtimeRoot") cache (cp-str cfg 0 "cache") store (cp-str cfg 0 "store")]
    (and (cp-safe-absolute? runtime) (cp-safe-absolute? cache) (cp-safe-absolute? store)
         (not (nc-path-overlap? work runtime)) (not (nc-path-overlap? work cache))
         (not (nc-path-overlap? work store)))))

(defn- nc-work-paths-safe? [before :string after :string marker :string cursor :string ack :string] :bool
  (let [pending (str cursor ".pending") intent (str cursor ".intent") last (str cursor ".last") ack-tmp (str ack ".tmp")]
    (not (or (nc-path-overlap? before after)
             (nc-path-overlap? before marker) (nc-path-overlap? after marker)
             (nc-path-overlap? before pending) (nc-path-overlap? after pending)
             (nc-path-overlap? before intent) (nc-path-overlap? after intent)
             (nc-path-overlap? before last) (nc-path-overlap? after last)
             (nc-path-overlap? before ack-tmp) (nc-path-overlap? after ack-tmp)
             (nc-path-overlap? marker pending) (nc-path-overlap? marker intent) (nc-path-overlap? marker last)
             (nc-path-overlap? ack-tmp pending) (nc-path-overlap? ack-tmp intent) (nc-path-overlap? ack-tmp last)
             (nc-path-overlap? marker ack-tmp)))))

;; The marker is created and synced before inference can be submitted. A
;; leftover or partial marker is UNKNOWN; never infer failure and retry. The
;; enclosing task lock and host-owned directory exclude cooperating writers.
(defn- nc-mark [marker :string job :string] :bool
  (and (cp-absent? marker) (cp-write marker (cp-bytes (str job "\n")))
       (= (cp-fs "M" (cp-parent-dir marker) "") "1")))

(defn- nc-advance [cfg :vector-i64 definition :vector-i64 pin :string cursor-path :string cursor :vector-i64
                  source :vector-i64 slot :i64] :string
  (let [now (rt-now) head (rt-read-head cfg (cp-str cfg 0 "head"))
        request (br-request definition pin cursor now)
        plan (br-problem cfg definition pin cursor source now)]
    (cond (not (= plan "bridge/ok")) "cron-resident/plan-changed"
          (not (= slot (br-slot definition cursor))) "cron-resident/slot-changed"
          (not (= (br-head-problem cfg head) "bridge/head-ready")) "cron-resident/archive-pending"
          (not (br-completed? head request)) "cron-resident/completion-unknown"
          (not (= (cc-advance cursor-path cursor pin slot) "cursor/advanced")) "cron-resident/cursor-unknown"
          :else (str "cron-resident/completed " slot))))

(defn- nc-cycle [cfg :vector-i64 config-path :string definition-path :string pin :string cursor-path :string source-path :string
                state :string work-before :string work-after :string repo :string gh :string] :string
  (if (or (not (cp-safe-absolute? definition-path)) (not (cp-safe-absolute? cursor-path))
          (not (cp-safe-absolute? source-path)) (not (cp-safe-absolute? state))
          (not (cp-safe-absolute? work-before)) (not (cp-safe-absolute? work-after))
          (not (cp-safe-absolute? gh)) (= work-before work-after)
          (= definition-path config-path) (= source-path config-path)
          (= cursor-path config-path) (= cursor-path definition-path) (= cursor-path source-path)
          (nc-resident-path? cfg definition-path) (nc-resident-path? cfg cursor-path)
          (nc-resident-path? cfg source-path)
          (= definition-path (cp-str cfg 0 "archiveAck")) (= cursor-path (cp-str cfg 0 "archiveAck"))
          (= source-path (cp-str cfg 0 "archiveAck"))
          (= definition-path (str (cp-str cfg 0 "archiveAck") ".tmp"))
          (= cursor-path (str (cp-str cfg 0 "archiveAck") ".tmp"))
          (= source-path (str (cp-str cfg 0 "archiveAck") ".tmp"))
          (not (cp-exists? definition-path)) (not (cp-exists? cursor-path)) (not (cp-exists? source-path)))
    "cron-resident/input-refused"
    (if (not (br-cursor-clear? cursor-path))
      "cron-resident/cursor-unknown"
    (let [definition (cp-read definition-path) cursor (cp-read cursor-path) source (cp-read source-path)
          now (rt-now) plan (br-problem cfg definition pin cursor source now)
          slot (if (= plan "bridge/ok") (br-slot definition cursor) -1)
          previous (cp-num cursor 0 "slot")
          job (if (= plan "bridge/ok") (verified-cron-job-id true now previous slot pin definition) "")
          marker (str state "/dispatch-" job)]
      (cond (= plan "cursor/idle") "cron-resident/idle"
            (not (= plan "bridge/ok")) "cron-resident/plan-refused"
            (or (not (cp-hex? job 64))
                (not (nc-work-paths-safe? work-before work-after marker cursor-path (cp-str cfg 0 "archiveAck")))
                (not (nc-work-resident-safe? cfg work-before)) (not (nc-work-resident-safe? cfg work-after))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path marker)
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path (str cursor-path ".pending"))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path (str cursor-path ".intent"))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path (str cursor-path ".last"))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path work-before)
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path work-after)) "cron-resident/path-refused"
            :else
            (let [refresh (rt-refresh cfg)]
              (if (not (or (= refresh "resident/retention-ready") (= refresh "resident/replicas-refreshed"))) "cron-resident/retention-pending"
                (let [archive (rt-archive-native cfg work-before repo gh)]
                  (if (not (= (ln-field archive 0) "resident-archive/confirmed")) "cron-resident/archive-pending"
                    (let [head (rt-read-head cfg (cp-str cfg 0 "head")) request (br-request definition pin cursor (rt-now))
                          ready (br-head-problem cfg head)]
                      (cond (not (= ready "bridge/head-ready")) "cron-resident/head-refused"
                            (br-completed? head request) (nc-advance cfg definition pin cursor-path cursor source slot)
                            (not (= (br-install cfg head request) "bridge/request-ready")) "cron-resident/request-refused"
                            (not (nc-mark marker job)) "cron-resident/dispatch-unknown"
                            :else
                            (let [turn (rt-cycle cfg) status (rt-status cfg turn)]
                              (if (not (= (ln-field turn 0) "resident/published")) "cron-resident/completion-unknown"
                                (let [new-archive (rt-archive-native cfg work-after repo gh)]
                                  (if (not (= (ln-field new-archive 0) "resident-archive/confirmed")) "cron-resident/archive-pending"
                                    (nc-advance cfg definition pin cursor-path cursor source slot))))))))))))))))


;; Explicit recovery under the same writer lock. Reconstruct the request for
;; the current slot (the minute before a matching slot is sufficient to
;; validate it), bind it to the signed head, and independently read the
;; archive back before retiring the local cursor intent. No inference runs.
(defn- nc-recovery-cycle [cfg :vector-i64 config-path :string definition-path :string pin :string cursor-path :string source-path :string
                          state :string work-before :string work-after :string repo :string gh :string] :string
  (if (or (not (cp-safe-absolute? definition-path)) (not (cp-safe-absolute? cursor-path))
          (not (cp-safe-absolute? source-path)) (not (cp-safe-absolute? state))
          (not (cp-safe-absolute? work-before)) (not (cp-safe-absolute? work-after)) (not (cp-safe-absolute? gh))
          (= definition-path config-path) (= source-path config-path) (= cursor-path config-path)
          (= cursor-path definition-path) (= cursor-path source-path)
          (nc-resident-path? cfg definition-path) (nc-resident-path? cfg cursor-path) (nc-resident-path? cfg source-path)
          (= definition-path (cp-str cfg 0 "archiveAck")) (= cursor-path (cp-str cfg 0 "archiveAck"))
          (= source-path (cp-str cfg 0 "archiveAck"))
          (= definition-path (str (cp-str cfg 0 "archiveAck") ".tmp"))
          (= cursor-path (str (cp-str cfg 0 "archiveAck") ".tmp"))
          (= source-path (str (cp-str cfg 0 "archiveAck") ".tmp"))
          (not (cp-exists? definition-path)) (not (cp-exists? cursor-path)) (not (cp-exists? source-path))
          (not (= (cp-fs "D" (str cursor-path ".pending") "") "0"))
          (not (= (cp-fs "D" (str cursor-path ".intent") "") "1")))
    "cron-resident/recovery-unknown"
    (let [definition (cp-read definition-path) cursor (cp-read cursor-path) source (cp-read source-path)
          now (rt-now) slot (cp-num cursor 0 "slot") prior (if (>= slot 60000) (- slot 60000) -1)
          prior-cursor (if (>= prior 0) (cc-cursor pin prior) (vector-alloc 0))
          plan (if (and (>= prior 0) (= (cc-cursor-problem cursor pin now) "cursor/ok"))
                 (br-problem cfg definition pin prior-cursor source now) "cursor/invalid")
          job (if (= plan "bridge/ok") (verified-cron-job-id true now prior slot pin definition) "")
          marker (str state "/dispatch-" job) request (if (= plan "bridge/ok") (br-request definition pin prior-cursor now) (vector-alloc 0))
          head (rt-read-head cfg (cp-str cfg 0 "head"))]
      (cond (or (not (= plan "bridge/ok")) (not (= (br-slot definition prior-cursor) slot))
                (not (cp-hex? job 64)) (not (rt-admitted-head? cfg head)) (not (br-completed? head request))
                (not (cc-recovery-ready? cursor-path cursor))
                (not (= (cp-fs "D" (str (cp-str cfg 0 "request") ".tmp") "") "0"))) "cron-resident/recovery-unknown"
            (or (not (nc-work-paths-safe? work-before work-after marker cursor-path (cp-str cfg 0 "archiveAck")))
                (not (nc-work-resident-safe? cfg work-before)) (not (nc-work-resident-safe? cfg work-after))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path marker)
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path (str cursor-path ".pending"))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path (str cursor-path ".intent"))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path (str cursor-path ".last"))
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path work-before)
                (nc-sensitive-path? cfg config-path definition-path cursor-path source-path work-after)) "cron-resident/path-refused"
            :else
            (let [archive (rt-archive-native cfg work-before repo gh)
                  current (rt-read-head cfg (cp-str cfg 0 "head"))]
              (cond (not (= (ln-field archive 0) "resident-archive/confirmed")) "cron-resident/recovery-unknown"
                    (not (= (ln-field archive 1) (cp-str head 0 "checkpoint"))) "cron-resident/recovery-unknown"
                    (not (= (cp-text head) (cp-text current))) "cron-resident/recovery-unknown"
                    (not (= (br-head-problem cfg current) "bridge/head-ready")) "cron-resident/recovery-unknown"
                    (not (br-completed? current request)) "cron-resident/recovery-unknown"
                    (not (= (cc-recover cursor-path cursor) "cursor/recovered")) "cron-resident/recovery-unknown"
                    :else (str "cron-resident/recovered " slot)))))))


(defn main [] :i64
 (let [root "/var/tmp/awai150-controller" cfg [0] bad [7] config (str root "/config") definition (str root "/definition") cursor (str root "/cursor") input (str root "/source") wb (str root "/work") wa (str root "/work-a") runtime (str root "/runtime") cache (str root "/cache") store (str root "/store")]
  (if (and (nc-work-resident-safe? cfg wb)
      (not (nc-work-resident-safe? bad wb))
      (not (nc-work-resident-safe? cfg (str runtime "/work")))
      (not (nc-work-resident-safe? cfg (str cache "/work")))
      (not (nc-work-resident-safe? cfg (str store "/work")))
      (not (nc-work-resident-safe? cfg root))
      (nc-work-resident-safe? cfg (str root "/runtime2"))
      (= (nc-cycle cfg config definition "pin" cursor input root wb wa "repo/name" "/bin/gh") "cron-resident/archive-pending")
      (= (nc-cycle cfg config definition "pin" cursor input root (str runtime "/work") wa "repo/name" "/bin/gh") "cron-resident/path-refused")
      (= (nc-cycle cfg config definition "pin" cursor input root wb (str cache "/work") "repo/name" "/bin/gh") "cron-resident/path-refused")
      (= (nc-cycle cfg config definition "pin" cursor input root (str store "/work") wa "repo/name" "/bin/gh") "cron-resident/path-refused")
      (= (nc-cycle bad config definition "pin" cursor input root wb wa "repo/name" "/bin/gh") "cron-resident/path-refused")
      (= (nc-recovery-cycle cfg config definition "pin" cursor input root wb wa "repo/name" "/bin/gh") "cron-resident/recovery-unknown")
      (= (nc-recovery-cycle cfg config definition "pin" cursor input root (str runtime "/work") wa "repo/name" "/bin/gh") "cron-resident/path-refused")
      (= (nc-recovery-cycle cfg config definition "pin" cursor input root wb (str cache "/work") "repo/name" "/bin/gh") "cron-resident/path-refused")) 0 1)))
