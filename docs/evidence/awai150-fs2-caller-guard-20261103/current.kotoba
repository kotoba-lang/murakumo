(ns caller-guard (:export [main]))
(defn- cp-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- cp-fs [op :string path :string tail :string] :string
 (if (= op "D")
  (let [r (typed-cap-call 35 :string :string (str "\u0000FS2\u0000" op path "\u0000" tail))]
   (if (and (>= (string-byte-length r) 5) (= (string-substring r 0 5) "\u0000FS2\u0000")) (string-substring r 5 (string-length r)) ""))
  "1"))
(defn- cp-exists? [p :string] :bool (= (cp-fs "D" p "") "1"))
(defn- cp-absent? [p :string] :bool (= (cp-fs "D" p "") "0"))
(defn- cp-write [p :string b :vector-i64] :bool true)
(defn- cp-read [p :string] :vector-i64 (cp-bytes "data"))
(defn- cp-load [p :string c :string] :vector-i64 (cp-bytes "data"))
(defn- cp-cid [b :vector-i64] :string "cid")
(defn- cp-block? [p :string c :string] :bool true)
(defn- cp-parent-dir [p :string] :string "/")
(defn- cp-put [store :string b :vector-i64] :string
  (let [cid (cp-cid b) p (str store "/" cid) status (cp-fs "D" p "")]
    (if (or (> (vector-count b) 131072)
            (cond (= status "1") (not (= (cp-cid (cp-read p)) cid))
                  (= status "0") (not (cp-write p b))
                  :else true)) "" cid)))
(defn- ga-copy [store :string out :string cid :string] :bool
  (if (not (cp-block? store cid)) false
    (let [path (str out "/" cid) data (cp-load store cid) status (cp-fs "D" path "")]
      (cond (= status "1") (cp-block? out cid)
            (= status "0") (and (cp-write path data) (cp-block? out cid))
            :else false))))
(defn- rt-save [path :string b :vector-i64] :bool
  (and (cp-absent? (str path ".tmp"))
    (cp-write (str path ".tmp") b)
    (= (cp-fs "L" (str path ".tmp") path) "1")
    (= (cp-fs "M" (cp-parent-dir path) "") "1")))
(defn- pr-save-output [path :string answer :vector-i64 cid :string] :bool
  (let [status (cp-fs "D" path "")]
    (and (cond (= status "1") (and (= (cp-cid (cp-read path)) cid) (= (cp-fs "M" path "") "1"))
               (= status "0") (cp-write path answer)
               :else false)
         (= (cp-fs "M" (cp-parent-dir path) "") "1"))))
(defn- pr-prepare-submit [request :string marker :string body :vector-i64] :bool
  (and (cp-absent? request) (cp-absent? marker)
       (cp-write request body)
       (= (cp-fs "M" (cp-parent-dir request) "") "1")
       (cp-write marker (cp-bytes "itonami.inference-dispatch/1\n"))
       (= (cp-fs "M" (cp-parent-dir marker) "") "1")))
(defn- nc-mark [marker :string job :string] :bool
  (and (cp-absent? marker) (cp-write marker (cp-bytes (str job "\n")))
       (= (cp-fs "M" (cp-parent-dir marker) "") "1")))
(defn main [] :i64
 (let [op (typed-cap-call 38 :string :string "0") root (typed-cap-call 38 :string :string "1")
       value (cond (= op "put") (cp-put root (cp-bytes "data"))
                   (= op "copy") (if (ga-copy "/source" root "cid") "true" "false")
                   (= op "save") (if (rt-save (str root "/item") (cp-bytes "data")) "true" "false")
                   (= op "output") (if (pr-save-output (str root "/item") (cp-bytes "data") "cid") "true" "false")
                   (= op "prepare") (if (pr-prepare-submit (str root "/item") (str root "/marker") (cp-bytes "data")) "true" "false")
                   (= op "mark") (if (nc-mark (str root "/marker") "job") "true" "false")
                   :else "bad-op")
       sent (typed-cap-call 37 :string :string (str value "\n"))] 0))
