(defn same-from? [s :string p :string i :i64] :bool
  (cond (>= i (string-length p)) true
        (= (string-code-point-at s i) (string-code-point-at p i)) (recur s p (inc i))
        :else false))
(defn digest-problem [d :string] :string
  (let [n (string-length d)]
    (cond (and (>= n 7) (same-from? d "sha256:" 0))
            (if (= n 71) (if (hex-from? d 7 71) "oci/ok" "oci/bad-digest") "oci/bad-digest")
          (> (string-index-of d ":") 0) "itonami/unsupported-digest"
          :else "oci/bad-digest")))
(defn b32-char [v :i64] :string (string-substring "abcdefghijklmnopqrstuvwxyz234567" v (inc v)))
(defn cid-byte [d :string codec :i64 i :i64] :i64
  (cond (= i 0) 1
        (= i 1) codec
        (= i 2) 18
        (= i 3) 32
        :else (let [k (+ 7 (* 2 (- i 4)))]
                (+ (* 16 (hex-value (string-code-point-at d k))) (hex-value (string-code-point-at d (inc k)))))))
(defn b32-from [d :string codec :i64 i :i64 acc :i64 nbits :i64 out :string] :string
  (cond (>= nbits 5)
          (let [m (- nbits 5) v (bit-and (u64-shift-right acc m) 31)]
            (recur d codec i (bit-and acc (dec (i64-shift-left 1 m))) m (string-concat out (b32-char v))))
        (< i 36)
          (recur d codec (inc i) (bit-or (i64-shift-left acc 8) (cid-byte d codec i)) (+ nbits 8) out)
        (> nbits 0) (string-concat out (b32-char (bit-and (i64-shift-left acc (- 5 nbits)) 31)))
        :else out))
(defn digest-cid [d :string codec :i64] :string
  (cond (not (= (digest-problem d) "oci/ok")) ""
        (= codec 85) (b32-from d codec 0 0 0 "b")
        (= codec 113) (b32-from d codec 0 0 0 "b")
        :else ""))
(defn b32-value [c :i64] :i64
  (cond (and (>= c 97) (<= c 122)) (- c 97)
        (and (>= c 50) (<= c 55)) (+ 26 (- c 50))
        :else -1))
(defn b32-decode [s :string i :i64 acc :i64 nbits :i64 out :vector-i64] :vector-i64
  (cond (>= nbits 8)
          (let [m (- nbits 8)]
            (recur s i (bit-and acc (dec (i64-shift-left 1 m))) m (vector-conj out (bit-and (u64-shift-right acc m) 255))))
        (>= i (string-length s)) out
        :else (let [v (b32-value (string-code-point-at s i))]
                (if (< v 0) [-1] (recur s (inc i) (bit-or (i64-shift-left acc 5) v) (+ nbits 5) out)))))
(defn cid-bytes [cid :string] :vector-i64
  (if (= (string-length cid) 59)
    (if (= (string-code-point-at cid 0) 98) (b32-decode cid 1 0 0 []) [-1])
    [-1]))
(defn cid-codec [cid :string] :i64
  (let [b (cid-bytes cid)]
    (if (= (count b) 36)
      (let [c (vector-at b 1)]
        (if (and (= (vector-at b 0) 1) (= (vector-at b 2) 18) (= (vector-at b 3) 32))
          (if (= c 85) c (if (= c 113) c 0))
          0))
      0)))
(defn- en-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- en-b58 [] :string "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz")
(defn- en-b64 [] :string "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")
(defn- en-char [alphabet :string i :i64] :string (string-substring alphabet i (+ i 1)))
(defn- en-b58-digit [c :i64] :i64
  (cond (and (>= c 49) (<= c 57)) (- c 49)
        (and (>= c 65) (<= c 72)) (- c 56)
        (and (>= c 74) (<= c 78)) (- c 57)
        (and (>= c 80) (<= c 90)) (- c 58)
        (and (>= c 97) (<= c 107)) (- c 64)
        (and (>= c 109) (<= c 122)) (- c 65)
        :else -1))
(defn- en-b64-digit [c :i64] :i64
  (cond (and (>= c 65) (<= c 90)) (- c 65)
        (and (>= c 97) (<= c 122)) (- c 71)
        (and (>= c 48) (<= c 57)) (+ c 4)
        (= c 45) 62
        (= c 95) 63
        :else -1))
(defn- en-starts? [b :vector-i64 p :string] :bool
  (let [q (en-bytes p)]
    (if (< (vector-count b) (vector-count q)) false
      (loop [i 0] (if (= i (vector-count q)) true (if (= (vector-at b i) (vector-at q i)) (recur (+ i 1)) false))))))
(defn- en-slice [v :vector-i64 a :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ a i)))))))
(defn- en-did-raw [did :string] :vector-i64
  (let [b (en-bytes did) out (vector-alloc 35)]
    (cond (not (en-starts? b "did:key:z")) (vector-assoc! out 0 1)
          (and (> (vector-count b) 9) (= (vector-at b 9) 49)) (vector-assoc! out 0 2)
          :else
          (loop [i 9 acc out]
            (if (= i (vector-count b))
              (if (and (= (vector-at acc 1) 237) (= (vector-at acc 2) 1)) acc (vector-assoc! acc 0 4))
              (let [d (en-b58-digit (vector-at b i))]
                (if (< d 0) (vector-assoc! acc 0 3)
                  ;; acc[1..34] := acc[1..34] * 58 + d, big-endian
                  (let [carry (loop [j 34 c d]
                                (if (= j 0) c
                                  (let [x (+ (* (vector-at acc j) 58) c)
                                        z (vector-assoc! acc j (bit-and x 255))]
                                    (recur (- j 1) (u64-shift-right x 8)))))]
                    (if (> carry 0) (vector-assoc! acc 0 4) (recur (+ i 1) acc))))))))))
(defn did-key-problem [did :string] :string
  (case (vector-at (en-did-raw did) 0)
    0 "enroll/ok"
    1 "enroll/not-did-key"
    2 "enroll/did-key-not-canonical"
    3 "enroll/did-key-bad-base58"
    "enroll/did-key-not-ed25519"))
(defn did-key-public [did :string] :vector-i64
  (let [raw (en-did-raw did)]
    (if (= (vector-at raw 0) 0) (en-slice raw 3 32) (vector-alloc 0))))
(defn- en-div58 [b :vector-i64] :i64
  (loop [j 0 r 0]
    (if (= j (vector-count b)) r
      (let [x (+ (* r 256) (vector-at b j)) z (vector-assoc! b j (quot x 58))]
        (recur (+ j 1) (rem x 58))))))
(defn- en-zero? [b :vector-i64] :bool
  (loop [j 0] (if (= j (vector-count b)) true (if (= (vector-at b j) 0) (recur (+ j 1)) false))))
(defn- en-b58-encode [raw :vector-i64] :string
  (let [b (en-slice raw 0 (vector-count raw))
        ones (loop [j 0 s ""] (if (and (< j (vector-count raw)) (= (vector-at raw j) 0)) (recur (+ j 1) (string-concat s "1")) s))]
    (loop [out ""]
      (if (en-zero? b) (string-concat ones out)
        (let [r (en-div58 b)] (recur (string-concat (en-char (en-b58) r) out)))))))
(defn did-from-public [pk :vector-i64] :string
  (let [raw (vector-alloc 34) a (vector-assoc! raw 0 237) c (vector-assoc! raw 1 1)
        filled (loop [i 0 out raw] (if (= i 32) out (recur (+ i 1) (vector-assoc! out (+ i 2) (vector-at pk i)))))]
    (string-concat "did:key:z" (en-b58-encode filled))))
(defn- en-sig-raw [sig :string] :vector-i64
  (let [b (en-bytes sig) out (vector-alloc 65)]
    (if (not (= (vector-count b) 86)) (vector-assoc! out 0 1)
      (loop [i 0 acc 0 bits 0 k 1 o out]
        (if (= i 86)
          (if (= acc 0) o (vector-assoc! o 0 1))
          (let [d (en-b64-digit (vector-at b i))]
            (if (< d 0) (vector-assoc! o 0 1)
              (let [a2 (+ (* acc 64) d) b2 (+ bits 6)]
                (if (>= b2 8)
                  (let [bv (bit-and (u64-shift-right a2 (- b2 8)) 255)
                        left (bit-and a2 (- (i64-shift-left 1 (- b2 8)) 1))]
                    (recur (+ i 1) left (- b2 8) (+ k 1) (vector-assoc! o k bv)))
                  (recur (+ i 1) a2 b2 k o))))))))))
(defn- en-sig-ok? [sig :string] :bool (= (vector-at (en-sig-raw sig) 0) 0))
(defn- en-sig-bytes [sig :string] :vector-i64 (en-slice (en-sig-raw sig) 1 64))
(defn- en-b64-encode [v :vector-i64] :string
  (loop [i 0 acc 0 bits 0 out ""]
    (if (= i (vector-count v))
      (if (= bits 0) out (string-concat out (en-char (en-b64) (i64-shift-left acc (- 6 bits)))))
      (let [a2 (+ (* acc 256) (vector-at v i)) b2 (+ bits 8)]
        (if (>= b2 12)
          (let [hi (u64-shift-right a2 (- b2 6)) lo (u64-shift-right (bit-and a2 (- (i64-shift-left 1 (- b2 6)) 1)) (- b2 12))]
            (recur (+ i 1) (bit-and a2 (- (i64-shift-left 1 (- b2 12)) 1)) (- b2 12)
                   (string-concat out (string-concat (en-char (en-b64) hi) (en-char (en-b64) lo)))))
          (let [hi (u64-shift-right a2 (- b2 6))]
            (recur (+ i 1) (bit-and a2 (- (i64-shift-left 1 (- b2 6)) 1)) (- b2 6) (string-concat out (en-char (en-b64) hi)))))))))
(defn field-problem [s :string] :string
  (let [b (en-bytes s)]
    (if (> (vector-count b) 128) "enroll/field-too-long"
      (loop [i 0]
        (if (= i (vector-count b)) "enroll/ok"
          (let [c (vector-at b i)]
            (if (and (>= c 33) (<= c 126) (not (= c 34)) (not (= c 92))) (recur (+ i 1)) "enroll/field-charset")))))))
(defn sign-statement [seed :vector-i64 text :string] :string
  (let [out (vector-alloc 64) z (sign-into out seed (en-bytes text))]
    (en-b64-encode out)))
(defn statement-problem [did :string text :string sig :string] :string
  (cond (not (= (did-key-problem did) "enroll/ok")) (did-key-problem did)
        (not (en-sig-ok? sig)) "enroll/signature-encoding"
        (not (arena-scope (verify? (did-key-public did) (en-bytes text) (en-sig-bytes sig)))) "enroll/bad-signature"
        :else "enroll/ok"))
(defn cp [s :string i :i64] :i64 (string-code-point-at s i))
(defn- cp-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- cp-text [b :vector-i64] :string (string-from-utf8 (bytes-from-vector-i64 b)))
(defn- cp-arg [i :i64] :string (typed-cap-call 38 :string :string (string-from-i64 i)))
(defn- cp-say [s :string] :i64 (let [x (typed-cap-call 37 :string :string (str s "\n"))] 0))
(defn- cp-frame [op :string path :string tail :string] :string
  (str "\u0000FS2\u0000" op path "\u0000" tail))
(defn- cp-fs [op :string path :string tail :string] :string
  (let [r (typed-cap-call :fs/app-data :string :string (cp-frame op path tail))]
    (if (and (>= (string-byte-length r) 5) (= (string-substring r 0 5) "\u0000FS2\u0000"))
      (string-substring r 5 (string-length r)) "")))
(defn- cp-exists? [p :string] :bool (= (cp-fs "D" p "") "1"))
(defn- cp-read-op [p :string op :string tail :string] :vector-i64
  (let [r (typed-cap-call :fs/app-data :string :bytes (cp-frame op p tail)) n (bytes-count r)]
    (if (and (>= n 5) (= (bytes-at r 0) 0) (= (bytes-at r 1) 70) (= (bytes-at r 2) 83)
             (= (bytes-at r 3) 50) (= (bytes-at r 4) 0))
      (vector-i64-from-bytes (bytes-slice r 5 n)) (vector-alloc 0))))
(defn- cp-read [p :string] :vector-i64 (cp-read-op p "A" ""))
(defn- cp-cid [b :vector-i64] :string (digest-cid (str "sha256:" (sha256-hex b)) 85))
(defn- cp-hex? [s :string n :i64] :bool
  (let [b (cp-bytes s)]
    (and (= (vector-count b) n)
      (loop [i 0] (if (= i n) true
        (let [c (vector-at b i)] (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102))) (recur (+ i 1)) false)))))))
(defn- cp-raw? [s :string] :bool (= (cid-codec s) 85))
(defn- cp-safe-absolute? [s :string] :bool
  (and (> (string-length s) 1) (= (string-substring s 0 1) "/")
       (= (field-problem s) "enroll/ok")
       (< (string-index-of s "_SEP") 0) (< (string-index-of s "..") 0)))
(defn checkpoint-path? [s :string] :bool
  (let [b (cp-bytes s) n (vector-count b)]
    (and (> n 0) (<= n 120) (< (string-index-of s "_SEP") 0)
      (loop [i 0 start true]
        (if (= i n) (not start)
          (let [c (vector-at b i)]
            (cond (= c 47) (if start false (recur (+ i 1) true))
                  (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)) (and (>= c 48) (<= c 57)) (= c 95) (= c 45)) (recur (+ i 1) false)
                  (= c 46) (if start false (if (and (> i 0) (= (vector-at b (- i 1)) 46)) false (recur (+ i 1) false)))
                  :else false)))))))
(defn- cp-cut [b :vector-i64 start :i64] :i64
  (let [end (if (< (+ start 4096) (vector-count b)) (+ start 4096) (vector-count b))]
    (loop [i start]
      (cond (>= i end) end
            (or (= (vector-at b i) 87) (= (vector-at b i) 65)) (+ i 1)
            :else (recur (+ i 1))))))
(defn- cp-piece [p :string b :vector-i64 i :i64 e :i64 first :bool] :i64
  (let [prefix (cp-bytes (cp-frame (if first "B" "C") p "")) n (vector-count prefix)
        v (loop [k 0 v (vector-alloc (+ n (- e i)))]
            (if (= k (+ n (- e i))) v
              (recur (+ k 1) (vector-assoc! v k (if (< k n) (vector-at prefix k) (vector-at b (+ i (- k n))))))))
        z (typed-cap-call :fs/app-data :bytes :bytes (bytes-from-vector-i64 v))] 0))
(defn- cp-write [p :string b :vector-i64] :bool
  (let [z (loop [i 0 first true]
            (let [e (cp-cut b i) x (cp-piece p b i e first)]
              (if (= e (vector-count b)) 0 (recur e false))))
        flush (cp-fs "M" p "")]
    (and (= flush "1") (= (cp-cid (cp-read p)) (cp-cid b)))))
(defn- cp-put [store :string b :vector-i64] :string
  (let [cid (cp-cid b) p (str store "/" cid)]
    (if (or (> (vector-count b) 131072)
            (if (cp-exists? p) (not (= (cp-cid (cp-read p)) cid)) (not (cp-write p b)))) "" cid)))
(defn- cp-load [store :string cid :string] :vector-i64
  (if (and (cp-raw? cid) (cp-exists? (str store "/" cid))) (cp-read (str store "/" cid)) (vector-alloc 0)))
(defn- cp-block? [store :string cid :string] :bool
  (and (cp-raw? cid) (cp-exists? (str store "/" cid))
    (let [b (cp-read (str store "/" cid))] (and (<= (vector-count b) 131072) (= (cp-cid b) cid)))))
(defn- cp-str [b :vector-i64 o :i64 k :string] :string
  (let [v (json-member b o k)] (if (and (>= v 0) (= (json-kind b v) 3)) (json-string b v) "")))
(defn- cp-num [b :vector-i64 o :i64 k :string] :i64
  (let [v (json-member b o k)] (if (and (>= v 0) (= (json-kind b v) 4) (json-int-ok? b v)) (json-int b v) -1)))
(defn- cp-json [b :vector-i64 i :i64] :string
  (cp-text (json-canonical-bytes b i)))
(defn- cp-payload [b :vector-i64] :i64 (json-member b 0 "payload"))
(defn- cp-no-overlap? [b :vector-i64 us :i64 upto :i64 path :string] :bool
  (loop [i 0]
    (if (= i upto) true
      (let [prior (cp-str b (json-element b us i) "path")]
        (if (or (= prior path) (= (string-index-of path (str prior "/")) 0)
                (= (string-index-of prior (str path "/")) 0)) false (recur (+ i 1)))))))
(defn checkpoint-problem [b :vector-i64 author :string profile :string policy :string environment :string
                          epoch :i64 parent :string task :string] :string
  (if (or (> (vector-count b) 8192) (not (json-canonical? b))) "checkpoint/noncanonical"
    (let [p (cp-payload b) us (if (>= p 0) (json-member b p "untracked") -1)
          did (if (>= p 0) (cp-str b p "did") "")]
      (cond (or (not (= (json-kind b 0) 1)) (not (= (json-count b 0) 2)) (< p 0)
                (not (= (json-kind b p) 1)) (not (= (json-count b p) 13))
                (= task "") (not (= (field-problem task) "enroll/ok"))) "checkpoint/schema"
            (not (= (cp-str b p "kind") "itonami.git-checkpoint/1")) "checkpoint/kind"
            (not (= did author)) "checkpoint/author"
            (not (= (statement-problem did (cp-json b p) (cp-str b 0 "signature")) "enroll/ok")) "checkpoint/signature"
            (not (= (cp-str b p "profile") profile)) "checkpoint/profile"
            (not (= (cp-str b p "policy") policy)) "checkpoint/policy"
            (not (= (cp-str b p "environment") environment)) "checkpoint/environment"
            (or (< epoch 1) (not (= (cp-num b p "epoch") epoch))) "checkpoint/epoch"
            (not (= (cp-str b p "parent") parent)) "checkpoint/parent"
            (not (= (cp-str b p "task") task)) "checkpoint/task"
            (or (not (cp-hex? (cp-str b p "head") 40))
                (not (or (= (cp-str b p "stash") "none") (cp-hex? (cp-str b p "stash") 40)))) "checkpoint/git-id"
            (or (not (= (digest-problem profile) "oci/ok")) (not (cp-raw? policy)) (not (cp-raw? environment))
                (not (cp-raw? (cp-str b p "bundle"))) (not (cp-raw? (cp-str b p "summary")))
                (not (or (= parent "root") (cp-raw? parent)))) "checkpoint/cid"
            (or (< us 0) (not (= (json-kind b us) 2)) (> (json-count b us) 16)) "checkpoint/untracked"
            :else (loop [i 0 previous ""]
              (if (= i (json-count b us)) "checkpoint/ok"
                (let [u (json-element b us i) path (cp-str b u "path") cid (cp-str b u "cid") mode (cp-str b u "mode")]
                  (if (and (= (json-kind b u) 1) (= (json-count b u) 3) (checkpoint-path? path) (cp-raw? cid)
                           (or (= mode "644") (= mode "755"))
                           (> (string-compare path previous) 0) (cp-no-overlap? b us i path))
                    (recur (+ i 1) path) "checkpoint/untracked-path"))))))))
(defn- cp-spawn [s :string] :string (typed-cap-call 20 :string :string s))
(defn- cp-out [s :string] :string
  (let [i (string-index-of s "\n")] (if (< i 0) "" (string-substring s (+ i 1) (string-length s)))))
(defn- cp-ok? [s :string] :bool (= (string-index-of s "0\n") 0))
(defn- cp-line [s :string] :string
  (let [i (string-index-of s "\n")] (if (< i 0) s (string-substring s 0 i))))
(defn- cp-a [] :string "ARG_SEP")
(defn- cp-git [repo :string args :string] :string
  (cp-spawn (str "/usr/bin/git" (cp-a) "--no-pager" (cp-a) "-c" (cp-a) "core.hooksPath=/dev/null"
    (cp-a) "-c" (cp-a) "core.fsmonitor=false" (cp-a) "-c" (cp-a) "gc.auto=0"
    (cp-a) "-c" (cp-a) "core.autocrlf=false" (cp-a) "-c" (cp-a) "core.attributesFile=/dev/null"
    (cp-a) "-c" (cp-a) "commit.gpgSign=false"
    (cp-a) "-c" (cp-a) "user.name=Itonami checkpoint"
    (cp-a) "-c" (cp-a) "user.email=checkpoint@example.invalid"
    (cp-a) "-C" (cp-a) repo (cp-a) args)))
(defn- cp-seed [p :string] :vector-i64
  (let [s (cp-line (cp-text (cp-read p)))] (if (cp-hex? s 64) (hex-bytes s) (vector-alloc 0))))
(defn- cp-int [s :string] :i64
  (let [b (cp-bytes s)] (if (or (= (vector-count b) 0) (> (vector-count b) 9)) -1
    (loop [i 0 n 0] (if (= i (vector-count b)) n
      (let [c (vector-at b i)] (if (and (>= c 48) (<= c 57)) (recur (+ i 1) (+ (* n 10) (- c 48))) -1)))))))
(defn- cp-meta-field [s :string wanted :i64] :string
  (let [b (cp-bytes s) n (vector-count b)]
    (loop [i 0 start 0 field 0]
      (cond (= i n) (if (= field wanted) (string-substring s start i) "")
            (= (vector-at b i) 32) (if (= field wanted) (string-substring s start i) (recur (+ i 1) (+ i 1) (+ field 1)))
            :else (recur (+ i 1) start field)))))
(defn- cp-kind [p :string] :string (cp-meta-field (cp-fs "O" p "") 3))
(defn- cp-size [p :string] :i64
  (let [m (cp-fs "O" p "")]
    (if (= (cp-meta-field m 3) "0") (cp-int (cp-meta-field m 1)) -1)))
(defn- cp-mkdir [p :string] :bool
  (or (= (cp-fs "I" p "") "1") (= (cp-kind p) "1")))
(defn- cp-real-parents? [base :string rel :string create :bool] :bool
  (loop [i 0]
    (if (= i (string-length rel)) true
      (if (not (= (string-substring rel i (+ i 1)) "/")) (recur (+ i 1))
        (let [p (str base "/" (string-substring rel 0 i))
              before (cp-kind p)
              made (if (and create (= before "")) (cp-mkdir p) false)
              after (if made (cp-kind p) before)]
          (if (= after "1") (recur (+ i 1)) false))))))
(defn- cp-range [p :string off :i64 n :i64] :vector-i64 (cp-read-op p "E" (str off ":" n)))
(defn- cp-chunk-size [size :i64 i :i64] :i64
  (let [remaining (- size (* i 131072))] (if (< remaining 131072) remaining 131072)))
(defn- cp-save-chunk [store :string path :string size :i64 i :i64 ids :vector-i64] :bool
  (arena-scope
    (let [cid (cp-put store (cp-range path (* i 131072) (cp-chunk-size size i))) b (cp-bytes cid)]
      (and (= (vector-count b) 59)
        (loop [k 0] (if (= k 59) true
          (let [z (vector-assoc! ids (+ (* i 59) k) (vector-at b k))] (recur (+ k 1)))))))))
(defn- cp-chunk-id [ids :vector-i64 i :i64] :string
  (let [b (loop [k 0 b (vector-alloc 59)]
            (if (= k 59) b (recur (+ k 1) (vector-assoc! b k (vector-at ids (+ (* i 59) k))))))]
    (cp-text b)))
(defn- cp-save-bundle [store :string path :string] :string
  (let [size (cp-size path)]
    (if (or (< size 1) (> size 67108864)) ""
      (let [n (quot (+ size 131071) 131072) ids (vector-alloc (* n 59))
            saved (loop [i 0] (if (= i n) true (if (cp-save-chunk store path size i ids) (recur (+ i 1)) false)))
            chunks (if saved (loop [i 0 out "["]
                     (if (= i n) (str out "]")
                       (recur (+ i 1) (str out (if (= i 0) "" ",") "\"" (cp-chunk-id ids i) "\"")))) "")]
        (if (= chunks "") "" (cp-put store (cp-bytes (str "{\"chunks\":" chunks ",\"kind\":\"itonami.git-bundle/1\",\"size\":" size "}"))))))))
(defn- cp-bundle? [store :string cid :string] :bool
  (if (not (cp-block? store cid)) false
    (let [b (cp-load store cid)]
      (if (not (json-canonical? b)) false
        (let [chunks (json-member b 0 "chunks") size (cp-num b 0 "size")]
          (and (= (json-kind b 0) 1) (= (json-count b 0) 3)
            (= (cp-str b 0 "kind") "itonami.git-bundle/1") (> size 0) (<= size 67108864)
            (>= chunks 0) (= (json-kind b chunks) 2) (= (json-count b chunks) (quot (+ size 131071) 131072))
            (loop [i 0]
              (if (= i (json-count b chunks)) true
                (if (arena-scope (let [el (json-element b chunks i) c (if (= (json-kind b el) 3) (json-string b el) "")]
                      (and (cp-block? store c) (= (cp-size (str store "/" c)) (cp-chunk-size size i)))))
                  (recur (+ i 1)) false)))))))))
(defn- cp-assemble-bundle [store :string cid :string] :bool
  (let [b (cp-load store cid) chunks (json-member b 0 "chunks") size (cp-num b 0 "size") path (str store "/" cid ".bundle")
        written (loop [i 0]
                  (if (= i (json-count b chunks)) true
                    (if (arena-scope
                          (let [data (cp-load store (json-string b (json-element b chunks i)))
                                z (loop [p 0]
                                    (let [e (cp-cut data p) w (cp-piece path data p e (and (= i 0) (= p 0)))]
                                      (if (= e (vector-count data)) 0 (recur e))))] true))
                      (recur (+ i 1)) false)))
        flush (cp-fs "M" path "")]
    (and written (= flush "1") (= (cp-size path) size)
      (loop [i 0]
        (if (= i (json-count b chunks)) true
          (if (arena-scope (= (cp-cid (cp-range path (* i 131072) (cp-chunk-size size i))) (json-string b (json-element b chunks i))))
            (recur (+ i 1)) false))))))
(defn- cp-capture-untracked [repo :string store :string list :vector-i64] :string
  (if (or (not (json-canonical? list)) (not (= (json-kind list 0) 2)) (> (json-count list 0) 16)) ""
    (loop [i 0 prev "" out "["]
      (if (= i (json-count list 0)) (str out "]")
        (let [el (json-element list 0 i) path (if (= (json-kind list el) 3) (json-string list el) "")
              admitted (and (checkpoint-path? path) (> (string-compare path prev) 0)
                         (= (string-index-of (cp-git repo (str "ls-files" (cp-a) "--error-unmatch" (cp-a) "--" (cp-a) path)) "1\n") 0)
                         (= (string-index-of (cp-git repo (str "check-ignore" (cp-a) "--" (cp-a) path)) "1\n") 0))
              st (if admitted (cp-fs "U" (str repo "/" path) "") "")
              kind (cp-meta-field st 3) bits (cp-meta-field st 0)
              mode (cond (and (= kind "0") (= bits "420")) "644"
                         (and (= kind "0") (= bits "493")) "755" :else "")
              cid (if (and (not (= mode "")) (cp-real-parents? repo path false)) (cp-put store (cp-read (str repo "/" path))) "")]
          (if (= cid "") "" (recur (+ i 1) path (str out (if (= i 0) "" ",") "{\"cid\":\"" cid "\",\"mode\":\"" mode "\",\"path\":\"" path "\"}"))))))))
(defn- cp-capture [] :i64
  (let [repo (cp-arg 1) store (cp-arg 2) seed (cp-seed (cp-arg 3))
        epoch (cp-int (cp-arg 9)) parent (cp-arg 10) task (cp-arg 11)]
    (if (or (not (cp-safe-absolute? repo)) (not (cp-safe-absolute? store)) (not (= (vector-count seed) 32))
            (< epoch 1) (= task "") (not (= (field-problem task) "enroll/ok")))
      (cp-say "checkpoint/capture-arguments")
      (let [head-r (cp-git repo "rev-parseARG_SEP--verifyARG_SEPHEAD") head (cp-line (cp-out head-r))
            status (cp-git repo "statusARG_SEP--porcelain=v1ARG_SEP--untracked-files=no")
            modes (cp-git repo "ls-filesARG_SEP--format=%(objectmode)")
            attrs (cp-git repo "ls-filesARG_SEP--ARG_SEP.gitattributesARG_SEP:(glob)**/.gitattributes")
            filters (cp-git repo "configARG_SEP--get-regexpARG_SEP^filter[.]")
            stash-r (if (and (cp-ok? head-r) (cp-ok? status) (cp-ok? modes) (< (string-index-of (cp-out modes) "160000\n") 0)
                            (cp-ok? attrs) (= (cp-out attrs) "") (= (string-index-of filters "1\n") 0))
                      (cp-git repo "stashARG_SEPcreateARG_SEPitonami-checkpoint") "refused")
            stash0 (cp-line (cp-out stash-r)) stash (if (= stash0 "") "none" stash0)
            ref (str "refs/itonami/checkpoints/" (if (= stash "none") head stash))
            update (if (and (cp-ok? stash-r) (cp-hex? head 40) (or (= stash "none") (cp-hex? stash 40)))
                     (cp-git repo (str "update-ref" (cp-a) ref (cp-a) (if (= stash "none") head stash))) "refused")
            bundle-path (str store "/" (if (= stash "none") head stash) ".bundle")
            bundle-r (if (cp-ok? update) (cp-git repo (str "bundle" (cp-a) "create" (cp-a) bundle-path (cp-a) "HEAD" (cp-a) ref)) "refused")]
        (if (not (cp-ok? bundle-r)) (cp-say (str "checkpoint/git-capture " bundle-r " stash " stash-r))
          (let [bundle (cp-save-bundle store bundle-path) profile-bytes (cp-read (cp-arg 4))
                profile-cid (cp-put store profile-bytes) profile (str "sha256:" (sha256-hex profile-bytes))
                policy (cp-put store (cp-read (cp-arg 5))) environment (cp-put store (cp-read (cp-arg 6)))
                summary (cp-put store (cp-read (cp-arg 7))) us (cp-capture-untracked repo store (cp-read (cp-arg 8)))
                did (did-from-public (public-from-seed seed))
                payload (str "{\"bundle\":\"" bundle "\",\"did\":\"" did "\",\"environment\":\"" environment
                  "\",\"epoch\":" epoch ",\"head\":\"" head "\",\"kind\":\"itonami.git-checkpoint/1\",\"parent\":\"" parent
                  "\",\"policy\":\"" policy "\",\"profile\":\"" profile "\",\"stash\":\"" stash
                  "\",\"summary\":\"" summary "\",\"task\":\"" task "\",\"untracked\":" (if (= us "") "null" us) "}")
                envelope (cp-bytes (str "{\"payload\":" payload ",\"signature\":\"" (sign-statement seed payload) "\"}"))
                verdict (checkpoint-problem envelope did profile policy environment epoch parent task)]
            (if (or (= bundle "") (= profile-cid "") (= policy "") (= environment "") (= summary "") (= us "")
                    (not (= status (cp-git repo "statusARG_SEP--porcelain=v1ARG_SEP--untracked-files=no")))
                    (not (= head-r (cp-git repo "rev-parseARG_SEP--verifyARG_SEPHEAD"))))
              (cp-say "checkpoint/capture-incomplete-or-busy")
              (if (not (= verdict "checkpoint/ok")) (cp-say verdict)
                (let [cid (cp-put store envelope)]
                  (if (= cid "") (cp-say "checkpoint/root-publication-failed")
                    (cp-say (str "checkpoint/created " cid "\n" (cp-text envelope)))))))))))))
(defn- cp-closure? [store :string b :vector-i64] :bool
  (let [p (cp-payload b) us (json-member b p "untracked")]
    (and (cp-bundle? store (cp-str b p "bundle")) (cp-block? store (cp-str b p "policy"))
         (cp-block? store (cp-str b p "environment")) (cp-block? store (cp-str b p "summary"))
         (cp-block? store (digest-cid (cp-str b p "profile") 85))
         (loop [i 0] (if (= i (json-count b us)) true
           (if (cp-block? store (cp-str b (json-element b us i) "cid")) (recur (+ i 1)) false))))))
(defn- cp-parent-dir [p :string] :string
  (loop [i (- (string-length p) 1)] (if (< i 1) "/" (if (= (string-substring p i (+ i 1)) "/") (string-substring p 0 i) (recur (- i 1))))))
(defn- cp-materialize [store :string b :vector-i64 dest :string] :string
  (let [p (cp-payload b) head (cp-str b p "head") stash (cp-str b p "stash")
        stage (str dest ".partial") ref (str "refs/itonami/checkpoints/" (if (= stash "none") head stash))
        bundle (str store "/" (cp-str b p "bundle") ".bundle")]
    (cond (not (cp-safe-absolute? dest)) "checkpoint/destination"
          (or (cp-exists? dest) (cp-exists? stage)) "checkpoint/destination-exists"
          (not (cp-assemble-bundle store (cp-str b p "bundle"))) "checkpoint/bundle-assembly"
          (not (= (cp-fs "I" stage "") "1")) "checkpoint/mkdir"
          :else
          (let [init (cp-git stage "initARG_SEP--quietARG_SEP--template=")
                fetch (if (cp-ok? init) (cp-git stage (str "-c" (cp-a) "protocol.file.allow=always" (cp-a) "fetch" (cp-a) "--no-tags" (cp-a) bundle (cp-a) (str ref ":" ref))) "refused")
                checkout (if (cp-ok? fetch) (cp-git stage (str "checkout" (cp-a) "--quiet" (cp-a) "--detach" (cp-a) head)) "refused")
                apply (if (and (cp-ok? checkout) (not (= stash "none"))) (cp-git stage (str "stash" (cp-a) "apply" (cp-a) "--index" (cp-a) ref)) checkout)
                fsck (if (cp-ok? apply) (cp-git stage "fsckARG_SEP--fullARG_SEP--strict") "refused")
                us (json-member b p "untracked")
                files (if (cp-ok? fsck)
                  (loop [i 0]
                    (if (= i (json-count b us)) true
                      (let [u (json-element b us i) path (str stage "/" (cp-str b u "path"))]
                        (if (and (cp-real-parents? stage (cp-str b u "path") true) (not (cp-exists? path)) (cp-write path (cp-load store (cp-str b u "cid")))
                                 (= (cp-fs "H" path (cp-str b u "mode")) "1"))
                          (recur (+ i 1)) false)))) false)]
            (if (not files) "checkpoint/materialize-failed-partial-retained"
              (let [sync (cp-fs "M" stage "")
                    rename (if (= sync "1") (cp-fs "T" stage dest) "0")
                    parent-sync (if (= rename "1") (cp-fs "M" (cp-parent-dir dest) "") "0")]
                (if (and (= rename "1") (= parent-sync "1")) "checkpoint/restored" "checkpoint/publish-failed")))))))
(defn- cp-closure-list [store :string cid :string b :vector-i64] :i64
  (let [p (cp-payload b) bundle (cp-str b p "bundle") index (cp-load store bundle)
        chunks (json-member index 0 "chunks") us (json-member b p "untracked")
        a (cp-say (str "checkpoint/block " cid))
        d (cp-say (str "checkpoint/block " bundle))
        e (cp-say (str "checkpoint/block " (cp-str b p "policy")))
        f (cp-say (str "checkpoint/block " (cp-str b p "environment")))
        g (cp-say (str "checkpoint/block " (cp-str b p "summary")))
        h (cp-say (str "checkpoint/block " (digest-cid (cp-str b p "profile") 85)))
        i (loop [n 0] (if (= n (json-count b us)) 0
            (let [x (cp-say (str "checkpoint/block " (cp-str b (json-element b us n) "cid")))] (recur (+ n 1)))))
        j (loop [n 0] (if (= n (json-count index chunks)) 0
            (let [x (cp-say (str "checkpoint/block " (json-string index (json-element index chunks n))))] (recur (+ n 1)))))]
    (cp-say "checkpoint/closure-complete")))
(defn- cp-restore [] :i64
  (let [store (cp-arg 1) cid (cp-arg 2)]
    (if (not (cp-block? store cid)) (cp-say "checkpoint/missing-or-corrupt-root")
      (let [b (cp-load store cid)
            v (checkpoint-problem b (cp-arg 3) (cp-arg 4) (cp-arg 5) (cp-arg 6) (cp-int (cp-arg 7)) (cp-arg 8) (cp-arg 9))]
        (cond (not (= v "checkpoint/ok")) (cp-say v)
              (not (cp-closure? store b)) (cp-say "checkpoint/missing-or-corrupt-block")
              (= (cp-arg 0) "verify") (cp-say "checkpoint/verified")
              (= (cp-arg 0) "closure") (cp-closure-list store cid b)
              :else (cp-say (cp-materialize store b (cp-arg 10))))))))
(defn- cp-recovery [] :i64
  (let [store (cp-arg 1) from (cp-arg 2) to (cp-arg 3) seed (cp-seed (cp-arg 4)) task (cp-arg 5)]
    (if (or (not (= (vector-count seed) 32)) (not (cp-block? store from)) (not (cp-block? store to)))
      (cp-say "recovery/missing-input")
      (let [a (cp-load store from) b (cp-load store to)]
        (if (or (not (json-canonical? a)) (not (json-canonical? b))
                (< (cp-payload a) 0) (< (cp-payload b) 0)) (cp-say "recovery/noncanonical")
          (let [pa (cp-payload a) pb (cp-payload b) did (did-from-public (public-from-seed seed))
                ea (if (>= pa 0) (cp-num a pa "epoch") -1) eb (if (>= pb 0) (cp-num b pb "epoch") -1)
                va (checkpoint-problem a (cp-str a pa "did") (cp-str a pa "profile") (cp-str a pa "policy")
                     (cp-str a pa "environment") ea (cp-str a pa "parent") task)
                vb (checkpoint-problem b did (cp-str a pa "profile") (cp-str a pa "policy")
                     (cp-str a pa "environment") eb from task)]
            (if (or (not (= va "checkpoint/ok")) (not (= vb "checkpoint/ok")) (<= eb ea)
                    (not (cp-closure? store a)) (not (cp-closure? store b)))
              (cp-say "recovery/contract")
              (let [text (str "{\"checkpoint\":\"" from "\",\"did\":\"" did "\",\"epoch\":" eb
                           ",\"kind\":\"itonami.recovery/1\",\"resumed\":\"" to "\",\"task\":\"" task "\"}")
                    envelope (cp-bytes (str "{\"payload\":" text ",\"signature\":\"" (sign-statement seed text) "\"}"))
                    cid (cp-put store envelope)]
                (cp-say (str "recovery/recorded " cid "\n" (cp-text envelope)))))))))))
(defn- cp-verify-recovery [] :i64
  (let [store (cp-arg 1) cid (cp-arg 2)]
    (if (not (cp-block? store cid)) (cp-say "recovery/missing-or-corrupt")
      (let [b (cp-load store cid)]
        (if (not (json-canonical? b)) (cp-say "recovery/noncanonical")
          (let [p (cp-payload b) did (cp-arg 3)]
            (cond (or (< p 0) (not (= (json-kind b 0) 1)) (not (= (json-count b 0) 2))
                      (not (= (json-kind b p) 1)) (not (= (json-count b p) 6))) (cp-say "recovery/schema")
                  (or (not (= (cp-str b p "kind") "itonami.recovery/1")) (not (= (cp-str b p "did") did))
                      (not (= (cp-str b p "checkpoint") (cp-arg 4))) (not (= (cp-str b p "resumed") (cp-arg 5)))
                      (not (= (cp-str b p "task") (cp-arg 6))) (< (cp-int (cp-arg 7)) 1)
                      (not (= (cp-num b p "epoch") (cp-int (cp-arg 7))))) (cp-say "recovery/contract")
                  (not (= (statement-problem did (cp-json b p) (cp-str b 0 "signature")) "enroll/ok")) (cp-say "recovery/signature")
                  :else (cp-say "recovery/verified"))))))))
(defn checkpoint-main [] :i64
  (cond (= (cp-arg 0) "capture") (cp-capture)
        (or (= (cp-arg 0) "restore") (= (cp-arg 0) "verify") (= (cp-arg 0) "closure")) (cp-restore)
        (= (cp-arg 0) "recovery") (cp-recovery)
        (= (cp-arg 0) "verify-recovery") (cp-verify-recovery)
        :else (cp-say "checkpoint/command")))
(defn lower [c :i64] :i64 (if (and (>= c 65) (<= c 90)) (+ c 32) c))


(defn- ga-repo? [s :string] :bool
  (let [b (cp-bytes s) n (vector-count b)]
    (and (> n 2) (<= n 120)
      (loop [i 0 slashes 0 segment 0]
        (if (= i n) (and (= slashes 1) (> segment 0))
          (let [c (vector-at b i)]
            (cond (= c 47) (and (= slashes 0) (> segment 0) (recur (+ i 1) 1 0))
                  (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90))
                      (and (>= c 48) (<= c 57)) (= c 45) (= c 95))
                    (recur (+ i 1) slashes (+ segment 1))
                  :else false)))))))

(defn- ga-private? [gh :string repo :string] :bool
  (let [answer (cp-spawn (str gh (cp-a) "api" (cp-a) "--hostname" (cp-a) "github.com"
                     (cp-a) (str "repos/" repo) (cp-a) "--jq" (cp-a) "[.full_name,.private] | @tsv"))]
    (and (cp-ok? answer) (= (cp-out answer) (str repo "\ttrue\n")))))

;; Reject effective Git configuration that can redirect transport, weaken TLS,
;; load external helpers, or expand configuration. --name-only avoids emitting
;; configured values. Exit 1 with no output means no matching keys; any other
;; outcome is a refusal. The host must still restrict the child environment and
;; network/credential authority; Git configuration is not the whole boundary.
(defn- ga-config-safe? [repo-dir :string] :bool
  (= (cp-git repo-dir (str "config" (cp-a) "--name-only" (cp-a) "--get-regexp" (cp-a)
    "^(url[.].*[.](insteadof|pushinsteadof)|http([.].*)?[.](proxy|sslverify|sslcainfo|followredirects)|remote[.].*[.]proxy|credential([.].*)?[.]helper|include([.].*)?[.]path)$")) "1\n"))

;; Transport explicitly enforces TLS verification and disables redirects. The
;; config check above also rejects URL-scoped settings that could override them.
(defn- ga-git [repo-dir :string args :string] :string
  (cp-git repo-dir (str "-c" (cp-a) "http.sslVerify=true" (cp-a) "-c" (cp-a)
                         "http.followRedirects=false" (cp-a) args)))

;; Never copy an unverified object. The caller keeps the source store
;; quiescent and the private task directory exclusively owned throughout.
(defn- ga-copy [store :string out :string cid :string] :bool
  (if (not (cp-block? store cid)) false
    (let [path (str out "/" cid) data (cp-load store cid)]
      (if (cp-exists? path) (cp-block? out cid)
        (and (cp-write path data) (cp-block? out cid))))))

(defn- ga-copy-closure [store :string out :string cid :string b :vector-i64] :bool
  (let [p (cp-payload b) bundle (cp-str b p "bundle") index (cp-load store bundle)
        chunks (json-member index 0 "chunks") us (json-member b p "untracked")]
    (and (ga-copy store out cid) (ga-copy store out bundle)
         (ga-copy store out (cp-str b p "policy")) (ga-copy store out (cp-str b p "environment"))
         (ga-copy store out (cp-str b p "summary"))
         (ga-copy store out (digest-cid (cp-str b p "profile") 85))
         (loop [i 0] (if (= i (json-count b us)) true
           (if (arena-scope (ga-copy store out (cp-str b (json-element b us i) "cid"))) (recur (+ i 1)) false)))
         (loop [i 0] (if (= i (json-count index chunks)) true
           (if (arena-scope (ga-copy store out (json-string index (json-element index chunks i)))) (recur (+ i 1)) false))))))

(defn- ga-verified? [store :string cid :string author :string profile :string policy :string environment :string
                     epoch :i64 parent :string task :string] :bool
  (and (cp-block? store cid)
       (let [b (cp-load store cid)]
         (and (= (checkpoint-problem b author profile policy environment epoch parent task) "checkpoint/ok")
              (cp-closure? store b)))))

;; A fixed private repository, non-force ref and independent fetch are
;; mandatory. A push acknowledgement alone is never success. Work is a fresh,
;; host-allocated task path: failure retains it for reconciliation. In
;; particular a timed-out Git child may still have descendants; the host must
;; not retry or reuse the directory while its state is unknown.
(defn- ga-archive [work :string store :string cid :string author :string profile :string policy :string environment :string
                   epoch :i64 parent :string task :string repo :string gh :string] :string
  (cond (or (not (cp-safe-absolute? work)) (not (cp-safe-absolute? store))
            (not (cp-safe-absolute? gh)) (= work store) (not (ga-repo? repo))
            (not (cp-raw? cid)) (not (ga-verified? store cid author profile policy environment epoch parent task))) "archive/input-refused"
        (not (ga-private? gh repo)) "archive/private-repository-unverified"
        (not (= (cp-fs "I" work "") "1")) "archive/work-exists-or-unavailable"
        (not (= (cp-fs "H" work "700") "1")) "archive/work-permissions"
        :else
        (let [repo-dir (str work "/repo") blocks (str repo-dir "/blocks") readback (str work "/readback")
              b (cp-load store cid) remote (str "file:///var/tmp/awai150-guard/remote.git")
              ref (str "refs/heads/itonami/archive/" cid)
              manifest (cp-bytes (str "{\"author\":\"" author "\",\"environment\":\"" environment
                "\",\"epoch\":" epoch ",\"kind\":\"itonami.github-checkpoint-archive/1\",\"parent\":\"" parent
                "\",\"policy\":\"" policy "\",\"profile\":\"" profile "\",\"root\":\"" cid "\",\"task\":\"" task "\"}"))
              created-repo (= (cp-fs "I" repo-dir "") "1")
              init (if created-repo (cp-git repo-dir "initARG_SEP--quietARG_SEP--template=") "refused")
              config-safe (and (cp-ok? init) (ga-config-safe? repo-dir))
              ready (and config-safe (= (cp-fs "I" blocks "") "1")
                         (ga-copy-closure store blocks cid b) (ga-verified? blocks cid author profile policy environment epoch parent task)
                         (cp-write (str repo-dir "/manifest.json") manifest))
              add (if ready (cp-git repo-dir "addARG_SEP--ARG_SEPblocksARG_SEPmanifest.json") "refused")
              commit (if (cp-ok? add) (cp-git repo-dir "commitARG_SEP--quietARG_SEP-mARG_SEPArchive verified checkpoint") "refused")
              tree-out (if (cp-ok? commit) (cp-git repo-dir "rev-parseARG_SEPHEAD^{tree}") "refused")
              tree (cp-line (cp-out tree-out))]
          (if (not config-safe) "archive/git-config-refused"
          (if (not (and (cp-ok? tree-out) (cp-hex? tree 40))) "archive/staging-refused"
            (let [push (ga-git repo-dir (str "push" (cp-a) "--quiet" (cp-a) remote (cp-a) "HEAD:" ref))
                  created (= (cp-fs "I" readback "") "1")
                  ri (if created (cp-git readback "initARG_SEP--quietARG_SEP--template=") "refused")
                  fetch (if (and (cp-ok? ri) (ga-config-safe? readback)) (ga-git readback (str "fetch" (cp-a) "--quiet" (cp-a) "--no-tags" (cp-a) remote (cp-a) ref)) "refused")
                  got (if (cp-ok? fetch) (cp-git readback "rev-parseARG_SEPFETCH_HEAD^{tree}") "refused")
                  check (if (and (cp-ok? got) (= (cp-line (cp-out got)) tree)) (cp-git readback "fsckARG_SEP--fullARG_SEP--strict") "refused")
                  checkout (if (cp-ok? check) (cp-git readback "checkoutARG_SEP--quietARG_SEPFETCH_HEADARG_SEP--ARG_SEPblocksARG_SEPmanifest.json") "refused")
                  verified (and (cp-ok? checkout) (= (cp-cid (cp-read (str readback "/manifest.json"))) (cp-cid manifest))
                                (ga-verified? (str readback "/blocks") cid author profile policy environment epoch parent task))]
              (if verified (str "archive/stored " cid " " tree " " (if (cp-ok? push) "acknowledged" "unacknowledged"))
                "archive/readback-unknown-or-conflict")))))))

(defn github-checkpoint-archive-main [] :i64
  (cp-say (ga-archive (cp-arg 0) (cp-arg 1) (cp-arg 2) (cp-arg 3) (cp-arg 4) (cp-arg 5) (cp-arg 6)
                      (cp-int (cp-arg 7)) (cp-arg 8) (cp-arg 9) (cp-arg 10) (cp-arg 11))))




;; Stubbed head/retention admission; archive, Git, FS and acknowledgement are real.
(defn- rt-now [] :i64 100000)
(defn- rt-archive [cfg :vector-i64] :string
  (if (cp-exists? "/var/tmp/awai150-guard/changed") "resident/archive-refused"
    (str "resident/archive " (cp-str cfg 0 "root") " " (cp-str cfg 0 "author") " " (cp-str cfg 0 "profile")
         " " (cp-str cfg 0 "policy") " " (cp-str cfg 0 "environment") " 1 root fixture-task "
         (cp-str cfg 0 "store") " " (cp-str cfg 0 "ack"))))

(defn- rt-archive-native [cfg :vector-i64 work :string repo :string gh :string] :string
  (let [descriptor (rt-archive cfg)
        root (ln-field descriptor 1) author (ln-field descriptor 2) profile (ln-field descriptor 3)
        policy (ln-field descriptor 4) environment (ln-field descriptor 5) epoch-text (ln-field descriptor 6)
        parent (ln-field descriptor 7) task (ln-field descriptor 8) store (ln-field descriptor 9) ack (ln-field descriptor 10)
        exact (str "resident/archive " root " " author " " profile " " policy " " environment " " epoch-text
                   " " parent " " task " " store " " ack)]
    (if (or (not (= descriptor exact)) (not (cp-safe-absolute? ack))
            (= work ack) (= work (str ack ".tmp"))) "resident-archive/head-refused"
      (let [result (ga-archive work store root author profile policy environment (cp-int epoch-text) parent task repo gh)
            tree (ln-field result 2) outcome (ln-field result 3)
            valid (and (cp-hex? tree 40) (or (= outcome "acknowledged") (= outcome "unacknowledged"))
                       (= result (str "archive/stored " root " " tree " " outcome)))
            now (rt-now) current (= (rt-archive cfg) descriptor)
            tmp (str ack ".tmp")
            until (if (and (> now 0) (<= now 9223372036853875807)) (+ now 900000) 0)
            body (cp-bytes (str "{\"checkpoint\":\"" root "\",\"kind\":\"itonami.github-archive-ack/1\",\"tree\":\""
                                tree "\",\"until\":" until "}"))
            prepared (and valid current (> until 0)
                          (not (cp-exists? tmp)) (cp-write tmp body))
            moved (if prepared (cp-fs "L" tmp ack) "0")
            synced (if (= moved "1") (cp-fs "M" (cp-parent-dir ack) "") "0")]
        (if (= synced "1") (str "resident-archive/confirmed " root " " tree)
          "resident-archive/unconfirmed")))))


(defn main [] :i64
 (let [cfg (cp-read (cp-arg 0)) r (rt-archive-native cfg (cp-arg 1) "cloud-itonami/itonami-bot-state" (cp-arg 2))]
   (cp-say r)))

(defn- ln-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))


(defn- ln-field [line :string k :i64] :string
  (let [b (ln-bytes line)]
    (loop [i 0 start 0 n 0]
      (cond (= i (vector-count b)) (if (= n k) (string-substring line start i) "")
            (or (= (vector-at b i) 32) (= (vector-at b i) 10)) (if (= n k) (string-substring line start i) (recur (+ i 1) (+ i 1) (+ n 1)))
            :else (recur (+ i 1) start n)))))

