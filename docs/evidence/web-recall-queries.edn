;; Fixed query set for comparing Phase 1 (federated live search) with Phase 2 (own
;; index over a crawled corpus) — ADR-260929 M3/M5. 24 English Wikipedia articles
;; are the corpus; each query describes exactly one of them WITHOUT using its title.
;; Small on purpose: n=24 supports "does it work / roughly how do they compare",
;; not fine-grained ranking claims.
{:corpus
 ["Distributed_hash_table" "Raft_(algorithm)" "Paxos_(computer_science)" "Merkle_tree"
  "InterPlanetary_File_System" "BitTorrent" "Content-addressable_storage" "Consistent_hashing"
  "Gossip_protocol" "Bloom_filter" "Vector_clock" "CAP_theorem" "Kademlia" "EdDSA"
  "SHA-2" "Public-key_cryptography" "Okapi_BM25" "Inverted_index" "Web_crawler" "Robots.txt"
  "Server-side_request_forgery" "Decentralized_identifier" "Lisp_(programming_language)" "WebAssembly"]
 :queries
 [["consensus algorithm for a replicated log with leader election designed to be understandable" "Raft_(algorithm)"]
  ["family of protocols for reaching agreement among unreliable processors in a network" "Paxos_(computer_science)"]
  ["tree of hashes where each leaf is a hash of a data block used to verify large data structures" "Merkle_tree"]
  ["peer-to-peer hypermedia protocol for storing and sharing files addressed by content" "InterPlanetary_File_System"]
  ["peer-to-peer file sharing protocol using torrents and trackers" "BitTorrent"]
  ["storing information so it is retrieved by its content hash rather than location" "Content-addressable_storage"]
  ["hashing scheme that minimises key remapping when servers are added or removed" "Consistent_hashing"]
  ["nodes periodically exchange state with random peers to spread information epidemic style" "Gossip_protocol"]
  ["space-efficient probabilistic set that can give false positives but never false negatives" "Bloom_filter"]
  ["mechanism for determining partial ordering of events in a distributed system using counters per process" "Vector_clock"]
  ["theorem stating a distributed store cannot provide consistency availability and partition tolerance at once" "CAP_theorem"]
  ["distributed hash table using XOR metric used by eMule and BitTorrent trackerless" "Kademlia"]
  ["digital signature scheme using a twisted Edwards curve" "EdDSA"]
  ["family of cryptographic hash functions published by the NSA with 256 and 512 bit digests" "SHA-2"]
  ["cryptography using a pair of related keys one public and one private" "Public-key_cryptography"]
  ["ranking function used by search engines to estimate relevance of documents to a query using term frequency" "Okapi_BM25"]
  ["data structure mapping each word to the documents that contain it for full text search" "Inverted_index"]
  ["program that systematically browses the web to index pages" "Web_crawler"]
  ["standard used by websites to tell crawlers which pages not to visit" "Robots.txt"]
  ["attack where a server is tricked into making requests to internal resources" "Server-side_request_forgery"]
  ["globally unique identifier that a subject controls without a central registry" "Decentralized_identifier"]
  ["family of languages based on parenthesised expressions and code as data" "Lisp_(programming_language)"]
  ["binary instruction format that runs in browsers as a portable compilation target" "WebAssembly"]
  ["structure that lets a network of nodes look up values by key with no central server" "Distributed_hash_table"]]}
