          (let [m (- nbits 8)]
            (recur s i (bit-and acc (dec (i64-shift-left 1 m))) m (vector-conj out (bit-and (u64-shift-right acc m) 255))))
        (>= i (string-length s)) out
        :else (let [v (b32-value (string-code-point-at s i))]
                (if (< v 0) [-1] (recur s (inc i) (bit-or (i64-shift-left acc 5) v) (+ nbits 5) out)))))
(defn cid-bytes [cid :string] :vector-i64
  (if (= (string-length cid) 59)
    (if (= (string-code-point-at cid 0) 98) (b32-decode cid 1 0 0 []) [-1])
    [-1]))
(defn cid-codec [cid :string] :i64
  (let [b (cid-bytes cid)]
    (if (= (count b) 36)
      (let [c (vector-at b 1)]
        (if (and (= (vector-at b 0) 1) (= (vector-at b 2) 18) (= (vector-at b 3) 32))
          (if (= c 85) c (if (= c 113) c 0))
          0))
      0)))
(defn hex-char [v :i64] :string (string-substring "0123456789abcdef" v (inc v)))
(defn hex-of [b :vector-i64 i :i64 out :string] :string
  (if (>= i 36) out
    (recur b (inc i) (string-concat out (string-concat (hex-char (quot (vector-at b i) 16)) (hex-char (bit-and (vector-at b i) 15)))))))
(defn cid-digest [cid :string] :string
  (let [c (cid-codec cid)]
    (if (= c 0) ""
      (let [d (hex-of (cid-bytes cid) 4 "sha256:")]
        (if (= (digest-cid d c) cid) d "")))))
(defn- en-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- en-b58-digit [c :i64] :i64
  (cond (and (>= c 49) (<= c 57)) (- c 49)
        (and (>= c 65) (<= c 72)) (- c 56)
        (and (>= c 74) (<= c 78)) (- c 57)
        (and (>= c 80) (<= c 90)) (- c 58)
        (and (>= c 97) (<= c 107)) (- c 64)
        (and (>= c 109) (<= c 122)) (- c 65)
        :else -1))
(defn- en-b64-digit [c :i64] :i64
  (cond (and (>= c 65) (<= c 90)) (- c 65)
        (and (>= c 97) (<= c 122)) (- c 71)
        (and (>= c 48) (<= c 57)) (+ c 4)
        (= c 45) 62
        (= c 95) 63
        :else -1))
(defn- en-starts? [b :vector-i64 p :string] :bool
  (let [q (en-bytes p)]
    (if (< (vector-count b) (vector-count q)) false
      (loop [i 0] (if (= i (vector-count q)) true (if (= (vector-at b i) (vector-at q i)) (recur (+ i 1)) false))))))
(defn- en-slice [v :vector-i64 a :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ a i)))))))
(defn- en-did-raw [did :string] :vector-i64
  (let [b (en-bytes did) out (vector-alloc 35)]
    (cond (not (en-starts? b "did:key:z")) (vector-assoc! out 0 1)
          (and (> (vector-count b) 9) (= (vector-at b 9) 49)) (vector-assoc! out 0 2)
          :else
          (loop [i 9 acc out]
            (if (= i (vector-count b))
              (if (and (= (vector-at acc 1) 237) (= (vector-at acc 2) 1)) acc (vector-assoc! acc 0 4))
              (let [d (en-b58-digit (vector-at b i))]
                (if (< d 0) (vector-assoc! acc 0 3)
                  ;; acc[1..34] := acc[1..34] * 58 + d, big-endian
                  (let [carry (loop [j 34 c d]
                                (if (= j 0) c
                                  (let [x (+ (* (vector-at acc j) 58) c)
                                        z (vector-assoc! acc j (bit-and x 255))]
                                    (recur (- j 1) (u64-shift-right x 8)))))]
                    (if (> carry 0) (vector-assoc! acc 0 4) (recur (+ i 1) acc))))))))))
(defn did-key-problem [did :string] :string
  (case (vector-at (en-did-raw did) 0)
    0 "enroll/ok"
    1 "enroll/not-did-key"
    2 "enroll/did-key-not-canonical"
    3 "enroll/did-key-bad-base58"
    "enroll/did-key-not-ed25519"))
(defn did-key-public [did :string] :vector-i64
  (let [raw (en-did-raw did)]
    (if (= (vector-at raw 0) 0) (en-slice raw 3 32) (vector-alloc 0))))
(defn- en-sig-raw [sig :string] :vector-i64
  (let [b (en-bytes sig) out (vector-alloc 65)]
    (if (not (= (vector-count b) 86)) (vector-assoc! out 0 1)
      (loop [i 0 acc 0 bits 0 k 1 o out]
        (if (= i 86)
          (if (= acc 0) o (vector-assoc! o 0 1))
          (let [d (en-b64-digit (vector-at b i))]
            (if (< d 0) (vector-assoc! o 0 1)
              (let [a2 (+ (* acc 64) d) b2 (+ bits 6)]
                (if (>= b2 8)
                  (let [bv (bit-and (u64-shift-right a2 (- b2 8)) 255)
                        left (bit-and a2 (- (i64-shift-left 1 (- b2 8)) 1))]
                    (recur (+ i 1) left (- b2 8) (+ k 1) (vector-assoc! o k bv)))
                  (recur (+ i 1) a2 b2 k o))))))))))
(defn- en-sig-ok? [sig :string] :bool (= (vector-at (en-sig-raw sig) 0) 0))
(defn- en-sig-bytes [sig :string] :vector-i64 (en-slice (en-sig-raw sig) 1 64))
(defn statement-problem [did :string text :string sig :string] :string
  (cond (not (= (did-key-problem did) "enroll/ok")) (did-key-problem did)
        (not (en-sig-ok? sig)) "enroll/signature-encoding"
        (not (arena-scope (verify? (did-key-public did) (en-bytes text) (en-sig-bytes sig)))) "enroll/bad-signature"
        :else "enroll/ok"))
(defn cp [s :string i :i64] :i64 (string-code-point-at s i))
(defn- jn-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- jn-root [b :vector-i64] :i64
  (loop [i 0] (if (and (< i (vector-count b)) (let [c (vector-at b i)] (or (= c 32) (= c 9) (= c 10) (= c 13)))) (recur (+ i 1)) i)))
(defn- jn-text [doc :string key :string] :string
  (let [b (jn-bytes doc)]
    (if (not (json-valid? b)) ""
      (let [v (json-member b (jn-root b) key)] (if (and (>= v 0) (= (json-kind b v) 3)) (json-string b v) "")))))
(defn- jn-num [doc :string key :string] :i64
  (let [b (jn-bytes doc)]
    (if (not (json-valid? b)) -1
      (let [v (json-member b (jn-root b) key)] (if (and (>= v 0) (json-int-ok? b v)) (json-int b v) -1)))))
(defn- jn-job-id? [s :string] :bool
  (let [b (jn-bytes s)]
    (and (= (vector-count b) 64)
      (loop [i 0]
        (if (= i 64) true
          (let [c (vector-at b i)]
            (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102)))
              (recur (+ i 1)) false)))))))
(defn- jn-lease-bound? [chosen :string expected :string] :bool
  (and (jn-job-id? expected) (= (jn-text chosen "class") expected)
       (= (jn-num chosen "slot") 0) (> (jn-num chosen "epoch") 0)
       (not (= (jn-text chosen "node") ""))))
(defn- jn-receipt-bound? [chosen :string receipt :string expected :string] :bool
  (and (jn-lease-bound? chosen expected)
       (= (jn-text receipt "job") expected)
       (= (jn-text receipt "node") (jn-text chosen "node"))))
(defn step-receipt-text [at :i64 did :string epoch :i64 exit :i64 job :string node :string output :string] :string
  (str "{\"at\":" at ",\"did\":\"" did "\",\"epoch\":" epoch ",\"exit\":" exit ",\"job\":\"" job
       "\",\"kind\":\"itonami.agent-step-receipt/1\",\"node\":\"" node "\",\"output\":\"" output "\"}"))
(defn receipt-verdict [holder-did :string holder-epoch :i64
                       at :i64 did :string epoch :i64 exit :i64 job :string node :string output :string
                       sig :string] :string
  (cond (not (= (statement-problem did (step-receipt-text at did epoch exit job node output) sig) "enroll/ok")) "job/bad-signature"
        (not (= did holder-did)) "job/not-the-holder"
        (not (= epoch holder-epoch)) "job/stale-epoch"
        (= (cid-digest output) "") "job/bad-output-cid"
        :else "job/confirmed"))

(defn- jn-int [s :string] :i64
  (let [b (jn-bytes s) neg (and (> (vector-count b) 0) (= (vector-at b 0) 45)) j0 (if neg 1 0)]
    (if (or (= (vector-count b) j0) (> (- (vector-count b) j0) 16)) -1
      (loop [i j0 n 0]
        (if (= i (vector-count b)) (if neg (- 0 n) n)
          (let [c (vector-at b i)] (if (and (>= c 48) (<= c 57)) (recur (+ i 1) (+ (* n 10) (- c 48))) -1)))))))

(defn- jn-field [s :string k :i64] :string
  (let [b (jn-bytes s)]
    (loop [i 0 start 0 n 0]
      (cond (= i (vector-count b)) (if (= n k) (string-substring s start i) "")
            (= (vector-at b i) 32) (if (= n k) (string-substring s start i) (recur (+ i 1) (+ i 1) (+ n 1)))
            :else (recur (+ i 1) start n)))))

;; a member of a JSON object text: its string, its integer, or "" / -1


(defn- jn-now [arg :string] :i64 1000)
(defn- jn-live-lease? [chosen :string expected :string node :string now :i64] :bool
  (and (jn-lease-bound? chosen expected) (= (jn-text chosen "node") node)
       (>= now 0) (> (jn-num chosen "until") now)))


(defn- mode [] :string (typed-cap-call 38 :string :string "0"))
(defn- jn-arg [i :i64] :string (cond (= i 5) "k16" (= i 9) (if (= (mode) "numeric") "1000" "clock") (= i 10) "1" (= i 14) "100" (= i 15) (if (= (mode) "rogue") "rogue" "follow") (= i 18) (typed-cap-call 38 :string :string "1") :else ""))
(defn- jn-token [i :i64] :string "")
(defn- jn-say [s :string] :i64 (let [x (typed-cap-call 37 :string :string (str s "\n"))] 0))
(defn- key-seed [s :string] :vector-i64 [1])
(defn- job-problem [a :string b :string c :string d :string] :string "job/ok")
(defn- job-id [a :string b :string c :string d :string] :string "ded77d4a699b728ef3ba67c14e4d26a76160bbc7a129ea75543cf9e6d07a73f1")
(defn- node-did [seed :vector-i64] :string "did")
(defn- own-state [seed :vector-i64 did :string node :string fd :string admitted :string now :i64] :i64 0)
(defn- cell-admit [index :string digest :string klass :string state :i64 allowed :i64] :string "launch/ok")
(defn- cell-execute [index :string digest :string klass :string layout :string state :i64 allowed :i64 input :string] :string
 (let [x (jn-say (str "fixture/input:" input))] "ok 0 bafkreicjiv65wa2mvyywylconw3pslnbwlzyogs4jpo5qwqllx4y4lvyey"))
(defn- sign-statement [seed :vector-i64 text :string] :string "fixture-signature")
(defn- lease-ttl [] :i64 60000)
(defn- lease-text [node :string klass :string slot :i64 epoch :i64 until :i64 revision :i64] :string "")
(defn- lease-round [t :i64 id :string own :string ports :string token :string] :string
 (if (and (= (mode) "noquorum") (not (= own ""))) ""
  (str "{\"class\":\"" (if (= (mode) "wrong-job") "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "ded77d4a699b728ef3ba67c14e4d26a76160bbc7a129ea75543cf9e6d07a73f1")
    "\",\"epoch\":1,\"node\":\"" (if (and (= (mode) "stolen") (not (= own ""))) "b70" "k16")
    "\",\"revision\":0,\"slot\":0,\"until\":" (if (= (mode) "expired") 1000 2000) "}")))
(defn- sha256-hex [b :vector-i64] :string "")
(defn- lc-plain? [s :string] :bool
  (let [b (vector-i64-from-bytes (string-to-utf8 s))]
    (loop [i 0] (if (= i (vector-count b)) true (let [c (vector-at b i)] (if (and (>= c 33) (<= c 126) (not (= c 34)) (not (= c 92))) (recur (+ i 1)) false))))))
(defn valid-value? [node :string enabled :bool class :string slot :i64 epoch :i64 until :i64 now :i64] :bool
  (and enabled (> (string-length node) 0) (lc-plain? node)
       (>= (string-length class) 1) (<= (string-length class) 128) (lc-plain? class)
       (>= slot 0) (<= slot 255) (>= epoch 1) (<= epoch 9007199254740991)
       (>= now 0) (<= now 9007199254740991)
       (>= until 0) (<= until 9007199254740991)
       (<= until (+ now (+ (lease-ttl) (lease-skew))))))
(defn lease-skew [] :i64 60000)
(defn- jn-lease-problem [chosen :string node :string jid :string now :i64] :string
  (let [b (jn-bytes chosen) holder (jn-text chosen "node") class (jn-text chosen "class")
        epoch (jn-num chosen "epoch") slot (jn-num chosen "slot")
        until (jn-num chosen "until") revision (jn-num chosen "revision")]
    (cond (or (= chosen "") (not (json-canonical? b)) (not (= (json-kind b 0) 1))
              (not (= (json-count b 0) 6)) (= node "") (< now 0) (> now 9007199253000000)) "job/lease-invalid"
          (not (= holder node)) "job/lease-holder"
          (or (not (= class jid)) (not (= slot 0)) (not (= epoch 1)) (not (= revision 0))) "job/lease-binding"
          (or (<= until now) (not (valid-value? holder true class slot epoch until now))) "job/lease-expired-or-invalid"
          :else "job/lease-ok")))
(defn json-count [b :vector-i64 i :i64] :i64
  (let [c (jr-at b i)]
    (if (not (or (= c 123) (= c 91))) 0
      (let [j0 (jr-skip b (+ i 1))]
        (if (or (= (jr-at b j0) 125) (= (jr-at b j0) 93)) 0
          (loop [j j0 n 1]
            (let [v (if (= c 123) (jr-skip b (+ (jr-skip b (jr-skip-string b j)) 1)) j)
                  m (jr-skip b (jr-skip-value b v))]
              (if (= (jr-at b m) 44) (recur (jr-skip b (+ m 1)) (+ n 1)) n))))))))
(defn- jr-canon-string? [b :vector-i64 i :i64 e :i64] :bool
  (loop [j (+ i 1)]
    (if (>= j (- e 1)) true
      (if (= (vector-at b j) 92)
        (let [d (vector-at b (+ j 1))]
          (cond (or (= d 34) (= d 92) (= d 98) (= d 102) (= d 110) (= d 114) (= d 116)) (recur (+ j 2))
                (= d 117)
                (let [u (jr-hex4 b (+ j 2))
                      lower (loop [k 2] (if (= k 6) true (let [h (vector-at b (+ j k))] (if (and (>= h 65) (<= h 70)) false (recur (+ k 1))))))]
                  (if (and lower (< u 32) (not (= u 8)) (not (= u 9)) (not (= u 10)) (not (= u 12)) (not (= u 13)))
                    (recur (+ j 6)) false))
                :else false))
        (recur (+ j 1))))))
(defn- jr-canon-key? [b :vector-i64 i :i64 e :i64] :bool
  (loop [j (+ i 1) digits true]
    (if (>= j (- e 1)) (not digits)
      (let [c (vector-at b j)] (if (>= c 128) false (recur (+ j 1) (and digits (jr-digit? c))))))))
(defn- jr-after? [b :vector-i64 a :i64 ae :i64 c :i64 ce :i64] :bool
  (loop [k 1]
    (let [x (if (< (+ a k) (- ae 1)) (vector-at b (+ a k)) -1) y (if (< (+ c k) (- ce 1)) (vector-at b (+ c k)) -1)]
      (cond (and (< x 0) (< y 0)) false
            (= x y) (recur (+ k 1))
            :else (> y x)))))
(defn- jr-canon-number? [b :vector-i64 i :i64 e :i64] :bool
  (and (json-int-ok? b i) (= (jr-digits b (if (= (vector-at b i) 45) (+ i 1) i)) e)
       (not (and (= (vector-at b i) 45) (= (vector-at b (+ i 1)) 48)))))
(defn json-canonical? [b :vector-i64] :bool
  (let [kinds (vector-alloc 65) want (vector-alloc 65) pa (vector-alloc 65) pe (vector-alloc 65)]
    (loop [j 0 sp 0]
      (if (= j (vector-count b)) true
        (let [c (vector-at b j)]
          (cond (jr-ws? c) false
                (or (= c 123) (= c 91))
                (let [z (vector-assoc! kinds sp (if (= c 123) 1 2)) y (vector-assoc! want sp (if (= c 123) 1 0)) x (vector-assoc! pa sp -1)]
                  (recur (+ j 1) (+ sp 1)))
                (or (= c 125) (= c 93)) (recur (+ j 1) (- sp 1))
                (= c 44) (let [z (if (and (> sp 0) (= (vector-at kinds (- sp 1)) 1)) (vector-assoc! want (- sp 1) 1) want)] (recur (+ j 1) sp))
                (= c 58) (recur (+ j 1) sp)
                (= c 34)
                (let [e (jr-skip-string b j)]
                  (if (not (jr-canon-string? b j e)) false
                    (if (and (> sp 0) (= (vector-at want (- sp 1)) 1))
                      (let [d (- sp 1)]
                        (if (and (jr-canon-key? b j e) (or (< (vector-at pa d) 0) (jr-after? b (vector-at pa d) (vector-at pe d) j e)))
                          (let [z (vector-assoc! pa d j) y (vector-assoc! pe d e) x (vector-assoc! want d 0)] (recur e sp))
                          false))
                      (recur e sp))))
                (or (= c 45) (jr-digit? c))
                (let [e (jr-number b j)] (if (jr-canon-number? b j e) (recur e sp) false))
                :else (recur (jr-skip-value b j) sp)))))))
(defn lower [c :i64] :i64 (if (and (>= c 65) (<= c 90)) (+ c 32) c))
(defn test-job-dispatch-lease [] :bool
  (let [now 1792500000000 jid "job-one" until (+ now 60000)
        valid (lease-text "node-a" jid 0 1 until 0)]
    (and (= (jn-lease-problem valid "node-a" jid now) "job/lease-ok")
         (= (jn-lease-problem valid "node-b" jid now) "job/lease-holder")
         (= (jn-lease-problem valid "node-a" "job-two" now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 1 1 until 0) "node-a" jid now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 0 2 until 0) "node-a" jid now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 0 1 until 1) "node-a" jid now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 0 1 now 0) "node-a" jid now) "job/lease-expired-or-invalid")
         (= (jn-lease-problem (lease-text "node-a" jid 0 1 (+ now 2000000) 0) "node-a" jid now) "job/lease-expired-or-invalid")
         (= (jn-lease-problem "" "node-a" jid now) "job/lease-invalid")
         (= (jn-lease-problem "{}" "node-a" jid now) "job/lease-invalid")
         (= (jn-lease-problem "{\"class\":\"job-one\",\"epoch\":1,\"node\":\"node-a\",\"revision\":0,\"slot\":0,\"until\":1792500060000,\"untrusted\":1}" "node-a" jid now) "job/lease-invalid")
         (= (jn-lease-problem valid "" jid now) "job/lease-invalid")
         (= (jn-lease-problem valid "node-a" jid -1) "job/lease-invalid"))))

(defn field-problem [s :string] :string
  (let [b (en-bytes s)]
    (if (> (vector-count b) 128) "enroll/field-too-long"
      (loop [i 0]
        (if (= i (vector-count b)) "enroll/ok"
          (let [c (vector-at b i)]
            (if (and (>= c 33) (<= c 126) (not (= c 34)) (not (= c 92))) (recur (+ i 1)) "enroll/field-charset")))))))
(defn- jn-attempt-root? [dir :string] :bool
  (and (> (string-length dir) 1) (<= (string-length dir) 128)
       (= (string-substring dir 0 1) "/")
       (< (string-index-of dir "..") 0) (< (string-index-of dir "_SEP") 0)
       (= (field-problem dir) "enroll/ok")))
(defn- jn-attempt-id? [jid :string] :bool
  (let [b (jn-bytes jid)]
    (and (= (vector-count b) 64)
      (loop [i 0]
        (if (= i 64) true
          (let [c (vector-at b i)]
            (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102)))
              (recur (+ i 1)) false)))))))
(defn- jn-fs [op :string path :string tail :string] :string
  (let [r (typed-cap-call 35 :string :string (str "\u0000FS2\u0000" op path "\u0000" tail))]
    (if (and (>= (string-byte-length r) 5) (= (string-substring r 0 5) "\u0000FS2\u0000"))
      (string-substring r 5 (string-length r)) "")))
(defn- jn-private-dir? [path :string] :bool
  (let [m (jn-fs "U" path "")]
    (and (= (jn-field m 0) "448") (= (jn-field m 3) "1"))))
(defn- jn-attempt [dir :string jid :string] :string
  (if (or (not (jn-attempt-root? dir)) (not (jn-attempt-id? jid))
          (not (jn-private-dir? dir))) "job/attempt-config"
    (let [path (str dir "/" jid) made (jn-fs "I" path "")]
      (if (not (= made "1")) "job/attempt-exists-or-unknown"
        (if (and (= (jn-fs "H" path "0700") "1") (jn-private-dir? path)
                 (= (jn-fs "M" path "") "1") (= (jn-fs "M" dir "") "1"))
          (let [z (typed-cap-call 37 :string :string "fixture/marker-synced\n")]
            (loop [i 0] (recur (+ i 1)))) "job/attempt-unknown")))))
(defn- jn-run-with-source [source :string source-admitted :bool] :i64
  (let [profile (jn-arg 1) input (jn-arg 2) policy (jn-arg 3) rail (jn-arg 4)
        node (jn-arg 5) seed (key-seed (jn-arg 6)) fd (jn-arg 7) admitted (jn-arg 8)
        now 1000
        allowed (jn-int (jn-arg 10)) index (jn-arg 11) layout (jn-arg 12)
        ports (jn-arg 13) t (jn-int (jn-arg 14)) mode (jn-arg 15)
        ipath (jn-arg 16) token (jn-token 17) attempts (jn-arg 18)
        has-input (and (not (= ipath "")) (= (typed-cap-call 35 :string :string (string-concat ipath "EXISTS_SEP")) "1"))
        itext (if has-input (typed-cap-call 35 :string :string ipath) "")
        jp (job-problem profile input policy rail)]
    (cond (not (= jp "job/ok")) (let [x (jn-say (string-concat "job " jp))] 1)
          (= (vector-count seed) 0) (let [x (jn-say "job run/bad-key")] 1)
          (not (= (jn-arg 9) "clock")) (let [x (jn-say "job/clock-required")] 2)
          (not (= mode "follow")) (let [x (jn-say "job/mode-refused")] 2)
          (or (< now 0) (> now 9007199253000000) (< t 1) (>= t 9007199254740991))
            (let [x (jn-say "job/time-or-ballot-refused")] 2)
          (not (jn-attempt-root? attempts)) (let [x (jn-say "job/attempt-config")] 1)
          (= token "-") (let [x (jn-say "job token/missing-or-short")] 2)
          (and (not (= ipath "")) (not has-input)) (let [x (jn-say "job input/missing")] 1)
          (and has-input (not (= (digest-cid (string-concat "sha256:" (sha256-hex (jn-bytes itext))) 85) input))) (let [x (jn-say "job input/cid-mismatch")] 1)
          :else
          (let [jid (job-id profile input policy rail)
                did (node-did seed)
                state (own-state seed did node fd admitted now)
                admit (cell-admit index profile "container" state allowed)
                a (jn-say (str "job " jid))]
            (if (not (= admit "launch/ok")) (let [x (jn-say (string-concat "ineligible " admit))] 0)
              (let [chosen (lease-round t node (lease-text node jid 0 1 (+ now (lease-ttl)) 0) ports token)
                    holder (if (= chosen "") "" (jn-text chosen "node"))
                    epoch (if (= chosen "") 0 (jn-num chosen "epoch"))
                    b (jn-say (string-concat "lease " (if (= holder "") "none" holder)))
                    check-now 1000
                    guard (if (< check-now now) "job/clock-regressed" (jn-lease-problem chosen node jid check-now))]
                (if (not (= guard "job/lease-ok"))
                  (let [x (jn-say (if (= guard "job/lease-holder") (str "held-by " holder) guard))] 0)
                  (let [attempt (jn-attempt attempts jid) dispatch-now 1000
                        dispatch-guard (if (< dispatch-now check-now) "job/clock-regressed"
                                         (jn-lease-problem chosen node jid dispatch-now))]
                    (cond (not (= attempt "job/attempt-recorded")) (let [x (jn-say attempt)] 1)
                          (not (= dispatch-guard "job/lease-ok")) (let [x (jn-say dispatch-guard)] 1)
                          :else
                          (let [r (cell-execute index profile "container" layout state allowed (if source-admitted source itext))]
                    (if (not (= (jn-field r 0) "ok")) (let [x (jn-say r)] 1)
                      (let [fresh (lease-round (+ t 1) node chosen ports token)
                            finished 1000
                            final-guard (jn-lease-problem fresh node jid finished)]
                        (if (or (< finished dispatch-now) (not (= fresh chosen)) (not (= final-guard "job/lease-ok")))
                          (let [x (jn-say "job/lease-lost-output-unconfirmed")] 1)
                          (let [text (step-receipt-text finished did epoch (jn-int (jn-field r 1)) jid node (jn-field r 2))
                                c (jn-say (string-concat "receipt " text))
                                d (jn-say (string-concat "signature " (sign-statement seed text)))]
                            0))))))))))))))
(defn- jn-run [] :i64 (jn-run-with-source "" false))
(defn main [] :i64 (if (= (mode) "source") (jn-run-with-source "validated-source" true) (jn-run)))
