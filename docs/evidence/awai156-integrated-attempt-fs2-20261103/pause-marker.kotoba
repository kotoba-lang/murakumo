          (recur (inc i)))))))
(defn reduce64 [h :vector-i64] :vector-i64 (mod-l (bcopy-into (bzero 64) 0 h)))
(defn below-l? [s :vector-i64] :bool
  (loop [j 31] (cond (< j 0) false (< (vector-at s j) (l-byte j)) true (> (vector-at s j) (l-byte j)) false :else (recur (dec j)))))
(defn verify? [pk :vector-i64 m :vector-i64 sig :vector-i64] :bool
  (arena-scope
    (if (or (not (= (vector-count pk) 32)) (not (= (vector-count sig) 64))) false
      (let [s (bslice sig 32 32) q (pt-unpackneg pk)]
        (if (or (not (below-l? s)) (= (vector-count q) 0)) false
          (let [rr (bslice sig 0 32)
                h (reduce64 (sha512 (bcat (bcat rr pk) m)))
                p (pt-add (pt-mul q h) (pt-mul (pt-base) s))]
            (bytes=? (pt-pack p) rr)))))))
(defn- jr-at [b :vector-i64 i :i64] :i64 (if (and (>= i 0) (< i (vector-count b))) (vector-at b i) -1))
(defn- jr-ws? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- jr-skip [b :vector-i64 i :i64] :i64 (loop [j i] (if (jr-ws? (jr-at b j)) (recur (+ j 1)) j)))
(defn- jr-digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
(defn- jr-cont? [c :i64] :bool (and (>= c 128) (<= c 191)))
(defn- jr-digits [b :vector-i64 j :i64] :i64 (loop [k j] (if (jr-digit? (jr-at b k)) (recur (+ k 1)) k)))
(defn- jr-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- jr-hex [c :i64] :i64
  (cond (jr-digit? c) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55)
        :else -1))
(defn- jr-hex4 [b :vector-i64 k :i64] :i64
