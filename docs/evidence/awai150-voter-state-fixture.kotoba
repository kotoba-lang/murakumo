(ns awai150-voter-state-fixture (:export [main]))
(defn- ln-frame [op :string path :string tail :string] :string (str "\u0000FS2\u0000" op path "\u0000" tail))
(defn- ln-fs [op :string path :string tail :string] :string
  (let [r (typed-cap-call :fs/app-data :string :string (ln-frame op path tail))]
    (if (and (>= (string-byte-length r) 5) (= (string-substring r 0 5) "\u0000FS2\u0000"))
      (string-substring r 5 (string-length r)) "")))
(defn bzero [n :i64] :vector-i64
  (let [v (vector-alloc n)] (loop [i 0] (if (>= i n) v (let [z (vector-assoc! v i 0)] (recur (inc i)))))))
(defn bcopy-into [d :vector-i64 off :i64 s :vector-i64] :vector-i64
  (loop [i 0] (if (>= i (vector-count s)) d (let [z (vector-assoc! d (+ off i) (vector-at s i))] (recur (inc i))))))
(defn pt [x :vector-i64 y :vector-i64 z :vector-i64 t :vector-i64] :vector-i64
  (bcopy-into (bcopy-into (bcopy-into (bcopy-into (bzero 64) 0 x) 16 y) 32 z) 48 t))
(defn- jr-at [b :vector-i64 i :i64] :i64 (if (and (>= i 0) (< i (vector-count b))) (vector-at b i) -1))
(defn- jr-ws? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- jr-skip [b :vector-i64 i :i64] :i64 (loop [j i] (if (jr-ws? (jr-at b j)) (recur (+ j 1)) j)))
(defn- jr-digit? [c :i64] :bool (and (>= c 48) (<= c 57)))
(defn- jr-cont? [c :i64] :bool (and (>= c 128) (<= c 191)))
(defn- jr-digits [b :vector-i64 j :i64] :i64 (loop [k j] (if (jr-digit? (jr-at b k)) (recur (+ k 1)) k)))
(defn- jr-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- jr-hex [c :i64] :i64
  (cond (jr-digit? c) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55)
        :else -1))
(defn- jr-hex4 [b :vector-i64 k :i64] :i64
  (let [a (jr-hex (jr-at b k)) c (jr-hex (jr-at b (+ k 1))) d (jr-hex (jr-at b (+ k 2))) e (jr-hex (jr-at b (+ k 3)))]
    (if (or (< a 0) (< c 0) (< d 0) (< e 0)) -1 (+ (* a 4096) (+ (* c 256) (+ (* d 16) e))))))
(defn- jr-utf8 [b :vector-i64 j :i64] :i64
