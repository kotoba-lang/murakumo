(ns resident-turn-order-fixture (:export [main]))
(defn- say [s :string] :i64 (let [x (typed-cap-call 37 :string :string (str s "\n"))] 0))
(defn- arg [i :i64] :string (typed-cap-call 38 :string :string (string-from-i64 i)))
(defn- cp-num [v :vector-i64 i :i64 k :string] :i64
 (cond (= k "epoch") 1 (= k "next") 1 (= k "intervalMs") 1000 (= (vector-count v) 0) -1 (= k "until") (if (= (vector-at v 0) 1) 10000 (vector-at v 0)) :else 0))
(defn- cp-str [v :vector-i64 i :i64 k :string] :string "synthetic")
(defn- cp-text [v :vector-i64] :string (if (= (vector-count v) 0) "missing" (str (vector-at v 0))))
(defn- cp-read [p :string] :vector-i64 [1])
(defn- cp-load [p :string k :string] :vector-i64 [1])
(defn- cp-materialize [store :string checkpoint :vector-i64 dest :string] :string "checkpoint/restored")
(defn- rt-lease [cfg :vector-i64 epoch :i64] :vector-i64 (let [x (say "quorum")] cfg))
(defn- rt-now [] :i64 100)
(defn- recovery-lease-problem [v :vector-i64 task :string node :string epoch :i64 now :i64] :string (if (and (> (vector-count v) 0) (= (vector-at v 0) 1)) "recovery/lease-admitted" "recovery/refused"))
(defn- rf-budget [lease :i64 retention :i64 now :i64] :i64 (if (= retention 200) 0 4))
(defn- rt-runtime [cfg :vector-i64] :vector-i64 cfg)
(defn- rt-status [cfg :vector-i64 phase :string] :i64 0)
(defn- pr-step-resident [dest :string runtime :vector-i64 cache :string next :i64 budget :i64] :string (let [x (say "inference")] "profile/step-completed 1 digest"))
(defn- ln-field [s :string i :i64] :string (if (= (string-index-of s "profile/step-completed ") 0) "profile/step-completed" "other"))
(defn- rt-capture [cfg :vector-i64 dest :string epoch :i64 root :string next :i64] :string "capture")
(defn- rt-replicate [cfg :vector-i64 successor :string next-at :i64 request :string] :bool false)
(defn- rt-publish-candidate [cfg :vector-i64 successor :string next-at :i64 request :string] :bool false)
(defn- rt-post-problem [cfg :vector-i64 head :vector-i64 lease :vector-i64 fresh :vector-i64 now :i64] :string
  (cond (<= (cp-num head 0 "until") now) "resident/retention-expired-proposal-retained"
        (or (not (= (cp-text lease) (cp-text fresh)))
            (not (= (recovery-lease-problem fresh (cp-str cfg 0 "task") (cp-str cfg 0 "node")
                      (cp-num lease 0 "epoch") now) "recovery/lease-admitted"))) "resident/lease-lost"
        :else "resident/admission-held"))

;; Materialization can outlast or invalidate the lease learned by rt-cycle.
;; Re-learn it after restore, before any inference dispatch; an unknown or
;; changed lease and insufficient remaining budget cannot start a new turn.
;; This is not an atomic effect fence: the receiver still needs one.
(defn- rt-dispatch [cfg :vector-i64 head :vector-i64 lease :vector-i64 dest :string next :i64] :string
  (let [fresh (rt-lease cfg (cp-num lease 0 "epoch")) now (rt-now)
        admission (rt-post-problem cfg head lease fresh now)
        budget (rf-budget (cp-num lease 0 "until") (cp-num head 0 "until") now)]
    (cond (not (= admission "resident/admission-held")) admission
          (< budget 1) "profile/budget-refused"
          :else (pr-step-resident dest (rt-runtime cfg) (cp-str cfg 0 "cache") next budget))))

(defn- rt-turn [cfg :vector-i64 head :vector-i64 lease :vector-i64 request :string] :string
  (let [store (cp-str cfg 0 "store") root (cp-str head 0 "checkpoint") checkpoint (cp-load store root)
        dest (str (cp-str cfg 0 "runtimeRoot") "/checkouts/" (rt-now))
        restored (cp-materialize store checkpoint dest)]
    (if (not (= restored "checkpoint/restored")) restored
      (let [next (cp-num (cp-read (str dest "/state.json")) 0 "next")
            next-at (+ (rt-now) (cp-num cfg 0 "intervalMs"))
            status (rt-status cfg "inference")
            result (rt-dispatch cfg head lease dest next)
            completed (= (ln-field result 0) "profile/step-completed")
            fresh (if completed (rt-lease cfg (cp-num lease 0 "epoch")) (vector-alloc 0))
            post (if completed (rt-post-problem cfg head lease fresh (rt-now)) "resident/not-dispatched")]
        (cond (not completed) result
              (not (= post "resident/admission-held")) post
              :else
              (let [successor (rt-capture cfg dest (cp-num lease 0 "epoch") root next)
                    copied (and (not (= successor "")) (rt-replicate cfg successor next-at request))
                    final (if copied (rt-lease cfg (cp-num lease 0 "epoch")) (vector-alloc 0))
                    post-final (rt-post-problem cfg head lease final (rt-now))]
                (cond (not copied) "resident/proposal-retained"
                      (not (= post-final "resident/admission-held")) post-final
                      (rt-publish-candidate cfg successor next-at request)
                      (str "resident/published " next " " successor)
                      :else "resident/head-publication-failed")))))))


(defn main [] :i64
 (let [mode (arg 0) cfg (if (= mode "held") [1] (if (= mode "changed") [2] (if (= mode "missing") [] [1])))
       head (if (= mode "expired") [100] (if (= mode "budget") [200] [10000]))
       result (rt-turn cfg head [1] "none") x (say (str "result " result))] 0))
