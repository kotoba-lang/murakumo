                          false))
                      (recur e sp))))
                (or (= c 45) (jr-digit? c))
                (let [e (jr-number b j)] (if (jr-canon-number? b j e) (recur e sp) false))
                :else (recur (jr-skip-value b j) sp)))))))
(defn- jr-put [out :vector-i64 n :i64 c :i64] :i64 (let [z (vector-assoc! out n c)] (+ n 1)))
(defn- jr-put-text [out :vector-i64 n :i64 s :string] :i64
  (let [t (jr-bytes s)] (loop [k 0 m n] (if (= k (vector-count t)) m (recur (+ k 1) (jr-put out m (vector-at t k)))))))
(defn- jr-hexd [v :i64] :i64 (if (< v 10) (+ v 48) (+ v 87)))
(defn- jr-put-string [out :vector-i64 n :i64 s :vector-i64] :i64
  (let [m0 (jr-put out n 34)
        m1 (loop [k 0 m m0]
             (if (= k (vector-count s)) m
               (let [c (vector-at s k)]
                 (recur (+ k 1)
                        (cond (= c 34) (jr-put out (jr-put out m 92) 34)
                              (= c 92) (jr-put out (jr-put out m 92) 92)
                              (= c 8) (jr-put out (jr-put out m 92) 98)
                              (= c 12) (jr-put out (jr-put out m 92) 102)
                              (= c 10) (jr-put out (jr-put out m 92) 110)
                              (= c 13) (jr-put out (jr-put out m 92) 114)
                              (= c 9) (jr-put out (jr-put out m 92) 116)
                              (< c 32) (jr-put out (jr-put out (jr-put out (jr-put out (jr-put out (jr-put out m 92) 117) 48) 48)
                                                                (jr-hexd (quot c 16))) (jr-hexd (rem c 16)))
                              :else (jr-put out m c))))))]
    (jr-put out m1 34)))
(defn- jr-sort-members [b :vector-i64 ks :vector-i64 vs :vector-i64 m :i64] :i64
  (loop [x 0]
    (if (>= x m) 0
      (let [best (loop [y (+ x 1) bi x]
                   (if (= y m) bi
                     (let [ky (vector-at ks y) kb (vector-at ks bi)]
                       (recur (+ y 1) (if (jr-after? b ky (jr-skip-string b ky) kb (jr-skip-string b kb)) y bi)))))
            k1 (vector-at ks x) v1 (vector-at vs x) k2 (vector-at ks best) v2 (vector-at vs best)
            a (vector-assoc! ks x k2) c (vector-assoc! vs x v2) d (vector-assoc! ks best k1) e (vector-assoc! vs best v1)]
        (recur (+ x 1))))))
(defn- jr-emit [b :vector-i64 i :i64 out :vector-i64 n :i64] :i64
  (let [k (json-kind b i)]
    (cond (< n 0) n
          (= k 1)
          (let [m (json-count b i) ks (vector-alloc m) vs (vector-alloc m)
                f (loop [j (jr-skip b (+ i 1)) x 0]
                    (if (= x m) 0
                      (let [e (jr-skip-string b j) v (jr-skip b (+ (jr-skip b e) 1))
                            z (vector-assoc! ks x j) y (vector-assoc! vs x v)
                            nx (jr-skip b (jr-skip-value b v))]
                        (recur (if (= (jr-at b nx) 44) (jr-skip b (+ nx 1)) nx) (+ x 1)))))
                ok (loop [x 0] (if (= x m) true (if (jr-canon-key? b (vector-at ks x) (jr-skip-string b (vector-at ks x))) (recur (+ x 1)) false)))]
            (if (not ok) -1
              (let [s (jr-sort-members b ks vs m)
                    m2 (loop [x 0 p (jr-put out n 123)]
                         (if (or (= x m) (< p 0)) p
                           (let [p1 (if (> x 0) (jr-put out p 44) p)
                                 k0 (vector-at ks x) ke (jr-skip-string b k0)
                                 p2 (loop [q k0 r p1] (if (= q ke) r (recur (+ q 1) (jr-put out r (vector-at b q)))))]
                             (recur (+ x 1) (jr-emit b (vector-at vs x) out (jr-put out p2 58))))))]
                (if (< m2 0) -1 (jr-put out m2 125)))))
          (= k 2)
          (let [m2 (loop [j (jr-skip b (+ i 1)) x 0 p (jr-put out n 91)]
                     (if (or (= (jr-at b j) 93) (< p 0)) p
                       (let [p1 (jr-emit b j out (if (> x 0) (jr-put out p 44) p))
                             nx (jr-skip b (jr-skip-value b j))]
                         (recur (if (= (jr-at b nx) 44) (jr-skip b (+ nx 1)) nx) (+ x 1) p1))))]
            (if (< m2 0) -1 (jr-put out m2 93)))
          (= k 3) (jr-put-string out n (json-string-bytes b i))
          (= k 4) (if (json-int-ok? b i) (jr-put-text out n (string-from-i64 (json-int b i))) -1)
          (= k 5) (jr-put-text out n "true")
          (= k 6) (jr-put-text out n "false")
          (= k 7) (jr-put-text out n "null")
          :else -1)))
(defn json-canonical-bytes [b :vector-i64 i :i64] :vector-i64
  (let [out (vector-alloc (vector-count b)) n (jr-emit b i out 0)]
    (if (< n 0) (vector-alloc 0)
      (loop [k 0 r (vector-alloc n)] (if (= k n) r (recur (+ k 1) (vector-assoc! r k (vector-at out k))))))))
(defn- en-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- en-b58-digit [c :i64] :i64
  (cond (and (>= c 49) (<= c 57)) (- c 49)
        (and (>= c 65) (<= c 72)) (- c 56)
        (and (>= c 74) (<= c 78)) (- c 57)
        (and (>= c 80) (<= c 90)) (- c 58)
        (and (>= c 97) (<= c 107)) (- c 64)
        (and (>= c 109) (<= c 122)) (- c 65)
        :else -1))
(defn- en-b64-digit [c :i64] :i64
  (cond (and (>= c 65) (<= c 90)) (- c 65)
        (and (>= c 97) (<= c 122)) (- c 71)
        (and (>= c 48) (<= c 57)) (+ c 4)
        (= c 45) 62
        (= c 95) 63
        :else -1))
(defn- en-starts? [b :vector-i64 p :string] :bool
  (let [q (en-bytes p)]
    (if (< (vector-count b) (vector-count q)) false
      (loop [i 0] (if (= i (vector-count q)) true (if (= (vector-at b i) (vector-at q i)) (recur (+ i 1)) false))))))
(defn- en-slice [v :vector-i64 a :i64 n :i64] :vector-i64
  (loop [i 0 out (vector-alloc n)] (if (= i n) out (recur (+ i 1) (vector-assoc! out i (vector-at v (+ a i)))))))
(defn- en-did-raw [did :string] :vector-i64
  (let [b (en-bytes did) out (vector-alloc 35)]
    (cond (not (en-starts? b "did:key:z")) (vector-assoc! out 0 1)
          (and (> (vector-count b) 9) (= (vector-at b 9) 49)) (vector-assoc! out 0 2)
          :else
          (loop [i 9 acc out]
            (if (= i (vector-count b))
              (if (and (= (vector-at acc 1) 237) (= (vector-at acc 2) 1)) acc (vector-assoc! acc 0 4))
              (let [d (en-b58-digit (vector-at b i))]
                (if (< d 0) (vector-assoc! acc 0 3)
                  ;; acc[1..34] := acc[1..34] * 58 + d, big-endian
                  (let [carry (loop [j 34 c d]
                                (if (= j 0) c
                                  (let [x (+ (* (vector-at acc j) 58) c)
                                        z (vector-assoc! acc j (bit-and x 255))]
                                    (recur (- j 1) (u64-shift-right x 8)))))]
                    (if (> carry 0) (vector-assoc! acc 0 4) (recur (+ i 1) acc))))))))))
(defn did-key-problem [did :string] :string
  (case (vector-at (en-did-raw did) 0)
    0 "enroll/ok"
    1 "enroll/not-did-key"
    2 "enroll/did-key-not-canonical"
    3 "enroll/did-key-bad-base58"
    "enroll/did-key-not-ed25519"))
(defn did-key-public [did :string] :vector-i64
  (let [raw (en-did-raw did)]
    (if (= (vector-at raw 0) 0) (en-slice raw 3 32) (vector-alloc 0))))
(defn- en-sig-raw [sig :string] :vector-i64
  (let [b (en-bytes sig) out (vector-alloc 65)]
    (if (not (= (vector-count b) 86)) (vector-assoc! out 0 1)
      (loop [i 0 acc 0 bits 0 k 1 o out]
        (if (= i 86)
          (if (= acc 0) o (vector-assoc! o 0 1))
          (let [d (en-b64-digit (vector-at b i))]
            (if (< d 0) (vector-assoc! o 0 1)
              (let [a2 (+ (* acc 64) d) b2 (+ bits 6)]
                (if (>= b2 8)
                  (let [bv (bit-and (u64-shift-right a2 (- b2 8)) 255)
                        left (bit-and a2 (- (i64-shift-left 1 (- b2 8)) 1))]
                    (recur (+ i 1) left (- b2 8) (+ k 1) (vector-assoc! o k bv)))
                  (recur (+ i 1) a2 b2 k o))))))))))
(defn- en-sig-ok? [sig :string] :bool (= (vector-at (en-sig-raw sig) 0) 0))
(defn- en-sig-bytes [sig :string] :vector-i64 (en-slice (en-sig-raw sig) 1 64))
(defn field-problem [s :string] :string
  (let [b (en-bytes s)]
    (if (> (vector-count b) 128) "enroll/field-too-long"
      (loop [i 0]
        (if (= i (vector-count b)) "enroll/ok"
          (let [c (vector-at b i)]
            (if (and (>= c 33) (<= c 126) (not (= c 34)) (not (= c 92))) (recur (+ i 1)) "enroll/field-charset")))))))
(defn statement-problem [did :string text :string sig :string] :string
  (cond (not (= (did-key-problem did) "enroll/ok")) (did-key-problem did)
        (not (en-sig-ok? sig)) "enroll/signature-encoding"
        (not (arena-scope (verify? (did-key-public did) (en-bytes text) (en-sig-bytes sig)))) "enroll/bad-signature"
        :else "enroll/ok"))
(defn cp [s :string i :i64] :i64 (string-code-point-at s i))
(defn revision-verdict [current :i64 proposed :i64] :string
  (cond (< proposed 1) "intent/bad-revision"
        (<= proposed current) "intent/not-advancing"
        :else "intent/ok"))
(defn- tv-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- tv-root [b :vector-i64] :i64
  (loop [i 0] (if (and (< i (vector-count b)) (let [c (vector-at b i)] (or (= c 32) (= c 9) (= c 10) (= c 13)))) (recur (+ i 1)) i)))
(defn- tv-count [trust :string] :i64
  (let [b (tv-bytes trust)]
    (if (= (vector-count b) 0) 0
      (loop [i 0 n 1] (if (= i (vector-count b)) n (recur (+ i 1) (if (= (vector-at b i) 44) (+ n 1) n)))))))
(defn- tv-part [trust :string k :i64 part :i64] :string
  (let [b (tv-bytes trust)]
    (loop [i 0 e 0 start 0 eq -1]
      (let [c (if (< i (vector-count b)) (vector-at b i) 44)]
        (cond (= c 44)
              (if (= e k)
                (if (< eq 0) "" (if (= part 0) (string-substring trust start eq) (string-substring trust (+ eq 1) i)))
                (if (>= i (vector-count b)) "" (recur (+ i 1) (+ e 1) (+ i 1) -1)))
              (and (= c 61) (< eq 0)) (recur (+ i 1) e start i)
              :else (recur (+ i 1) e start eq))))))
(defn- tv-trust-ok? [trust :string] :bool
  (let [n (tv-count trust)]
    (and (>= n 1) (<= n 8)
         (loop [x 0]
           (if (= x n) true
             (let [id (tv-part trust x 0) did (tv-part trust x 1)]
               (if (and (> (string-length id) 0) (= (did-key-problem did) "enroll/ok")
                        (loop [y 0] (if (= y x) true (if (or (= (tv-part trust y 0) id) (= (tv-part trust y 1) did)) false (recur (+ y 1))))))
                 (recur (+ x 1)) false)))))))
(defn- tv-text [b :vector-i64 obj :i64 key :string] :string
  (let [v (json-member b obj key)] (if (and (>= v 0) (= (json-kind b v) 3)) (json-string b v) "")))
(defn- tv-signed? [b :vector-i64 root :i64 id :string did :string text :string] :bool
  (let [legacy (tv-text b root "signature")
        sigs (json-member b root "signatures")]
    (or (and (> (string-length legacy) 0) (= (statement-problem did text legacy) "enroll/ok"))
        (and (>= sigs 0) (= (json-kind b sigs) 2)
             (loop [k 0]
               (let [e (json-element b sigs k)]
                 (cond (< e 0) false
                       (and (= (json-kind b e) 1) (= (tv-text b e "key") id)
                            (= (statement-problem did text (tv-text b e "signature")) "enroll/ok")) true
                       :else (recur (+ k 1)))))))))
(defn topology-revision [doc :vector-i64] :i64
  (if (not (json-valid? doc)) -1
    (let [p (json-member doc (tv-root doc) "payload") r (if (>= p 0) (json-member doc p "revision") -1)]
      (if (and (>= r 0) (json-int-ok? doc r)) (json-int doc r) -1))))
(defn- tv-skip [b :vector-i64 i :i64] :i64
  (loop [j i] (if (and (< j (vector-count b)) (let [c (vector-at b j)] (or (= c 32) (= c 9) (= c 10) (= c 13)))) (recur (+ j 1)) j)))
(defn- tv-u16 [b :vector-i64 s :i64 e :i64] :i64
  (loop [i s n 0] (if (>= i e) n (let [c (vector-at b i)] (recur (+ i 1) (cond (and (>= c 128) (<= c 191)) n (>= c 240) (+ n 2) :else (+ n 1)))))))
(defn- tv-str-len [b :vector-i64 v :i64] :i64
  (if (or (< v 0) (not (= (json-kind b v) 3))) -1 (let [d (json-string-bytes b v)] (tv-u16 d 0 (vector-count d)))))
(defn- tv-name-ok? [s :string] :bool
  (let [b (tv-bytes s)]
    (and (> (vector-count b) 0)
         (loop [i 0] (if (= i (vector-count b)) true
                       (let [c (vector-at b i)]
                         (if (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 45)) (recur (+ i 1)) false)))))))
(defn- tv-owner-ok? [s :string] :bool
  (let [b (tv-bytes s)]
    (and (= (vector-count b) 36)
         (loop [i 0] (if (= i 36) true
                       (let [c (vector-at b i)]
                         (if (or (and (>= c 97) (<= c 102)) (and (>= c 48) (<= c 57)) (= c 45)) (recur (+ i 1)) false)))))))
(defn- tv-octet [h :string k :i64] :i64
  (let [b (tv-bytes h)]
    (loop [i 0 part 0 start 0]
      (let [end (or (= i (vector-count b)) (= (vector-at b i) 46))]
        (cond (and end (= part k))
              (let [n (- i start)]
                (if (or (< n 1) (> n 3) (and (> n 1) (= (vector-at b start) 48))) -1
                  (loop [j start v 0]
                    (if (= j i) (if (> v 255) -1 v)
                      (let [c (vector-at b j)] (if (and (>= c 48) (<= c 57)) (recur (+ j 1) (+ (* v 10) (- c 48))) -1))))))
              (= i (vector-count b)) -1
              end (recur (+ i 1) (+ part 1) (+ i 1))
              :else (recur (+ i 1) part start))))))
(defn- tv-dots [h :string] :i64
  (let [b (tv-bytes h)] (loop [i 0 n 0] (if (= i (vector-count b)) n (recur (+ i 1) (if (= (vector-at b i) 46) (+ n 1) n))))))
(defn- tv-endpoint? [url :string] :bool
  (and (= (string-index-of url "http://") 0)
       (let [r (string-substring url 7 (string-length url)) k (string-index-of r ":")]
         (and (> k 0)
              (let [h (string-substring r 0 k) p (string-substring r (+ k 1) (string-length r))]
                (and (or (= p "8796") (= p "8797") (= p "8796/") (= p "8797/"))
                     (= (tv-dots h) 3) (= (tv-octet h 0) 100)
                     (>= (tv-octet h 1) 64) (<= (tv-octet h 1) 127)
                     (>= (tv-octet h 2) 0) (>= (tv-octet h 3) 0)))))))
(defn- tv-ident [b :vector-i64 e :i64] :string
  (let [v (if (= (json-kind b e) 1) (json-member b e "node") -1)]
    (if (or (< v 0) (= (json-kind b v) 7)) "" (string-from-utf8 (bytes-from-vector-i64 (json-canonical-bytes b v))))))
(defn- tv-unique? [b :vector-i64 arr :i64] :bool
  (let [n (json-count b arr)]
    (loop [i 0 j 1]
      (cond (>= i n) true
            (>= j n) (recur (+ i 1) (+ i 2))
            (= (tv-ident b (json-element b arr i)) (tv-ident b (json-element b arr j))) false
            :else (recur i (+ j 1))))))
(defn- tv-boolean? [b :vector-i64 v :i64] :bool (and (>= v 0) (or (= (json-kind b v) 5) (= (json-kind b v) 6))))
(defn- tv-entries-ok? [b :vector-i64 arr :i64] :bool
  (loop [k 0]
    (let [e (json-element b arr k)]
      (cond (< e 0) true
            (and (= (json-kind b e) 1) (tv-name-ok? (tv-text b e "node")) (tv-endpoint? (tv-text b e "url"))
                 (tv-boolean? b (json-member b e "enabled")))
            (recur (+ k 1))
            :else false))))
(defn- tv-role-ok? [b :vector-i64 r :i64] :bool
  (and (= (json-kind b r) 1)
       (let [kind (tv-text b r "kind")] (or (= kind "text") (= kind "image")))
       (let [n (tv-str-len b (json-member b r "model"))] (and (>= n 1) (<= n 128)))))
(defn- tv-roles-ok? [b :vector-i64 rs :i64] :bool
  (loop [j 0] (let [r (json-element b rs j)] (cond (< r 0) true (tv-role-ok? b r) (recur (+ j 1)) :else false))))
(defn- tv-nodes-roles-ok? [b :vector-i64 arr :i64] :bool
  (loop [k 0]
    (let [e (json-element b arr k)
          rs (if (>= e 0) (json-member b e "roles") -1)]
      (cond (< e 0) true
            (and (tv-owner-ok? (tv-text b e "owner-id")) (>= rs 0) (= (json-kind b rs) 2) (<= (json-count b rs) 8) (tv-roles-ok? b rs))
            (recur (+ k 1))
            :else false))))
(defn- tv-replicas-ok? [b :vector-i64 o :i64] :bool
  (loop [i (tv-skip b (+ o 1))]
    (cond (= (vector-at b i) 125) true
          (not (= (vector-at b i) 34)) false
          :else
          (let [ks (+ i 1)
                ke (loop [j ks] (if (= (vector-at b j) 34) j (recur (+ j 1))))
                v (tv-skip b (+ (tv-skip b (+ ke 1)) 1))
                nxt (tv-skip b (json-end b v))
                n (tv-u16 b ks ke)]
            (cond (not (and (>= n 1) (<= n 128) (= (json-kind b v) 4) (json-int-ok? b v) (>= (json-int b v) 1) (<= (json-int b v) 256))) false
                  (= (vector-at b nxt) 44) (recur (tv-skip b (+ nxt 1)))
                  :else true)))))
(defn topology-payload-problem [doc :vector-i64] :string
  (let [p (json-member doc (tv-root doc) "payload")
        rv (json-member doc p "revision") ns (json-member doc p "nodes") gs (json-member doc p "gateways")
        pol (json-member doc p "policies")
        mr (if (and (>= pol 0) (= (json-kind doc pol) 1)) (json-member doc pol "minimum-replicas") -1)]
    (cond (not (and (>= rv 0) (= (json-kind doc rv) 4) (json-int-ok? doc rv) (> (json-int doc rv) 0)
                    (>= ns 0) (= (json-kind doc ns) 2) (>= (json-count doc ns) 1) (<= (json-count doc ns) 256)
                    (>= gs 0) (= (json-kind doc gs) 2) (>= (json-count doc gs) 1) (<= (json-count doc gs) 16)))
          "topology/invalid-structure"
          (not (tv-unique? doc ns)) "topology/duplicate-identity"
          (not (tv-entries-ok? doc ns)) "topology/invalid-endpoint"
          (not (tv-unique? doc gs)) "topology/duplicate-identity"
          (not (tv-entries-ok? doc gs)) "topology/invalid-endpoint"
          (not (tv-nodes-roles-ok? doc ns)) "topology/invalid-roles"
          (not (and (>= mr 0) (= (json-kind doc mr) 1) (tv-replicas-ok? doc mr))) "topology/invalid-policy"
          :else "topology/ok")))
(defn topology-verdict [doc :vector-i64 trust :string threshold :i64 current :i64] :string
  (cond (> (vector-count doc) 262144) "topology/too-large"
        (not (json-valid? doc)) "topology/not-strict-json"
        :else
        (let [root (tv-root doc) p (json-member doc root "payload")]
          (if (or (< p 0) (not (= (json-kind doc p) 1))) "topology/no-payload"
            (let [cb (json-canonical-bytes doc p)]
              (cond (= (vector-count cb) 0) "topology/not-canonical-domain"
                    (or (not (tv-trust-ok? trust)) (< threshold 1) (> threshold (tv-count trust))) "topology/bad-trust"
                    :else
                    (let [text (string-from-utf8 (bytes-from-vector-i64 cb))
                          n (loop [x 0 n 0]
                              (if (= x (tv-count trust)) n
                                (recur (+ x 1) (if (tv-signed? doc root (tv-part trust x 0) (tv-part trust x 1) text) (+ n 1) n))))
                          s (json-member doc p "schema")]
                      (cond (< n threshold) "topology/needs-signatures"
                            (not (and (>= s 0) (json-int-ok? doc s) (= (json-int doc s) 1))) "topology/schema"
                            (not (= (topology-payload-problem doc) "topology/ok")) (topology-payload-problem doc)
                            :else (let [v (revision-verdict current (topology-revision doc))]
                                    (if (= v "intent/ok") "topology/ok" v))))))))))
(defn lease-ttl [] :i64 900000)
(defn lease-skew [] :i64 60000)
(defn majority [n :i64] :i64 (+ (quot n 2) 1))
(defn ballot-ok? [t :i64 id :string] :bool
  (and (> t 0) (<= t 9007199254740991) (>= (string-length id) 1) (<= (string-length id) 128)))
(defn ballot-cmp [ta :i64 ida :string tb :i64 idb :string] :i64
  (cond (> ta tb) 1 (< ta tb) -1 :else (string-compare ida idb)))
(defn prepare-ok? [bt :i64 bid :string pt :i64 pid :string] :bool
  (and (ballot-ok? bt bid) (>= (ballot-cmp bt bid pt pid) 0)))
(defn accept-ok? [bt :i64 bid :string value :string pt :i64 pid :string at :i64 aid :string accepted :string] :bool
  (and (ballot-ok? bt bid) (not (= value "")) (>= (ballot-cmp bt bid pt pid) 0)
       (or (not (and (= bt at) (= bid aid))) (= value accepted))))
(defn adopt? [at :i64 aid :string best-t :i64 best-id :string] :bool
  (and (> at 0) (> (ballot-cmp at aid best-t best-id) 0)))
(defn- lc-plain? [s :string] :bool
  (let [b (vector-i64-from-bytes (string-to-utf8 s))]
    (loop [i 0] (if (= i (vector-count b)) true (let [c (vector-at b i)] (if (and (>= c 33) (<= c 126) (not (= c 34)) (not (= c 92))) (recur (+ i 1)) false))))))
(defn lease-text [node :string class :string slot :i64 epoch :i64 until :i64 revision :i64] :string
  (str "{\"class\":\"" class "\",\"epoch\":" epoch ",\"node\":\"" node "\",\"revision\":" revision
       ",\"slot\":" slot ",\"until\":" until "}"))
(defn valid-value? [node :string enabled :bool class :string slot :i64 epoch :i64 until :i64 now :i64] :bool
  (and enabled (> (string-length node) 0) (lc-plain? node)
       (>= (string-length class) 1) (<= (string-length class) 128) (lc-plain? class)
       (>= slot 0) (<= slot 255) (>= epoch 1) (<= epoch 9007199254740991)
       (<= until (+ now (+ (lease-ttl) (lease-skew))))))
(defn- ln-listen [s :string] :string (typed-cap-call 43 :string :string s))
(defn- ln-accept [s :string] :string (typed-cap-call 44 :string :string s))
(defn- ln-dial [s :string] :string (typed-cap-call 45 :string :string s))
(defn- ln-read [s :string] :string (typed-cap-call 46 :string :string s))
(defn- ln-write [s :string] :string (typed-cap-call 47 :string :string s))
(defn- ln-say [s :string] :i64 (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 0))
(defn- ln-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))
(defn- ln-exists? [path :string] :bool (= (ln-fs "D" path "") "1"))
(defn- ln-load [path :string] :string (if (ln-exists? path) (ln-fs "A" path "") ""))
(defn- ln-dirname [path :string] :string
  (let [b (ln-bytes path) k (loop [i (- (vector-count b) 1)] (cond (< i 0) -1 (= (vector-at b i) 47) i :else (recur (- i 1))))]
    (if (< k 1) "/" (string-substring path 0 k))))
(defn- ln-store [path :string text :string] :i64
  (let [tmp (string-concat path ".tmp")
        w (ln-fs "B" tmp text)
        f (if (and (not (= text "")) (= w text)) (ln-fs "M" tmp "") "0")
        r (if (= f "1") (ln-fs "L" tmp path) "0")
        d (if (= r "1") (ln-fs "M" (ln-dirname path) "") "0")]
    (if (= d "1") 1 0)))
(defn- ln-init-fresh [path :string] :string
  (if (or (< (string-length path) 2) (not (= (string-substring path 0 1) "/"))
          (= (string-substring path (- (string-length path) 1) (string-length path)) "/"))
    "voter/init-refused"
    (let [parent (ln-dirname path) dir (ln-fs "N" parent ".voter-genesis-")]
      (if (= dir "") "voter/init-refused"
        (let [temp (str dir "/register") text "0 - 0 - -"
              wrote (= (ln-fs "B" temp text) text)
              flushed (and wrote (= (ln-fs "M" temp "") "1"))
              moved (and flushed (= (ln-fs "T" temp path) "1"))
              sync (and moved (= (ln-fs "M" parent "") "1"))
              removed (if moved true (= (ln-fs "J" temp "") "1"))
              cleaned (= (ln-fs "K" dir "") "1")]
          (cond (and moved sync cleaned) "voter/init-created"
                moved "voter/init-unknown"
                :else "voter/init-refused"))))))
(defn- ln-now [s :string] :i64 (if (= s "clock") (ln-int (typed-cap-call 7 :string :string "wall")) (ln-int s)))
(defn- ln-int [s :string] :i64
  (let [b (ln-bytes s)]
    (if (or (= (vector-count b) 0) (> (vector-count b) 16)) -1
      (loop [i 0 n 0] (if (= i (vector-count b)) n (let [c (vector-at b i)] (if (and (>= c 48) (<= c 57)) (recur (+ i 1) (+ (* n 10) (- c 48))) -1)))))))
(defn- ln-field [line :string k :i64] :string
  (let [b (ln-bytes line)]
    (loop [i 0 start 0 n 0]
      (cond (= i (vector-count b)) (if (= n k) (string-substring line start i) "")
            (or (= (vector-at b i) 32) (= (vector-at b i) 10)) (if (= n k) (string-substring line start i) (recur (+ i 1) (+ i 1) (+ n 1)))
            :else (recur (+ i 1) start n)))))
(defn- ln-dash [s :string] :string (if (= s "") "-" s))
(defn- ln-undash [s :string] :string (if (= s "-") "" s))
(defn- ln-addr [p :string] :string (if (>= (string-index-of p ":") 0) p (str "127.0.0.1:" p)))
(defn- ln-line [s :string] :string (let [k (string-index-of s "\n")] (if (< k 0) s (string-substring s 0 k))))
(defn- ln-rest [s :string] :string (let [k (string-index-of s " ")] (if (< k 0) "" (string-substring s (+ k 1) (string-length s)))))
(defn- ln-space? [c :i64] :bool (or (= c 32) (= c 9) (= c 10) (= c 13)))
(defn- ln-token [path :string] :string
  (if (or (= path "") (not (ln-exists? path))) ""
    (let [t (ln-fs "A" path "") b (ln-bytes t) n (vector-count b)
          i (loop [i 0] (if (and (< i n) (ln-space? (vector-at b i))) (recur (+ i 1)) i))
          j (loop [j n] (if (and (> j i) (ln-space? (vector-at b (- j 1)))) (recur (- j 1)) j))]
      (if (< (- j i) 32) "" (string-substring t i j)))))
(defn lease-token [path :string] :string (ln-token path))
(defn- ln-mac [token :string msg :string] :string (hmac-sha256-hex (ln-bytes token) (ln-bytes msg)))
(defn- ln-same? [a :string b :string] :bool
  (let [x (ln-bytes a) y (ln-bytes b)]
    (and (= (vector-count x) (vector-count y))
         (= (loop [i 0 d 0] (if (= i (vector-count x)) d (recur (+ i 1) (bit-or d (bit-xor (vector-at x i) (vector-at y i)))))) 0))))
(defn- ln-unhex [h :string] :string
  (let [b (ln-bytes h) n (quot (vector-count b) 2)
        v (loop [i 0 out (vector-alloc n)]
            (if (= i n) out
              (let [a (vector-at b (* 2 i)) c (vector-at b (+ (* 2 i) 1))
                    x (+ (* 16 (if (< a 58) (- a 48) (- a 87))) (if (< c 58) (- c 48) (- c 87)))]
                (recur (+ i 1) (vector-assoc! out i x)))))]
    (string-from-utf8 (bytes-from-vector-i64 v))))
(defn- ln-recv [c :string until-newline :bool] :string
  (loop [k 0 acc ""]
    (if (= k 16) acc
      (let [r (ln-read (str c " 4096 2000"))]
        (cond (= r "") acc
              (or (= r "timeout") (= r "closed") (= r "reset")) acc
              :else (let [acc2 (string-concat acc (ln-unhex r))]
                      (if (and until-newline (>= (string-index-of acc2 "\n") 0)) acc2 (recur (+ k 1) acc2))))))))
(defn- ln-reply [ok :bool st :string] :string (str (if ok "ok " "no ") st))
(defn- ln-text [b :vector-i64 obj :i64 key :string] :string
  (let [v (json-member b obj key)] (if (and (>= v 0) (= (json-kind b v) 3)) (json-string b v) "")))
(defn- ln-num [b :vector-i64 obj :i64 key :string] :i64
  (let [v (json-member b obj key)] (if (and (>= v 0) (= (json-kind b v) 4) (json-int-ok? b v)) (json-int b v) -1)))
(defn- ln-root [b :vector-i64] :i64
  (loop [i 0] (if (and (< i (vector-count b)) (let [c (vector-at b i)] (or (= c 32) (= c 9) (= c 10) (= c 13)))) (recur (+ i 1)) i)))
(defn- ln-enabled? [topo :vector-i64 node :string] :bool
  (let [p (json-member topo (ln-root topo) "payload") ns (if (>= p 0) (json-member topo p "nodes") -1)]
    (if (or (< ns 0) (not (= (json-kind topo ns) 2))) false
      (loop [k 0]
        (let [e (json-element topo ns k)]
          (cond (< e 0) false
                (and (= (json-kind topo e) 1) (= (ln-text topo e "node") node))
                (let [en (json-member topo e "enabled")] (and (>= en 0) (= (json-kind topo en) 5)))
                :else (recur (+ k 1))))))))
(defn- ln-member-ok? [topo :vector-i64 now :i64 value :string] :bool
  (if (= (vector-count topo) 0) true
    (let [v (ln-bytes value) r (ln-root v) node (ln-text v r "node")]
      (valid-value? node (ln-enabled? topo node) (ln-text v r "class") (ln-num v r "slot")
                    (ln-num v r "epoch") (ln-num v r "until") now))))
(defn- ln-state-ok? [st :string] :bool
  (let [pt (ln-int (ln-field st 0)) pid (ln-undash (ln-field st 1))
        at (ln-int (ln-field st 2)) aid (ln-undash (ln-field st 3)) av (ln-undash (ln-field st 4))]
    (and (>= pt 0) (>= at 0)
         (= st (str pt " " (ln-dash pid) " " at " " (ln-dash aid) " " (ln-dash av)))
         (if (= pt 0) (= pid "") (ballot-ok? pt pid))
         (if (= at 0) (and (= aid "") (= av ""))
           (and (ballot-ok? at aid) (not (= av ""))
                (>= (ballot-cmp pt pid at aid) 0)
                (json-valid? (ln-bytes av)) (json-canonical? (ln-bytes av)))))))
(defn- ln-handle [file :string req :string topo :vector-i64 now :i64] :string
  (let [st (ln-load file)
        pt (ln-int (ln-field st 0)) pid (ln-undash (ln-field st 1))
        at (ln-int (ln-field st 2)) aid (ln-undash (ln-field st 3)) av (ln-undash (ln-field st 4))
        op (ln-field req 0) bt (ln-int (ln-field req 1)) bid (ln-field req 2) v (ln-field req 3)]
    (cond (not (ln-state-ok? st)) "no 0 - 0 - -"
          (= op "prepare")
          (if (prepare-ok? bt bid pt pid)
            (let [ns (str bt " " bid " " at " " (ln-dash aid) " " (ln-dash av))] (if (= (ln-store file ns) 1) (ln-reply true ns) (ln-reply false st)))
            (ln-reply false st))
          (= op "accept")
          (if (and (json-canonical? (ln-bytes v)) (ln-member-ok? topo now v) (accept-ok? bt bid v pt pid at aid av))
            (let [ns (str bt " " bid " " bt " " bid " " v)] (if (= (ln-store file ns) 1) (ln-reply true ns) (ln-reply false st)))
            (ln-reply false st))
          :else (ln-reply false st))))
(defn- ln-ask [port :string line :string token :string] :string
  (let [c (ln-dial (str (ln-addr port) " 1000"))]
    (if (< (ln-int c) 1) ""
      (let [msg (if (= token "") line (str (ln-mac token (string-concat "req " line)) " " line))
            w (ln-write (str c " " (hex (ln-bytes (string-concat msg "\n")))))
            r (ln-line (ln-recv c false))
            z (ln-write c)]
        (cond (= token "") r
              (ln-same? (ln-field r 0) (ln-mac token (str "rep " line "\n" (ln-rest r)))) (ln-rest r)
              :else "")))))
(defn- ln-port-count [ports :string] :i64
  (if (= ports "") 0
    (let [b (ln-bytes ports)] (loop [i 0 n 1] (if (= i (vector-count b)) n (recur (+ i 1) (if (= (vector-at b i) 44) (+ n 1) n)))))))
(defn- ln-port [ports :string k :i64] :string
  (let [b (ln-bytes ports)]
    (loop [i 0 start 0 n 0]
      (cond (= i (vector-count b)) (if (= n k) (string-substring ports start i) "")
            (= (vector-at b i) 44) (if (= n k) (string-substring ports start i) (recur (+ i 1) (+ i 1) (+ n 1)))
            :else (recur (+ i 1) start n)))))
(defn- ln-phase [line :string t :i64 id :string own :string ports :string token :string] :string
  (let [n (ln-port-count ports)]
    (loop [k 0 oks 0 ans 0 pre 0 bt 0 bid "" bv own]
      (if (= k n) (str oks " " ans " " pre " " bv)
        (let [r (ln-ask (ln-port ports k) line token)
              ok (= (ln-field r 0) "ok")
              pt (ln-int (ln-field r 1)) pid (ln-undash (ln-field r 2))
              beats (and (= (ln-field r 0) "no") (> (ballot-cmp pt pid t id) 0) (> pt pre))
              at (ln-int (ln-field r 3)) aid (ln-undash (ln-field r 4)) av (ln-undash (ln-field r 5))
              better (and ok (adopt? at aid bt bid))]
          (recur (+ k 1) (if ok (+ oks 1) oks) (if (= r "") ans (+ ans 1)) (if beats pt pre)
                 (if better at bt) (if better aid bid) (if better av bv)))))))
(defn- ln-short [res :string phase :string need :i64] :string
  (let [oks (ln-field res 0)]
    (if (and (>= (ln-int (ln-field res 1)) need) (> (ln-int (ln-field res 2)) 0))
      (str "preempted " (ln-field res 2) " " phase " " oks)
      (str "no-majority " phase " " oks))))
(defn- ln-backoff [] :i64
  (let [b (ln-bytes (typed-cap-call 23 :string :string "1"))
        h (vector-at b 0) l (vector-at b 1)
        x (+ (* 16 (if (< h 58) (- h 48) (- h 87))) (if (< l 58) (- l 48) (- l 87)))
        s (typed-cap-call 7 :string :string (str "sleep " (+ 20 (quot (* x 200) 256))))]
    0))
(defn- cp-arg [i :i64] :string (typed-cap-call 38 :string :string (string-from-i64 i)))
(defn- cp-say [s :string] :i64 (let [x (typed-cap-call 37 :string :string (str s "\n"))] 0))
(defn- cp-read [p :string] :vector-i64 (cp-read-op p "A" ""))
(defn- cp-safe-absolute? [s :string] :bool
  (and (> (string-length s) 1) (= (string-substring s 0 1) "/")
       (= (field-problem s) "enroll/ok")
       (< (string-index-of s "_SEP") 0) (< (string-index-of s "..") 0)))
(defn- cp-str [b :vector-i64 o :i64 k :string] :string
  (let [v (json-member b o k)] (if (and (>= v 0) (= (json-kind b v) 3)) (json-string b v) "")))
(defn- cp-num [b :vector-i64 o :i64 k :string] :i64
  (let [v (json-member b o k)] (if (and (>= v 0) (= (json-kind b v) 4) (json-int-ok? b v)) (json-int b v) -1)))
(defn- rf-host [port :string] :string
  (let [i (string-index-of port ":")] (if (> i 0) (string-substring port 0 i) "")))
(defn- rf-voters? [ports :string] :bool
  (and (= (ln-port-count ports) 3)
    (let [a (rf-host (ln-port ports 0)) b (rf-host (ln-port ports 1)) c (rf-host (ln-port ports 2))]
      (and (not (= a "")) (not (= b "")) (not (= c "")) (not (= a b)) (not (= b c)) (not (= a c))))))
(defn- lg-epoch? [e :i64] :bool (and (> e 0) (<= e 1000000)))
(defn- lg-epoch-ready? [dir :string epoch :i64 file :string] :bool
  (let [water (str dir "/epoch-watermark") state (ln-load water)
        high (ln-int (ln-field state 0)) owner (ln-undash (ln-field state 1))]
    (and (ln-state-ok? state) (= (ln-int (ln-field state 2)) 0)
         (if (= high 0) (= owner "") (= owner "epoch"))
         (if (ln-exists? file) (<= epoch high)
           (and (= epoch (+ high 1)) (= (ln-store water (str epoch " epoch 0 - -")) 1)
                (= (ln-init-fresh file) "voter/init-created"))))))
(defn- lg-locked-request [dir :string epoch :i64 file :string line :string topo :vector-i64 now :i64] :string
  (let [lock (str dir "/.epoch-lock") acquired (= (ln-fs "I" lock "") "1")]
    (if (not acquired) "no 0 - 0 - -"
      (let [reply (if (lg-epoch-ready? dir epoch file) (ln-handle file line topo now) "no 0 - 0 - -")
            released (= (ln-fs "K" lock "") "1")]
        (if released reply "no 0 - 0 - -")))))
(defn- lg-request [line :string task :string dir :string topo :vector-i64 now :i64] :string
  (let [op (ln-field line 0) epoch (ln-int (ln-field line 1))
        t (ln-field line 2) id (ln-field line 3) value (ln-field line 4)
        v (ln-bytes value) file (str dir "/epoch-" epoch ".state")]
    (if (or (not (lg-epoch? epoch))
            (not (or (= op "prepare") (= op "accept"))) (not (ballot-ok? (ln-int t) id))
            (and (= op "accept")
              (or (not (json-valid? v)) (not (json-canonical? v))
                  (not (ln-member-ok? topo now value)) (not (= (cp-str v 0 "class") task)) (not (= (cp-num v 0 "slot") 0))
                  (not (= (cp-num v 0 "epoch") epoch))))) "no 0 - 0 - -"
      (lg-locked-request dir epoch file (str op " " t " " id (if (= op "accept") (str " " value) "")) topo now))))
(defn- lg-serve [l :string dir :string task :string topo :vector-i64 token :string] :i64
  (arena-scope
    (let [c (ln-accept (str l " 1000"))]
      (if (< (ln-int c) 1) 0
        (let [raw (ln-line (ln-recv c true)) line (ln-rest raw)
              ok (ln-same? (ln-field raw 0) (ln-mac token (str "req " line)))
              reply (if ok (lg-request line task dir topo (ln-now "clock")) "")
              sent (if ok (ln-write (str c " " (hex (ln-bytes (str (ln-mac token (str "rep " line "\n" reply)) " " reply "\n"))))) "")
              closed (ln-write c)] 0)))))
(defn- lg-try [epoch :i64 t :i64 node :string own :string ports :string token :string] :string
  (let [need (majority (ln-port-count ports))
        prep (ln-phase (str "prepare " epoch " " t " " node) t node own ports token)
        value (ln-field prep 3)]
    (if (< (ln-int (ln-field prep 0)) need) (ln-short prep "prepare" need)
      (let [acc (ln-phase (str "accept " epoch " " t " " node " " value) t node value ports token)]
        (if (< (ln-int (ln-field acc 0)) need) (ln-short acc "accept" need) (str "chosen " value))))))
(defn lease-group-round [epoch :i64 node :string own :string ports :string token :string] :string
  (if (or (not (lg-epoch? epoch)) (= token "") (not (rf-voters? ports))) ""
    (loop [k 0 t (ln-now "clock")]
      (let [r (lg-try epoch t node own ports token)]
        (cond (= (ln-field r 0) "chosen") (ln-field r 1)
              (and (= (ln-field r 0) "preempted") (< k 4))
              (let [z (ln-backoff)] (recur (+ k 1) (+ (ln-int (ln-field r 1)) 1)))
              :else "")))))
(defn lease-group-main [] :i64
  (let [addr (cp-arg 0) dir (cp-arg 1) task (cp-arg 2) topo (cp-read (cp-arg 3))
        trust (cp-arg 4) token (lease-token (cp-arg 5))]
    (if (or (= token "") (= task "") (not (lc-plain? task))
            (not (cp-safe-absolute? dir)) (not (= (topology-verdict topo trust 1 0) "topology/ok")))
      (let [x (cp-say "group/config-refused")] 2)
      (let [l (ln-listen addr)]
        (if (< (ln-int l) 1) (let [x (cp-say "group/listen-refused")] 2)
          (loop [i 0] (let [x (lg-serve l dir task topo token)] (recur (+ i 1)))))))))
(defn lower [c :i64] :i64 (if (and (>= c 65) (<= c 90)) (+ c 32) c))
(defn main [] :i64
 (let [e (ln-int (cp-arg 0)) node (cp-arg 1) ports (cp-arg 2) token (lease-token (cp-arg 3))
       own (lease-text node "awai147-test" 0 e (+ (ln-now "clock") (lease-ttl)) 1)
       value (lease-group-round e node own ports token) out (ln-say value)]
  (if (= value "") 1 0)))
