{:id "murakumo-gateway" :title "murakumo gateway max_tokens clamp and lane admission"
 :module-file "src/murakumo/infer/admission.kotoba"
 :preserved-check "(if (= (marker) 7) 0 1000)"
 :program
 {:goal "murakumo inference gateway admission. clamp-max-tokens(requested) is the minimum of the literal 2048 and requested. lane-fits(context, input, max-tokens) is true exactly when context >= input + max-tokens: if context is less than (input plus max-tokens) then false else true. fits-after-clamp(context, input, requested) is lane-fits(context, input, clamp-max-tokens(requested))."
  :stages [{:id "clamp" :goal "Outermost: minimum of the literal 2048 and requested." :operations ["minimum"] :calls [] :depends-on []} {:id "fit" :goal "Outermost: if. Condition: context less than (input plus max-tokens). Then: literal false. Else: literal true." :operations ["less-than" "add" "if-bool"] :calls [] :depends-on []} {:id "route" :goal "Outermost: call lane-fits with context, input, and clamp-max-tokens(requested), in that order." :operations [] :calls ["lane-fits" "clamp-max-tokens"] :depends-on ["clamp" "fit"]}]
  :functions [{:id "clamp-max-tokens" :stage "clamp" :goal "Outermost: minimum of the literal 2048 and requested." :args [{:name "requested" :type :i64}] :returns :i64} {:id "lane-fits" :stage "fit" :goal "Outermost: if. Condition: context less than (input plus max-tokens). Then: literal false. Else: literal true." :args [{:name "context" :type :i64} {:name "input" :type :i64} {:name "max-tokens" :type :i64}] :returns :bool} {:id "fits-after-clamp" :stage "route" :goal "Outermost: call lane-fits with arguments context, input, and clamp-max-tokens(requested), in that order." :args [{:name "context" :type :i64} {:name "input" :type :i64} {:name "requested" :type :i64}] :returns :bool}]
  :literals [{:id "max-output" :type :i64 :value 2048} {:id "true" :type :bool :value true} {:id "false" :type :bool :value false}]
  :max-decisions 128 :max-depth 6 :candidate-limit 8}
 :baseline "(ns murakumo.infer.admission (:export [clamp-max-tokens lane-fits fits-after-clamp marker]))
;; poll_worker.cljk clamps max_tokens with (min 2048 ...); resident.cljk admits a lane when context >= input + max_tokens.
(defn clamp-max-tokens [requested :i64] :i64 0)
(defn lane-fits [context :i64 input :i64 max-tokens :i64] :bool false)
(defn fits-after-clamp [context :i64 input :i64 requested :i64] :bool false)
(defn marker [] :i64 7)
"
 :check ";; Fixed acceptance checks (exhaustive grids, independent oracles) per function; marker must stay 7.
(defn chk-clamp [r :i64] :i64 (if (< 2048 r) 2048 r))
(defn chk-fit [c :i64 i :i64 m :i64] :i64 (if (< c (+ i m)) 0 1))
(defn chk-case-clamp-max-tokens [r :i64] :i64 (if (= (clamp-max-tokens r) (chk-clamp r)) 0 1))
(defn chk-clamp-max-tokens-r [r :i64 bad :i64] :i64 (if (< r 4100) (chk-clamp-max-tokens-r (+ r 1) (+ bad (chk-case-clamp-max-tokens r))) bad))
(defn chk-case-lane-fits [c :i64 i :i64 m :i64] :i64 (if (lane-fits c i m) (- 1 (chk-fit c i m)) (chk-fit c i m)))
(defn chk-lane-fits-c [c :i64 bad :i64] :i64 (if (< c 21) (chk-lane-fits-c (+ c 1) (chk-lane-fits-i c 0 bad)) bad))
(defn chk-lane-fits-i [c :i64 i :i64 bad :i64] :i64 (if (< i 21) (chk-lane-fits-i c (+ i 1) (chk-lane-fits-m c i 0 bad)) bad))
(defn chk-lane-fits-m [c :i64 i :i64 m :i64 bad :i64] :i64 (if (< m 21) (chk-lane-fits-m c i (+ m 1) (+ bad (chk-case-lane-fits c i m))) bad))
(defn chk-case-fits-after-clamp [c :i64 i :i64 r :i64] :i64 (if (fits-after-clamp (+ 2040 c) i (+ 2040 r)) (- 1 (chk-fit (+ 2040 c) i (chk-clamp (+ 2040 r)))) (chk-fit (+ 2040 c) i (chk-clamp (+ 2040 r)))))
(defn chk-fits-after-clamp-c [c :i64 bad :i64] :i64 (if (< c 21) (chk-fits-after-clamp-c (+ c 1) (chk-fits-after-clamp-i c 0 bad)) bad))
(defn chk-fits-after-clamp-i [c :i64 i :i64 bad :i64] :i64 (if (< i 11) (chk-fits-after-clamp-i c (+ i 1) (chk-fits-after-clamp-r c i 0 bad)) bad))
(defn chk-fits-after-clamp-r [c :i64 i :i64 r :i64 bad :i64] :i64 (if (< r 21) (chk-fits-after-clamp-r c i (+ r 1) (+ bad (chk-case-fits-after-clamp c i r))) bad))
"
 :checks {"clamp-max-tokens" "(chk-clamp-max-tokens-r 0 0)" "lane-fits" "(chk-lane-fits-c 0 0)" "fits-after-clamp" "(chk-fits-after-clamp-c 0 0)"}
 :cases 18212
 :known {"clamp-max-tokens" "(min 2048 requested)" "lane-fits" "(if (< context (+ input max-tokens)) false true)" "fits-after-clamp" "(lane-fits context input (clamp-max-tokens requested))"}
 :wrong {"clamp-max-tokens" "(min 2048 requested)" "lane-fits" "(if (< context (+ input max-tokens)) false true)" "fits-after-clamp" "(lane-fits context input requested)"}}
