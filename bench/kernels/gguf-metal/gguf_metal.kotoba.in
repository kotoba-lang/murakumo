(ns murakumo.gguf-metal (:export [main]))

;; E1, first slice (S1; AWAI-2851): read a GGUF file from a Kotoba program on the Metal route
;; (amu ADR 0405, profile amu-program-metal, which gives the program libSystem through dyld, so open / pread /
;; fstat / lseek are ordinary C calls). Layout follows llama.cpp ggml/include/gguf.h (magic "GGUF", version u32,
;; n_tensors i64, n_kv i64, KVs, tensor infos, aligned data blob) and ggml.h dtype ids (F32 = 0, Q8_0 = 8; a Q8_0
;; block is one fp16 scale + 32 int8 = 34 bytes). The program first checks the file's SHA-256 against the pinned
;; digest file (@EXPECT@, first 64 characters; the same helpers as bench/kernels/pipeline-metal slice 37 and
;; bench/kernels/sha256-metal), then reads the whole file (refused over 16 MiB; chunked data reads land in S8),
;; walks the KVs (printing each; the tokenizer arrays are skipped by length, never decoded — no Qwen encode in E1,
;; the gate feeds fixed id vectors), walks the tensor infos (one line per tensor in file order:
;; `name dtype d0xd1... begin end`), reads the data region into a Metal buffer (newBufferWithLength + pread into
;; its contents), folds it eight bytes at a time and prints `data-bytes N checksum C` where C = (C * 31 + word)
;; mod 2^48. Refused before the checksum is printed (a message on stderr, then a trap): a digest mismatch (before
;; any tensor is read), bad magic, a version other than 3, a truncated file, an unknown dtype, a Q8_0 tensor whose
;; length is not a multiple of 32 elements, a span that disagrees with shape and dtype, a largest data_offsets end
;; that is not the data region's size, a file over 16 MiB. KV pin expectations (arch qwen2, block counts, head
;; counts, rope base, rms eps, tokenizer ids and lengths) are asserted by line-for-line equality with the Python
;; oracle in run.sh, which embeds them — the same mechanism every stage-M gate uses. Not implemented: dtypes other
;; than F32 and Q8_0, alignments other than 32, names with bytes outside UTF-8, files whose data region is not a
;; multiple of 8 bytes.
;; The path is @PATH@, the pinned digest file @EXPECT@.

(defn- mask48 [] :i64 281474976710655)

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- byte-at [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (bit-and (peek f p) 255))

;; write n bytes at p to stderr
(defn- wr [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (cc f (sym f "write") 2 p n 0 0))

(defn- wr-text [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (wr f (cstr f (vector-at R 3) s) (string-length s)))

(defn- wr-num [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 v :i64] :i64
  (wr-text f R (string-from-i64 v)))

;; trap unless the n bytes at p+i are inside the end bound eb
(defn- need [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 n :i64 eb :i64] :i64
  (if (> (+ i n) eb) (vector-at [0] 1) 0))

;; little-endian u32 at p+i
(defn- u32le [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64] :i64
  (bit-and (peek f (+ p i)) 4294967295))

;; ---- digest-before-read (slice 37): SHA-256 of the checkpoint file, compared with the pinned digest file ----
;; The same code as bench/kernels/sha256-metal, as helpers. The expected digest is the first 64 characters of the pinned
;; digest file (main passes its path); a different digest, or an unreadable file, traps before the checkpoint is read for any other purpose.
(defn- sha-m32 [] :i64 4294967295)
(defn- sha-rotr [x :i64 n :i64] :i64
  (bit-and (bit-or (i64-shift-right x n) (i64-shift-left x (- 32 n))) (sha-m32)))
(defn- sha-shr [x :i64 n :i64] :i64 (i64-shift-right x n))
(defn- sha-add [a :i64 b :i64] :i64 (bit-and (+ a b) (sha-m32)))

(defn- sha-ksched [] :vector-i64
  (vector-i64 1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895))
(defn- sha-ksched2 [] :vector-i64
  (vector-i64 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298))
;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- sha-s0 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 7) (sha-rotr x 18)) (sha-shr x 3)))
(defn- sha-s1 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 17) (sha-rotr x 19)) (sha-shr x 10)))
(defn- sha-S0 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 2) (sha-rotr x 13)) (sha-rotr x 22)))
(defn- sha-S1 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 6) (sha-rotr x 11)) (sha-rotr x 25)))
(defn- sha-ch [e :i64 f :i64 g :i64] :i64 (bit-xor (bit-and e f) (bit-and (bit-xor e (sha-m32)) g)))
(defn- sha-maj [a :i64 b :i64 c :i64] :i64 (bit-xor (bit-xor (bit-and a b) (bit-and a c)) (bit-and b c)))

;; big-endian 32-bit word from four bytes at p
(defn- sha-be32 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64
  (let [w (bit-and (peek f p) (sha-m32))]
    (bit-or (bit-or (i64-shift-left (bit-and w 255) 24) (i64-shift-left (bit-and (i64-shift-right w 8) 255) 16))
            (bit-or (i64-shift-left (bit-and (i64-shift-right w 16) 255) 8) (bit-and (i64-shift-right w 24) 255)))))

;; one 64-byte sha-block at p: H is updated in place, K the 64 round constants, W a 64-word scratch vector
(defn- sha-block [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 H :vector-i64 K :vector-i64 W :vector-i64] :i64
  (let [u0 (loop [t 0]
             (if (= t 16) 0
               (let [u (vector-assoc! W t (sha-be32 f (+ p (* t 4))))] (recur (+ t 1)))))
        u1 (loop [t 16]
             (if (= t 64) 0
               (let [v (sha-add (sha-add (sha-s1 (vector-at W (- t 2))) (vector-at W (- t 7)))
                            (sha-add (sha-s0 (vector-at W (- t 15))) (vector-at W (- t 16))))
                     u (vector-assoc! W t v)]
                 (recur (+ t 1)))))]
    (loop [t 0
           a (vector-at H 0) b (vector-at H 1) c (vector-at H 2) d (vector-at H 3)
           e (vector-at H 4) ff (vector-at H 5) g (vector-at H 6) h (vector-at H 7)]
      (if (= t 64)
        (let [x0 (vector-assoc! H 0 (sha-add (vector-at H 0) a)) x1 (vector-assoc! H 1 (sha-add (vector-at H 1) b))
              x2 (vector-assoc! H 2 (sha-add (vector-at H 2) c)) x3 (vector-assoc! H 3 (sha-add (vector-at H 3) d))
              x4 (vector-assoc! H 4 (sha-add (vector-at H 4) e)) x5 (vector-assoc! H 5 (sha-add (vector-at H 5) ff))
              x6 (vector-assoc! H 6 (sha-add (vector-at H 6) g)) x7 (vector-assoc! H 7 (sha-add (vector-at H 7) h))]
          0)
        (let [t1 (sha-add (sha-add (sha-add h (sha-S1 e)) (sha-add (sha-ch e ff g) (vector-at K t))) (vector-at W t))
              t2 (sha-add (sha-S0 a) (sha-maj a b c))]
          (recur (+ t 1) (sha-add t1 t2) a b c (sha-add d t1) e ff g))))))

(defn- sha-hex-digest [H :vector-i64] :string
  (loop [i 0 s ""]
    (if (= i 8) s
      (let [w (vector-at H i)
            t (loop [k 0 acc ""]
                (if (= k 8) acc
                  (let [d (bit-and (i64-shift-right w (- 28 (* 4 k))) 15)]
                    (recur (+ k 1) (string-concat acc (string-substring "0123456789abcdef" d (+ d 1)))))))]
        (recur (+ i 1) (string-concat s t))))))

;; hex digest of the file at path, 64 lowercase hex characters
(defn- sha-file [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64] :string
  (let [total (cc f (sym f "lseek") fd 0 2 0 0)
        chunk 1048576
        buf (cc f (vector-at R 3) (+ chunk 8) 0 0 0 0)
        tail (cc f (vector-at R 3) 256 0 0 0 0)
        K (vector-alloc 64)
        k1 (loop [t 0] (if (= t 32) 0 (let [u (vector-assoc! K t (vector-at (sha-ksched) t))] (recur (+ t 1)))))
        k2 (loop [t 0] (if (= t 32) 0 (let [u (vector-assoc! K (+ 32 t) (vector-at (sha-ksched2) t))] (recur (+ t 1)))))
        W (vector-alloc 64)
        H (vector-i64 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225)
        full (* (quot total 64) 64)
        u1 (loop [off 0]
             (if (>= off full) 0
               (let [want (if (< (- full off) chunk) (- full off) chunk)
                     got (cc f (sym f "pread") fd buf want off 0)
                     u (if (= got want) 0 (vector-at [0] 1))
                     w (loop [p 0]
                         (if (>= p want) 0
                           (let [b (sha-block f (+ buf p) H K W)] (recur (+ p 64)))))]
                 (recur (+ off want)))))
        rem (- total full)
        z (loop [i 0] (if (= i 256) 0 (let [u (poke8 f (+ tail i) 0)] (recur (+ i 1)))))
        got2 (if (= rem 0) 0 (cc f (sym f "pread") fd tail rem full 0))
        u2 (if (= got2 rem) 0 (vector-at [0] 1))
        u3 (poke8 f (+ tail rem) 128)
        nb (if (< rem 56) 64 128)
        bits (* total 8)
        u4 (loop [i 0]
             (if (= i 8) 0
               (let [u (poke8 f (+ tail (+ (- nb 1) (- 0 i))) (bit-and (i64-shift-right bits (* 8 i)) 255))] (recur (+ i 1)))))
        u5 (sha-block f tail H K W)
        u6 (if (= nb 128) (sha-block f (+ tail 64) H K W) 0)]
    (sha-hex-digest H)))


;; fstat (macOS arm64 struct stat: st_mtimespec at 48, st_ctimespec at 64, st_size at 96): size, mtime and ctime (seconds and nanoseconds) of an
;; open file. ctime is set by the kernel on any write or metadata change and cannot be set back by a program.
(defn- fd-stamp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64] :vector-i64
  (let [sb (cc f (vector-at R 3) 160 0 0 0 0)
        r (cc f (sym f "fstat") fd sb 0 0 0)
        u (if (= r 0) 0 (vector-at [0] 1))]
    (vector-i64 (peek f (+ sb 96)) (peek f (+ sb 48)) (peek f (+ sb 56)) (peek f (+ sb 64)) (peek f (+ sb 72)))))
;; traps if the open file's size, modification time or change time differs from the stamp taken before it was hashed
(defn- stamp-same! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64 st0 :vector-i64] :i64
  (let [st1 (fd-stamp f R fd)]
    (if (= (+ (+ (+ (bit-xor (vector-at st0 0) (vector-at st1 0)) (bit-xor (vector-at st0 1) (vector-at st1 1))) (+ (bit-xor (vector-at st0 2) (vector-at st1 2)) (bit-xor (vector-at st0 3) (vector-at st1 3)))) (bit-xor (vector-at st0 4) (vector-at st1 4))) 0)
      0 (vector-at [0] 1))))

(defn- sha-verify! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64 expect :string] :vector-i64
  (let [st0 (fd-stamp f R fd)
        want (cc f (sym f "open") (cstr f (vector-at R 3) expect) 0 0 0 0)
        u0 (if (< want 0) (vector-at [0] 1) 0)
        eb (cc f (vector-at R 3) 80 0 0 0 0)
        z (loop [i 0] (if (= i 80) 0 (let [u (poke8 f (+ eb i) 0)] (recur (+ i 1)))))
        got0 (cc f (sym f "pread") want eb 64 0 0)
        u1 (if (= got0 64) 0 (vector-at [0] 1))
        have (vector-i64-from-bytes (string-to-utf8 (sha-file f R fd)))
        bad (loop [i 0 acc 0]
              (if (= i 64) acc
                (recur (+ i 1) (+ acc (if (= (bit-and (peek f (+ eb i)) 255) (vector-at have i)) 0 1)))))
        trap (if (= bad 0) 0 (vector-at [0] 1))]
    st0))

;; ---- GGUF walk: every load is bounds-checked against eb (the file size) ----
;; one fixed-size GGUF value's byte size, 0 for string / array / unknown
(defn- vsize [t :i64] :i64
  (cond
    (= t 0) 1 (= t 1) 1 (= t 7) 1
    (= t 2) 2 (= t 3) 2
    (= t 4) 4 (= t 5) 4 (= t 6) 4
    (= t 10) 8 (= t 11) 8 (= t 12) 8
    :else 0))

;; skip the string at p+i (u64 length + bytes); returns the index after it
(defn- skip-str [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 eb :i64] :i64
  (let [u (need f p i 8 eb)
        ln (peek f (+ p i))
        nx (+ (+ i 8) ln)
        u2 (if (or (< ln 0) (> nx eb)) (vector-at [0] 1) 0)]
    nx))

;; print one KV's value at p+i of type t; returns the index after it.
;; scalars print as unsigned numbers (f32 as raw bits, exact), strings print raw, arrays print `elemtype:count`.
(defn- kv-value [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 i :i64 t :i64 eb :i64] :i64
  (let [s (vsize t)]
    (cond
      (> s 0) (let [u (need f p i s eb)
                    v (cond (= s 8) (peek f (+ p i))
                            (= s 4) (u32le f p i)
                            (= s 2) (+ (byte-at f (+ p i)) (* 256 (byte-at f (+ p (+ i 1)))))
                            :else (byte-at f (+ p i)))
                    w (wr-text f R " ")
                    x (wr-num f R v)
                    y (wr-text f R "\n")]
                (+ i s))
      (= t 8) (let [u (need f p i 8 eb)
                    ln (peek f (+ p i))
                    u2 (if (or (< ln 0) (> (+ (+ i 8) ln) eb)) (vector-at [0] 1) 0)
                    w (wr-text f R " ")
                    x (wr f (+ p (+ i 8)) ln)
                    y (wr-text f R "\n")]
                (+ (+ i 8) ln))
      (= t 9) (let [u (need f p i 12 eb)
                    et (u32le f p i)
                    cn (peek f (+ p (+ i 4)))
                    u2 (if (or (< cn 0) (> cn eb)) (vector-at [0] 1) 0)
                    w (wr-text f R " ")
                    x (wr-num f R et)
                    y (wr-text f R ":")
                    z (wr-num f R cn)
                    a (wr-text f R "\n")]
                (if (> (vsize et) 0)
                  (let [nx (+ (+ i 12) (* cn (vsize et)))
                        u3 (if (or (> nx eb) (< nx i)) (vector-at [0] 1) 0)]
                    nx)
                  (if (= et 8)
                    (loop [k 0 j (+ i 12)]
                      (if (= k cn) j
                        (recur (+ k 1) (skip-str f p j eb))))
                    (vector-at [0] 1))))
      :else (vector-at [0] 1))))

;; print the nk KVs starting at p+i (one `kv name type value` line each); returns the index after them
(defn- kv-walk [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 i :i64 nk :i64 eb :i64] :i64
  (loop [k 0 j i]
    (if (= k nk) j
      (let [u (need f p j 8 eb)
            ln (peek f (+ p j))
            ns (+ j 8)
            u2 (if (or (< ln 0) (> (+ ns ln) eb)) (vector-at [0] 1) 0)
            w (wr-text f R "kv ")
            x (wr f (+ p ns) ln)
            y (wr-text f R " ")
            after (+ ns ln)
            u3 (need f p after 4 eb)
            t (u32le f p after)
            z (wr-num f R t)
            nx (kv-value f R p (+ after 4) t eb)]
        (recur (+ k 1) nx)))))

;; print the tensor catalog (one line per tensor, file order): `name dtype d0xd1... begin end`.
;; chk[0] = largest data_offsets end, chk[1] = tensors whose span disagrees with shape, dtype,
;; 32-alignment, or the previous tensor's end (a backward step overlaps it and is refused).
;; returns the index after the last tensor info.
(defn- tensor-walk [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 i :i64 nt :i64 eb :i64 chk :vector-i64] :i64
  (loop [k 0 j i prev 0]
    (if (= k nt) j
      (let [u (need f p j 8 eb)
            ln (peek f (+ p j))
            ns (+ j 8)
            u2 (if (or (< ln 0) (> (+ ns ln) eb)) (vector-at [0] 1) 0)
            w0 (wr f (+ p ns) ln)
            w1 (wr-text f R " ")
            after (+ ns ln)
            u3 (need f p after 4 eb)
            nd (u32le f p after)
            u4 (if (or (< nd 1) (> nd 8)) (let [w (wr-text f R "refused: bad rank\n")] (vector-at [0] 1)) 0)
            qr (loop [d 0 q (+ after 4) pr 1]
                 (let [ud (need f p q 8 eb)
                       dv (peek f (+ p q))
                       ud2 (if (<= dv 0) (let [w (wr-text f R "refused: bad dim\n")] (vector-at [0] 1)) 0)
                       nq (+ q 8)
                       npr (* pr dv)]
                   (if (= (+ d 1) nd) (vector-i64 nq npr)
                     (recur (+ d 1) nq npr))))
            q2 (vector-at qr 0)
            pr (vector-at qr 1)
            u5 (need f p q2 12 eb)
            dt (u32le f p q2)
            off (peek f (+ p (+ q2 4)))
            w3 (wr-num f R dt)
            w4 (wr-text f R " ")
            wd (loop [d 0 q (+ after 4)]
                 (if (= d nd) 0
                   (let [x (if (= d 0) 0 (wr-text f R "x"))
                         y (wr-num f R (peek f (+ p q)))]
                     (recur (+ d 1) (+ q 8)))))
            w2 (wr-text f R " ")
            size (cond
                   (= dt 0) (* pr 4)
                   (= dt 8) (if (= (rem pr 32) 0) (* (quot pr 32) 34) -1)
                   :else -1)
            u6 (if (< size 0) (let [w (wr-text f R "refused: unknown dtype or bad Q8_0 length\n")] (vector-at [0] 1)) 0)
            end (+ off size)
            bad (if (= (+ (+ (if (< off 0) 1 0) (if (= (rem off 32) 0) 0 1)) (if (< off prev) 1 0)) 0) 0 1)
            u7 (if (= bad 0) 0 (let [w (vector-assoc! chk 1 (+ (vector-at chk 1) 1))] 0))
            u8 (if (> end (vector-at chk 0)) (let [w (vector-assoc! chk 0 end)] 0) 0)
            w5 (wr-num f R off)
            w6 (wr-text f R " ")
            w7 (wr-num f R end)
            w8 (wr-text f R "\n")]
        (recur (+ k 1) (+ q2 12) end)))))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        fd (cc f (sym f "open") (cstr f (vector-at R 3) "@PATH@") 0 0 0 0)
        u0 (if (< fd 0) (vector-at [0] 1) 0)
        shv (sha-verify! f R fd "@EXPECT@")
        total (cc f (sym f "lseek") fd 0 2 0 0)
        u1 (if (< total 24) (let [w (wr-text f R "refused: truncated header\n")] (vector-at [0] 1)) 0)
        u1b (if (> total 16777216) (let [w (wr-text f R "refused: file over 16 MiB, chunked reads land in S8\n")] (vector-at [0] 1)) 0)
        fbuf (cc f (vector-at R 3) total 0 0 0 0)
        got (cc f (sym f "pread") fd fbuf total 0 0)
        u2 (if (= got total) 0 (let [w (wr-text f R "refused: short read\n")] (vector-at [0] 1)))
        m (if (= (+ (+ (+ (bit-xor (byte-at f fbuf) 71) (bit-xor (byte-at f (+ fbuf 1)) 71)) (bit-xor (byte-at f (+ fbuf 2)) 85)) (bit-xor (byte-at f (+ fbuf 3)) 70)) 0) 0 (let [w (wr-text f R "refused: bad magic\n")] (vector-at [0] 1)))
        ver (u32le f fbuf 4)
        u3 (if (= ver 3) 0 (let [w (wr-text f R "refused: bad version\n")] (vector-at [0] 1)))
        nt (peek f (+ fbuf 8))
        nk (peek f (+ fbuf 16))
        u4 (if (or (<= nt 0) (< nk 0)) (let [w (wr-text f R "refused: bad counts\n")] (vector-at [0] 1)) 0)
        kpos (kv-walk f R fbuf 24 nk total)
        u5 (wr-text f R "kvs ")
        u6 (wr-num f R nk)
        u7 (wr-text f R "\n")
        chk (vector-alloc 2)
        tpos (tensor-walk f R fbuf kpos nt total chk)
        u8 (wr-text f R "tensors ")
        u9 (wr-num f R nt)
        u10 (wr-text f R "\n")
        r (rem tpos 32)
        dstart (if (= r 0) tpos (+ tpos (- 32 r)))
        dlen (- total dstart)
        r1 (if (= (vector-at chk 1) 0) 0 (let [w (wr-text f R "refused: a tensor's size differs from its shape and dtype\n")] (vector-at [0] 1)))
        r2 (if (= (vector-at chk 0) dlen) 0 (let [w (wr-text f R "refused: data_offsets do not match the data region size\n")] (vector-at [0] 1)))
        buf (msg f R dev "newBufferWithLength:options:" dlen 0 0)
        u11 (if (= buf 0) (vector-at [0] 1) 0)
        data (msg f R buf "contents" 0 0 0)
        got2 (cc f (sym f "pread") fd data dlen dstart 0)
        u12 (if (= got2 dlen) (stamp-same! f R fd shv) (vector-at [0] 1))
        c (loop [i 0 c 0]
            (if (>= i dlen) c
              (recur (+ i 8) (bit-and (+ (* c 31) (peek f (+ data i))) (mask48)))))
        u13 (wr-text f R "data-bytes ")
        u14 (wr-num f R dlen)
        u15 (wr-text f R " checksum ")
        u16 (wr-num f R c)
        u17 (wr-text f R "\n")]
    c))
