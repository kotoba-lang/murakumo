(ns murakumo.resblock-metal (:export [main]))

;; Stage M, slice 8 (JUN-927, ADR-261106): an SDXL-style ResBlock run end to end on the Apple GPU
;; from one Kotoba program built by Amu selfhost (amu ADR 0405, profile amu-program-metal), all of
;; its kernels dispatched into ONE command buffer and one encoder, each reading what the previous wrote:
;;   a = silu(groupnorm(x));  h1 = conv3x3(a) + c1 + linear(silu(temb));  b = silu(groupnorm(h1));
;;   sk = conv1x1(x) + bs;  out = conv3x3(b) + c2 + sk
;; CI = 32 -> CO = 64 channels on a 16 x 16 image, 32 GroupNorm groups (ComfyUI's), time embedding 64.
;; Parameters are the 16-bit integers of bench/kernels/resblock (the same LCG stream, the same
;; order: x, temb, g1, b1, w1, c1, wt, bt, g2, b2, w2, c2, ws, bs) turned into float (scale, add) or,
;; for x, w1, w2 and ws used by the matrix units, into half on the GPU. Activations between the
;; stages are half where a convolution reads them. The raw float32 `out` goes to stderr first
;; (64 * 256 * 4 bytes), then the timing of the whole sequence.

(defn- mask48 [] :i64 281474976710655)

(defn- kernel-source [] :string
  "#include <metal_stdlib>
#include <metal_simdgroup_matrix>
using namespace metal;
// ---- conversions: shorts -> float (scale, add) or half (scale); P holds two floats per word
kernel void cvt_f(device const short *S [[buffer(0)]], device float *F [[buffer(1)]], device const float *P [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
  F[i] = float(S[i]) * P[0] + P[1];
}
kernel void cvt_h(device const short *S [[buffer(0)]], device half *H [[buffer(1)]], device const float *P [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
  H[i] = half(float(S[i]) * P[0]);
}
// ---- GroupNorm (affine) + SiLU, float in, half out. P = {C, HW, NG}
kernel void gn_silu_h(device const float *X [[buffer(0)]], device const float *Ga [[buffer(1)]], device const float *Be [[buffer(2)]],
                      device half *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                      uint g [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
                      uint lane [[thread_index_in_simdgroup]], uint sgi [[simdgroup_index_in_threadgroup]]) {
  threadgroup float part[4];
  threadgroup float stat[2];
  uint C = P[0]; uint HW = P[1]; uint NG = P[2];
  uint n = (C / NG) * HW;
  uint base = g * n;
  float s = 0.0f;
  for (uint i = tid; i < n; i += 128u) s += X[base + i];
  s = simd_sum(s);
  if (lane == 0u) part[sgi] = s;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[0] = (part[0] + part[1] + part[2] + part[3]) / float(n);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float mean = stat[0];
  float q = 0.0f;
  for (uint i = tid; i < n; i += 128u) { float d = X[base + i] - mean; q += d * d; }
  q = simd_sum(q);
  if (lane == 0u) part[sgi] = q;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[1] = 1.0f / precise::sqrt((part[0] + part[1] + part[2] + part[3]) / float(n) + 0.00001f);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float inv = stat[1];
  for (uint i = tid; i < n; i += 128u) {
    uint ch = g * (C / NG) + i / HW;
    float v = ((X[base + i] - mean) * inv) * Ga[ch] + Be[ch];
    O[base + i] = half(v / (1.0f + precise::exp(-v)));
  }
}
// ---- bias1[c] = c1[c] + bt[c] + sum_k silu(temb[k]) * wt[k*CO + c]. P = {TE, CO}
kernel void temb_bias(device const float *Te [[buffer(0)]], device const float *Wt [[buffer(1)]], device const float *Bt [[buffer(2)]],
                      device const float *C1 [[buffer(3)]], device float *O [[buffer(4)]], device const uint *P [[buffer(5)]],
                      uint c [[thread_position_in_grid]]) {
  uint TE = P[0]; uint CO = P[1];
  float acc = Bt[c];
  for (uint k = 0u; k < TE; k++) { float t = Te[k]; acc += (t / (1.0f + precise::exp(-t))) * Wt[k * CO + c]; }
  O[c] = acc + C1[c];
}
// ---- implicit-GEMM convolution with epilogue (slice 4). P = {CIN, COUT, IH, IW, KS, STR, OW, NP, NPP, MODE}
kernel void conv(device const half *X [[buffer(0)]], device const half *Wt [[buffer(1)]], device const float *Bias [[buffer(2)]],
                 device const float *Res [[buffer(3)]], device float *C [[buffer(4)]], device const uint *P [[buffer(5)]],
                 uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                 uint tid [[thread_index_in_threadgroup]]) {
  threadgroup half As[64 * 32];
  threadgroup half Bs[32 * 64];
  threadgroup float Cs[64 * 64];
  uint CIN = P[0]; uint COUT = P[1]; uint IH = P[2]; uint IW = P[3]; uint KS = P[4]; uint STR = P[5];
  uint OW = P[6]; uint NP = P[7]; uint NPP = P[8]; uint MODE = P[9];
  int PADV = int(KS) / 2;
  uint KD = CIN * KS * KS;
  uint KDP = ((KD + 31u) / 32u) * 32u;
  uint m0 = tg.y * 64u;
  uint n0 = tg.x * 64u;
  uint row0 = (sg / 2u) * 32u;
  uint col0 = (sg % 2u) * 32u;
  simdgroup_float8x8 acc[4][4];
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      acc[i][j] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  for (uint k0 = 0u; k0 < KDP; k0 += 32u) {
    for (uint idx = tid; idx < 2048u; idx += 128u) {
      uint r = idx / 32u;
      uint c = idx % 32u;
      uint m = m0 + r;
      uint kc = k0 + c;
      As[idx] = (m < COUT && kc < KD) ? Wt[m * KD + kc] : half(0.0f);
      uint kk = idx / 64u;
      uint n = idx % 64u;
      uint k = k0 + kk;
      uint p = n0 + n;
      half v = half(0.0f);
      if (k < KD && p < NP) {
        uint ci = k / (KS * KS);
        uint kr = k % (KS * KS);
        int yy = int((p / OW) * STR) + int(kr / KS) - PADV;
        int xx = int((p % OW) * STR) + int(kr % KS) - PADV;
        if (yy >= 0 && yy < int(IH) && xx >= 0 && xx < int(IW))
          v = X[(ci * IH + uint(yy)) * IW + uint(xx)];
      }
      Bs[idx] = v;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint ks = 0u; ks < 4u; ks++) {
      simdgroup_half8x8 a[4];
      simdgroup_half8x8 b[4];
      for (uint i = 0u; i < 4u; i++)
        simdgroup_load(a[i], As + (row0 + i * 8u) * 32u + ks * 8u, 32u);
      for (uint j = 0u; j < 4u; j++)
        simdgroup_load(b[j], Bs + ks * 8u * 64u + col0 + j * 8u, 64u);
      for (uint i = 0u; i < 4u; i++)
        for (uint j = 0u; j < 4u; j++)
          simdgroup_multiply_accumulate(acc[i][j], a[i], b[j], acc[i][j]);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      simdgroup_store(acc[i][j], Cs + (row0 + i * 8u) * 64u + col0 + j * 8u, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint idx = tid; idx < 4096u; idx += 128u) {
    uint m = m0 + idx / 64u;
    uint p = n0 + idx % 64u;
    if (m < COUT && p < NP) {
      float v = Cs[idx];
      if (MODE >= 1u) v += Bias[m];
      if (MODE == 2u) v += Res[m * NP + p];
      C[m * NPP + p] = v;
    }
  }
}
")

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        strlen (sym f "strlen")
        n (cc f strlen t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

(defn- lcg [s :i64] :i64
  (bit-and (+ (* s 1103515245) 12345) 2147483647))

;; n signed 16-bit values (LCG draw & 65535, minus 32768), four per word, as shorts.
(defn- fill-shorts [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 s seed]
    (if (>= i n) s
      (let [s0 (lcg s) s1 (lcg s0) s2 (lcg s1) s3 (lcg s2)
            v0 (bit-and (- (bit-and (i64-shift-right s0 8) 65535) 32768) 65535)
            v1 (bit-and (- (bit-and (i64-shift-right s1 8) 65535) 32768) 65535)
            v2 (bit-and (- (bit-and (i64-shift-right s2 8) 65535) 32768) 65535)
            v3 (bit-and (- (bit-and (i64-shift-right s3 8) 65535) 32768) 65535)
            w (bit-or (bit-or v0 (i64-shift-left v1 16)) (bit-or (i64-shift-left v2 32) (i64-shift-left v3 48)))
            u (poke f (+ p (* i 2)) w)]
        (recur (+ i 4) s3)))))

(defn- new-buffer [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 device :i64 n :i64] :i64
  (let [b (msg f R device "newBufferWithLength:options:" n 0 0)]
    (if (= b 0) (vector-at [0] 1) b)))
(defn- contents [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 b :i64] :i64
  (msg f R b "contents" 0 0 0))

;; one dispatch. by-groups = 1: (gx,gy,1) threadgroups of tx threads;
;; by-groups = 0: gx threads in total, tx per threadgroup.
(defn- run-once [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pso :i64 B :vector-i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        u6 (msg f R en "setComputePipelineState:" pso 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))
        u8 (if (= by-groups 1)
             (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
             (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))
        u9 (msg f R en "endEncoding" 0 0 0)
        u10 (msg f R cb "commit" 0 0 0)
        u11 (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn- report [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 best :i64 total :i64] :i64
  (let [base (scratch f)
        tb (+ base 192)
        u (cc f (sym f "mach_timebase_info") tb 0 0 0 0)
        w (peek f tb)
        numer (bit-and w 4294967295)
        denom (u64-shift-right w 32)
        text (string-concat "metal-dispatch-ns best " (string-concat (string-from-i64 (quot (* best numer) denom))
             (string-concat " total " (string-concat (string-from-i64 (quot (* total numer) denom)) "\n"))))
        p (cstr f (vector-at R 3) text)]
    (cc f (sym f "write") 2 p (string-length text) 0 0)))

;; the raw bytes at p, n of them, to stderr
(defn- dump [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (let [w (sym f "write")]
    (loop [off 0]
      (if (>= off n) 0
        (let [r (cc f w 2 (+ p off) (- n off) 0 0)]
          (if (<= r 0) (vector-at [0] 1) (recur (+ off r))))))))

(defn- pbuf-u [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 a :i64 b :i64 c :i64 d :i64 e :i64 g :i64 h :i64 i :i64 j :i64 k :i64] :i64
  (let [p (new-buffer f R dev 64)
        q (contents f R p)
        u0 (poke f q (bit-or a (i64-shift-left b 32)))
        u1 (poke f (+ q 8) (bit-or c (i64-shift-left d 32)))
        u2 (poke f (+ q 16) (bit-or e (i64-shift-left g 32)))
        u3 (poke f (+ q 24) (bit-or h (i64-shift-left i 32)))
        u4 (poke f (+ q 32) (bit-or j (i64-shift-left k 32)))]
    p))

;; two floats (given as bit patterns) in one 8-byte word
(defn- pbuf-f [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 a :i64 b :i64] :i64
  (let [p (new-buffer f R dev 16)
        u (poke f (contents f R p) (bit-or a (i64-shift-left b 32)))]
    p))

(defn- pso [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 lib :i64 name :string] :i64
  (let [base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        fn (msg f R lib "newFunctionWithName:" (nsstring f R name) 0 0)
        u1 (if (= fn 0) (vector-at [0] 1) 0)
        p (msg f R dev "newComputePipelineStateWithFunction:error:" fn errp 0)
        u2 (if (= p 0) (refuse f R (peek f errp)) 0)]
    p))

;; encode one dispatch into encoder en (no commit): by-groups 1 = (gx,gy,1) threadgroups of tx threads
(defn- enc [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 pipe :i64 B :vector-i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        u6 (msg f R en "setComputePipelineState:" pipe 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))]
    (if (= by-groups 1)
      (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
      (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))))

(defn- run-block [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pg :i64 pt :i64 pc :i64
                 G1 :vector-i64 G2 :vector-i64 G3 :vector-i64 G4 :vector-i64 G5 :vector-i64 G6 :vector-i64] :i64
  (let [cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        d1 (enc f R en pg G1 1 32 1 128)
        d2 (enc f R en pt G2 0 64 1 64)
        d3 (enc f R en pc G3 1 4 1 128)
        d4 (enc f R en pg G4 1 32 1 128)
        d5 (enc f R en pc G5 1 4 1 128)
        d6 (enc f R en pc G6 1 4 1 128)
        e (msg f R en "endEncoding" 0 0 0)
        y (msg f R cb "commit" 0 0 0)
        z (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        now (sym f "mach_absolute_time")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        queue (msg f R dev "newCommandQueue" 0 0 0)
        base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        lib (msg f R dev "newLibraryWithSource:options:error:" (nsstring f R (kernel-source)) 0 errp)
        u1 (if (= lib 0) (refuse f R (peek f errp)) 0)
        p-cvtf (pso f R dev lib "cvt_f")
        p-cvth (pso f R dev lib "cvt_h")
        p-gn (pso f R dev lib "gn_silu_h")
        p-tb (pso f R dev lib "temb_bias")
        p-conv (pso f R dev lib "conv")
        ;; element counts of the parameters, in fill order
        nx 8192 nt 64 ng1 32 nb1 32 nw1 18432 nc1 64 nwt 4096 nbt 64 ng2 64 nb2 64 nw2 36864 nc2 64 nws 2048 nbs 64
        sx (new-buffer f R dev (* nx 2)) st (new-buffer f R dev (* nt 2)) sg1 (new-buffer f R dev (* ng1 2)) sb1 (new-buffer f R dev (* nb1 2))
        sw1 (new-buffer f R dev (* nw1 2)) sc1 (new-buffer f R dev (* nc1 2)) swt (new-buffer f R dev (* nwt 2)) sbt (new-buffer f R dev (* nbt 2))
        sg2 (new-buffer f R dev (* ng2 2)) sb2 (new-buffer f R dev (* nb2 2)) sw2 (new-buffer f R dev (* nw2 2)) sc2 (new-buffer f R dev (* nc2 2))
        sws (new-buffer f R dev (* nws 2)) sbs (new-buffer f R dev (* nbs 2))
        s1 (fill-shorts f (contents f R sx) nx 12345)
        s2 (fill-shorts f (contents f R st) nt s1)
        s3 (fill-shorts f (contents f R sg1) ng1 s2)
        s4 (fill-shorts f (contents f R sb1) nb1 s3)
        s5 (fill-shorts f (contents f R sw1) nw1 s4)
        s6 (fill-shorts f (contents f R sc1) nc1 s5)
        s7 (fill-shorts f (contents f R swt) nwt s6)
        s8 (fill-shorts f (contents f R sbt) nbt s7)
        s9 (fill-shorts f (contents f R sg2) ng2 s8)
        s10 (fill-shorts f (contents f R sb2) nb2 s9)
        s11 (fill-shorts f (contents f R sw2) nw2 s10)
        s12 (fill-shorts f (contents f R sc2) nc2 s11)
        s13 (fill-shorts f (contents f R sws) nws s12)
        s14 (fill-shorts f (contents f R sbs) nbs s13)
        ;; float / half parameter buffers
        fx (new-buffer f R dev (* nx 4)) hx (new-buffer f R dev (* nx 2)) ft (new-buffer f R dev (* nt 4))
        fg1 (new-buffer f R dev (* ng1 4)) fb1 (new-buffer f R dev (* nb1 4)) hw1 (new-buffer f R dev (* nw1 2))
        fc1 (new-buffer f R dev (* nc1 4)) fwt (new-buffer f R dev (* nwt 4)) fbt (new-buffer f R dev (* nbt 4))
        fg2 (new-buffer f R dev (* ng2 4)) fb2 (new-buffer f R dev (* nb2 4)) hw2 (new-buffer f R dev (* nw2 2))
        fc2 (new-buffer f R dev (* nc2 4)) hws (new-buffer f R dev (* nws 2)) fbs (new-buffer f R dev (* nbs 4))
        ;; scale / add as float bit patterns: 2^-13 956301312, 2^-12 964689920, 2^-14 947912704, 2^-16 931135488, 2^-17 922746880, 1.0 1065353216
        pf13 (pbuf-f f R dev 956301312 0) pf12 (pbuf-f f R dev 964689920 0) pf14 (pbuf-f f R dev 947912704 0)
        pf16g (pbuf-f f R dev 931135488 1065353216) pf17 (pbuf-f f R dev 922746880 0)
        c0 (run-once f R queue p-cvtf (vector-i64 sx fx pf13) 0 nx 1 64)
        c1 (run-once f R queue p-cvth (vector-i64 sx hx pf13) 0 nx 1 64)
        c2 (run-once f R queue p-cvtf (vector-i64 st ft pf12) 0 nt 1 64)
        c3 (run-once f R queue p-cvtf (vector-i64 sg1 fg1 pf16g) 0 ng1 1 32)
        c4 (run-once f R queue p-cvtf (vector-i64 sb1 fb1 pf14) 0 nb1 1 32)
        c5 (run-once f R queue p-cvth (vector-i64 sw1 hw1 pf17) 0 nw1 1 64)
        c6 (run-once f R queue p-cvtf (vector-i64 sc1 fc1 pf14) 0 nc1 1 64)
        c7 (run-once f R queue p-cvtf (vector-i64 swt fwt pf17) 0 nwt 1 64)
        c8 (run-once f R queue p-cvtf (vector-i64 sbt fbt pf14) 0 nbt 1 64)
        c9 (run-once f R queue p-cvtf (vector-i64 sg2 fg2 pf16g) 0 ng2 1 64)
        c10 (run-once f R queue p-cvtf (vector-i64 sb2 fb2 pf14) 0 nb2 1 64)
        c11 (run-once f R queue p-cvth (vector-i64 sw2 hw2 pf17) 0 nw2 1 64)
        c12 (run-once f R queue p-cvtf (vector-i64 sc2 fc2 pf14) 0 nc2 1 64)
        c13 (run-once f R queue p-cvth (vector-i64 sws hws pf17) 0 nws 1 64)
        c14 (run-once f R queue p-cvtf (vector-i64 sbs fbs pf14) 0 nbs 1 64)
        ;; activations and per-dispatch parameter blocks
        a-h (new-buffer f R dev (* 8192 2))
        bias1 (new-buffer f R dev (* 64 4))
        h1-f (new-buffer f R dev (* 16384 4))
        b-h (new-buffer f R dev (* 16384 2))
        sk-f (new-buffer f R dev (* 16384 4))
        out-f (new-buffer f R dev (* 16384 4))
        pgn1 (pbuf-u f R dev 32 256 32 0 0 0 0 0 0 0)
        ptb (pbuf-u f R dev 64 64 0 0 0 0 0 0 0 0)
        pcv1 (pbuf-u f R dev 32 64 16 16 3 1 16 256 256 1)
        pgn2 (pbuf-u f R dev 64 256 32 0 0 0 0 0 0 0)
        pcvs (pbuf-u f R dev 32 64 16 16 1 1 16 256 256 1)
        pcv2 (pbuf-u f R dev 64 64 16 16 3 1 16 256 256 2)
        G1 (vector-i64 fx fg1 fb1 a-h pgn1)
        G2 (vector-i64 ft fwt fbt fc1 bias1 ptb)
        G3 (vector-i64 a-h hw1 bias1 bias1 h1-f pcv1)
        G4 (vector-i64 h1-f fg2 fb2 b-h pgn2)
        G5 (vector-i64 hx hws fbs bias1 sk-f pcvs)
        G6 (vector-i64 b-h hw2 fc2 sk-f out-f pcv2)
        w1 (run-block f R queue p-gn p-tb p-conv G1 G2 G3 G4 G5 G6)
        w2 (dump f (contents f R out-f) (* 16384 4))]
    (loop [i 0 best 9223372036854775807 total 0]
      (if (= i @REPS@)
        (let [u (report f R best total)] 0)
        (let [t0 (cc f now 0 0 0 0 0)
              u (run-block f R queue p-gn p-tb p-conv G1 G2 G3 G4 G5 G6)
              t1 (cc f now 0 0 0 0 0)
              d (- t1 t0)]
          (recur (+ i 1) (if (< d best) d best) (+ total d)))))))
