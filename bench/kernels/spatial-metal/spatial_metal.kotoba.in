        t3-h (new-buffer f R dev 16384)
        pr-f (new-buffer f R dev 32768)
        out-f (new-buffer f R dev 32768)
        Pgn (pbuf-u f R dev 128 64 32 0 0 0 0 0 0 0) Pln (pbuf-u f R dev 128 0 0 0 0 0 0 0 0 0) Lproj (pbuf-u f R dev 64 128 128 0 0 0 0 0 0 0) Lqkv (pbuf-u f R dev 64 128 128 1 0 0 0 0 0 0) Lck (pbuf-u f R dev 64 24 128 1 0 0 0 0 0 0)
        Lo (pbuf-u f R dev 64 128 128 0 1 0 0 0 0 0) Lf1 (pbuf-u f R dev 64 128 1024 0 0 0 0 0 0 0) Lf2 (pbuf-u f R dev 64 512 128 0 1 0 0 0 0 0) Lout (pbuf-u f R dev 64 128 128 0 0 0 0 0 0 0)
        Pas (pbuf-u f R dev 64 2 0 0 0 0 0 0 0 0) Pac (pbuf-u f R dev 16 2 0 0 0 0 0 0 0 0) Pgg (pbuf-u f R dev 512 0 0 0 0 0 0 0 0 0) Pun (pbuf-u f R dev 128 64 0 0 0 0 0 0 0 0)
        PS (vector-i64 p-gn p-ln p-lin p-attn p-gg p-cvtfh p-un)
        ALL (vector-alloc 123)
        ALLc0 (copy-into ALL 0 (vector-i64 f-x f-gng f-gnb gt-h Pgn gt-h h-wi f-bi dmyf t0-f dmyh Lproj t0-f f-l1g f-l1b ln-hb Pln ln-hb h-wq1 zero dmyf dmyf q-h Lqkv ln-hb h-wk1 zero dmyf dmyf k-h Lqkv ln-hb h-wv1 zero dmyf dmyf v-h Lqkv q-h k-h))
        ALLc1 (copy-into ALL 40 (vector-i64 v-h at-h Pas at-h h-wo1 f-bo1 t0-f t1-f dmyh Lo t1-f f-l2g f-l2b ln-hb Pln ln-hb h-wq2 zero dmyf dmyf q-h Lqkv h-ctx h-wk2 zero dmyf dmyf k-h Lck h-ctx h-wv2 zero dmyf dmyf v-h Lck q-h k-h v-h at-h))
        ALLc2 (copy-into ALL 80 (vector-i64 Pac at-h h-wo2 f-bo2 t1-f t2-f dmyh Lo t2-f f-l3g f-l3b ln-hb Pln ln-hb h-wf1 f-bf1 dmyf ff-f dmyh Lf1 ff-f gg-h Pgg gg-h h-wf2 f-bf2 t2-f t3-f dmyh Lf2 t3-f t3-h t3-h h-wout f-bout dmyf pr-f dmyh Lout f-x))
        ALLc3 (copy-into ALL 120 (vector-i64 pr-f out-f Pun))
        T (vector-alloc 147)
        Tc0 (copy-into T 0 (vector-i64 0 0 5 1 32 1 128 2 5 7 1 2 1 128 1 12 5 1 64 1 128 2 17 7 1 2 1 128 2 24 7 1 2 1 128 2 31 7 1 2))
        Tc1 (copy-into T 40 (vector-i64 1 128 3 38 5 1 2 2 128 2 43 7 1 2 1 128 1 50 5 1 64 1 128 2 55 7 1 2 1 128 2 62 7 1 2 1 128 2 69 7))
        Tc2 (copy-into T 80 (vector-i64 1 2 1 128 3 76 5 1 2 2 128 2 81 7 1 2 1 128 1 88 5 1 64 1 128 2 93 7 1 16 1 128 4 100 3 0 32768 1 64 2))
        Tc3 (copy-into T 120 (vector-i64 103 7 1 2 1 128 5 110 2 0 8192 1 64 2 112 7 1 2 1 128 6 119 4 0 8192 1 64))
        w1 (run-seq f R queue PS ALL T 21)
        w2 (dump f (contents f R out-f) (* 8192 4))]
    (loop [i 0 best 9223372036854775807 total 0]
      (if (= i @REPS@)
        (let [u (report f R best total)] 0)
        (let [t0 (cc f now 0 0 0 0 0)
              u (run-seq f R queue PS ALL T 21)
              t1 (cc f now 0 0 0 0 0)
              d (- t1 t0)]
          (recur (+ i 1) (if (< d best) d best) (+ total d)))))))
