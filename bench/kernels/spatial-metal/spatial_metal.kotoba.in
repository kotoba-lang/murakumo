        sd7 (fill-shorts f (contents f R s-l1g) 128 sd6)
        sd8 (fill-shorts f (contents f R s-l1b) 128 sd7)
        sd9 (fill-shorts f (contents f R s-wq1) 16384 sd8)
        sd10 (fill-shorts f (contents f R s-wk1) 16384 sd9)
        sd11 (fill-shorts f (contents f R s-wv1) 16384 sd10)
        sd12 (fill-shorts f (contents f R s-wo1) 16384 sd11)
        sd13 (fill-shorts f (contents f R s-bo1) 128 sd12)
        sd14 (fill-shorts f (contents f R s-l2g) 128 sd13)
        sd15 (fill-shorts f (contents f R s-l2b) 128 sd14)
        sd16 (fill-shorts f (contents f R s-wq2) 16384 sd15)
        sd17 (fill-shorts f (contents f R s-wk2) 3072 sd16)
        sd18 (fill-shorts f (contents f R s-wv2) 3072 sd17)
        sd19 (fill-shorts f (contents f R s-wo2) 16384 sd18)
        sd20 (fill-shorts f (contents f R s-bo2) 128 sd19)
        sd21 (fill-shorts f (contents f R s-l3g) 128 sd20)
        sd22 (fill-shorts f (contents f R s-l3b) 128 sd21)
        sd23 (fill-shorts f (contents f R s-wf1) 131072 sd22)
        sd24 (fill-shorts f (contents f R s-bf1) 1024 sd23)
        sd25 (fill-shorts f (contents f R s-wf2) 65536 sd24)
        sd26 (fill-shorts f (contents f R s-bf2) 128 sd25)
        sd27 (fill-shorts f (contents f R s-wout) 16384 sd26)
        sd28 (fill-shorts f (contents f R s-bout) 128 sd27)
        pf13 (pbuf-f f R dev 956301312 0)
        pf12 (pbuf-f f R dev 964689920 0)
        pf14 (pbuf-f f R dev 947912704 0)
        pf16g (pbuf-f f R dev 931135488 1065353216)
        pf17 (pbuf-f f R dev 922746880 0)
        cv-x (run-once f R queue p-cvtf (vector-i64 s-x f-x pf13) 0 8192 1 64)
        cv-ctx (run-once f R queue p-cvth (vector-i64 s-ctx h-ctx pf12) 0 384 1 64)
        cv-gng (run-once f R queue p-cvtf (vector-i64 s-gng f-gng pf16g) 0 128 1 64)
        cv-gnb (run-once f R queue p-cvtf (vector-i64 s-gnb f-gnb pf14) 0 128 1 64)
        cv-wi (run-once f R queue p-cvth (vector-i64 s-wi h-wi pf17) 0 16384 1 64)
        cv-bi (run-once f R queue p-cvtf (vector-i64 s-bi f-bi pf14) 0 128 1 64)
        cv-l1g (run-once f R queue p-cvtf (vector-i64 s-l1g f-l1g pf16g) 0 128 1 64)
        cv-l1b (run-once f R queue p-cvtf (vector-i64 s-l1b f-l1b pf14) 0 128 1 64)
        cv-wq1 (run-once f R queue p-cvth (vector-i64 s-wq1 h-wq1 pf17) 0 16384 1 64)
        cv-wk1 (run-once f R queue p-cvth (vector-i64 s-wk1 h-wk1 pf17) 0 16384 1 64)
        cv-wv1 (run-once f R queue p-cvth (vector-i64 s-wv1 h-wv1 pf17) 0 16384 1 64)
        cv-wo1 (run-once f R queue p-cvth (vector-i64 s-wo1 h-wo1 pf17) 0 16384 1 64)
        cv-bo1 (run-once f R queue p-cvtf (vector-i64 s-bo1 f-bo1 pf14) 0 128 1 64)
        cv-l2g (run-once f R queue p-cvtf (vector-i64 s-l2g f-l2g pf16g) 0 128 1 64)
        cv-l2b (run-once f R queue p-cvtf (vector-i64 s-l2b f-l2b pf14) 0 128 1 64)
        cv-wq2 (run-once f R queue p-cvth (vector-i64 s-wq2 h-wq2 pf17) 0 16384 1 64)
        cv-wk2 (run-once f R queue p-cvth (vector-i64 s-wk2 h-wk2 pf17) 0 3072 1 64)
        cv-wv2 (run-once f R queue p-cvth (vector-i64 s-wv2 h-wv2 pf17) 0 3072 1 64)
        cv-wo2 (run-once f R queue p-cvth (vector-i64 s-wo2 h-wo2 pf17) 0 16384 1 64)
        cv-bo2 (run-once f R queue p-cvtf (vector-i64 s-bo2 f-bo2 pf14) 0 128 1 64)
        cv-l3g (run-once f R queue p-cvtf (vector-i64 s-l3g f-l3g pf16g) 0 128 1 64)
        cv-l3b (run-once f R queue p-cvtf (vector-i64 s-l3b f-l3b pf14) 0 128 1 64)
        cv-wf1 (run-once f R queue p-cvth (vector-i64 s-wf1 h-wf1 pf17) 0 131072 1 64)
        cv-bf1 (run-once f R queue p-cvtf (vector-i64 s-bf1 f-bf1 pf14) 0 1024 1 64)
        cv-wf2 (run-once f R queue p-cvth (vector-i64 s-wf2 h-wf2 pf17) 0 65536 1 64)
        cv-bf2 (run-once f R queue p-cvtf (vector-i64 s-bf2 f-bf2 pf14) 0 128 1 64)
        cv-wout (run-once f R queue p-cvth (vector-i64 s-wout h-wout pf17) 0 16384 1 64)
        cv-bout (run-once f R queue p-cvtf (vector-i64 s-bout f-bout pf14) 0 128 1 64)
        zero (new-buffer f R dev 512) dmyf (new-buffer f R dev 64) dmyh (new-buffer f R dev 64)
        gt-h (new-buffer f R dev 16384)
        t0-f (new-buffer f R dev 32768)
        ln-hb (new-buffer f R dev 16384)
        q-h (new-buffer f R dev 16384)
        k-h (new-buffer f R dev 16384)
