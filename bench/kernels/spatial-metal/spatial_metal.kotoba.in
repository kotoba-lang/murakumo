(ns murakumo.spatial-metal (:export [main]))

;; Stage M, slice 9 (JUN-927, ADR-261106): an SDXL-style SpatialTransformer block (GroupNorm, linear
;; proj_in, LayerNorm + self-attention, LayerNorm + cross-attention over a context, LayerNorm + GEGLU
;; feed-forward, linear proj_out, residuals) run end to end on the Apple GPU from one Kotoba program
;; built by Amu selfhost (amu ADR 0405, profile amu-program-metal): 21 kernels in ONE command buffer
;; and one encoder. 128 channels on 8 x 8 (64 tokens), 2 heads of 64, 32 GroupNorm groups, 16 context
;; tokens of width 24 (padded to 64 rows of zeros), feed-forward inner width 512. Parameters are the
;; 16-bit integers of bench/kernels/spatial (same LCG stream, same order, same scales), made on the
;; GPU into float or, for the matrix operands, half. The residual stream stays float32; the matrix units
;; read half. The raw float32 output (128 * 64 * 4 bytes) goes to stderr first, then the timing.

(defn- mask48 [] :i64 281474976710655)

(defn- kernel-source [] :string
  "#include <metal_stdlib>
#include <metal_simdgroup_matrix>
using namespace metal;
kernel void cvt_f(device const short *S [[buffer(0)]], device float *F [[buffer(1)]], device const float *P [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
  F[i] = float(S[i]) * P[0] + P[1];
}
kernel void cvt_h(device const short *S [[buffer(0)]], device half *H [[buffer(1)]], device const float *P [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
  H[i] = half(float(S[i]) * P[0]);
}
kernel void cvt_fh(device const float *F [[buffer(0)]], device half *H [[buffer(1)]], uint i [[thread_position_in_grid]]) {
  H[i] = half(F[i]);
}
// GroupNorm (affine, no activation): float [C,HW] in, half token-major [HW,C] out. P = {C, HW, NG}
kernel void gn_tok_h(device const float *X [[buffer(0)]], device const float *Ga [[buffer(1)]], device const float *Be [[buffer(2)]],
                     device half *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                     uint g [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
                     uint lane [[thread_index_in_simdgroup]], uint sgi [[simdgroup_index_in_threadgroup]]) {
  threadgroup float part[4];
  threadgroup float stat[2];
  uint C = P[0]; uint HW = P[1]; uint NG = P[2];
  uint n = (C / NG) * HW;
  uint base = g * n;
  float s = 0.0f;
  for (uint i = tid; i < n; i += 128u) s += X[base + i];
  s = simd_sum(s);
  if (lane == 0u) part[sgi] = s;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[0] = (part[0] + part[1] + part[2] + part[3]) / float(n);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float mean = stat[0];
  float q = 0.0f;
  for (uint i = tid; i < n; i += 128u) { float d = X[base + i] - mean; q += d * d; }
  q = simd_sum(q);
  if (lane == 0u) part[sgi] = q;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[1] = 1.0f / precise::sqrt((part[0] + part[1] + part[2] + part[3]) / float(n) + 0.00001f);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float inv = stat[1];
  for (uint i = tid; i < n; i += 128u) {
    uint ch = g * (C / NG) + i / HW;
    uint pos = i % HW;
    float v = ((X[base + i] - mean) * inv) * Ga[ch] + Be[ch];
    O[pos * C + ch] = half(v);
  }
}
// LayerNorm over the last axis: float [M,N] in, half out. P = {N}; one threadgroup per row
kernel void ln_h(device const float *X [[buffer(0)]], device const float *Ga [[buffer(1)]], device const float *Be [[buffer(2)]],
                 device half *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                 uint r [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
                 uint lane [[thread_index_in_simdgroup]], uint sgi [[simdgroup_index_in_threadgroup]]) {
  threadgroup float part[4];
  threadgroup float stat[2];
  uint NN = P[0];
  uint base = r * NN;
  float s = 0.0f;
  for (uint i = tid; i < NN; i += 128u) s += X[base + i];
  s = simd_sum(s);
  if (lane == 0u) part[sgi] = s;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[0] = (part[0] + part[1] + part[2] + part[3]) / float(NN);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float mean = stat[0];
  float q = 0.0f;
  for (uint i = tid; i < NN; i += 128u) { float d = X[base + i] - mean; q += d * d; }
  q = simd_sum(q);
  if (lane == 0u) part[sgi] = q;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[1] = 1.0f / precise::sqrt((part[0] + part[1] + part[2] + part[3]) / float(NN) + 0.00001f);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float inv = stat[1];
  for (uint i = tid; i < NN; i += 128u)
    O[base + i] = half(((X[base + i] - mean) * inv) * Ga[i] + Be[i]);
}
// linear: C[M,N] = A[M,K] . B[K,N] + Bias[n] (+ Res[m,N]); half A, B; float or half out. P = {M, K, N, OUTH, RES}
// M and N multiples of 64, K a multiple of 8.
kernel void linear(device const half *A [[buffer(0)]], device const half *B [[buffer(1)]], device const float *Bias [[buffer(2)]],
                   device const float *Res [[buffer(3)]], device float *OF [[buffer(4)]], device half *OH [[buffer(5)]],
                   device const uint *P [[buffer(6)]],
                   uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                   uint tid [[thread_index_in_threadgroup]]) {
  threadgroup float Cs[64 * 64];
  uint K = P[1]; uint N = P[2]; uint OUTH = P[3]; uint RES = P[4];
  uint m0 = tg.y * 64u;
  uint n0 = tg.x * 64u;
  uint row0 = (sg / 2u) * 32u;
  uint col0 = (sg % 2u) * 32u;
  simdgroup_float8x8 acc[4][4];
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      acc[i][j] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  for (uint k = 0u; k < K; k += 8u) {
    simdgroup_half8x8 a[4];
    simdgroup_half8x8 b[4];
    for (uint i = 0u; i < 4u; i++)
      simdgroup_load(a[i], A + (m0 + row0 + i * 8u) * K + k, K);
    for (uint j = 0u; j < 4u; j++)
      simdgroup_load(b[j], B + k * N + n0 + col0 + j * 8u, N);
    for (uint i = 0u; i < 4u; i++)
      for (uint j = 0u; j < 4u; j++)
        simdgroup_multiply_accumulate(acc[i][j], a[i], b[j], acc[i][j]);
  }
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      simdgroup_store(acc[i][j], Cs + (row0 + i * 8u) * 64u + col0 + j * 8u, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint idx = tid; idx < 4096u; idx += 128u) {
    uint m = m0 + idx / 64u;
    uint n = n0 + idx % 64u;
    float v = Cs[idx] + Bias[n];
    if (RES == 1u) v += Res[m * N + n];
    if (OUTH == 1u) OH[m * N + n] = half(v); else OF[m * N + n] = v;
  }
}
// fused non-causal attention, head dim 64, half Q/K/V/O token-major. P = {LK, NH}; grid (LQ/32, NH)
kernel void attn_h(device const half *Q [[buffer(0)]], device const half *K [[buffer(1)]], device const half *V [[buffer(2)]],
                   device half *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                   uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                   uint tid [[thread_index_in_threadgroup]]) {
  threadgroup float Ssm[32 * 32];
  threadgroup half Psm[32 * 32];
  threadgroup float Msm[32];
  threadgroup float Lsm[32];
  uint LK = P[0];
  uint HD = P[1] * 64u;
  uint NB = (LK + 31u) / 32u;
  const float SCALE = 0.125f;
  uint q0 = tg.x * 32u;
  uint h = tg.y;
  uint hoff = h * 64u;
  simdgroup_half8x8 qa[8];
  for (uint d = 0u; d < 8u; d++)
    simdgroup_load(qa[d], Q + (q0 + sg * 8u) * HD + hoff + d * 8u, HD);
  float m = -INFINITY;
  float l = 0.0f;
  for (uint kb = 0u; kb < NB; kb++) {
    for (uint j = 0u; j < 4u; j++) {
      simdgroup_float8x8 s = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
      for (uint d = 0u; d < 8u; d++) {
        simdgroup_half8x8 kt;
        simdgroup_load(kt, K + (kb * 32u + j * 8u) * HD + hoff + d * 8u, HD, ulong2(0, 0), true);
        simdgroup_multiply_accumulate(s, qa[d], kt, s);
      }
      simdgroup_store(s, Ssm + sg * 8u * 32u + j * 8u, 32);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 32u) {
      float bm = -INFINITY;
      for (uint c = 0u; c < 32u; c++)
        if (kb * 32u + c < LK) bm = max(bm, Ssm[tid * 32u + c] * SCALE);
      float mn = max(m, bm);
      float alpha = (m == -INFINITY) ? 0.0f : exp(m - mn);
      float sum = 0.0f;
      for (uint c = 0u; c < 32u; c++)
        if (kb * 32u + c < LK) sum += exp(Ssm[tid * 32u + c] * SCALE - mn);
      l = l * alpha + sum;
      m = mn;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  if (tid < 32u) { Msm[tid] = m; Lsm[tid] = l; }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  simdgroup_float8x8 oacc[8];
  for (uint dt = 0u; dt < 8u; dt++)
    oacc[dt] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  for (uint kb = 0u; kb < NB; kb++) {
    for (uint j = 0u; j < 4u; j++) {
      simdgroup_float8x8 s = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
      for (uint d = 0u; d < 8u; d++) {
        simdgroup_half8x8 kt;
        simdgroup_load(kt, K + (kb * 32u + j * 8u) * HD + hoff + d * 8u, HD, ulong2(0, 0), true);
        simdgroup_multiply_accumulate(s, qa[d], kt, s);
      }
      simdgroup_store(s, Ssm + sg * 8u * 32u + j * 8u, 32);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint idx = tid; idx < 1024u; idx += 128u) {
      uint r = idx / 32u;
      uint c = idx % 32u;
      float p = (kb * 32u + c < LK) ? exp(Ssm[idx] * SCALE - Msm[r]) / Lsm[r] : 0.0f;
      Psm[idx] = half(p);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint ks = 0u; ks < 4u; ks++) {
      simdgroup_half8x8 pa;
      simdgroup_load(pa, Psm + sg * 8u * 32u + ks * 8u, 32);
      for (uint dt = 0u; dt < 8u; dt++) {
        simdgroup_half8x8 vt;
        simdgroup_load(vt, V + (kb * 32u + ks * 8u) * HD + hoff + dt * 8u, HD);
        simdgroup_multiply_accumulate(oacc[dt], pa, vt, oacc[dt]);
      }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  threadgroup float Os[32 * 64];
  for (uint dt = 0u; dt < 8u; dt++)
    simdgroup_store(oacc[dt], Os + sg * 8u * 64u + dt * 8u, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint idx = tid; idx < 2048u; idx += 128u) {
    uint r = idx / 64u;
    uint c = idx % 64u;
    O[(q0 + r) * HD + hoff + c] = half(Os[idx]);
  }
}
// GEGLU: float [M,2N] in, half [M,N] out. P = {N}
float erf_as(float x) {
  float ax = fabs(x);
  float t = 1.0f / (1.0f + 0.3275911f * ax);
  float p = 1.061405429f;
  p = p * t + (-1.453152027f);
  p = p * t + 1.421413741f;
  p = p * t + (-0.284496736f);
  p = p * t + 0.254829592f;
  p = p * t;
  float r = 1.0f - p * precise::exp(-(ax * ax));
  return x < 0.0f ? -r : r;
}
kernel void geglu_h(device const float *X [[buffer(0)]], device half *O [[buffer(1)]], device const uint *P [[buffer(2)]],
                    uint i [[thread_position_in_grid]]) {
  uint NN = P[0];
  uint r = i / NN;
  uint c = i % NN;
  float a = X[r * 2u * NN + c];
  float g = X[r * 2u * NN + NN + c];
  O[i] = half(a * ((0.5f * g) * (1.0f + erf_as(g * 0.70710678f))));
}
// out[c, pos] = x[c, pos] + p[pos, c]. P = {C, HW}
kernel void untok_add(device const float *X [[buffer(0)]], device const float *Pp [[buffer(1)]], device float *O [[buffer(2)]],
                      device const uint *P [[buffer(3)]], uint i [[thread_position_in_grid]]) {
  uint C = P[0]; uint HW = P[1];
  uint c = i / HW;
  uint pos = i % HW;
  O[i] = X[i] + Pp[pos * C + c];
}
")

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        strlen (sym f "strlen")
        n (cc f strlen t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

(defn- lcg [s :i64] :i64
  (bit-and (+ (* s 1103515245) 12345) 2147483647))

;; n signed 16-bit values (LCG draw & 65535, minus 32768), four per word, as shorts.
(defn- fill-shorts [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 s seed]
    (if (>= i n) s
      (let [s0 (lcg s) s1 (lcg s0) s2 (lcg s1) s3 (lcg s2)
            v0 (bit-and (- (bit-and (i64-shift-right s0 8) 65535) 32768) 65535)
            v1 (bit-and (- (bit-and (i64-shift-right s1 8) 65535) 32768) 65535)
            v2 (bit-and (- (bit-and (i64-shift-right s2 8) 65535) 32768) 65535)
            v3 (bit-and (- (bit-and (i64-shift-right s3 8) 65535) 32768) 65535)
            w (bit-or (bit-or v0 (i64-shift-left v1 16)) (bit-or (i64-shift-left v2 32) (i64-shift-left v3 48)))
            u (poke f (+ p (* i 2)) w)]
        (recur (+ i 4) s3)))))

(defn- new-buffer [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 device :i64 n :i64] :i64
  (let [b (msg f R device "newBufferWithLength:options:" n 0 0)]
    (if (= b 0) (vector-at [0] 1) b)))
(defn- contents [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 b :i64] :i64
  (msg f R b "contents" 0 0 0))

;; one dispatch. by-groups = 1: (gx,gy,1) threadgroups of tx threads;
;; by-groups = 0: gx threads in total, tx per threadgroup.
(defn- run-once [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pso :i64 B :vector-i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        u6 (msg f R en "setComputePipelineState:" pso 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))
        u8 (if (= by-groups 1)
             (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
             (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))
        u9 (msg f R en "endEncoding" 0 0 0)
        u10 (msg f R cb "commit" 0 0 0)
        u11 (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn- pbuf-u [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 a :i64 b :i64 c :i64 d :i64 e :i64 g :i64 h :i64 i :i64 j :i64 k :i64] :i64
  (let [p (new-buffer f R dev 64)
        q (contents f R p)
        u0 (poke f q (bit-or a (i64-shift-left b 32)))
        u1 (poke f (+ q 8) (bit-or c (i64-shift-left d 32)))
        u2 (poke f (+ q 16) (bit-or e (i64-shift-left g 32)))
        u3 (poke f (+ q 24) (bit-or h (i64-shift-left i 32)))
        u4 (poke f (+ q 32) (bit-or j (i64-shift-left k 32)))]
    p))

;; two floats (given as bit patterns) in one 8-byte word
(defn- pbuf-f [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 a :i64 b :i64] :i64
  (let [p (new-buffer f R dev 16)
        u (poke f (contents f R p) (bit-or a (i64-shift-left b 32)))]
    p))

(defn- pso [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 lib :i64 name :string] :i64
  (let [base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        fn (msg f R lib "newFunctionWithName:" (nsstring f R name) 0 0)
        u1 (if (= fn 0) (vector-at [0] 1) 0)
        p (msg f R dev "newComputePipelineStateWithFunction:error:" fn errp 0)
        u2 (if (= p 0) (refuse f R (peek f errp)) 0)]
    p))

;; encode one dispatch into encoder en (no commit): by-groups 1 = (gx,gy,1) threadgroups of tx threads
(defn- report [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 best :i64 total :i64] :i64
  (let [base (scratch f)
        tb (+ base 192)
        u (cc f (sym f "mach_timebase_info") tb 0 0 0 0)
        w (peek f tb)
        numer (bit-and w 4294967295)
        denom (u64-shift-right w 32)
        text (string-concat "metal-dispatch-ns best " (string-concat (string-from-i64 (quot (* best numer) denom))
             (string-concat " total " (string-concat (string-from-i64 (quot (* total numer) denom)) "\n"))))
        p (cstr f (vector-at R 3) text)]
    (cc f (sym f "write") 2 p (string-length text) 0 0)))

;; the raw bytes at p, n of them, to stderr
(defn- dump [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (let [w (sym f "write")]
    (loop [off 0]
      (if (>= off n) 0
        (let [r (cc f w 2 (+ p off) (- n off) 0 0)]
          (if (<= r 0) (vector-at [0] 1) (recur (+ off r))))))))


;; encode one dispatch whose buffers are ALL[off .. off+cnt)
(defn- enc2 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 pipe :i64 ALL :vector-i64 off :i64 cnt :i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        u6 (msg f R en "setComputePipelineState:" pipe 0 0)
        u7 (loop [i 0]
             (if (= i cnt) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at ALL (+ off i)) 0 i)] (recur (+ i 1)))))]
    (if (= by-groups 1)
      (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
      (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))))

;; dst[off + i] <- src[i]
(defn- copy-into [dst :vector-i64 off :i64 src :vector-i64] :i64
  (loop [i 0]
    (if (= i (vector-count src)) 0
      (let [u (vector-assoc! dst (+ off i) (vector-at src i))] (recur (+ i 1))))))

;; every dispatch of T (7 words each: pso index, offset, count, by-groups, gx, gy, tx) into one command buffer
(defn- run-seq [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 PS :vector-i64 ALL :vector-i64 T :vector-i64 n :i64] :i64
  (let [cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        w (loop [i 0]
            (if (= i n) 0
              (let [b (* i 7)
                    u (enc2 f R en (vector-at PS (vector-at T b)) ALL (vector-at T (+ b 1)) (vector-at T (+ b 2))
                            (vector-at T (+ b 3)) (vector-at T (+ b 4)) (vector-at T (+ b 5)) (vector-at T (+ b 6)))]
                (recur (+ i 1)))))
        e (msg f R en "endEncoding" 0 0 0)
        y (msg f R cb "commit" 0 0 0)
        z (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        now (sym f "mach_absolute_time")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        queue (msg f R dev "newCommandQueue" 0 0 0)
        base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        lib (msg f R dev "newLibraryWithSource:options:error:" (nsstring f R (kernel-source)) 0 errp)
        u1 (if (= lib 0) (refuse f R (peek f errp)) 0)
        p-cvtf (pso f R dev lib "cvt_f") p-cvth (pso f R dev lib "cvt_h") p-cvtfh (pso f R dev lib "cvt_fh")
        p-gn (pso f R dev lib "gn_tok_h") p-ln (pso f R dev lib "ln_h") p-lin (pso f R dev lib "linear")
        p-attn (pso f R dev lib "attn_h") p-gg (pso f R dev lib "geglu_h") p-un (pso f R dev lib "untok_add")
        s-x (new-buffer f R dev 16384)
        s-ctx (new-buffer f R dev 768)
        s-gng (new-buffer f R dev 256)
        s-gnb (new-buffer f R dev 256)
        s-wi (new-buffer f R dev 32768)
        s-bi (new-buffer f R dev 256)
        s-l1g (new-buffer f R dev 256)
        s-l1b (new-buffer f R dev 256)
        s-wq1 (new-buffer f R dev 32768)
        s-wk1 (new-buffer f R dev 32768)
        s-wv1 (new-buffer f R dev 32768)
        s-wo1 (new-buffer f R dev 32768)
        s-bo1 (new-buffer f R dev 256)
        s-l2g (new-buffer f R dev 256)
        s-l2b (new-buffer f R dev 256)
        s-wq2 (new-buffer f R dev 32768)
        s-wk2 (new-buffer f R dev 6144)
        s-wv2 (new-buffer f R dev 6144)
        s-wo2 (new-buffer f R dev 32768)
        s-bo2 (new-buffer f R dev 256)
        s-l3g (new-buffer f R dev 256)
        s-l3b (new-buffer f R dev 256)
        s-wf1 (new-buffer f R dev 262144)
        s-bf1 (new-buffer f R dev 2048)
        s-wf2 (new-buffer f R dev 131072)
        s-bf2 (new-buffer f R dev 256)
        s-wout (new-buffer f R dev 32768)
        s-bout (new-buffer f R dev 256)
        f-x (new-buffer f R dev 32768)
        h-ctx (new-buffer f R dev 3072)
        f-gng (new-buffer f R dev 512)
        f-gnb (new-buffer f R dev 512)
        h-wi (new-buffer f R dev 32768)
        f-bi (new-buffer f R dev 512)
        f-l1g (new-buffer f R dev 512)
        f-l1b (new-buffer f R dev 512)
        h-wq1 (new-buffer f R dev 32768)
        h-wk1 (new-buffer f R dev 32768)
        h-wv1 (new-buffer f R dev 32768)
        h-wo1 (new-buffer f R dev 32768)
        f-bo1 (new-buffer f R dev 512)
        f-l2g (new-buffer f R dev 512)
        f-l2b (new-buffer f R dev 512)
        h-wq2 (new-buffer f R dev 32768)
        h-wk2 (new-buffer f R dev 6144)
        h-wv2 (new-buffer f R dev 6144)
        h-wo2 (new-buffer f R dev 32768)
        f-bo2 (new-buffer f R dev 512)
        f-l3g (new-buffer f R dev 512)
        f-l3b (new-buffer f R dev 512)
        h-wf1 (new-buffer f R dev 262144)
        f-bf1 (new-buffer f R dev 4096)
        h-wf2 (new-buffer f R dev 131072)
        f-bf2 (new-buffer f R dev 512)
        h-wout (new-buffer f R dev 32768)
        f-bout (new-buffer f R dev 512)
        sd1 (fill-shorts f (contents f R s-x) 8192 12345)
        sd2 (fill-shorts f (contents f R s-ctx) 384 sd1)
        sd3 (fill-shorts f (contents f R s-gng) 128 sd2)
        sd4 (fill-shorts f (contents f R s-gnb) 128 sd3)
        sd5 (fill-shorts f (contents f R s-wi) 16384 sd4)
