(ns murakumo.clip-tower-metal (:export [main]))

;; I3b, second slice (JUN-927, ADR-261106): a CLIP text tower (the structure of Hugging Face's CLIPTextModel) run on the
;; Apple GPU from one Kotoba program on the Metal route (amu ADR 0405, profile amu-program-metal), reading its weights
;; from a safetensors file in the Hugging Face layout (Linear weights stored [out, in]). Config: 2 layers, hidden 128,
;; 2 heads of 64, intermediate 512, quick_gelu, 77 tokens padded to 128 rows, LayerNorm eps 1e-5 (the file is @MODEL@;
;; the 77 token ids are in @IDS@). The program indexes the file's header, admits each tensor (size = shape x dtype),
;; reads the data region into one Metal buffer, converts the weight matrices float32 -> half on the GPU, and encodes
;; ALL kernels (embedding gather, per layer LayerNorm / q, k, v / causal attention / out_proj + residual / LayerNorm / fc1
;; + quick_gelu / fc2 + residual, final LayerNorm) into ONE command buffer. The final hidden states (77 rows of 128
;; float32) go to stderr raw, then the timing line.

(defn- mask48 [] :i64 281474976710655)

(defn- kernel-source [] :string
  "#include <metal_stdlib>
#include <metal_simdgroup_matrix>
using namespace metal;
kernel void cvt32h(device const float *S [[buffer(0)]], device half *H [[buffer(1)]], uint i [[thread_position_in_grid]]) {
  H[i] = half(S[i]);
}
// token + position embeddings; rows >= T are zero. P = {H, T}
kernel void embed(device const uint *Ids [[buffer(0)]], device const float *Tok [[buffer(1)]], device const float *Pos [[buffer(2)]],
                  device float *O [[buffer(3)]], device const uint *P [[buffer(4)]], uint i [[thread_position_in_grid]]) {
  uint H = P[0]; uint T = P[1];
  uint r = i / H; uint c = i % H;
  O[i] = (r < T) ? Tok[Ids[r] * H + c] + Pos[r * H + c] : 0.0f;
}
// LayerNorm over the last axis: float in, half or float out. P = {N}; one threadgroup per row
float ln_row(device const float *X, device const float *Ga, device const float *Be, uint base, uint NN, uint tid, uint lane, uint sgi,
             threadgroup float *part, threadgroup float *stat, thread float &mean, thread float &inv) {
  float s = 0.0f;
  for (uint i = tid; i < NN; i += 128u) s += X[base + i];
  s = simd_sum(s);
  if (lane == 0u) part[sgi] = s;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[0] = (part[0] + part[1] + part[2] + part[3]) / float(NN);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  mean = stat[0];
  float q = 0.0f;
  for (uint i = tid; i < NN; i += 128u) { float d = X[base + i] - mean; q += d * d; }
  q = simd_sum(q);
  if (lane == 0u) part[sgi] = q;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (tid == 0u) stat[1] = 1.0f / precise::sqrt((part[0] + part[1] + part[2] + part[3]) / float(NN) + 0.00001f);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  inv = stat[1];
  return 0.0f;
}
kernel void ln_h(device const float *X [[buffer(0)]], device const float *Ga [[buffer(1)]], device const float *Be [[buffer(2)]],
                 device half *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                 uint r [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
                 uint lane [[thread_index_in_simdgroup]], uint sgi [[simdgroup_index_in_threadgroup]]) {
  threadgroup float part[4];
  threadgroup float stat[2];
  uint NN = P[0];
  float mean; float inv;
  ln_row(X, Ga, Be, r * NN, NN, tid, lane, sgi, part, stat, mean, inv);
  for (uint i = tid; i < NN; i += 128u)
    O[r * NN + i] = half(((X[r * NN + i] - mean) * inv) * Ga[i] + Be[i]);
}
kernel void ln_f(device const float *X [[buffer(0)]], device const float *Ga [[buffer(1)]], device const float *Be [[buffer(2)]],
                 device float *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                 uint r [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]],
                 uint lane [[thread_index_in_simdgroup]], uint sgi [[simdgroup_index_in_threadgroup]]) {
  threadgroup float part[4];
  threadgroup float stat[2];
  uint NN = P[0];
  float mean; float inv;
  ln_row(X, Ga, Be, r * NN, NN, tid, lane, sgi, part, stat, mean, inv);
  for (uint i = tid; i < NN; i += 128u)
    O[r * NN + i] = ((X[r * NN + i] - mean) * inv) * Ga[i] + Be[i];
}
// C[M,N] = A[M,K] . W^T + Bias[n] (+ Res) with W stored [N,K] (a Hugging Face Linear weight), then an activation.
// P = {M, K, N, OUTH, RES, ACT}; ACT 0 none, 1 quick_gelu (x * sigmoid(1.702 x)), 2 gelu (erf). M, N multiples of 64, K of 8.
float erf_as(float x) {
  float ax = fabs(x);
  float t = 1.0f / (1.0f + 0.3275911f * ax);
  float p = 1.061405429f;
  p = p * t + (-1.453152027f);
  p = p * t + 1.421413741f;
  p = p * t + (-0.284496736f);
  p = p * t + 0.254829592f;
  p = p * t;
  float r = 1.0f - p * precise::exp(-(ax * ax));
  return x < 0.0f ? -r : r;
}
kernel void linear_t(device const half *A [[buffer(0)]], device const half *W [[buffer(1)]], device const float *Bias [[buffer(2)]],
                     device const float *Res [[buffer(3)]], device float *OF [[buffer(4)]], device half *OH [[buffer(5)]],
                     device const uint *P [[buffer(6)]],
                     uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                     uint tid [[thread_index_in_threadgroup]]) {
  threadgroup float Cs[64 * 64];
  uint K = P[1]; uint N = P[2]; uint OUTH = P[3]; uint RES = P[4]; uint ACT = P[5];
  uint m0 = tg.y * 64u;
  uint n0 = tg.x * 64u;
  uint row0 = (sg / 2u) * 32u;
  uint col0 = (sg % 2u) * 32u;
  simdgroup_float8x8 acc[4][4];
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      acc[i][j] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  for (uint k = 0u; k < K; k += 8u) {
    simdgroup_half8x8 a[4];
    simdgroup_half8x8 b[4];
    for (uint i = 0u; i < 4u; i++)
      simdgroup_load(a[i], A + (m0 + row0 + i * 8u) * K + k, K);
    for (uint j = 0u; j < 4u; j++)
      simdgroup_load(b[j], W + (n0 + col0 + j * 8u) * K + k, K, ulong2(0, 0), true);
    for (uint i = 0u; i < 4u; i++)
      for (uint j = 0u; j < 4u; j++)
        simdgroup_multiply_accumulate(acc[i][j], a[i], b[j], acc[i][j]);
  }
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      simdgroup_store(acc[i][j], Cs + (row0 + i * 8u) * 64u + col0 + j * 8u, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint idx = tid; idx < 4096u; idx += 128u) {
    uint m = m0 + idx / 64u;
    uint n = n0 + idx % 64u;
    float v = Cs[idx] + Bias[n];
    if (ACT == 1u) v = v / (1.0f + precise::exp(-1.702f * v));
    if (ACT == 2u) v = (0.5f * v) * (1.0f + erf_as(v * 0.70710678f));
    if (RES == 1u) v += Res[m * N + n];
    if (OUTH == 1u) OH[m * N + n] = half(v); else OF[m * N + n] = v;
  }
}
// fused attention, head dim 64, half Q/K/V/O token-major, optional causal mask. P = {LK, NH, CAUSAL}; grid (LQ/32, NH)
kernel void attn_hc(device const half *Q [[buffer(0)]], device const half *K [[buffer(1)]], device const half *V [[buffer(2)]],
                    device half *O [[buffer(3)]], device const uint *P [[buffer(4)]],
                    uint2 tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                    uint tid [[thread_index_in_threadgroup]]) {
  threadgroup float Ssm[32 * 32];
  threadgroup half Psm[32 * 32];
  threadgroup float Msm[32];
  threadgroup float Lsm[32];
  threadgroup float Os[32 * 64];
  uint LK = P[0];
  uint HD = P[1] * 64u;
  uint CAUSAL = P[2];
  uint NB = (LK + 31u) / 32u;
  const float SCALE = 0.125f;
  uint q0 = tg.x * 32u;
  uint h = tg.y;
  uint hoff = h * 64u;
  simdgroup_half8x8 qa[8];
  for (uint d = 0u; d < 8u; d++)
    simdgroup_load(qa[d], Q + (q0 + sg * 8u) * HD + hoff + d * 8u, HD);
  float m = -INFINITY;
  float l = 0.0f;
  for (uint kb = 0u; kb < NB; kb++) {
    for (uint j = 0u; j < 4u; j++) {
      simdgroup_float8x8 s = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
      for (uint d = 0u; d < 8u; d++) {
        simdgroup_half8x8 kt;
        simdgroup_load(kt, K + (kb * 32u + j * 8u) * HD + hoff + d * 8u, HD, ulong2(0, 0), true);
        simdgroup_multiply_accumulate(s, qa[d], kt, s);
      }
      simdgroup_store(s, Ssm + sg * 8u * 32u + j * 8u, 32);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 32u) {
      uint qi = q0 + tid;
      float bm = -INFINITY;
      for (uint c = 0u; c < 32u; c++) {
        uint key = kb * 32u + c;
        if (key < LK && (CAUSAL == 0u || key <= qi)) bm = max(bm, Ssm[tid * 32u + c] * SCALE);
      }
      float mn = max(m, bm);
      float alpha = (m == -INFINITY) ? 0.0f : exp(m - mn);
      float sum = 0.0f;
      for (uint c = 0u; c < 32u; c++) {
        uint key = kb * 32u + c;
        if (key < LK && (CAUSAL == 0u || key <= qi)) sum += exp(Ssm[tid * 32u + c] * SCALE - mn);
      }
      l = l * alpha + sum;
      m = mn;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  if (tid < 32u) { Msm[tid] = m; Lsm[tid] = l; }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  simdgroup_float8x8 oacc[8];
  for (uint dt = 0u; dt < 8u; dt++)
    oacc[dt] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  for (uint kb = 0u; kb < NB; kb++) {
    for (uint j = 0u; j < 4u; j++) {
      simdgroup_float8x8 s = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
      for (uint d = 0u; d < 8u; d++) {
        simdgroup_half8x8 kt;
        simdgroup_load(kt, K + (kb * 32u + j * 8u) * HD + hoff + d * 8u, HD, ulong2(0, 0), true);
        simdgroup_multiply_accumulate(s, qa[d], kt, s);
      }
      simdgroup_store(s, Ssm + sg * 8u * 32u + j * 8u, 32);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint idx = tid; idx < 1024u; idx += 128u) {
      uint r = idx / 32u;
      uint c = idx % 32u;
      uint key = kb * 32u + c;
      uint qi = q0 + r;
      float p = (key < LK && (CAUSAL == 0u || key <= qi)) ? exp(Ssm[idx] * SCALE - Msm[r]) / Lsm[r] : 0.0f;
      Psm[idx] = half(p);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint ks = 0u; ks < 4u; ks++) {
      simdgroup_half8x8 pa;
      simdgroup_load(pa, Psm + sg * 8u * 32u + ks * 8u, 32);
      for (uint dt = 0u; dt < 8u; dt++) {
        simdgroup_half8x8 vt;
        simdgroup_load(vt, V + (kb * 32u + ks * 8u) * HD + hoff + dt * 8u, HD);
        simdgroup_multiply_accumulate(oacc[dt], pa, vt, oacc[dt]);
      }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  for (uint dt = 0u; dt < 8u; dt++)
    simdgroup_store(oacc[dt], Os + sg * 8u * 64u + dt * 8u, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint idx = tid; idx < 2048u; idx += 128u) {
    uint r = idx / 64u;
    uint c = idx % 64u;
    O[(q0 + r) * HD + hoff + c] = half(Os[idx]);
  }
}
")

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        strlen (sym f "strlen")
        n (cc f strlen t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

(defn- new-buffer [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 device :i64 n :i64] :i64
  (let [b (msg f R device "newBufferWithLength:options:" n 0 0)]
    (if (= b 0) (vector-at [0] 1) b)))
(defn- contents [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 b :i64] :i64
  (msg f R b "contents" 0 0 0))

;; one dispatch. by-groups = 1: (gx,gy,1) threadgroups of tx threads;
;; by-groups = 0: gx threads in total, tx per threadgroup.
(defn- run-once [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pso :i64 B :vector-i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        u6 (msg f R en "setComputePipelineState:" pso 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))
        u8 (if (= by-groups 1)
             (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
             (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))
        u9 (msg f R en "endEncoding" 0 0 0)
        u10 (msg f R cb "commit" 0 0 0)
        u11 (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn- report [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 best :i64 total :i64] :i64
  (let [base (scratch f)
        tb (+ base 192)
        u (cc f (sym f "mach_timebase_info") tb 0 0 0 0)
        w (peek f tb)
        numer (bit-and w 4294967295)
        denom (u64-shift-right w 32)
        text (string-concat "metal-dispatch-ns best " (string-concat (string-from-i64 (quot (* best numer) denom))
             (string-concat " total " (string-concat (string-from-i64 (quot (* total numer) denom)) "\n"))))
        p (cstr f (vector-at R 3) text)]
    (cc f (sym f "write") 2 p (string-length text) 0 0)))

;; the raw bytes at p, n of them, to stderr
(defn- dump [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (let [w (sym f "write")]
    (loop [off 0]
      (if (>= off n) 0
        (let [r (cc f w 2 (+ p off) (- n off) 0 0)]
          (if (<= r 0) (vector-at [0] 1) (recur (+ off r))))))))

(defn- pbuf-u [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 a :i64 b :i64 c :i64 d :i64 e :i64 g :i64 h :i64 i :i64 j :i64 k :i64] :i64
  (let [p (new-buffer f R dev 64)
        q (contents f R p)
        u0 (poke f q (bit-or a (i64-shift-left b 32)))
        u1 (poke f (+ q 8) (bit-or c (i64-shift-left d 32)))
        u2 (poke f (+ q 16) (bit-or e (i64-shift-left g 32)))
        u3 (poke f (+ q 24) (bit-or h (i64-shift-left i 32)))
        u4 (poke f (+ q 32) (bit-or j (i64-shift-left k 32)))]
    p))

;; two floats (given as bit patterns) in one 8-byte word
(defn- pbuf-f [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 a :i64 b :i64] :i64
  (let [p (new-buffer f R dev 16)
        u (poke f (contents f R p) (bit-or a (i64-shift-left b 32)))]
    p))

(defn- pso [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 lib :i64 name :string] :i64
  (let [base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        fn (msg f R lib "newFunctionWithName:" (nsstring f R name) 0 0)
        u1 (if (= fn 0) (vector-at [0] 1) 0)
        p (msg f R dev "newComputePipelineStateWithFunction:error:" fn errp 0)
        u2 (if (= p 0) (refuse f R (peek f errp)) 0)]
    p))

;; encode one dispatch into encoder en (no commit): by-groups 1 = (gx,gy,1) threadgroups of tx threads
(defn- byte-at [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (bit-and (peek f p) 255))

;; index of the closing quote of the string whose first content byte is at p+i
(defn- str-end [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64] :i64
  (loop [j i]
    (if (= (byte-at f (+ p j)) 34) j (recur (+ j 1)))))

;; first index >= i whose byte is c
(defn- find-byte [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 c :i64] :i64
  (loop [j i]
    (if (= (byte-at f (+ p j)) c) j (recur (+ j 1)))))

;; unsigned decimal at p+i (after optional spaces): value into out[0], index after the digits returned
(defn- parse-uint [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 out :vector-i64] :i64
  (let [s (loop [j i] (if (= (byte-at f (+ p j)) 32) (recur (+ j 1)) j))]
    (loop [j s v 0]
      (let [b (byte-at f (+ p j))]
        (if (and (>= b 48) (<= b 57))
          (recur (+ j 1) (+ (* v 10) (- b 48)))
          (let [u (vector-assoc! out 0 v)] j))))))

;; write n bytes at p to stderr
(defn- wr [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (cc f (sym f "write") 2 p n 0 0))

(defn- wr-text [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (wr f (cstr f (vector-at R 3) s) (string-length s)))

(defn- wr-num [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 v :i64] :i64
  (wr-text f R (string-from-i64 v)))

;; shape list at p+lb (its '['): dims into rec[5..], count into rec[4], returns the index after ']'
(defn- parse-shape [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 lb :i64 rec :vector-i64 tmp :vector-i64] :i64
  (loop [q (+ lb 1) n 0]
    (let [c (byte-at f (+ p q))]
      (cond
        (= c 93) (let [u (vector-assoc! rec 4 n)] (+ q 1))
        (= c 44) (recur (+ q 1) n)
        (= c 32) (recur (+ q 1) n)
        :else (let [nx (parse-uint f p q tmp)
                    u (vector-assoc! rec (+ 5 n) (vector-at tmp 0))]
                (recur nx (+ n 1)))))))

;; parse the object starting at p+i (its '{'): fills rec = [dtype-begin dtype-end begin end ndims d0..d7],
;; returns the index just after its '}'
(defn- tensor-body [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 rec :vector-i64 tmp :vector-i64] :i64
  (loop [j (+ i 1)]
    (let [b (byte-at f (+ p j))]
      (cond
        (= b 125) (+ j 1)
        (= b 34)
        (let [ke (str-end f p (+ j 1))
              klen (- ke (+ j 1))
              k0 (byte-at f (+ p (+ j 1)))
              after (+ ke 1)]
          (if (= klen 12)
            (let [lb (find-byte f p after 91)
                  n1 (parse-uint f p (+ lb 1) tmp)
                  u0 (vector-assoc! rec 2 (vector-at tmp 0))
                  cm (find-byte f p n1 44)
                  n2 (parse-uint f p (+ cm 1) tmp)
                  u1 (vector-assoc! rec 3 (vector-at tmp 0))]
              (recur (+ (find-byte f p n2 93) 1)))
            (if (= k0 100)
              (let [vs (+ (find-byte f p after 34) 1)
                    ve (str-end f p vs)
                    u0 (vector-assoc! rec 0 vs)
                    u1 (vector-assoc! rec 1 ve)]
                (recur (+ ve 1)))
              (recur (parse-shape f p (find-byte f p after 91) rec tmp)))))
        :else (recur (+ j 1))))))

;; skip a balanced {...} starting at p+i, returns the index after it (strings hold no braces here)
(defn- skip-object [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64] :i64
  (loop [j (+ i 1) depth 1]
    (let [b (byte-at f (+ p j))]
      (cond
        (= depth 0) j
        (= b 123) (recur (+ j 1) (+ depth 1))
        (= b 125) (if (= depth 1) (+ j 1) (recur (+ j 1) (- depth 1)))
        :else (recur (+ j 1) depth)))))

;; bytes per element of the dtype string at p+s .. p+e, 0 if not one this reader knows
;; bytes per element of the dtype string at p+s .. p+e, 0 if not one this reader knows
(defn- dsize [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :i64 e :i64] :i64
  (let [n (- e s)
        b0 (byte-at f (+ p s))
        b1 (byte-at f (+ p (+ s 1)))
        b2 (byte-at f (+ p (+ s 2)))]
    (cond
      (= n 2) (if (= b1 56) 1 (if (= b1 49) 0 0))
      (= n 4) (if (= b0 66) (if (= b1 70) 2 1) 0)
      (= n 3) (if (= b1 49) (if (= b2 54) 2 0) (if (= b1 51) (if (= b2 50) 4 0) (if (= b1 54) (if (= b2 52) 8 0) 0)))
      :else 0)))

(defn- dims-product [rec :vector-i64] :i64
  (loop [d 0 pr 1]
    (if (= d (vector-at rec 4)) pr (recur (+ d 1) (* pr (vector-at rec (+ 5 d)))))))


;; index the header: TT[4k..4k+3] = name begin, name length, begin, end of tensor k; chk[0] = largest end, chk[1] = bad sizes
(defn- index-header [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 TT :vector-i64 chk :vector-i64] :i64
  (let [rec (vector-alloc 16)
        tmp (vector-alloc 2)]
    (loop [j (+ (find-byte f p 0 123) 1) count 0]
      (let [b (byte-at f (+ p j))]
        (cond
          (>= j n) count
          (= b 125) count
          (= b 34)
          (let [ne (str-end f p (+ j 1))
                ns (+ j 1)
                after (find-byte f p (+ ne 1) 123)]
            (if (and (= (- ne ns) 12) (= (byte-at f (+ p ns)) 95))
              (recur (skip-object f p after) count)
              (let [nx (tensor-body f p after rec tmp)
                    a (vector-assoc! TT (* count 4) ns)
                    b2 (vector-assoc! TT (+ (* count 4) 1) (- ne ns))
                    c (vector-assoc! TT (+ (* count 4) 2) (vector-at rec 2))
                    d (vector-assoc! TT (+ (* count 4) 3) (vector-at rec 3))
                    ds (dsize f p (vector-at rec 0) (vector-at rec 1))
                    ok (if (= ds 0) 0 (if (= (* (dims-product rec) ds) (- (vector-at rec 3) (vector-at rec 2))) 1 0))
                    u10 (if (= ok 1) 0 (let [w (vector-assoc! chk 1 (+ (vector-at chk 1) 1))] 0))
                    u11 (if (> (vector-at rec 3) (vector-at chk 0)) (let [w (vector-assoc! chk 0 (vector-at rec 3))] 0) 0)]
                (recur nx (+ count 1)))))
          :else (recur (+ j 1) count))))))

(defn- bytes-eq [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 q :i64 n :i64] :i64
  (loop [i 0]
    (if (= i n) 1
      (if (= (byte-at f (+ p i)) (byte-at f (+ q i))) (recur (+ i 1)) 0))))

;; the data offset of the tensor called name (a string), or a trap
(defn- toff [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 hdr :i64 TT :vector-i64 nt :i64 name :string] :i64
  (let [q (cstr f (vector-at R 3) name)
        len (string-length name)
        hit (loop [k 0]
              (if (= k nt) -1
                (if (and (= (vector-at TT (+ (* k 4) 1)) len) (= (bytes-eq f (+ hdr (vector-at TT (* k 4))) q len) 1))
                  k (recur (+ k 1)))))]
    (if (< hit 0)
      (let [w (wr-text f R "refused: tensor missing from the file: ")
            w2 (wr-text f R name)
            w3 (wr-text f R "\n")]
        (vector-at [0] 1))
      (vector-at TT (+ (* hit 4) 2)))))

(defn- lname [i :i64 suffix :string] :string
  (string-concat "text_model.encoder.layers." (string-concat (string-from-i64 i) (string-concat "." suffix))))

;; ---- recording a dispatch list: ALL / OFS hold buffer handles and byte offsets, T 7 words per dispatch
(defn- emit [ALL :vector-i64 OFS :vector-i64 T :vector-i64 Rec :vector-i64 bufs :vector-i64 offs :vector-i64
             pso :i64 bg :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [na (vector-at Rec 0)
        nt (vector-at Rec 1)
        cnt (vector-count bufs)
        c (loop [i 0] (if (= i cnt) 0 (let [a (vector-assoc! ALL (+ na i) (vector-at bufs i))
                                            b (vector-assoc! OFS (+ na i) (vector-at offs i))] (recur (+ i 1)))))
        b7 (* nt 7)
        t0 (vector-assoc! T b7 pso) t1 (vector-assoc! T (+ b7 1) na) t2 (vector-assoc! T (+ b7 2) cnt)
        t3 (vector-assoc! T (+ b7 3) bg) t4 (vector-assoc! T (+ b7 4) gx) t5 (vector-assoc! T (+ b7 5) gy) t6 (vector-assoc! T (+ b7 6) tx)
        r0 (vector-assoc! Rec 0 (+ na cnt))
        r1 (vector-assoc! Rec 1 (+ nt 1))]
    0))

(defn- zeros [n :i64] :vector-i64
  (let [v (vector-alloc n)
        z (loop [i 0] (if (= i n) 0 (let [u (vector-assoc! v i 0)] (recur (+ i 1)))))]
    v))

(defn- enc3 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 pipe :i64 ALL :vector-i64 OFS :vector-i64 off :i64 cnt :i64
             by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        u6 (msg f R en "setComputePipelineState:" pipe 0 0)
        u7 (loop [i 0]
             (if (= i cnt) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at ALL (+ off i)) (vector-at OFS (+ off i)) i)] (recur (+ i 1)))))]
    (if (= by-groups 1)
      (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
      (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))))

(defn- run-seq3 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 PS :vector-i64 ALL :vector-i64 OFS :vector-i64 T :vector-i64 n :i64] :i64
  (let [cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        w (loop [i 0]
            (if (= i n) 0
              (let [b (* i 7)
                    u (enc3 f R en (vector-at PS (vector-at T b)) ALL OFS (vector-at T (+ b 1)) (vector-at T (+ b 2))
                            (vector-at T (+ b 3)) (vector-at T (+ b 4)) (vector-at T (+ b 5)) (vector-at T (+ b 6)))]
                (recur (+ i 1)))))
        e (msg f R en "endEncoding" 0 0 0)
        y (msg f R cb "commit" 0 0 0)
        z (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn- slurp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 path :string sz :vector-i64] :i64
  (let [fd (cc f (sym f "open") (cstr f (vector-at R 3) path) 0 0 0 0)
        u0 (if (< fd 0) (vector-at [0] 1) 0)
        total (cc f (sym f "lseek") fd 0 2 0 0)
        buf (cc f (vector-at R 3) (+ total 16) 0 0 0 0)
        got (cc f (sym f "pread") fd buf total 0 0)
        u1 (if (= got total) 0 (vector-at [0] 1))
        z (loop [i 0] (if (= i 16) 0 (let [u (poke8 f (+ buf (+ total i)) 0)] (recur (+ i 1)))))
        s (vector-assoc! sz 0 total)]
    buf))

(defn- half-buf [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 n :i64] :i64 (new-buffer f R dev (* n 2)))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        now (sym f "mach_absolute_time")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        queue (msg f R dev "newCommandQueue" 0 0 0)
        base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        lib (msg f R dev "newLibraryWithSource:options:error:" (nsstring f R (kernel-source)) 0 errp)
        u1 (if (= lib 0) (refuse f R (peek f errp)) 0)
        p-cvt (pso f R dev lib "cvt32h") p-emb (pso f R dev lib "embed") p-lnh (pso f R dev lib "ln_h")
        p-lnf (pso f R dev lib "ln_f") p-lin (pso f R dev lib "linear_t") p-att (pso f R dev lib "attn_hc")
        PS (vector-i64 p-cvt p-emb p-lnh p-lnf p-lin p-att)
        ;; the safetensors file
        fd (cc f (sym f "open") (cstr f (vector-at R 3) "@MODEL@") 0 0 0 0)
        u2 (if (< fd 0) (vector-at [0] 1) 0)
        lenb (cc f (vector-at R 3) 16 0 0 0 0)
        u3 (cc f (sym f "pread") fd lenb 8 0 0)
        hlen (peek f lenb)
        hdr (cc f (vector-at R 3) (+ hlen 16) 0 0 0 0)
        u4 (cc f (sym f "pread") fd hdr hlen 8 0)
        TT (zeros 1024)
        chk (zeros 2)
        nt (index-header f hdr hlen TT chk)
        total (cc f (sym f "lseek") fd 0 2 0 0)
        dlen (- total (+ 8 hlen))
        r1 (if (= (vector-at chk 1) 0) 0 (let [w (wr-text f R "refused: a tensor's size differs from its shape and dtype\n")] (vector-at [0] 1)))
        r2 (if (= (vector-at chk 0) dlen) 0 (let [w (wr-text f R "refused: data_offsets do not match the data region size\n")] (vector-at [0] 1)))
        dbuf (msg f R dev "newBufferWithLength:options:" dlen 0 0)
        u5 (if (= dbuf 0) (vector-at [0] 1) 0)
        got (cc f (sym f "pread") fd (msg f R dbuf "contents" 0 0 0) dlen (+ 8 hlen) 0)
        u6 (if (= got dlen) 0 (vector-at [0] 1))
        ;; the token ids
        sz (vector-alloc 1)
        ibuf (slurp f R "@IDS@" sz)
        ids (new-buffer f R dev 512)
        tmp (vector-alloc 1)
        u7 (loop [k 0 q 0]
             (if (= k 77) 0
               (let [nx (parse-uint f ibuf (+ q 0) tmp)
                     u (poke8 f (+ (contents f R ids) (* k 4)) (bit-and (vector-at tmp 0) 255))
                     u8 (poke8 f (+ (contents f R ids) (+ (* k 4) 1)) (bit-and (i64-shift-right (vector-at tmp 0) 8) 255))
                     u9 (poke8 f (+ (contents f R ids) (+ (* k 4) 2)) 0)
                     u10 (poke8 f (+ (contents f R ids) (+ (* k 4) 3)) 0)]
                 (recur (+ k 1) (+ nx 1)))))
        ;; activations
        xa (new-buffer f R dev (* 16384 4)) xb (new-buffer f R dev (* 16384 4)) outf (new-buffer f R dev (* 16384 4))
        lnh (half-buf f R dev 16384) qh (half-buf f R dev 16384) kh (half-buf f R dev 16384) vh (half-buf f R dev 16384)
        ath (half-buf f R dev 16384) f1h (half-buf f R dev 65536)
        ;; parameter blocks
        Pemb (pbuf-u f R dev 128 77 0 0 0 0 0 0 0 0) Pln (pbuf-u f R dev 128 0 0 0 0 0 0 0 0 0)
        Plq (pbuf-u f R dev 128 128 128 1 0 0 0 0 0 0) Plo (pbuf-u f R dev 128 128 128 0 1 0 0 0 0 0)
        Pl1 (pbuf-u f R dev 128 128 512 1 0 1 0 0 0 0) Pl2 (pbuf-u f R dev 128 512 128 0 1 0 0 0 0 0)
        Pat (pbuf-u f R dev 77 2 1 0 0 0 0 0 0 0)
        ALL (zeros 512) OFS (zeros 512) T (zeros 448) Rec (zeros 2)
        dummy (new-buffer f R dev 64)
        o-tok (toff f R hdr TT nt "text_model.embeddings.token_embedding.weight")
        o-pos (toff f R hdr TT nt "text_model.embeddings.position_embedding.weight")
        e0 (emit ALL OFS T Rec (vector-i64 ids dbuf dbuf xa Pemb) (vector-i64 0 o-tok o-pos 0 0) 1 0 16384 1 64)
        ;; both layers: weights to half, then the layer's dispatches
        lw (loop [l 0 z 0]
             (if (= l 2) z
               (let [wq (half-buf f R dev 16384) wk (half-buf f R dev 16384) wv (half-buf f R dev 16384) wo (half-buf f R dev 16384)
                     w1 (half-buf f R dev 65536) w2 (half-buf f R dev 65536)
                     oq (toff f R hdr TT nt (lname l "self_attn.q_proj.weight")) ok (toff f R hdr TT nt (lname l "self_attn.k_proj.weight"))
                     ov (toff f R hdr TT nt (lname l "self_attn.v_proj.weight")) oo (toff f R hdr TT nt (lname l "self_attn.out_proj.weight"))
                     o1 (toff f R hdr TT nt (lname l "mlp.fc1.weight")) o2 (toff f R hdr TT nt (lname l "mlp.fc2.weight"))
                     bq (toff f R hdr TT nt (lname l "self_attn.q_proj.bias")) bk (toff f R hdr TT nt (lname l "self_attn.k_proj.bias"))
                     bv (toff f R hdr TT nt (lname l "self_attn.v_proj.bias")) bo (toff f R hdr TT nt (lname l "self_attn.out_proj.bias"))
                     b1 (toff f R hdr TT nt (lname l "mlp.fc1.bias")) b2 (toff f R hdr TT nt (lname l "mlp.fc2.bias"))
                     g1 (toff f R hdr TT nt (lname l "layer_norm1.weight")) be1 (toff f R hdr TT nt (lname l "layer_norm1.bias"))
                     g2 (toff f R hdr TT nt (lname l "layer_norm2.weight")) be2 (toff f R hdr TT nt (lname l "layer_norm2.bias"))
                     c0 (emit ALL OFS T Rec (vector-i64 dbuf wq) (vector-i64 oq 0) 0 0 16384 1 64)
                     c1 (emit ALL OFS T Rec (vector-i64 dbuf wk) (vector-i64 ok 0) 0 0 16384 1 64)
                     c2 (emit ALL OFS T Rec (vector-i64 dbuf wv) (vector-i64 ov 0) 0 0 16384 1 64)
                     c3 (emit ALL OFS T Rec (vector-i64 dbuf wo) (vector-i64 oo 0) 0 0 16384 1 64)
                     c4 (emit ALL OFS T Rec (vector-i64 dbuf w1) (vector-i64 o1 0) 0 0 65536 1 64)
                     c5 (emit ALL OFS T Rec (vector-i64 dbuf w2) (vector-i64 o2 0) 0 0 65536 1 64)
                     d1 (emit ALL OFS T Rec (vector-i64 xa dbuf dbuf lnh Pln) (vector-i64 0 g1 be1 0 0) 2 1 128 1 128)
                     d2 (emit ALL OFS T Rec (vector-i64 lnh wq dbuf dummy dummy qh Plq) (vector-i64 0 0 bq 0 0 0 0) 4 1 2 2 128)
                     d3 (emit ALL OFS T Rec (vector-i64 lnh wk dbuf dummy dummy kh Plq) (vector-i64 0 0 bk 0 0 0 0) 4 1 2 2 128)
                     d4 (emit ALL OFS T Rec (vector-i64 lnh wv dbuf dummy dummy vh Plq) (vector-i64 0 0 bv 0 0 0 0) 4 1 2 2 128)
                     d5 (emit ALL OFS T Rec (vector-i64 qh kh vh ath Pat) (vector-i64 0 0 0 0 0) 5 1 4 2 128)
                     d6 (emit ALL OFS T Rec (vector-i64 ath wo dbuf xa xb dummy Plo) (vector-i64 0 0 bo 0 0 0 0) 4 1 2 2 128)
                     d7 (emit ALL OFS T Rec (vector-i64 xb dbuf dbuf lnh Pln) (vector-i64 0 g2 be2 0 0) 2 1 128 1 128)
                     d8 (emit ALL OFS T Rec (vector-i64 lnh w1 dbuf dummy dummy f1h Pl1) (vector-i64 0 0 b1 0 0 0 0) 4 1 8 2 128)
                     d9 (emit ALL OFS T Rec (vector-i64 f1h w2 dbuf xb xa dummy Pl2) (vector-i64 0 0 b2 0 0 0 0) 4 1 2 2 128)]
                 (recur (+ l 1) z))))
        og (toff f R hdr TT nt "text_model.final_layer_norm.weight")
        ob (toff f R hdr TT nt "text_model.final_layer_norm.bias")
        ef (emit ALL OFS T Rec (vector-i64 xa dbuf dbuf outf Pln) (vector-i64 0 og ob 0 0) 3 1 128 1 128)
        nd (vector-at Rec 1)
        w1 (run-seq3 f R queue PS ALL OFS T nd)
        w2 (dump f (contents f R outf) (* 77 128 4))]
    (loop [i 0 best 9223372036854775807 total 0]
      (if (= i @REPS@)
        (let [u (report f R best total)] 0)
        (let [t0 (cc f now 0 0 0 0 0)
              u (run-seq3 f R queue PS ALL OFS T nd)
              t1 (cc f now 0 0 0 0 0)
              d (- t1 t0)]
          (recur (+ i 1) (if (< d best) d best) (+ total d)))))))
