(ns murakumo.qwen2-metal (:export [main]))

;; E1 (AWAI-2851, engine-plan): Qwen2.5-0.5B Q8_0 greedy decode on the Apple GPU from a Kotoba program built by
;; `bin/amu compile --runtime-profile amu-program-metal` (amu ADR 0405). The program checks the GGUF file's SHA-256
;; against the pinned digest first (the S1/S2 reader's helpers), indexes the KVs and tensor infos, refuses a model whose
;; block count, widths or head counts are not Qwen2.5-0.5B's or whose tensors have another dtype, shape or span, preads
;; the data region into one Metal buffer (8 MiB chunks), then runs every prompt token and @STEPS@ greedy steps through
;; the model, six dispatches per layer (E2, AWAI-2917): RMSNorm fused into one q|k|v Q8_0 matvec with biases; NEOX RoPE
;; on q and k with the KV cache store; causal GQA attention (14 query heads over 2 kv heads, split over 4 thread groups
;; per head); the output matvec into the residual; RMSNorm fused into one gate|up matvec; the down matvec with SwiGLU
;; applied to its input, into the residual. Then the final RMSNorm fused into the tied head over the 151,936-row
;; embedding table, and argmax, which leaves the token id in the arena and in a per-position log. One command buffer per
;; token; during decode the next step's buffer (whose embedding reads the token id the previous argmax left) is
;; committed before the CPU waits for the previous one, so two are in flight and each token is still read back as soon
;; as its own buffer completes. The KV cache holds 256 positions. The kernels are MSL text in this program, written by
;; hand (engine-plan D2); E7 replaces them with kernels Amu emits.
;; The prompt (E3, AWAI-2922) goes through the model by @PREFILL@: 1 (the default) all rows in one command buffer
;; (Q8_0 GEMMs on simdgroup matrices, RMSNorm and SwiGLU passes, RoPE + KV store and flash-style causal attention for
;; every row, the head on the last row only), 0 one token per command buffer, 2 both, then the last token's logits
;; compared on the GPU (prints `prefill-check ...` with the max difference as float bits). @GENIDS@ nonzero replaces
;; the prompt by that many synthetic ids (i * 7919 + 100) mod 151000; the batch holds at most 512 rows and the KV cache
;; 1024 positions.
;; Prints `greedy t0 t1 ...` and `e1-ns ...` (diagnostic timing) on stderr.
;; The path is @PATH@, the pinned digest file @EXPECT@, the prompt ids @IDS@.

(defn- mask48 [] :i64 281474976710655)

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- byte-at [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (bit-and (peek f p) 255))

;; write n bytes at p to stderr
(defn- wr [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (cc f (sym f "write") 2 p n 0 0))

(defn- wr-text [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (wr f (cstr f (vector-at R 3) s) (string-length s)))

(defn- wr-num [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 v :i64] :i64
  (wr-text f R (string-from-i64 v)))

;; trap unless the n bytes at p+i are inside the end bound eb
(defn- need [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 n :i64 eb :i64] :i64
  (if (> (+ i n) eb) (vector-at [0] 1) 0))

;; little-endian u32 at p+i
(defn- u32le [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64] :i64
  (bit-and (peek f (+ p i)) 4294967295))

;; ---- digest-before-read (slice 37): SHA-256 of the checkpoint file, compared with the pinned digest file ----
;; The same code as bench/kernels/sha256-metal, as helpers. The expected digest is the first 64 characters of the pinned
;; digest file (main passes its path); a different digest, or an unreadable file, traps before the checkpoint is read for any other purpose.
(defn- sha-m32 [] :i64 4294967295)
(defn- sha-rotr [x :i64 n :i64] :i64
  (bit-and (bit-or (i64-shift-right x n) (i64-shift-left x (- 32 n))) (sha-m32)))
(defn- sha-shr [x :i64 n :i64] :i64 (i64-shift-right x n))
(defn- sha-add [a :i64 b :i64] :i64 (bit-and (+ a b) (sha-m32)))

(defn- sha-ksched [] :vector-i64
  (vector-i64 1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895))
(defn- sha-ksched2 [] :vector-i64
  (vector-i64 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298))
;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- sha-s0 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 7) (sha-rotr x 18)) (sha-shr x 3)))
(defn- sha-s1 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 17) (sha-rotr x 19)) (sha-shr x 10)))
(defn- sha-S0 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 2) (sha-rotr x 13)) (sha-rotr x 22)))
(defn- sha-S1 [x :i64] :i64 (bit-xor (bit-xor (sha-rotr x 6) (sha-rotr x 11)) (sha-rotr x 25)))
(defn- sha-ch [e :i64 f :i64 g :i64] :i64 (bit-xor (bit-and e f) (bit-and (bit-xor e (sha-m32)) g)))
(defn- sha-maj [a :i64 b :i64 c :i64] :i64 (bit-xor (bit-xor (bit-and a b) (bit-and a c)) (bit-and b c)))

;; big-endian 32-bit word from four bytes at p
(defn- sha-be32 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64
  (let [w (bit-and (peek f p) (sha-m32))]
    (bit-or (bit-or (i64-shift-left (bit-and w 255) 24) (i64-shift-left (bit-and (i64-shift-right w 8) 255) 16))
            (bit-or (i64-shift-left (bit-and (i64-shift-right w 16) 255) 8) (bit-and (i64-shift-right w 24) 255)))))

;; one 64-byte sha-block at p: H is updated in place, K the 64 round constants, W a 64-word scratch vector
(defn- sha-block [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 H :vector-i64 K :vector-i64 W :vector-i64] :i64
  (let [u0 (loop [t 0]
             (if (= t 16) 0
               (let [u (vector-assoc! W t (sha-be32 f (+ p (* t 4))))] (recur (+ t 1)))))
        u1 (loop [t 16]
             (if (= t 64) 0
               (let [v (sha-add (sha-add (sha-s1 (vector-at W (- t 2))) (vector-at W (- t 7)))
                            (sha-add (sha-s0 (vector-at W (- t 15))) (vector-at W (- t 16))))
                     u (vector-assoc! W t v)]
                 (recur (+ t 1)))))]
    (loop [t 0
           a (vector-at H 0) b (vector-at H 1) c (vector-at H 2) d (vector-at H 3)
           e (vector-at H 4) ff (vector-at H 5) g (vector-at H 6) h (vector-at H 7)]
      (if (= t 64)
        (let [x0 (vector-assoc! H 0 (sha-add (vector-at H 0) a)) x1 (vector-assoc! H 1 (sha-add (vector-at H 1) b))
              x2 (vector-assoc! H 2 (sha-add (vector-at H 2) c)) x3 (vector-assoc! H 3 (sha-add (vector-at H 3) d))
              x4 (vector-assoc! H 4 (sha-add (vector-at H 4) e)) x5 (vector-assoc! H 5 (sha-add (vector-at H 5) ff))
              x6 (vector-assoc! H 6 (sha-add (vector-at H 6) g)) x7 (vector-assoc! H 7 (sha-add (vector-at H 7) h))]
          0)
        (let [t1 (sha-add (sha-add (sha-add h (sha-S1 e)) (sha-add (sha-ch e ff g) (vector-at K t))) (vector-at W t))
              t2 (sha-add (sha-S0 a) (sha-maj a b c))]
          (recur (+ t 1) (sha-add t1 t2) a b c (sha-add d t1) e ff g))))))

(defn- sha-hex-digest [H :vector-i64] :string
  (loop [i 0 s ""]
    (if (= i 8) s
      (let [w (vector-at H i)
            t (loop [k 0 acc ""]
                (if (= k 8) acc
                  (let [d (bit-and (i64-shift-right w (- 28 (* 4 k))) 15)]
                    (recur (+ k 1) (string-concat acc (string-substring "0123456789abcdef" d (+ d 1)))))))]
        (recur (+ i 1) (string-concat s t))))))

;; hex digest of the file at path, 64 lowercase hex characters
(defn- sha-file [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64] :string
  (let [total (cc f (sym f "lseek") fd 0 2 0 0)
        chunk 1048576
        buf (cc f (vector-at R 3) (+ chunk 8) 0 0 0 0)
        tail (cc f (vector-at R 3) 256 0 0 0 0)
        K (vector-alloc 64)
        k1 (loop [t 0] (if (= t 32) 0 (let [u (vector-assoc! K t (vector-at (sha-ksched) t))] (recur (+ t 1)))))
        k2 (loop [t 0] (if (= t 32) 0 (let [u (vector-assoc! K (+ 32 t) (vector-at (sha-ksched2) t))] (recur (+ t 1)))))
        W (vector-alloc 64)
        H (vector-i64 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225)
        full (* (quot total 64) 64)
        u1 (loop [off 0]
             (if (>= off full) 0
               (let [want (if (< (- full off) chunk) (- full off) chunk)
                     got (cc f (sym f "pread") fd buf want off 0)
                     u (if (= got want) 0 (vector-at [0] 1))
                     w (loop [p 0]
                         (if (>= p want) 0
                           (let [b (sha-block f (+ buf p) H K W)] (recur (+ p 64)))))]
                 (recur (+ off want)))))
        rem (- total full)
        z (loop [i 0] (if (= i 256) 0 (let [u (poke8 f (+ tail i) 0)] (recur (+ i 1)))))
        got2 (if (= rem 0) 0 (cc f (sym f "pread") fd tail rem full 0))
        u2 (if (= got2 rem) 0 (vector-at [0] 1))
        u3 (poke8 f (+ tail rem) 128)
        nb (if (< rem 56) 64 128)
        bits (* total 8)
        u4 (loop [i 0]
             (if (= i 8) 0
               (let [u (poke8 f (+ tail (+ (- nb 1) (- 0 i))) (bit-and (i64-shift-right bits (* 8 i)) 255))] (recur (+ i 1)))))
        u5 (sha-block f tail H K W)
        u6 (if (= nb 128) (sha-block f (+ tail 64) H K W) 0)]
    (sha-hex-digest H)))


;; fstat (macOS arm64 struct stat: st_mtimespec at 48, st_ctimespec at 64, st_size at 96): size, mtime and ctime (seconds and nanoseconds) of an
;; open file. ctime is set by the kernel on any write or metadata change and cannot be set back by a program.
(defn- fd-stamp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64] :vector-i64
  (let [sb (cc f (vector-at R 3) 160 0 0 0 0)
        r (cc f (sym f "fstat") fd sb 0 0 0)
        u (if (= r 0) 0 (vector-at [0] 1))]
    (vector-i64 (peek f (+ sb 96)) (peek f (+ sb 48)) (peek f (+ sb 56)) (peek f (+ sb 64)) (peek f (+ sb 72)))))
;; traps if the open file's size, modification time or change time differs from the stamp taken before it was hashed
(defn- stamp-same! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64 st0 :vector-i64] :i64
  (let [st1 (fd-stamp f R fd)]
    (if (= (+ (+ (+ (bit-xor (vector-at st0 0) (vector-at st1 0)) (bit-xor (vector-at st0 1) (vector-at st1 1))) (+ (bit-xor (vector-at st0 2) (vector-at st1 2)) (bit-xor (vector-at st0 3) (vector-at st1 3)))) (bit-xor (vector-at st0 4) (vector-at st1 4))) 0)
      0 (vector-at [0] 1))))

(defn- sha-verify! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 fd :i64 expect :string] :vector-i64
  (let [st0 (fd-stamp f R fd)
        want (cc f (sym f "open") (cstr f (vector-at R 3) expect) 0 0 0 0)
        u0 (if (< want 0) (vector-at [0] 1) 0)
        eb (cc f (vector-at R 3) 80 0 0 0 0)
        z (loop [i 0] (if (= i 80) 0 (let [u (poke8 f (+ eb i) 0)] (recur (+ i 1)))))
        got0 (cc f (sym f "pread") want eb 64 0 0)
        u1 (if (= got0 64) 0 (vector-at [0] 1))
        have (vector-i64-from-bytes (string-to-utf8 (sha-file f R fd)))
        bad (loop [i 0 acc 0]
              (if (= i 64) acc
                (recur (+ i 1) (+ acc (if (= (bit-and (peek f (+ eb i)) 255) (vector-at have i)) 0 1)))))
        trap (if (= bad 0) 0 (vector-at [0] 1))]
    st0))

;; ---- GGUF walk: every load is bounds-checked against eb (the file size) ----
;; one fixed-size GGUF value's byte size, 0 for string / array / unknown
(defn- vsize [t :i64] :i64
  (cond
    (= t 0) 1 (= t 1) 1 (= t 7) 1
    (= t 2) 2 (= t 3) 2
    (= t 4) 4 (= t 5) 4 (= t 6) 4
    (= t 10) 8 (= t 11) 8 (= t 12) 8
    :else 0))

;; skip the string at p+i (u64 length + bytes); returns the index after it
(defn- skip-str [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 eb :i64] :i64
  (let [u (need f p i 8 eb)
        ln (peek f (+ p i))
        nx (+ (+ i 8) ln)
        u2 (if (or (< ln 0) (> nx eb)) (vector-at [0] 1) 0)]
    nx))

;; ---- GGUF index (no printing): KVs and tensor infos recorded into vectors ----
;; skip one KV value of type t at p+i; returns the index after it
(defn- kv-skip [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 t :i64 eb :i64] :i64
  (let [s (vsize t)]
    (cond
      (> s 0) (let [u (need f p i s eb)] (+ i s))
      (= t 8) (skip-str f p i eb)
      (= t 9) (let [u (need f p i 12 eb)
                    et (u32le f p i)
                    cn (peek f (+ p (+ i 4)))
                    u2 (if (or (< cn 0) (> cn eb)) (vector-at [0] 1) 0)]
                (if (> (vsize et) 0)
                  (let [nx (+ (+ i 12) (* cn (vsize et)))
                        u3 (if (or (> nx eb) (< nx i)) (vector-at [0] 1) 0)]
                    nx)
                  (if (= et 8)
                    (loop [k 0 j (+ i 12)]
                      (if (= k cn) j
                        (recur (+ k 1) (skip-str f p j eb))))
                    (vector-at [0] 1))))
      :else (vector-at [0] 1))))

;; KI: 4 words per KV (key start, key length, type, value start), then the index after the last KV
(defn- kv-index [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 nk :i64 eb :i64] :vector-i64
  (let [KI (vector-alloc (+ (* 4 nk) 1))
        e (loop [k 0 j 24]
            (if (= k nk) j
              (let [u (need f p j 8 eb)
                    ln (peek f (+ p j))
                    ns (+ j 8)
                    u2 (if (or (< ln 0) (> (+ ns ln) eb)) (vector-at [0] 1) 0)
                    after (+ ns ln)
                    u3 (need f p after 4 eb)
                    t (u32le f p after)
                    a0 (vector-assoc! KI (* 4 k) ns)
                    a1 (vector-assoc! KI (+ (* 4 k) 1) ln)
                    a2 (vector-assoc! KI (+ (* 4 k) 2) t)
                    a3 (vector-assoc! KI (+ (* 4 k) 3) (+ after 4))]
                (recur (+ k 1) (kv-skip f p (+ after 4) t eb)))))
        z (vector-assoc! KI (* 4 nk) e)]
    KI))

;; 1 when the ln bytes at p equal the UTF-8 bytes of s
(defn- name-eq [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 ln :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (if (= n ln)
      (loop [i 0]
        (if (= i n) 1
          (if (= (byte-at f (+ p i)) (vector-at v i)) (recur (+ i 1)) 0)))
      0)))

;; the u32 value (f32 as raw bits) of KV key, which must have type t
(defn- kv-u32 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 KI :vector-i64 nk :i64 key :string t :i64] :i64
  (loop [k 0]
    (if (= k nk)
      (let [w (wr-text f R (string-concat "refused: missing KV " (string-concat key "\n")))] (vector-at [0] 1))
      (if (= (name-eq f (+ p (vector-at KI (* 4 k))) (vector-at KI (+ (* 4 k) 1)) key) 1)
        (if (= (vector-at KI (+ (* 4 k) 2)) t)
          (u32le f p (vector-at KI (+ (* 4 k) 3)))
          (let [w (wr-text f R (string-concat "refused: KV type " (string-concat key "\n")))] (vector-at [0] 1)))
        (recur (+ k 1))))))

;; TI: 7 words per tensor (name start, name length, rank, ne0, ne1, dtype, offset), then the index after the infos
(defn- t-index [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 nt :i64 eb :i64] :vector-i64
  (let [TI (vector-alloc (+ (* 7 nt) 1))
        e (loop [k 0 j i]
            (if (= k nt) j
              (let [u (need f p j 8 eb)
                    ln (peek f (+ p j))
                    ns (+ j 8)
                    u2 (if (or (< ln 0) (> (+ ns ln) eb)) (vector-at [0] 1) 0)
                    after (+ ns ln)
                    u3 (need f p after 4 eb)
                    nd (u32le f p after)
                    u4 (if (or (< nd 1) (> nd 4)) (vector-at [0] 1) 0)
                    u5 (need f p (+ after 4) (+ (* nd 8) 12) eb)
                    d0 (peek f (+ p (+ after 4)))
                    d1 (if (> nd 1) (peek f (+ p (+ after 12))) 1)
                    q2 (+ (+ after 4) (* nd 8))
                    dt (u32le f p q2)
                    off (peek f (+ p (+ q2 4)))
                    b (* 7 k)
                    a0 (vector-assoc! TI b ns)
                    a1 (vector-assoc! TI (+ b 1) ln)
                    a2 (vector-assoc! TI (+ b 2) nd)
                    a3 (vector-assoc! TI (+ b 3) d0)
                    a4 (vector-assoc! TI (+ b 4) d1)
                    a5 (vector-assoc! TI (+ b 5) dt)
                    a6 (vector-assoc! TI (+ b 6) off)]
                (recur (+ k 1) (+ q2 12)))))
        z (vector-assoc! TI (* 7 nt) e)]
    TI))

;; data-region offset of tensor name, refused unless its rank is 1 or 2, its dtype is dt, its dims are d0 x d1
;; and its span lies inside the data region of dlen bytes
(defn- t-find [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 TI :vector-i64 nt :i64 name :string dt :i64 d0 :i64 d1 :i64 dlen :i64] :i64
  (loop [k 0]
    (if (= k nt)
      (let [w (wr-text f R (string-concat "refused: missing tensor " (string-concat name "\n")))] (vector-at [0] 1))
      (let [b (* 7 k)]
        (if (= (name-eq f (+ p (vector-at TI b)) (vector-at TI (+ b 1)) name) 1)
          (let [bad (+ (+ (if (= (vector-at TI (+ b 5)) dt) 0 1) (if (= (vector-at TI (+ b 3)) d0) 0 1))
                       (+ (if (= (vector-at TI (+ b 4)) d1) 0 1) (if (<= (vector-at TI (+ b 2)) 2) 0 1)))
                off (vector-at TI (+ b 6))
                size (if (= dt 0) (* (* d0 d1) 4) (* (quot (* d0 d1) 32) 34))
                bad2 (+ bad (+ (if (< off 0) 1 0) (if (> (+ off size) dlen) 1 0)))]
            (if (= bad2 0) off
              (let [w (wr-text f R (string-concat "refused: tensor shape, dtype or span " (string-concat name "\n")))] (vector-at [0] 1))))
          (recur (+ k 1)))))))

;; ---- the kernels: every one takes (W bytes, A floats, P eight uints) ----
(defn- kernel-source [] :string
  "#include <metal_stdlib>
using namespace metal;
struct P { uint a, b, c, d, e, f, g, h; };
struct P16 { uint a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, q; };

// Q8_0 matvec: y = W x (+ bias) ; a weight off, b rows, c cols, d bias off, e flags (1 bias, 2 add into y,
// 4 SwiGLU input: x[k] = silu(A[f + k]) * A[f + c + k]), f x off, g y off. Two simdgroups of 32 per 64-thread threadgroup, 4 rows per simdgroup (8 rows per threadgroup).
// Lane l works on block l/4 (stepping by 8 blocks) and quants (l%4)*8 .. +7, keeping that x slice in registers
// for the 4 rows; each row is summed with simd_sum.
kernel void mv(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
               uint tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
               uint ln [[thread_index_in_simdgroup]]) {
  uint r0 = (tg * 2 + sg) * 4;
  if (r0 >= p.b) return;
  uint nb = p.c / 32;
  uint ix = ln / 4, il = ln % 4;
  device const float *x = A + p.f;
  device const uchar *w0 = W + p.a + r0 * nb * 34;
  float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f, s3 = 0.0f;
  for (uint ib = ix; ib < nb; ib += 8) {
    device const float4 *xv = (device const float4 *)(x + ib * 32 + il * 8);
    float4 y0 = xv[0], y1 = xv[1];
    if (p.e & 4u) {
      device const float4 *uv = (device const float4 *)(x + p.c + ib * 32 + il * 8);
      y0 = y0 / (1.0f + exp(-y0)) * uv[0];
      y1 = y1 / (1.0f + exp(-y1)) * uv[1];
    }
    device const uchar *bl = w0 + ib * 34;
    for (uint r = 0; r < 4; r++) {
      device const uchar *br = bl + r * nb * 34;
      device const char *q = (device const char *)(br + 2 + il * 8);
      float t = dot(float4(q[0], q[1], q[2], q[3]), y0) + dot(float4(q[4], q[5], q[6], q[7]), y1);
      t *= float(*(device const half *)br);
      if (r == 0) s0 += t; else if (r == 1) s1 += t; else if (r == 2) s2 += t; else s3 += t;
    }
  }
  s0 = simd_sum(s0); s1 = simd_sum(s1); s2 = simd_sum(s2); s3 = simd_sum(s3);
  if (ln < 4 && r0 + ln < p.b) {
    uint r = r0 + ln;
    float s = ln == 0 ? s0 : ln == 1 ? s1 : ln == 2 ? s2 : s3;
    if (p.e & 1u) s += *(device const float *)(W + p.d + r * 4);
    if (p.e & 2u) A[p.g + r] += s; else A[p.g + r] = s;
  }
}

// RMSNorm fused into a Q8_0 matvec over up to three stacked weight segments (q|k|v, gate|up, or the head):
// a w0, b bias0, c w1, d bias1, e w2, f bias2, g norm weight off, h epsilon bits, i x off, j y off, k cols,
// l rows0, m rows1, n rows2, o flags (1 biases). Segment lengths are multiples of 4, so a simdgroup's 4 rows are
// in one segment. Every simdgroup recomputes the norm scale of x (k floats) itself.
kernel void nmv(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P16 &p [[buffer(2)]],
                uint tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                uint ln [[thread_index_in_simdgroup]]) {
  uint r0 = (tg * 2 + sg) * 4;
  uint total = p.l + p.m + p.n;
  if (r0 >= total) return;
  device const float *x = A + p.i;
  float ss = 0.0f;
  for (uint k = ln; k < p.k; k += 32) ss += x[k] * x[k];
  ss = simd_sum(ss);
  float scale = 1.0f / precise::sqrt(ss / float(p.k) + as_type<float>(p.h));
  device const float *nw = (device const float *)(W + p.g);
  uint wo, bo, rr;
  if (r0 < p.l) { wo = p.a; bo = p.b; rr = r0; }
  else if (r0 < p.l + p.m) { wo = p.c; bo = p.d; rr = r0 - p.l; }
  else { wo = p.e; bo = p.f; rr = r0 - p.l - p.m; }
  uint nb = p.k / 32;
  uint ix = ln / 4, il = ln % 4;
  device const uchar *w0 = W + wo + rr * nb * 34;
  float s0 = 0.0f, s1 = 0.0f, s2 = 0.0f, s3 = 0.0f;
  for (uint ib = ix; ib < nb; ib += 8) {
    uint k0 = ib * 32 + il * 8;
    device const float4 *xv = (device const float4 *)(x + k0);
    device const float4 *nv = (device const float4 *)(nw + k0);
    float4 y0 = xv[0] * scale * nv[0], y1 = xv[1] * scale * nv[1];
    device const uchar *bl = w0 + ib * 34;
    for (uint r = 0; r < 4; r++) {
      device const uchar *br = bl + r * nb * 34;
      device const char *q = (device const char *)(br + 2 + il * 8);
      float t = dot(float4(q[0], q[1], q[2], q[3]), y0) + dot(float4(q[4], q[5], q[6], q[7]), y1);
      t *= float(*(device const half *)br);
      if (r == 0) s0 += t; else if (r == 1) s1 += t; else if (r == 2) s2 += t; else s3 += t;
    }
  }
  s0 = simd_sum(s0); s1 = simd_sum(s1); s2 = simd_sum(s2); s3 = simd_sum(s3);
  if (ln < 4) {
    float s = ln == 0 ? s0 : ln == 1 ? s1 : ln == 2 ? s2 : s3;
    if (p.o & 1u) s += *(device const float *)(W + bo + (rr + ln) * 4);
    A[p.j + r0 + ln] = s;
  }
}

// NEOX RoPE on q (14 heads) and k (2 heads) in place, k and v stored into the cache, for M token rows (640 threads
// per row): a layer, b position of row 0, c positions per layer, d q off, e k off, f v off (row 0), g k cache off,
// h v cache off, i base bits, j floats between rows, k M
kernel void ropekv(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P16 &p [[buffer(2)]],
                   uint gt [[thread_position_in_grid]]) {
  uint m = gt / 640, t = gt % 640;
  if (m >= p.k) return;
  uint pos = p.b + m;
  uint cache = (p.a * p.c + pos) * 128;
  uint ro = m * p.j;
  if (t < 512) {
    bool isk = t >= 448;
    uint u = isk ? t - 448 : t;
    uint h = u / 32, j = u % 32;
    float inv = precise::pow(as_type<float>(p.i), -float(2 * j) / 64.0f);
    float ang = float(pos) * inv;
    float c = precise::cos(ang), s = precise::sin(ang);
    device float *y = A + (isk ? p.e : p.d) + ro + h * 64;
    float a = y[j], b = y[j + 32];
    float lo = a * c - b * s, hi = a * s + b * c;
    y[j] = lo;
    y[j + 32] = hi;
    if (isk) { A[p.g + cache + h * 64 + j] = lo; A[p.g + cache + h * 64 + j + 32] = hi; }
  } else {
    uint i = t - 512;
    A[p.h + cache + i] = A[p.f + ro + i];
  }
}

// one dequantized embedding row: a table off, b token, c row length, d 1 = take the token from the uint word at e
// (the previous step's argmax) instead of b, g out off
kernel void embed(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                  uint i [[thread_position_in_grid]]) {
  if (i >= p.c) return;
  uint tok = p.d == 1u ? ((device const uint *)A)[p.e] : p.b;
  device const uchar *bl = W + p.a + tok * (p.c / 32) * 34 + (i / 32) * 34;
  A[p.g + i] = float(*(device const half *)bl) * float(((device const char *)(bl + 2))[i % 32]);
}

// causal GQA attention for M query rows, one 256-thread threadgroup per (row, head): a layer, b query heads per kv
// head, c positions seen by row 0 (row m sees c + m, at most 1024), d positions per layer, e q off, f out off,
// g k cache off, h v cache off, i floats between q rows, j floats between out rows. Thread t scores positions
// t, t + 256, ... (64-wide float4 dot products); the max and the sum of exp come from simdgroup and threadgroup
// reductions, each exp computed once; then 4 groups of 64 threads (one output dimension each) sum a quarter of
// the positions and the four partial outputs are added.
kernel void attn(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P16 &p [[buffer(2)]],
                 uint tg [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                 uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  threadgroup float sc[1024];
  threadgroup float red[8];
  threadgroup float part[256];
  uint m = tg / 14, h = tg % 14;
  uint kh = h / p.b;
  uint n = p.c + m;
  device const float *kc = A + p.g + p.a * p.d * 128 + kh * 64;
  device const float *vc = A + p.h + p.a * p.d * 128 + kh * 64;
  device const float4 *qv = (device const float4 *)(A + p.e + m * p.i + h * 64);
  float lm = -INFINITY;
  for (uint s = t; s < n; s += 256) {
    device const float4 *kr = (device const float4 *)(kc + s * 128);
    float acc = 0.0f;
    for (uint i = 0; i < 16; i++) acc += dot(qv[i], kr[i]);
    acc *= 0.125f;
    sc[s] = acc;
    lm = max(lm, acc);
  }
  float mx = simd_max(lm);
  if (ln == 0) red[sg] = mx;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  mx = max(max(max(red[0], red[1]), max(red[2], red[3])), max(max(red[4], red[5]), max(red[6], red[7])));
  float lz = 0.0f;
  for (uint s = t; s < n; s += 256) { float e = precise::exp(sc[s] - mx); sc[s] = e; lz += e; }
  float z = simd_sum(lz);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (ln == 0) red[sg] = z;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  z = ((red[0] + red[1]) + (red[2] + red[3])) + ((red[4] + red[5]) + (red[6] + red[7]));
  uint g = t / 64, d = t % 64;
  float o = 0.0f;
  for (uint s = g; s < n; s += 4) o += sc[s] * vc[s * 128 + d];
  part[t] = o;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (g == 0) A[p.f + m * p.j + h * 64 + d] = ((part[d] + part[d + 64]) + (part[d + 128] + part[d + 192])) / z;
}

// causal GQA attention for prefill, 4 query rows per ATQ_NT-thread threadgroup (one head): same parameters as attn
// (row m sees c + m positions, at most 1024), k M. The 4 q rows sit in threadgroup memory; thread t scores positions
// t, t + ATQ_NT, ... for all 4 rows from one read of each k row; per-row max and sum come from simdgroup and
// threadgroup reductions; then thread t sums positions g, g + G, ... (G = ATQ_NT / 256, g = t / 256) for output
// dimension t % 64 of row (t / 64) % 4, and the G partial sums are added.
constant constexpr uint ATQ_NT = 512;
kernel void attnq(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P16 &p [[buffer(2)]],
                  uint tg [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                  uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  threadgroup float sc[4 * 1024];
  threadgroup float4 qs[4 * 16];
  threadgroup float red[4 * 32];
  threadgroup float rm[4], rz[4];
  threadgroup float part[ATQ_NT];
  uint mb = (tg / 14) * 4, h = tg % 14;
  uint kh = h / p.b;
  device const float *kc = A + p.g + p.a * p.d * 128 + kh * 64;
  device const float *vc = A + p.h + p.a * p.d * 128 + kh * 64;
  uint rows = min(4u, p.k - mb);
  if (t < 64) {
    uint r = t / 16, i = t % 16;
    qs[t] = r < rows ? ((device const float4 *)(A + p.e + (mb + r) * p.i + h * 64))[i] : float4(0.0f);
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  uint nmax = p.c + mb + rows - 1;
  float lm0 = -INFINITY, lm1 = -INFINITY, lm2 = -INFINITY, lm3 = -INFINITY;
  for (uint s = t; s < nmax; s += ATQ_NT) {
    device const float4 *kr = (device const float4 *)(kc + s * 128);
    float a0 = 0.0f, a1 = 0.0f, a2 = 0.0f, a3 = 0.0f;
    for (uint i = 0; i < 16; i++) {
      float4 kv = kr[i];
      a0 += dot(qs[i], kv); a1 += dot(qs[16 + i], kv); a2 += dot(qs[32 + i], kv); a3 += dot(qs[48 + i], kv);
    }
    a0 = s < p.c + mb ? a0 * 0.125f : -INFINITY;
    a1 = s < p.c + mb + 1 ? a1 * 0.125f : -INFINITY;
    a2 = s < p.c + mb + 2 ? a2 * 0.125f : -INFINITY;
    a3 = s < p.c + mb + 3 ? a3 * 0.125f : -INFINITY;
    sc[s] = a0; sc[1024 + s] = a1; sc[2048 + s] = a2; sc[3072 + s] = a3;
    lm0 = max(lm0, a0); lm1 = max(lm1, a1); lm2 = max(lm2, a2); lm3 = max(lm3, a3);
  }
  lm0 = simd_max(lm0); lm1 = simd_max(lm1); lm2 = simd_max(lm2); lm3 = simd_max(lm3);
  if (ln == 0) { red[sg] = lm0; red[32 + sg] = lm1; red[64 + sg] = lm2; red[96 + sg] = lm3; }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (t < 4) {
    float m = red[t * 32];
    for (uint i = 1; i < ATQ_NT / 32; i++) m = max(m, red[t * 32 + i]);
    rm[t] = m;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  float z0 = 0.0f, z1 = 0.0f, z2 = 0.0f, z3 = 0.0f;
  for (uint s = t; s < nmax; s += ATQ_NT) {
    float e0 = precise::exp(sc[s] - rm[0]), e1 = precise::exp(sc[1024 + s] - rm[1]);
    float e2 = precise::exp(sc[2048 + s] - rm[2]), e3 = precise::exp(sc[3072 + s] - rm[3]);
    sc[s] = e0; sc[1024 + s] = e1; sc[2048 + s] = e2; sc[3072 + s] = e3;
    z0 += e0; z1 += e1; z2 += e2; z3 += e3;
  }
  z0 = simd_sum(z0); z1 = simd_sum(z1); z2 = simd_sum(z2); z3 = simd_sum(z3);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (ln == 0) { red[sg] = z0; red[32 + sg] = z1; red[64 + sg] = z2; red[96 + sg] = z3; }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (t < 4) {
    float z = 0.0f;
    for (uint i = 0; i < ATQ_NT / 32; i++) z += red[t * 32 + i];
    rz[t] = z;
  }
  threadgroup_barrier(mem_flags::mem_threadgroup);
  uint g = t / 256, r = (t / 64) % 4, d = t % 64;
  float o = 0.0f;
  if (r < rows) {
    uint n = p.c + mb + r;
    for (uint s = g; s < n; s += ATQ_NT / 256) o += sc[r * 1024 + s] * vc[s * 128 + d];
  }
  part[t] = o;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  if (g == 0 && r < rows) {
    uint i = r * 64 + d;
    float sum = 0.0f;
    for (uint q = 0; q < ATQ_NT / 256; q++) sum += part[q * 256 + i];
    A[p.f + (mb + r) * p.j + h * 64 + d] = sum / rz[r];
  }
}

// causal GQA attention for prefill on simdgroup matrices, 8 query rows of one head per 128-thread threadgroup:
// same parameters as attn (row m sees c + m positions, at most 1024), k M. K and V are walked in chunks of 32
// positions with an online softmax: each simdgroup computes the 8 x 8 scores of 8 positions (Q from threadgroup
// memory, K loaded transposed from the cache), then each simdgroup takes 2 rows (one lane per position, simd_max
// and simd_sum) to update the row's running max and sum and turn the scores into probabilities, then each simdgroup rescales its 8 x 16 slice of the output by a diagonal matrix of the
// rows' correction factors and adds P V for the chunk.
kernel void attnf(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P16 &p [[buffer(2)]],
                  uint tg [[threadgroup_position_in_grid]], uint t [[thread_position_in_threadgroup]],
                  uint sg [[simdgroup_index_in_threadgroup]], uint ln [[thread_index_in_simdgroup]]) {
  threadgroup float qs[8 * 64];
  threadgroup float sc[8 * 32];
  threadgroup float dg[64];
  threadgroup float rl[8];
  threadgroup float rmx[8];
  uint mb = (tg / 14) * 8, h = tg % 14;
  uint kh = h / p.b;
  device const float *kc = A + p.g + p.a * p.d * 128 + kh * 64;
  device const float *vc = A + p.h + p.a * p.d * 128 + kh * 64;
  uint rows = min(8u, p.k - mb);
  for (uint e = t; e < 512; e += 128) {
    uint r = e / 64, d = e % 64;
    qs[e] = r < rows ? A[p.e + (mb + r) * p.i + h * 64 + d] * 0.125f : 0.0f;
  }
  if (t < 64) dg[t] = 0.0f;
  if (t < 8) { rmx[t] = -INFINITY; rl[t] = 0.0f; }
  simdgroup_float8x8 o[2];
  o[0] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  o[1] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  uint nmax = p.c + mb + rows - 1;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint s0 = 0; s0 < nmax; s0 += 32) {
    simdgroup_float8x8 sacc = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
    for (uint dk = 0; dk < 64; dk += 8) {
      simdgroup_float8x8 qf, kf;
      simdgroup_load(qf, qs + dk, 64);
      simdgroup_load(kf, kc + (s0 + sg * 8) * 128 + dk, 128, ulong2(0, 0), true);
      simdgroup_multiply_accumulate(sacc, qf, kf, sacc);
    }
    simdgroup_store(sacc, sc + sg * 8, 32);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint rr = 0; rr < 2; rr++) {
      uint r = sg * 2 + rr;
      bool ok = s0 + ln < p.c + mb + r;
      float v = ok ? sc[r * 32 + ln] : -INFINITY;
      float old = rmx[r];
      float cm = max(old, simd_max(v));
      float e = ok ? precise::exp(v - cm) : 0.0f;
      sc[r * 32 + ln] = e;
      float ls = simd_sum(e);
      if (ln == 0) {
        float alpha = precise::exp(old - cm);
        rl[r] = rl[r] * alpha + ls;
        rmx[r] = cm;
        dg[r * 9] = alpha;
      }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    simdgroup_float8x8 df;
    simdgroup_load(df, dg, 8);
    for (uint j = 0; j < 2; j++) {
      simdgroup_float8x8 tmp;
      simdgroup_multiply(tmp, df, o[j]);
      for (uint kp = 0; kp < 32; kp += 8) {
        simdgroup_float8x8 pf, vf;
        simdgroup_load(pf, sc + kp, 32);
        simdgroup_load(vf, vc + (s0 + kp) * 128 + sg * 16 + j * 8, 128);
        simdgroup_multiply_accumulate(tmp, pf, vf, tmp);
      }
      o[j] = tmp;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  for (uint j = 0; j < 2; j++) simdgroup_store(o[j], qs + sg * 16 + j * 8, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint e = t; e < 512; e += 128) {
    uint r = e / 64, d = e % 64;
    if (r < rows) A[p.f + (mb + r) * p.j + h * 64 + d] = qs[e] / rl[r];
  }
}

// embedding rows for M prompt tokens (uint words at e): a table off, b M, c row length, g out off (rows of c)
kernel void embedb(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                   uint gi [[thread_position_in_grid]]) {
  uint m = gi / p.c, i = gi % p.c;
  if (m >= p.b) return;
  uint tok = ((device const uint *)A)[p.e + m];
  device const uchar *bl = W + p.a + tok * (p.c / 32) * 34 + (i / 32) * 34;
  A[p.g + m * p.c + i] = float(*(device const half *)bl) * float(((device const char *)(bl + 2))[i % 32]);
}

// RMSNorm of M rows, one simdgroup per row (8 per 256-thread threadgroup): a weight off, b M, c n, f x off,
// g out off (both rows of c), h epsilon bits
kernel void rsb(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                uint tg [[threadgroup_position_in_grid]], uint sg [[simdgroup_index_in_threadgroup]],
                uint ln [[thread_index_in_simdgroup]]) {
  uint m = tg * 8 + sg;
  if (m >= p.b) return;
  device const float *x = A + p.f + m * p.c;
  float ss = 0.0f;
  for (uint k = ln; k < p.c; k += 32) ss += x[k] * x[k];
  ss = simd_sum(ss);
  float r = 1.0f / precise::sqrt(ss / float(p.c) + as_type<float>(p.h));
  device const float *w = (device const float *)(W + p.a);
  for (uint k = ln; k < p.c; k += 32) A[p.g + m * p.c + k] = x[k] * r * w[k];
}

// SwiGLU in place for M rows: gate[k] = silu(gate[k]) * up[k], up c floats after gate; b M, c n, f off, g row stride
kernel void swig(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                 uint gi [[thread_position_in_grid]]) {
  uint m = gi / p.c, k = gi % p.c;
  if (m >= p.b) return;
  device float *r = A + p.f + m * p.g;
  float g = r[k];
  r[k] = g / (1.0f + precise::exp(-g)) * r[p.c + k];
}

struct G { uint w0, b0, w1, b1, w2, b2, s0, s1, s2, k, xo, xs, yo, ys, fl, mm, ntn, pad; };

// Q8_0 GEMM for prefill: Y[m][n] = sum_k X[m][k] W[n][k] (+ bias[n]) over M activation rows (xs floats apart) and
// up to three stacked weight segments (rows s0 | s1 | s2, each a multiple of 64); fl & 1 adds the segment's bias,
// fl & 2 adds into Y (ys floats between rows). One 128-thread threadgroup computes a 32 x 64 tile (ntn tiles across
// n): per Q8_0 block of k it stages X (32 x 32, float) and the weights dequantized to half (64 x 32) in threadgroup
// memory, and each of the 4 simdgroups accumulates a 32 x 16 slice with 8 x 8 simdgroup matrices (half weights,
// float activations and accumulators). Rounding the dequantized weights to half moves logits by about 1e-2. One
// 8 KB threadgroup buffer holds both stages. Without a bias the tile goes straight to Y with simdgroup_store (in add
// mode the accumulators start from Y's tile); rows past M land in the unused rows of the 512-row buffers. With a bias
// the buffer stages the 32 x 64 output tile for the epilogue, which writes rows below M only.
kernel void gemm(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant G &p [[buffer(2)]],
                 uint tg [[threadgroup_position_in_grid]], uint t [[thread_index_in_threadgroup]],
                 uint sg [[simdgroup_index_in_threadgroup]]) {
  threadgroup float buf[2048];
  threadgroup float *As = buf;
  threadgroup half *Bs = (threadgroup half *)(buf + 1024);
  threadgroup float *Cs = buf;
  uint tn = tg % p.ntn, tm = tg / p.ntn;
  uint n0 = tn * 64, m0 = tm * 32;
  uint wo, bo, nr;
  if (n0 < p.s0) { wo = p.w0; bo = p.b0; nr = n0; }
  else if (n0 < p.s0 + p.s1) { wo = p.w1; bo = p.b1; nr = n0 - p.s0; }
  else { wo = p.w2; bo = p.b2; nr = n0 - p.s0 - p.s1; }
  uint nb = p.k / 32;
  simdgroup_float8x8 acc[4][2];
  device float *yt = A + p.yo + m0 * p.ys + n0 + sg * 16;
  for (uint i = 0; i < 4; i++) for (uint j = 0; j < 2; j++) {
    if (p.fl & 2u) simdgroup_load(acc[i][j], yt + i * 8 * p.ys + j * 8, p.ys);
    else acc[i][j] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  }
  for (uint kb = 0; kb < nb; kb++) {
    for (uint e = t; e < 256; e += 128) {
      uint mr = e / 8, k4 = e % 8, m = m0 + mr;
      float4 v = m < p.mm ? *(device const float4 *)(A + p.xo + m * p.xs + kb * 32 + k4 * 4) : float4(0.0f);
      *(threadgroup float4 *)(As + mr * 32 + k4 * 4) = v;
    }
    {
      uint r = t / 2, hh = t % 2;
      device const uchar *bl = W + wo + (nr + r) * nb * 34 + kb * 34;
      float d = float(*(device const half *)bl);
      device const ushort *q = (device const ushort *)(bl + 2 + hh * 16);
      threadgroup half4 *dst = (threadgroup half4 *)(Bs + r * 32 + hh * 16);
      for (uint i = 0; i < 4; i++) {
        char2 c0 = as_type<char2>(q[2 * i]), c1 = as_type<char2>(q[2 * i + 1]);
        dst[i] = half4(d * float4(c0.x, c0.y, c1.x, c1.y));
      }
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint kk = 0; kk < 32; kk += 8) {
      simdgroup_float8x8 a[4];
      simdgroup_half8x8 b[2];
      for (uint i = 0; i < 4; i++) simdgroup_load(a[i], As + i * 8 * 32 + kk, 32);
      for (uint j = 0; j < 2; j++) simdgroup_load(b[j], Bs + (sg * 16 + j * 8) * 32 + kk, 32, ulong2(0, 0), true);
      for (uint i = 0; i < 4; i++) for (uint j = 0; j < 2; j++) simdgroup_multiply_accumulate(acc[i][j], a[i], b[j], acc[i][j]);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  if (!(p.fl & 1u)) {
    for (uint i = 0; i < 4; i++) for (uint j = 0; j < 2; j++) simdgroup_store(acc[i][j], yt + i * 8 * p.ys + j * 8, p.ys);
    return;
  }
  for (uint i = 0; i < 4; i++) for (uint j = 0; j < 2; j++) simdgroup_store(acc[i][j], Cs + i * 8 * 64 + sg * 16 + j * 8, 64);
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint e = t; e < 2048; e += 128) {
    uint mr = e / 64, nn = e % 64, m = m0 + mr;
    if (m < p.mm) {
      float v = Cs[e] + *(device const float *)(W + bo + (nr + nn) * 4);
      A[p.yo + m * p.ys + n0 + nn] = v;
    }
  }
}

// max |a - b| over n floats and max |a|, as float bits, in one 1024-thread threadgroup: c n, e a off, f b off,
// g out word (max |a - b|), g + 1 (max |a|)
kernel void maxdiff(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                    uint t [[thread_position_in_threadgroup]]) {
  threadgroup float bd[1024];
  threadgroup float ba[1024];
  float d = 0.0f, a = 0.0f;
  for (uint i = t; i < p.c; i += 1024) { d = max(d, fabs(A[p.e + i] - A[p.f + i])); a = max(a, fabs(A[p.e + i])); }
  bd[t] = d; ba[t] = a;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint w = 512; w > 0; w >>= 1) {
    if (t < w) { bd[t] = max(bd[t], bd[t + w]); ba[t] = max(ba[t], ba[t + w]); }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  if (t == 0) { ((device uint *)A)[p.g] = as_type<uint>(bd[0]); ((device uint *)A)[p.g + 1] = as_type<uint>(ba[0]); }
}

// argmax (first index on ties) in one 1024-thread threadgroup: c n, f logits off, g out word (uint),
// also logged at word h + e (e the position)
kernel void argmax(device const uchar *W [[buffer(0)]], device float *A [[buffer(1)]], constant P &p [[buffer(2)]],
                   uint t [[thread_position_in_threadgroup]]) {
  threadgroup float bv[1024];
  threadgroup uint bi[1024];
  float best = -INFINITY;
  uint idx = 0;
  for (uint i = t; i < p.c; i += 1024) { float v = A[p.f + i]; if (v > best) { best = v; idx = i; } }
  bv[t] = best; bi[t] = idx;
  threadgroup_barrier(mem_flags::mem_threadgroup);
  for (uint w = 512; w > 0; w >>= 1) {
    if (t < w && (bv[t + w] > bv[t] || (bv[t + w] == bv[t] && bi[t + w] < bi[t]))) { bv[t] = bv[t + w]; bi[t] = bi[t + w]; }
    threadgroup_barrier(mem_flags::mem_threadgroup);
  }
  if (t == 0) { ((device uint *)A)[p.g] = bi[0]; ((device uint *)A)[p.h + p.e] = bi[0]; }
}
")

(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        n (cc f (sym f "strlen") t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

(defn- pipeline [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 lib :i64 errp :i64 name :string] :i64
  (let [fn (msg f R lib "newFunctionWithName:" (nsstring f R name) 0 0)
        u (if (= fn 0) (vector-at [0] 1) 0)
        po (msg f R dev "newComputePipelineStateWithFunction:error:" fn errp 0)]
    (if (= po 0) (refuse f R (peek f errp)) po)))

(defn- pk [lo :i64 hi :i64] :i64 (bit-or (bit-and lo 4294967295) (i64-shift-left hi 32)))

;; C: 0 setComputePipelineState: 1 setBytes:length:atIndex: 2 dispatchThreadgroups:threadsPerThreadgroup:
;;    3 parameter scratch, 4 queue, 5 W, 6 A, 7 A contents, 8..13 pipelines (mv embed attn argmax nmv ropekv),
;;    14 setBuffer:offset:atIndex:, 15 timing accumulators (encode, gpu wait), 16 mach_absolute_time,
;;    17..23 pipelines (embedb rsb gemm maxdiff swig attnq attnf), dispatched as k = 9..15
;; one dispatch of pipeline k: gx threadgroups of tx threads, parameters pv (at most 24 uint words, bytes 0..95 of the
;; scratch; the grid and group sizes live at 96 and 128)
(defn- disp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 en :i64 C :vector-i64 k :i64 pv :vector-i64 gx :i64 tx :i64] :i64
  (let [pm (vector-at C 3)
        np2 (quot (vector-count pv) 2)
        u0 (loop [i 0]
             (if (= i np2) 0
               (let [u (poke f (+ pm (* 8 i)) (pk (vector-at pv (* 2 i)) (vector-at pv (+ (* 2 i) 1))))] (recur (+ i 1)))))
        u2 (if (> (vector-count pv) 24) (vector-at [0] 1) 0)
        grid (+ pm 96)
        group (+ pm 128)
        u3 0
        v0 (poke f grid gx) v1 (poke f (+ grid 8) 1) v2 (poke f (+ grid 16) 1)
        v3 (poke f group tx) v4 (poke f (+ group 8) 1) v5 (poke f (+ group 16) 1)
        ms (vector-at R 0)
        s0 (cc f ms en (vector-at C 0) (vector-at C (+ 8 k)) 0 0)
        s1 (cc f ms en (vector-at C 1) pm (* 4 (vector-count pv)) 2)
        s2 (cc f ms en (vector-at C 2) grid group 0)]
    0))

;; arena A offsets (floats); every vector offset is a multiple of 4 (float4 loads)
(defn- oX [] :i64 0)
(defn- oQ [] :i64 1792)
(defn- oK [] :i64 2688)
(defn- oV [] :i64 2816)
(defn- oO [] :i64 2944)
(defn- oG [] :i64 3840)
(defn- oLG [] :i64 13568)
(defn- oLG2 [] :i64 165504)
(defn- oKC [] :i64 317440)
(defn- oVC [] :i64 3463168)
(defn- oTOK [] :i64 6608896)
(defn- oDIFF [] :i64 6608897)
(defn- oLOG [] :i64 6608900)
(defn- oTOKS [] :i64 6609924)
(defn- oXB [] :i64 6610436)
(defn- oQKV [] :i64 7069188)
(defn- oOB [] :i64 7659012)
(defn- oGU [] :i64 8117764)
(defn- oRS [] :i64 13098500)
(defn- arena-floats [] :i64 13099012)
(defn- tmax [] :i64 1024)
(defn- mmax [] :i64 512)

;; L: 12 offsets per layer (attn_norm q.w q.b k.w k.b v.w v.b o.w ffn_norm gate up down), then 288 embedding,
;; 289 output_norm, 290 epsilon bits, 291 rope base bits
(defn- lw [L :vector-i64 l :i64 k :i64] :i64 (vector-at L (+ (* l 12) k)))

;; one token through the model in one command buffer; returns the argmax token id
(defn- step-enc! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 C :vector-i64 L :vector-i64 tok :i64 pos :i64 from-gpu :i64] :i64
  (let [ms (vector-at R 0)
        ta (cc f (vector-at C 16) 0 0 0 0 0)
        cb (msg f R (vector-at C 4) "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        b0 (cc f ms en (vector-at C 14) (vector-at C 5) 0 0)
        b1 (cc f ms en (vector-at C 14) (vector-at C 6) 0 1)
        eps (vector-at L 290)
        base (vector-at L 291)
        e0 (disp f R en C 1 (vector-i64 (vector-at L 288) tok 896 from-gpu (oTOK) 0 (oX) 0) 7 128)
        ly (loop [l 0]
             (if (= l 24) 0
               (let [d1 (disp f R en C 4 (vector-i64 (lw L l 1) (lw L l 2) (lw L l 3) (lw L l 4) (lw L l 5) (lw L l 6)
                                                     (lw L l 0) eps (oX) (oQ) 896 896 128 128 1 0) 144 64)
                     d2 (disp f R en C 5 (vector-i64 l pos (tmax) (oQ) (oK) (oV) (oKC) (oVC) base 0 1 0 0 0 0 0) 10 64)
                     d3 (disp f R en C 2 (vector-i64 l 7 (+ pos 1) (tmax) (oQ) (oO) (oKC) (oVC) 0 0 0 0 0 0 0 0) 14 256)
                     d4 (disp f R en C 0 (vector-i64 (lw L l 7) 896 896 0 2 (oO) (oX) 0) 112 64)
                     d5 (disp f R en C 4 (vector-i64 (lw L l 9) 0 (lw L l 10) 0 0 0
                                                     (lw L l 8) eps (oX) (oG) 896 4864 4864 0 0 0) 1216 64)
                     d6 (disp f R en C 0 (vector-i64 (lw L l 11) 896 4864 0 6 (oG) (oX) 0) 112 64)]
                 (recur (+ l 1)))))
        f2 (disp f R en C 4 (vector-i64 (vector-at L 288) 0 0 0 0 0 (vector-at L 289) eps (oX) (oLG) 896 151936 0 0 0 0) 18992 64)
        f3 (disp f R en C 3 (vector-i64 0 0 151936 0 pos (oLG) (oTOK) (oLOG)) 1 1024)
        z0 (msg f R en "endEncoding" 0 0 0)
        z1 (msg f R cb "commit" 0 0 0)
        tb (cc f (vector-at C 16) 0 0 0 0 0)
        acc (vector-at C 15)
        k0 (poke f acc (+ (peek f acc) (- tb ta)))]
    cb))

;; the whole prompt (M tokens already in the arena at oTOKS, positions pos0 ..) through the model in one command
;; buffer, 9 dispatches per layer; the last row goes through the head into logits at lg and argmax (logged at its
;; position). Returns the command buffer, committed.
(defn- prefill-enc! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 C :vector-i64 L :vector-i64 M :i64 pos0 :i64 lg :i64] :i64
  (let [ms (vector-at R 0)
        ta (cc f (vector-at C 16) 0 0 0 0 0)
        cb (msg f R (vector-at C 4) "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        b0 (cc f ms en (vector-at C 14) (vector-at C 5) 0 0)
        b1 (cc f ms en (vector-at C 14) (vector-at C 6) 0 1)
        eps (vector-at L 290)
        base (vector-at L 291)
        tm (quot (+ M 31) 32)
        e0 (disp f R en C 9 (vector-i64 (vector-at L 288) M 896 0 (oTOKS) 0 (oXB) 0) (quot (+ (* M 896) 127) 128) 128)
        ly (loop [l 0]
             (if (= l 24) 0
               (let [r1 (disp f R en C 10 (vector-i64 (lw L l 0) M 896 0 0 (oXB) (oOB) eps) (quot (+ M 7) 8) 256)
                     g1 (disp f R en C 11 (vector-i64 (lw L l 1) (lw L l 2) (lw L l 3) (lw L l 4) (lw L l 5) (lw L l 6)
                                                     896 128 128 896 (oOB) 896 (oQKV) 1152 1 M 18 0) (* 18 tm) 128)
                     rk (disp f R en C 5 (vector-i64 l pos0 (tmax) (oQKV) (+ (oQKV) 896) (+ (oQKV) 1024) (oKC) (oVC)
                                                    base 1152 M 0 0 0 0 0) (* M 10) 64)
                     at (disp f R en C 15 (vector-i64 l 7 (+ pos0 1) (tmax) (oQKV) (oOB) (oKC) (oVC) 1152 896 M 0 0 0 0 0) (* (quot (+ M 7) 8) 14) 128)
                     g2 (disp f R en C 11 (vector-i64 (lw L l 7) 0 0 0 0 0 896 0 0 896 (oOB) 896 (oXB) 896 2 M 14 0) (* 14 tm) 128)
                     r2 (disp f R en C 10 (vector-i64 (lw L l 8) M 896 0 0 (oXB) (oOB) eps) (quot (+ M 7) 8) 256)
                     g3 (disp f R en C 11 (vector-i64 (lw L l 9) 0 (lw L l 10) 0 0 0 4864 4864 0 896 (oOB) 896 (oGU) 9728 0
                                                     M 152 0) (* 152 tm) 128)
                     sw (disp f R en C 13 (vector-i64 0 M 4864 0 0 (oGU) 9728 0) (quot (+ (* M 4864) 255) 256) 256)
                     g4 (disp f R en C 11 (vector-i64 (lw L l 11) 0 0 0 0 0 896 0 0 4864 (oGU) 9728 (oXB) 896 2 M 14 0) (* 14 tm) 128)]
                 (recur (+ l 1)))))
        f2 (disp f R en C 4 (vector-i64 (vector-at L 288) 0 0 0 0 0 (vector-at L 289) eps (+ (oXB) (* (- M 1) 896)) lg
                                       896 151936 0 0 0 0) 18992 64)
        f3 (disp f R en C 3 (vector-i64 0 0 151936 0 (+ pos0 (- M 1)) lg (oTOK) (oLOG)) 1 1024)
        z0 (msg f R en "endEncoding" 0 0 0)
        z1 (msg f R cb "commit" 0 0 0)
        tb (cc f (vector-at C 16) 0 0 0 0 0)
        acc (vector-at C 15)
        k0 (poke f acc (+ (peek f acc) (- tb ta)))]
    cb))

;; one dispatch in its own command buffer, waited (the logits comparison of the check mode)
(defn- one! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 C :vector-i64 k :i64 pv :vector-i64 gx :i64 tx :i64] :i64
  (let [ms (vector-at R 0)
        cb (msg f R (vector-at C 4) "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        b0 (cc f ms en (vector-at C 14) (vector-at C 5) 0 0)
        b1 (cc f ms en (vector-at C 14) (vector-at C 6) 0 1)
        d (disp f R en C k pv gx tx)
        z0 (msg f R en "endEncoding" 0 0 0)
        z1 (msg f R cb "commit" 0 0 0)
        z2 (msg f R cb "waitUntilCompleted" 0 0 0)]
    (msg f R cb "status" 0 0 0)))

;; n synthetic prompt ids (i * 7919 + 100) mod 151000, for prefill timing
(defn- gen-ids [n :i64] :vector-i64
  (let [v (vector-alloc n)
        u (loop [i 0] (if (= i n) 0 (let [w (vector-assoc! v i (rem (+ (* i 7919) 100) 151000))] (recur (+ i 1)))))]
    v))

;; wait for one step's command buffer; returns the token it logged at pos
(defn- step-wait! [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 C :vector-i64 cb :i64 pos :i64] :i64
  (let [tb (cc f (vector-at C 16) 0 0 0 0 0)
        z2 (msg f R cb "waitUntilCompleted" 0 0 0)
        tc (cc f (vector-at C 16) 0 0 0 0 0)
        acc (vector-at C 15)
        k1 (poke f (+ acc 8) (+ (peek f (+ acc 8)) (- tc tb)))
        st (msg f R cb "status" 0 0 0)
        u (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))]
    (bit-and (peek f (+ (vector-at C 7) (* 4 (+ (oLOG) pos)))) 4294967295)))

(defn- ticks-ns [f [:fn [[:i64 :i64 :i64] :i64]] t :i64] :i64
  (let [tb (+ (scratch f) 192)
        u (cc f (sym f "mach_timebase_info") tb 0 0 0 0)
        w (peek f tb)]
    (quot (* t (bit-and w 4294967295)) (u64-shift-right w 32))))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        now (sym f "mach_absolute_time")
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        fd (cc f (sym f "open") (cstr f (vector-at R 3) "@PATH@") 0 0 0 0)
        u0 (if (< fd 0) (vector-at [0] 1) 0)
        shv (sha-verify! f R fd "@EXPECT@")
        total (cc f (sym f "lseek") fd 0 2 0 0)
        u1 (if (< total 24) (let [w (wr-text f R "refused: truncated header\n")] (vector-at [0] 1)) 0)
        hb (if (> total 67108864) 67108864 total)
        fbuf (cc f (vector-at R 3) hb 0 0 0 0)
        got (cc f (sym f "pread") fd fbuf hb 0 0)
        u2 (if (= got hb) 0 (let [w (wr-text f R "refused: short read\n")] (vector-at [0] 1)))
        m (if (= (+ (+ (+ (bit-xor (byte-at f fbuf) 71) (bit-xor (byte-at f (+ fbuf 1)) 71)) (bit-xor (byte-at f (+ fbuf 2)) 85)) (bit-xor (byte-at f (+ fbuf 3)) 70)) 0) 0 (let [w (wr-text f R "refused: bad magic\n")] (vector-at [0] 1)))
        u3 (if (= (u32le f fbuf 4) 3) 0 (let [w (wr-text f R "refused: bad version\n")] (vector-at [0] 1)))
        nt (peek f (+ fbuf 8))
        nk (peek f (+ fbuf 16))
        u4 (if (or (<= nt 0) (< nk 0)) (let [w (wr-text f R "refused: bad counts\n")] (vector-at [0] 1)) 0)
        KI (kv-index f fbuf nk hb)
        u5 (if (= (kv-u32 f R fbuf KI nk "qwen2.block_count" 4) 24) 0 (let [w (wr-text f R "refused: block_count is not 24\n")] (vector-at [0] 1)))
        u6 (if (= (kv-u32 f R fbuf KI nk "qwen2.embedding_length" 4) 896) 0 (let [w (wr-text f R "refused: embedding_length is not 896\n")] (vector-at [0] 1)))
        u7 (if (= (kv-u32 f R fbuf KI nk "qwen2.feed_forward_length" 4) 4864) 0 (let [w (wr-text f R "refused: feed_forward_length is not 4864\n")] (vector-at [0] 1)))
        u8 (if (= (kv-u32 f R fbuf KI nk "qwen2.attention.head_count" 4) 14) 0 (let [w (wr-text f R "refused: head_count is not 14\n")] (vector-at [0] 1)))
        u9 (if (= (kv-u32 f R fbuf KI nk "qwen2.attention.head_count_kv" 4) 2) 0 (let [w (wr-text f R "refused: head_count_kv is not 2\n")] (vector-at [0] 1)))
        eps (kv-u32 f R fbuf KI nk "qwen2.attention.layer_norm_rms_epsilon" 6)
        base (kv-u32 f R fbuf KI nk "qwen2.rope.freq_base" 6)
        TI (t-index f fbuf (vector-at KI (* 4 nk)) nt hb)
        tpos (vector-at TI (* 7 nt))
        r (rem tpos 32)
        dstart (if (= r 0) tpos (+ tpos (- 32 r)))
        u10 (if (> dstart total) (let [w (wr-text f R "refused: data region starts past the end of the file\n")] (vector-at [0] 1)) 0)
        dlen (- total dstart)
        L (vector-alloc 292)
        lf (loop [l 0]
             (if (= l 24) 0
               (let [p (string-concat "blk." (string-concat (string-from-i64 l) "."))
                     b (* l 12)
                     a0 (vector-assoc! L b (t-find f R fbuf TI nt (string-concat p "attn_norm.weight") 0 896 1 dlen))
                     a1 (vector-assoc! L (+ b 1) (t-find f R fbuf TI nt (string-concat p "attn_q.weight") 8 896 896 dlen))
                     a2 (vector-assoc! L (+ b 2) (t-find f R fbuf TI nt (string-concat p "attn_q.bias") 0 896 1 dlen))
                     a3 (vector-assoc! L (+ b 3) (t-find f R fbuf TI nt (string-concat p "attn_k.weight") 8 896 128 dlen))
                     a4 (vector-assoc! L (+ b 4) (t-find f R fbuf TI nt (string-concat p "attn_k.bias") 0 128 1 dlen))
                     a5 (vector-assoc! L (+ b 5) (t-find f R fbuf TI nt (string-concat p "attn_v.weight") 8 896 128 dlen))
