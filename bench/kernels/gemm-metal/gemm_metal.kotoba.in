(ns murakumo.gemm-metal (:export [main]))

;; Stage M, slice 1 (JUN-927, ADR-261106): one f16 matrix multiply C[@M@,@N@] =
;; A[@M@,@K@] . B[@K@,@N@] on the Apple GPU's matrix units (simdgroup_matrix),
;; reached from Amu selfhost through dyld exactly as the S7 slice does
;; (amu ADR 0405, profile amu-program-metal). The kernel is MSL text in a Kotoba
;; string. A and B are small integers (-64..63) stored as half; every product and
;; partial sum is an integer float32 holds exactly, so the answer does not depend on
;; the order the matrix units add in and must equal gemm.c bit for bit.
;; The first run is folded into the checksum; @REPS@ further runs are timed.
;; Needs M and N multiples of 64 and K a multiple of 8.

(defn- mm [] :i64 @M@)
(defn- kk [] :i64 @K@)
(defn- nn [] :i64 @N@)
(defn- reps [] :i64 @REPS@)
(defn- mask48 [] :i64 281474976710655)

(defn- kernel-source [] :string
  "#include <metal_stdlib>
#include <metal_simdgroup_matrix>
using namespace metal;
constant uint KK = @K@u;
constant uint NN = @N@u;
kernel void to_half(device const short *S [[buffer(0)]],
                    device half *H [[buffer(1)]],
                    uint i [[thread_position_in_grid]]) {
  H[i] = half(S[i]);
}
kernel void gemm(device const half *A [[buffer(0)]],
                 device const half *B [[buffer(1)]],
                 device float *C [[buffer(2)]],
                 uint2 tg [[threadgroup_position_in_grid]],
                 uint sg [[simdgroup_index_in_threadgroup]]) {
  uint row0 = tg.y * 64u + (sg / 2u) * 32u;
  uint col0 = tg.x * 64u + (sg % 2u) * 32u;
  simdgroup_float8x8 acc[4][4];
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      acc[i][j] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
  for (uint k = 0u; k < KK; k += 8u) {
    simdgroup_half8x8 a[4];
    simdgroup_half8x8 b[4];
    for (uint i = 0u; i < 4u; i++)
      simdgroup_load(a[i], A + (row0 + i * 8u) * KK + k, KK);
    for (uint j = 0u; j < 4u; j++)
      simdgroup_load(b[j], B + k * NN + col0 + j * 8u, NN);
    for (uint i = 0u; i < 4u; i++)
      for (uint j = 0u; j < 4u; j++)
        simdgroup_multiply_accumulate(acc[i][j], a[i], b[j], acc[i][j]);
  }
  for (uint i = 0u; i < 4u; i++)
    for (uint j = 0u; j < 4u; j++)
      simdgroup_store(acc[i][j], C + (row0 + i * 8u) * NN + col0 + j * 8u, NN);
}
")

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        strlen (sym f "strlen")
        n (cc f strlen t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

(defn- lcg [s :i64] :i64
  (bit-and (+ (* s 1103515245) 12345) 2147483647))

;; n signed 16-bit values (LCG draw & 127, minus 64), four per word, as shorts.
(defn- fill-shorts [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 s seed]
    (if (>= i n) s
      (let [s0 (lcg s) s1 (lcg s0) s2 (lcg s1) s3 (lcg s2)
            v0 (bit-and (- (bit-and (i64-shift-right s0 8) 127) 64) 65535)
            v1 (bit-and (- (bit-and (i64-shift-right s1 8) 127) 64) 65535)
            v2 (bit-and (- (bit-and (i64-shift-right s2 8) 127) 64) 65535)
            v3 (bit-and (- (bit-and (i64-shift-right s3 8) 127) 64) 65535)
            w (bit-or (bit-or v0 (i64-shift-left v1 16)) (bit-or (i64-shift-left v2 32) (i64-shift-left v3 48)))
            u (poke f (+ p (* i 2)) w)]
        (recur (+ i 4) s3)))))

(defn- new-buffer [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 device :i64 n :i64] :i64
  (let [b (msg f R device "newBufferWithLength:options:" n 0 0)]
    (if (= b 0) (vector-at [0] 1) b)))
(defn- contents [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 b :i64] :i64
  (msg f R b "contents" 0 0 0))

;; one dispatch. by-groups = 1: (gx,gy,1) threadgroups of tx threads;
;; by-groups = 0: gx threads in total, tx per threadgroup.
(defn- run-once [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pso :i64 B :vector-i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        u6 (msg f R en "setComputePipelineState:" pso 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))
        u8 (if (= by-groups 1)
             (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
             (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))
        u9 (msg f R en "endEncoding" 0 0 0)
        u10 (msg f R cb "commit" 0 0 0)
        u11 (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

;; fold the float32 bit patterns of C, two per word, row-major
(defn- fold-c [f [:fn [[:i64 :i64 :i64] :i64]] out :i64 n :i64 c0 :i64] :i64
  (loop [i 0 c c0]
    (if (>= i n) c
      (let [w (peek f (+ out (* i 4)))
            lo (bit-and w 4294967295)
            hi (u64-shift-right w 32)]
        (recur (+ i 2) (bit-and (+ (* (bit-and (+ (* c 31) lo) (mask48)) 31) hi) (mask48)))))))

(defn- report [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 best :i64 total :i64] :i64
  (let [base (scratch f)
        tb (+ base 192)
        u (cc f (sym f "mach_timebase_info") tb 0 0 0 0)
        w (peek f tb)
        numer (bit-and w 4294967295)
        denom (u64-shift-right w 32)
        text (string-concat "metal-dispatch-ns best " (string-concat (string-from-i64 (quot (* best numer) denom))
             (string-concat " total " (string-concat (string-from-i64 (quot (* total numer) denom)) "\n"))))
        p (cstr f (vector-at R 3) text)]
    (cc f (sym f "write") 2 p (string-length text) 0 0)))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        now (sym f "mach_absolute_time")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        queue (msg f R dev "newCommandQueue" 0 0 0)
        base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        lib (msg f R dev "newLibraryWithSource:options:error:" (nsstring f R (kernel-source)) 0 errp)
        u1 (if (= lib 0) (refuse f R (peek f errp)) 0)
        kh (msg f R lib "newFunctionWithName:" (nsstring f R "to_half") 0 0)
        kg (msg f R lib "newFunctionWithName:" (nsstring f R "gemm") 0 0)
        u2 (if (or (= kh 0) (= kg 0)) (vector-at [0] 1) 0)
        psoh (msg f R dev "newComputePipelineStateWithFunction:error:" kh errp 0)
        u3 (if (= psoh 0) (refuse f R (peek f errp)) 0)
        psog (msg f R dev "newComputePipelineStateWithFunction:error:" kg errp 0)
        u4 (if (= psog 0) (refuse f R (peek f errp)) 0)
        na (* (mm) (kk))
        nb (* (kk) (nn))
        nc (* (mm) (nn))
        sa (new-buffer f R dev (* na 2))
        sb (new-buffer f R dev (* nb 2))
        ha (new-buffer f R dev (* na 2))
        hb (new-buffer f R dev (* nb 2))
        bc (new-buffer f R dev (* nc 4))
        s1 (fill-shorts f (contents f R sa) na 12345)
        s2 (fill-shorts f (contents f R sb) nb s1)
        c0 (bit-and s2 (mask48))
        v1 (run-once f R queue psoh (vector-i64 sa ha) 0 na 1 64)
        v2 (run-once f R queue psoh (vector-i64 sb hb) 0 nb 1 64)
        G (vector-i64 ha hb bc)
        v3 (run-once f R queue psog G 1 (quot (nn) 64) (quot (mm) 64) 128)
        c1 (fold-c f (contents f R bc) nc c0)]
    (loop [i 0 best 9223372036854775807 total 0]
      (if (= i (reps))
        (let [u (report f R best total)] c1)
        (let [t0 (cc f now 0 0 0 0 0)
              u (run-once f R queue psog G 1 (quot (nn) 64) (quot (mm) 64) 128)
              t1 (cc f now 0 0 0 0 0)
              d (- t1 t0)]
          (recur (+ i 1) (if (< d best) d best) (+ total d)))))))
