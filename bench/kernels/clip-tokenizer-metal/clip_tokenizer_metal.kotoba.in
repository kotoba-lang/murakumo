(ns murakumo.clip-tokenizer-metal (:export [main]))

;; I3b, first slice (JUN-927, ADR-261106): the CLIP byte-pair tokenizer in Kotoba, on the Metal route (amu ADR 0405,
;; profile amu-program-metal: libSystem through dyld, so open / pread are ordinary C calls). It reads
;; ComfyUI's tokenizer files (vocab.json: @VOCAB@; merges.txt: @MERGES@) and a prompts file (@PROMPTS@,
;; one ASCII prompt per line), builds a hash table of the vocabulary and one of the merge ranks, and prints for each
;; prompt the token ids to stderr, space separated: <|startoftext|> (49406), the prompt's tokens, <|endoftext|> (49407),
;; truncated to 77 as the CLIP towers expect. Pre-tokenization is the CLIP regex for ASCII text: lowercase; skip
;; whitespace; the contractions 's 't 're 've 'm 'll 'd; a run of letters; one digit; a run of anything else.
;; Words are split into characters, the last one carrying </w>, and merged by lowest rank until no merge applies.
;; Not supported (refused): non-ASCII bytes, the special-token spellings inside a prompt, HTML entities, ComfyUI's
;; prompt weighting and embeddings syntax. Vocabulary entries with non-ASCII keys are skipped (no ASCII prompt needs them).

(defn- hsize [] :i64 131072)
(defn- psize [] :i64 262144)

(defn- byte-at [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (bit-and (peek f p) 255))

;; read the whole file at path into a fresh malloc'd buffer (NUL padded); returns the address, size in sz[0]
(defn- slurp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 path :string sz :vector-i64] :i64
  (let [fd (cc f (sym f "open") (cstr f (vector-at R 3) path) 0 0 0 0)
        u0 (if (< fd 0) (vector-at [0] 1) 0)
        total (cc f (sym f "lseek") fd 0 2 0 0)
        buf (cc f (vector-at R 3) (+ total 16) 0 0 0 0)
        got (cc f (sym f "pread") fd buf total 0 0)
        u1 (if (= got total) 0 (vector-at [0] 1))
        z (loop [i 0] (if (= i 16) 0 (let [u (poke8 f (+ buf (+ total i)) 0)] (recur (+ i 1)))))
        s (vector-assoc! sz 0 total)]
    buf))

(defn- fnv [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (loop [i 0 h 2166136261]
    (if (= i n) h
      (recur (+ i 1) (bit-and (* (bit-xor h (byte-at f (+ p i))) 16777619) 4294967295)))))

(defn- bytes-eq [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 q :i64 n :i64] :i64
  (loop [i 0]
    (if (= i n) 1
      (if (= (byte-at f (+ p i)) (byte-at f (+ q i))) (recur (+ i 1)) 0))))

;; vocabulary table: slot s holds [arena offset + 1 (0 = empty), length, id] at VT[3s..3s+2]; keys live in the arena
(defn- vt-find [f [:fn [[:i64 :i64 :i64] :i64]] VT :vector-i64 arena :i64 p :i64 n :i64] :i64
  (let [mask (- (hsize) 1)]
    (loop [s (bit-and (fnv f p n) mask)]
      (let [off (vector-at VT (* s 3))]
        (if (= off 0) -1
          (if (and (= (vector-at VT (+ (* s 3) 1)) n) (= (bytes-eq f p (+ arena (- off 1)) n) 1))
            (vector-at VT (+ (* s 3) 2))
            (recur (bit-and (+ s 1) mask))))))))

;; insert the key at p (n bytes) with id; its bytes are copied to the arena at st[0]
(defn- vt-insert [f [:fn [[:i64 :i64 :i64] :i64]] VT :vector-i64 arena :i64 st :vector-i64 p :i64 n :i64 id :i64] :i64
  (let [mask (- (hsize) 1)
        top (vector-at st 0)
        c (loop [i 0] (if (= i n) 0 (let [u (poke8 f (+ arena (+ top i)) (byte-at f (+ p i)))] (recur (+ i 1)))))
        s0 (bit-and (fnv f p n) mask)
        s (loop [s s0] (if (= (vector-at VT (* s 3)) 0) s (recur (bit-and (+ s 1) mask))))
        a (vector-assoc! VT (* s 3) (+ top 1))
        b (vector-assoc! VT (+ (* s 3) 1) n)
        d (vector-assoc! VT (+ (* s 3) 2) id)
        e (vector-assoc! st 0 (+ top n))]
    0))

;; decode the JSON string whose content starts at p+i into the scratch area at tmp; returns the index after the
;; closing quote, with the decoded length in out[0] and 1 in out[1] if it held an escape this reader does not decode
(defn- json-string [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 tmp :i64 out :vector-i64] :i64
  (loop [j i k 0 bad 0]
    (let [c (byte-at f (+ p j))]
      (cond
        (= c 34) (let [a (vector-assoc! out 0 k) b (vector-assoc! out 1 bad)] (+ j 1))
        (= c 92)
        (let [d (byte-at f (+ p (+ j 1)))]
          (cond
            (= d 34) (let [u (poke8 f (+ tmp k) 34)] (recur (+ j 2) (+ k 1) bad))
            (= d 92) (let [u (poke8 f (+ tmp k) 92)] (recur (+ j 2) (+ k 1) bad))
            (= d 117) (recur (+ j 6) k 1)
            :else (recur (+ j 2) k 1)))
        :else (let [u (poke8 f (+ tmp k) c)] (recur (+ j 1) (+ k 1) bad))))))

(defn- parse-uint [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 out :vector-i64] :i64
  (let [s (loop [j i] (if (= (byte-at f (+ p j)) 32) (recur (+ j 1)) j))]
    (loop [j s v 0]
      (let [b (byte-at f (+ p j))]
        (if (and (>= b 48) (<= b 57))
          (recur (+ j 1) (+ (* v 10) (- b 48)))
          (let [u (vector-assoc! out 0 v)] j))))))

;; vocab.json: {"key": id, ...}
(defn- load-vocab [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 VT :vector-i64 arena :i64 st :vector-i64 tmp :i64] :i64
  (let [out (vector-alloc 2)
        num (vector-alloc 1)]
    (loop [j 0 count 0]
      (if (>= j n) count
        (if (= (byte-at f (+ p j)) 34)
          (let [e (json-string f p (+ j 1) tmp out)
                len (vector-at out 0)
                bad (vector-at out 1)
                colon (loop [q e] (if (= (byte-at f (+ p q)) 58) q (recur (+ q 1))))
                e2 (parse-uint f p (+ colon 1) num)
                u (if (= bad 0) (vt-insert f VT arena st tmp len (vector-at num 0)) 0)]
            (recur e2 (if (= bad 0) (+ count 1) count)))
          (recur (+ j 1) count))))))

;; merge-rank table: slot s holds [key + 1 (0 = empty), rank] at PT[2s..2s+1], key = idA * 65536 + idB
(defn- pt-find [PT :vector-i64 key :i64] :i64
  (let [mask (- (psize) 1)]
    (loop [s (bit-and (* key 2654435761) mask)]
      (let [k (vector-at PT (* s 2))]
        (if (= k 0) -1
          (if (= k (+ key 1)) (vector-at PT (+ (* s 2) 1))
            (recur (bit-and (+ s 1) mask))))))))

(defn- pt-insert [PT :vector-i64 key :i64 rank :i64] :i64
  (let [mask (- (psize) 1)
        s (loop [s (bit-and (* key 2654435761) mask)]
            (if (= (vector-at PT (* s 2)) 0) s (recur (bit-and (+ s 1) mask))))
        a (vector-assoc! PT (* s 2) (+ key 1))
        b (vector-assoc! PT (+ (* s 2) 1) rank)]
    0))

;; merges.txt: a header line, then "a b" per line, rank = line number after the header
(defn- load-merges [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 VT :vector-i64 arena :i64 PT :vector-i64] :i64
  (let [first (loop [j 0] (if (= (byte-at f (+ p j)) 10) (+ j 1) (recur (+ j 1))))]
    (loop [j first rank 0 stored 0]
      (if (>= j n) stored
        (let [le (loop [q j] (if (or (= (byte-at f (+ p q)) 10) (>= q n)) q (recur (+ q 1))))
              sp (loop [q j] (if (or (= (byte-at f (+ p q)) 32) (>= q le)) q (recur (+ q 1))))
              ia (vt-find f VT arena (+ p j) (- sp j))
              ib (vt-find f VT arena (+ p (+ sp 1)) (- le (+ sp 1)))
              ok (if (and (>= ia 0) (>= ib 0)) 1 0)
              u (if (= ok 1) (pt-insert PT (+ (* ia 65536) ib) rank) 0)]
          (recur (+ le 1) (+ rank 1) (+ stored ok)))))))
;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))


(defn- refuse-text [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (let [p (cstr f (vector-at R 3) s)
        w (cc f (sym f "write") 2 p (string-length s) 0 0)]
    (vector-at [0] 1)))

;; BPE of the word at w (n bytes, lowercase), with "</w>" appended to the buffer; appends its ids to OUT (count in OUT[0])
(defn- bpe-word [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 VT :vector-i64 arena :i64 PT :vector-i64 w :i64 nb :i64 n :i64
                 OFF :vector-i64 SS :vector-i64 SE :vector-i64 SI :vector-i64 OUT :vector-i64] :i64
  (let [u0 (if (> nb 400) (refuse-text f R "refused: a word longer than 400 bytes\n") 0)
        s0 (poke8 f (+ w nb) 60) s1 (poke8 f (+ w (+ nb 1)) 47) s2 (poke8 f (+ w (+ nb 2)) 119) s3 (poke8 f (+ w (+ nb 3)) 62)
        init (loop [i 0]
               (if (= i n) 0
                 (let [st (vector-at OFF i)
                       en (if (= i (- n 1)) (+ nb 4) (vector-at OFF (+ i 1)))
                       id (vt-find f VT arena (+ w st) (- en st))
                       u (if (< id 0) (refuse-text f R "refused: a symbol missing from the vocabulary\n") 0)
                       a (vector-assoc! SS i st) b (vector-assoc! SE i en) c (vector-assoc! SI i id)]
                   (recur (+ i 1)))))
        m (loop [m n]
            (let [best (loop [i 0 br 2147483647 bi -1]
                         (if (>= i (- m 1)) bi
                           (let [r (pt-find PT (+ (* (vector-at SI i) 65536) (vector-at SI (+ i 1))))]
                             (if (and (>= r 0) (< r br)) (recur (+ i 1) r i) (recur (+ i 1) br bi)))))]
              (if (< best 0) m
                (let [ia (vector-at SI best)
                      ib (vector-at SI (+ best 1))
                      m2 (loop [i 0 k 0]
                           (if (>= i m) k
                             (if (and (< i (- m 1)) (and (= (vector-at SI i) ia) (= (vector-at SI (+ i 1)) ib)))
                               (let [st (vector-at SS i)
                                     en (vector-at SE (+ i 1))
                                     id (vt-find f VT arena (+ w st) (- en st))
                                     u (if (< id 0) (refuse-text f R "refused: a merged symbol missing from the vocabulary\n") 0)
                                     a (vector-assoc! SS k st) b (vector-assoc! SE k en) c (vector-assoc! SI k id)]
                                 (recur (+ i 2) (+ k 1)))
                               (let [a (vector-assoc! SS k (vector-at SS i)) b (vector-assoc! SE k (vector-at SE i)) c (vector-assoc! SI k (vector-at SI i))]
                                 (recur (+ i 1) (+ k 1))))))]
                  (recur m2)))))
        out (loop [i 0 c (vector-at OUT 0)]
              (if (= i m) (vector-assoc! OUT 0 c)
                (let [u (vector-assoc! OUT (+ 1 c) (vector-at SI i))] (recur (+ i 1) (+ c 1)))))]
    0))

(defn- within [c :i64 a :i64 b :i64] :bool (and (>= c a) (<= c b)))
;; Unicode class of a code point, for the supported set only: 0 whitespace (str.isspace), 1 letter (\p{L}), 2 number (\p{N}),
;; 3 other, 4 not supported (the program refuses it rather than tokenizing it differently from the Hugging Face tokenizer). The Hugging Face
;; tokenizer NFC-normalizes first. A letter followed by one combining mark (U+0300-036F, U+3099, U+309A) is composed with the table below
;; (the same as NFC); any other use of a mark, and the singleton / exclusion characters U+2329, U+232A, U+2ADC, are refused. Whitespace is the
;; White_Space property (not str.isspace: U+001C-001F are not whitespace). Latin-1 and the other supported letters are NFC-stable.
(defn- cls [c :i64] :i64
  (cond
    (< c 128) (cond (or (= c 32) (within c 9 13)) 0 (or (within c 97 122) (within c 65 90)) 1 (within c 48 57) 2 :else 3)
    (or (= c 133) (or (= c 160) (or (= c 5760) (or (within c 8192 8202) (or (= c 8232) (or (= c 8233) (or (= c 8239) (or (= c 8287) (= c 12288))))))))) 0
    (< c 256) (cond (or (= c 170) (or (= c 181) (or (= c 186) (or (within c 192 214) (or (within c 216 246) (within c 248 255)))))) 1
                    (or (within c 178 179) (or (= c 185) (within c 188 190))) 2
                    :else 3)
    (within c 256 383) (if (= c 304) 4 1)
    (within c 8203 8303) 3
    (within c 8400 8447) 3
    (or (= c 9001) (or (= c 9002) (= c 10972))) 4
    (or (within c 8592 9311) (or (within c 9472 10101) (within c 10132 11263))) 3
    (within c 11776 11903) (if (= c 11823) 1 3)
    (within c 12288 12351) (cond (or (= c 12293) (or (= c 12294) (or (= c 12347) (or (= c 12348) (within c 12337 12341))))) 1
                             (or (= c 12295) (or (within c 12321 12329) (within c 12344 12346))) 2
                             :else 3)
    (within c 12352 12447) (cond (= c 12352) 3 (within c 12439 12440) 3 (within c 12441 12442) 4 (within c 12443 12444) 3 :else 1)
    (within c 12448 12543) (cond (or (= c 12448) (= c 12539)) 3 :else 1)
    (within c 12593 12686) 1
    (within c 13312 19903) 1
    (within c 19968 40959) 1
    (within c 44032 55203) 1
    (within c 65024 65039) 3
    (within c 65281 65295) 3
    (within c 65296 65305) 2
    (within c 65306 65312) 3
    (within c 65313 65338) 1
    (within c 65339 65344) 3
    (within c 65345 65370) 1
    (within c 65371 65381) 3
    (within c 65382 65439) 1
    (within c 65504 65518) 3
    (or (within c 127744 128591) (or (within c 128640 128767) (within c 129280 129535))) 3
    :else 4))
;; str.lower for the supported letters: ASCII, Latin-1, Latin Extended-A, fullwidth Latin
(defn- lcp [c :i64] :i64
  (cond
    (< c 128) (if (within c 65 90) (+ c 32) c)
    (or (within c 192 214) (within c 216 222)) (+ c 32)
    (< c 256) c
    (or (within c 256 303) (or (within c 306 311) (within c 330 375))) (if (= (bit-and c 1) 0) (+ c 1) c)
    (or (within c 313 328) (within c 377 382)) (if (= (bit-and c 1) 1) (+ c 1) c)
    (= c 376) 255
    (within c 65313 65338) (+ c 32)
    :else c))
;; mapped character of a byte (GPT-2/CLIP bytes_to_unicode)
(defn- bmap [b :i64] :i64
  (cond (or (within b 33 126) (or (within b 161 172) (within b 174 255))) b
        (<= b 32) (+ 256 b)
        (<= b 160) (+ 256 (+ 33 (- b 127)))
        :else 323))
(defn- sym-bytes [c :i64] :i64 (if (< c 128) 1 2))

;; the length, in code points, of the token starting at cp index i within [0, e): CL holds the classes, CP the lowered code points
(defn- token-len [CP :vector-i64 CL :vector-i64 i :i64 e :i64] :i64
  (let [c (vector-at CP i)
        k (vector-at CL i)
        n1 (if (< (+ i 1) e) (vector-at CP (+ i 1)) 0)
        n2 (if (< (+ i 2) e) (vector-at CP (+ i 2)) 0)]
    (cond
      (= k 5) 1
      (= c 39)
      (cond
        (or (= n1 115) (or (= n1 116) (or (= n1 109) (= n1 100)))) 2
        (or (and (= n1 114) (= n2 101)) (or (and (= n1 118) (= n2 101)) (and (= n1 108) (= n2 108)))) 3
        :else (loop [j (+ i 1)]
                (if (and (< j e) (= (vector-at CL j) 3)) (recur (+ j 1)) (- j i))))
      (= k 1)
      (loop [j (+ i 1)] (if (and (< j e) (= (vector-at CL j) 1)) (recur (+ j 1)) (- j i)))
      (= k 2) 1
      :else
      (loop [j (+ i 1)]
        (if (and (< j e) (= (vector-at CL j) 3)) (recur (+ j 1)) (- j i))))))

;; NFC for a letter followed by one combining mark (U+0300-036F, U+3099, U+309A): the entries (base << 28 | mark << 14 | composed), generated from
;; unicodedata.normalize("NFC") over the supported lower-case letters whose composition is also in the supported set
(defn- nfc-t0 [] :vector-i64
  (vector-i64 26050822368 26050838753 26050855138 26050871523 26050887937 26050920707 26050953444 26050986213 26051477765 26051870944 26051887329 26587709703 26587726089 26587808011 26587889933 26588332263 26588758279 26856325391 27124564200 27124580585 27124596970 27124629779 27124662549 27124678935 27124695275 27124760859 27125219609 27125612776 27125629161 27661467933 27661533471 27661549857 27662074147 27929903397 28198306028 28198322413 28198338798 28198355241 28198371627 28198404397 28198437103 28198961455 28199354604 28199370989 28466774325 28735815991 29003628858 29003809086 29004251452 29004677434 29540499780 29540532465 29540680008 29541122374 29541548356 29808918770 29808935155 29808951540 29808967925 29808984397))
(defn- nfc-t1 [] :vector-i64
  (vector-i64 29809017167 29809049846 29809099089 29809967346 29809983731 30614241621 30614421849 30614864215 30615290197 30882677083 30882693469 30882857313 30883299679 30883725659 31151292773 31151735139 31419531513 31419547898 31419564283 31419580777 31419597163 31419629933 31419662588 31419695471 31419711857 31420186995 31420580089 31420596474 31956435317 32493289725 32493306231 32493404415 32494338301 32761725306 32761823612 32761905534 32762773882 3317529211028 3318871388236 3319408259150 3319945130064 3320482000978 3321018871892 3321555742806 3322092613720 3322629484634 3323166355548 3323703226462 3324240097376 3324776968290 3325582274661 3326119145575 3326656016489 3328535064688 3328535081073 3329340371059 3329340387444 3330145677430 3330145693815 3330950983801))
(defn- nfc-t2 [] :vector-i64
  (vector-i64 3330951000186 3331756290172 3331756306557 3340883095710 3343299014900 3344641192108 3345178063022 3345714933936 3346251804850 3346788675764 3347325546678 3347862417592 3348399288506 3348936159420 3349473030334 3350009901248 3350546772162 3351352078533 3351888949447 3352425820361 3354304868560 3354304884945 3355110174931 3355110191316 3355915481302 3355915497687 3356720787673 3356720804058 3357526094044 3357526110429 3362894803191 3363163238648 3363431674105 3363700109562 3366652899582))
(defn- nfc-scan [T :vector-i64 key :i64] :i64
  (loop [i 0]
    (if (= i (vector-count T)) -1
      (let [e (vector-at T i)]
        (if (= (i64-shift-right e 14) key) (bit-and e 16383) (recur (+ i 1)))))))
;; the composed code point of base + mark, or -1
(defn- nfc-find [base :i64 mark :i64] :i64
  (let [key (+ (* base 16384) mark)
        a (nfc-scan (nfc-t0) key)]
    (if (>= a 0) a
      (let [b (nfc-scan (nfc-t1) key)]
        (if (>= b 0) b (nfc-scan (nfc-t2) key))))))

;; the special tokens <|startoftext|> and <|endoftext|> written in a prompt are matched case-insensitively (the Hugging Face tokenizer matches added
;; tokens on the normalized text) and stand for the ids BOS (1) / EOS (2), splitting the text around them
(defn- match-lit [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 e :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s))
        n (vector-count v)]
    (if (> (+ i n) e) 0
      (loop [k 0]
        (if (= k n) 1
          (let [b (byte-at f (+ p (+ i k)))
                l (if (within b 65 90) (+ b 32) b)]
            (if (= l (vector-at v k)) (recur (+ k 1)) 0)))))))
(defn- special-at [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 i :i64 e :i64] :i64
  (if (= (byte-at f (+ p i)) 60)
    (if (= (match-lit f p i e "<|startoftext|>") 1) 1 (if (= (match-lit f p i e "<|endoftext|>") 1) 2 0))
    0))

(defn- bad-utf8 [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64] :i64 (refuse-text f R "refused: invalid UTF-8 in a prompt\n"))
;; decode the UTF-8 sequence at p: code point * 8 + length; refuses invalid UTF-8 (overlong forms, surrogates, truncation)
(defn- utf8-at [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 i :i64 e :i64] :i64
  (let [b0 (byte-at f (+ p i))
        b1 (if (< (+ i 1) e) (byte-at f (+ p (+ i 1))) 0)
        b2 (if (< (+ i 2) e) (byte-at f (+ p (+ i 2))) 0)
        b3 (if (< (+ i 3) e) (byte-at f (+ p (+ i 3))) 0)
        d0 0]
    (cond
      (< b0 128) (+ (* b0 8) 1)
      (and (within b0 194 223) (= (bit-and b1 192) 128)) (+ (* (+ (* (bit-and b0 31) 64) (bit-and b1 63)) 8) 2)
      (and (within b0 224 239) (and (= (bit-and b1 192) 128) (= (bit-and b2 192) 128)))
      (let [c (+ (* (+ (* (bit-and b0 15) 64) (bit-and b1 63)) 64) (bit-and b2 63))]
        (if (or (< c 2048) (within c 55296 57343)) (bad-utf8 f R) (+ (* c 8) 3)))
      (and (within b0 240 244) (and (= (bit-and b1 192) 128) (and (= (bit-and b2 192) 128) (= (bit-and b3 192) 128))))
      (let [c (+ (* (+ (* (+ (* (bit-and b0 7) 64) (bit-and b1 63)) 64) (bit-and b2 63)) 64) (bit-and b3 63))]
        (if (or (< c 65536) (> c 1114111)) (bad-utf8 f R) (+ (* c 8) 4)))
      :else (bad-utf8 f R))))

;; UTF-8 of code point c at q; returns its length
(defn- utf8-put [f [:fn [[:i64 :i64 :i64] :i64]] q :i64 c :i64] :i64
  (cond
    (< c 128) (let [u (poke8 f q c)] 1)
    (< c 2048) (let [u (poke8 f q (+ 192 (i64-shift-right c 6))) v (poke8 f (+ q 1) (+ 128 (bit-and c 63)))] 2)
    (< c 65536) (let [u (poke8 f q (+ 224 (i64-shift-right c 12))) v (poke8 f (+ q 1) (+ 128 (bit-and (i64-shift-right c 6) 63))) w (poke8 f (+ q 2) (+ 128 (bit-and c 63)))] 3)
    :else (let [u (poke8 f q (+ 240 (i64-shift-right c 18))) v (poke8 f (+ q 1) (+ 128 (bit-and (i64-shift-right c 12) 63)))
                w (poke8 f (+ q 2) (+ 128 (bit-and (i64-shift-right c 6) 63))) x (poke8 f (+ q 3) (+ 128 (bit-and c 63)))] 4)))

;; the byte-level symbols of cps [a, a+len) of CP into wbuf (each byte of the UTF-8 text as its mapped character, UTF-8 encoded),
;; OFF[k] the start of symbol k; returns the byte length of wbuf's content, the symbol count goes to OFF[ns] slot via the caller
(defn- word-symbols [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 CP :vector-i64 a :i64 len :i64 wbuf :i64 tmp :i64 OFF :vector-i64] :vector-i64
  (let [nsb (loop [k 0 q 0]
              (if (= k len) q
                (recur (+ k 1) (+ q (utf8-put f (+ tmp q) (vector-at CP (+ a k)))))))
        r (loop [m 0 q 0]
            (if (= m nsb) (vector-i64 q nsb)
              (let [c (bmap (byte-at f (+ tmp m)))
                    u (vector-assoc! OFF m q)
                    nbytes (if (< c 128) 1 2)
                    w1 (if (< c 128) (poke8 f (+ wbuf q) c) (let [x (poke8 f (+ wbuf q) (+ 192 (i64-shift-right c 6)))] (poke8 f (+ wbuf (+ q 1)) (+ 128 (bit-and c 63)))))]
                (recur (+ m 1) (+ q nbytes)))))
        e (vector-assoc! OFF nsb (vector-at r 0))]
    r))

;; ---- prompt weighting (ComfyUI's escape_important / parse_parentheses / token_weights), weights as fixed point with 16 fractional bits ----
;; A prompt is cut into segments (start, end, weight): the pieces between parentheses and inside them, nested as in ComfyUI: "(x)" multiplies the
;; weight by 1.1, "(x:1.3)" sets it to 1.3. "\\(" and "\\)" are ordinary characters. Each segment is tokenized on its own (words never join across a segment).
(defn- wsent [] :i64 -4611686018427387904)
(defn- is-pyspace [b :i64] :bool (or (= b 32) (or (within b 9 13) (within b 28 31))))
;; the ASCII letters of a trimmed byte range equal to the lower-case word s (nan, inf, infinity), ignoring a sign
(defn- word-eq [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :i64 e :i64 w :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 w))
        n (vector-count v)]
    (if (= (- e s) n)
      (loop [k 0] (if (= k n) 1 (let [b (byte-at f (+ p (+ s k)))
                                      l (if (within b 65 90) (+ b 32) b)]
                                  (if (= l (vector-at v k)) (recur (+ k 1)) 0))))
      0)))
;; Python's float() of the bytes [s, e), as a fixed-point weight; wsent when it is not a number (ComfyUI then keeps 1.1 x the weight and the text)
;; and a refusal for the forms this program does not read (nan, inf, underscores, more than 12 digits, huge exponents)
(defn- parse-fp [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 s0 :i64 e0 :i64] :i64
  (let [s (loop [i s0] (if (and (< i e0) (is-pyspace (byte-at f (+ p i)))) (recur (+ i 1)) i))
        e (loop [i e0] (if (and (> i s) (is-pyspace (byte-at f (+ p (- i 1))))) (recur (- i 1)) i))
        neg (if (and (< s e) (= (byte-at f (+ p s)) 45)) 1 0)
        s1 (if (and (< s e) (or (= (byte-at f (+ p s)) 45) (= (byte-at f (+ p s)) 43))) (+ s 1) s)
        spec (if (or (= (word-eq f p s1 e "nan") 1) (or (= (word-eq f p s1 e "inf") 1) (= (word-eq f p s1 e "infinity") 1))) 1 0)
        und (if (and (> (loop [i s a 0] (if (>= i e) a (recur (+ i 1) (if (= (byte-at f (+ p i)) 95) 1 a)))) 0)
                     (= (loop [i s a 1] (if (>= i e) a (let [b (byte-at f (+ p i))] (recur (+ i 1) (if (or (within b 48 57) (or (= b 95) (or (= b 46) (or (= b 101) (or (= b 69) (or (= b 43) (= b 45))))))) a 0))))) 1))
              1 0)
        u0 (if (or (= spec 1) (= und 1)) (refuse-text f R "refused: a weight written as nan, inf or with underscores\n") 0)
        ;; digits before the point
        ie (loop [i s1] (if (and (< i e) (within (byte-at f (+ p i)) 48 57)) (recur (+ i 1)) i))
        has-dot (if (and (< ie e) (= (byte-at f (+ p ie)) 46)) 1 0)
        fs (if (= has-dot 1) (+ ie 1) ie)
        fe (loop [i fs] (if (and (< i e) (within (byte-at f (+ p i)) 48 57)) (recur (+ i 1)) i))
        nd (+ (- ie s1) (- fe fs))
        has-exp (if (and (< fe e) (or (= (byte-at f (+ p fe)) 101) (= (byte-at f (+ p fe)) 69))) 1 0)
        xs (if (= has-exp 1) (+ fe 1) fe)
        xneg (if (and (= has-exp 1) (and (< xs e) (= (byte-at f (+ p xs)) 45))) 1 0)
        xd0 (if (and (= has-exp 1) (and (< xs e) (or (= (byte-at f (+ p xs)) 45) (= (byte-at f (+ p xs)) 43)))) (+ xs 1) xs)
        xe (loop [i xd0] (if (and (< i e) (within (byte-at f (+ p i)) 48 57)) (recur (+ i 1)) i))
        ok (if (and (> nd 0) (and (= xe e) (or (= has-exp 0) (> xe xd0)))) 1 0)]
    (if (= ok 0) (wsent)
      (let [nint (- ie s1)
            nfrac (- fe fs)
            ;; the mantissa digits as one integer (at most 12 of them)
            u1 (if (> nd 12) (refuse-text f R "refused: a weight with more than 12 digits\n") 0)
            m (loop [i s1 acc 0]
                (if (>= i fe) acc
                  (let [b (byte-at f (+ p i))]
                    (if (within b 48 57) (recur (+ i 1) (+ (* acc 10) (- b 48))) (recur (+ i 1) acc)))))
            xv (loop [i xd0 acc 0] (if (>= i xe) acc (recur (+ i 1) (+ (* acc 10) (- (byte-at f (+ p i)) 48)))))
            u2 (if (> xv 30) (refuse-text f R "refused: a weight with a huge exponent\n") 0)
            dexp (- (if (= xneg 1) (- 0 xv) xv) nfrac)
            val (if (>= dexp 0)
                  (let [pw (loop [k 0 a 1] (if (= k dexp) a (recur (+ k 1) (* a 10))))
                        u3 (if (> (* m pw) 1000000) (refuse-text f R "refused: a weight above 1,000,000\n") 0)]
                    (* (* m pw) 65536))
                  (if (< dexp -18) 0
                    (let [pw (loop [k 0 a 1] (if (= k (- 0 dexp)) a (recur (+ k 1) (* a 10))))]
                      (quot (+ (* m 65536) (quot pw 2)) pw))))]
        (if (= neg 1) (- 0 val) val)))))

;; a weight times 1.1
(defn- fp-mul11 [w :i64] :i64 (quot (+ (* w 11) (if (>= w 0) 5 -5)) 10))

;; ComfyUI's parse_parentheses on [s, e): pieces (start, end, is_paren) into PCS, returns the count
(defn- find-pieces [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 s :i64 e :i64 PCS :vector-i64] :i64
  (let [r (loop [i s cur -1 level 0 lastreal 0 n 0]
            (if (>= i e)
              (if (>= cur 0)
                (let [u (vector-assoc! PCS (* n 3) cur) v (vector-assoc! PCS (+ (* n 3) 1) e)
                      w (vector-assoc! PCS (+ (* n 3) 2) (if (and (>= (- e cur) 2) (and (= (byte-at f (+ p cur)) 40) (= lastreal 1))) 1 0))]
                  (+ n 1))
                n)
              (let [b (byte-at f (+ p i))
                    nb (if (< (+ i 1) e) (byte-at f (+ p (+ i 1))) 0)
                    esc (if (and (= b 92) (or (= nb 40) (= nb 41))) 1 0)
                    w (if (= esc 1) 2 1)
                    u0 (if (> (+ n 2) 300) (refuse-text f R "refused: more than 300 weighted pieces in a prompt\n") 0)]
                (cond
                  (and (= esc 0) (= b 40))
                  (if (= level 0)
                    (if (>= cur 0)
                      (let [u (vector-assoc! PCS (* n 3) cur) v (vector-assoc! PCS (+ (* n 3) 1) i)
                            x (vector-assoc! PCS (+ (* n 3) 2) (if (and (>= (- i cur) 2) (and (= (byte-at f (+ p cur)) 40) (= lastreal 1))) 1 0))]
                        (recur (+ i 1) i 1 0 (+ n 1)))
                      (recur (+ i 1) i 1 0 n))
                    (recur (+ i 1) (if (>= cur 0) cur i) (+ level 1) 0 n))
                  (and (= esc 0) (= b 41))
                  (if (= (- level 1) 0)
                    (let [c0 (if (>= cur 0) cur i)
                          u (vector-assoc! PCS (* n 3) c0) v (vector-assoc! PCS (+ (* n 3) 1) (+ i 1))
                          x (vector-assoc! PCS (+ (* n 3) 2) (if (and (>= (+ (- i c0) 1) 2) (= (byte-at f (+ p c0)) 40)) 1 0))]
                      (recur (+ i 1) -1 0 1 (+ n 1)))
                    (recur (+ i 1) (if (>= cur 0) cur i) (- level 1) 1 n))
                  :else (recur (+ i w) (if (>= cur 0) cur i) level 0 n)))))]
    r))

;; the segments (start, end, weight) of the prompt [s, e), in order, into SEG; STK and PCS are scratch; returns the count
(defn- segments [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 p :i64 s :i64 e :i64 SEG :vector-i64 STK :vector-i64 PCS :vector-i64] :i64
  (if (= @WEIGHTS@ 0)
    (let [a (vector-assoc! SEG 0 s) b (vector-assoc! SEG 1 e) c (vector-assoc! SEG 2 65536)] 1)
  (let [u (vector-assoc! STK 0 s) v (vector-assoc! STK 1 e) w (vector-assoc! STK 2 65536) x (vector-assoc! STK 3 0)]
    (loop [sp 1 n 0]
      (if (= sp 0) n
        (let [t (* (- sp 1) 4)
              ts (vector-at STK t) te (vector-at STK (+ t 1)) tw (vector-at STK (+ t 2)) tk (vector-at STK (+ t 3))]
          (if (= tk 1)
            ;; an emit entry: the segment itself
            (let [a (vector-assoc! SEG (* n 3) ts) b (vector-assoc! SEG (+ (* n 3) 1) te) c (vector-assoc! SEG (+ (* n 3) 2) tw)
                  u0 (if (>= n 600) (refuse-text f R "refused: more than 600 segments in a prompt\n") 0)]
              (recur (- sp 1) (+ n 1)))
            ;; a parse entry: cut it into pieces and push them back to front
            (let [np (find-pieces f R p ts te PCS)
                  sp2 (loop [k (- np 1) q (- sp 1)]
                        (if (< k 0) q
                          (let [ps (vector-at PCS (* k 3)) pe (vector-at PCS (+ (* k 3) 1)) pp (vector-at PCS (+ (* k 3) 2))
                                u1 (if (>= q 395) (refuse-text f R "refused: prompt parentheses nested too deeply\n") 0)]
                            (if (= pp 1)
                              (let [is (+ ps 1) ie (- pe 1)
                                    colon (loop [i (- ie 1)] (if (< i is) -1 (if (= (byte-at f (+ p i)) 58) i (recur (- i 1)))))
                                    fp (if (> (- colon is) 0) (parse-fp f R p (+ colon 1) ie) (wsent))
                                    w2 (if (= fp (wsent)) (fp-mul11 tw) fp)
                                    e2 (if (= fp (wsent)) ie colon)
                                    a (vector-assoc! STK (* q 4) is) b (vector-assoc! STK (+ (* q 4) 1) e2)
                                    c (vector-assoc! STK (+ (* q 4) 2) w2) d (vector-assoc! STK (+ (* q 4) 3) 0)]
                                (recur (- k 1) (+ q 1)))
                              (let [a (vector-assoc! STK (* q 4) ps) b (vector-assoc! STK (+ (* q 4) 1) pe)
                                    c (vector-assoc! STK (+ (* q 4) 2) tw) d (vector-assoc! STK (+ (* q 4) 3) 1)]
                                (recur (- k 1) (+ q 1)))))))]
              (recur sp2 n)))))))))

;; the code points of the bytes [s, e) (with "\\(" and "\\)" as plain parentheses) into CP / CL / WT from index k, lower-cased, classified,
;; NFC-composed, special tokens marked; then one boundary entry (class 0) so that nothing joins across a segment; returns the new k
(defn- decode-seg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 pbuf :i64 s :i64 e :i64 CP :vector-i64 CL :vector-i64 WT :vector-i64 SGI :vector-i64 k0 :i64 w :i64 g :i64] :i64
  (let [k (loop [q s k k0]
            (if (>= q e) k
              (let [b0 (byte-at f (+ pbuf q))
                    nb (if (< (+ q 1) e) (byte-at f (+ pbuf (+ q 1))) 0)
                    esc (if (and (= @WEIGHTS@ 1) (and (= b0 92) (or (= nb 40) (= nb 41)))) 1 0)
                    d (if (= esc 1) (+ (* nb 8) 2) (utf8-at f R pbuf q e))
                    sp (if (= esc 1) 0 (special-at f pbuf q e))
                    c (if (> sp 0) (+ 2097152 sp) (lcp (i64-shift-right d 3)))
                    u0 (if (>= k 8190) (refuse-text f R "refused: a prompt line longer than 8190 characters\n") 0)
                    m (if (or (within c 768 879) (within c 12441 12442)) 1 0)
                    pc (if (and (= m 1) (> k 0)) (nfc-find (vector-at CP (- k 1)) c) -1)
                    u2 (if (and (= m 1) (< pc 0)) (refuse-text f R "refused: a combining mark that does not compose with the character before it\n") 0)
                    cl (if (> sp 0) 5 (if (= m 1) 1 (cls c)))
                    u1 (if (= cl 4) (refuse-text f R "refused: a character outside the supported set (ASCII, Latin-1, Latin Extended-A, CJK, kana, Hangul, fullwidth forms, common symbols and emoji)\n") 0)
                    k2 (if (= m 1) (- k 1) k)
                    a (vector-assoc! CP k2 (if (= m 1) pc c)) b (vector-assoc! CL k2 cl) x (vector-assoc! WT k2 w) y (vector-assoc! SGI k2 g)]
                (recur (+ q (if (> sp 0) (if (= sp 1) 15 13) (bit-and d 7))) (+ k2 1)))))
        a (vector-assoc! CP k 32) b (vector-assoc! CL k 0) x (vector-assoc! WT k 0) y (vector-assoc! SGI k g)]
    (+ k 1)))


;; ComfyUI's batching of the token groups (one group per segment) into blocks of 77: BOS, tokens, EOS, padding. A group of fewer than 8 tokens is kept
;; whole (the block is closed with EOS and padding and a new one started when it does not fit); a longer group is cut where the block is full.
;; OUT / OUTW / OUTG: the tokens, their weights and group numbers (count in OUT[0], token k at index k + 1); fills IDS / WTS (block * 77 + position)
;; for at most 4 blocks and returns the block count
(defn- batch-blocks [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 OUT :vector-i64 OUTW :vector-i64 OUTG :vector-i64 IDS :vector-i64 WTS :vector-i64
                     bos :i64 eos :i64 pad :i64] :i64
  (let [cnt (vector-at OUT 0)
        u0 (vector-assoc! IDS 0 bos) u1 (vector-assoc! WTS 0 65536)
        r (loop [p 0 c 0 len 1]
            (if (>= p cnt)
              (vector-i64 c len)
              (let [g (vector-at OUTG (+ 1 p))
                    e (loop [q p] (if (and (< q cnt) (= (vector-at OUTG (+ 1 q)) g)) (recur (+ q 1)) q))
                    st (loop [q p] (if (and (> q 0) (= (vector-at OUTG q) g)) (recur (- q 1)) q))
                    large (if (>= (- e st) 8) 1 0)
                    base (+ (* c 77) len)
                    u2 (if (>= c 3) (refuse-text f R "refused: a prompt of more than 4 blocks of 75 tokens\n") 0)]
                (if (> (+ (- e p) len) 76)
                  (let [rem (- 76 len)]
                    (if (= large 1)
                      (let [x (loop [j 0] (if (= j rem) 0 (let [a (vector-assoc! IDS (+ base j) (vector-at OUT (+ 1 (+ p j))))
                                                                b (vector-assoc! WTS (+ base j) (vector-at OUTW (+ 1 (+ p j))))] (recur (+ j 1)))))
                            a (vector-assoc! IDS (+ (* c 77) 76) eos) b (vector-assoc! WTS (+ (* c 77) 76) 65536)
                            a2 (vector-assoc! IDS (* (+ c 1) 77) bos) b2 (vector-assoc! WTS (* (+ c 1) 77) 65536)]
                        (recur (+ p rem) (+ c 1) 1))
                      (let [a (vector-assoc! IDS base eos) b (vector-assoc! WTS base 65536)
                            x (loop [j (+ len 1)] (if (>= j 77) 0 (let [a1 (vector-assoc! IDS (+ (* c 77) j) pad) b1 (vector-assoc! WTS (+ (* c 77) j) 65536)] (recur (+ j 1)))))
                            a2 (vector-assoc! IDS (* (+ c 1) 77) bos) b2 (vector-assoc! WTS (* (+ c 1) 77) 65536)]
                        (recur p (+ c 1) 1))))
                  (let [x (loop [j 0] (if (= j (- e p)) 0 (let [a (vector-assoc! IDS (+ base j) (vector-at OUT (+ 1 (+ p j))))
                                                                b (vector-assoc! WTS (+ base j) (vector-at OUTW (+ 1 (+ p j))))] (recur (+ j 1)))))]
                    (recur e c (+ len (- e p))))))))
        c (vector-at r 0)
        len (vector-at r 1)
        a (vector-assoc! IDS (+ (* c 77) len) eos) b (vector-assoc! WTS (+ (* c 77) len) 65536)
        x (loop [j (+ len 1)] (if (>= j 77) 0 (let [a1 (vector-assoc! IDS (+ (* c 77) j) pad) b1 (vector-assoc! WTS (+ (* c 77) j) 65536)] (recur (+ j 1)))))]
    (+ c 1)))

(defn- wr-num [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 v :i64] :i64
  (let [t (string-from-i64 v)
        p (cstr f (vector-at R 3) t)]
    (cc f (sym f "write") 2 p (string-length t) 0 0)))
(defn- wr-text [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (cc f (sym f "write") 2 (cstr f (vector-at R 3) s) (string-length s) 0 0))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        sz (vector-alloc 1)
        vbuf (slurp f R "@VOCAB@" sz)
        vlen (vector-at sz 0)
        mbuf (slurp f R "@MERGES@" sz)
        mlen (vector-at sz 0)
        pbuf (slurp f R "@PROMPTS@" sz)
        plen (vector-at sz 0)
        arena (cc f (vector-at R 3) 4194304 0 0 0 0)
        tmp (cc f (vector-at R 3) 4096 0 0 0 0)
        wbuf (cc f (vector-at R 3) 1024 0 0 0 0)
        VT (vector-alloc (* (hsize) 3))
        PT (vector-alloc (* (psize) 2))
        z1 (loop [i 0] (if (= i (* (hsize) 3)) 0 (let [u (vector-assoc! VT i 0)] (recur (+ i 1)))))
        z2 (loop [i 0] (if (= i (* (psize) 2)) 0 (let [u (vector-assoc! PT i 0)] (recur (+ i 1)))))
        st (vector-alloc 1)
        z3 (vector-assoc! st 0 0)
        nv (load-vocab f vbuf vlen VT arena st tmp)
        nm (load-merges f mbuf mlen VT arena PT)
        bos (vt-find f VT arena (cstr f (vector-at R 3) "<|startoftext|>") 15)
        eos (vt-find f VT arena (cstr f (vector-at R 3) "<|endoftext|>") 13)
        u0 (wr-text f R "vocab ")
        u1 (wr-num f R nv)
        u2 (wr-text f R " merges ")
        u3 (wr-num f R nm)
        u4 (wr-text f R "\n")
        SS (vector-alloc 512) SE (vector-alloc 512) SI (vector-alloc 512)
        OFF (vector-alloc 520)
        CP (vector-alloc 8192) CL (vector-alloc 8192)
        tmpw (cc f (vector-at R 3) 1024 0 0 0 0)
        OUT (vector-alloc 4096) OUTW (vector-alloc 4096) OUTG (vector-alloc 4096) SGI (vector-alloc 8192) IDS (vector-alloc 320) WTS (vector-alloc 320)
        SEG (vector-alloc 1840) STK (vector-alloc 1600) PCS (vector-alloc 920) WT (vector-alloc 8192)]
    ;; one output line per prompt line
    (loop [ls 0]
      (if (>= ls plen) 0
        (let [le (loop [q ls] (if (or (>= q plen) (= (byte-at f (+ pbuf q)) 10)) q (recur (+ q 1))))
              u (vector-assoc! OUT 0 0)
              nseg (segments f R pbuf ls le SEG STK PCS)
              ncp (loop [g 0 k 0]
                    (if (= g nseg) k
                      (recur (+ g 1) (decode-seg f R pbuf (vector-at SEG (* g 3)) (vector-at SEG (+ (* g 3) 1)) CP CL WT SGI k (vector-at SEG (+ (* g 3) 2)) g))))
              walk (loop [i 0]
                     (if (>= i ncp) 0
                       (if (= (vector-at CL i) 0) (recur (+ i 1))
                         (if (= (vector-at CL i) 5)
                           (let [cc (vector-at OUT 0) u (vector-assoc! OUT (+ 1 cc) (if (= (vector-at CP i) 2097153) bos eos))
                                 ww (vector-assoc! OUTW (+ 1 cc) (vector-at WT i)) gg (vector-assoc! OUTG (+ 1 cc) (vector-at SGI i)) v (vector-assoc! OUT 0 (+ cc 1))]
                             (recur (+ i 1)))
                           (let [n (token-len CP CL i ncp)
                                 r (word-symbols f R CP i n wbuf tmpw OFF)
                                 c0 (vector-at OUT 0)
                                 b (bpe-word f R VT arena PT wbuf (vector-at r 0) (vector-at r 1) OFF SS SE SI OUT)
                                 c1 (vector-at OUT 0)
                                 ws (loop [j c0] (if (>= j c1) 0 (let [x (vector-assoc! OUTW (+ 1 j) (vector-at WT i)) y (vector-assoc! OUTG (+ 1 j) (vector-at SGI i))] (recur (+ j 1)))))]
                             (recur (+ i n)))))))
              cnt (vector-at OUT 0)
              nb (batch-blocks f R OUT OUTW OUTG IDS WTS bos eos eos)
              keep (if (> cnt 75) 75 cnt)
              pr (if (= @BLOCKS@ 1)
                   (loop [b 0]
                     (if (= b nb) 0
                       (let [a (loop [k 0] (if (= k 77) 0 (let [x (if (= k 0) 0 (wr-text f R " ")) y (wr-num f R (vector-at IDS (+ (* b 77) k)))] (recur (+ k 1)))))
                             a1 (wr-text f R "\n")
                             w1 (if (= @WLINES@ 1)
                                  (let [c (wr-text f R "w")
                                        d (loop [k 0] (if (= k 77) 0 (let [x (wr-text f R " ") y (wr-num f R (vector-at WTS (+ (* b 77) k)))] (recur (+ k 1)))))
                                        e (wr-text f R "\n")]
                                    0)
                                  0)]
                         (recur (+ b 1)))))
                   (let [p0 (wr-num f R bos)
                         p1 (loop [k 0] (if (= k keep) 0 (let [a (wr-text f R " ") b (wr-num f R (vector-at OUT (+ 1 k)))] (recur (+ k 1)))))
                         p2 (wr-text f R " ")
                         p3 (wr-num f R eos)
                         p4 (wr-text f R "\n")
                         pw (if (= @WLINES@ 1)
                              (let [a (wr-text f R "w")
                                    b (loop [k 0] (if (= k keep) 0 (let [x (wr-text f R " ") y (wr-num f R (vector-at OUTW (+ 1 k)))] (recur (+ k 1)))))
                                    c (wr-text f R "\n")]
                                0)
                              0)]
                     0))]
          (recur (+ le 1)))))))
