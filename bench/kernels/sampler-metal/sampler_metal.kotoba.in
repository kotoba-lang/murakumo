(ns murakumo.sampler-metal (:export [main]))

;; Stage M, slice 14 (JUN-927, ADR-261106): the sampling loop of an SDXL render on the Apple GPU, reached from
;; Amu selfhost through dyld (amu ADR 0405, profile amu-program-metal). What it contains, and what it does not:
;;   - the discrete sigma table of ModelSamplingDiscrete (scaled-linear betas 0.00085 .. 0.012, 1000 steps) made on the GPU,
;;   - ComfyUI's "simple" scheduler picking @STEPS@ sigmas from it (plus the final 0),
;;   - for each step: EPS input scaling x / sqrt(sigma^2 + 1), two stand-in "model" calls (toy elementwise eps functions, NOT a UNet),
;;     classifier-free guidance on the denoised values (uncond + cfg * (cond - uncond), cfg = 7.5) and the Euler update.
;; Output to stderr, raw: the 1000 sigmas, the 32-float schedule slot, the N final latent floats.

(defn- kernel-source [] :string
  "#include <metal_stdlib>
using namespace metal;
kernel void to_x(device const short *S [[buffer(0)]], device float *X [[buffer(1)]], uint i [[thread_position_in_grid]]) {
  X[i] = (float(S[i]) / 64.0f) * 14.0f;
}
kernel void sigma_table(device float *ST [[buffer(0)]], uint i [[thread_position_in_grid]]) {
  if (i != 0u) return;
  float a = precise::sqrt(0.00085f);
  float b = precise::sqrt(0.012f);
  float ac = 1.0f;
  for (uint j = 0u; j < 1000u; j++) {
    float rt = a + (b - a) * (float(j) / 999.0f);
    float beta = rt * rt;
    ac = ac * (1.0f - beta);
    ST[j] = precise::sqrt((1.0f - ac) / ac);
  }
}
kernel void gather(device const float *ST [[buffer(0)]], device float *SG [[buffer(1)]], device const uint *P [[buffer(2)]], uint i [[thread_position_in_grid]]) {
  uint steps = P[1];
  if (i > steps) return;
  if (i == steps) { SG[i] = 0.0f; return; }
  uint idx = (i * 1000u) / steps;
  SG[i] = ST[999u - idx];
}
kernel void scale_in(device const float *X [[buffer(0)]], device float *XIN [[buffer(1)]], device const float *SG [[buffer(2)]], device const uint *P [[buffer(3)]], uint i [[thread_position_in_grid]]) {
  float s = SG[P[0]];
  XIN[i] = X[i] / precise::sqrt(s * s + 1.0f);
}
kernel void eps_u(device const float *XIN [[buffer(0)]], device float *EU [[buffer(1)]], uint i [[thread_position_in_grid]]) {
  EU[i] = 0.5f * XIN[i];
}
kernel void eps_c(device const float *XIN [[buffer(0)]], device float *EC [[buffer(1)]], uint i [[thread_position_in_grid]]) {
  float x = XIN[i];
  EC[i] = 0.5f * x + (0.25f * x) / (1.0f + x * x);
}
kernel void cfg_euler(device float *X [[buffer(0)]], device const float *EU [[buffer(1)]], device const float *EC [[buffer(2)]], device const float *SG [[buffer(3)]],
                      device const uint *P [[buffer(4)]], uint i [[thread_position_in_grid]]) {
  float s = SG[P[0]];
  float sn = SG[P[0] + 1u];
  float cfg = as_type<float>(P[2]);
  float x = X[i];
  float du = x - s * EU[i];
  float dc = x - s * EC[i];
  float den = du + (dc - du) * cfg;
  float d = (x - den) / s;
  X[i] = x + d * (sn - s);
}
")

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        strlen (sym f "strlen")
        n (cc f strlen t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

(defn- lcg [s :i64] :i64
  (bit-and (+ (* s 1103515245) 12345) 2147483647))

;; n signed 16-bit values (LCG draw & 127, minus 64), four per word, as shorts.
(defn- fill-shorts [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 s seed]
    (if (>= i n) s
      (let [s0 (lcg s) s1 (lcg s0) s2 (lcg s1) s3 (lcg s2)
            v0 (bit-and (- (bit-and (i64-shift-right s0 8) 127) 64) 65535)
            v1 (bit-and (- (bit-and (i64-shift-right s1 8) 127) 64) 65535)
            v2 (bit-and (- (bit-and (i64-shift-right s2 8) 127) 64) 65535)
            v3 (bit-and (- (bit-and (i64-shift-right s3 8) 127) 64) 65535)
            w (bit-or (bit-or v0 (i64-shift-left v1 16)) (bit-or (i64-shift-left v2 32) (i64-shift-left v3 48)))
            u (poke f (+ p (* i 2)) w)]
        (recur (+ i 4) s3)))))

(defn- new-buffer [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 device :i64 n :i64] :i64
  (let [b (msg f R device "newBufferWithLength:options:" n 0 0)]
    (if (= b 0) (vector-at [0] 1) b)))
(defn- contents [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 b :i64] :i64
  (msg f R b "contents" 0 0 0))

;; one dispatch. by-groups = 1: (gx,gy,1) threadgroups of tx threads;
;; by-groups = 0: gx threads in total, tx per threadgroup.
(defn- run-once [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pso :i64 B :vector-i64 by-groups :i64 gx :i64 gy :i64 tx :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid gx) u1 (poke f (+ grid 8) gy) u2 (poke f (+ grid 16) 1)
        u3 (poke f group tx) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        u6 (msg f R en "setComputePipelineState:" pso 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))
        u8 (if (= by-groups 1)
             (msg f R en "dispatchThreadgroups:threadsPerThreadgroup:" grid group 0)
             (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0))
        u9 (msg f R en "endEncoding" 0 0 0)
        u10 (msg f R cb "commit" 0 0 0)
        u11 (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

;; the raw bytes at p, n of them, to stderr
(defn- dump [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64] :i64
  (let [w (sym f "write")]
    (loop [off 0]
      (if (>= off n) 0
        (let [r (cc f w 2 (+ p off) (- n off) 0 0)]
          (if (<= r 0) (vector-at [0] 1) (recur (+ off r))))))))


(defn- mkpso [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 dev :i64 lib :i64 name :string] :i64
  (let [base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        fn (msg f R lib "newFunctionWithName:" (nsstring f R name) 0 0)
        u1 (if (= fn 0) (vector-at [0] 1) 0)
        p (msg f R dev "newComputePipelineStateWithFunction:error:" fn errp 0)
        u2 (if (= p 0) (refuse f R (peek f errp)) 0)]
    p))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        queue (msg f R dev "newCommandQueue" 0 0 0)
        base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        lib (msg f R dev "newLibraryWithSource:options:error:" (nsstring f R (kernel-source)) 0 errp)
        u1 (if (= lib 0) (refuse f R (peek f errp)) 0)
        pto (mkpso f R dev lib "to_x")
        pst (mkpso f R dev lib "sigma_table")
        pga (mkpso f R dev lib "gather")
        psc (mkpso f R dev lib "scale_in")
        peu (mkpso f R dev lib "eps_u")
        pec (mkpso f R dev lib "eps_c")
        pce (mkpso f R dev lib "cfg_euler")
        n @N@
        steps @STEPS@
        sh (new-buffer f R dev (* n 2))
        bx (new-buffer f R dev (* n 4))
        bxin (new-buffer f R dev (* n 4))
        beu (new-buffer f R dev (* n 4))
        bec (new-buffer f R dev (* n 4))
        bst (new-buffer f R dev 4096)
        bsg (new-buffer f R dev 128)
        bp (new-buffer f R dev 16)
        s1 (fill-shorts f (contents f R sh) n 12345)
        pp (contents f R bp)
        u2 (poke f pp (bit-or 0 (i64-shift-left steps 32)))
        u3 (poke f (+ pp 8) 1089470464)
        v1 (run-once f R queue pto (vector-i64 sh bx) 0 n 1 64)
        v2 (run-once f R queue pst (vector-i64 bst) 0 1 1 1)
        v3 (run-once f R queue pga (vector-i64 bst bsg bp) 0 32 1 32)
        w (loop [i 0]
            (if (= i steps) 0
              (let [q (poke f pp (bit-or i (i64-shift-left steps 32)))
                    a (run-once f R queue psc (vector-i64 bx bxin bsg bp) 0 n 1 64)
                    b (run-once f R queue peu (vector-i64 bxin beu) 0 n 1 64)
                    c (run-once f R queue pec (vector-i64 bxin bec) 0 n 1 64)
                    d (run-once f R queue pce (vector-i64 bx beu bec bsg bp) 0 n 1 64)]
                (recur (+ i 1)))))
        w1 (dump f (contents f R bst) 4000)
        w2 (dump f (contents f R bsg) 128)
        w3 (dump f (contents f R bx) (* n 4))]
    0))
