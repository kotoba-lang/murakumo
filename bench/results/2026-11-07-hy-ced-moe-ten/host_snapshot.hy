(import datetime json pathlib platform shutil socket subprocess)
(defn run [args] (.strip (. (subprocess.run args :capture_output True :text True :check True) stdout)))
(setv ps (run ["ps" "-axo" "pid,rss,%cpu,comm"])
      commands (run ["ps" "-axo" "pid,rss,%cpu,args"])
      owned (lfor line (.splitlines commands) :if (or (in "fleet_train.hy" line) (in "verify_fleet_artifacts.hy" line)) line)
      servers (lfor line (.splitlines ps) :if (in "llama-server" line) line)
      disk (shutil.disk_usage "."))
(print (json.dumps {"utc" (.isoformat (datetime.datetime.now datetime.timezone.utc))
 "host" (socket.gethostname) "platform" (platform.platform)
 "memory_pressure" (run ["memory_pressure" "-Q"])
 "swap" (run ["sysctl" "vm.swapusage"])
 "iostat" (run ["iostat" "-Id" "disk0"])
 "disk_free_bytes" disk.free "inference_processes_retained" servers
 "owned_model_processes" owned} :indent 2))
