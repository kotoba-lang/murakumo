(ns murakumo.infer.image-native
  "Pinned Qwen Image 2.1 GGUF execution through sd.cpp. No shell sees prompts."
  (:require ["node:fs" :as fs] ["node:path" :as path] ["node:child_process" :as cp]))

(def model-id "qwen-image-2.1-uncensored")
(def runtime-revision "3f8527a46c54ecf4cb4ed6003da8e8982283c73c")
(def artifacts
  [{:file "qwen-image-2.1-UC-Q4_K_M.gguf"
    :repo "abenzerps/Qwen-Image-2.1-Uncensored-GGUF" :revision "6b34e59458d3eb7ba6a6f86a116aed5253dc02c3"
    :sha256 "e79c8a009f2ecbdb6c70fd663d9aea9ee304a0d91f347e4169a756b8ad141b41"}
   {:file "Qwen3VL-8B-Instruct-Q4_K_M.gguf"
    :repo "Qwen/Qwen3-VL-8B-Instruct-GGUF" :revision "f982a07559d4a2f6c8744d840bf6fccab30eea96"
    :sha256 "67d1659bfe71b89d50b45a4ad1a9e5b997e5bb16ce5da66a6a6167abd569e9e2"}
   {:file "qwen_image_2.1_vae_bf16.safetensors" :remote-file "vae/qwen_image_2.1_vae_bf16.safetensors"
    :repo "abenzerps/Qwen-Image-2.1-Uncensored-GGUF" :revision "6b34e59458d3eb7ba6a6f86a116aed5253dc02c3"
    :sha256 "bb21f7473051e1ac368515dd3f2e15cd44d7a11748ee8823e1ddca3e4876b7c9"}])

(defn memory-available []
  (* 1024 (js/parseInt (or (second (re-find #"MemAvailable:\s+(\d+)" (fs/readFileSync "/proc/meminfo" "utf8"))) "0") 10)))
(defn qualified? [cfg]
  (try
    (let [marker (js->clj (js/JSON.parse (fs/readFileSync (path/join (:native-root cfg) "qualified.json") "utf8")) :keywordize-keys true)]
      (and (= model-id (:model marker)) (= runtime-revision (:runtime marker)) (= "cpu" (:backend marker))
           (= (mapv :sha256 artifacts) (:sha256 marker))
           (fs/existsSync (:sd-cli cfg))
           (every? #(fs/existsSync (path/join (:native-root cfg) "models" (:file %))) artifacts)))
    (catch :default _ false)))
(defn probe! [cfg]
  (let [qualified (qualified? cfg) free (memory-available)]
    (js/Promise.resolve
     {:name (:name cfg) :models (if qualified [model-id] []) :running (if @(:busy cfg) 1 0) :pending 0
      :memory-bytes free :ready (boolean (and qualified (not @(:busy cfg)) (>= free (:min-free cfg))))})))

(defn arguments [cfg {:keys [model input]} output]
  (let [{:keys [prompt width height steps seed]} input
        model-path #(path/join (:native-root cfg) "models" %)]
    (when-not (and (= model-id model) (string? prompt) (<= 1 (count prompt) 2000)
                   (= 512 width height) (= 25 steps) (int? seed) (<= 0 seed 2147483647))
      (throw (js/Error. "Invalid native image profile")))
    ["--diffusion-model" (model-path (:file (first artifacts)))
     "--llm" (model-path (:file (second artifacts)))
     "--vae" (model-path (:file (last artifacts)))
     "-p" prompt "-W" (str width) "-H" (str height) "--steps" (str steps)
     "--seed" (str seed) "--cfg-scale" "1" "--sampling-method" "euler"
     ;; The K16's resident text service owns Vulkan exclusively. Explicit CPU
     ;; assignments and disabled auto-fit prevent even an idle-GPU race.
     "--backend" "cpu" "--params-backend" "cpu" "--auto-fit" "off" "--fa" "-t" "4" "-o" output]))

(defn render! [cfg claim lost?]
  (let [dir (fs/mkdtempSync (path/join (:native-root cfg) "job-")) output (path/join dir "image.png")]
    (-> (js/Promise.
         (fn [resolve reject]
           (try
             (let [child (cp/spawn (:sd-cli cfg) (clj->js (arguments cfg claim output))
                                  #js {:stdio "ignore" :shell false})
                   cancelled? (atom false) kill-timer (atom nil)
                   timer (js/setInterval
                          (fn []
                            (when (and (not @cancelled?) (or @lost? (>= (js/Date.now) (:deadline claim))))
                              (reset! cancelled? true) (.kill child "SIGTERM")
                              (reset! kill-timer (js/setTimeout #(.kill child "SIGKILL") 3000)))) 1000)]
               (.once child "error" (fn [_] (js/clearInterval timer) (reject (js/Error. "Native image runtime unavailable"))))
               (.once child "close"
                      (fn [code]
                        (js/clearInterval timer) (when @kill-timer (js/clearTimeout @kill-timer))
                        (try
                          (when (or @cancelled? @lost? (not= 0 code)) (throw (js/Error. "Native image execution failed or lease expired")))
                          (let [bytes (fs/readFileSync output)]
                            (when-not (and (<= 24 (.-length bytes) 8388608)
                                           (= "89504e470d0a1a0a" (.toString (.subarray bytes 0 8) "hex"))
                                           (= 512 (.readUInt32BE bytes 16) (.readUInt32BE bytes 20)))
                              (throw (js/Error. "Invalid native image artifact")))
                            (resolve (.toString bytes "base64")))
                          (catch :default e (reject e))))))
             (catch :default e (reject e)))))
        (.finally #(fs/rmSync dir #js {:recursive true :force true})))))
