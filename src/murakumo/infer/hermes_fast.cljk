(ns murakumo.infer.hermes-fast)

(def profile-contract
  {:profile "mishima-fast"
   ;; Hermes normalizes an OpenAI-compatible custom base URL to this receipt
   ;; provider even when config.yaml names the profile provider `murakumo`.
   :provider "custom"
   :model "mishima"
   :max-prompt-tokens 8000
   :max-output-tokens 256
   :max-api-calls 1
   :fallback-providers []})

(defn prompt-tokens
  "Tokens sent as prompt, including a provider-cached prefix. Missing counters
  are unknown rather than zero: a receipt that could not measure must not pass."
  [usage]
  (let [input (:input_tokens usage)
        cached (:cache_read_tokens usage)]
    (when (and (number? input) (number? cached)
               (not (neg? input)) (not (neg? cached)))
      (+ input cached))))

(defn- failure [gate field observed expected]
  {:gate gate :field field :observed observed :expected expected})

(defn qualify
  "Apply the primary-only, one-call and prompt-ceiling gates to a Hermes usage
  receipt. `response-ok?` belongs here because a fast wrong response is not a
  serving qualification."
  ([usage response-ok?]
   (qualify profile-contract usage response-ok?))
  ([contract usage response-ok?]
   (let [pt (prompt-tokens usage)
         failures
         (cond-> []
           (nil? pt)
           (conj (failure :measured-prompt-tokens :input_tokens
                          [(:input_tokens usage) (:cache_read_tokens usage)]
                          "non-negative numeric input_tokens and cache_read_tokens"))

           (and pt (> pt (:max-prompt-tokens contract)))
           (conj (failure :prompt-ceiling :prompt-tokens pt
                          (str "<= " (:max-prompt-tokens contract))))

           (not= (:provider contract) (:provider usage))
           (conj (failure :primary-provider :provider (:provider usage)
                          (:provider contract)))

           (not= (:model contract) (:model usage))
           (conj (failure :primary-model :model (:model usage) (:model contract)))

           (not= 1 (:api_calls usage))
           (conj (failure :single-api-call :api_calls (:api_calls usage) 1))

           (not (true? (:completed usage)))
           (conj (failure :completed-turn :completed (:completed usage) true))

           (true? (:failed usage))
           (conj (failure :no-failure :failed (:failed usage) false))

           (true? (:partial usage))
           (conj (failure :no-partial-result :partial (:partial usage) false))

           (true? (:interrupted usage))
           (conj (failure :not-interrupted :interrupted (:interrupted usage) false))

           (not response-ok?)
           (conj (failure :exact-response :stdout response-ok? true)))]
     {:pass? (empty? failures)
      :prompt-tokens pt
      :failed failures})))
