(ns murakumo.infer.fleet-gateway
  "Replicated stateless entrypoints; each resident owns admission and recovery."
  (:require [murakumo.infer.resident :as r]
            [murakumo.infer.jobs :as jobs]
            [murakumo.infer.replicated-topology :as topo]
            [clojure.string :as str]
            ["node:child_process" :as cp] ["node:fs" :as fs] ["node:http" :as http] ["node:crypto" :as crypto]))

(def privacy-peer-modes #{"kagishi-ram" "ephemeral-memory"})

(defn privacy-peer-report? [report]
  (boolean (and (contains? privacy-peer-modes (:replay_mode report))
                (string? (:boot_id report))
                (re-matches #"[0-9a-f]{32}" (:boot_id report)))))

(defn eligible-reports [reports topology privacy-mode?]
  (into {} (filter (fn [[node report]]
                     (and (topo/conformant-report? topology node report)
                          (or (not privacy-mode?) (privacy-peer-report? report))))
                   reports)))

(defn candidates [reports model kind now stale-ms]
  (vec (for [[node report] reports
             :when (< (- now (:at report 0)) stale-ms)
             [lane l] (:lanes report)
             :when (and (:ready l) (not (:busy l)) (= model (:model l)) (= kind (:kind l)))]
         (merge (select-keys l [:max-image-tokens :max-images :input-tokenizer])
                {:node node :lane (name lane) :context (:context l 0)
                 :boot-id (:boot_id report)
                 :privacy-peer? (privacy-peer-report? report)}))))

(defn gateway-input-tokens! [choices peers body bytes token]
  "Ask one qualified same-model resident for a nonce-bound tokenizer estimate.
  Uses per-call 128-bit CSPRNG x-murakumo-estimate-nonce (INFER-PRIV-04);
  never computes or sends unsalted SHA-256(body)."
  (if-let [{:keys [node lane]} (first (filter #(= "llama-template" (:input-tokenizer %)) choices))]
    (let [peer (get peers node)
          estimate-nonce (.toString (.randomBytes crypto 16) "hex")]
      (-> (js/fetch (str (.-origin (js/URL. (:url peer))) "/estimate/" lane)
                    #js {:method "POST" :signal (.timeout js/AbortSignal 7000)
                         :headers #js {"authorization" (str "Bearer " token)
                                       "content-type" "application/json"
                                       "x-murakumo-estimate-nonce" estimate-nonce}
                         :body bytes})
          (.then (fn [resp] (when-not (.-ok resp) (throw (js/Error. "estimate unavailable"))) (.json resp)))
          (.then (fn [result]
                   (when (and (= estimate-nonce (aget result "estimate_nonce"))
                              (= (:model body) (.-model result))
                              (= "backend-tokenizer" (.-source result))
                              (js/Number.isSafeInteger (aget result "input-tokens"))
                              (<= 0 (aget result "input-tokens") 2097280))
                     (aget result "input-tokens"))))
          (.catch (fn [_] nil))))
    (js/Promise.resolve nil)))

(def supported-inbound-routes
  #{"GET /health"
    "POST /v1/chat/completions"
    "POST /v1/images/generations"
    "GET /jobs/*"
    "POST /jobs/*"
    "GET /topology"
    "POST /topology"})

(defn parse-allowed-routes [routes]
  (when-some [routes routes]
    (when-not (and (sequential? routes) (seq routes)
                   (every? #(contains? supported-inbound-routes %) routes))
      (throw (js/Error. "invalid inbound-allowed-routes")))
    (set routes)))

(defn inbound-route-key [req]
  (let [method (.-method req)
        url (.-url req)]
    (if (str/starts-with? url "/jobs/")
      (str method " /jobs/*")
      (str method " " url))))

(defn inspect-wire-v1-headers [req]
  (if (r/duplicate-raw-header? req r/protected-admit-header-names)
    {:ok false :status 400 :error "duplicate_header" :executed false}
    (let [env-hdr (aget (.-headers req) "x-murakumo-admit-envelope")
          sig-hdr (aget (.-headers req) "x-murakumo-admit-sig")
          env-res (r/parse-admit-envelope env-hdr)
          sig-res (r/parse-admit-sig-header sig-hdr)
          req-route (str (.-method req) " " (.-url req))]
      (cond
        (not (:ok env-res)) env-res
        (not (:ok sig-res)) sig-res
        :else
        (let [env (:envelope env-res)
              alg (:alg env)
              kid (:kid env)
              route (:route env)
              owner (:owner env)
              lane (:lane env)
              boot (:boot env)
              iat (:iat env)
              nonce (:nonce env)
              hdr-boot (aget (.-headers req) "x-murakumo-boot-id")
              hdr-iat (aget (.-headers req) "x-murakumo-issued-at")
              hdr-nonce (aget (.-headers req) "x-murakumo-replay-nonce")]
          (cond
            (not= 1 (:v env))
            {:ok false :status 400 :error "invalid_admit_version" :executed false}
            (not= "ed25519" alg)
            {:ok false :status 403 :error "unsupported_admit_alg" :executed false}
            (not (and (string? kid) (re-matches #"[A-Za-z0-9_-]{1,64}" kid)))
            {:ok false :status 400 :error "invalid_admit_kid" :executed false}
            (and (:header-kid sig-res) (not= (:header-kid sig-res) kid))
            {:ok false :status 403 :error "admit_kid_mismatch" :executed false}
            (not= route req-route)
            {:ok false :status 403 :error "route_mismatch" :executed false}
            (not (and (string? owner) (re-matches #"[A-Za-z0-9-]+" owner)))
            {:ok false :status 400 :error "invalid_admit_owner" :executed false}
            (not (and (string? lane) (re-matches #"[A-Za-z0-9-]+" lane)))
            {:ok false :status 400 :error "invalid_admit_lane" :executed false}
            (not (and (number? iat) (js/Number.isFinite iat) (js/Number.isSafeInteger iat) (pos? iat)))
            {:ok false :status 400 :error "invalid_issued_at" :executed false}
            (not (r/valid-replay-nonce-format? nonce))
            {:ok false :status 400 :error "invalid_replay_nonce" :executed false}
            (and (some? hdr-boot) (not= hdr-boot (or boot "")))
            {:ok false :status 403 :error "envelope_header_mismatch" :executed false}
            (and (some? hdr-iat) (not= hdr-iat (str iat)))
            {:ok false :status 403 :error "envelope_header_mismatch" :executed false}
            (and (some? hdr-nonce) (not= hdr-nonce nonce))
            {:ok false :status 403 :error "envelope_header_mismatch" :executed false}
            :else
            {:ok true :owner owner :lane lane :boot boot :route route :kid kid :envelope env}))))))

(defn start! [config]
  (when (:mint-replay-headers? config)
    (throw (js/Error. "mint-replay-headers? is prohibited: gateway must not synthesize or re-issue caller replay headers")))
  (let [resolved-mode (r/resolve-replay-mode config)
        replay-mode-label (r/normalized-replay-mode resolved-mode)
        privacy-mode? (contains? r/privacy-replay-modes resolved-mode)
        token (r/private-token (:token-file config))
        inbound-token (if-some [file (:inbound-token-file config)]
                        (r/private-token file)
                        token)
        allowed-routes (parse-allowed-routes (:inbound-allowed-routes config))
        topology (topo/start! config token)
        reports (atom {})
        active (atom 0)
        ingress-state (atom {:desired nil :failures 0 :applying false})
        serving? #(and (topo/gateway-allowed? topology (:node config))
                       (not (and (:drain-file config) (.existsSync fs (:drain-file config)))))
        sync-ingress! (fn []
                        (when (and (seq (:tunnel-start-argv config)) (seq (:tunnel-stop-argv config)))
                          (let [now (js/Date.now)
                                healthy? (boolean (and (serving?)
                                           (some (fn [[node report]]
                                                   (and (< (- now (:at report 0)) 15000)
                                                        (topo/conformant-report? topology node report)
                                                        (or (not privacy-mode?) (privacy-peer-report? report))
                                                        (some #(= "image" (:kind %)) (vals (:lanes report))))) @reports)))
                                failures (if healthy? 0 (inc (:failures @ingress-state)))
                                apply? (and (not (:applying @ingress-state))
                                            (or (not= healthy? (:desired @ingress-state))
                                                (>= (- now (:last-applied @ingress-state 0)) (:tunnel-reconcile-ms config 30000)))
                                            (or healthy? (and (zero? @active) (>= failures (:tunnel-failure-threshold config 3)))))]
                            (swap! ingress-state assoc :failures failures)
                            (when apply?
                              (swap! ingress-state assoc :applying true)
                              (let [[bin & args] (if healthy? (:tunnel-start-argv config) (:tunnel-stop-argv config))]
                                (.execFile cp bin (clj->js args) #js {:timeout 10000}
                                  (fn [error _ _]
                                    (swap! ingress-state #(cond-> (assoc % :applying false) (nil? error) (assoc :desired healthy? :last-applied now)))
                                    (println (js/JSON.stringify (clj->js {:event "image-ingress" :enabled healthy? :ok (nil? error)}))))))))))
        peers (atom (into {} (for [p (if topology (topo/nodes topology) (:peers config))] [(:node p) p])))
        polling (atom false)
        headers #js {"authorization" (str "Bearer " token) "content-type" "application/json"}
        tick! (fn []
                (when (compare-and-set! polling false true)
                  (when topology
                    (reset! peers (into {} (for [p (topo/nodes topology)] [(:node p) p])))
                    (swap! reports #(into {} (filter (fn [[node report]] (topo/conformant-report? topology node report)) %))))
                  (-> (js/Promise.allSettled
                       (clj->js (for [[node p] @peers]
                                  (-> (js/fetch (str (.-origin (js/URL. (:url p))) "/health")
                                                #js {:headers headers :signal (.timeout js/AbortSignal 5000)})
                                      (.then (fn [resp] (when-not (.-ok resp) (throw (js/Error. "peer unavailable"))) (.json resp)))
                                      (.then (fn [body]
                                               (when-not (and (= node (.-node body)) (topo/conformant-report? topology node (js->clj body :keywordize-keys true))) (throw (js/Error. "peer identity mismatch")))
                                               (swap! reports assoc node
                                                      (assoc (js->clj body :keywordize-keys true) :at (js/Date.now)))))
                                      (.catch (fn [_] (swap! reports dissoc node)))))))
                      (.finally (fn [] (reset! polling false) (sync-ingress!))))))
        handler (fn [req res compatibility?]
                  (let [topology-route? (and topology (not compatibility?) (= "/topology" (.-url req)))]
                  (cond
                    (and topology-route? (not (r/authorized? req token))) (r/json! res 401 {:error "unauthorized"})
                    (and (not compatibility?) (not topology-route?) (not (r/authorized? req inbound-token))) (r/json! res 401 {:error "unauthorized"})
                    (and (not compatibility?) allowed-routes (not (contains? allowed-routes (inbound-route-key req))))
                    (r/json! res 403 {:error "route_not_allowed"})
                    (and (not compatibility?) (str/starts-with? (.-url req) "/jobs/"))
                    (let [id (subs (.-url req) 6) method (.-method req)
                          endpoints (for [[node report] (eligible-reports @reports topology privacy-mode?)
                                          :when (and (:jobs report) (< (- (js/Date.now) (:at report 0)) 15000))]
                                      (:url (get @peers node)))]
                      (if-not (and (jobs/valid-id? id) (contains? #{"GET" "POST"} method) (serving?))
                        (r/json! res 503 {:error "job_gateway_unavailable"})
                        (letfn [(forward [urls body]
                                  (if-let [url (first urls)]
                                    (-> (jobs/request! (str url "/jobs/" id) token method body 30000)
                                        (.catch (fn [_] (forward (rest urls) body))))
                                    (js/Promise.reject (js/Error. "job quorum unavailable"))))]
                          (-> (if (= method "POST")
                                (-> (r/read-body! req 2097152)
                                    (.then #(js->clj (js/JSON.parse (.toString %)) :keywordize-keys true)))
                                (js/Promise.resolve nil))
                              (.then #(forward endpoints %))
                              (.then #(r/json! res (if (= method "POST") 202 200) %))
                              (.catch (fn [_] (r/json! res 503 {:error "job_not_admitted" :retry "same-id-only"})))))))
                    (and topology (not compatibility?) (= "GET" (.-method req)) (= "/topology" (.-url req)))
                    (r/json! res 200 (topo/document topology))
                    (and topology (not compatibility?) (= "POST" (.-method req)) (= "/topology" (.-url req)))
                    (-> (r/read-body! req 262144)
                        (.then (fn [bytes]
                                 ((:accept! topology) (js->clj (js/JSON.parse (.toString bytes)) :keywordize-keys true))
                                 (r/json! res 200 (topo/summary topology))))
                        (.catch (fn [_] (r/json! res 400 {:error "invalid_topology"}))))
                    (and (= "GET" (.-method req))
                         (contains? (if compatibility? #{"/health" "/readiness"} #{"/health"}) (.-url req)))
                    (let [now (js/Date.now)
                          live (if (serving?)
                                 (into {} (filter (fn [[_ p]] (< (- now (:at p)) 15000))
                                                  (eligible-reports @reports topology privacy-mode?))) {})]
                      (if compatibility?
                        (let [image-lanes (for [[_ p] live [_ lane] (:lanes p) :when (= "image" (:kind lane))] lane)
                              models (into {} (for [model (distinct (map :model image-lanes))
                                                    :let [ls (filter #(= model (:model %)) image-lanes)]]
                                                [model {:ready (boolean (some :ready ls))
                                                        :free (boolean (some #(and (:ready %) (not (:busy %))) ls))}]))]
                          (r/json! res (if (seq image-lanes) 200 503) {:ok (boolean (seq image-lanes)) :busy (boolean (some :busy image-lanes)) :models models}))
                        (r/json! res (if (and (seq live) (serving?)) 200 503)
                                 {:node (:node config) :replay_mode replay-mode-label
                                  :topology (topo/summary topology) :resilience (topo/resilience topology live)
                                  :peers live :inflight @active :draining (not (serving?)) :admission "node-owned"})))
                    (and (= "POST" (.-method req)) (not (serving?)))
                    (r/json! res 503 {:error "topology_gateway_unavailable" :executed false})
                    (and (= "POST" (.-method req))
                         (contains? (if compatibility? #{"/v1/images/generations"} #{"/v1/chat/completions" "/v1/images/generations"}) (.-url req)))
                    (let [has-admit-envelope? (some? (aget (.-headers req) "x-murakumo-admit-envelope"))
                          wire-v1? (or privacy-mode? has-admit-envelope? (true? (:require-caller-replay-headers? config)))
                          wire-check (when wire-v1? (inspect-wire-v1-headers req))]
                      (if (and wire-v1? (not (:ok wire-check)))
                        (r/json! res (:status wire-check) {:error (:error wire-check) :executed false})
                        (do
                          (swap! active inc)
                          (let [released? (atom false) release! #(when (compare-and-set! released? false true) (swap! active dec))]
                            (.once res "finish" release!) (.once res "close" release!))
                          (-> (r/read-body! req (:max-body-bytes config 2097152))
                              (.then (fn [bytes]
                                       (let [body (js->clj (js/JSON.parse (.toString bytes)) :keywordize-keys true)
                                             kind (if (= "/v1/chat/completions" (.-url req)) "text" "image")
                                             elig (eligible-reports @reports topology (or privacy-mode? wire-v1?))
                                             all-choices (candidates elig (:model body) kind (js/Date.now) 15000)
                                             ;; In Wire v1 privacy mode, restrict estimation strictly to the envelope's single (owner, lane).
                                             est-choices (if wire-v1?
                                                           (filterv #(and (= (:owner wire-check) (:node %))
                                                                          (= (:lane wire-check) (:lane %)))
                                                                    all-choices)
                                                           all-choices)]
                                         (-> (if (= kind "text")
                                               (gateway-input-tokens! est-choices @peers body bytes token)
                                               (js/Promise.resolve nil))
                                             (.then (fn [input] {:bytes bytes :input-tokens input}))))))
                              (.then
                               (fn [{:keys [bytes input-tokens]}]
                                 (let [_ (when (.-destroyed res) (throw (js/Error. "caller disconnected")))
                                       body (js->clj (js/JSON.parse (.toString bytes)) :keywordize-keys true)
                                       kind (if (= "/v1/chat/completions" (.-url req)) "text" "image")
                                       _ (when (and (= kind "text") (not (r/valid-output-budget? body)))
                                           (throw (js/Error. "invalid output budget")))
                                       elig (eligible-reports @reports topology (or privacy-mode? wire-v1?))
                                       choices (candidates elig (:model body) kind (js/Date.now) 15000)
                                       choices (if wire-v1?
                                                 ;; Single (owner, lane) routing: NEVER fail over to a different peer!
                                                 (filterv #(and (= (:owner wire-check) (:node %))
                                                                (= (:lane wire-check) (:lane %)))
                                                          choices)
                                                 choices)
                                       choices (filterv #(or (= kind "image")
                                                            (when-let [input (or (when (= "llama-template" (:input-tokenizer %)) input-tokens) (r/request-input-tokens % body (.-length bytes)))]
                                                              (>= (:context %) (+ input (r/output-reservation % (:max_tokens body 1024)))))) choices)
                                       privacy-req? (or privacy-mode? wire-v1? (boolean (some :privacy-peer? choices)))
                                       ;; In privacy mode (INFER-PRIV-05), never accept or propagate external x-murakumo-job-id.
                                       incoming-id (when-not privacy-req? (aget (.-headers req) "x-murakumo-job-id"))
                                       nonce (str/replace (.randomUUID crypto) #"-" "")
                                       ;; Random first peer spreads simultaneous arrivals across gateways (durable mode).
                                       choices (if (and (not wire-v1?) (seq choices))
                                                 (let [n (.randomInt crypto (count choices))]
                                                   (vec (concat (subvec choices n) (subvec choices 0 n))))
                                                 choices)
                                       ;; A durable-mode retry is pinned to its original owner, even if health changed.
                                       [owner lane suffix] (when incoming-id (str/split incoming-id #"_" 3))
                                       choices (if incoming-id [{:node owner :lane lane}] choices)
                                       controller (js/AbortController.)
                                       timer (js/setTimeout #(.abort controller)
                                                            (:request-timeout-ms config (if privacy-req? 190000 490000)))]
                                   (.on res "close" #(when-not (.-writableEnded res) (.abort controller)))
                                   (letfn [(attempt [remaining last-refusal]
                                             (if-let [{:keys [node lane privacy-peer?]} (first remaining)]
                                               (if-let [p (or (get @peers node) (when incoming-id (topo/node-entry topology node)))]
                                                 (let [peer-privacy? (or privacy-req? privacy-peer? (privacy-peer-report? (get @reports node)))
                                                       id (when-not peer-privacy? (or incoming-id (str node "_" lane "_" nonce)))]
                                                   (when-not (and (re-matches #"[A-Za-z0-9-]+" node)
                                                                  (re-matches #"[A-Za-z0-9-]+" lane)
                                                                  (or (nil? incoming-id) (re-matches #"[a-f0-9]{32}" (or suffix ""))))
                                                     (throw (js/Error. "invalid job id")))
                                                   (let [exec-headers
                                                         (let [h #js {"authorization" (str "Bearer " token)
                                                                      "content-type" "application/json"}
                                                               env-hdr (aget (.-headers req) "x-murakumo-admit-envelope")
                                                               sig-hdr (aget (.-headers req) "x-murakumo-admit-sig")
                                                               caller-nonce (aget (.-headers req) "x-murakumo-replay-nonce")
                                                               caller-issued (aget (.-headers req) "x-murakumo-issued-at")
                                                               caller-boot (aget (.-headers req) "x-murakumo-boot-id")]
                                                           ;; Only durable mode carries x-murakumo-job-id.
                                                           ;; Correlation headers (cf-ray, traceparent, tracestate, x-request-id,
                                                           ;; x-correlation-id) are intentionally never copied into exec-headers.
                                                           (when id (aset h "x-murakumo-job-id" id))
                                                           ;; Never synthesize, re-issue, re-sign, or overwrite caller admit/replay headers.
                                                           (when env-hdr (aset h "x-murakumo-admit-envelope" env-hdr))
                                                           (when sig-hdr (aset h "x-murakumo-admit-sig" sig-hdr))
                                                           (when caller-nonce (aset h "x-murakumo-replay-nonce" caller-nonce))
                                                           (when caller-issued (aset h "x-murakumo-issued-at" caller-issued))
                                                           (when caller-boot (aset h "x-murakumo-boot-id" caller-boot))
                                                           h)]
                                                   (-> (js/fetch (str (.-origin (js/URL. (:url p))) "/execute/" lane)
                                                                 #js {:method "POST" :signal (.-signal controller)
                                                                      :headers exec-headers
                                                                      :body bytes})
                                                       (.then (fn [resp]
                                                                ;; Durable mode retries explicit pre-admission 429/503 with executed === false.
                                                                ;; Wire v1 privacy envelopes are single-(owner,lane)-bound and NEVER fail over
                                                                ;; to a different peer; 502, 409, and 410 NEVER retry or re-sign.
                                                                (if (and (nil? incoming-id) (not wire-v1?) (contains? #{429 503} (.-status resp)))
                                                                  (-> (.json resp)
                                                                      (.then (fn [refusal]
                                                                               (if (false? (.-executed refusal))
                                                                                 (attempt (rest remaining) {:status (.-status resp)
                                                                                                            :error (or (.-error refusal) "no_ready_capacity")})
                                                                                 (r/json! res 502
                                                                                          (if peer-privacy?
                                                                                            {:error "execution_unknown" :retryable false}
                                                                                            {:error "execution_unknown" :job-id id :retryable false}))))))
                                                                  (do
                                                                    (let [ct (or (.get (.-headers resp) "content-type") "application/json")
                                                                          resp-headers (if peer-privacy?
                                                                                         #js {"content-type" ct "cache-control" "no-store"}
                                                                                         #js {"content-type" ct "x-murakumo-job-id" id "x-murakumo-node" node})]
                                                                      (.writeHead res (.-status resp) resp-headers))
                                                                    (let [reader (.getReader (.-body resp))]
                                                                      (letfn [(pump []
                                                                                (-> (.read reader)
                                                                                    (.then (fn [part]
                                                                                             (if (.-done part) (.end res)
                                                                                                 (do (.write res (.from js/Buffer (.-value part))) (pump)))))))]
                                                                        (pump)))))))
                                                       (.catch (fn [_]
                                                                 (when-not (.-headersSent res)
                                                                   (r/json! res 502
                                                                            (if peer-privacy?
                                                                              {:error "execution_unknown" :retryable false}
                                                                              {:error "execution_unknown" :job-id id :retryable false})))
                                                                 (when-not (.-writableEnded res) (.end res)))))))
                                                 (r/json! res 400 {:error "unknown_job_owner"}))
                                               (if last-refusal
                                                 (r/json! res (:status last-refusal) {:error (:error last-refusal) :executed false})
                                                 (if (or privacy-mode? wire-v1?)
                                                   (r/json! res 503 {:error "no_privacy_peer_available" :executed false})
                                                   (r/json! res 429 {:error "no_ready_capacity" :executed false})))))]
                                     (-> (js/Promise.resolve (attempt choices nil))
                                         (.finally #(js/clearTimeout timer)))))))
                              (.catch (fn [_] (when-not (.-headersSent res) (r/json! res 400 {:error "invalid_request"}))))))))
                    :else (r/json! res 404 {:error "not_found"}))))
        server (.createServer http (fn [req res] (handler req res false)))
        compat-server (when (:compat-image-port config)
                        (when-not (contains? #{"127.0.0.1" "::1"} (:compat-image-bind config "127.0.0.1"))
                          (throw (js/Error. "image compatibility ingress must remain loopback")))
                        (.createServer http (fn [req res] (handler req res true))))]
    (doseq [[node p] @peers]
      (when-not (and (re-matches #"[A-Za-z0-9-]+" node) (:url p))
        (throw (js/Error. "invalid peer manifest"))))
    (.listen server (:port config 8797) (:bind config "127.0.0.1"))
    (when compat-server (.listen compat-server (:compat-image-port config) (:compat-image-bind config "127.0.0.1")))
    (tick!)
    (let [timer (js/setInterval tick! (:probe-interval-ms config 3000))
          stop-watchdog! (r/service-watchdog! config #(.-listening server))]
      {:server server :reports reports
       :close (fn [] (stop-watchdog!) (when topology ((:close topology))) (js/clearInterval timer) (.close server) (when compat-server (.close compat-server)))})))

(defn run-command [command args]
  (case command
    "serve" (let [[flag file] args]
              (when-not (and (= flag "--config") file) (throw (js/Error. "gateway serve --config FILE")))
              (start! (js->clj (js/JSON.parse (.readFileSync fs file "utf8")) :keywordize-keys true)))
    (println "murakumo gateway serve --config FILE — replicated fleet entrypoint")))
