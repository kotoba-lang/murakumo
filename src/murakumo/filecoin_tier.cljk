(ns murakumo.filecoin-tier
  "Optional Filecoin cold tier for the artifact CAS, reached across a process
  boundary: a loopback `filecoin-cas` service owns the Synapse SDK and the
  wallet key; murakumo only speaks HTTP to it (curl, synchronously, so the
  `{:put! :get}` adapter contract of murakumo.artifact-store is unchanged).

  `(wrap local cfg)` returns `local` untouched when `cfg` is nil, so nothing
  changes until MURAKUMO_FILECOIN_CAS_URL is set.

    put!  local write first (verifies the CID, throws on mismatch, exactly as
          before), then a best-effort PUT to the tier. A tier failure never
          fails the put; it is reported through :on-error and `backfill!`
          catches whatever was missed.
    get   local first; on a local miss, ask the tier, and persist what comes
          back through the local `put!` (which re-verifies the CID) before
          returning it. Tier failures read as a miss."
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as nodepath]))

(def default-timeout-s 120)

(defn- loopback-http? [url]
  (boolean (re-matches #"http://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]{1,5})?" url)))

(defn endpoint!
  "Validate the service URL: https, or plain http on loopback only. Returns the
  URL without a trailing slash."
  [url]
  (let [u (str url)]
    (when-not (or (re-matches #"https://[A-Za-z0-9.-]+(:[0-9]{1,5})?" (.replace u #"/+$" ""))
                  (loopback-http? (.replace u #"/+$" "")))
      (throw (ex-info "murakumo-filecoin: endpoint must be https or loopback http"
                      {:reason :insecure-endpoint :url u})))
    (.replace u #"/+$" "")))

(defn curl-argv
  "argv for one request. The bearer token is never on the command line: it
  goes in `header-file` (mode 0600) via curl's `-H @file`. A PUT body is read
  from stdin."
  [{:keys [method url timeout-s header-file out-file]}]
  (cond-> ["curl" "-s" "-S" "-m" (str (or timeout-s default-timeout-s))
           "-X" method "-o" out-file "-w" "%{http_code}"]
    header-file (into ["-H" (str "@" header-file)])
    (= "PUT" method) (into ["--data-binary" "@-"])
    true (conj url)))

(defn curl-transport
  "Default transport: (fn [{:keys [method path body]}]) -> {:status n :body
  Buffer-or-nil}. status 0 means the request itself failed (:error set)."
  [{:keys [url token-file timeout-s]}]
  (fn [{:keys [method path body]}]
    (let [dir (.mkdtempSync fs (.join nodepath (.tmpdir os) "mkfc-"))
          out-file (.join nodepath dir "out")
          header-file (when token-file (.join nodepath dir "hdr"))]
      (try
        (when token-file
          (.writeFileSync fs header-file
                          (str "Authorization: Bearer "
                               (.trim (.readFileSync fs token-file "utf8")) "\n")
                          #js {:mode 0600}))
        (let [argv (curl-argv {:method method :url (str url path) :timeout-s timeout-s
                               :header-file header-file :out-file out-file})
              r (.spawnSync cp (first argv) (to-array (rest argv))
                             #js {:input (when body (js/Buffer.from body))
                                  :maxBuffer (* 1024 1024)})
              status (js/parseInt (str (.-stdout r)) 10)]
          (cond
            (.-error r) {:status 0 :error (.-message (.-error r))}
            (not= 0 (.-status r)) {:status 0 :error (str "curl exit " (.-status r) ": "
                                                         (.trim (str (.-stderr r))))}
            (js/isNaN status) {:status 0 :error "no http status"}
            :else {:status status
                   ;; A Node Buffer, not `(js/Uint8Array. ...)`: murakumo's hashing
                   ;; rejects a Uint8Array built inside the kbb sandbox
                   ;; ("Uint8Array expected"), and readFileSync's Buffer is accepted.
                   :body (when (.existsSync fs out-file)
                           (.readFileSync fs out-file))}))
        (catch :default e {:status 0 :error (.-message e)})
        (finally (.rmSync fs dir #js {:recursive true :force true}))))))

(defn config-from-env
  "{:url :token-file ...} from MURAKUMO_FILECOIN_CAS_URL and optionally
  MURAKUMO_FILECOIN_CAS_TOKEN_FILE, or nil when the tier is not configured."
  ([] (config-from-env #(aget js/process.env %)))
  ([getenv]
   (when-let [url (not-empty (getenv "MURAKUMO_FILECOIN_CAS_URL"))]
     (cond-> {:url (endpoint! url)}
       (not-empty (getenv "MURAKUMO_FILECOIN_CAS_TOKEN_FILE"))
       (assoc :token-file (getenv "MURAKUMO_FILECOIN_CAS_TOKEN_FILE"))))))

(defn- transport-of [cfg] (or (:transport cfg) (curl-transport cfg)))
(defn- report [cfg event] ((or (:on-error cfg) (fn [_] nil)) event))

(defn remote-put!
  "PUT one object to the tier. True when the tier accepted it (202 queued or
  200 already stored); otherwise reports and returns false."
  [cfg cid bytes]
  (let [{:keys [status error]} ((transport-of cfg) {:method "PUT" :path (str "/obj/" cid)
                                                    :body bytes})]
    (or (contains? #{200 202} status)
        (do (report cfg {:filecoin-put-failed cid :status status :error error}) false))))

(defn remote-get
  "Bytes from the tier, or nil (unknown to the tier, or the tier failed)."
  [cfg cid]
  (let [{:keys [status body error]} ((transport-of cfg) {:method "GET" :path (str "/obj/" cid)})]
    (cond
      (= 200 status) body
      (= 404 status) nil
      :else (do (report cfg {:filecoin-get-failed cid :status status :error error}) nil))))

(defn remote-known?
  "Whether the tier already has an entry for `cid` (queued or stored)."
  [cfg cid]
  (= 200 (:status ((transport-of cfg) {:method "GET" :path (str "/status/" cid)}))))

(defn wrap
  "Tiered `{:put! :get}` over `local`; `local` itself when `cfg` is nil."
  [local cfg]
  (if (nil? cfg)
    local
    {:put! (fn [cid bytes]
             (let [r ((:put! local) cid bytes)]
               (remote-put! cfg cid bytes)
               r))
     :get (fn [cid]
            (or ((:get local) cid)
                (when-let [bytes (remote-get cfg cid)]
                  (try
                    ((:put! local) cid bytes)      ; re-verifies the CID
                    ((:get local) cid)
                    (catch :default e
                      (report cfg {:filecoin-get-rejected cid :error (.-message e)})
                      nil)))))}))

(defn local-cids
  "CIDs present under a filesystem CAS root (<root>/<prefix>/<cid>)."
  [root]
  (if-not (.existsSync fs root)
    []
    (vec (for [prefix (.readdirSync fs root)
               :let [d (.join nodepath root prefix)]
               :when (.isDirectory (.statSync fs d))
               cid (.readdirSync fs d)
               :when (re-matches #"baf[a-z2-7]+" cid)]
           cid))))

(defn backfill!
  "Send every local object the tier does not know yet. Run after enabling the
  tier, or after an outage. `read` is (fn [cid]) -> bytes (the local `:get`).
  Returns {:sent n :skipped n :failed n}."
  [cfg root read]
  (reduce (fn [acc cid]
            (cond
              (remote-known? cfg cid) (update acc :skipped inc)
              (remote-put! cfg cid (read cid)) (update acc :sent inc)
              :else (update acc :failed inc)))
          {:sent 0 :skipped 0 :failed 0}
          (local-cids root)))
