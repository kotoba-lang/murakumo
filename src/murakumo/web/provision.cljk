(ns murakumo.web.provision
  "Validation for the node `:configure` op and the provisioning drop-file
  (ADR-260929). Pure. The point of this namespace is what it REFUSES: only a
  fixed set of config file names, bounded sizes, and value shapes; and nothing
  here ever echoes a value back (results name files, never contents), so a secret
  cannot leak through a status line, a log or a tool result.

  A tenant service-account secret (`kb_sa_...`) is issued by a tenant admin. Nothing
  here mints it or obtains it; this only carries a value the admin already handed
  over from the one place the operator put it to every node's 0600 config file."
  (:require [kotoba.lang.text :as text]))

(def allowed-files
  "Every file `:configure` may write, and nothing else (no path is ever taken from input)."
  #{"yataverse.url" "yataverse.prefix" "yataverse.authn.edn" "yataverse.sa-token"
    "yataverse.auth-cmd" "yataverse.auth" "backends.edn" "zone.edn"})

(def secret-files #{"yataverse.sa-token" "yataverse.auth"})

(def max-file-chars 4096)

(defn- control-chars? [s] (boolean (re-find #"[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]" s)))

(defn- check-file [name content]
  (let [c (if (string? content) (text/trim content) content)]
    (cond
      (not (allowed-files name)) :file/not-allowed
      (not (string? content)) :file/not-a-string
      (empty? c) :file/empty
      (> (count content) max-file-chars) :file/too-large
      (control-chars? content) :file/control-characters
      :else
      (case name
        "yataverse.url" (when-not (re-matches #"https://[A-Za-z0-9.-]+(:\d+)?" c) :yataverse.url/not-https-origin)
        "yataverse.prefix" (when-not (and (re-matches #"/[A-Za-z0-9._/-]*/" c) (not (re-find #"\.\." c)))
                             :yataverse.prefix/bad)
        "yataverse.sa-token" (when-not (re-matches #"kb_sa_[A-Za-z0-9._-]+" c) :yataverse.sa-token/bad-shape)
        "yataverse.authn.edn" (when-not (re-matches #"(?s)\{.*:tenant-id\s+\"t_[A-Za-z0-9_-]+\".*\}" c)
                                :yataverse.authn.edn/no-tenant-id)
        "yataverse.auth-cmd" (when-not (re-matches #"(?s)\[\s*\"[^\"]+\"(\s+\"[^\"]*\")*\s*\]" c)
                               :yataverse.auth-cmd/not-an-argv-vector)
        nil))))

(defn validate-files
  "files: {\"name\" \"content\" ...} -> {:ok files} | {:refused {name reason ...}}.
  Reasons name the file and the rule; they never contain the value."
  [files]
  (if-not (and (map? files) (seq files))
    {:refused {"*" :files/none}}
    (let [problems (into (sorted-map)
                         (keep (fn [[k v]] (when-let [r (check-file (str k) v)] [(str k) r])))
                         files)]
      (if (empty? problems)
        {:ok (into {} (map (fn [[k v]] [(str k) (text/trim v)])) files)}
        {:refused problems}))))

(defn needs-secret-mode?
  "Secret files are written 0600; every file is, but these are the ones a status
  view must never print."
  [name] (contains? secret-files name))

(defn put-configured?
  "Whether the present config names a way to write: a url and one authorization source."
  [present]
  (let [p (set present)]
    (boolean (and (p "yataverse.url")
                  (or (p "yataverse.auth-cmd") (p "yataverse.auth")
                      (and (p "yataverse.authn.edn") (p "yataverse.sa-token")))))))
