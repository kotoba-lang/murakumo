[Unit]
Description=Murakumo replicated fleet entrypoint
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=murakumo
WorkingDirectory=/opt/murakumo
ExecStart=/usr/bin/node /opt/murakumo/release/node.mjs gateway serve --config /etc/murakumo/gateway.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
