<?xml version="1.0" encoding="UTF-8"?>
<!-- com.murakumo.kotoba-mesh-watchdog — HTTP-wedge watchdog for the resident
     kotoba mesh node. Rendered per-node by `murakumo provision` next to
     com.murakumo.kotoba-mesh. Every 60s it probes the node's own
     http://127.0.0.1:{{PORT}}/health.

     It kills kotoba-server ONLY for the failure it was built for (2026-07-02,
     pin 4f38b74a): the TCP listener accepts a connection but HTTP never
     answers, twice in a row. Before it counts a strike it asks `nc` whether a
     plain TCP connect works:
       - "Can't assign requested address" → THIS HOST is out of ephemeral
         ports (TIME_WAIT). The server is fine; killing it changes nothing and
         the restart storm makes it worse. Measured 2026-09-02 on simeon: the
         watchdog killed a healthy server every two minutes for hours
         (ADR-260902-fleet-outbound-hygiene). Log it, clear the strike.
       - connect refused / no listener → the process is gone or starting;
         that is KeepAlive's job, not ours. Clear the strike.
       - connect succeeded but /health failed → the wedge. Strike; kill on two.
     The log line names which of the three it saw, so a reader can tell a
     wedge from an exhausted node from a restart in progress. -->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.murakumo.kotoba-mesh-watchdog</string>
  <key>UserName</key>         <string>{{USER}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>H="{{HOME}}"; P={{PORT}}; M="$H/.murakumo/watchdog.strike"; L="$H/.murakumo/watchdog.log"; T="$(date -u +%Y-%m-%dT%H:%M:%SZ)"; if curl -sf -m 5 "http://127.0.0.1:$P/health" &gt;/dev/null 2&gt;&#38;1; then rm -f "$M"; else R="$(nc -z -w 3 127.0.0.1 $P 2&gt;&#38;1)"; case "$R" in *"assign requested address"*) echo "$T probe on :$P failed with EADDRNOTAVAIL — this host is out of ephemeral ports (TIME_WAIT=$(netstat -an -p tcp 2&gt;/dev/null | grep -c TIME_WAIT)); kotoba-server NOT killed" &gt;&gt; "$L"; rm -f "$M";; *succeeded*) if [ -f "$M" ]; then rm -f "$M"; echo "$T TCP accepts but /health failed twice on :$P — HTTP wedge, killing kotoba-server" &gt;&gt; "$L"; pkill -f "$H/.murakumo/bin/kotoba-server"; else touch "$M"; fi;; *) echo "$T no listener on :$P ($R) — leaving restart to KeepAlive" &gt;&gt; "$L"; rm -f "$M";; esac; fi</string>
  </array>
  <key>StartInterval</key>    <integer>60</integer>
  <key>RunAtLoad</key>        <true/>
  <key>StandardOutPath</key>  <string>{{HOME}}/.murakumo/watchdog.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/.murakumo/watchdog.log</string>
</dict>
</plist>
