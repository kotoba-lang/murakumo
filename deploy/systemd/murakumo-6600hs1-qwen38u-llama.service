# Qwen3.8-27B-Uncensored (orcarouter GGUF, Q4_K_M + f16 mmproj) on
# aiueos-6600hs-1 (Ryzen 5 7500F, 15 GiB DDR5, Intel Arc BMG G31 32 GiB VRAM
# via Mesa ANV Vulkan, HWE kernel 7.0.0-31). Owner instruction 2026-09-16:
# host qwen3.8 uncensored + nex2 mini on the reinstalled ubuntu-server box.
# Same llama.cpp build as k16 (llama-b10883 Vulkan). Full offload; the tunable
# tail is $SERVER_ARGS in the model dir's server.env (aiueos-owned), which
# also carries the llama-bench numbers. Sibling: murakumo-6600hs1-nex-n25-mini-llama
# (Nex keeps 20 expert layers on CPU so this model can stay fully resident;
# numbers beside the fleet.edn entry).
#
# 2026-09-16 (later): this box WAS the fleet's b70 head (murakumo-b70-llama.service,
# jun@100.119.10.43) before the reinstall; that head ran the same 27B shape with
# --spec-type draft-mtp at decode 16.8-28 tok/s. The orcarouter Uncensored GGUF
# carries the mtp tensors, so the same flags work on this Vulkan build: E2E
# 17.2-18.0 tok/s alone (was 10.7), 12.0 beside a Nex request, 2 slots busy
# 9.0 + 8.6. 2 slots x 16384 (ctx-size is the TOTAL). batch/ubatch left at
# defaults: 4096/2048 left 126 MiB of VRAM budget beside Nex, defaults leave
# ~857 MiB (764 MiB after a 6334-token prompt, prefill 322 tok/s). The
# murakumo-main pool has had 0 available heads since the reinstall (/ready
# pool-available {gad 0, b70 0, xavier 0}); restoring the b70 role is an
# owner decision recorded in root ADR adr-2609161500.
[Unit]
Description=Qwen3.8-27B-Uncensored Q4_K_M (orcarouter) on aiueos-6600hs-1 (Intel BMG G31, Vulkan)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=aiueos
Group=aiueos
WorkingDirectory=/home/aiueos/murakumo/llama.cpp/build-vulkan/llama-b10883
Environment=LD_LIBRARY_PATH=/home/aiueos/murakumo/llama.cpp/build-vulkan/llama-b10883
EnvironmentFile=/home/aiueos/models/orcarouter/Qwen3.8-27B-Uncensored-GGUF/server.env
ExecStart=/home/aiueos/murakumo/llama.cpp/build-vulkan/llama-b10883/llama-server --model /home/aiueos/models/orcarouter/Qwen3.8-27B-Uncensored-GGUF/Qwen3.8-27B-Uncensored-Q4_K_M.gguf --mmproj /home/aiueos/models/orcarouter/Qwen3.8-27B-Uncensored-GGUF/mmproj-Qwen3.8-27B-Uncensored-f16.gguf --alias qwen3.8-27b-uncensored --host 127.0.0.1 --port 8097 --flash-attn on --jinja --no-webui $SERVER_ARGS
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
