# Edge-queue join for qwen3.8-27b-uncensored from aiueos-6600hs-1. Same
# /opt/murakumo/infer-join.cljs + /etc/murakumo/join.env as k16; --poll-ms 250
# (k16 polls at 1000) so the 4x faster node wins more claim races. The gateway's
# soft cache-affinity still hands a repeated prompt to whoever served it last.
# --slots 2 since the llama unit runs 2 slots (MTP speculative, 2026-09-16 later).
[Unit]
Description=Join Murakumo Cloud from aiueos-6600hs-1 as qwen3.8-27b-uncensored
After=network-online.target tailscaled.service murakumo-6600hs1-qwen38u-llama.service
Wants=network-online.target
Requires=murakumo-6600hs1-qwen38u-llama.service

[Service]
Type=simple
TimeoutStartSec=0
User=aiueos
Group=aiueos
EnvironmentFile=/etc/murakumo/join.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStartPre=/bin/bash -c 'for i in $(seq 1 300); do /usr/bin/curl -fsS http://127.0.0.1:8097/health >/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/local/bin/nbb --classpath /opt/murakumo/src /opt/murakumo/infer-join.cljs --model qwen3.8-27b-uncensored --base https://api.murakumo.cloud --name aiueos-6600hs-1-qwen38u --trust-tier awai-secure --local-url http://127.0.0.1:8097/v1 --slots 2 --poll-ms 250
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
