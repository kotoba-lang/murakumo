# Edge-queue join for nex-n2.5-mini-uncensored from aiueos-6600hs-1. Enrolled
# 2026-09-16 but idle: api.murakumo.cloud routes this model id by name to the
# HEADS list (6600hs1 > xavier, Workers-VPC bindings), not through the edge
# queue. Kept so a routing change on the gateway needs nothing on the node.
# 2026-09-18: the local server behind :8090 is the vLLM unit (Requires= below);
# it answers /health and /v1 exactly like llama-server did. To roll back to
# llama.cpp, point Requires=/After= at the -llama unit again.
[Unit]
Description=Join Murakumo Cloud from aiueos-6600hs-1 as nex-n2.5-mini-uncensored
After=network-online.target tailscaled.service murakumo-6600hs1-nex-n25-mini-vllm.service
Wants=network-online.target
Requires=murakumo-6600hs1-nex-n25-mini-vllm.service

[Service]
Type=simple
TimeoutStartSec=0
User=aiueos
Group=aiueos
EnvironmentFile=/etc/murakumo/join.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStartPre=/bin/bash -c 'for i in $(seq 1 300); do /usr/bin/curl -fsS http://127.0.0.1:8090/health >/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/local/bin/nbb --classpath /opt/murakumo/src /opt/murakumo/infer-join.cljs --model nex-n2.5-mini-uncensored --base https://api.murakumo.cloud --name aiueos-6600hs-1-nex-n25-mini --trust-tier awai-secure --local-url http://127.0.0.1:8090/v1 --slots 1 --poll-ms 250
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
