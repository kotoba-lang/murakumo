# Qwen3.8-27B-Uncensored (orcarouter GGUF, Q4_K_M) on the aiueos K16
# (aiueos-node-260910, Ryzen 7 7735HS 8C/16T, 32 GiB LPDDR5 of which 5 GiB is
# the BIOS UMA carve-out => 27.4 GiB MemTotal, Radeon 680M gfx1035 via RADV
# Vulkan, GTT 13 GiB). Owner instruction 2026-09-15: host
# huggingface.co/orcarouter/Qwen3.8-27B-Uncensored-GGUF on k16.
#
# Sibling of murakumo-edge-usagi-llama.service (same llama.cpp build
# llama-b10883, same box). The 15.66 GiB Q4_K_M does NOT fit next to the
# usagi replica (65536-window Ling-3.0-tiny, ~9.8 GiB resident): MemAvailable
# was 10.9 GiB with both Ling replicas up. So this unit Conflicts= with usagi
# and the install stops usagi first; murakumo-edge (Ornith, :8092, 0.9 GiB)
# stays.
#
# The ExecStart line is split: the fixed part lives here, the tunable part
# (--device / -ngl / -t / --ctx-size) lives in server.env owned by aiueos, so
# a qualification run on the node can change the shape without root. Whatever
# is in server.env at start is what serves; the measurement that chose it is
# recorded in infer.edn beside the model entry, not here.
#
# Install:  scp deploy/systemd/murakumo-k16-qwen38u-*.service aiueos@100.66.205.17:/tmp/ \
#           && ssh aiueos@100.66.205.17 'sudo install -m644 /tmp/murakumo-k16-qwen38u-*.service /etc/systemd/system/ \
#                && sudo systemctl daemon-reload \
#                && sudo systemctl disable --now murakumo-edge-usagi-join murakumo-edge-usagi-llama \
#                && sudo systemctl enable --now murakumo-k16-qwen38u-llama murakumo-k16-qwen38u-join'
# Verify:   curl -s http://127.0.0.1:8097/health ; curl -s http://127.0.0.1:8097/v1/models
[Unit]
Description=Qwen3.8-27B-Uncensored Q4_K_M (orcarouter) on the aiueos K16
After=network-online.target tailscaled.service
Wants=network-online.target
Conflicts=murakumo-edge-usagi-llama.service

[Service]
Type=simple
User=aiueos
Group=aiueos
WorkingDirectory=/home/aiueos/murakumo/llama.cpp/build-vulkan/llama-b10883
Environment=LD_LIBRARY_PATH=/home/aiueos/murakumo/llama.cpp/build-vulkan/llama-b10883
# SERVER_ARGS: the tunable shape (device / offload / threads / window). See header.
EnvironmentFile=/home/aiueos/models/orcarouter/Qwen3.8-27B-Uncensored-GGUF/server.env
ExecStart=/home/aiueos/murakumo/llama.cpp/build-vulkan/llama-b10883/llama-server --model /home/aiueos/models/orcarouter/Qwen3.8-27B-Uncensored-GGUF/Qwen3.8-27B-Uncensored-Q4_K_M.gguf --mmproj /home/aiueos/models/orcarouter/Qwen3.8-27B-Uncensored-GGUF/mmproj-Qwen3.8-27B-Uncensored-f16.gguf --alias qwen3.8-27b-uncensored --host 127.0.0.1 --port 8097 --parallel 1 --flash-attn on --jinja --no-webui $SERVER_ARGS
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
