[Unit]
Description=Join Murakumo Cloud from the B70 vLLM inference node
After=network-online.target tailscaled.service murakumo-b70-vllm.service
Wants=network-online.target
Requires=murakumo-b70-vllm.service

[Service]
Type=simple
TimeoutStartSec=0
User=jun
Group=jun
EnvironmentFile=/etc/murakumo/join.env
# Supplies VLLM_API_KEY to the local inference client. The worker keeps this
# credential separate from MURAKUMO_SERVICE_TOKEN, which authenticates the
# public control plane.
EnvironmentFile=/etc/murakumo/b70-vllm.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStartPre=/bin/bash -c 'for i in $(seq 1 180); do /usr/bin/curl -fsS http://127.0.0.1:8090/health >/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/local/bin/nbb --classpath /opt/murakumo/src /opt/murakumo/infer-join.cljs --model qwen3.8-27b --base https://api.murakumo.cloud --name ubuntu-server-b70 --local-url http://127.0.0.1:8090/v1 --poll-ms 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
