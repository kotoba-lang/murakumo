# Join worker for murakumo-k16-qwen38u-llama.service — registers the K16 as
# node aiueos-node-260910-qwen38u serving model id qwen3.8-27b-uncensored and
# polls /infer/queue for it. Same shape as murakumo-edge-usagi-join.service
# (which it replaces on this box; see the llama unit header).
[Unit]
Description=Join Murakumo Cloud from the aiueos K16 as qwen3.8-27b-uncensored
After=network-online.target tailscaled.service murakumo-k16-qwen38u-llama.service
Wants=network-online.target
Requires=murakumo-k16-qwen38u-llama.service

[Service]
Type=simple
TimeoutStartSec=0
User=aiueos
Group=aiueos
EnvironmentFile=/etc/murakumo/join.env
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStartPre=/bin/bash -c 'for i in $(seq 1 300); do /usr/bin/curl -fsS http://127.0.0.1:8097/health >/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/local/bin/nbb --classpath /opt/murakumo/src /opt/murakumo/infer-join.cljs --model qwen3.8-27b-uncensored --base https://api.murakumo.cloud --name aiueos-node-260910-qwen38u --trust-tier awai-secure --local-url http://127.0.0.1:8097/v1 --slots 1 --poll-ms 1000
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
