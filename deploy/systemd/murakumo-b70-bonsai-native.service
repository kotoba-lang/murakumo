[Unit]
Description=Murakumo Mishima Ternary Bonsai 2 27B inference on Intel B70
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/kgpu/prism-llama
# B70 is a Mishima-only node. Nex is disabled so the full card can back this
# 128K q4 KV slot instead of sharing memory with a second model. The Prism
# Vulkan server processed a measured 10,054-token prompt at 152.31 tok/s;
# the older serial native guest exceeded 300 seconds for the same probe.
# 8092 is the stable Workers-VPC address and now belongs to the fleet router.
# The B70 head stays private behind that router on loopback 8093.
ExecStart=/root/kgpu/prism-llama/llama-server --model /root/kgpu/models/Ternary-Bonsai-2-27B-PTQ1_0.gguf --alias prism-ml/Ternary-Bonsai-2-27B-PTQ1_0 --host 127.0.0.1 --port 8093 --parallel 1 --ctx-size 131072 --cache-type-k q4_0 --cache-type-v q4_0 --flash-attn on -ngl 999 --no-webui
Restart=always
RestartSec=2
TimeoutStartSec=0
TimeoutStopSec=30
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
