# The fleet main chat server on the inference head (root@100.82.98.110).
#
# Captured into the repo 2026-07-25 because it existed ONLY on that machine:
# infer.edn had documented `:infer/ctx 262144` for weeks while the unit that
# actually ran served --ctx-size 8192, and nothing in the repo could show the
# difference. Config that lives only on a box is config nobody can review.
#
# ── Qwen3.8 cutover, verified on this head 2026-08-15 ───────────────────────
#
#   source           Qwen/Qwen3.8-27B@1d4bf0f (Apache-2.0)
#   runtime          lmstudio-community Q4_K_M@5a7da681, 16.81GB
#   vision           BF16 mmproj, 0.93GB
#   architecture     dense 27B, 64 layers; native context 262144
#   device           Radeon 8060S (RADV GFX1151), 48 GiB VRAM carve-out
#   canary           exact text response + 64x64 solid-color vision passed
#   short decode     14.94 tok/s on a deterministic 7-token response
#
# Production deliberately starts at one 32768-token slot. Dense Qwen3.8 has a
# different KV/memory profile from the retired Qwen3.6 MoE, so the old 524288
# total-context measurement must not be carried forward as if it applied.
# Raise this only after a long-context memory and latency qualification run.
#
# Install:  scp deploy/llama-server.service root@<head>:/etc/systemd/system/ \
#           && ssh root@<head> 'systemctl daemon-reload && systemctl restart llama-server'
# Verify through the sole public boundary:
#           curl -s https://api.murakumo.cloud/ready \
#             | jq '.inference.request-capacity'
[Unit]
Description=Legacy standalone llama.cpp server (superseded by lightweight proxy)
After=network.target

[Service]
Type=simple
User=gad
WorkingDirectory=/home/gad/llamacpp-vk
Environment="LD_LIBRARY_PATH=/home/gad/llamacpp-vk"
ExecStart=/home/gad/llamacpp-vk/llama-server -m /home/gad/models/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf --mmproj /home/gad/models/Qwen3.8-27B-GGUF/mmproj-Qwen3.8-27B-BF16.gguf --host 0.0.0.0 --port 11434 -ngl 999 --ctx-size 32768 --parallel 1 --jinja --api-key-file /etc/murakumo/fleet-origin.keys
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# The production head is murakumo-ring.service on :8090. Do not enable this
# unit alongside murakumo-legacy-infer-proxy.service: doing so loads the same
# dense 27B model twice. This unit remains as the immediate rollback target.
