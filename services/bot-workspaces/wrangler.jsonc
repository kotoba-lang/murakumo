{
  "name": "murakumo-bot-workspaces",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "BrowserTeam",
        "name": "BROWSER_TEAMS"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "Sandbox"
      ],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": [
        "BrowserTeam"
      ],
      "tag": "v2"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  }
}
