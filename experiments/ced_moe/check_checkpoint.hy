"""Fleet-only restart, exact snapshot and deliberate-fault controls."""
(import argparse copy json pathlib shutil subprocess sys)
(import mlx.core :as mx)
(import stream_checkpoint :as ckpt)
(import memory_policy [require-hard-memory-enforcer])
(import process_memory [counters])

(defn check [data output [dtype "float32"]]
  (setv guard (require-hard-memory-enforcer (* 2 (** 1024 3)))
        root (pathlib.Path output) code (getattr (pathlib.Path __file__) "parent"))
  (.mkdir root :parents True :exist_ok False)
  (defn run-case [name steps [resume None]]
    (setv target (/ root name)
          command [sys._base_executable "-m" "hy" (str (/ code "train.hy"))
                   "--data" data "--output" (str target) "--preset" "tiny"
                   "--dtype" dtype "--optimizer" "sgd" "--master-offload" "nvme"
                   "--steps" (str steps) "--seq" "16" "--batch" "1"
                   "--eval-every" "2" "--eval-batches" "1" "--memory-limit-gib" "2"
                   "--max-seconds" "30" "--checkpoint" "--checkpoint-every" "2"])
    (when resume (.extend command ["--resume" (str resume)]))
    (with [log (open (/ root (+ name ".log")) "w")]
      (subprocess.run command :stdout log :stderr subprocess.STDOUT :check True :timeout 40))
    target)
  (setv whole (run-case "whole" 4)
        first (run-case "first" 2)
        boundary (/ first "checkpoint-2-rank-0")
        resumed (run-case "resumed" 2 boundary)
        left (/ whole "checkpoint-4-rank-0") right (/ resumed "checkpoint-4-rank-0")
        meta (json.loads (.read_text (/ boundary "state.json")))
        cfg (get meta "config") provenance (get meta "data_manifest_sha256")
        options (get meta "training_options") evaluation (get meta "evaluation_options")
        parent (/ root "boundary-reload"))
  (.mkdir parent)
  (setv [p state loaded] (ckpt.load boundary cfg provenance options evaluation parent))
  (for [key (get meta "parameter_order")]
    (setv weight (get (mx.load (str (/ boundary "weights" (+ key ".safetensors")))) "value")
          master (get (mx.load (str (/ boundary "master" (+ key ".safetensors")))) "value"))
    (assert (bool (mx.array-equal weight (get p key))) "snapshot weights changed")
    (assert (bool (mx.array-equal master (.read (get state "master") key))) "snapshot masters changed"))
  (assert (= (get meta "rng_state") (get loaded "rng_state")))
  (assert (= (lfor key mx.random.state (.tolist key)) (get meta "mlx_rng_state")))
  (.close (get state "master"))
  (setv errors {"weights" 0.0 "master" 0.0})
  (for [kind ["weights" "master"] key (get meta "parameter_order")]
    (setv a (get (mx.load (str (/ left kind (+ key ".safetensors")))) "value")
          b (get (mx.load (str (/ right kind (+ key ".safetensors")))) "value")
          error (float (mx.max (mx.abs (- a b)))))
    (setv (get errors kind) (max (get errors kind) error)))
  (when (= dtype "float32")
    (for [error (.values errors)] (assert (<= error 1e-4) (str errors))))
  (setv a (json.loads (.read_text (/ left "state.json")))
        b (json.loads (.read_text (/ right "state.json"))))
  (for [key ["rng_state" "mlx_rng_state" "step" "tokens_seen" "training_options"]]
    (assert (= (get a key) (get b key)) (+ "restart metadata differs: " key)))
  (setv refusals [])
  (defn must-refuse [label target [opts options] [prov provenance]]
    (setv refused False)
    (try (ckpt.inspect target cfg prov opts evaluation)
      (except [error ValueError] (setv refused True)))
    (assert refused (+ "corruption accepted: " label))
    (.append refusals label))
  (setv corrupt (/ root "corrupt"))
  (shutil.copytree boundary corrupt)
  (setv key (get (get meta "parameter_order") 0)
        file (/ corrupt "weights" (+ key ".safetensors")))
  (with [f (open file "r+b")]
    (.seek f -1 2) (setv byte (.read f 1)) (.seek f -1 2)
    (.write f (bytes [(^ (get byte 0) 1)])))
  (must-refuse "tensor-bit-flip" corrupt)
  (setv wrong-shape (/ root "wrong-shape"))
  (shutil.copytree boundary wrong-shape)
  (setv relative (+ "weights/" key ".safetensors") file (/ wrong-shape relative))
  (mx.save-safetensors (str file) {"value" (mx.zeros [1] :dtype mx.float32)})
  (setv modified (copy.deepcopy meta)
        (get (get (get modified "files") relative) "sha256") (ckpt.digest file)
        (get (get (get modified "files") relative) "file_bytes") (. (file.stat) st_size))
  (.write_text (/ wrong-shape "state.json") (json.dumps modified))
  (.write_text (/ wrong-shape "COMPLETE") (+ (ckpt.digest (/ wrong-shape "state.json")) "\n"))
  (must-refuse "valid-hash-but-wrong-tensor-shape" wrong-shape)
  (setv incomplete (/ root "interrupted.partial"))
  (.mkdir incomplete)
  (.write_text (/ incomplete "state.json") "{}")
  (must-refuse "interrupted-publication" incomplete)
  (setv changed (dict options) (get changed "lr") (* 2 (get options "lr")))
  (must-refuse "changed-optimizer-options" boundary changed)
  (must-refuse "changed-corpus" boundary options "deliberately-wrong-digest")
  (setv broken (/ root "broken-seal"))
  (.mkdir broken)
  (.write_text (/ broken "state.json") (.read_text (/ boundary "state.json")))
  (.write_text (/ broken "COMPLETE") "wrong\n")
  (must-refuse "metadata-seal" broken)
  (setv result {"ok" True "dtype" dtype "continuous_steps" 4 "split_steps" [2 2]
               "boundary_weight_master_rng_exact" True "max_abs_errors" errors
               "continuation_absolute_tolerance" (when (= dtype "float32") 1e-4)
               "bf16_end_to_end_bitwise_qualified" False "metadata_and_sampler_match" True
               "refusals" refusals "kernel_limit" guard "process_memory" (counters)
               "schema" ckpt.SCHEMA "source_sha256" (ckpt.source-fingerprint)})
  (.write_text (/ root "result.json") (json.dumps result :indent 2))
  (print (json.dumps result)))

(when (= __name__ "__main__")
  (setv parser (argparse.ArgumentParser))
  (.add_argument parser "--data" :required True)
  (.add_argument parser "--output" :required True)
  (.add_argument parser "--dtype" :choices ["float32" "bfloat16"] :default "float32")
  (setv args (.parse_args parser))
  (check args.data args.output args.dtype))
