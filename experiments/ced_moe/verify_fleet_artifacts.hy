"""Fleet-only separate-process readback of complete3B checkpoint generations."""
(import argparse json pathlib time)
(import hashlib)
(import numpy :as np)
(import fleet_checkpoint :as c)
(import fleet_mesh [Mesh])
(import memory_policy [require-hard-memory-enforcer])
(import process_memory [counters])

(defn run [args]
  (setv guard (require-hard-memory-enforcer (* 10 (** 1024 3)))
        mesh (Mesh args.world_size) started (time.monotonic) io-start (counters)
        root (pathlib.Path args.final)
        first (pathlib.Path args.prefix)
        common (get (json.loads (.read_text (/ root "state.json"))) "common")
        cfg (get common "config") options (get common "options")
        provenance (get common "data_manifest_sha256") errors [] meta [] digests [])
  (c.base.ensure (and (= (get cfg "name") "3b") (= (get options "world_size") mesh.world)) "3B actual layout required")
  (for [path [first root]]
    (try
      (setv [state sha] (c.inspect-local path cfg options provenance mesh.rank mesh.world))
      (.append meta state) (.append digests sha)
      (except [failure Exception] (.append errors (str failure)))))
  (setv reports (mesh.gather {"rank" mesh.rank "errors" errors "manifest_sha256" digests}))
  (for [report reports] (c.base.ensure (not (get report "errors")) "artifact readback failed on a rank"))
  (c.base.ensure (= (len (set (lfor r reports (json.dumps (get r "manifest_sha256")))) ) 1) "global generation mismatch")
  (c.base.ensure (= (get (get (get meta 0) "common") "step") 16) "expected prefix16")
  (c.base.ensure (= (get (get (get meta 1) "common") "step") 32) "expected final32")
  (setv corpus (pathlib.Path args.data)
        tokens (np.memmap (/ corpus "train.bin") :dtype np.uint16 :mode "r")
        rng (np.random.default_rng 936) expected-inputs [] seq (get options "sequence"))
  (c.base.ensure (= (c.base.digest (/ corpus "manifest.json")) provenance) "actual corpus manifest changed")
  (for [step (range 1 33)]
    (setv starts (.integers rng 0 (- (len tokens) seq 1) :size 1)
          rows (np.stack (lfor s starts (get tokens (slice s (+ s seq 1)))))
          x (.astype (get rows #(... (slice None -1))) np.int32)
          y (.astype (get rows #(... (slice 1 None))) np.int32))
    (.append expected-inputs (.hexdigest (hashlib.sha256 (+ (.tobytes x) (.tobytes y)))))
    (when (in step [16 32])
      (c.base.ensure (= rng.bit_generator.state
                       (get (get (get meta (if (= step 16) 0 1)) "common") "sampler_rng_state"))
                    "saved sampler state does not match processed global tokens")))
  (setv prefix-result (json.loads (.read_text (/ first.parent "result.json")))
        final-result (json.loads (.read_text (/ root.parent "result.json"))))
  (c.base.ensure (= (get prefix-result "end_step") (get final-result "start_step") 16) "optimizer boundary step mismatch")
  (c.base.ensure (= (get prefix-result "final_validation_ce") (get final-result "initial_validation_ce")) "boundary CE mismatch")
  (c.base.ensure (= expected-inputs (+ (get prefix-result "input_sha256") (get final-result "input_sha256"))) "training inputs do not match sampler")
  (c.base.ensure (= (get prefix-result "confirmation_initial") (get final-result "confirmation_initial")) "confirmation baseline changed")
  (for [result [prefix-result final-result] row (get result "trace")]
    (c.base.ensure (= (get row "learning_rate") (* (get options "lr") (min 1.0 (/ (get row "step") (get options "warmup_steps"))))) "warmup/global optimizer step mismatch"))
  (setv counts {"weights" 0 "master" 0 "m" 0 "v" 0} total {"weights" 0 "master" 0 "m" 0 "v" 0})
  (for [[name value] (.items (get (get meta 1) "files"))]
    (setv kind (get value "kind"))
    (+= (get total kind) 1)
    (when (!= (get value "sha256") (get (get (get (get meta 0) "files") name) "sha256"))
      (+= (get counts kind) 1)))
  (c.base.ensure (> (get counts "weights") 0) "no owned weight updates observed")
  (c.base.ensure (> (get counts "master") 0) "no owned master updates observed")
  (for [kind ["m" "v"]] (c.base.ensure (> (get counts kind) 0) "no owned moment updates observed"))
  (setv memory (counters) result {"pass" True "rank" mesh.rank "world_size" mesh.world
       "manifest_sha256" digests "owned_tensor_shards_per_generation" (len (get (get meta 1) "files"))
       "expected_input_sha256" expected-inputs "sampler_states_exact" True "optimizer_step_schedule_exact" True "boundary_ce_exact" True "training_inputs_exact" True
       "changed_shards_16_to_32" counts "owned_parameters_per_kind" total
       "file_bytes_per_generation" (lfor state meta (sum (gfor v (.values (get state "files")) (get v "file_bytes"))))
       "seconds" (- (time.monotonic) started) "memory_enforcer" guard "process_memory" memory
       "process_read_bytes" (- (get memory "disk_read_bytes") (get io-start "disk_read_bytes"))
       "scope" "separate-process all-file hash/header/layout/source/runtime/data/options/global-seal readback; no model execution"})
  (.write_text (pathlib.Path args.output) (json.dumps result :indent 2))
  (print (json.dumps result)))

(when (= __name__ "__main__")
  (setv parser (argparse.ArgumentParser))
  (.add_argument parser "--world-size" :type int :required True)
  (.add_argument parser "--prefix" :required True)
  (.add_argument parser "--final" :required True)
  (.add_argument parser "--output" :required True)
  (.add_argument parser "--data" :default "data")
  (run (.parse_args parser)))
