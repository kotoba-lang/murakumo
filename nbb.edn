;; nbb (ClojureScript-on-Node) config for ops/task shells.
;; Note: nbb does not resolve :deps from bb.edn; list deps here.
;; W6 cljs oracle load: paths include resources/ for KIR artifacts;
;; kotoba-kir executes precompiled pure-planner documents.
{:paths ["src" "resources"]
 :deps {
        io.github.kotoba-lang/org-chainagnostic-cacao {:git/sha "6bf973223a95e5f63e8893662d10521927a9c5a2"}
        ;; Declared HERE and not only in deps.edn: nbb reads nbb.edn and does NOT
        ;; read deps.edn or bb.edn, and the .cljs in this repo are run as
        ;; bare `nbb <file>`. A coordinate they cannot see is not a
        ;; declaration. sha and :paths are COPIED from deps.edn.
        io.github.kotoba-lang/edn {:git/url "https://github.com/kotoba-lang/edn.git" :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
io.github.kotoba-lang/osaho
        {:git/url "https://github.com/kotoba-lang/osaho.git"
         :git/sha "d58972da61758584a5bec0e863bcb3ea6fdd6c64"}}}
