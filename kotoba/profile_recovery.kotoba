;; JUN-156: a bounded, model-only Itonami profile step and automatic recovery.
;; Compose after git_checkpoint and its pinned native dependency closure.
;; The host supplies reviewed immutable profile/runtime pins and fresh tool
;; grants. SOUL and itonami.edn are data, never an authority source. No model
;; output is dispatched as a tool. This adapter does not run legacy cron scripts.
;; Transport is an explicitly admitted curl oneshot in the existing user
;; manager, not a detached child escaping the native spawn's 10-second budget.
(ns murakumo.profile-recovery
  (:export [profile-recovery-main]))

(defn- pr-json-quote [s :string] :string
  (let [b (cp-bytes s) out (vector-alloc (+ 2 (* 6 (vector-count b)))) z (vector-assoc! out 0 34)
        end (loop [i 0 p 1]
          (if (= i (vector-count b)) p
            (let [c (vector-at b i)]
              (cond (or (= c 34) (= c 92))
                    (let [x (vector-assoc! out p 92) y (vector-assoc! out (+ p 1) c)] (recur (+ i 1) (+ p 2)))
                    (< c 32)
                    (let [a (vector-assoc! out p 92) c0 (vector-assoc! out (+ p 1) 117)
                          d (vector-assoc! out (+ p 2) 48) e (vector-assoc! out (+ p 3) 48)
                          f (vector-assoc! out (+ p 4) (string-code-point-at "0123456789abcdef" (quot c 16)))
                          g (vector-assoc! out (+ p 5) (string-code-point-at "0123456789abcdef" (rem c 16)))]
                      (recur (+ i 1) (+ p 6)))
                    :else (let [x (vector-assoc! out p c)] (recur (+ i 1) (+ p 1)))))))
        y (vector-assoc! out end 34)]
    (cp-text (loop [i 0 v (vector-alloc (+ end 1))]
      (if (> i end) v (recur (+ i 1) (vector-assoc! v i (vector-at out i))))))))

(defn- pr-pause [] :bool (arena-scope (cp-ok? (cp-spawn (str "/usr/bin/sleep" (cp-a) "1")))))
(defn- pr-unit-state [unit :string] :string
  ;; A failed query is not evidence that the unit does not exist. Inspect the
  ;; load state separately so only an explicit not-found permits first submit.
  (let [load (cp-spawn (str "/usr/bin/systemctl" (cp-a) "--user" (cp-a) "show" (cp-a)
               "--property=LoadState" (cp-a) "--value" (cp-a) unit))
        value (if (cp-ok? load) (cp-line (cp-out load)) "")]
    (cond (= value "not-found") "unit/not-found"
          (not (= value "loaded")) "unit/unknown"
          :else (let [sub (cp-spawn (str "/usr/bin/systemctl" (cp-a) "--user" (cp-a) "show" (cp-a)
                            "--property=SubState" (cp-a) "--value" (cp-a) unit))]
                  (if (cp-ok? sub) (cp-line (cp-out sub)) "unit/unknown")))))

(defn- pr-unit-active? [s :string] :bool
  (or (= s "start-pre") (= s "start") (= s "start-post") (= s "running")))

(defn- pr-unit-code [unit :string] :i64
  (arena-scope
    (let [s (pr-unit-state unit)]
      (cond (= s "exited") 1 (pr-unit-active? s) 0 :else -1))))

;; A request is created only after an explicit not-found observation and
;; before any submission. A leftover request or marker is UNKNOWN, including
;; after a crash between the durable marker and the systemd call. Existing
;; units may only be observed when their request bytes still match.
;; The caller must serialize writers to this private cache directory.
(defn- pr-run-decision [status :string request-exists :bool request-matches :bool
                       marker-exists :bool response-exists :bool] :string
  (cond (and (or (pr-unit-active? status) (= status "exited"))
             request-exists request-matches) "profile/reuse-unit"
        (and (= status "unit/not-found") (not request-exists)
             (not marker-exists) (not response-exists)) "profile/new-unit"
        :else "profile/submission-unknown"))

(defn- pr-prepare-submit [request :string marker :string body :vector-i64] :bool
  (and (cp-absent? request) (cp-absent? marker)
       (cp-write request body)
       (= (cp-fs "M" (cp-parent-dir request) "") "1")
       (cp-write marker (cp-bytes "itonami.inference-dispatch/1\n"))
       (= (cp-fs "M" (cp-parent-dir marker) "") "1")))

;; This is a host-pinned transport description, not proof that the socket's
;; peer is the expected machine or that its model is qualified. The host must
;; authenticate the tunnel, own its directory, and protect the header file.
(defn- pr-local-mtp? [runtime :vector-i64] :bool
  (and (= (cp-str runtime 0 "kind") "itonami.readonly-profile-runtime-local-mtp/1")
       (= (cp-str runtime 0 "endpoint") "http://localhost/v1/chat/completions")
       (cp-safe-absolute? (cp-str runtime 0 "socket"))
       (cp-safe-absolute? (cp-str runtime 0 "authorizationFile"))
       (not (= (cp-str runtime 0 "socket") (cp-str runtime 0 "authorizationFile")))))

;; Paths and the content-addressed unit name are host-supplied. curl ignores
;; ~/.curlrc and redirects. The local variant cannot use a TCP proxy or select
;; a network URL: it sends only through the explicitly pinned Unix socket.
(defn- pr-submit [unit :string request :string response :string seconds :i64 runtime :vector-i64] :bool
  (cp-ok? (cp-spawn (str "/usr/bin/systemd-run" (cp-a) "--user" (cp-a) "--quiet" (cp-a) "--no-block"
    (cp-a) (str "--unit=" unit) (cp-a) "--property=Type=oneshot" (cp-a) "--property=RemainAfterExit=yes"
    (cp-a) "--property=TimeoutStartSec=900" (cp-a) "--property=NoNewPrivileges=yes"
    (cp-a) "--property=MemoryMax=128M" (cp-a) "--property=CPUQuota=25%"
    (cp-a) "/usr/bin/curl" (cp-a) "--disable" (cp-a) "--http1.1"
    (if (pr-local-mtp? runtime)
      (str (cp-a) "--noproxy" (cp-a) "*"
           (cp-a) "--unix-socket" (cp-a) (cp-str runtime 0 "socket")
           (cp-a) "--header" (cp-a) (str "@" (cp-str runtime 0 "authorizationFile"))
           (cp-a) "-fsS")
      (str (cp-a) "--proto" (cp-a) "=https" (cp-a) "--tlsv1.2" (cp-a) "--fail-with-body"
           (cp-a) "--silent" (cp-a) "--show-error"))
    (cp-a) "--connect-timeout" (cp-a) "5" (cp-a) "--max-time" (cp-a) (str seconds)
    (cp-a) "--header" (cp-a) "Content-Type: application/json" (cp-a) "--data-binary" (cp-a) (str "@" request)
    (cp-a) "--output" (cp-a) response (cp-a)
    (if (pr-local-mtp? runtime) "http://localhost/v1/chat/completions" "https://api.murakumo.cloud/v1/chat/completions")))))

(defn- pr-answer [b :vector-i64] :string
  (if (not (json-valid? b)) ""
    (let [cs (json-member b 0 "choices") c (if (>= cs 0) (json-element b cs 0) -1)
          m (if (>= c 0) (json-member b c "message") -1)]
      ;; A nonempty prefix is not a completed turn. Refuse truncated,
      ;; tool-call, missing and unknown finish reasons rather than checkpointing
      ;; them as a completed profile step.
      (if (and (>= m 0) (= (cp-str b c "finish_reason") "stop")) (cp-str b m "content") ""))))

;; The local server must report the requested model and actual MTP execution.
;; This is response evidence, not an attestation of the server or its weights;
;; the host still has to authenticate and qualify the socket peer.
(defn- pr-mtp-response? [runtime :vector-i64 b :vector-i64] :bool
  (if (not (json-valid? b)) false
    (let [s (json-member b 0 "mtplx_stats")
          enabled (if (>= s 0) (json-member b s "runtime_mtp_enabled") -1)
          head (if (>= s 0) (json-member b s "draft_head_installed") -1)]
      (and (>= s 0) (= (cp-str b 0 "model") (cp-str runtime 0 "model"))
           (= (cp-str b s "generation_mode") "mtp")
           (>= enabled 0) (= (json-kind b enabled) 5)
           (>= head 0) (= (json-kind b head) 5)
           (> (cp-num b s "mtp_forward_calls") 0)))))

;; The server's diagnostic-heavy response can exceed the peer's 16 KiB block
;; limit. Keep the full model text and only the fields needed for continuation
;; and MTP admission. Bind the compact record to the raw cache bytes by hash;
;; the hash alone does not make the raw response available on a recovery host.
(defn- pr-mtp-compact [runtime :vector-i64 b :vector-i64] :vector-i64
  (let [answer (pr-answer b) stats (if (json-valid? b) (json-member b 0 "mtplx_stats") -1)]
    (if (or (= answer "") (not (pr-mtp-response? runtime b))) (vector-alloc 0)
      (cp-bytes (str "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"content\":" (pr-json-quote answer)
        "}}],\"model\":" (pr-json-quote (cp-str b 0 "model"))
        ",\"mtplx_stats\":{\"draft_head_installed\":true,\"generation_mode\":\"mtp\",\"mtp_forward_calls\":"
        (cp-num b stats "mtp_forward_calls") ",\"runtime_mtp_enabled\":true},\"rawResponseDigest\":\"sha256:"
        (sha256-hex b) "\"}")))))

(defn- pr-replicable? [b :vector-i64] :bool
  (and (> (vector-count b) 0) (<= (vector-count b) 16384)))

;; A crash can leave the output durable while state still points at this turn.
;; Only the exact completed response may be reused. Sync both the file and
;; its parent directory before state can refer to it.
(defn- pr-save-output [path :string answer :vector-i64 cid :string] :bool
  (let [status (cp-fs "D" path "")]
    (and (cond (= status "1") (and (= (cp-cid (cp-read path)) cid) (= (cp-fs "M" path "") "1"))
               (= status "0") (cp-write path answer)
               :else false)
         (= (cp-fs "M" (cp-parent-dir path) "") "1"))))

;; Recover a fully written but unpublished state only when the exact request,
;; durable dispatch marker, finished response, saved output and candidate
;; state all agree. The caller holds the private task's single-writer lock.
;; Never dispatch again here. Unknown filesystem or sync outcomes remain for
;; host reconciliation and must not be treated as a completed turn.
(defn- pr-reconcile-pending [repo :string runtime :vector-i64 next :i64 task :string state :vector-i64
                            body :vector-i64 unit :string request :string marker :string response :string] :string
  (let [tmp (str repo "/state.json.tmp") outdir (str repo "/outputs")
        output (str outdir "/" next ".json") statepath (str repo "/state.json")
        ready (and (= (pr-unit-state unit) "exited")
                   (= (cp-fs "D" tmp "") "1") (= (cp-fs "D" request "") "1")
                   (= (cp-fs "D" marker "") "1") (= (cp-fs "D" response "") "1")
                   (= (cp-fs "D" output "") "1")
                   (= (cp-cid (cp-read request)) (cp-cid body))
                   (= (cp-text (cp-read marker)) "itonami.inference-dispatch/1\n"))]
    (if (not ready) "profile/state-publication-unknown"
      (let [raw (cp-read response) completed (and (not (= (pr-answer raw) ""))
                        (or (not (pr-local-mtp? runtime)) (pr-mtp-response? runtime raw)))
            answer (if completed (if (pr-local-mtp? runtime) (pr-mtp-compact runtime raw) raw) (vector-alloc 0))
            cid (cp-cid answer) expected (cp-bytes (str "{\"next\":" (+ next 1) ",\"previous\":\"" cid "\",\"task\":\"" task "\"}"))
            valid (and completed (pr-replicable? answer) (= (cp-cid (cp-read output)) cid)
                       (= (cp-cid (cp-read tmp)) (cp-cid expected))
                       (= (cp-cid (cp-read statepath)) (cp-cid state)))
            durable (and valid (= (cp-fs "M" output "") "1") (= (cp-fs "M" outdir "") "1")
                         (= (cp-fs "M" tmp "") "1") (= (cp-fs "M" repo "") "1"))
            renamed (and durable (= (cp-fs "L" tmp statepath) "1"))
            synced (and renamed (= (cp-fs "M" repo "") "1"))]
        (if synced (str "profile/step-completed " next " " cid) "profile/state-publication-unknown")))))

(defn- pr-wait [unit :string response :string runtime :vector-i64] :bool
  (loop [i 0]
    (let [state (pr-unit-code unit)]
      (cond (= state 1)
            (and (cp-exists? response)
                 (let [b (cp-read response)]
                   (and (not (= (pr-answer b) ""))
                        (or (not (pr-local-mtp? runtime)) (pr-mtp-response? runtime b)))))
            (or (= state -1) (> i 900)) false
            :else (let [z (pr-pause)] (if z (recur (+ i 1)) false))))))

(defn- pr-runtime? [runtime :vector-i64 meta :vector-i64 role :vector-i64] :bool
  (and (json-canonical? runtime)
       (or (and (= (cp-str runtime 0 "kind") "itonami.readonly-profile-runtime/1")
                (= (cp-str runtime 0 "endpoint") "https://api.murakumo.cloud/v1/chat/completions"))
           (pr-local-mtp? runtime))
       (= (cp-str runtime 0 "rail") "murakumo")
       (= (str "sha256:" (sha256-hex meta)) (cp-str runtime 0 "profileDigest"))
       (= (str "sha256:" (sha256-hex role)) (cp-str runtime 0 "roleDigest"))
       (= (cp-str runtime 0 "profile") "accountability-steward")
       (not (= (cp-str runtime 0 "model") ""))
       (cp-hex? (cp-str runtime 0 "source") 40)
       (not (= (cp-str runtime 0 "task") "")) (= (field-problem (cp-str runtime 0 "task")) "enroll/ok")
       (>= (string-index-of (cp-text meta) ":capabilities []") 0)
       (>= (string-index-of (cp-text meta) ":rails [:murakumo]") 0)
       (>= (string-index-of (cp-text meta) ":authorities [\"api.murakumo.cloud\"]") 0)))

;; A separate, host-pinned read-only lane for the AWAI growth steward. The
;; profile metadata does not grant any of its listed capabilities: this
;; adapter only asks the model for a draft and never dispatches tool calls.
;; The host selects and pins both the work order and the bounded source
;; snapshot; neither is a live observation or an authorization.
(defn- pr-growth-runtime? [runtime :vector-i64 meta :vector-i64 role :vector-i64 work :vector-i64 context :vector-i64] :bool
  (and (json-canonical? runtime) (pr-local-mtp? runtime)
       (let [i (json-member runtime 0 "maxTokens")]
         (or (< i 0) (and (json-int-ok? runtime i) (>= (json-int runtime i) 64) (<= (json-int runtime i) 768))))
       (= (cp-str runtime 0 "rail") "murakumo") (= (cp-str runtime 0 "tools") "none")
       (= (cp-str runtime 0 "profile") "awai-growth-steward")
       (not (= (cp-str runtime 0 "model") ""))
       (= (str "sha256:" (sha256-hex meta)) (cp-str runtime 0 "profileDigest"))
       (= (str "sha256:" (sha256-hex role)) (cp-str runtime 0 "roleDigest"))
       (= (str "sha256:" (sha256-hex work)) (cp-str runtime 0 "workDigest"))
       (= (str "sha256:" (sha256-hex context)) (cp-str runtime 0 "contextDigest"))
       (> (vector-count work) 0) (<= (vector-count work) 8192)
       (> (vector-count context) 0) (<= (vector-count context) 8192)
       (cp-hex? (cp-str runtime 0 "source") 40)
       (not (= (cp-str runtime 0 "task") "")) (= (field-problem (cp-str runtime 0 "task")) "enroll/ok")
       (>= (string-index-of (cp-text meta) ":profile/id \"awai-growth-steward\"") 0)
       (>= (string-index-of (cp-text meta) ":rails [:murakumo]") 0)
       (>= (string-index-of (cp-text meta) ":authorities [\"api.murakumo.cloud\"]") 0)))

(defn- pr-step-range [repo :string runtime :vector-i64 cache :string next :i64 seconds :i64 limit :i64 tokens :i64] :string
  (let [dir (str repo "/profile") meta (cp-read (str dir "/itonami.edn")) role (cp-read (str dir "/SOUL.md"))
        growth (= (cp-str runtime 0 "profile") "awai-growth-steward")
        work-path (str dir "/tasks/first-turn.md") context-path (str dir "/context.md")
        work (if (and growth (cp-exists? work-path)) (cp-read work-path) (vector-alloc 0))
        context (if (and growth (cp-exists? context-path)) (cp-read context-path) (vector-alloc 0))
        state (cp-read (str repo "/state.json")) task (cp-str runtime 0 "task")]
    (cond (or (< seconds 1) (> seconds 840)) "profile/budget-refused"
          (not (or (pr-runtime? runtime meta role) (pr-growth-runtime? runtime meta role work context))) "profile/runtime-refused"
          (or (not (json-canonical? state)) (not (= (cp-num state 0 "next") next)) (< next 1) (> next limit)
              (not (= (cp-str state 0 "task") task))) "profile/state-refused"
          :else
          (let [previous (cp-str state 0 "previous") prior-file (str repo "/outputs/" (- next 1) ".json")
                prior (if (= next 1) (vector-alloc 0) (cp-read prior-file))
                linked (if (= next 1) (= previous "none")
                         (and (= previous (cp-cid prior)) (not (= (pr-answer prior) ""))
                              (or (not (pr-local-mtp? runtime)) (pr-mtp-response? runtime prior))))]
            (if (not linked) "profile/previous-output-mismatch"
              (let [instruction (if growth
                       (str "Read-only AWAI growth steward task " task ", step " next ".\n"
                         (cp-text work) "\n\nBounded source snapshot, not live observations:\n" (cp-text context)
                         "\nAll tools are denied. Do not change files, publish, merge or contact anyone."
                         " Do not invent observations or report completion of unperformed work."
                         " Use a concise six-row table with next job, evidence and stop condition for each role."
                         " Use each full role ID. Avoid repeated evidence and source snapshot details."
                         " Keep the whole answer under 450 tokens. End with brief unknowns and next handoff.")
                       (if (= limit 2) (str "Read-only checkpoint recovery task " task ", step " next
                       ". Continue from the preceding assistant result, if present. Propose one next read-only verification."
                       " Do not call tools, change files, publish, merge or contact anyone. Reply in at most 16 tokens.")
                       (str "Resident accountability-steward proposal turn " next ", task " task
                         ". Follow the profile's propose-only goal and continue from the preceding proposal."
                         " State one concrete next verification and what evidence would decide it."
                         " You have no current external observations; do not invent progress or completion."
                         " All tools are denied. Do not change files, publish, merge or contact anyone.")))
                    body (str "{\"chat_template_kwargs\":{\"enable_thinking\":false},\"max_tokens\":" tokens ",\"messages\":["
                      "{\"content\":" (pr-json-quote (str "This invocation is a model-only read-only proposal. All tools are denied.\n" (cp-text role))) ",\"role\":\"system\"},"
                      (if (= next 1) "" (str "{\"content\":" (pr-json-quote (pr-answer prior)) ",\"role\":\"assistant\"},"))
                      "{\"content\":" (pr-json-quote instruction) ",\"role\":\"user\"}],\"model\":" (pr-json-quote (cp-str runtime 0 "model"))
                      ",\"reasoning_effort\":\"none\",\"stream\":false,\"temperature\":0}")
                    id (sha256-hex (cp-bytes (if (pr-local-mtp? runtime)
                         (str "local-mtp\n" (cp-str runtime 0 "socket") "\n" (cp-str runtime 0 "authorizationFile") "\n" body)
                         body))) unit (str "itonami-recovery-" (string-substring id 0 24) ".service")
                    request (str cache "/" id ".request.json") response (str cache "/" id ".response.json")
                    marker (str cache "/" id ".dispatch") body-bytes (cp-bytes body)
                    request-status (cp-fs "D" request "") marker-status (cp-fs "D" marker "") response-status (cp-fs "D" response "")
                    pending-status (cp-fs "D" (str repo "/state.json.tmp") "")
                    known (and (or (= request-status "0") (= request-status "1"))
                               (or (= marker-status "0") (= marker-status "1"))
                               (or (= response-status "0") (= response-status "1")))
                    present (= request-status "1") matches (if present (= (cp-cid (cp-read request)) (cp-cid body-bytes)) false)
                    decision (if (and known (= pending-status "0"))
                               (pr-run-decision (pr-unit-state unit) present matches (= marker-status "1") (= response-status "1")) "profile/submission-unknown")
                    submitted (cond (= decision "profile/reuse-unit") true
                                    (= decision "profile/new-unit")
                                    (and (pr-prepare-submit request marker body-bytes)
                                         (pr-submit unit request response seconds runtime))
                                    :else false)]
                (if (= pending-status "1")
                  (pr-reconcile-pending repo runtime next task state body-bytes unit request marker response)
                (if (not (= pending-status "0")) "profile/state-publication-unknown"
                (if (or (not submitted) (not (pr-wait unit response runtime))) "profile/inference-unavailable-state-retained"
                  (let [raw (cp-read response)
                        answer (if (pr-local-mtp? runtime) (pr-mtp-compact runtime raw) raw)
                        cid (cp-cid answer)
                        outdir (str repo "/outputs") output (str outdir "/" next ".json")
                        newstate (cp-bytes (str "{\"next\":" (+ next 1) ",\"previous\":\"" cid "\",\"task\":\"" task "\"}"))
                        tmp (str repo "/state.json.tmp")
                        usable (pr-replicable? answer)
                        ok (and usable
                                (cp-mkdir outdir) (= (cp-fs "M" repo "") "1")
                                (pr-save-output output answer cid) (cp-write tmp newstate))
                        rename (if ok (cp-fs "L" tmp (str repo "/state.json")) "0")
                        sync (if (= rename "1") (cp-fs "M" repo "") "0")]
                    (if (not usable) "profile/response-not-replicable"
                      (if (= sync "1") (str "profile/step-completed " next " " cid) "profile/state-publication-failed"))))))))))))

(defn- pr-token-budget [runtime :vector-i64 resident :bool] :i64
  (if (= (cp-str runtime 0 "profile") "awai-growth-steward")
    (let [limit (cp-num runtime 0 "maxTokens")] (if (and (>= limit 64) (<= limit 768)) limit 768))
    (if resident 256 32)))

(defn- pr-step-bounded [repo :string runtime :vector-i64 cache :string next :i64 seconds :i64] :string
  (pr-step-range repo runtime cache next seconds 2 (pr-token-budget runtime false)))

(defn- pr-step-resident [repo :string runtime :vector-i64 cache :string next :i64 seconds :i64] :string
  (pr-step-range repo runtime cache next seconds 1000000 (pr-token-budget runtime true)))

(defn- pr-step [repo :string runtime :vector-i64 cache :string next :i64] :string
  (pr-step-bounded repo runtime cache next 840))

;; A task-owned producer's heartbeat. The worker holds this only after its
;; checkpoint is replicated. No claim about a physical host or fleet consensus.
(defn- pr-hold [address :string] :i64
  (let [listener (typed-cap-call 43 :string :string address) ready (cp-say "profile/producer-holding")]
    (loop [i 0]
      (let [handled (arena-scope (let [c (typed-cap-call 44 :string :string (str listener " 1000"))]
        (if (> (cp-int c) 0)
          (let [w (typed-cap-call 47 :string :string (str c " 616c6976650a"))
                z (typed-cap-call 47 :string :string c)] 1) 0)))]
        (recur (+ i handled))))))

(defn- pr-alive? [peer :string] :bool
  (arena-scope
    (let [c (typed-cap-call 45 :string :string (str peer " 1000"))]
      (if (<= (cp-int c) 0) false
        (let [r (loop [i 0 bytes ""]
                  (if (or (>= (string-length bytes) 12) (>= i 6)) bytes
                    (let [part (typed-cap-call 46 :string :string (str c " 6 1000"))]
                      (if (= part "") bytes (recur (+ i 1) (str bytes part))))))
              z (typed-cap-call 47 :string :string c)]
          (= r "616c6976650a"))))))

(defn- pr-resume [store :string cid :string contract :vector-i64 dest :string cache :string] :string
  (if (or (not (json-canonical? contract)) (not (cp-block? store cid))) "profile/contract-refused"
    (let [b (cp-load store cid) v (checkpoint-problem b (cp-str contract 0 "author") (cp-str contract 0 "profile")
          (cp-str contract 0 "policy") (cp-str contract 0 "environment") (cp-num contract 0 "epoch")
          (cp-str contract 0 "parent") (cp-str contract 0 "task"))]
      (cond (not (= v "checkpoint/ok")) v
            (not (cp-closure? store b)) "checkpoint/missing-or-corrupt-block"
            :else (let [restored (cp-materialize store b dest)]
              (if (not (= restored "checkpoint/restored")) restored
                (let [report (cp-say "profile/automatically-restored")]
                  (pr-step dest (cp-load store (cp-str contract 0 "environment")) cache (cp-num contract 0 "next")))))))))

(defn profile-recovery-main [] :i64
  (cond (= (cp-arg 0) "step")
        (cp-say (pr-step (cp-arg 1) (cp-read (cp-arg 2)) (cp-arg 3) (cp-int (cp-arg 4))))
        (= (cp-arg 0) "hold") (pr-hold (cp-arg 1))
        (= (cp-arg 0) "watch")
        (let [requested (cp-int (cp-arg 7)) limit (if (and (> requested 0) (<= requested 1800)) requested 1800)]
        (loop [i 0 seen false failures 0]
          (let [alive (pr-alive? (cp-arg 1)) misses (if alive 0 (+ failures 1))]
            (if (and alive (not seen)) (cp-say "profile/producer-observed") 0)
            (cond (and seen (>= misses 2))
                  (let [v (cp-say "profile/producer-lost")]
                    (cp-say (pr-resume (cp-arg 2) (cp-arg 3) (cp-read (cp-arg 4)) (cp-arg 5) (cp-arg 6))))
                  (>= i limit) (cp-say "profile/watch-expired")
                  :else (let [z (pr-pause)] (recur (+ i 1) (or seen alive) misses))))))
        :else (cp-say "profile/command")))
