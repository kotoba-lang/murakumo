(ns deploy-plan-core
  (:schemas {;; T5.2 native guest record wire
             :deploy/join-path [:record :deploy/join-path
                                [[:a :string] [:b :string]]]
             :deploy/app-manifest [:record :deploy/app-manifest
                                   [[:manifest-dir :string] [:manifest :string]]]
             :deploy/component-build [:record :deploy/component-build
                                      [[:kotoba :string] [:src-path :string]
                                       [:wit :string] [:wasm :string]]]
             :deploy/app-deploy [:record :deploy/app-deploy
                                 [[:kotoba :string] [:manifest :string]
                                  [:wit :string] [:port :i64]]]})
  (:export [default-wasm default-publish-node
            artifact-forward-port publish-forward-port
            forward-settle-ms placement-wait-ms
            digit-char nat-str i64-str
            app-manifest-path publish-selector
            localhost-url last-slash-index manifest-dir
            command-output component-build-cmd app-deploy-cmd
            digit-val? digit-of parse-digits-go parse-digits trim-ws
            execution-observed? execution-count-command
            release-wit-path stop-forward-command
            absolute-unix-git-bin? blank?
            pin-bin-kotoba pin-bin-server
            join-path release-wit-suffix
            pin-wit-dirname pin-wit-dest
            cp-bin rm-bin rm-rf-flag cp-recursive-flag
            git-c-flag git-rev-parse git-short-flag git-head-ref
            version-flag version-bin-path build-features
            missing-manifest? missing-operator-seed?
            component-subcmd build-subcmd app-subcmd deploy-subcmd
            wit-dir-flag output-flag publish-flag url-flag
            token-flag block-subcmd put-subcmd file-flag
            argv-join-sep localhost-url-prefix
            path-sep exec-count-prefix exec-count-suffix
            pkill-f-prefix stop-forward-suffix]))

;; W6 pure-planner oracle — murakumo.deploy.plan path/argv/constants core.
;; Vector argv maps, artifact distribution over nodes, regex extract stay cljc.
;; Guest ABI max arity 5: component-build joins 4 path args + bin.
;; Argv flag/bin fragments + deploy-command-error gates dual-source.
;; pin-wit-dest + join-path dual-source for pin-copy-plan path fragments.
;; component/app/block subcmd + flag fragments dual-source for argv vectors.
;; argv-join-sep + localhost-url-prefix dual-source; build/deploy cmds
;; and localhost-url recompose from fragment SSoTs.
;; path-sep + exec-count/stop-forward shell tokens dual-source;
;; join-path / app-manifest-path / execution-count / stop-forward recompose.
;; T5.2: multi-scalar pure inputs take single guest records.
;; Parity: test/murakumo/deploy_plan_kotoba_parity_test.clj

(defn default-wasm [] :string "/tmp/murakumo-deploy.wasm")
(defn default-publish-node [] :string "asher")
(defn artifact-forward-port [] :i64 18900)
(defn publish-forward-port [] :i64 18077)
(defn forward-settle-ms [] :i64 1300)
(defn placement-wait-ms [] :i64 75000)

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

;; ── residual path / probe shell tokens ───────────────────────────────

(defn path-sep [] :string
  ;; between path segments (join-path / app-manifest-path / slash scan)
  "/")

(defn exec-count-prefix [] :string
  ;; grep -c for lattice execution markers before CID
  "grep -c 'trigger: executed.*")

(defn exec-count-suffix [] :string
  ;; after CID: close quote + mesh log path + quiet stderr
  "' ~/.murakumo/mesh.log 2>/dev/null")

(defn pkill-f-prefix [] :string
  ;; start of pkill -f pattern for local port-forward
  "pkill -f '")

(defn stop-forward-suffix [] :string
  ;; after local-port in stop-forward-command
  ":localhost' 2>/dev/null")

(defn app-manifest-path [x [:ref :deploy/app-manifest]] :string
  ;; T5.2 native: manifest-dir + manifest file name
  (string-concat (record-get x :manifest-dir)
                 (string-concat (path-sep) (record-get x :manifest))))

(defn publish-selector [selector :string] :string
  ;; empty string ≡ cljc nil
  (if (string=? selector "")
    "asher"
    selector))

;; ── residual argv join + localhost URL prefix ────────────────────────

(defn argv-join-sep [] :string
  ;; space between space-joined cmd tokens (parity with host str/join)
  " ")

(defn localhost-url-prefix [] :string
  ;; scheme+host prefix before port for publish/local control URLs
  "http://localhost:")

(defn localhost-url [port :i64] :string
  (string-concat (localhost-url-prefix) (i64-str port)))

(defn last-slash-index [s :string i :i64 best :i64] :i64
  ;; scan [0,n) for last path-sep; returns -1 if none
  (let [n (string-byte-length s)]
    (if (< i n)
      (if (string=? (string-substring s i (+ i 1)) (path-sep))
        (last-slash-index s (+ i 1) i)
        (last-slash-index s (+ i 1) best))
      best)))

(defn manifest-dir [manifest :string] :string
  ;; cljc: replace trailing /file → "" ; if unchanged → "."
  (let [slash (last-slash-index manifest 0 -1)]
    (if (< slash 0)
      "."
      (string-substring manifest 0 slash))))

(defn ws? [c :string] :bool
  (if (string=? c " ")
    true
    (if (string=? c "\n")
      true
      (if (string=? c "\t")
        true
        (if (string=? c "\r") true false)))))

(defn trim [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (ws? (string-substring s 0 1))
        (trim (string-substring s 1 n))
        (if (ws? (string-substring s (- n 1) n))
          (trim (string-substring s 0 (- n 1)))
          s)))))

(defn command-output [out :string] :string
  (trim out))

;; ── residual component/app/block argv subcmd + flag fragments ────────

(defn component-subcmd [] :string "component")
(defn build-subcmd [] :string "build")
(defn app-subcmd [] :string "app")
(defn deploy-subcmd [] :string "deploy")
(defn wit-dir-flag [] :string "--wit-dir")
(defn output-flag [] :string "-o")
(defn publish-flag [] :string "--publish")
(defn url-flag [] :string "--url")
(defn token-flag [] :string "--token")
(defn block-subcmd [] :string "block")
(defn put-subcmd [] :string "put")
(defn file-flag [] :string "--file")

(defn component-build-cmd [x [:ref :deploy/component-build]] :string
  ;; space-joined form of component-build-argv; recomposes fragment SSoTs
  ;; T5.2 native: kotoba+src-path+wit+wasm
  (let [kotoba (record-get x :kotoba)
        src-path (record-get x :src-path)
        wit (record-get x :wit)
        wasm (record-get x :wasm)]
    (string-concat
     kotoba
     (string-concat
      (argv-join-sep)
      (string-concat
       (component-subcmd)
       (string-concat
        (argv-join-sep)
        (string-concat
         (build-subcmd)
         (string-concat
          (argv-join-sep)
          (string-concat
           src-path
           (string-concat
            (argv-join-sep)
            (string-concat
             (wit-dir-flag)
             (string-concat
              (argv-join-sep)
              (string-concat
               wit
               (string-concat
                (argv-join-sep)
                (string-concat (output-flag)
                               (string-concat (argv-join-sep) wasm))))))))))))))))

(defn app-deploy-cmd [x [:ref :deploy/app-deploy]] :string
  ;; space-joined form of app-deploy-argv; recomposes fragment SSoTs
  ;; T5.2 native: kotoba+manifest+wit+port
  (let [kotoba (record-get x :kotoba)
        manifest (record-get x :manifest)
        wit (record-get x :wit)
        port (record-get x :port)]
    (string-concat
     kotoba
     (string-concat
      (argv-join-sep)
      (string-concat
       (app-subcmd)
       (string-concat
        (argv-join-sep)
        (string-concat
         (deploy-subcmd)
         (string-concat
          (argv-join-sep)
          (string-concat
           manifest
           (string-concat
            (argv-join-sep)
            (string-concat
             (wit-dir-flag)
             (string-concat
              (argv-join-sep)
              (string-concat
               wit
               (string-concat
                (argv-join-sep)
                (string-concat
                 (publish-flag)
                 (string-concat
                  (argv-join-sep)
                  (string-concat
                   (url-flag)
                   (string-concat (argv-join-sep)
                                  (localhost-url port)))))))))))))))))))

(defn pin-bin-kotoba [] :string "kotoba")
(defn pin-bin-server [] :string "kotoba-server")

(defn release-wit-suffix [] :string
  "/../../../crates/kotoba-runtime/wit")

(defn blank? [s :string] :bool
  (let [n (string-byte-length s)]
    (if (= n 0)
      true
      (if (ws? (string-substring s 0 1))
        (blank? (string-substring s 1 n))
        false))))

(defn trim-ws [s :string] :string
  (trim s))

(defn digit-val? [c :string] :bool
  ;; true if single char is ASCII digit (tunnel_core pattern)
  (if (= (string-byte-length c) 1)
    (if (string-contains? "0123456789" c) true false)
    false))

(defn digit-of-go [digits :string c :string i :i64] :i64
  (let [n (string-byte-length digits)]
    (if (< i n)
      (if (string=? (string-substring digits i (+ i 1)) c)
        i
        (digit-of-go digits c (+ i 1)))
      0)))

(defn digit-of [c :string] :i64
  (digit-of-go "0123456789" c 0))

(defn parse-digits-go [s :string acc :i64] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      acc
      (let [c (string-substring s 0 1)]
        (if (digit-val? c)
          (parse-digits-go (string-substring s 1 n)
                           (+ (* acc 10) (digit-of c)))
          -1)))))

(defn parse-digits [s :string] :i64
  (let [t (trim-ws s)
        n (string-byte-length t)]
    (if (= n 0)
      -1
      (parse-digits-go t 0))))

(defn execution-observed? [grep-count-out :string] :bool
  ;; cljc: (pos? (Integer/parseInt (trim out))) catch false
  (let [n (parse-digits grep-count-out)]
    (if (< n 1) false true)))

(defn execution-count-command [cid :string] :string
  (string-concat
   (exec-count-prefix)
   (string-concat cid (exec-count-suffix))))

(defn join-path [x [:ref :deploy/join-path]] :string
  ;; T5.2 native: path segments a+b
  (string-concat (record-get x :a)
                 (string-concat (path-sep) (record-get x :b))))

(defn release-wit-path [release-dir :string] :string
  (string-concat release-dir (release-wit-suffix)))

(defn stop-forward-command [local-port :i64] :string
  (string-concat
   (pkill-f-prefix)
   (string-concat (i64-str local-port) (stop-forward-suffix))))

(defn absolute-unix-git-bin? [p :string] :bool
  ;; Unix absolute path, non-blank, not bare "git". Windows drive letter stays host.
  (if (blank? p)
    false
    (if (string=? p "git")
      false
      (if (< (string-byte-length p) 1)
        false
        (if (string=? (string-substring p 0 1) (path-sep)) true false)))))

;; ── residual pin/git argv fragments + deploy CLI gates ───────────────

(defn cp-bin [] :string "cp")
(defn rm-bin [] :string "rm")
(defn rm-rf-flag [] :string "-rf")
(defn cp-recursive-flag [] :string "-R")

(defn git-c-flag [] :string "-C")
(defn git-rev-parse [] :string "rev-parse")
(defn git-short-flag [] :string "--short")
(defn git-head-ref [] :string "HEAD")

(defn version-flag [] :string "--version")

(defn version-bin-path [dest :string] :string
  ;; cljc: (str dest "/kotoba")
  (join-path (record-new [:ref :deploy/join-path] dest (pin-bin-kotoba))))

(defn build-features [] :string
  "p2p,realtime-wasm,webrtc")

(defn missing-manifest? [manifest :string] :bool
  (blank? manifest))

(defn missing-operator-seed? [operator-seed :string] :bool
  (blank? operator-seed))

;; ── residual pin-copy-plan path fragments ────────────────────────────

(defn pin-wit-dirname [] :string
  ;; cljc: "wit" under pin dest
  "wit")

(defn pin-wit-dest [dest :string] :string
  ;; cljc: (str dest "/wit")
  (join-path (record-new [:ref :deploy/join-path] dest (pin-wit-dirname))))
