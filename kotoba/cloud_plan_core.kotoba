(ns cloud-plan-core
  (:export [default-driver default-cloud-name default-cloud-domain
            default-cloud-graph default-auth-key-env overlay-version
            digit-char nat-str i64-str
            node-region relay-score overlay-id-input node-id-input
            quic-endpoint webrtc-endpoint relay-endpoint-url
            webtransport-endpoint transport-endpoint
            dash-placeholder summary-nodes-header routes-header
            direct-candidates-label relays-section-label connects-section-label
            summary-title routes-title bootstrap-title
            unknown-node-line unknown-relay-line
            dial-denied-line connect-denied-line
            dial-ok-title connect-ok-title relay-ok-title
            from-to-cap-reason authorized-line
            relay-fallback-line reason-line indent-argv-line
            address-family-line policy-line skipped-reason-suffix
            starts-with?
            is-cmd-plan? is-cmd-records? is-cmd-routes?
            is-cmd-dial? is-cmd-connect? is-cmd-relay? is-cmd-bootstrap?
            is-flag-cloud? is-flag-fleet? is-flag-target?
            is-flag-from? is-flag-to? is-flag-capability?
            is-flag-driver? is-flag-format? is-flag-auth-key?
            is-flag-dash? is-positional-target?
            flag-cloud-value flag-fleet-value flag-target-value
            flag-from-value flag-to-value flag-capability-value
            flag-driver-value flag-format-value flag-auth-key-value]))

;; W6 pure-planner oracle — murakumo.cloud.plan scalar/string core (low).
;; graph-cid hashing, choose-relay sort, record maps stay cljc.
;; node-region: first non-empty of zone, region-label, region, else "global".
;; webtransport + generic transport endpoint URL fragments dual-source.
;; CLI presentation labels/line templates dual-source (width fmt stays host).
;; Summary address-family/policy lines dual-source (counts as i64).
;; parse-flags command/flag classifiers dual-source (reduce fold stays host).
;; Parity: test/murakumo/cloud_plan_kotoba_parity_test.clj

(defn default-driver [] :string "murakumo-overlay")
(defn default-cloud-name [] :string "murakumo.cloud")
(defn default-cloud-domain [] :string "murakumo.cloud")
(defn default-cloud-graph [] :string "murakumo-cloud")
(defn default-auth-key-env [] :string "MURAKUMO_OVERLAY_AUTH_KEY")
(defn overlay-version [] :i64 1)

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn node-region [zone :string region-label :string region :string] :string
  (if (string=? zone "")
    (if (string=? region-label "")
      (if (string=? region "")
        "global"
        region)
      region-label)
    zone))

(defn relay-score [node-region :string relay-region :string] :i64
  (if (string=? node-region relay-region) 0 1))

(defn overlay-id-input [overlay-id :string cloud-name :string] :string
  ;; preimage for identity/graph-cid
  (if (string=? overlay-id "")
    (if (string=? cloud-name "")
      "murakumo.cloud"
      cloud-name)
    overlay-id))

(defn node-id-input [overlay-cid :string node-name :string] :string
  (string-concat overlay-cid (string-concat ":" node-name)))

(defn quic-endpoint [host :string port :i64] :string
  (string-concat
   "quic://"
   (string-concat host (string-concat ":" (i64-str port)))))

(defn webrtc-endpoint [host :string p2p-port :i64] :string
  (string-concat
   "webrtc://"
   (string-concat host (string-concat ":" (i64-str (+ p2p-port 100))))))

(defn relay-endpoint-url [relay-url :string node-id :string] :string
  (string-concat relay-url (string-concat "/" node-id)))

(defn webtransport-endpoint [host :string http-port :i64] :string
  ;; cljc: (str "https://" host ":" http-port "/.well-known/murakumo/webtransport")
  (string-concat
   "https://"
   (string-concat
    host
    (string-concat
     ":"
     (string-concat (i64-str http-port)
                    "/.well-known/murakumo/webtransport")))))

(defn transport-endpoint [scheme :string host :string] :string
  ;; cljc fallback: (str (name transport) "://" host)
  (string-concat scheme (string-concat "://" host)))

;; ── residual CLI presentation labels + line templates ────────────────

(defn dash-placeholder [] :string "-")

(defn summary-nodes-header [] :string
  "  NODE           REGION     RELAY          DIRECT")

(defn routes-header [] :string
  "  NODE           DIRECT                                      RELAY")

(defn direct-candidates-label [] :string
  "  direct candidates:")

(defn relays-section-label [] :string
  "  relays:")

(defn connects-section-label [] :string
  "  connects:")

(defn summary-title [domain :string overlay :string] :string
  (string-concat
   "murakumo.cloud "
   (string-concat domain (string-concat "  overlay " overlay))))

(defn routes-title [overlay :string] :string
  (string-concat "murakumo.cloud routes overlay " overlay))

(defn bootstrap-title [overlay :string] :string
  (string-concat "murakumo.cloud bootstrap overlay " overlay))

(defn unknown-node-line [node-name :string] :string
  (string-concat "unknown murakumo.cloud node: " node-name))

(defn unknown-relay-line [relay-name :string] :string
  (string-concat "unknown murakumo.cloud relay: " relay-name))

(defn dial-denied-line [node-name :string] :string
  (string-concat
   "murakumo.cloud dial "
   (string-concat node-name " denied by policy")))

(defn connect-denied-line [node-name :string] :string
  (string-concat
   "murakumo.cloud connect "
   (string-concat node-name " denied by policy")))

(defn dial-ok-title [route-name :string node :string] :string
  (string-concat
   "murakumo.cloud dial "
   (string-concat route-name (string-concat "  node " node))))

(defn connect-ok-title [node-name :string] :string
  (string-concat "murakumo.cloud connect " node-name))

(defn relay-ok-title [relay-name :string] :string
  (string-concat "murakumo.cloud relay " relay-name))

(defn from-to-cap-reason [from :string to :string
                          capability :string reason :string] :string
  ;; "  from=%s to=%s capability=%s reason=%s"
  (string-concat
   "  from="
   (string-concat
    from
    (string-concat
     " to="
     (string-concat
      to
      (string-concat
       " capability="
       (string-concat capability (string-concat " reason=" reason))))))))

(defn authorized-line [from :string to :string capability :string] :string
  ;; "  authorized: from=%s to=%s capability=%s"
  (string-concat
   "  authorized: from="
   (string-concat
    from
    (string-concat
     " to="
     (string-concat to (string-concat " capability=" capability))))))

(defn relay-fallback-line [endpoint :string] :string
  (string-concat "  relay fallback: " endpoint))

(defn reason-line [reason :string] :string
  (string-concat "  reason=" reason))

(defn indent-argv-line [argv-joined :string] :string
  (string-concat "  " argv-joined))

(defn address-family-line [af :string nodes :i64 relays :i64] :string
  ;; "  address-family %s ; nodes %d ; relays %d"
  (string-concat
   "  address-family "
   (string-concat
    af
    (string-concat
     " ; nodes "
     (string-concat
      (i64-str nodes)
      (string-concat " ; relays " (i64-str relays)))))))

(defn policy-line [default :string allow-n :i64] :string
  ;; "  policy default=%s allow=%d"
  (string-concat
   "  policy default="
   (string-concat default (string-concat " allow=" (i64-str allow-n)))))

(defn skipped-reason-suffix [reason :string] :string
  ;; host pads name column; this is the trailing " skipped reason=…" fragment
  (string-concat " skipped reason=" reason))

;; ── residual parse-flags command/flag classifiers ───────────────────

(defn starts-with? [s :string prefix :string] :i64
  (let [n (string-byte-length s)
        p (string-byte-length prefix)]
    (if (< n p)
      0
      (if (string=? (string-substring s 0 p) prefix) 1 0))))

(defn is-cmd-plan? [a :string] :i64
  (if (string=? a "plan") 1 0))

(defn is-cmd-records? [a :string] :i64
  (if (string=? a "records") 1 0))

(defn is-cmd-routes? [a :string] :i64
  (if (string=? a "routes") 1 0))

(defn is-cmd-dial? [a :string] :i64
  (if (string=? a "dial") 1 0))

(defn is-cmd-connect? [a :string] :i64
  (if (string=? a "connect") 1 0))

(defn is-cmd-relay? [a :string] :i64
  (if (string=? a "relay") 1 0))

(defn is-cmd-bootstrap? [a :string] :i64
  (if (string=? a "bootstrap") 1 0))

(defn is-flag-cloud? [a :string] :i64
  (starts-with? a "--cloud="))

(defn is-flag-fleet? [a :string] :i64
  (starts-with? a "--fleet="))

(defn is-flag-target? [a :string] :i64
  (starts-with? a "--target="))

(defn is-flag-from? [a :string] :i64
  (starts-with? a "--from="))

(defn is-flag-to? [a :string] :i64
  (starts-with? a "--to="))

(defn is-flag-capability? [a :string] :i64
  (starts-with? a "--capability="))

(defn is-flag-driver? [a :string] :i64
  (starts-with? a "--driver="))

(defn is-flag-format? [a :string] :i64
  (starts-with? a "--format="))

(defn is-flag-auth-key? [a :string] :i64
  (starts-with? a "--auth-key="))

(defn is-flag-dash? [a :string] :i64
  (starts-with? a "--"))

(defn is-positional-target? [a :string] :i64
  ;; not a --flag → free target token
  (if (= (is-flag-dash? a) 1) 0 1))

(defn flag-value-after [a :string prefix-len :i64] :string
  (let [n (string-byte-length a)]
    (if (< n prefix-len)
      ""
      (string-substring a prefix-len n))))

(defn flag-cloud-value [a :string] :string
  (flag-value-after a 8))

(defn flag-fleet-value [a :string] :string
  (flag-value-after a 8))

(defn flag-target-value [a :string] :string
  (flag-value-after a 9))

(defn flag-from-value [a :string] :string
  (flag-value-after a 7))

(defn flag-to-value [a :string] :string
  (flag-value-after a 5))

(defn flag-capability-value [a :string] :string
  (flag-value-after a 13))

(defn flag-driver-value [a :string] :string
  (flag-value-after a 9))

(defn flag-format-value [a :string] :string
  (flag-value-after a 9))

(defn flag-auth-key-value [a :string] :string
  (flag-value-after a 11))
