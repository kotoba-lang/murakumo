;; Itonami cells, including a Murakumo inference worker, use the same node
;; lifecycle and runtime-class declarations. A service name is not a node
;; state, runtime class or grant.
;;
;; Composition order (canonical sources, no copies):
;;   tsukasa/ledger_core, tsukasa/node_state, fleet_placement_core, this file.
;; The caller verifies signed L1/L2 inputs before deriving the node state.
;; This function proposes placement only. The selected node must separately
;; check grant, artifact digest/signature and capability bounds before launch.
(ns murakumo.fleet-cell-placement
  (:export [cell-eligible-reason cell-capacity-reason physical-capacity-reason
            test-cell-eligibility test-cell-state-path test-cell-capacity]))

;; Derive the two authority-sensitive inputs to eligible-reason from the
;; canonical tsukasa functions instead of accepting caller-selected booleans.
(defn cell-eligible-reason [state :i64 runtime-classes :i64 runtime-class :string
                           enabled :bool cordoned :bool fresh :bool
                           memory-gb :i64 min-gb :i64 labels :bool
                           pressure :i64 max-pressure :i64] :string
  (eligible-reason enabled (schedulable? state) cordoned fresh
                   memory-gb min-gb labels pressure max-pressure
                   (has-runtime-class? runtime-classes runtime-class)))

;; One dimension of an authenticated, independently measured physical pool:
;; [qualified capacity, OS/control reserve, committed reservations,
;;  bounded unmanaged usage, candidate demand]. Never add these values: use
;; successive subtraction so signed overflow cannot create apparent space.
;; The caller must aggregate host and VM reservations before this boundary.
;; Missing measurements use -1, not zero. This is a proposal, not a permit.
(defn physical-capacity-reason [v :vector-i64] :string
  (if (not (= (vector-count v) 5)) "capacity/unknown"
    (let [capacity (vector-at v 0) reserve (vector-at v 1)
          committed (vector-at v 2) unmanaged (vector-at v 3)
          demand (vector-at v 4) limit 9007199254740991]
      (cond (or (< capacity 0) (< reserve 0) (< committed 0) (< unmanaged 0)
                (<= demand 0) (> capacity limit) (> reserve limit)
                (> committed limit) (> unmanaged limit) (> demand limit)) "capacity/unknown"
            (> reserve capacity) "capacity/insufficient"
            (> committed (- capacity reserve)) "capacity/insufficient"
            (> unmanaged (- (- capacity reserve) committed)) "capacity/insufficient"
            (> demand (- (- (- capacity reserve) committed) unmanaged)) "capacity/insufficient"
            :else "capacity/ok"))))

;; Composes the existing cell eligibility with a fresh, externally verified
;; physical-pool snapshot. verified-pool must include identity, host/VM
;; aggregation, all existing allocations and measurement provenance. Each
;; relevant resource dimension must be checked by the caller; launch still
;; needs a durable reservation, fencing, artifact and capability admission.
(defn cell-capacity-reason [state :i64 classes :i64 class :string
                            enabled :bool cordoned :bool fresh :bool
                            memory :i64 min-memory :i64 labels :bool
                            pressure :i64 max-pressure :i64
                            verified-pool :bool pool-at :i64 now :i64 ttl :i64
                            amounts :vector-i64] :string
  (let [base (cell-eligible-reason state classes class enabled cordoned fresh
                                   memory min-memory labels pressure max-pressure)]
    (cond (not (= base "eligible/ok")) base
          ;; The legacy eligibility function permits an absent pressure (0).
          ;; A physical capacity proposal requires a real bounded observation.
          (or (not (or (= pressure 1) (= pressure 2) (= pressure 4)))
              (not (or (= max-pressure 0) (= max-pressure 1) (= max-pressure 2) (= max-pressure 4))))
            "capacity/pressure-unknown"
          (not verified-pool) "capacity/unverified-pool"
          (not (fresh? true pool-at now ttl)) "capacity/stale"
          :else (physical-capacity-reason amounts))))

(defn test-cell-capacity [] :bool
  (and (= (physical-capacity-reason [100 10 20 30 40]) "capacity/ok")
       (= (physical-capacity-reason [100 10 20 30 41]) "capacity/insufficient")
       (= (physical-capacity-reason [100 101 0 0 1]) "capacity/insufficient")
       (= (physical-capacity-reason [100 10 91 0 1]) "capacity/insufficient")
       (= (physical-capacity-reason [100 10 20 71 1]) "capacity/insufficient")
       (= (physical-capacity-reason [100 10 -1 0 1]) "capacity/unknown")
       (= (physical-capacity-reason [100 10 20 0 0]) "capacity/unknown")
       (= (physical-capacity-reason [100 10 20 0]) "capacity/unknown")
       (= (physical-capacity-reason [9007199254740992 0 0 0 1]) "capacity/unknown")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 1 2 true 100 100 10 [100 10 20 30 40]) "capacity/ok")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 2 0 true 100 100 10 [100 10 20 30 40]) "capacity/ok")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 0 2 true 100 100 10 [100 10 20 30 40]) "capacity/pressure-unknown")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true -1 2 true 100 100 10 [100 10 20 30 40]) "capacity/pressure-unknown")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 3 4 true 100 100 10 [100 10 20 30 40]) "capacity/pressure-unknown")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 1 3 true 100 100 10 [100 10 20 30 40]) "capacity/pressure-unknown")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 1 2 false 100 100 10 [100 10 20 30 40]) "capacity/unverified-pool")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 1 2 true 101 100 10 [100 10 20 30 40]) "capacity/stale")
       (= (cell-capacity-reason 2 2 "container" true false true 16 8 true 1 2 true 90 100 10 [100 10 20 30 40]) "capacity/stale")
       (= (cell-capacity-reason 3 2 "container" true false true 16 8 true 1 2 true 100 100 10 [100 10 20 30 40]) "eligible/not-active")))

(defn test-cell-eligibility [] :bool
  (and
    (= (cell-eligible-reason 2 2 "container" true false true 16 8 true 1 2) "eligible/ok")
    (= (cell-eligible-reason 2 1 "wasm" true false true 16 8 true 1 2) "eligible/ok")
    (= (cell-eligible-reason 2 3 "container" true false true 16 8 true 1 2) "eligible/ok")
    (= (cell-eligible-reason 2 3 "wasm" true false true 16 8 true 1 2) "eligible/ok")
    (= (cell-eligible-reason 0 3 "container" true false true 16 8 true 1 2) "eligible/not-active")
    (= (cell-eligible-reason 1 3 "container" true false true 16 8 true 1 2) "eligible/not-active")
    (= (cell-eligible-reason 3 3 "container" true false true 16 8 true 1 2) "eligible/not-active")
    (= (cell-eligible-reason 4 3 "container" true false true 16 8 true 1 2) "eligible/not-active")
    (= (cell-eligible-reason 9 3 "container" true false true 16 8 true 1 2) "eligible/not-active")
    (= (cell-eligible-reason 2 1 "container" true false true 16 8 true 1 2) "eligible/runtime-class")
    (= (cell-eligible-reason 2 2 "wasm" true false true 16 8 true 1 2) "eligible/runtime-class")
    (= (cell-eligible-reason 2 0 "wasm" true false true 16 8 true 1 2) "eligible/runtime-class")
    (= (cell-eligible-reason 2 4 "container" true false true 16 8 true 1 2) "eligible/runtime-class")
    (= (cell-eligible-reason 2 3 "microvm" true false true 16 8 true 1 2) "eligible/runtime-class")
    (= (cell-eligible-reason 2 3 "murakumo" true false true 16 8 true 1 2) "eligible/runtime-class")
    ;; Keep the canonical precedence: resource refusal precedes class refusal.
    (= (cell-eligible-reason 2 1 "container" true false true 4 8 true 1 2) "eligible/memory")
    (= (cell-eligible-reason 2 3 "container" true true true 16 8 true 1 2) "eligible/cordoned")
    (= (cell-eligible-reason 2 3 "container" true false false 16 8 true 1 2) "eligible/stale")
    (= (cell-eligible-reason 2 3 "container" true false true 16 8 true 3 2) "eligible/pressure")))

;; Cross-component path: declaration -> derived target -> legal state step ->
;; eligibility. These are fixture inputs, not signature or transport evidence.
(defn test-cell-state-path [] :bool
  (let [decl (first-problem "n" "did:key:x" "site-a" "always-on" 2)
        fresh (fresh? true 1000000 1000000 300000)
        target (node-target decl "d1" "d1" false fresh false false)
        proposed (next-state -1 target)
        admitted (next-state proposed target)
        active (next-state admitted target)
        stale-target (node-target decl "d1" "d1" false false false false)
        drained (next-state active stale-target)
        changed (node-target decl "d1" "d2" false true false false)
        refused (node-target (first-problem "n" "did:key:x" "site-a" "always-on" 0)
                             "d1" "d1" false true false false)]
    (and
      (= proposed 0) (= admitted 1) (= active 2) (= drained 3)
      (= (cell-eligible-reason proposed 2 "container" true false fresh 16 8 true 1 2) "eligible/not-active")
      (= (cell-eligible-reason admitted 2 "container" true false fresh 16 8 true 1 2) "eligible/not-active")
      (= (cell-eligible-reason active 2 "container" true false fresh 16 8 true 1 2) "eligible/ok")
      (= (cell-eligible-reason drained 2 "container" true false false 16 8 true 1 2) "eligible/not-active")
      (= (cell-eligible-reason (next-state active changed) 2 "container" true false true 16 8 true 1 2) "eligible/not-active")
      (= (cell-eligible-reason (next-state active refused) 0 "container" true false true 16 8 true 1 2) "eligible/not-active")
      (= (cell-eligible-reason (next-state drained target) 2 "container" true false true 16 8 true 1 2) "eligible/ok")
      (= (cell-eligible-reason (next-state 4 target) 2 "container" true false true 16 8 true 1 2) "eligible/not-active"))))
