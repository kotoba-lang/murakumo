(ns provision-plan-core
  (:schemas {;; T5.2 native guest record wire
             :provision/multiaddr [:record :provision/multiaddr
                                   [[:ip :string] [:port :i64]]]
             :provision/bin-path [:record :provision/bin-path
                                  [[:local-bin :string] [:bin :string]]]
             :provision/remote-dest [:record :provision/remote-dest
                                     [[:host :string] [:bin :string]]]
             :provision/label-kv [:record :provision/label-kv
                                  [[:k :string] [:v :string]]]
             :provision/peer-entry [:record :provision/peer-entry
                                    [[:peer-id :string] [:multiaddr :string]]]
             :provision/join [:record :provision/join
                              [[:acc :string] [:sep :string] [:next :string]]]
             :provision/bootstrap [:record :provision/bootstrap
                                   [[:acc :string] [:entry :string]]]
             :provision/labels [:record :provision/labels
                                [[:acc :string] [:pair :string]]]
             :provision/roles [:record :provision/roles
                               [[:acc :string] [:role :string]]]
             :provision/plist-replace [:record :provision/plist-replace
                                       [[:tmpl :string] [:ph :string] [:val :string]]]
             :provision/write-plist [:record :provision/write-plist
                                     [[:label :string] [:body :string]]]})
  (:export [plist-label remote-bin remote-store ssh-rsync-options
            peer-advertise-wait-ms default-p2p-port
            digit-char nat-str i64-str
            operator-seed-missing? resolve-p2p-port multiaddr webrtc-port
            mesh-binary-status-command remote-store-command
            launch-status-command peer-id-log-command live-link-count-command
            live-link-count-output launch-up-command launch-down-command
            reprovision-command watchdog-label
            watchdog-reprovision-command
            rsync-bin rsync-az-flag rsync-e-flag
            local-bin-path remote-bin-dest
            launchd-daemon-path tee-plist-prefix
            label-kv plist-heredoc-footer
            peer-at-sep peer-join-sep peer-entry
            did-key-prefix peer-id-body-prefix peer-id-body-pattern
            peer-id-did-pattern did-peer-id
            home-bin-suffix home-bin-path
            label-join-sep roles-join-sep
            plist-ph-user plist-ph-bin plist-ph-port plist-ph-roles
            plist-ph-labels plist-ph-home plist-ph-ed25519 plist-ph-x25519
            plist-ph-did plist-ph-p2pport plist-ph-p2pseed
            plist-ph-extaddr plist-ph-bootstrap plist-ph-webrtc
            join-append bootstrap-append labels-append roles-append
            plist-replace
            alnum-char? find-prefix-at take-alnum peer-id-from-log
            write-plist-shell
            multiaddr-ip4-prefix multiaddr-udp-mid multiaddr-quic-suffix
            launchctl-print-prefix launchctl-bootout-prefix
            launchctl-bootstrap-sys launchctl-bootstrap-prefix
            launchctl-kickstart-prefix launchctl-status-suffix
            launchctl-plist-quiet-semi launchctl-quiet-true-sleep
            launchctl-plist-quiet-true-semi
            launchd-daemons-dir plist-ext]))

;; Product Value ABI v1 pure oracle — murakumo.provision.plan string/port.
;; resolve-p2p-port uses [:option :i64] (no has-* sentinels).
;; launch/peer-id/link/watchdog shell strings are pure.
;; rsync argv fragments + launchd path/tee prefix dual-source.
;; peer-entry (peerid@multiaddr) dual-source for bootstrap-str host fold.
;; home-bin-path + label/roles join seps dual-source for render-plist.
;; peer-id body/DID patterns dual-source; log/link grep commands recompose them.
;; render-plist placeholder tokens dual-source.
;; multiaddr path tokens dual-source; multiaddr recomposes from them.
;; T5.2: multi-scalar pure inputs take single guest records (option residual stays positional).
;; launchctl shell tokens dual-source; status/up/down/reprovision/watchdog
;; cmds + launchd-daemon-path recompose from those SSoTs.
;; join-append / bootstrap-append / labels-append / roles-append: pure fold
;; steps; host still walks node/label/role collections.
;; plist-replace: pure template replace step; host chains placeholders.
;; peer-id-from-log: pure scan for did:key:12D3… (no host regex).
;; write-plist-shell: pure tee+body+footer assembly (body content still host).
;; Parity: test/murakumo/provision_plan_kotoba_parity_test.clj

(defn plist-label [] :string "com.murakumo.kotoba-mesh")
(defn remote-bin [] :string "$HOME/.murakumo/bin")
(defn remote-store [] :string "$HOME/.murakumo/store")
(defn ssh-rsync-options [] :string "ssh -o BatchMode=yes -o ConnectTimeout=8")
(defn peer-advertise-wait-ms [] :i64 8000)
(defn default-p2p-port [] :i64 4001)

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn blank? [s :string] :bool
  (let [n (string-byte-length s)]
    (if (= n 0)
      true
      (if (ws? (string-substring s 0 1))
        (blank? (string-substring s 1 n))
        false))))

(defn operator-seed-missing? [seed :string] :bool
  ;; cljc: (str/blank? (str operator-seed)) — empty after str
  (blank? seed))

(defn resolve-p2p-port [node-port [:option :i64]
                        fleet-port [:option :i64]] :i64
  ;; Product Value ABI v1: optional ports (no has-* sentinels).
  ;; cljc: (or (:p2p-port node) (:fleet/p2p-port fleet) 4001)
  (if-some [p node-port]
    p
    (if-some [f fleet-port]
      f
      4001)))

;; ── residual multiaddr path tokens ───────────────────────────────────

(defn multiaddr-ip4-prefix [] :string
  ;; libp2p multiaddr IP4 protocol prefix
  "/ip4/")

(defn multiaddr-udp-mid [] :string
  ;; between host and UDP port
  "/udp/")

(defn multiaddr-quic-suffix [] :string
  ;; Tailscale QUIC transport suffix after port
  "/quic-v1")

(defn multiaddr [m [:ref :provision/multiaddr]] :string
  ;; recomposes from multiaddr path token SSoTs
  ;; T5.2 native: ip+port.
  (string-concat
   (multiaddr-ip4-prefix)
   (string-concat
    (record-get m :ip)
    (string-concat
     (multiaddr-udp-mid)
     (string-concat (i64-str (record-get m :port)) (multiaddr-quic-suffix))))))

(defn webrtc-port [p2p-port :i64] :i64
  (+ p2p-port 100))

(defn mesh-binary-status-command [] :string
  "test -x $HOME/.murakumo/bin/kotoba-server && echo installed || echo absent")

(defn remote-store-command [] :string
  "mkdir -p $HOME/.murakumo/bin $HOME/.murakumo/store")

;; ── residual launchctl shell tokens ──────────────────────────────────

(defn launchctl-print-prefix [] :string
  "sudo launchctl print system/")

(defn launchctl-bootout-prefix [] :string
  "sudo launchctl bootout system/")

(defn launchctl-bootstrap-sys [] :string
  ;; verb + domain before daemons dir
  "sudo launchctl bootstrap system ")

(defn launchd-daemons-dir [] :string
  "/Library/LaunchDaemons/")

(defn launchctl-bootstrap-prefix [] :string
  (string-concat (launchctl-bootstrap-sys) (launchd-daemons-dir)))

(defn launchctl-kickstart-prefix [] :string
  "sudo launchctl kickstart -k system/")

(defn launchctl-status-suffix [] :string
  " >/dev/null 2>&1 && echo running || echo stopped")

(defn launchctl-plist-quiet-semi [] :string
  ;; after label in launch-up: quiet bootstrap then kickstart
  ".plist 2>/dev/null; ")

(defn launchctl-quiet-true-sleep [] :string
  ;; after bootout label in reprovision: ignore miss + settle
  " 2>/dev/null || true; sleep 1; ")

(defn launchctl-plist-quiet-true-semi [] :string
  ;; after bootstrap label in reprovision: quiet then kickstart
  ".plist 2>/dev/null || true; ")

(defn plist-ext [] :string
  ".plist")

(defn launch-status-command [] :string
  (string-concat
   (launchctl-print-prefix)
   (string-concat (plist-label) (launchctl-status-suffix))))

;; ── peer-id DID / body patterns (shared by log grep + host re-find) ──

(defn did-key-prefix [] :string
  "did:key:")

(defn peer-id-body-prefix [] :string
  ;; libp2p peer-id multihash body starts with 12D3 in mesh logs
  "12D3")

(defn peer-id-body-pattern [] :string
  ;; 12D3[A-Za-z0-9]*
  (string-concat (peer-id-body-prefix) "[A-Za-z0-9]*"))

(defn peer-id-did-pattern [] :string
  ;; did:key:12D3[A-Za-z0-9]*
  (string-concat (did-key-prefix) (peer-id-body-pattern)))

(defn did-peer-id [peer-id :string] :string
  ;; cljc: (str did-key-prefix peer-id)
  (string-concat (did-key-prefix) peer-id))

(defn peer-id-log-command [] :string
  ;; grep -ho 'did:key:12D3…' ~/.murakumo/mesh.log … | tail -1
  (string-concat
   "grep -ho '"
   (string-concat
    (peer-id-did-pattern)
    "' ~/.murakumo/mesh.log 2>/dev/null | tail -1")))

(defn live-link-count-command [] :string
  ;; grep peer connected … | grep -o '12D3…' | sort -u | wc -l
  (string-concat
   "grep 'kotoba-net: peer connected' ~/.murakumo/mesh.log 2>/dev/null | grep -o '"
   (string-concat
    (peer-id-body-pattern)
    "' | sort -u | wc -l")))

(defn ws? [c :string] :bool
  (if (string=? c " ")
    true
    (if (string=? c "\n")
      true
      (if (string=? c "\t")
        true
        (if (string=? c "\r") true false)))))

(defn trim [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (ws? (string-substring s 0 1))
        (trim (string-substring s 1 n))
        (if (ws? (string-substring s (- n 1) n))
          (trim (string-substring s 0 (- n 1)))
          s)))))

(defn live-link-count-output [out :string] :string
  (trim out))

(defn launch-up-command [] :string
  (string-concat
   (launchctl-bootstrap-prefix)
   (string-concat
    (plist-label)
    (string-concat
     (launchctl-plist-quiet-semi)
     (string-concat (launchctl-kickstart-prefix) (plist-label))))))

(defn launch-down-command [] :string
  (string-concat (launchctl-bootout-prefix) (plist-label)))

(defn reprovision-command [] :string
  (string-concat
   (launchctl-bootout-prefix)
   (string-concat
    (plist-label)
    (string-concat
     (launchctl-quiet-true-sleep)
     (string-concat
      (launchctl-bootstrap-prefix)
      (string-concat
       (plist-label)
       (string-concat
        (launchctl-plist-quiet-true-semi)
        (string-concat (launchctl-kickstart-prefix) (plist-label)))))))))

(defn watchdog-label [] :string
  "com.murakumo.kotoba-mesh-watchdog")

(defn watchdog-reprovision-command [] :string
  (string-concat
   (launchctl-bootout-prefix)
   (string-concat
    (watchdog-label)
    (string-concat
     (launchctl-quiet-true-sleep)
     (string-concat
      (launchctl-bootstrap-prefix)
      (string-concat
       (watchdog-label)
       (string-concat
        (launchctl-plist-quiet-true-semi)
        (string-concat (launchctl-kickstart-prefix) (watchdog-label)))))))))

;; ── residual rsync argv fragments + launchd path/tee ─────────────────

(defn rsync-bin [] :string "rsync")
(defn rsync-az-flag [] :string "-az")
(defn rsync-e-flag [] :string "-e")

(defn local-bin-path [p [:ref :provision/bin-path]] :string
  ;; cljc: (str local-bin "/" bin)
  ;; T5.2 native.
  (string-concat (record-get p :local-bin) (string-concat "/" (record-get p :bin))))

(defn remote-bin-dest [p [:ref :provision/remote-dest]] :string
  ;; cljc: (str host ":.murakumo/bin/" bin)
  ;; T5.2 native.
  (string-concat (record-get p :host) (string-concat ":.murakumo/bin/" (record-get p :bin))))

(defn launchd-daemon-path [label :string] :string
  ;; /Library/LaunchDaemons/{label}.plist — recomposes dir + ext SSoTs
  (string-concat
   (launchd-daemons-dir)
   (string-concat label (plist-ext))))

(defn tee-plist-prefix [label :string] :string
  ;; "sudo tee {path} >/dev/null <<'PLIST'\n" — heredoc body stays host
  (string-concat
   "sudo tee "
   (string-concat
    (launchd-daemon-path label)
    " >/dev/null <<'PLIST'\n")))

(defn label-kv [p [:ref :provision/label-kv]] :string
  ;; single launchd env pair; host joins with comma
  ;; T5.2 native.
  (string-concat (record-get p :k) (string-concat "=" (record-get p :v))))

(defn plist-heredoc-footer [] :string
  "\nPLIST")

;; ── residual bootstrap peer-entry fragments ──────────────────────────

(defn peer-at-sep [] :string "@")

(defn peer-join-sep [] :string ",")

(defn peer-entry [p [:ref :provision/peer-entry]] :string
  ;; cljc: (str peer-id "@" multiaddr)
  ;; T5.2 native.
  (string-concat (record-get p :peer-id)
                 (string-concat (peer-at-sep) (record-get p :multiaddr))))

;; ── residual render-plist path + join seps ───────────────────────────

(defn home-bin-suffix [] :string
  ;; cljc: "/.murakumo/bin" under node home for {{BIN}}
  "/.murakumo/bin")

(defn home-bin-path [home :string] :string
  ;; cljc: (str home "/.murakumo/bin")
  (string-concat home (home-bin-suffix)))

(defn label-join-sep [] :string
  ;; labels-env host join between label-kv pairs
  ",")

(defn roles-join-sep [] :string
  ;; render-plist {{ROLES}} CSV join
  ",")

;; ── residual render-plist / watchdog placeholder tokens ──────────────

(defn plist-ph-user [] :string "{{USER}}")
(defn plist-ph-bin [] :string "{{BIN}}")
(defn plist-ph-port [] :string "{{PORT}}")
(defn plist-ph-roles [] :string "{{ROLES}}")
(defn plist-ph-labels [] :string "{{LABELS}}")
(defn plist-ph-home [] :string "{{HOME}}")
(defn plist-ph-ed25519 [] :string "{{ED25519}}")
(defn plist-ph-x25519 [] :string "{{X25519}}")
(defn plist-ph-did [] :string "{{DID}}")
(defn plist-ph-p2pport [] :string "{{P2PPORT}}")
(defn plist-ph-p2pseed [] :string "{{P2PSEED}}")
(defn plist-ph-extaddr [] :string "{{EXTADDR}}")
(defn plist-ph-bootstrap [] :string "{{BOOTSTRAP}}")
(defn plist-ph-webrtc [] :string "{{WEBRTC}}")

;; ── residual fold steps (host still walks collections / chains steps) ─

(defn join-append [j [:ref :provision/join]] :string
  ;; empty acc ⇒ first item only (no leading sep)
  ;; T5.2 native: acc+sep+next.
  (let [acc (record-get j :acc)
        sep (record-get j :sep)
        next (record-get j :next)]
    (if (string=? acc "")
      next
      (string-concat acc (string-concat sep next)))))

(defn bootstrap-append [b [:ref :provision/bootstrap]] :string
  ;; host reduce over peer-entry strings for bootstrap-str
  ;; T5.2 native.
  (join-append (record-new [:ref :provision/join]
                           (record-get b :acc)
                           (peer-join-sep)
                           (record-get b :entry))))

(defn labels-append [l [:ref :provision/labels]] :string
  ;; host reduce over label-kv pairs for labels-env
  ;; T5.2 native.
  (join-append (record-new [:ref :provision/join]
                           (record-get l :acc)
                           (label-join-sep)
                           (record-get l :pair))))

(defn roles-append [r [:ref :provision/roles]] :string
  ;; host reduce over role names for {{ROLES}} CSV
  ;; T5.2 native.
  (join-append (record-new [:ref :provision/join]
                           (record-get r :acc)
                           (roles-join-sep)
                           (record-get r :role))))

(defn plist-replace [p [:ref :provision/plist-replace]] :string
  ;; one placeholder substitution; host chains render-plist / watchdog
  ;; T5.2 native.
  (string-replace-all (record-get p :tmpl)
                      (record-get p :ph)
                      (record-get p :val)))

;; ── residual peer-id log extract + write-plist shell assembly ─────────

(defn alnum-char? [c :string] :bool
  ;; single-char ASCII letter or digit (libp2p PeerId body charset)
  (if (string-contains?
       "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
       c)
    true
    false))

(defn find-prefix-at [s :string prefix :string i :i64] :i64
  ;; first index of prefix in s at/after i, or -1
  (let [n (string-byte-length s)
        p (string-byte-length prefix)]
    (if (or (= p 0) (> (+ i p) n))
      -1
      (if (string=? (string-substring s i (+ i p)) prefix)
        i
        (find-prefix-at s prefix (+ i 1))))))

(defn take-alnum [s :string i :i64 acc :string] :string
  ;; consume [A-Za-z0-9]* from s[i..] into acc
  (let [n (string-byte-length s)]
    (if (>= i n)
      acc
      (let [c (string-substring s i (+ i 1))]
        (if (alnum-char? c)
          (take-alnum s (+ i 1) (string-concat acc c))
          acc)))))

(defn peer-id-from-log [out :string] :string
  ;; cljc re-find did:key:(12D3[A-Za-z0-9]*) → capture group (body only)
  ;; empty string when no match (host maps blank → nil)
  (let [needle (string-concat (did-key-prefix) (peer-id-body-prefix))
        idx (find-prefix-at out needle 0)]
    (if (< idx 0)
      ""
      (let [body-start (+ idx (string-byte-length (did-key-prefix)))
            n (string-byte-length out)
            rest (string-substring out body-start n)]
        (take-alnum rest 0 "")))))

(defn write-plist-shell [w [:ref :provision/write-plist]] :string
  ;; cljc: (str (tee-plist-prefix label) body plist-heredoc-footer)
  ;; body content is host-rendered plist XML; assembly is pure
  ;; T5.2 native.
  (string-concat
   (tee-plist-prefix (record-get w :label))
   (string-concat (record-get w :body) (plist-heredoc-footer))))
