(ns identity-core
  (:export [ws? trim seed-node seed-p2p seed-x25519 seed-overlay
            did-derive-cmd did-from-output]))

;; W6 pure-planner oracle — murakumo.identity pure string core (medium).
;; SHA-256 / base32 CID / base64url / op-token stay host (crypto).
;; Seed *inputs* (preimage strings) ported; hashing remains cljc.
;; trim matches clojure.string/trim for space/tab/newline/cr.
;; Parity: test/murakumo/identity_kotoba_parity_test.clj

(defn ws? [c :string] :i64
  (if (string=? c " ")
    1
    (if (string=? c "\n")
      1
      (if (string=? c "\t")
        1
        (if (string=? c "\r") 1 0)))))

(defn trim [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (= (ws? (string-substring s 0 1)) 1)
        (trim (string-substring s 1 n))
        (if (= (ws? (string-substring s (- n 1) n)) 1)
          (trim (string-substring s 0 (- n 1)))
          s)))))

(defn seed-node [operator-seed :string node-name :string] :string
  ;; preimage for node-seed before sha256-hex
  (string-concat operator-seed (string-concat ":" node-name)))

(defn seed-p2p [operator-seed :string node-name :string] :string
  (string-concat (seed-node operator-seed node-name) ":p2p"))

(defn seed-x25519 [operator-seed :string] :string
  (string-concat operator-seed ":x25519"))

(defn seed-overlay [operator-seed :string overlay-id :string] :string
  (string-concat
   operator-seed
   (string-concat ":" (string-concat overlay-id ":murakumo-overlay-auth"))))

(defn did-derive-cmd [kotoba :string seed :string] :string
  ;; space-joined argv for display/parity (cljc returns vector)
  (string-concat
   kotoba
   (string-concat " did-derive " seed)))

(defn did-from-output [out :string] :string
  (trim out))
