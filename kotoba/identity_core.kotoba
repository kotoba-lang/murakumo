(ns identity-core
  (:export [ws? trim seed-node seed-p2p seed-x25519 seed-overlay
            did-derive-cmd did-from-output
            jwt-header-json jwt-payload-json op-token-sig-seg
            cid-b-prefix graph-name-fleet
            seed-sep seed-p2p-suffix seed-x25519-suffix seed-overlay-suffix
            did-derive-subcmd jwt-seg-sep argv-join-sep
            jwt-payload-sub-prefix jwt-payload-exp-mid jwt-payload-exp-val
            jwt-payload-close]))

;; W6 pure-planner oracle — murakumo.identity pure string core (medium + expand).
;; SHA-256 / base32 CID / base64url / HMAC stay host (crypto).
;; Seed *inputs* (preimage strings) and JWT/op-token *payload templates* ported;
;; hashing / b64url encoding remain cljc.
;; Residual JWT payload fragments dual-source; jwt-payload-json recompose.
;; seed/jwt seps + did-derive subcmd dual-source for host argv/token join.
;; trim matches clojure.string/trim for space/tab/newline/cr.
;; Parity: test/murakumo/identity_kotoba_parity_test.clj

(defn ws? [c :string] :i64
  (if (string=? c " ")
    1
    (if (string=? c "\n")
      1
      (if (string=? c "\t")
        1
        (if (string=? c "\r") 1 0)))))

(defn trim [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (= (ws? (string-substring s 0 1)) 1)
        (trim (string-substring s 1 n))
        (if (= (ws? (string-substring s (- n 1) n)) 1)
          (trim (string-substring s 0 (- n 1)))
          s)))))

;; ── residual seed/jwt/did-derive separators + subcmd ─────────────────

(defn seed-sep [] :string
  ;; between operator-seed and node-name / overlay-id in preimages
  ":")

(defn seed-p2p-suffix [] :string ":p2p")

(defn seed-x25519-suffix [] :string ":x25519")

(defn seed-overlay-suffix [] :string ":murakumo-overlay-auth")

(defn did-derive-subcmd [] :string "did-derive")

(defn jwt-seg-sep [] :string
  ;; between JWT header/payload/sig segments
  ".")

(defn argv-join-sep [] :string
  ;; space between argv tokens in did-derive-cmd
  " ")

(defn seed-node [operator-seed :string node-name :string] :string
  ;; preimage for node-seed before sha256-hex
  (string-concat operator-seed (string-concat (seed-sep) node-name)))

(defn seed-p2p [operator-seed :string node-name :string] :string
  (string-concat (seed-node operator-seed node-name) (seed-p2p-suffix)))

(defn seed-x25519 [operator-seed :string] :string
  (string-concat operator-seed (seed-x25519-suffix)))

(defn seed-overlay [operator-seed :string overlay-id :string] :string
  (string-concat
   operator-seed
   (string-concat (seed-sep)
                  (string-concat overlay-id (seed-overlay-suffix)))))

(defn did-derive-cmd [kotoba :string seed :string] :string
  ;; space-joined argv for display/parity (cljc returns vector)
  (string-concat
   kotoba
   (string-concat (argv-join-sep)
                  (string-concat (did-derive-subcmd)
                                 (string-concat (argv-join-sep) seed)))))

(defn did-from-output [out :string] :string
  (trim out))

;; ── residual JWT payload fragments + header/sig/cid tokens ───────────

(defn jwt-header-json [] :string
  ;; preimage for first JWT segment before b64url
  "{\"alg\":\"HS256\",\"typ\":\"JWT\"}")

(defn jwt-payload-sub-prefix [] :string
  "{\"sub\":\"")

(defn jwt-payload-exp-mid [] :string
  "\",\"exp\":")

(defn jwt-payload-exp-val [] :string
  ;; fixed sentinel exp for CLI media op-token
  "9999999999")

(defn jwt-payload-close [] :string
  "}")

(defn jwt-payload-json [did :string] :string
  ;; preimage for second JWT segment before b64url
  (string-concat
   (jwt-payload-sub-prefix)
   (string-concat
    did
    (string-concat
     (jwt-payload-exp-mid)
     (string-concat (jwt-payload-exp-val) (jwt-payload-close))))))

(defn op-token-sig-seg [] :string
  ;; third JWT segment is a fixed CLI media marker (not an HMAC)
  "kotoba-cli-media")

(defn cid-b-prefix [] :string
  ;; CIDv1 base32lower display prefix (multihash bytes stay host)
  "b")

(defn graph-name-fleet [] :string
  ;; common graph-cid input used by fleet/persist
  "murakumo-fleet")
