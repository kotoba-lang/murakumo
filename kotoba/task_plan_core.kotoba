(ns task-plan-core
  (:schemas {;; T5.3: assign pack families become named records (no base-65536).
             :task/pair [:record :task/pair [[:a :i64] [:b :i64]]]
             ;; T5.2 residual multi-arg pure (no option-string)
             :task/slots [:record :task/slots
                          [[:budget :i64] [:node-slots :i64] [:slots-per :i64]
                           [:max-slots :i64] [:cores :i64]]]
             :task/wave [:record :task/wave [[:used :i64] [:slots :i64]]]
             :task/better-mem [:record :task/better-mem
                               [[:memneg0 :i64] [:memneg1 :i64]
                                [:name-ord0 :i64] [:name-ord1 :i64]]]
             :task/unsched [:record :task/unsched
                            [[:placement :string] [:excluding :string]
                             [:min-mem-str :string]]]
             :task/pick-fold [:record :task/pick-fold
                              [[:champ [:option :i64]] [:ok-i :bool]
                               [:better-c-i :bool]]]
             :task/score [:record :task/score
                          [[:fill0 :i64] [:load0 :i64] [:memneg0 :i64]
                           [:fill1 :i64] [:load1 :i64]]]
             :task/challenger [:record :task/challenger
                               [[:fill-c :i64] [:load-c :i64]
                                [:fill-i :i64] [:load-i :i64]]]
             :task/triple [:record :task/triple [[:v0 :i64] [:v1 :i64] [:v2 :i64]]]
             ;; ok flags for 3-node pick (profile 5 :bool — split from i64 triple)
             :task/flags3 [:record :task/flags3 [[:v0 :bool] [:v1 :bool] [:v2 :bool]]]
             :task/assign2 [:record :task/assign2
                            [[:code :i64] [:load0 :i64] [:load1 :i64]]]
             :task/assign3 [:record :task/assign3
                            [[:code :i64] [:load0 :i64] [:load1 :i64] [:load2 :i64]]]
             ;; T5.3 + profile 5: eligibility flags are a :bool record.
             ;; T5.2 native guest record wire: mem/min folded into eligibility.
             :task/eligibility [:record :task/eligibility
                                [[:online :bool] [:labels-ok :bool] [:roles-ok :bool]
                                 [:not-excluded :bool] [:allowlist-ok :bool]
                                 [:mem-bytes :i64] [:min-mem :i64]]]
             ;; T5.2 native guest record wire expansion
             :task/retry [:record :task/retry
                          [[:attempt :i64] [:max-attempts :i64]]]
             ;; T5.2 option-string-in-record (+ option-i64)
             :task/failed [:record :task/failed
                           [[:exit [:option :i64]]
                            [:timeout :bool]
                            [:error [:option :string]]]]
             ;; T5.2 residual tournament multi-arg
             :task/capacity-in [:record :task/capacity-in
                                [[:node-slots :i64] [:slots-per :i64] [:cores :i64]]]
             :task/pick2 [:record :task/pick2
                          [[:ok0 :bool] [:ok1 :bool]
                           [:fill0 :i64] [:fill1 :i64]
                           [:load0 :i64] [:load1 :i64]]]
             :task/assign2-in [:record :task/assign2-in
                               [[:load0 :i64] [:load1 :i64]
                                [:ok0 :bool] [:ok1 :bool]
                                [:fill0 :i64] [:fill1 :i64]]]})
  (:export [default-max-slots default-max-attempts default-timeout-ms
            slots failed? can-retry?
            task-eligible? fill-milli better-fill?
            task-score-code better-mem?
            wave-of slot-of load-after-assign
            digit-char nat-str i64-str pad4 task-id
            pair-record pick-task-idx-2 assign-task-step-2
            assign-task-2-code assign-task-2-load0 assign-task-2-load1
            attempt-next exclude-append-marker
            pick-task-fold-step load-inc-if challenger-wins?
            triple-record flags3-record assign-task-pick-3 apply-task-pick-3 assign-task-step-3
            assign-task-3-code assign-task-3-load0 assign-task-3-load1 assign-task-3-load2
            nearest-rank-idx summary-retried speedup-milli
            max2 min2 clamp-nonneg
            unschedulable-detail
            exclude-join-sep
            unsched-placement-prefix unsched-excluding-prefix
            unsched-min-mem-prefix]))

;; Product Value ABI v1 pure oracle — murakumo.task.plan integer + assign core.
;; failed? uses [:option :i64] exit + :bool timeout + [:option :string] error (profile 5).
;; Full admit/prepare vector folds stay cljc.
;; task-eligible? takes [:ref :task/eligibility] + mem (T5.3 record; profile 5 :bool).
;; task-score-code (0|1|2 ordinal, not a pure bool) + wave/slot: pure assign-1 core.
;; expand: task-id = "t-" + zero-pad-4 (cljc last-4 of "0000"+i for i≥10000).
;; assign-task-step-2/3 + pick-task-fold-step: pure assign reduce building blocks.
;; T5.3: load/fill/ok triples and assign results are named records — base-65536 gone.
;; percentile: nearest-rank-idx; summary: retried/speedup-milli pure.
;; unschedulable-detail: pure reject detail string (host projects pr-str placement).
;; exclude-join-sep + unsched prefixes dual-source for host exclude CSV join.
;; Parity: test/murakumo/task_plan_kotoba_parity_test.clj

(defn default-max-slots [] :i64 8)

(defn default-max-attempts [] :i64 2)

(defn default-timeout-ms [] :i64 120000)

(defn capacity [c [:ref :task/capacity-in]] :i64
  (let [node-slots (record-get c :node-slots)
        slots-per (record-get c :slots-per)
        cores (record-get c :cores)]
    (if (< node-slots 0)
      (if (< slots-per 0)
        (if (< cores 0) 1 cores)
        slots-per)
      node-slots)))

(defn slots [s [:ref :task/slots]] :i64
  ;; T5.2 native: five capacity inputs on one record.
  (let [budget-slots (record-get s :budget)
        node-slots (record-get s :node-slots)
        slots-per (record-get s :slots-per)
        max-slots (record-get s :max-slots)
        cores (record-get s :cores)]
    (if (< budget-slots 0)
      (let [cap (capacity (record-new [:ref :task/capacity-in] node-slots slots-per cores))
            m (if (< max-slots 0) 8 max-slots)
            capped (if (< cap m) cap m)]
        (if (< capped 1) 1 capped))
      budget-slots)))

(defn failed? [x [:ref :task/failed]] :bool
  ;; Product Value ABI v1: optional exit + error on one record. T5.2 native.
  (if-some [_ (record-get x :error)]
    true
    (if (record-get x :timeout)
      true
      (if-some [e (record-get x :exit)]
        (if (= e 0) false true)
        true))))

(defn can-retry? [r [:ref :task/retry]] :bool
  ;; T5.2 native: single retry record.
  (if (< (record-get r :attempt) (record-get r :max-attempts)) true false))

;; ── T5.3 + profile 5: eligibility is a :bool record ──

(defn task-eligible? [e [:ref :task/eligibility]] :bool
  ;; T5.2 native guest record wire: mem-bytes/min-mem on the eligibility record
  ;; (single parameter). Nested if (not and/or): desugar gensyms break
  ;; precompiled KIR drift gates.
  ;; Semantics: online ∧ labels ∧ roles ∧ not-excluded ∧ allowlist ∧ mem≥min.
  (if (record-get e :online)
    (if (record-get e :labels-ok)
      (if (record-get e :roles-ok)
        (if (record-get e :not-excluded)
          (if (record-get e :allowlist-ok)
            (if (>= (record-get e :mem-bytes) (record-get e :min-mem)) true false)
            false)
          false)
        false)
      false)
    false))

(defn fill-milli [p [:ref :task/pair]] :i64
  ;; T5.2: a=assigned b=slots
  (let [assigned (record-get p :a)
        slots (record-get p :b)]
    (if (< slots 1)
      0
      (quot (* assigned 1000) slots))))

(defn better-fill? [p [:ref :task/pair]] :bool
  ;; T5.2: a=fill0 b=fill1
  (if (< (record-get p :a) (record-get p :b)) true false))

(defn task-score-code [s [:ref :task/score]] :i64
  ;; Ordinal score code (not a pure bool): 1 if node0 better, 0 if node1 better,
  ;; 2 if fill+load tie. T5.2 native.
  (let [fill0 (record-get s :fill0)
        load0 (record-get s :load0)
        fill1 (record-get s :fill1)
        load1 (record-get s :load1)]
    (if (< fill0 fill1)
      1
      (if (< fill1 fill0)
        0
        (if (< load0 load1)
          1
          (if (< load1 load0)
            0
            2))))))

(defn better-mem? [b [:ref :task/better-mem]] :bool
  ;; T5.2 native.
  (let [memneg0 (record-get b :memneg0)
        memneg1 (record-get b :memneg1)
        name-ord0 (record-get b :name-ord0)
        name-ord1 (record-get b :name-ord1)]
    (if (< memneg0 memneg1)
      true
      (if (< memneg1 memneg0)
        false
        (if (< name-ord0 name-ord1) true false)))))

(defn wave-of [w [:ref :task/wave]] :i64
  ;; T5.2 native.
  (let [used (record-get w :used)
        slots (record-get w :slots)]
    (if (< slots 1) 0 (quot used slots))))

(defn slot-of [w [:ref :task/wave]] :i64
  ;; T5.2 native.
  (let [used (record-get w :used)
        slots (record-get w :slots)]
    (if (< slots 1) 0 (- used (* (quot used slots) slots)))))

(defn load-after-assign [used :i64] :i64
  (+ used 1))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn rem64 [a :i64 b :i64] :i64
  (- a (* (quot a b) b)))

(defn pad4 [n :i64] :string
  ;; cljc (subs (str "0000" i) (- (count …) 4)) — last 4 decimal digits zero-padded
  (let [m (if (< n 0) 0 n)
        d (rem64 m 10000)]
    (if (< d 10)
      (string-concat "000" (i64-str d))
      (if (< d 100)
        (string-concat "00" (i64-str d))
        (if (< d 1000)
          (string-concat "0" (i64-str d))
          (i64-str d))))))

(defn task-id [i :i64] :string
  (string-concat "t-" (pad4 i)))

(defn attempt-next [attempt :i64] :i64
  (+ attempt 1))

(defn exclude-append-marker [] :i64
  ;; host conj's node name; pure marker that retry path is active
  1)

;; ── T5.3: assign packs → records ──────────────────────────────────────────

(defn pair-record [a :i64 b :i64] [:ref :task/pair]
  (record-new [:ref :task/pair] a b))

(defn triple-record [v0 :i64 v1 :i64 v2 :i64] [:ref :task/triple]
  (record-new [:ref :task/triple] v0 v1 v2))

(defn flags3-record [v0 :bool v1 :bool v2 :bool] [:ref :task/flags3]
  (record-new [:ref :task/flags3] v0 v1 v2))

(defn pick-task-idx-2 [p [:ref :task/pick2]] :i64
  (let [ok0 (record-get p :ok0)
        ok1 (record-get p :ok1)
        fill0 (record-get p :fill0)
        fill1 (record-get p :fill1)
        load0 (record-get p :load0)
        load1 (record-get p :load1)]
    (if ok0
      (if ok1
        (let [b (task-score-code
                 (record-new [:ref :task/score] fill0 load0 0 fill1 load1))]
          (if (= b 2)
            0
            (if (= b 1) 0 1)))
        0)
      (if ok1 1 -1))))

(defn assign-task-step-2 [x [:ref :task/assign2-in]] [:ref :task/assign2]
  (let [load0 (record-get x :load0)
        load1 (record-get x :load1)
        ok0 (record-get x :ok0)
        ok1 (record-get x :ok1)
        fill0 (record-get x :fill0)
        fill1 (record-get x :fill1)
        p (if ok0
            (if ok1
              (let [b (task-score-code
                       (record-new [:ref :task/score] fill0 load0 0 fill1 load1))]
                (if (= b 2) 0 (if (= b 1) 0 1)))
              0)
            (if ok1 1 -1))
        code (if (< p 0) 0 (+ p 1))
        n0 (if (= p 0) (+ load0 1) load0)
        n1 (if (= p 1) (+ load1 1) load1)]
    (record-new [:ref :task/assign2] code n0 n1)))

(defn assign-task-2-code [r [:ref :task/assign2]] :i64
  (record-get r :code))

(defn assign-task-2-load0 [r [:ref :task/assign2]] :i64
  (record-get r :load0))

(defn assign-task-2-load1 [r [:ref :task/assign2]] :i64
  (record-get r :load1))

(defn pick-task-fold-step [p [:ref :task/pick-fold]] :i64
  ;; Host folds candidates. better-c-i true ⇒ challenger strictly better than champ.
  ;; Product Value ABI v1: optional champ presence. T5.2 native (option-i64 in-record).
  ;; 0=none yet, 1=take i, 2=keep champ (incl. ties)
  (let [ok-i (record-get p :ok-i)
        better-c-i (record-get p :better-c-i)]
    (if-some [_ (record-get p :champ)]
      (if ok-i
        (if better-c-i 1 2)
        2)
      (if ok-i 1 0))))

(defn load-inc-if [p [:ref :task/pair]] :i64
  ;; T5.2: a=load b=picked
  (if (= (record-get p :b) 0)
    (record-get p :a)
    (+ (record-get p :a) 1)))

(defn challenger-wins? [c [:ref :task/challenger]] :bool
  ;; true if i better than champ (score lower). Tie → false (keep champ).
  ;; T5.2 native.
  (let [b (task-score-code
           (record-new [:ref :task/score]
                       (record-get c :fill-c)
                       (record-get c :load-c)
                       0
                       (record-get c :fill-i)
                       (record-get c :load-i)))]
    (if (= b 0) true false)))

(defn assign-task-pick-3 [ok [:ref :task/flags3]
                          fill [:ref :task/triple]
                          load [:ref :task/triple]] :i64
  (let [ok0 (record-get ok :v0)
        ok1 (record-get ok :v1)
        ok2 (record-get ok :v2)
        f0 (record-get fill :v0)
        f1 (record-get fill :v1)
        f2 (record-get fill :v2)
        l0 (record-get load :v0)
        l1 (record-get load :v1)
        l2 (record-get load :v2)
        p01 (if ok0
              (if ok1
                (let [b (task-score-code (record-new [:ref :task/score] f0 l0 0 f1 l1))]
                  (if (= b 2) 0 (if (= b 1) 0 1)))
                0)
              (if ok1 1 -1))
        fc (if (= p01 0) f0 (if (= p01 1) f1 0))
        lc (if (= p01 0) l0 (if (= p01 1) l1 0))
        win2 (if (< p01 0)
               false
               (challenger-wins? (record-new [:ref :task/challenger] fc lc f2 l2)))]
    (if (< p01 0)
      (if ok2 2 -1)
      (if ok2
        (if win2 2 p01)
        p01))))

(defn apply-task-pick-3 [load [:ref :task/triple] pick :i64] [:ref :task/triple]
  (let [l0 (record-get load :v0)
        l1 (record-get load :v1)
        l2 (record-get load :v2)
        n0 (load-inc-if (record-new [:ref :task/pair] l0 (if (= pick 0) 1 0)))
        n1 (load-inc-if (record-new [:ref :task/pair] l1 (if (= pick 1) 1 0)))
        n2 (load-inc-if (record-new [:ref :task/pair] l2 (if (= pick 2) 1 0)))]
    (record-new [:ref :task/triple] n0 n1 n2)))

(defn assign-task-step-3 [load [:ref :task/triple]
                          ok [:ref :task/flags3]
                          fill [:ref :task/triple]] [:ref :task/assign3]
  (let [p (assign-task-pick-3 ok fill load)
        code (if (< p 0) 0 (+ p 1))
        nload (apply-task-pick-3 load p)]
    (record-new [:ref :task/assign3] code
                (record-get nload :v0)
                (record-get nload :v1)
                (record-get nload :v2))))

(defn assign-task-3-code [r [:ref :task/assign3]] :i64
  (record-get r :code))

(defn assign-task-3-load0 [r [:ref :task/assign3]] :i64
  (record-get r :load0))

(defn assign-task-3-load1 [r [:ref :task/assign3]] :i64
  (record-get r :load1))

(defn assign-task-3-load2 [r [:ref :task/assign3]] :i64
  (record-get r :load2))

(defn nearest-rank-idx [p [:ref :task/pair]] :i64
  ;; cljc percentile: (int (floor (* p (count v)))) clamped to [0, n-1]
  ;; T5.2: a=n b=p-milli
  (let [n (record-get p :a)
        p-milli (record-get p :b)]
    (if (< n 1)
      -1
      (let [raw (quot (* p-milli n) 1000)
            hi (- n 1)
            idx (if (< raw 0) 0 raw)]
        (if (< hi idx) hi idx)))))

(defn summary-retried [p [:ref :task/pair]] :i64
  ;; T5.2: a=attempts b=finals
  (let [d (- (record-get p :a) (record-get p :b))]
    (if (< d 0) 0 d)))

(defn speedup-milli [p [:ref :task/pair]] :i64
  ;; cljc (/ task-ms wall-ms) as milli; 0 when either non-positive
  ;; T5.2: a=task-ms b=wall-ms
  (let [task-ms (record-get p :a)
        wall-ms (record-get p :b)]
    (if (if (< wall-ms 1) 1 (if (< task-ms 1) 1 0))
      0
      (quot (* task-ms 1000) wall-ms))))

(defn max2 [p [:ref :task/pair]] :i64
  ;; T5.2 residual: a,b on pair record
  (if (< (record-get p :a) (record-get p :b))
    (record-get p :b)
    (record-get p :a)))

(defn min2 [p [:ref :task/pair]] :i64
  (if (< (record-get p :a) (record-get p :b))
    (record-get p :a)
    (record-get p :b)))

(defn clamp-nonneg [n :i64] :i64
  (if (< n 0) 0 n))

;; ── residual unschedulable detail fragments ──────────────────────────

(defn exclude-join-sep [] :string
  ;; host join for :exclude-nodes names in why-unschedulable
  ",")

(defn unsched-placement-prefix [] :string
  "no node satisfies placement=")

(defn unsched-excluding-prefix [] :string
  " excluding=")

(defn unsched-min-mem-prefix [] :string
  " min-mem-bytes=")

(defn unschedulable-detail [u [:ref :task/unsched]] :string
  ;; cljc why-unschedulable: host projects (pr-str placement), joined exclude names,
  ;; and (str min-mem-bytes) or "" when absent. T5.2 native.
  (let [placement (record-get u :placement)
        excluding (record-get u :excluding)
        min-mem-str (record-get u :min-mem-str)
        base (string-concat (unsched-placement-prefix) placement)
        with-ex (if (string=? excluding "")
                  base
                  (string-concat base
                                (string-concat (unsched-excluding-prefix) excluding)))]
    (if (string=? min-mem-str "")
      with-ex
      (string-concat with-ex
                     (string-concat (unsched-min-mem-prefix) min-mem-str)))))
