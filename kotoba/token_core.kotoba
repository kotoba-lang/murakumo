(ns token-core
  (:export [version default-ttl claim-sub claim-scope claim-exp
            expired? scope-allows? signing-input
            digit-char nat-str i64-str encode-claims-json]))

;; W6 pure-planner oracle — murakumo.token pure claims/scope + wire JSON core.
;; HMAC / base64url / sign-verify stay host (javax / WebCrypto).
;; encode-claims-json: fixed key order sub→scope→iat→exp (clj encode-claims
;; pre-b64url string). No JSON escaping — same naive quote join as host clj.
;; Sentinel: has-sub/has-scope/has-exp 0 = nil (absent); ttl -1 = default 30d.
;; Parity: test/murakumo/token_kotoba_parity_test.clj

(defn version [] :string
  "mk1")

(defn default-ttl [] :i64
  2592000)

(defn claim-sub [has-sub :i64 sub :string] :string
  ;; cljc: (str (or sub "anonymous"))
  (if (= has-sub 0)
    "anonymous"
    sub))

(defn claim-scope [has-scope :i64 scope :string] :string
  ;; cljc: (str (or scope "all"))
  (if (= has-scope 0)
    "all"
    scope))

(defn claim-exp [now :i64 ttl :i64] :i64
  ;; cljc: (+ now (or ttl 2592000)); ttl -1 = absent
  (let [t (if (< ttl 0) 2592000 ttl)]
    (+ now t)))

(defn expired? [has-exp :i64 exp :i64 now :i64] :i64
  ;; cljc: (or (nil? exp) (>= now exp)) → 1 expired, 0 live
  (if (= has-exp 0)
    1
    (if (< now exp) 0 1)))

(defn scope-allows? [token-scope :string required :string] :i64
  ;; cljc: (or (= "all" scope) (= scope required))
  (if (string=? token-scope "all")
    1
    (if (string=? token-scope required) 1 0)))

(defn signing-input [payload-seg :string] :string
  (string-concat "mk1." payload-seg))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn encode-claims-json [sub :string scope :string iat :i64 exp :i64] :string
  ;; Fixed key order matches murakumo.token/encode-claims clj branch before b64url.
  ;; Callers must pass claim-sub / claim-scope resolved strings (no nil).
  (let [a (string-concat "{\"sub\":\"" sub)
        b (string-concat a "\",\"scope\":\"")
        c (string-concat b scope)
        d (string-concat c "\",\"iat\":")
        e (string-concat d (i64-str iat))
        f (string-concat e ",\"exp\":")]
    (string-concat f (string-concat (i64-str exp) "}"))))
