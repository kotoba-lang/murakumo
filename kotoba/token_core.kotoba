(ns token-core
  (:export [version default-ttl claim-sub claim-scope claim-exp
            expired? scope-allows? signing-input
            digit-char nat-str i64-str
            encode-claims-json wire-token
            version-ok? parts-present?
            constant-time-eq ct-scan]))

;; W6 pure-planner oracle — murakumo.token claims/scope + wire pure core.
;; HMAC-SHA256 (javax / WebCrypto) and base64url byte codecs stay host.
;; encode-claims-json matches JVM fixed-key JSON (not cljs JSON.stringify order).
;; constant-time-eq: full-length scan (no early exit) for sig compare parity.
;; Parity: test/murakumo/token_kotoba_parity_test.clj

(defn version [] :string
  "mk1")

(defn default-ttl [] :i64
  2592000)

(defn claim-sub [has-sub :i64 sub :string] :string
  (if (= has-sub 0)
    "anonymous"
    sub))

(defn claim-scope [has-scope :i64 scope :string] :string
  (if (= has-scope 0)
    "all"
    scope))

(defn claim-exp [now :i64 ttl :i64] :i64
  (let [t (if (< ttl 0) 2592000 ttl)]
    (+ now t)))

(defn expired? [has-exp :i64 exp :i64 now :i64] :i64
  (if (= has-exp 0)
    1
    (if (< now exp) 0 1)))

(defn scope-allows? [token-scope :string required :string] :i64
  (if (string=? token-scope "all")
    1
    (if (string=? token-scope required) 1 0)))

(defn signing-input [payload-seg :string] :string
  (string-concat "mk1." payload-seg))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn encode-claims-json [sub :string scope :string iat :i64 exp :i64] :string
  ;; cljc JVM branch fixed key order for encode-claims
  (string-concat
   "{\"sub\":\""
   (string-concat
    sub
    (string-concat
     "\",\"scope\":\""
     (string-concat
      scope
      (string-concat
       "\",\"iat\":"
       (string-concat
        (i64-str iat)
        (string-concat ",\"exp\":" (string-concat (i64-str exp) "}")))))))))

(defn wire-token [payload-seg :string sig :string] :string
  ;; mk1.<payload>.<sig>
  (string-concat
   "mk1."
   (string-concat payload-seg (string-concat "." sig))))

(defn version-ok? [v :string] :i64
  (if (string=? v "mk1") 1 0))

(defn parts-present? [has-v :i64 has-p :i64 has-s :i64] :i64
  ;; host split: all three segments present
  (if (= has-v 1)
    (if (= has-p 1)
      (if (= has-s 1) 1 0)
      0)
    0))

(defn ct-scan [a :string b :string i :i64 n :i64 acc :i64] :i64
  ;; acc=0 means still equal so far; force full scan
  (if (< i n)
    (let [ca (string-substring a i (+ i 1))
          cb (string-substring b i (+ i 1))
          ne (if (string=? ca cb) 0 1)
          nacc (if (= acc 0) ne 1)]
      (ct-scan a b (+ i 1) n nacc))
    acc))

(defn constant-time-eq [a :string b :string] :i64
  ;; 1 equal, 0 unequal — always scans min lengths after length check
  (let [na (string-byte-length a)
        nb (string-byte-length b)]
    (if (= na nb)
      (if (= (ct-scan a b 0 na 0) 0) 1 0)
      0)))
