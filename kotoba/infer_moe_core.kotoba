(ns infer-moe-core
  (:schemas {;; T5.2 native guest record wire
             :moe/ratio [:record :moe/ratio [[:experts :i64] [:active :i64]]]
             :moe/verdict [:record :moe/verdict
                           [[:experts :i64] [:active :i64] [:shared :bool]]]
             :moe/resident [:record :moe/resident
                            [[:weight-bytes :i64] [:experts :i64] [:capacity :i64]]]})
  (:export [gib capacity-default expert-ratio-milli verdict-name
            resident-est]))

;; W6 pure-planner oracle — murakumo.infer.moe scalar core (optional).
;; plan/node ranking and custom :model/mlx-moe-capacity-tiers stay cljc.
;; capacity-default: README table only (128→512, 64→432, 48→320, 32→208).
;; Below 32 GiB usable → 0 (cljc nil). expert-ratio-milli: experts*1000/active.
;; verdict-name: recommended|workable|not-recommended|unknown.
;; Parity: test/murakumo/infer_moe_kotoba_parity_test.clj

(defn gib [] :i64 1073741824)

(defn capacity-default [usable-bytes :i64] :i64
  (let [g (gib)
        u128 (* 128 g)
        u64 (* 64 g)
        u48 (* 48 g)
        u32 (* 32 g)]
    (if (< usable-bytes u32)
      0
      (if (< usable-bytes u48)
        208
        (if (< usable-bytes u64)
          320
          (if (< usable-bytes u128)
            432
            512))))))

(defn expert-ratio-milli [x [:ref :moe/ratio]] :i64
  ;; T5.2 native: single ratio record. active <= 0 → 0
  (let [experts (record-get x :experts)
        active (record-get x :active)]
    (if (< active 1)
      0
      (quot (* experts 1000) active))))

(defn verdict-name [x [:ref :moe/verdict]] :string
  ;; T5.2 native: single verdict record. experts/active 0 ⇒ unknown
  (let [experts (record-get x :experts)
        active (record-get x :active)
        shared (record-get x :shared)]
    (if (if (< experts 1) true (if (< active 1) true false))
      "unknown"
      (let [milli (if (< active 1) 0 (quot (* experts 1000) active))
            high (if (< milli 10000) false true)]
        (if (if high (if shared true false) false)
          "recommended"
          (if shared
            "workable"
            "not-recommended"))))))

(defn resident-est [x [:ref :moe/resident]] :i64
  ;; T5.2 native: single resident record.
  (let [weight-bytes (record-get x :weight-bytes)
        experts (record-get x :experts)
        capacity (record-get x :capacity)]
    (if (if (< weight-bytes 1) 1 (if (< experts 1) 1 (if (< capacity 1) 1 0)))
      weight-bytes
      (quot (* weight-bytes capacity) experts))))
