;; Append after fleet_job_node and its real native dependency closure.
(ns murakumo.fleet-job-node-test
  (:export [test-job-dispatch-lease test-job-attempt]))

;; DIR must be a newly created private 0700 test directory. It is intentionally
;; left with the attempt marker: removing it would make retries unsafe.
(defn test-job-attempt [dir :string] :bool
  (let [jid "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"]
    (and (not (jn-attempt-root? "relative")) (not (jn-attempt-root? "/tmp/../bad"))
         (not (jn-attempt-id? "short"))
         (= (jn-attempt dir "short") "job/attempt-config")
         (= (jn-attempt dir jid) "job/attempt-recorded")
         (= (jn-attempt dir jid) "job/attempt-exists-or-unknown"))))

(defn test-job-dispatch-lease [] :bool
  (let [now 1792500000000 jid "job-one" until (+ now 60000)
        valid (lease-text "node-a" jid 0 1 until 0)]
    (and (= (jn-lease-problem valid "node-a" jid now) "job/lease-ok")
         (= (jn-lease-problem valid "node-b" jid now) "job/lease-holder")
         (= (jn-lease-problem valid "node-a" "job-two" now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 1 1 until 0) "node-a" jid now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 0 2 until 0) "node-a" jid now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 0 1 until 1) "node-a" jid now) "job/lease-binding")
         (= (jn-lease-problem (lease-text "node-a" jid 0 1 now 0) "node-a" jid now) "job/lease-expired-or-invalid")
         (= (jn-lease-problem (lease-text "node-a" jid 0 1 (+ now 2000000) 0) "node-a" jid now) "job/lease-expired-or-invalid")
         (= (jn-lease-problem "" "node-a" jid now) "job/lease-invalid")
         (= (jn-lease-problem "{}" "node-a" jid now) "job/lease-invalid")
         (= (jn-lease-problem "{\"class\":\"job-one\",\"epoch\":1,\"node\":\"node-a\",\"revision\":0,\"slot\":0,\"until\":1792500060000,\"untrusted\":1}" "node-a" jid now) "job/lease-invalid")
         (= (jn-lease-problem valid "" jid now) "job/lease-invalid")
         (= (jn-lease-problem valid "node-a" jid -1) "job/lease-invalid"))))
