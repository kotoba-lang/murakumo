(ns overlay-driver-core
  (:export [endpoint-kind blank? option-name dial-ok-reason
            command-is-dial?
            starts-with?
            scheme-quic scheme-webrtc scheme-https scheme-relay
            kind-quic kind-webrtc kind-webtransport kind-relay kind-unknown
            flag-dash-prefix
            cmd-dial
            reason-ok reason-unknown-command reason-missing-options]))

;; W6 pure-planner oracle — murakumo.overlay.driver scalar core.
;; parse-argv loop / session map assembly stay cljc.
;; endpoint scheme/kind + dial reason + cmd tokens dual-source;
;; endpoint-kind / dial-ok-reason / command-is-dial? / option-name recompose.
;; Parity: test/murakumo/overlay_driver_kotoba_parity_test.clj

(defn blank? [s :string] :bool
  (if (string=? s "") true false))

(defn starts-with? [s :string prefix :string] :bool
  (let [n (string-byte-length s)
        p (string-byte-length prefix)]
    (if (< n p)
      false
      (if (string=? (string-substring s 0 p) prefix) true false))))

;; ── residual scheme / kind / cmd / reason tokens ─────────────────────

(defn scheme-quic [] :string "quic://")
(defn scheme-webrtc [] :string "webrtc://")
(defn scheme-https [] :string "https://")
(defn scheme-relay [] :string "relay://")

(defn kind-quic [] :string "quic")
(defn kind-webrtc [] :string "webrtc")
(defn kind-webtransport [] :string "webtransport")
(defn kind-relay [] :string "relay")
(defn kind-unknown [] :string "unknown")

(defn flag-dash-prefix [] :string "--")

(defn cmd-dial [] :string "dial")

(defn reason-ok [] :string "ok")
(defn reason-unknown-command [] :string "unknown-command")
(defn reason-missing-options [] :string "missing-options")

(defn endpoint-kind [endpoint :string] :string
  ;; cljc: quic|webrtc|https→webtransport|relay|unknown
  (if (starts-with? endpoint (scheme-quic))
    (kind-quic)
    (if (starts-with? endpoint (scheme-webrtc))
      (kind-webrtc)
      (if (starts-with? endpoint (scheme-https))
        (kind-webtransport)
        (if (starts-with? endpoint (scheme-relay))
          (kind-relay)
          (kind-unknown))))))

(defn option-name [flag :string] :string
  ;; cljc keyword-option: (keyword (subs flag 2)) → bare name without --
  (let [n (string-byte-length flag)
        p (string-byte-length (flag-dash-prefix))]
    (if (< n p)
      ""
      (if (starts-with? flag (flag-dash-prefix))
        (string-substring flag p n)
        flag))))

(defn command-is-dial? [command :string] :bool
  (if (string=? command (cmd-dial)) true false))

(defn dial-ok-reason [is-dial :bool missing-count :i64] :string
  ;; cljc dial-result reasons
  (if is-dial
    (if (< 0 missing-count)
      (reason-missing-options)
      (reason-ok))
    (reason-unknown-command)))
