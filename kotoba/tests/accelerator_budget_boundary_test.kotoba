(ns accelerator-budget-boundary-test (:export [test-accelerator-budget-boundaries]))

;; These tests exercise the existing planner, not a host resource governor.
(defn test-accelerator-budget-boundaries [] :bool
  (and
    (= (aperture-bytes 100 20) 120)
    (= (aperture-bytes -1 20) -1)
    (= (aperture-bytes 9223372036854775807 1) -1)
    (= (usable-bytes 1000 120) 880)
    (= (usable-bytes 9223372036854775807 120) 8116567392432202711)
    (= (usable-bytes 100 -1) -1)
    (= (usable-bytes 100 1001) -1)
    (= (usable-bytes 9223372036854775807 1000) 0)
    (= (committed-bytes -1 0) -1)
    (= (committed-bytes 9223372036854775807 1) -1)
    (= (remaining-bytes 100 70 20) 10)
    (= (remaining-bytes 100 -1 0) -1)
    (= (admit-code 0 10 100 20 5) 0)
    (= (admit-code 1 75 100 20 5) 0)
    (= (admit-code 1 76 100 20 5) 3)
    (= (admit-code 1 81 100 20 0) 4)
    (= (admit-code 0 100 100 -1 0) 7)
    (= (admit-code 1 100 100 0 -1) 7)
    (= (admit-code 0 9223372036854775807 9223372036854775807 1 0) 3)
    (= (admit-code 1 1 9223372036854775807 9223372036854775807 1) 7)
    (= (admit-code 0 1 -1 0 0) 1)
    (= (admit-code 2 1 100 0 0) 5)
    (= (admit-code 0 0 100 0 0) 6)
    (= (granted-bytes 0 100 -1 0) 0)
    (= (granted-bytes 1 100 0 -1) 0)
    (= (granted-bytes 1 100 20 5) 75)
    (= (granted-bytes 1 100 20 81) 0)
    (= (granted-bytes 0 100 20 81) 80)
    (= (code-name 7) "invalid-observation")
    (= (demand-score 2 10 100) 3)
    (= (demand-score -1 0 100) -1)
    (= (demand-score 0 -1 100) -1)
    (= (demand-score 0 1 -1) -1)
    (= (demand-score 0 9223372036854775807 2) -1)
    (= (demand-score 9223372036854775807 1000 1) -1)
    (= (demand-score 7 9223372036854775807 0) 7)
    (not (idle? -1 3 3))
    (not (idle? 0 3 0))
    (not (challenger-wins? 9223372036854775807 1 1500))
    (challenger-wins? 4 2 1500)
    (= (revoke-code -1 0 0 3 0) 5)
    (= (revoke-code 1 9223372036854775807 1 0 0) 5)
    (= (revoke-code 2 4 1 0 0) 2)
    (not (revoke? -1 0 0 3 0))
    (= (revoke-name 5) "invalid-observation")))
