(ns infer-schedule-core
  (:export [eligible? score-queue score-free better-score?]))

;; W6 pure-planner oracle — murakumo.infer.schedule eligible? + score core.
;; pick/assign over node vectors stay cljc (filter/sort/atom). No capabilities.
;; Guest ABI max arity 5: eligibility flags are bit-packed into one i64.
;;   flags bits: 1 has-engine | 2 has-checkpoint | 4 holds-checkpoint | 8 can-fetch
;; Host computes set membership; guest applies pure and/or/memory rule.
;; score is two i64 keys (queue, -free); better-score? compares lexicographically.
;; Parity: test/murakumo/infer_schedule_kotoba_parity_test.clj

(defn rem64 [a :i64 b :i64] :i64
  (- a (* (quot a b) b)))

(defn bit? [flags :i64 mask :i64] :i64
  ;; (bit-and flags mask) != 0 using only +/*//quot (no bit ops)
  ;; mask is power of 2: 1,2,4,8
  (if (= 0 (rem64 (quot flags mask) 2))
    0
    1))

(defn eligible? [flags :i64 free-bytes :i64 min-free :i64] :i64
  ;; cljc:
  ;; (and (contains? engines engine)
  ;;      (or (nil? checkpoint) (contains? checkpoints checkpoint) can-fetch?)
  ;;      (>= free-bytes min-free))
  (let [has-engine (bit? flags 1)
        has-ckpt (bit? flags 2)
        holds (bit? flags 4)
        can-fetch (bit? flags 8)
        ckpt-ok (if (= has-ckpt 0)
                  1
                  (if (= holds 1)
                    1
                    (if (= can-fetch 1) 1 0)))
        mem-ok (if (< free-bytes min-free) 0 1)]
    (if (= has-engine 0)
      0
      (if (= ckpt-ok 0)
        0
        mem-ok))))

(defn score-queue [queue :i64] :i64
  ;; cljc score first key: (or queue 0); callers pass 0 for nil
  (if (< queue 0) 0 queue))

(defn score-free [free-bytes :i64] :i64
  ;; cljc score second key: (- (or free-bytes 0))
  (if (< free-bytes 0)
    0
    (- 0 free-bytes)))

(defn better-score? [q1 :i64 f1 :i64 q2 :i64 f2 :i64] :i64
  ;; true (1) when score(a)=[q1 f1] is strictly better (lower) than score(b)
  (if (< q1 q2)
    1
    (if (< q2 q1)
      0
      (if (< f1 f2) 1 0))))
