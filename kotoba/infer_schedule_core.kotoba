(ns infer-schedule-core
  (:export [eligible? score-queue score-free better-score?
            holds-warm? prefer-warm-then-score pick-idx-2-full
            pick-idx-3-tournament queue-after-assign
            lane-base pack3 pack-get queues-pack-2 pick-code
            assign-step-2 assign-result-pick assign-result-q0 assign-result-q1
            better-from-queues
            queues-pack-3 pick-code-3
            assign-pick-3 apply-pick-3
            assign-step-3 assign-step-3-code assign-step-3-queues
            better-pair
            pick-fold-step queue-inc-if]))

;; W6 pure-planner oracle — murakumo.infer.schedule eligible?/score + pick.
;; assign-step-2: pure assign batch step for fixed 2 nodes.
;; assign-step-3 / assign-pick-3 / apply-pick-3: pure step for fixed 3 nodes.
;; pick-fold-step: host-fold tournament for n>3 (0=none, 1=take challenger, 2=keep champ).
;; queue-inc-if: host updates one node's queue after pick.
;; Guest ABI max arity 5: eligibility flags bit-packed into one i64.
;;   flags bits: 1 has-engine | 2 has-checkpoint | 4 holds-checkpoint | 8 can-fetch
;; score is two i64 keys (queue, -free); better-score? compares lexicographically.
;; assign-step-3 result = pick-code-3 + 4 * pack3(nq0,nq1,nq2).
;; Parity: test/murakumo/infer_schedule_kotoba_parity_test.clj

(defn rem64 [a :i64 b :i64] :i64
  (- a (* (quot a b) b)))

(defn bit? [flags :i64 mask :i64] :i64
  (if (= 0 (rem64 (quot flags mask) 2))
    0
    1))

(defn eligible? [flags :i64 free-bytes :i64 min-free :i64] :i64
  (let [has-engine (bit? flags 1)
        has-ckpt (bit? flags 2)
        holds (bit? flags 4)
        can-fetch (bit? flags 8)
        ckpt-ok (if (= has-ckpt 0)
                  1
                  (if (= holds 1)
                    1
                    (if (= can-fetch 1) 1 0)))
        mem-ok (if (< free-bytes min-free) 0 1)]
    (if (= has-engine 0)
      0
      (if (= ckpt-ok 0)
        0
        mem-ok))))

(defn score-queue [queue :i64] :i64
  (if (< queue 0) 0 queue))

(defn score-free [free-bytes :i64] :i64
  (if (< free-bytes 0)
    0
    (- 0 free-bytes)))

(defn better-score? [q1 :i64 f1 :i64 q2 :i64 f2 :i64] :i64
  (if (< q1 q2)
    1
    (if (< q2 q1)
      0
      (if (< f1 f2) 1 0))))

(defn holds-warm? [flags :i64] :i64
  ;; bit 4 = holds-checkpoint
  (bit? flags 4))

(defn prefer-warm-then-score [warm0 :i64 warm1 :i64 better01 :i64] :i64
  ;; both eligible. Return 0 or 1. better01=1 ⇒ node0 score strictly better.
  (if (if (= warm0 1) (if (= warm1 0) 1 0) 0)
    0
    (if (if (= warm1 1) (if (= warm0 0) 1 0) 0)
      1
      (if (= better01 1) 0 1))))

(defn pick-idx-2-full [ok0 :i64 ok1 :i64 warm0 :i64 warm1 :i64 better01 :i64] :i64
  ;; Pure pick between two candidates. -1 if neither eligible.
  (if (= ok0 0)
    (if (= ok1 0) -1 1)
    (if (= ok1 0)
      0
      (prefer-warm-then-score warm0 warm1 better01))))

(defn pick-idx-3-tournament [champ01 :i64 ok2 :i64 warm-champ :i64 warm2 :i64
                             better-champ-2 :i64] :i64
  ;; champ01 ∈ {-1,0,1} from pick-idx-2-full on nodes 0/1.
  ;; Compare champion to node 2. Returns -1|0|1|2.
  (if (< champ01 0)
    (if (= ok2 0) -1 2)
    (if (= ok2 0)
      champ01
      (if (= (prefer-warm-then-score warm-champ warm2 better-champ-2) 0)
        champ01
        2))))

(defn queue-after-assign [queue :i64 picked :i64] :i64
  ;; cljc assign: (fnil inc 0) when node picked (picked 0/1)
  (if (= picked 0)
    (if (< queue 0) 0 queue)
    (if (< queue 0) 1 (+ queue 1))))

(defn lane-base [] :i64 65536)

(defn pack3 [a :i64 b :i64 c :i64] :i64
  (let [B (lane-base)]
    (+ a (+ (* b B) (* c (* B B))))))

(defn pack-get [packed :i64 idx :i64] :i64
  (let [B (lane-base)]
    (if (= idx 0)
      (rem64 packed B)
      (if (= idx 1)
        (rem64 (quot packed B) B)
        (quot packed (* B B))))))

(defn queues-pack-2 [q0 :i64 q1 :i64] :i64
  (pack3 q0 q1 0))

(defn pick-code [pick-idx :i64] :i64
  ;; -1|0|1 → 0=none, 1=node0, 2=node1
  (if (< pick-idx 0) 0 (+ pick-idx 1)))

(defn assign-step-2 [q0 :i64 q1 :i64 ok0 :i64 ok1 :i64
                     better-pack :i64] :i64
  ;; better-pack = pack3(warm0, warm1, better01)
  ;; → pack3(pick-code, nq0, nq1)
  (let [warm0 (pack-get better-pack 0)
        warm1 (pack-get better-pack 1)
        better01 (pack-get better-pack 2)
        p (pick-idx-2-full ok0 ok1 warm0 warm1 better01)
        code (pick-code p)
        nq0 (queue-after-assign q0 (if (= p 0) 1 0))
        nq1 (queue-after-assign q1 (if (= p 1) 1 0))]
    (pack3 code nq0 nq1)))

(defn assign-result-pick [result-pack :i64] :i64
  (pack-get result-pack 0))

(defn assign-result-q0 [result-pack :i64] :i64
  (pack-get result-pack 1))

(defn assign-result-q1 [result-pack :i64] :i64
  (pack-get result-pack 2))

(defn better-from-queues [q0 :i64 f0 :i64 q1 :i64 f1 :i64] :i64
  ;; recompute better01 after queue updates (free-bytes fixed per node)
  (better-score? (score-queue q0) (score-free f0)
                 (score-queue q1) (score-free f1)))

(defn queues-pack-3 [q0 :i64 q1 :i64 q2 :i64] :i64
  (pack3 q0 q1 q2))

(defn pick-code-3 [pick-idx :i64] :i64
  ;; -1|0|1|2 → 0=none, 1=node0, 2=node1, 3=node2
  (if (< pick-idx 0) 0 (+ pick-idx 1)))

(defn better-pair [q-a :i64 f-a :i64 q-b :i64 f-b :i64] :i64
  ;; 1 if a strictly better score than b (alias for host pack assembly)
  (better-from-queues q-a f-a q-b f-b))

(defn assign-pick-3 [ok-pack :i64 warm-pack :i64 better-pack :i64] :i64
  ;; better-pack = pack3(better01, better02, better12)
  ;; → pick idx −1|0|1|2
  (let [ok0 (pack-get ok-pack 0)
        ok1 (pack-get ok-pack 1)
        ok2 (pack-get ok-pack 2)
        warm0 (pack-get warm-pack 0)
        warm1 (pack-get warm-pack 1)
        warm2 (pack-get warm-pack 2)
        better01 (pack-get better-pack 0)
        better02 (pack-get better-pack 1)
        better12 (pack-get better-pack 2)
        champ (pick-idx-2-full ok0 ok1 warm0 warm1 better01)
        warm-champ (if (= champ 0)
                     warm0
                     (if (= champ 1) warm1 0))
        better-c2 (if (= champ 0)
                    better02
                    better12)]
    (pick-idx-3-tournament champ ok2 warm-champ warm2 better-c2)))

(defn apply-pick-3 [q-pack :i64 pick :i64] :i64
  ;; → pack3(nq0, nq1, nq2) after assigning one job to pick (−1 = none)
  (let [q0 (pack-get q-pack 0)
        q1 (pack-get q-pack 1)
        q2 (pack-get q-pack 2)
        nq0 (queue-after-assign q0 (if (= pick 0) 1 0))
        nq1 (queue-after-assign q1 (if (= pick 1) 1 0))
        nq2 (queue-after-assign q2 (if (= pick 2) 1 0))]
    (pack3 nq0 nq1 nq2)))

(defn assign-step-3 [q-pack :i64 ok-pack :i64 warm-pack :i64 better-pack :i64] :i64
  ;; one job pure assign for 3 nodes.
  ;; result = pick-code-3 + 4 * pack3(nq0,nq1,nq2)
  (let [p (assign-pick-3 ok-pack warm-pack better-pack)
        code (pick-code-3 p)
        nq (apply-pick-3 q-pack p)]
    (+ code (* 4 nq))))

(defn assign-step-3-code [result :i64] :i64
  (rem64 result 4))

(defn assign-step-3-queues [result :i64] :i64
  (quot result 4))

(defn pick-fold-step [has-champ :i64 ok-i :i64 warm-champ :i64 warm-i :i64
                      better-c-i :i64] :i64
  ;; Host folds candidates i=0..n-1. has-champ=1 once a champ exists.
  ;; Returns: 0 = no pick yet (no champ and ok-i=0)
  ;;          1 = take challenger i as new champ
  ;;          2 = keep existing champ
  (if (= has-champ 0)
    (if (= ok-i 0) 0 1)
    (if (= ok-i 0)
      2
      (if (= (prefer-warm-then-score warm-champ warm-i better-c-i) 0)
        2
        1))))

(defn queue-inc-if [queue :i64 picked :i64] :i64
  ;; picked 0/1 — alias queue-after-assign for host fold clarity
  (queue-after-assign queue picked))
