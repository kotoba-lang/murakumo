(ns infer-schedule-core
  (:export [eligible? score-queue score-free better-score?
            holds-warm? prefer-warm-then-score pick-idx-2-full
            pick-idx-3-tournament queue-after-assign
            lane-base pack3 pack-get queues-pack-2 pick-code
            assign-step-2 assign-result-pick assign-result-q0 assign-result-q1
            better-from-queues]))

;; W6 pure-planner oracle — murakumo.infer.schedule eligible?/score + pick.
;; assign-step-2 / assign-2jobs-2nodes: pure assign batch for fixed 2 nodes.
;; Variable-length node filter/sort and atom map stay cljc.
;; pick-idx-*-full is pure pick for fixed 2/3 candidates.
;; Guest ABI max arity 5: eligibility flags bit-packed into one i64.
;;   flags bits: 1 has-engine | 2 has-checkpoint | 4 holds-checkpoint | 8 can-fetch
;; score is two i64 keys (queue, -free); better-score? compares lexicographically.
;; Parity: test/murakumo/infer_schedule_kotoba_parity_test.clj

(defn rem64 [a :i64 b :i64] :i64
  (- a (* (quot a b) b)))

(defn bit? [flags :i64 mask :i64] :i64
  (if (= 0 (rem64 (quot flags mask) 2))
    0
    1))

(defn eligible? [flags :i64 free-bytes :i64 min-free :i64] :i64
  (let [has-engine (bit? flags 1)
        has-ckpt (bit? flags 2)
        holds (bit? flags 4)
        can-fetch (bit? flags 8)
        ckpt-ok (if (= has-ckpt 0)
                  1
                  (if (= holds 1)
                    1
                    (if (= can-fetch 1) 1 0)))
        mem-ok (if (< free-bytes min-free) 0 1)]
    (if (= has-engine 0)
      0
      (if (= ckpt-ok 0)
        0
        mem-ok))))

(defn score-queue [queue :i64] :i64
  (if (< queue 0) 0 queue))

(defn score-free [free-bytes :i64] :i64
  (if (< free-bytes 0)
    0
    (- 0 free-bytes)))

(defn better-score? [q1 :i64 f1 :i64 q2 :i64 f2 :i64] :i64
  (if (< q1 q2)
    1
    (if (< q2 q1)
      0
      (if (< f1 f2) 1 0))))

(defn holds-warm? [flags :i64] :i64
  ;; bit 4 = holds-checkpoint
  (bit? flags 4))

(defn prefer-warm-then-score [warm0 :i64 warm1 :i64 better01 :i64] :i64
  ;; both eligible. Return 0 or 1. better01=1 ⇒ node0 score strictly better.
  (if (if (= warm0 1) (if (= warm1 0) 1 0) 0)
    0
    (if (if (= warm1 1) (if (= warm0 0) 1 0) 0)
      1
      (if (= better01 1) 0 1))))

(defn pick-idx-2-full [ok0 :i64 ok1 :i64 warm0 :i64 warm1 :i64 better01 :i64] :i64
  ;; Pure pick between two candidates. -1 if neither eligible.
  (if (= ok0 0)
    (if (= ok1 0) -1 1)
    (if (= ok1 0)
      0
      (prefer-warm-then-score warm0 warm1 better01))))

(defn pick-idx-3-tournament [champ01 :i64 ok2 :i64 warm-champ :i64 warm2 :i64
                             better-champ-2 :i64] :i64
  ;; champ01 ∈ {-1,0,1} from pick-idx-2-full on nodes 0/1.
  ;; Compare champion to node 2. Returns -1|0|1|2.
  (if (< champ01 0)
    (if (= ok2 0) -1 2)
    (if (= ok2 0)
      champ01
      (if (= (prefer-warm-then-score warm-champ warm2 better-champ-2) 0)
        champ01
        2))))

(defn queue-after-assign [queue :i64 picked :i64] :i64
  ;; cljc assign: (fnil inc 0) when node picked (picked 0/1)
  (if (= picked 0)
    (if (< queue 0) 0 queue)
    (if (< queue 0) 1 (+ queue 1))))

(defn lane-base [] :i64 65536)

(defn pack3 [a :i64 b :i64 c :i64] :i64
  (let [B (lane-base)]
    (+ a (+ (* b B) (* c (* B B))))))

(defn pack-get [packed :i64 idx :i64] :i64
  (let [B (lane-base)]
    (if (= idx 0)
      (rem64 packed B)
      (if (= idx 1)
        (rem64 (quot packed B) B)
        (quot packed (* B B))))))

(defn queues-pack-2 [q0 :i64 q1 :i64] :i64
  (pack3 q0 q1 0))

(defn pick-code [pick-idx :i64] :i64
  ;; -1|0|1 → 0=none, 1=node0, 2=node1
  (if (< pick-idx 0) 0 (+ pick-idx 1)))

(defn assign-step-2 [q0 :i64 q1 :i64 ok0 :i64 ok1 :i64
                     better-pack :i64] :i64
  ;; better-pack = pack3(warm0, warm1, better01)
  ;; → pack3(pick-code, nq0, nq1)
  (let [warm0 (pack-get better-pack 0)
        warm1 (pack-get better-pack 1)
        better01 (pack-get better-pack 2)
        p (pick-idx-2-full ok0 ok1 warm0 warm1 better01)
        code (pick-code p)
        nq0 (queue-after-assign q0 (if (= p 0) 1 0))
        nq1 (queue-after-assign q1 (if (= p 1) 1 0))]
    (pack3 code nq0 nq1)))

(defn assign-result-pick [result-pack :i64] :i64
  (pack-get result-pack 0))

(defn assign-result-q0 [result-pack :i64] :i64
  (pack-get result-pack 1))

(defn assign-result-q1 [result-pack :i64] :i64
  (pack-get result-pack 2))

(defn better-from-queues [q0 :i64 f0 :i64 q1 :i64 f1 :i64] :i64
  ;; recompute better01 after queue updates (free-bytes fixed per node)
  (better-score? (score-queue q0) (score-free f0)
                 (score-queue q1) (score-free f1)))
