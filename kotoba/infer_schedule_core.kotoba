(ns infer-schedule-core
  (:schemas {;; T5.3: assign pack families become named records (no base-65536).
             ;; Profile 5: eligibility flags are real :bool fields (not 0/1 i64).
             :schedule/eligibility [:record :schedule/eligibility
                                    [[:has-engine :bool] [:has-checkpoint :bool]
                                     [:holds-checkpoint :bool] [:can-fetch :bool]]]
             ;; 2-node assign context: warm flags + score preference (profile 5 bool)
             :schedule/better2 [:record :schedule/better2
                                [[:warm0 :bool] [:warm1 :bool] [:better01 :bool]]]
             ;; 2-node assign result
             :schedule/assign2 [:record :schedule/assign2
                                [[:code :i64] [:q0 :i64] [:q1 :i64]]]
             ;; 3-node queue triple (numeric counts only)
             :schedule/triple [:record :schedule/triple
                               [[:v0 :i64] [:v1 :i64] [:v2 :i64]]]
             ;; 3-node ok / warm flags (profile 5 :bool — split from i64 triple)
             :schedule/flags3 [:record :schedule/flags3
                               [[:v0 :bool] [:v1 :bool] [:v2 :bool]]]
             ;; 3-node pairwise better flags (01, 02, 12) — profile 5 bool
             :schedule/better3 [:record :schedule/better3
                                [[:b01 :bool] [:b02 :bool] [:b12 :bool]]]
             ;; 3-node assign result
             :schedule/assign3 [:record :schedule/assign3
                                [[:code :i64] [:q0 :i64] [:q1 :i64] [:q2 :i64]]]})
  (:export [eligible? score-queue score-free better-score?
            holds-warm? prefer-warm-then-score pick-idx-2-full
            pick-idx-3-tournament queue-after-assign
            pick-code
            better2-record assign-step-2
            assign-result-pick assign-result-q0 assign-result-q1
            better-from-queues
            triple-record triple-v0 triple-v1 triple-v2
            flags3-record
            better3-record pick-code-3
            assign-pick-3 apply-pick-3
            assign-step-3 assign-step-3-code
            assign-step-3-q0 assign-step-3-q1 assign-step-3-q2
            better-pair
            pick-fold-step queue-inc-if]))

;; W6 pure-planner oracle — murakumo.infer.schedule eligible?/score + pick.
;; assign-step-2: pure assign batch step for fixed 2 nodes.
;; assign-step-3 / assign-pick-3 / apply-pick-3: pure step for fixed 3 nodes.
;; pick-fold-step: host-fold tournament for n>3 (0=none, 1=take challenger, 2=keep champ).
;; queue-inc-if: host updates one node's queue after pick.
;; T5.3 (schedule): eligibility is a named record (flags no longer bit-packed).
;; T5.3 (schedule assign): queue/ok/warm/better triples and assign results are
;; named records — base-65536 pack3 is deleted from this module.
;; Profile 5: ok/warm use :schedule/flags3 (:bool); queue stays :schedule/triple (:i64).
;; score is two i64 keys (queue, -free); better-score? compares lexicographically.
;; T5.3 complete for this module: no base-65536 packing remains.
;; Profile 5: eligibility fields and eligible?/holds-warm? are :bool (ADR 0191).
;; Parity: test/murakumo/infer_schedule_kotoba_parity_test.clj

(defn eligible? [e [:ref :schedule/eligibility] free-bytes :i64 min-free :i64] :bool
  ;; Written with and/or/not, which is what ADR 0191 shows and what the nested
  ;; `if` above it stood in for. That workaround existed because the synthesized
  ;; `and`/`or` temporaries were gensyms, so the precompiled KIR differed on
  ;; every compile and the drift gate could not use them. compiler#453/#454 made
  ;; every synthesized name deterministic, so the shape and the gate no longer
  ;; disagree.
  (and (record-get e :has-engine)
       (or (not (record-get e :has-checkpoint))
           (record-get e :holds-checkpoint)
           (record-get e :can-fetch))
       (>= free-bytes min-free)))

(defn score-queue [queue :i64] :i64
  (if (< queue 0) 0 queue))

(defn score-free [free-bytes :i64] :i64
  (if (< free-bytes 0)
    0
    (- 0 free-bytes)))

(defn better-score? [q1 :i64 f1 :i64 q2 :i64 f2 :i64] :bool
  (if (< q1 q2)
    true
    (if (< q2 q1)
      false
      (if (< f1 f2) true false))))

(defn holds-warm? [e [:ref :schedule/eligibility]] :bool
  (record-get e :holds-checkpoint))

(defn prefer-warm-then-score [warm0 :bool warm1 :bool better01 :bool] :i64
  ;; both eligible. Return 0 or 1. better01 true ⇒ node0 score strictly better.
  (if (if warm0 (if warm1 false true) false)
    0
    (if (if warm1 (if warm0 false true) false)
      1
      (if better01 0 1))))

(defn pick-idx-2-full [ok0 :bool ok1 :bool warm0 :bool warm1 :bool better01 :bool] :i64
  ;; Pure pick between two candidates. -1 if neither eligible.
  (if ok0
    (if ok1
      (prefer-warm-then-score warm0 warm1 better01)
      0)
    (if ok1 1 -1)))

(defn pick-idx-3-tournament [champ01 :i64 ok2 :bool warm-champ :bool warm2 :bool
                             better-champ-2 :bool] :i64
  ;; champ01 ∈ {-1,0,1} from pick-idx-2-full on nodes 0/1.
  ;; Compare champion to node 2. Returns -1|0|1|2.
  (if (< champ01 0)
    (if ok2 2 -1)
    (if ok2
      (if (= (prefer-warm-then-score warm-champ warm2 better-champ-2) 0)
        champ01
        2)
      champ01)))

(defn queue-after-assign [queue :i64 picked :i64] :i64
  ;; cljc assign: (fnil inc 0) when node picked (picked 0/1)
  (if (= picked 0)
    (if (< queue 0) 0 queue)
    (if (< queue 0) 1 (+ queue 1))))

(defn pick-code [pick-idx :i64] :i64
  ;; -1|0|1 → 0=none, 1=node0, 2=node1
  (if (< pick-idx 0) 0 (+ pick-idx 1)))

;; ── T5.3: assign packs → records ──────────────────────────────────────────

(defn better2-record [warm0 :bool warm1 :bool better01 :bool] [:ref :schedule/better2]
  (record-new [:ref :schedule/better2] warm0 warm1 better01))

(defn assign-step-2 [q0 :i64 q1 :i64 ok0 :bool ok1 :bool
                     better [:ref :schedule/better2]] [:ref :schedule/assign2]
  (let [warm0 (record-get better :warm0)
        warm1 (record-get better :warm1)
        better01 (record-get better :better01)
        p (pick-idx-2-full ok0 ok1 warm0 warm1 better01)
        code (pick-code p)
        nq0 (queue-after-assign q0 (if (= p 0) 1 0))
        nq1 (queue-after-assign q1 (if (= p 1) 1 0))]
    (record-new [:ref :schedule/assign2] code nq0 nq1)))

(defn assign-result-pick [result [:ref :schedule/assign2]] :i64
  (record-get result :code))

(defn assign-result-q0 [result [:ref :schedule/assign2]] :i64
  (record-get result :q0))

(defn assign-result-q1 [result [:ref :schedule/assign2]] :i64
  (record-get result :q1))

(defn better-from-queues [q0 :i64 f0 :i64 q1 :i64 f1 :i64] :bool
  ;; recompute better01 after queue updates for better2-record packing
  (better-score? (score-queue q0) (score-free f0)
                 (score-queue q1) (score-free f1)))

(defn triple-record [v0 :i64 v1 :i64 v2 :i64] [:ref :schedule/triple]
  (record-new [:ref :schedule/triple] v0 v1 v2))

(defn triple-v0 [t [:ref :schedule/triple]] :i64
  (record-get t :v0))

(defn triple-v1 [t [:ref :schedule/triple]] :i64
  (record-get t :v1))

(defn triple-v2 [t [:ref :schedule/triple]] :i64
  (record-get t :v2))

(defn flags3-record [v0 :bool v1 :bool v2 :bool] [:ref :schedule/flags3]
  (record-new [:ref :schedule/flags3] v0 v1 v2))

(defn better3-record [b01 :bool b02 :bool b12 :bool] [:ref :schedule/better3]
  (record-new [:ref :schedule/better3] b01 b02 b12))

(defn pick-code-3 [pick-idx :i64] :i64
  ;; -1|0|1|2 → 0=none, 1=node0, 2=node1, 3=node2
  (if (< pick-idx 0) 0 (+ pick-idx 1)))

(defn better-pair [q-a :i64 f-a :i64 q-b :i64 f-b :i64] :bool
  ;; true if a strictly better score than b
  (better-from-queues q-a f-a q-b f-b))

(defn assign-pick-3 [ok [:ref :schedule/flags3]
                     warm [:ref :schedule/flags3]
                     better [:ref :schedule/better3]] :i64
  ;; → pick idx −1|0|1|2  (ok/warm are profile-5 :bool flags3)
  (let [ok0 (record-get ok :v0)
        ok1 (record-get ok :v1)
        ok2 (record-get ok :v2)
        warm0 (record-get warm :v0)
        warm1 (record-get warm :v1)
        warm2 (record-get warm :v2)
        better01 (record-get better :b01)
        better02 (record-get better :b02)
        better12 (record-get better :b12)
        champ (pick-idx-2-full ok0 ok1 warm0 warm1 better01)
        warm-champ (if (= champ 0)
                     warm0
                     (if (= champ 1) warm1 false))
        better-c2 (if (= champ 0)
                    better02
                    better12)]
    (pick-idx-3-tournament champ ok2 warm-champ warm2 better-c2)))

(defn apply-pick-3 [q [:ref :schedule/triple] pick :i64] [:ref :schedule/triple]
  ;; queues after assigning one job to pick (−1 = none)
  (let [q0 (record-get q :v0)
        q1 (record-get q :v1)
        q2 (record-get q :v2)
        nq0 (queue-after-assign q0 (if (= pick 0) 1 0))
        nq1 (queue-after-assign q1 (if (= pick 1) 1 0))
        nq2 (queue-after-assign q2 (if (= pick 2) 1 0))]
    (record-new [:ref :schedule/triple] nq0 nq1 nq2)))

(defn assign-step-3 [q [:ref :schedule/triple]
                     ok [:ref :schedule/flags3]
                     warm [:ref :schedule/flags3]
                     better [:ref :schedule/better3]] [:ref :schedule/assign3]
  ;; one job pure assign for 3 nodes → named result record
  (let [p (assign-pick-3 ok warm better)
        code (pick-code-3 p)
        nq (apply-pick-3 q p)]
    (record-new [:ref :schedule/assign3] code
                (record-get nq :v0)
                (record-get nq :v1)
                (record-get nq :v2))))

(defn assign-step-3-code [result [:ref :schedule/assign3]] :i64
  (record-get result :code))

(defn assign-step-3-q0 [result [:ref :schedule/assign3]] :i64
  (record-get result :q0))

(defn assign-step-3-q1 [result [:ref :schedule/assign3]] :i64
  (record-get result :q1))

(defn assign-step-3-q2 [result [:ref :schedule/assign3]] :i64
  (record-get result :q2))

(defn pick-fold-step [champ [:option :i64] ok-i :bool warm-champ :bool warm-i :bool
                      better-c-i :bool] :i64
  ;; Host folds candidates i=0..n-1.
  ;; Product Value ABI v1: optional champ presence (no has-champ sentinel).
  ;; Returns: 0 = no pick yet (no champ and not ok-i)
  ;;          1 = take challenger i as new champ
  ;;          2 = keep existing champ
  (if-some [_ champ]
    (if ok-i
      (if (= (prefer-warm-then-score warm-champ warm-i better-c-i) 0)
        2
        1)
      2)
    (if ok-i 1 0)))

(defn queue-inc-if [queue :i64 picked :i64] :i64
  ;; picked 0/1 — alias queue-after-assign for host fold clarity
  (queue-after-assign queue picked))
