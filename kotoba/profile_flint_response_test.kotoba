;; Candidate source tests; compose after profile_recovery.
(ns murakumo.profile-flint-response-test (:export [test-flint-response]))

(defn test-flint-response [] :bool
  (let [good (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\",\"reasoning_content\":\"private\"}}],\"model\":\"flint\"}")
        unfinished (cp-bytes "{\"choices\":[{\"finish_reason\":\"length\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\"}}],\"model\":\"flint\"}")
        no-answer (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"\",\"reasoning_content\":\"private\"}}],\"model\":\"flint\"}")
        wrong-role (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"user\",\"content\":\"draft\"}}],\"model\":\"flint\"}")
        missing-role (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"content\":\"draft\"}}],\"model\":\"flint\"}")
        two (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"a\"}},{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"b\"}}],\"model\":\"flint\"}")
        duplicate-model (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\"}}],\"model\":\"flint\",\"model\":\"other\"}")
        duplicate-finish (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"finish_reason\":\"length\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\"}}],\"model\":\"flint\"}")
        escaped-key (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\"}}],\"mo\\u0064el\":\"flint\"}")
        tool (cp-bytes "{\"choices\":[{\"finish_reason\":\"tool_calls\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\"}}],\"model\":\"flint\"}")
        tool-hidden (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\",\"tool_calls\":[]}}],\"model\":\"flint\"}")
        legacy-call (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\",\"function_call\":{\"name\":\"x\",\"arguments\":\"{}\"}}}],\"model\":\"flint\"}")
        legacy-null (cp-bytes "{\"choices\":[{\"finish_reason\":\"stop\",\"message\":{\"role\":\"assistant\",\"content\":\"draft\",\"function_call\":null}}],\"model\":\"flint\"}")
        compact (flint-compact "flint" good)]
    (and (= (flint-response-problem "flint" good) "flint/ok")
         (= (flint-response-problem "" good) "flint/model-unpinned")
         (= (flint-response-problem "other" good) "flint/model-mismatch")
         (= (flint-response-problem "flint" (vector-alloc 0)) "flint/response-size")
         (= (flint-response-problem "flint" (vector-alloc 262145)) "flint/response-size")
         (= (flint-response-problem "flint" (cp-bytes "{")) "flint/response-invalid")
         (= (flint-response-problem "flint" unfinished) "flint/incomplete")
         (= (flint-response-problem "flint" no-answer) "flint/incomplete")
         (= (flint-response-problem "flint" wrong-role) "flint/role-refused")
         (= (flint-response-problem "flint" missing-role) "flint/role-refused")
         (= (flint-response-problem "flint" two) "flint/choices-refused")
         (= (flint-response-problem "flint" duplicate-model) "flint/response-invalid")
         (= (flint-response-problem "flint" duplicate-finish) "flint/response-invalid")
         (= (flint-response-problem "flint" escaped-key) "flint/response-invalid")
         (= (flint-response-problem "flint" tool) "flint/incomplete")
         (= (flint-response-problem "flint" tool-hidden) "flint/tool-calls-refused")
         (= (flint-response-problem "flint" legacy-call) "flint/tool-calls-refused")
         (= (flint-response-problem "flint" legacy-null) "flint/tool-calls-refused")
         (= (vector-count (flint-compact "flint" unfinished)) 0)
         (json-valid? compact) (= (pr-answer compact) "draft")
         (= (flint-response-problem "flint" compact) "flint/ok")
         (= (vector-count (flint-compact "flint" compact)) 0)
         (= (cp-str compact 0 "model") "flint")
         (= (cp-str compact 0 "rawResponseDigest") (str "sha256:" (sha256-hex good)))
         (< (string-index-of (cp-text compact) "private") 0))))
