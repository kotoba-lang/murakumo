;; Compose with the native host protocol, tunnel and observer sources.
;; No process or filesystem grant is required by this test.
(ns murakumo.fleet-macos-observer-test (:export [main]))
(defn main [] :i64
  (let [argv (mo-argv "/bin/dfARG_SEP-PkARG_SEP/")
        empty (mo-argv "/bin/dfARG_SEP")
        bad-node (mo-receive "-bad" "100.75.169.8" "/tmp/id" "/tmp/known" "/tmp/work" "/tmp/remote")
        bad-path (mo-receive "benjamin" "100.75.169.8" "/tmp/id" "/tmp/known" "/tmp/work" "/tmp/../remote")]
    (if (and (> (vector-count argv) 1) (= (vector-at argv 0) 3)
             (= (vector-count empty) 0) (= bad-node "") (= bad-path "")
             (mo-proc-ok? [0 0 0]) (not (mo-proc-ok? [0 0 9]))
             (not (mo-proc-ok? [0 1 0])) (not (mo-proc-ok? [1 0 0]))
             (not (mo-proc-ok? [0]))
             (= (mo-snapshot "relative") "")) 0 1)))
