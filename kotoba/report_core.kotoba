(ns report-core
  (:schemas {;; T5.2 native guest record wire
             :report/mesh [:record :report/mesh
                           [[:binary :string] [:launch :string]]]
             :report/pair-str [:record :report/pair-str
                               [[:a :string] [:b :string]]]
             :report/triple-str [:record :report/triple-str
                                 [[:a :string] [:b :string] [:c :string]]]
             :report/pad [:record :report/pad
                          [[:s :string] [:pad :i64]]]
             :report/pad-to [:record :report/pad-to
                             [[:s :string] [:width :i64]]]
             :report/count-file [:record :report/count-file
                                 [[:count :i64] [:peers-file :string]]]
             :report/name-ok [:record :report/name-ok
                              [[:name :string] [:ok :bool]]]
             :report/name-exit [:record :report/name-exit
                                [[:name :string] [:exit-str :string]]]
             :report/ports [:record :report/ports
                            [[:port :i64] [:interval :i64]]]
             :report/nodes-row [:record :report/nodes-row
                                [[:name :string] [:ip :string]
                                 [:online :bool] [:ssh-ok :bool] [:mesh :string]]]
             :report/title [:record :report/title
                            [[:fleet :string] [:ts :string]]]
             :report/cid [:record :report/cid
                          [[:cid :string] [:present :bool]]]
             :report/action-detail [:record :report/action-detail
                                    [[:action :string] [:targets :string]
                                     [:running :string] [:running-empty :bool]
                                     [:reason :string]]]
             :report/app-row [:record :report/app-row
                              [[:app :string] [:cid :string]
                               [:desired :i64] [:running-n :i64] [:action :string]]]
             :report/join [:record :report/join
                           [[:acc :string] [:sep :string] [:next :string]]]
             :report/csv [:record :report/csv
                          [[:acc :string] [:next :string]]]
             :report/status-row [:record :report/status-row
                                 [[:name :string] [:health [:option :i64]]
                                  [:wasm :string] [:links :string]
                                  [:p2p-port :i64]]]})
  (:export [digit-char nat-str i64-str blank? ws? trim
            mesh-status node-prefix unreachable-skipped-line
            provision-result-line mesh-pass1-line mesh-wait-peerid-line
            mesh-pass2-line mesh-forming-line deploy-wait-placement-line
            operator-seed-required-line operator-seed-hex-required-line
            deploy-usage-line reconcile-usage-line
            dashboard-no-persistence-line reconcile-no-persistence-line
            reconcile-converged-line reconcile-dry-run-line
            missing-binary-line deploy-start-line pin-success-line
            snapshot-error-line reconcile-persist-error-line
            online-label ssh-label health-label
            command-error-line
            launch-result-line rollout-line collected-peers-line
            artifact-node-status deploy-command-output alert-line
            dashboard-start-line apply-target-line watch-start-line
            deploy-observed-empty-line deploy-observed-placed-line
            missing-pinned-binaries-line1 missing-pinned-binaries-line2
            nodes-header status-header status-down-suffix
            spaces pad-right pad-to
            field-10 field-16 field-8 field-9 field-12 field-6
            nodes-row status-down-row status-row
            command-help
            reconcile-title reconcile-col-header
            cid-display action-detail
            nat-len field-i64-7
            reconcile-app-row reconcile-app-line
            reach-line drift-line
            report-csv-sep report-csv-spaced-sep mesh-status-sep
            cid-display-max-len
            join-append csv-append csv-spaced-append]))

;; W6 pure-planner oracle — murakumo.report string core.
;; Column-padded tables: pad-to(width) + nodes-row / status-row pure (ASCII).
;; reconcile-lines: pure title/col-header/app-row/detail/reach/drift;
;; host still mapcats apps; CSV join fold steps dual-sourced.
;; T5.2: multi-scalar pure inputs take single guest records
;; (status-row/health-label option residual stays positional).
;; Parity: test/murakumo/report_kotoba_parity_test.clj

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn ws? [c :string] :bool
  (if (string=? c " ")
    true
    (if (string=? c "\n")
      true
      (if (string=? c "\t")
        true
        (string=? c "\r")))))

(defn blank? [s :string] :bool
  (let [n (string-byte-length s)]
    (if (= n 0)
      true
      (if (ws? (string-substring s 0 1))
        (blank? (string-substring s 1 n))
        false))))

(defn trim [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (ws? (string-substring s 0 1))
        (trim (string-substring s 1 n))
        (if (ws? (string-substring s (- n 1) n))
          (trim (string-substring s 0 (- n 1)))
          s)))))

(defn mesh-status-sep [] :string "/")

(defn mesh-status [m [:ref :report/mesh]] :string
  ;; T5.2 native: binary+launch.
  (string-concat (record-get m :binary)
                 (string-concat (mesh-status-sep) (record-get m :launch))))

(defn node-prefix [name :string] :string
  (string-concat "[" (string-concat name "] ")))

(defn unreachable-skipped-line [] :string "unreachable — skipped")

(defn provision-result-line [peered :bool] :string
  ;; Profile 5: peered is a real :bool (not 0/1 i64).
  (if peered
    "provisioned + loaded (peered)"
    "provisioned + loaded"))

(defn mesh-pass1-line [] :string
  "── pass 1: provision with fixed P2P port + stable PeerId ──")

(defn mesh-wait-peerid-line [] :string
  "── waiting for nodes to advertise their PeerId ──")

(defn mesh-pass2-line [] :string
  "── pass 2: re-provision with KOTOBA_BOOTSTRAP_PEERS = the others ──")

(defn mesh-forming-line [] :string
  "── lattice forming; check `murakumo status` (PEERS should climb) ──")

(defn deploy-wait-placement-line [] :string
  "  waiting for the lattice to place + run it…")

(defn operator-seed-required-line [] :string
  "set MURAKUMO_OPERATOR_SEED first")

(defn operator-seed-hex-required-line [] :string
  "set MURAKUMO_OPERATOR_SEED (32-byte hex) first")

(defn deploy-usage-line [] :string
  "usage: deploy <app.edn> [publish-node]")

(defn reconcile-usage-line [] :string
  "usage: reconcile <murakumo.app.edn> [--dry-run|--apply|--watch[=secs]]")

(defn dashboard-no-persistence-line [] :string
  "(no MURAKUMO_OPERATOR_SEED → dashboard live-only, no Datom persistence)")

(defn reconcile-no-persistence-line [] :string
  "(no MURAKUMO_OPERATOR_SEED → watch without Datom persistence)")

(defn reconcile-converged-line [] :string "  ✓ converged")

(defn reconcile-dry-run-line [] :string
  "\n(dry-run; re-run with --apply to converge, or --watch to keep it converged)")

(defn missing-binary-line [path :string] :string
  (string-concat "missing binary: " path))

(defn deploy-start-line [p [:ref :report/pair-str]] :string
  ;; T5.2: a=manifest b=cid
  (string-concat
   "deploy "
   (string-concat (record-get p :a)
                  (string-concat "  (component " (string-concat (record-get p :b) ")")))))

(defn pin-success-line [p [:ref :report/triple-str]] :string
  ;; T5.2: a=src b=sha c=version
  (string-concat
   "pinned kotoba + kotoba-server → bin/  (src "
   (string-concat
    (record-get p :a)
    (string-concat
     " @ "
     (string-concat (record-get p :b)
                    (string-concat ", " (string-concat (record-get p :c) ")")))))))

(defn snapshot-error-line [message :string] :string
  (string-concat "snapshot error: " message))

(defn reconcile-persist-error-line [message :string] :string
  (string-concat "reconcile persist error: " message))

(defn online-label [online :bool] :string
  (if online "yes" "no"))

(defn ssh-label [ok :bool] :string
  (if ok "ok" "no"))

(defn health-label [health? [:option :i64]] :string
  ;; Product Value ABI v1: optional health presence (no has-health sentinel).
  (if-some [_ health?] "ok" "no-resp"))

(defn launch-result-line [p [:ref :report/name-exit]] :string
  ;; T5.2 native.
  (string-concat (record-get p :name)
                 (string-concat " " (record-get p :exit-str))))

(defn rollout-line [p [:ref :report/triple-str]] :string
  ;; T5.2: a=version b=sha c=features
  (string-concat
   "rolling out kotoba "
   (string-concat
    (record-get p :a)
    (string-concat
     " (sha "
     (string-concat (record-get p :b)
                    (string-concat ", " (string-concat (record-get p :c) ")")))))))

(defn collected-peers-line [p [:ref :report/count-file]] :string
  ;; T5.2 native.
  (string-concat
   "── collected "
   (string-concat
    (i64-str (record-get p :count))
    (string-concat " PeerIds → "
                   (string-concat (record-get p :peers-file) " ──")))))

(defn artifact-node-status [p [:ref :report/name-ok]] :string
  ;; Profile 5: ok is :bool. T5.2 native.
  (string-concat
   " "
   (string-concat (record-get p :name)
                  (if (record-get p :ok) "✓" "✗"))))

(defn deploy-command-output [p [:ref :report/pair-str]] :string
  ;; T5.2: a=out b=err
  (string-concat (trim (record-get p :a)) (record-get p :b)))

(defn alert-line [p [:ref :report/triple-str]] :string
  ;; T5.2: a=level b=node c=msg
  (string-concat
   "[alert/"
   (string-concat
    (record-get p :a)
    (string-concat
     "] "
     (string-concat (record-get p :b)
                    (string-concat " — " (record-get p :c)))))))

(defn dashboard-start-line [p [:ref :report/ports]] :string
  ;; T5.2 native.
  (string-concat
   "murakumo dashboard → http://localhost:"
   (string-concat
    (i64-str (record-get p :port))
    (string-concat
     "  (snapshot every "
     (string-concat (i64-str (record-get p :interval)) "s → Datom log)")))))

(defn apply-target-line [p [:ref :report/pair-str]] :string
  ;; T5.2: a=app b=target
  (string-concat
   "  applying "
   (string-concat
    (record-get p :a)
    (string-concat
     " → deploy to "
     (string-concat
      (record-get p :b)
      " (no cross-node auction; murakumo picks the target directly)")))))

(defn watch-start-line [seconds :i64] :string
  (string-concat
   "── reconcile --watch (every "
   (string-concat (i64-str seconds) "s) ; Ctrl-C to stop ──")))

(defn deploy-observed-empty-line [] :string
  "  ⚠ not yet observed running on any node (check `murakumo status` / node logs)")

(defn deploy-observed-placed-line [p [:ref :report/pair-str]] :string
  ;; T5.2: a=where b=publish-name
  (string-concat
   "  ✓ placed + running on: "
   (string-concat
    (record-get p :a)
    (string-concat "  (deployed from "
                   (string-concat (record-get p :b) ")")))))

(defn missing-pinned-binaries-line1 [p [:ref :report/pair-str]] :string
  ;; T5.2: a=version b=sha
  (string-concat
   "fleet pins kotoba "
   (string-concat
    (record-get p :a)
    (string-concat
     " (sha "
     (string-concat (record-get p :b) ") but ./bin has no binaries.")))))

(defn missing-pinned-binaries-line2 [] :string
  "Build that version and `murakumo pin <its release dir>` before provisioning.")

(defn command-error-line [p [:ref :report/pair-str]] :string
  ;; T5.2: a=command b=error
  (let [command (record-get p :a)
        error (record-get p :b)]
    (if (if (string=? command "provision")
          (if (string=? error "missing-operator-seed-hex") 1 0)
          0)
      (operator-seed-hex-required-line)
      (if (if (string=? command "mesh")
            (if (string=? error "missing-operator-seed") 1 0)
            0)
        (operator-seed-required-line)
        (if (if (string=? command "deploy")
              (if (string=? error "missing-manifest") 1 0)
              0)
          (deploy-usage-line)
          (if (if (string=? command "deploy")
                (if (string=? error "missing-operator-seed") 1 0)
                0)
            (operator-seed-required-line)
            (if (if (string=? command "reconcile")
                  (if (string=? error "missing-manifest") 1 0)
                  0)
              (reconcile-usage-line)
              (string-concat
               "unknown "
               (string-concat command (string-concat " error: " error))))))))))

(defn spaces [n :i64] :string
  (if (< n 1)
    ""
    (string-concat " " (spaces (- n 1)))))

(defn pad-right [p [:ref :report/pad]] :string
  ;; T5.2 native.
  (string-concat (record-get p :s) (spaces (record-get p :pad))))

(defn pad-to [p [:ref :report/pad-to]] :string
  ;; ASCII left-align to width. T5.2 native.
  (let [s (record-get p :s)
        width (record-get p :width)
        n (string-byte-length s)
        pad (- width n)]
    (pad-right (record-new [:ref :report/pad] s (if (< pad 0) 0 pad)))))

(defn field-10 [p [:ref :report/pad]] :string
  (pad-right p))

(defn field-16 [p [:ref :report/pad]] :string
  (pad-right p))

(defn field-8 [p [:ref :report/pad]] :string
  (pad-right p))

(defn field-9 [p [:ref :report/pad]] :string
  (pad-right p))

(defn field-12 [p [:ref :report/pad]] :string
  (pad-right p))

(defn field-6 [p [:ref :report/pad]] :string
  (pad-right p))

(defn nodes-header [] :string
  "NODE       TAILSCALE-IP     ONLINE   SSH       MESH")

(defn status-header [] :string
  "NODE       HEALTH   WASM-EXEC    LINKS  P2P-PORT")

(defn status-down-suffix [] :string
  "down    ")

(defn nodes-row [r [:ref :report/nodes-row]] :string
  ;; T5.2 native.
  (let [name (record-get r :name)
        ip (record-get r :ip)
        online (record-get r :online)
        ssh-ok (record-get r :ssh-ok)
        mesh (record-get r :mesh)]
    (string-concat
     (pad-to (record-new [:ref :report/pad-to] name 10))
     (string-concat
      " "
      (string-concat
       (pad-to (record-new [:ref :report/pad-to] ip 16))
       (string-concat
        " "
        (string-concat
         (pad-to (record-new [:ref :report/pad-to] (online-label online) 8))
         (string-concat
          " "
          (string-concat
           (pad-to (record-new [:ref :report/pad-to] (ssh-label ssh-ok) 9))
           (string-concat " " mesh))))))))))

(defn status-down-row [name :string] :string
  (string-concat (pad-to (record-new [:ref :report/pad-to] name 10))
                 (string-concat " " (status-down-suffix))))

(defn status-row [r [:ref :report/status-row]] :string
  ;; T5.2 native: option health in-record.
  (let [name (record-get r :name)
        health? (record-get r :health)
        wasm-exec (record-get r :wasm)
        links-str (record-get r :links)
        p2p-port (record-get r :p2p-port)
        f-name (pad-to (record-new [:ref :report/pad-to] name 10))
        f-health (pad-to (record-new [:ref :report/pad-to]
                                     (health-label health?) 8))
        f-wasm (pad-to (record-new [:ref :report/pad-to] wasm-exec 12))
        f-links (pad-to (record-new [:ref :report/pad-to] links-str 6))]
    (string-concat
     f-name
     (string-concat
      " "
      (string-concat
       f-health
       (string-concat
        " "
        (string-concat
         f-wasm
         (string-concat
          " "
          (string-concat f-links (string-concat " " (i64-str p2p-port)))))))))))

(defn command-help [] :string
  "murakumo — kotoba WASM mesh control plane\n\ncommands:\n  nodes                       fleet reachability + mesh presence\n  pin       [src-dir]         copy a consistent kotoba cli+server into ./bin (own it)\n  provision [node|all]        rsync binaries + install resident LaunchDaemon\n  mesh      [node|all]        form ONE gossipsub lattice (2-pass: peer-id + bootstrap)\n  up/down   [node|all]        start/stop the resident mesh node\n  status    [node|all]        fold /health across the fleet (PEERS = live links)\n  deploy    <app.edn> [node]  compile clj→WASM + distribute + publish to the lattice\n  reconcile <murakumo.app.edn> [--dry-run|--apply|--watch[=secs]]  declarative desired-state (wadm)\n  cloud     [plan|records|routes|dial|connect <node>|relay <name>|bootstrap]    plan murakumo.cloud identity overlay\n  dash      [port] [interval]  web dashboard + persist heartbeat/placement to the Datom log\n  fleet     <datom-log.edn>    fold a kotoba-fleet Datom log into one coordination view\n  infer     probe|plan <model>|provision|up|down|ps|serve|generate  distributed inference (exo-style shard plan)\n  model     plan|setup|status <model> [node|all] [cache-dir]  Hugging Face model provisioning\n  revive    [node|all]        wake offline fleet Macs via a live LAN peer\n\nenv: MURAKUMO_OPERATOR_SEED (32-byte hex), MURAKUMO_KOTOBA_DIR")

(defn reconcile-title [p [:ref :report/title]] :string
  ;; T5.2 native.
  (string-concat
   "reconcile "
   (string-concat (record-get p :fleet)
                  (string-concat "  @ " (record-get p :ts)))))

(defn reconcile-col-header [] :string
  "  APP            CID        DESIRED RUNNING ACTION    DETAIL")

(defn cid-display [p [:ref :report/cid]] :string
  ;; T5.2 native.
  (if (record-get p :present)
    (record-get p :cid)
    "—"))

(defn action-detail [p [:ref :report/action-detail]] :string
  ;; Profile 5: running-empty is :bool. T5.2 native.
  (let [action (record-get p :action)
        targets-csv (record-get p :targets)
        running-csv (record-get p :running)
        running-empty (record-get p :running-empty)
        reason (record-get p :reason)]
    (if (string=? action "place")
      (string-concat "→ " targets-csv)
      (if (string=? action "satisfied")
        (if running-empty
          ""
          (string-concat "on " running-csv))
        reason))))

(defn nat-len [n :i64] :i64
  (if (< n 0)
    (+ 1 (nat-len (- 0 n)))
    (if (< n 10)
      1
      (+ 1 (nat-len (quot n 10))))))

(defn field-i64-7 [n :i64] :string
  (let [s (i64-str n)
        pad (- 7 (nat-len n))]
    (pad-right (record-new [:ref :report/pad] s (if (< pad 0) 0 pad)))))

(defn reconcile-app-row [r [:ref :report/app-row]] :string
  ;; T5.2 native.
  (string-concat
   "  "
   (string-concat
    (record-get r :app)
    (string-concat
     " "
     (string-concat
      (record-get r :cid)
      (string-concat
       " "
       (string-concat
        (field-i64-7 (record-get r :desired))
        (string-concat
         " "
         (string-concat
          (field-i64-7 (record-get r :running-n))
          (string-concat " " (record-get r :action)))))))))))

(defn reconcile-app-line [p [:ref :report/pair-str]] :string
  ;; T5.2: a=front b=detail
  (string-concat (record-get p :a) (string-concat " " (record-get p :b))))

(defn reach-line [p [:ref :report/pair-str]] :string
  ;; T5.2: a=reach-csv b=eligible-csv
  (string-concat
   "                            reach: "
   (string-concat
    (record-get p :a)
    (string-concat " → eligible(by transport)=" (record-get p :b)))))

(defn drift-line [misplaced-csv :string] :string
  (string-concat
   "                            drift: running on non-eligible node(s): "
   misplaced-csv))

(defn report-csv-sep [] :string
  ",")

(defn report-csv-spaced-sep [] :string
  ", ")

(defn cid-display-max-len [] :i64
  16)

(defn join-append [j [:ref :report/join]] :string
  ;; T5.2 native.
  (let [acc (record-get j :acc)
        sep (record-get j :sep)
        next (record-get j :next)]
    (if (string=? acc "")
      next
      (string-concat acc (string-concat sep next)))))

(defn csv-append [c [:ref :report/csv]] :string
  ;; T5.2 native.
  (join-append (record-new [:ref :report/join]
                           (record-get c :acc)
                           (report-csv-sep)
                           (record-get c :next))))

(defn csv-spaced-append [c [:ref :report/csv]] :string
  ;; T5.2 native.
  (join-append (record-new [:ref :report/join]
                           (record-get c :acc)
                           (report-csv-spaced-sep)
                           (record-get c :next))))
