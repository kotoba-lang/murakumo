(ns infer-rebalance-core
  (:export [shard-ceiling-gb os-kv-headroom-gb usable-gb pool-for-class
            lane-base largest-remainder-3
            seats-text seats-media seats-postproc
            pool-demand-pack seats-from-pool-pack
            classify-run-flags
            demand-base demand-empty
            demand-text demand-image demand-video demand-audio demand-postproc
            demand-inc demand-to-pool-pack
            workers-count seats-for-online seats-equal
            pipeline-effective-gb node-online?
            move-needed assigned-from-seats
            rebalance-reason-code rebalance-reason-name
            digit-char nat-str i64-str
            pool-code pool-name seat-order-pack order-nth
            take-end take-count pipeline-note rebalance-reason-detail]))

;; W6 pure-planner oracle — murakumo.infer.rebalance capacity + 3-pool
;; largest-remainder seat apportionment (map-fold product vertical).
;; rebalance moves / capacity vector filters stay cljc.
;; pool-demand-pack: class counts → packed pool weights (map-fold).
;; seats-from-pool-pack: total + packed weights + floor → seat pack (compose LR).
;; classify-run-flags: one-run class tag for demand-from-runs building block.
;; demand-*: class-count pack (base 4096, 5 lanes) + demand-inc reduce step
;;   + demand-to-pool-pack → pool-demand-pack (demand-from-runs fold core).
;; seat-order-pack / take-end: pure assignment order for node-id slice (vectors stay host).

;;
;; largest-remainder-3: integer form of cljc `largest-remainder` for the
;; fixed pools text/media/postproc (weights wt,wm,wp). Floor applied only
;; to active (weight>0) pools; inactive stay 0. Tie-break for remainder
;; seats uses fixed order text < media < postproc (array-map insertion).
;; Packing via base-65536 digits (no bit-shift; guest arithmetic subset):
;;   packed = text + media*B + postproc*B*B, B=65536
;; Parity: test/murakumo/infer_rebalance_kotoba_parity_test.clj

(defn shard-ceiling-gb [] :i64 10)

(defn os-kv-headroom-gb [] :i64 6)

(defn usable-gb [ram-gb :i64] :i64
  (let [raw (- ram-gb 6)
        floored (if (< raw 0) 0 raw)
        ceil (shard-ceiling-gb)]
    (if (< floored ceil) floored ceil)))

(defn pool-for-class [cls :string] :string
  (if (string=? cls "text")
    "text-pool"
    (if (string=? cls "postproc")
      "postproc-pool"
      (if (if (string=? cls "image") 1
            (if (string=? cls "video") 1
              (if (string=? cls "audio") 1 0)))
        "media-pool"
        "text-pool"))))

(defn lane-base [] :i64 65536)

(defn rem64 [a :i64 b :i64] :i64
  (- a (* (quot a b) b)))

(defn seats-text [packed :i64] :i64
  (rem64 packed (lane-base)))

(defn seats-media [packed :i64] :i64
  (rem64 (quot packed (lane-base)) (lane-base)))

(defn seats-postproc [packed :i64] :i64
  (quot packed (* (lane-base) (lane-base))))

(defn pack3 [t :i64 m :i64 p :i64] :i64
  (let [b (lane-base)]
    (+ t (+ (* m b) (* p (* b b))))))

(defn weight-pos? [w :i64] :i64
  (if (< 0 w) 1 0))

(defn count-active [wt :i64 wm :i64 wp :i64] :i64
  (+ (weight-pos? wt) (+ (weight-pos? wm) (weight-pos? wp))))

(defn min2 [a :i64 b :i64] :i64
  (if (< a b) a b))

(defn max2 [a :i64 b :i64] :i64
  (if (< a b) b a))

(defn better-bump? [rem-a :i64 idx-a :i64 rem-b :i64 idx-b :i64] :i64
  (if (< rem-b rem-a)
    1
    (if (< rem-a rem-b)
      0
      (if (< idx-a idx-b) 1 0))))

;; Pick best among three optional candidates (ok=1 means eligible).
;; Returns 0|1|2 or -1. Arity 5: ok-t, ok-m, ok-p, rem-packed, unused.
;; rem-packed uses same base-65536 packing as seats.
(defn pick-bump-3 [ok-t :i64 ok-m :i64 ok-p :i64 rem-packed :i64 _pad :i64] :i64
  (let [rt (seats-text rem-packed)
        rm (seats-media rem-packed)
        rp (seats-postproc rem-packed)]
    (if (= ok-t 0)
      (if (= ok-m 0)
        (if (= ok-p 0) -1 2)
        (if (= ok-p 0)
          1
          (if (= (better-bump? rm 1 rp 2) 1) 1 2)))
      (if (= ok-m 0)
        (if (= ok-p 0)
          0
          (if (= (better-bump? rt 0 rp 2) 1) 0 2))
        (let [win-tm (if (= (better-bump? rt 0 rm 1) 1) 0 1)
              r-win (if (= win-tm 0) rt rm)
              i-win win-tm]
          (if (= ok-p 0)
            win-tm
            (if (= (better-bump? r-win i-win rp 2) 1) win-tm 2)))))))

(defn ok-for [active :i64 bumped :i64] :i64
  ;; active and bumped are 0|1 flags
  (if (if (= active 1) (if (= bumped 0) 1 0) 0) 1 0))

(defn largest-remainder-3 [total :i64 wt :i64 wm :i64 wp :i64 floor :i64] :i64
  (let [at (weight-pos? wt)
        am (weight-pos? wm)
        ap (weight-pos? wp)
        n-active (count-active wt wm wp)]
    (if (if (= total 0) 1 (if (= n-active 0) 1 0))
      (pack3 0 0 0)
      (let [eff-floor (min2 floor (quot total n-active))
            bt (if (= at 1) eff-floor 0)
            bm (if (= am 1) eff-floor 0)
            bp (if (= ap 1) eff-floor 0)
            left0 (- total (+ bt (+ bm bp)))
            left (max2 0 left0)
            sumw (+ (if (= at 1) wt 0)
                    (+ (if (= am 1) wm 0)
                       (if (= ap 1) wp 0)))
            pt (if (= at 1) (* left wt) 0)
            pm (if (= am 1) (* left wm) 0)
            pp (if (= ap 1) (* left wp) 0)
            ft (if (= at 1) (quot pt sumw) 0)
            fm (if (= am 1) (quot pm sumw) 0)
            fp (if (= ap 1) (quot pp sumw) 0)
            rt (if (= at 1) (rem64 pt sumw) 0)
            rm (if (= am 1) (rem64 pm sumw) 0)
            rp (if (= ap 1) (rem64 pp sumw) 0)
            assigned (+ ft (+ fm fp))
            extra (- left assigned)
            rem-packed (pack3 rt rm rp)
            ;; bump 0
            b0 (if (< 0 extra)
                 (pick-bump-3 (ok-for at 0) (ok-for am 0) (ok-for ap 0) rem-packed 0)
                 -1)
            bt0 (if (= b0 0) 1 0)
            bm0 (if (= b0 1) 1 0)
            bp0 (if (= b0 2) 1 0)
            b1 (if (< 1 extra)
                 (pick-bump-3 (ok-for at bt0) (ok-for am bm0) (ok-for ap bp0) rem-packed 0)
                 -1)
            bt1 (if (= b1 0) 1 bt0)
            bm1 (if (= b1 1) 1 bm0)
            bp1 (if (= b1 2) 1 bp0)
            b2 (if (< 2 extra)
                 (pick-bump-3 (ok-for at bt1) (ok-for am bm1) (ok-for ap bp1) rem-packed 0)
                 -1)
            bump-t (if (if (= b0 0) 1 (if (= b1 0) 1 (if (= b2 0) 1 0))) 1 0)
            bump-m (if (if (= b0 1) 1 (if (= b1 1) 1 (if (= b2 1) 1 0))) 1 0)
            bump-p (if (if (= b0 2) 1 (if (= b1 2) 1 (if (= b2 2) 1 0))) 1 0)
            st (+ bt (+ ft bump-t))
            sm (+ bm (+ fm bump-m))
            sp (+ bp (+ fp bump-p))]
        (pack3 st sm sp)))))

(defn pool-demand-pack [text :i64 image :i64 video :i64 audio :i64 postproc :i64] :i64
  ;; cljc pool-demand: text→text-pool; image+video+audio→media-pool; postproc→postproc-pool
  (let [wt text
        wm (+ image (+ video audio))
        wp postproc]
    (pack3 wt wm wp)))

(defn seats-from-pool-pack [total :i64 pool-pack :i64 floor :i64] :i64
  ;; compose largest-remainder-3 over packed pool-demand weights
  (largest-remainder-3 total
                       (seats-text pool-pack)
                       (seats-media pool-pack)
                       (seats-postproc pool-pack)
                       floor))

(defn classify-run-flags [has-images :i64 has-video :i64 has-audio :i64
                          is-swarm :i64 has-tokens :i64] :i64
  ;; mirrors demand-from-runs cond order; returns class code:
  ;; 0 none, 1 text, 2 image, 3 video, 4 audio, 5 postproc
  (if (= has-images 1)
    2
    (if (= has-video 1)
      3
      (if (= has-audio 1)
        4
        (if (= is-swarm 1)
          5
          (if (= has-tokens 1)
            1
            0))))))

;; ── demand-from-runs class pack (5 lanes @ base 4096) ────────────────
;; pack = text + image*B + video*B^2 + audio*B^3 + postproc*B^4

(defn demand-base [] :i64 4096)

(defn demand-empty [] :i64 0)

(defn demand-text [pack :i64] :i64
  (rem64 pack (demand-base)))

(defn demand-image [pack :i64] :i64
  (let [b (demand-base)]
    (rem64 (quot pack b) b)))

(defn demand-video [pack :i64] :i64
  (let [b (demand-base)
        b2 (* b b)]
    (rem64 (quot pack b2) b)))

(defn demand-audio [pack :i64] :i64
  (let [b (demand-base)
        b3 (* b (* b b))]
    (rem64 (quot pack b3) b)))

(defn demand-postproc [pack :i64] :i64
  (let [b (demand-base)
        b4 (* (* b b) (* b b))]
    (quot pack b4)))

(defn demand-pack5 [t :i64 i :i64 v :i64 a :i64 p :i64] :i64
  (let [b (demand-base)
        b2 (* b b)
        b3 (* b b2)
        b4 (* b b3)]
    (+ t (+ (* i b) (+ (* v b2) (+ (* a b3) (* p b4)))))))

(defn demand-inc [pack :i64 class-code :i64] :i64
  ;; one reduce step of demand-from-runs given classify-run-flags code
  (let [t (demand-text pack)
        i (demand-image pack)
        v (demand-video pack)
        a (demand-audio pack)
        p (demand-postproc pack)]
    (if (= class-code 1)
      (demand-pack5 (+ t 1) i v a p)
      (if (= class-code 2)
        (demand-pack5 t (+ i 1) v a p)
        (if (= class-code 3)
          (demand-pack5 t i (+ v 1) a p)
          (if (= class-code 4)
            (demand-pack5 t i v (+ a 1) p)
            (if (= class-code 5)
              (demand-pack5 t i v a (+ p 1))
              pack)))))))

(defn demand-to-pool-pack [pack :i64] :i64
  ;; cljc pool-demand after demand-from-runs
  (pool-demand-pack (demand-text pack)
                    (demand-image pack)
                    (demand-video pack)
                    (demand-audio pack)
                    (demand-postproc pack)))

;; ── placement pure layer (target-allocation / rebalance hysteresis) ──

(defn workers-count [online :i64] :i64
  ;; reserve one head/relay when any node is online
  (if (< online 1) 0 (- online 1)))

(defn seats-for-online [online :i64 pool-pack :i64 floor :i64] :i64
  ;; pure core of target-allocation seat step (node id assignment stays cljc)
  (seats-from-pool-pack (workers-count online) pool-pack floor))

(defn seats-equal [a :i64 b :i64] :i64
  ;; hysteresis: seat allocation unchanged?
  (if (= a b) 1 0))

(defn pipeline-effective-gb [usable-gb :i64 text-seats :i64] :i64
  ;; cljc: (* usable text-n) for text pool pipeline
  (* usable-gb text-seats))

(defn node-online? [status :string] :i64
  ;; capacity filter: status "up" only
  (if (string=? status "up") 1 0))

(defn move-needed [from-pool :i64 to-pool :i64] :i64
  ;; pool codes 0=text 1=media 2=postproc; one node placement diff
  (if (= from-pool to-pool) 0 1))

(defn assigned-from-seats [seat-pack :i64] :i64
  ;; total workers assigned across three pools
  (+ (seats-text seat-pack)
     (+ (seats-media seat-pack) (seats-postproc seat-pack))))

(defn rebalance-reason-code [assigned-count :i64 move-count :i64] :i64
  ;; 0 stable, 1 initial placement, 2 demand-shift
  ;; (cljc checks empty current assignment; empty? of missing nodes-of is always true
  ;;  in current source — intended semantics: no assigned nodes ⇒ initial)
  (if (= assigned-count 0)
    1
    (if (< 0 move-count) 2 0)))

(defn rebalance-reason-name [code :i64] :string
  (if (= code 1)
    "initial placement"
    (if (= code 2)
      "demand-shift"
      "stable")))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn pool-code [name :string] :i64
  ;; 0 text-pool, 1 media-pool, 2 postproc-pool, -1 unknown
  (if (string=? name "text-pool")
    0
    (if (string=? name "media-pool")
      1
      (if (string=? name "postproc-pool") 2 -1))))

(defn pool-name [code :i64] :string
  (if (= code 0)
    "text-pool"
    (if (= code 1)
      "media-pool"
      (if (= code 2) "postproc-pool" "unknown"))))

(defn seat-of [code :i64 st :i64 sm :i64 sp :i64] :i64
  (if (= code 0) st (if (= code 1) sm sp)))

(defn before-pool? [ia :i64 ib :i64 st :i64 sm :i64 sp :i64] :i64
  ;; sort-by (comp - val): higher seats first; ties → lower index first (stable text<media<post)
  (let [sa (seat-of ia st sm sp)
        sb (seat-of ib st sm sp)]
    (if (< sb sa)
      1
      (if (< sa sb)
        0
        (if (< ia ib) 1 0)))))

(defn seat-order-pack [st :i64 sm :i64 sp :i64] :i64
  ;; pack permutation of pool codes 0,1,2 as a0 + a1*4 + a2*16 (desc seats)
  ;; bubble-sort three indices with before-pool?
  (let [p0 (if (= (before-pool? 0 1 st sm sp) 1) 0 1)
        p1 (if (= (before-pool? 0 1 st sm sp) 1) 1 0)
        ;; insert 2 after comparing with p1 then p0
        q1 (if (= (before-pool? p1 2 st sm sp) 1) p1 2)
        q2 (if (= (before-pool? p1 2 st sm sp) 1) 2 p1)
        r0 (if (= (before-pool? p0 q1 st sm sp) 1) p0 q1)
        r1 (if (= (before-pool? p0 q1 st sm sp) 1) q1 p0)]
    (+ r0 (+ (* r1 4) (* q2 16)))))

(defn order-nth [order-pack :i64 n :i64] :i64
  (if (= n 0)
    (rem64 order-pack 4)
    (if (= n 1)
      (rem64 (quot order-pack 4) 4)
      (quot order-pack 16))))

(defn take-end [start :i64 k :i64 remaining :i64] :i64
  ;; exclusive end index for (take k rem) from start within [0, remaining)
  (min2 remaining (+ start k)))

(defn take-count [start :i64 end :i64] :i64
  (max2 0 (- end start)))

(defn pipeline-note [text-n :i64 usable :i64] :string
  ;; cljc target-allocation pipeline :note
  (string-concat
   "text pool sharded as a "
   (string-concat
    (i64-str text-n)
    (string-concat
     "-way pipeline (~"
     (string-concat
      (i64-str (* usable text-n))
      (string-concat
       "GB effective, ceiling "
       (string-concat (i64-str (shard-ceiling-gb)) "GB/node)")))))))

(defn rebalance-reason-detail [code :i64 move-count :i64] :string
  ;; cljc: (str (count moves) " node(s) re-placed by demand shift")
  (if (= code 2)
    (string-concat (i64-str move-count) " node(s) re-placed by demand shift")
    (rebalance-reason-name code)))

