(ns infer-rebalance-core
  (:schemas {;; T5.3 residual: remaining pack families become records.
             ;; T5.2 native guest record: seats inputs are one record (not 5 scalars).
             :rebalance/seats-in [:record :rebalance/seats-in
                                  [[:total :i64] [:text-w :i64] [:media-w :i64]
                                   [:postproc-w :i64] [:floor :i64]]]
             :rebalance/lanes [:record :rebalance/lanes
                               [[:text :i64] [:media :i64] [:postproc :i64]]]
             :rebalance/demand [:record :rebalance/demand
                                [[:text :i64] [:image :i64] [:video :i64]
                                 [:audio :i64] [:postproc :i64]]]
             :rebalance/order [:record :rebalance/order
                               [[:i0 :i64] [:i1 :i64] [:i2 :i64]]]
             ;; T5.2 option-string-in-record: one-run class flags
             :rebalance/run-flags [:record :rebalance/run-flags
                                   [[:images [:option :string]]
                                    [:video [:option :string]]
                                    [:audio [:option :string]]
                                    [:swarm [:option :string]]
                                    [:tokens [:option :string]]]]
             ;; T5.2 residual multi-arg pure → single guest records
             :rebalance/pair [:record :rebalance/pair [[:a :i64] [:b :i64]]]
             :rebalance/triple [:record :rebalance/triple
                                [[:a :i64] [:b :i64] [:c :i64]]]
             :rebalance/bump-cmp [:record :rebalance/bump-cmp
                                  [[:rem-a :i64] [:idx-a :i64]
                                   [:rem-b :i64] [:idx-b :i64]]]
             :rebalance/ok-for [:record :rebalance/ok-for
                                [[:active :bool] [:bumped :bool]]]
             :rebalance/bump3-in [:record :rebalance/bump3-in
                                  [[:ok-t :bool] [:ok-m :bool] [:ok-p :bool]
                                   [:rt :i64] [:rm :i64] [:rp :i64]]]
             ;; T5.2 residual: seat-order tournament
             :rebalance/seat-of [:record :rebalance/seat-of
                                 [[:code :i64] [:st :i64] [:sm :i64] [:sp :i64]]]
             :rebalance/before-pool [:record :rebalance/before-pool
                                     [[:ia :i64] [:ib :i64]
                                      [:st :i64] [:sm :i64] [:sp :i64]]]
             :rebalance/order-nth [:record :rebalance/order-nth
                                   [[:i0 :i64] [:i1 :i64] [:i2 :i64] [:n :i64]]]})
  (:export [shard-ceiling-gb os-kv-headroom-gb usable-gb pool-for-class
            seats-of-text seats-of-media seats-of-postproc seats-total
            pool-demand-record pool-weight-text pool-weight-media pool-weight-postproc
            pool-seats-of-text pool-seats-of-media pool-seats-of-postproc
            classify-run-flags
            demand-empty demand-text demand-image demand-video demand-audio demand-postproc
            demand-inc demand-to-pool-record
            workers-count seats-equal
            seats-for-online-text seats-for-online-media seats-for-online-postproc
            pipeline-effective-gb node-online?
            move-needed
            rebalance-reason-code rebalance-reason-name
            digit-char nat-str i64-str
            pool-code pool-name seat-order-record order-nth
            take-end take-count pipeline-note rebalance-reason-detail]))

;; Product Value ABI v1 pure oracle — murakumo.infer.rebalance capacity + 3-pool.
;; classify-run-flags uses [:option :string] unit/kind tokens (no has-*).
;; largest-remainder seat apportionment (map-fold product vertical).
;; rebalance moves / capacity vector filters stay cljc.
;; pool-demand-record: class counts → [:ref :rebalance/lanes] weights.
;; pool-seats-of-*: total + pool weights record + floor → one seat lane.
;; classify-run-flags: one-run class tag for demand-from-runs building block.
;; demand-*: [:ref :rebalance/demand] class counts + demand-inc reduce step
;;   + demand-to-pool-record → pool weights (demand-from-runs fold core).
;; seat-order-record / take-end: pure assignment order for node-id slice.
;; T5.3 complete for this module: no base-N packing remains.

;;
;; seats-record: integer form of cljc `largest-remainder` for the
;; fixed pools text/media/postproc (weights wt,wm,wp). Floor applied only
;; to active (weight>0) pools; inactive stay 0. Tie-break for remainder
;; seats uses fixed order text < media < postproc (array-map insertion).
;; T5.3: the result is a `[:record :rebalance/lanes …]`, not a base-65536 pack.
;; Parity: test/murakumo/infer_rebalance_kotoba_parity_test.clj

(defn shard-ceiling-gb [] :i64 10)

(defn os-kv-headroom-gb [] :i64 6)

(defn usable-gb [ram-gb :i64] :i64
  (let [raw (- ram-gb 6)
        floored (if (< raw 0) 0 raw)
        ceil (shard-ceiling-gb)]
    (if (< floored ceil) floored ceil)))

(defn pool-for-class [cls :string] :string
  (if (string=? cls "text")
    "text-pool"
    (if (string=? cls "postproc")
      "postproc-pool"
      (if (if (string=? cls "image") 1
            (if (string=? cls "video") 1
              (if (string=? cls "audio") 1 0)))
        "media-pool"
        "text-pool"))))

;; ── T5.3: seats are a record, not a base-65536 pack ──────────────────────
;;
;; `[:record :rebalance/lanes [[:text :i64] [:media :i64] [:postproc :i64]]]`
;; carries both the apportioned seats and the largest-remainder remainders.
;; The public API exposes three scalar projections (`seats-of-*`), so no pack
;; crosses the host boundary and the host makes 3 calls instead of 1 pack call
;; plus 3 unpack calls.
;;
(defn rem64 [p [:ref :rebalance/pair]] :i64
  ;; T5.2 residual: a+b multi-arg → :rebalance/pair (a rem b)
  (let [a (record-get p :a)
        b (record-get p :b)]
    (- a (* (quot a b) b))))


(defn weight-pos? [w :i64] :bool
  (if (< 0 w) true false))

(defn count-active [t [:ref :rebalance/triple]] :i64
  (let [wt (record-get t :a)
        wm (record-get t :b)
        wp (record-get t :c)]
    (+ (if (weight-pos? wt) 1 0)
       (+ (if (weight-pos? wm) 1 0)
          (if (weight-pos? wp) 1 0)))))

(defn min2 [p [:ref :rebalance/pair]] :i64
  (if (< (record-get p :a) (record-get p :b))
    (record-get p :a) (record-get p :b)))

(defn max2 [p [:ref :rebalance/pair]] :i64
  (if (< (record-get p :a) (record-get p :b))
    (record-get p :b) (record-get p :a)))

(defn better-bump? [x [:ref :rebalance/bump-cmp]] :bool
  (let [rem-a (record-get x :rem-a)
        idx-a (record-get x :idx-a)
        rem-b (record-get x :rem-b)
        idx-b (record-get x :idx-b)]
    (if (< rem-b rem-a)
      true
      (if (< rem-a rem-b)
        false
        (if (< idx-a idx-b) true false)))))

;; Pick best among three optional candidates (ok=1 means eligible).
;; Returns 0|1|2 or -1. T5.3: the remainders arrive as a lanes record, so the
;; `_pad` argument that only existed to reach the old fixed shape is gone.
(defn pick-bump-3 [x [:ref :rebalance/bump3-in]] :i64
  (let [ok-t (record-get x :ok-t)
        ok-m (record-get x :ok-m)
        ok-p (record-get x :ok-p)
        rt (record-get x :rt)
        rm (record-get x :rm)
        rp (record-get x :rp)]
    (if ok-t
      (if ok-m
        (let [win-tm (if (better-bump?
                          (record-new [:ref :rebalance/bump-cmp] rt 0 rm 1)) 0 1)
              r-win (if (= win-tm 0) rt rm)
              i-win win-tm]
          (if ok-p
            (if (better-bump?
                 (record-new [:ref :rebalance/bump-cmp] r-win i-win rp 2)) win-tm 2)
            win-tm))
        (if ok-p
          (if (better-bump?
               (record-new [:ref :rebalance/bump-cmp] rt 0 rp 2)) 0 2)
          0))
      (if ok-m
        (if ok-p
          (if (better-bump?
               (record-new [:ref :rebalance/bump-cmp] rm 1 rp 2)) 1 2)
          1)
        (if ok-p 2 -1)))))

(defn ok-for [x [:ref :rebalance/ok-for]] :bool
  (if (record-get x :active)
    (if (record-get x :bumped) false true)
    false))

(defn seats-record [total :i64 wt :i64 wm :i64 wp :i64 floor :i64]
  [:record :rebalance/lanes [[:text :i64] [:media :i64] [:postproc :i64]]]
  (let [at (weight-pos? wt)
        am (weight-pos? wm)
        ap (weight-pos? wp)
        n-active (count-active (record-new [:ref :rebalance/triple] wt wm wp))]
    (if (if (= total 0) 1 (if (= n-active 0) 1 0))
      (record-new [:record :rebalance/lanes
                   [[:text :i64] [:media :i64] [:postproc :i64]]] 0 0 0)
      (let [eff-floor (min2 (record-new [:ref :rebalance/pair] floor (quot total n-active)))
            bt (if at eff-floor 0)
            bm (if am eff-floor 0)
            bp (if ap eff-floor 0)
            left0 (- total (+ bt (+ bm bp)))
            left (max2 (record-new [:ref :rebalance/pair] 0 left0))
            sumw (+ (if at wt 0)
                    (+ (if am wm 0)
                       (if ap wp 0)))
            pt (if at (* left wt) 0)
            pm (if am (* left wm) 0)
            pp (if ap (* left wp) 0)
            ft (if at (quot pt sumw) 0)
            fm (if am (quot pm sumw) 0)
            fp (if ap (quot pp sumw) 0)
            rt (if at (rem64 (record-new [:ref :rebalance/pair] pt sumw)) 0)
            rm (if am (rem64 (record-new [:ref :rebalance/pair] pm sumw)) 0)
            rp (if ap (rem64 (record-new [:ref :rebalance/pair] pp sumw)) 0)
            assigned (+ ft (+ fm fp))
            extra (- left assigned)
            rems (record-new [:record :rebalance/lanes
                              [[:text :i64] [:media :i64] [:postproc :i64]]] rt rm rp)
            ;; bump 0
            b0 (if (< 0 extra)
                 (pick-bump-3 (record-new [:ref :rebalance/bump3-in] (ok-for (record-new [:ref :rebalance/ok-for] at false)) (ok-for (record-new [:ref :rebalance/ok-for] am false)) (ok-for (record-new [:ref :rebalance/ok-for] ap false)) rt rm rp))
                 -1)
            bt0 (if (= b0 0) true false)
            bm0 (if (= b0 1) true false)
            bp0 (if (= b0 2) true false)
            b1 (if (< 1 extra)
                 (pick-bump-3 (record-new [:ref :rebalance/bump3-in] (ok-for (record-new [:ref :rebalance/ok-for] at bt0)) (ok-for (record-new [:ref :rebalance/ok-for] am bm0)) (ok-for (record-new [:ref :rebalance/ok-for] ap bp0)) rt rm rp))
                 -1)
            bt1 (if (= b1 0) true bt0)
            bm1 (if (= b1 1) true bm0)
            bp1 (if (= b1 2) true bp0)
            b2 (if (< 2 extra)
                 (pick-bump-3 (record-new [:ref :rebalance/bump3-in] (ok-for (record-new [:ref :rebalance/ok-for] at bt1)) (ok-for (record-new [:ref :rebalance/ok-for] am bm1)) (ok-for (record-new [:ref :rebalance/ok-for] ap bp1)) rt rm rp))
                 -1)
            bump-t (if (if (= b0 0) 1 (if (= b1 0) 1 (if (= b2 0) 1 0))) 1 0)
            bump-m (if (if (= b0 1) 1 (if (= b1 1) 1 (if (= b2 1) 1 0))) 1 0)
            bump-p (if (if (= b0 2) 1 (if (= b1 2) 1 (if (= b2 2) 1 0))) 1 0)
            st (+ bt (+ ft bump-t))
            sm (+ bm (+ fm bump-m))
            sp (+ bp (+ fp bump-p))]
        (record-new [:record :rebalance/lanes
                     [[:text :i64] [:media :i64] [:postproc :i64]]] st sm sp)))))

;; Public seat API (T5.3). Three scalar projections; no pack crosses the host
;; boundary. Replaces `largest-remainder-3` + `seats-text/media/postproc`.

(defn seats-of-text [in [:ref :rebalance/seats-in]] :i64
  (record-get [:record :rebalance/lanes
               [[:text :i64] [:media :i64] [:postproc :i64]]]
              (seats-record (record-get in :total)
                            (record-get in :text-w)
                            (record-get in :media-w)
                            (record-get in :postproc-w)
                            (record-get in :floor))
              :text))

(defn seats-of-media [in [:ref :rebalance/seats-in]] :i64
  (record-get [:record :rebalance/lanes
               [[:text :i64] [:media :i64] [:postproc :i64]]]
              (seats-record (record-get in :total)
                            (record-get in :text-w)
                            (record-get in :media-w)
                            (record-get in :postproc-w)
                            (record-get in :floor))
              :media))

(defn seats-of-postproc [in [:ref :rebalance/seats-in]] :i64
  (record-get [:record :rebalance/lanes
               [[:text :i64] [:media :i64] [:postproc :i64]]]
              (seats-record (record-get in :total)
                            (record-get in :text-w)
                            (record-get in :media-w)
                            (record-get in :postproc-w)
                            (record-get in :floor))
              :postproc))

(defn seats-total [in [:ref :rebalance/seats-in]] :i64
  ;; total workers assigned across three pools (was assigned-from-seats of a pack)
  (+ (seats-of-text in)
     (+ (seats-of-media in)
        (seats-of-postproc in))))

(defn pool-demand-record [text :i64 image :i64 video :i64 audio :i64 postproc :i64]
  [:ref :rebalance/lanes]
  ;; cljc pool-demand: text→text-pool; image+video+audio→media-pool; postproc→postproc-pool
  (let [wt text
        wm (+ image (+ video audio))
        wp postproc]
    (record-new [:record :rebalance/lanes [[:text :i64] [:media :i64] [:postproc :i64]]] wt wm wp)))

(defn pool-weight-text [w [:ref :rebalance/lanes]] :i64
  (record-get w :text))

(defn pool-weight-media [w [:ref :rebalance/lanes]] :i64
  (record-get w :media))

(defn pool-weight-postproc [w [:ref :rebalance/lanes]] :i64
  (record-get w :postproc))

;; Compose the seat apportionment over pool-weight lanes (record).

(defn pool-seats-of-text [s [:ref :rebalance/seats-in]] :i64
  ;; T5.2 residual: same shape as seats-of-* inputs.
  (record-get [:record :rebalance/lanes
               [[:text :i64] [:media :i64] [:postproc :i64]]]
              (seats-record (record-get s :total)
                            (record-get s :text-w)
                            (record-get s :media-w)
                            (record-get s :postproc-w)
                            (record-get s :floor))
              :text))

(defn pool-seats-of-media [s [:ref :rebalance/seats-in]] :i64
  (record-get [:record :rebalance/lanes
               [[:text :i64] [:media :i64] [:postproc :i64]]]
              (seats-record (record-get s :total)
                            (record-get s :text-w)
                            (record-get s :media-w)
                            (record-get s :postproc-w)
                            (record-get s :floor))
              :media))

(defn pool-seats-of-postproc [s [:ref :rebalance/seats-in]] :i64
  (record-get [:record :rebalance/lanes
               [[:text :i64] [:media :i64] [:postproc :i64]]]
              (seats-record (record-get s :total)
                            (record-get s :text-w)
                            (record-get s :media-w)
                            (record-get s :postproc-w)
                            (record-get s :floor))
              :postproc))

(defn classify-run-flags [x [:ref :rebalance/run-flags]] :i64
  ;; Product Value ABI v1: optional unit/kind tokens on one record.
  ;; mirrors demand-from-runs cond order; returns class code:
  ;; 0 none, 1 text, 2 image, 3 video, 4 audio, 5 postproc
  ;; T5.2 native guest record wire (option-string-in-record).
  (if-some [_ (record-get x :images)]
    2
    (if-some [_ (record-get x :video)]
      3
      (if-some [_ (record-get x :audio)]
        4
        (if-some [_ (record-get x :swarm)]
          5
          (if-some [_ (record-get x :tokens)]
            1
            0))))))

;; ── demand-from-runs class counts (record, not base-4096 pack) ───────

(defn demand-empty [] [:ref :rebalance/demand]
  (record-new [:record :rebalance/demand [[:text :i64] [:image :i64] [:video :i64] [:audio :i64] [:postproc :i64]]] 0 0 0 0 0))

(defn demand-text [d [:ref :rebalance/demand]] :i64
  (record-get d :text))

(defn demand-image [d [:ref :rebalance/demand]] :i64
  (record-get d :image))

(defn demand-video [d [:ref :rebalance/demand]] :i64
  (record-get d :video))

(defn demand-audio [d [:ref :rebalance/demand]] :i64
  (record-get d :audio))

(defn demand-postproc [d [:ref :rebalance/demand]] :i64
  (record-get d :postproc))

(defn demand-record [t :i64 i :i64 v :i64 a :i64 p :i64] [:ref :rebalance/demand]
  (record-new [:record :rebalance/demand [[:text :i64] [:image :i64] [:video :i64] [:audio :i64] [:postproc :i64]]] t i v a p))

(defn demand-inc [d [:ref :rebalance/demand] class-code :i64] [:ref :rebalance/demand]
  ;; one reduce step of demand-from-runs given classify-run-flags code
  (let [t (record-get d :text)
        i (record-get d :image)
        v (record-get d :video)
        a (record-get d :audio)
        p (record-get d :postproc)]
    (if (= class-code 1)
      (demand-record (+ t 1) i v a p)
      (if (= class-code 2)
        (demand-record t (+ i 1) v a p)
        (if (= class-code 3)
          (demand-record t i (+ v 1) a p)
          (if (= class-code 4)
            (demand-record t i v (+ a 1) p)
            (if (= class-code 5)
              (demand-record t i v a (+ p 1))
              d)))))))

(defn demand-to-pool-record [d [:ref :rebalance/demand]] [:ref :rebalance/lanes]
  ;; cljc pool-demand after demand-from-runs
  (pool-demand-record (record-get d :text)
                      (record-get d :image)
                      (record-get d :video)
                      (record-get d :audio)
                      (record-get d :postproc)))

;; ── placement pure layer (target-allocation / rebalance hysteresis) ──

(defn workers-count [online :i64] :i64
  ;; reserve one head/relay when any node is online
  (if (< online 1) 0 (- online 1)))

;; pure core of target-allocation seat step (node id assignment stays cljc).
;; T5.3: three scalar lanes instead of one seat pack.

(defn seats-for-online-text [s [:ref :rebalance/seats-in]] :i64
  ;; T5.2: online is projected into :total by host (or use workers-count of online field).
  ;; Here :total is treated as the online worker count input (host passes online).
  (pool-seats-of-text
   (record-new [:ref :rebalance/seats-in]
               (workers-count (record-get s :total))
               (record-get s :text-w)
               (record-get s :media-w)
               (record-get s :postproc-w)
               (record-get s :floor))))

(defn seats-for-online-media [s [:ref :rebalance/seats-in]] :i64
  (pool-seats-of-media
   (record-new [:ref :rebalance/seats-in]
               (workers-count (record-get s :total))
               (record-get s :text-w)
               (record-get s :media-w)
               (record-get s :postproc-w)
               (record-get s :floor))))

(defn seats-for-online-postproc [s [:ref :rebalance/seats-in]] :i64
  (pool-seats-of-postproc
   (record-new [:ref :rebalance/seats-in]
               (workers-count (record-get s :total))
               (record-get s :text-w)
               (record-get s :media-w)
               (record-get s :postproc-w)
               (record-get s :floor))))

(defn seats-equal [p [:ref :rebalance/pair]] :i64
  ;; hysteresis: seat allocation unchanged?
  (if (= (record-get p :a) (record-get p :b)) 1 0))

(defn pipeline-effective-gb [p [:ref :rebalance/pair]] :i64
  ;; cljc: (* usable text-n) for text pool pipeline
  ;; T5.2: a=usable-gb b=text-seats
  (* (record-get p :a) (record-get p :b)))

(defn node-online? [status :string] :bool
  ;; capacity filter: status "up" only
  (if (string=? status "up") true false))

(defn move-needed [p [:ref :rebalance/pair]] :bool
  ;; pool codes 0=text 1=media 2=postproc; one node placement diff
  ;; T5.2: a=from-pool b=to-pool
  (if (= (record-get p :a) (record-get p :b)) false true))

;; assigned-from-seats replaced by `seats-total` (T5.3) — it took a seat pack.

(defn rebalance-reason-code [p [:ref :rebalance/pair]] :i64
  ;; 0 stable, 1 initial placement, 2 demand-shift
  ;; T5.2: a=assigned-count b=move-count
  (let [assigned-count (record-get p :a)
        move-count (record-get p :b)]
    (if (= assigned-count 0)
      1
      (if (< 0 move-count) 2 0))))

(defn rebalance-reason-name [code :i64] :string
  (if (= code 1)
    "initial placement"
    (if (= code 2)
      "demand-shift"
      "stable")))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn pool-code [name :string] :i64
  ;; 0 text-pool, 1 media-pool, 2 postproc-pool, -1 unknown
  (if (string=? name "text-pool")
    0
    (if (string=? name "media-pool")
      1
      (if (string=? name "postproc-pool") 2 -1))))

(defn pool-name [code :i64] :string
  (if (= code 0)
    "text-pool"
    (if (= code 1)
      "media-pool"
      (if (= code 2) "postproc-pool" "unknown"))))

(defn seat-of [x [:ref :rebalance/seat-of]] :i64
  (let [code (record-get x :code)
        st (record-get x :st)
        sm (record-get x :sm)
        sp (record-get x :sp)]
    (if (= code 0) st (if (= code 1) sm sp))))

(defn before-pool? [x [:ref :rebalance/before-pool]] :bool
  ;; sort-by (comp - val): higher seats first; ties → lower index first (stable text<media<post)
  (let [ia (record-get x :ia)
        ib (record-get x :ib)
        st (record-get x :st)
        sm (record-get x :sm)
        sp (record-get x :sp)
        sa (seat-of (record-new [:ref :rebalance/seat-of] ia st sm sp))
        sb (seat-of (record-new [:ref :rebalance/seat-of] ib st sm sp))]
    (if (< sb sa)
      true
      (if (< sa sb)
        false
        (if (< ia ib) true false)))))

(defn seat-order-record [t [:ref :rebalance/triple]] [:ref :rebalance/order]
  ;; permutation of pool codes 0,1,2 (desc seats); ties → lower index first
  ;; T5.2: a=st b=sm c=sp
  (let [st (record-get t :a)
        sm (record-get t :b)
        sp (record-get t :c)
        p0 (if (before-pool?
               (record-new [:ref :rebalance/before-pool] 0 1 st sm sp)) 0 1)
        p1 (if (before-pool?
               (record-new [:ref :rebalance/before-pool] 0 1 st sm sp)) 1 0)
        q1 (if (before-pool?
               (record-new [:ref :rebalance/before-pool] p1 2 st sm sp)) p1 2)
        q2 (if (before-pool?
               (record-new [:ref :rebalance/before-pool] p1 2 st sm sp)) 2 p1)
        r0 (if (before-pool?
               (record-new [:ref :rebalance/before-pool] p0 q1 st sm sp)) p0 q1)
        r1 (if (before-pool?
               (record-new [:ref :rebalance/before-pool] p0 q1 st sm sp)) q1 p0)]
    (record-new [:record :rebalance/order [[:i0 :i64] [:i1 :i64] [:i2 :i64]]] r0 r1 q2)))

(defn order-nth [x [:ref :rebalance/order-nth]] :i64
  (let [n (record-get x :n)]
    (if (= n 0)
      (record-get x :i0)
      (if (= n 1)
        (record-get x :i1)
        (record-get x :i2)))))

(defn take-end [t [:ref :rebalance/triple]] :i64
  ;; exclusive end index for (take k rem) from start within [0, remaining)
  ;; T5.2: a=start b=k c=remaining
  (min2 (record-new [:ref :rebalance/pair]
                    (record-get t :c)
                    (+ (record-get t :a) (record-get t :b)))))

(defn take-count [p [:ref :rebalance/pair]] :i64
  ;; T5.2: a=start b=end
  (max2 (record-new [:ref :rebalance/pair]
                    0
                    (- (record-get p :b) (record-get p :a)))))

(defn pipeline-note [p [:ref :rebalance/pair]] :string
  ;; cljc target-allocation pipeline :note
  ;; T5.2: a=text-n b=usable
  (let [text-n (record-get p :a)
        usable (record-get p :b)]
    (string-concat
     "text pool sharded as a "
     (string-concat
      (i64-str text-n)
      (string-concat
       "-way pipeline (~"
       (string-concat
        (i64-str (* usable text-n))
        (string-concat
         "GB effective, ceiling "
         (string-concat (i64-str (shard-ceiling-gb)) "GB/node)"))))))))

(defn rebalance-reason-detail [p [:ref :rebalance/pair]] :string
  ;; cljc: (str (count moves) " node(s) re-placed by demand shift")
  ;; T5.2: a=code b=move-count
  (let [code (record-get p :a)
        move-count (record-get p :b)]
    (if (= code 2)
      (string-concat (i64-str move-count) " node(s) re-placed by demand shift")
      (rebalance-reason-name code))))

