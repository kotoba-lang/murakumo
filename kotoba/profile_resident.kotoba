;; Daily propose-only native profile resident. Host config, not checkpoint
;; instructions, fixes authority/identity/policy/endpoints. One systemd-owned
;; writer. A head is published only after a fresh lease and two durable replicas.
(ns murakumo.profile-resident
  (:export [profile-resident-main]))

(defn- rt-now [] :i64 (ln-now "clock"))
(defn- rt-save [path :string b :vector-i64] :bool
  (and (cp-absent? (str path ".tmp"))
    (cp-write (str path ".tmp") b)
    (= (cp-fs "L" (str path ".tmp") path) "1")
    (= (cp-fs "M" (cp-parent-dir path) "") "1")))

(defn- rt-status [cfg :vector-i64 phase :string] :i64
  (let [b (cp-bytes (str "{\"at\":" (rt-now) ",\"phase\":\"" phase "\"}"))
        z (rt-save (cp-str cfg 0 "status") b)] 0))

(defn- rt-root? [cfg :vector-i64 root :vector-i64] :bool (pp-root? cfg root))
(defn- rt-due? [head :vector-i64 request :string now :i64] :bool
  (or (>= now (cp-num head 0 "nextAt")) (not (= request (cp-str head 0 "request")))))

;; A missing request is not a new request. Keep the last consumed CID across
;; absence and periodic turns, so a transient missing file does not enqueue a
;; duplicate or erase the consumed cursor. A present file must be a bounded
;; canonical JSON object; an empty/unreadable or partial write fails closed.
(defn- rt-request-id [present :bool b :vector-i64 previous :string] :string
  (if (not present) (if (= previous "") "none" previous)
    (if (and (> (vector-count b) 0) (<= (vector-count b) 8192)
             (json-valid? b) (json-canonical? b) (= (json-kind b 0) 1))
      (cp-cid b) "")))

(defn- rt-lease [cfg :vector-i64 epoch :i64] :vector-i64
  (let [now (rt-now)]
    (if (or (< epoch 1) (> epoch 9007199254740991) (<= now 0)
            (> now (- 9007199254740991 (lease-ttl)))) (vector-alloc 0)
      (cp-bytes (lease-group-round epoch (cp-str cfg 0 "node")
        (lease-text (cp-str cfg 0 "node") (cp-str cfg 0 "task") 0 epoch (+ now (lease-ttl)) 1)
        (cp-str cfg 0 "voters") (lease-token (cp-str cfg 0 "tokenFile")))))))

;; Do not use a learned value to decide renewal or takeover before validating
;; its epoch, task and bounded times. It may be an old or corrupt quorum value.
(defn- rt-lease-bound? [cfg :vector-i64 lease :vector-i64 epoch :i64 now :i64] :bool
  (and (json-valid? lease) (json-canonical? lease) (= (json-kind lease 0) 1) (= (json-count lease 0) 6)
       (= (cp-str lease 0 "class") (cp-str cfg 0 "task")) (= (cp-num lease 0 "slot") 0)
       (= (cp-num lease 0 "epoch") epoch)
       (valid-value? (cp-str lease 0 "node") true (cp-str cfg 0 "task") 0 epoch (cp-num lease 0 "until") now)))

(defn- rt-current-lease [cfg :vector-i64 floor :i64] :vector-i64
  (let [path (cp-str cfg 0 "leaseFile") status (cp-fs "D" path "")
        saved (if (= status "1") (cp-read path) (vector-alloc 0))]
    (if (not (or (= status "0") (and (= status "1") (json-valid? saved) (json-canonical? saved))))
      (vector-alloc 0)
      (let [e (if (>= (cp-num saved 0 "epoch") floor) (cp-num saved 0 "epoch") floor)
            learned (rt-lease cfg e) now (rt-now) node (cp-str cfg 0 "node")]
        (if (not (rt-lease-bound? cfg learned e now)) (vector-alloc 0)
          (let [mine (= (cp-str learned 0 "node") node)
                renew (or (and mine (> now (- (cp-num learned 0 "until") (lease-renew-before))))
                          (not mine))
                next (if (and renew (< e 9007199254740991)
                           (or mine (> now (+ (cp-num learned 0 "until") (lease-skew)))))
                         (rt-lease cfg (+ e 1)) learned)
                ne (cp-num next 0 "epoch")
                bound (and (or (= ne e) (and (< e 9007199254740991) (= ne (+ e 1))))
                           (rt-lease-bound? cfg next ne (rt-now)))
                saved (and bound (rt-save path next))]
            (if (and saved (= (recovery-lease-problem next (cp-str cfg 0 "task") node ne (rt-now)) "recovery/lease-admitted"))
              next (vector-alloc 0))))))))

(defn- rt-pins [cfg :vector-i64 root :string until :i64] :vector-i64
  (cp-bytes (str "{\"authorA\":\"" (cp-str cfg 0 "authorA") "\",\"authorB\":\"" (cp-str cfg 0 "authorB")
    "\",\"checkpoint\":\"" root "\",\"domainA\":\"" (cp-str cfg 0 "domainA") "\",\"domainB\":\"" (cp-str cfg 0 "domainB")
    "\",\"task\":\"" (cp-str cfg 0 "task") "\",\"until\":" until "}")))

(defn- rt-head [root :string a :string b :string until :i64 next-at :i64 request :string] :vector-i64
  (cp-bytes (str "{\"checkpoint\":\"" root "\",\"kind\":\"itonami.resident-head/1\",\"nextAt\":" next-at
    ",\"receiptA\":\"" a "\",\"receiptB\":\"" b "\",\"request\":\"" request "\",\"until\":" until "}")))

(defn- rt-head-shape? [head :vector-i64] :bool
  (if (not (and (json-valid? head) (json-canonical? head) (= (json-kind head 0) 1))) false
    (let [request (cp-str head 0 "request")]
      (and (= (json-count head 0) 7)
         (= (cp-str head 0 "kind") "itonami.resident-head/1")
         (cp-raw? (cp-str head 0 "checkpoint"))
         (cp-raw? (cp-str head 0 "receiptA")) (cp-raw? (cp-str head 0 "receiptB"))
         (or (= request "none") (cp-raw? request))
         (>= (cp-num head 0 "nextAt") 0) (> (cp-num head 0 "until") 0)))))

;; The host-provisioned authorB pins the signer. A signature binds schedule
;; and request but does not prevent replay of an older valid signed head.
(defn- rt-sign-head [cfg :vector-i64 head :vector-i64] :vector-i64
  (let [seed (cp-seed (cp-str cfg 0 "key")) did (cp-str cfg 0 "authorB")]
    (if (and (rt-head-shape? head) (= (vector-count seed) 32)
             (= (did-from-public (public-from-seed seed)) did))
      (cp-bytes (str "{\"payload\":" (cp-text head) ",\"signature\":\"" (sign-statement seed (cp-text head)) "\"}"))
      (vector-alloc 0))))

(defn- rt-open-head [cfg :vector-i64 envelope :vector-i64] :vector-i64
  (if (not (and (json-valid? envelope) (json-canonical? envelope) (= (json-kind envelope 0) 1) (= (json-count envelope 0) 2)))
    (vector-alloc 0)
    (let [p (cp-payload envelope)
          head (if (>= p 0) (cp-bytes (cp-json envelope p)) (vector-alloc 0))]
      (if (and (rt-head-shape? head)
               (= (statement-problem (cp-str cfg 0 "authorB") (cp-text head) (cp-str envelope 0 "signature")) "enroll/ok"))
        head (vector-alloc 0)))))

(defn- rt-read-head [cfg :vector-i64 path :string] :vector-i64
  (if (cp-exists? path) (rt-open-head cfg (cp-read path)) (vector-alloc 0)))

(defn- rt-replicate [cfg :vector-i64 root :string next-at :i64 request :string] :bool
  (let [store (cp-str cfg 0 "store") until (+ (rt-now) 172800000)
        address (cp-str cfg 0 "peer") token (lease-token (cp-str cfg 0 "tokenFile"))
        sent (peer-upload store root address token)
        a (if sent (peer-retain store root address token until) "")
        r (if (not (= a "")) (retention-attest store root (cp-str cfg 0 "key") (cp-str cfg 0 "domainB") (cp-str cfg 0 "task") until) "")
        b (if (= (ln-field r 0) "retention/recorded") (ln-field r 1) "")
        envelope (rt-sign-head cfg (rt-head root a b until next-at request))]
    (and (not (= a "")) (not (= b ""))
      (= (retention-pair-problem (cp-load store a) (cp-load store b) (rt-pins cfg root until)) "retention/pair-verified")
      (> (vector-count envelope) 0)
      (rt-save (cp-str cfg 0 "candidateHead") envelope))))

(defn- rt-intact-head? [cfg :vector-i64 head :vector-i64] :bool
  (let [store (cp-str cfg 0 "store") root (cp-str head 0 "checkpoint") until (cp-num head 0 "until")]
    (and (rt-head-shape? head)
      (cp-block? store root) (rt-root? cfg (cp-load store root)) (cp-closure? store (cp-load store root))
      (= (retention-pair-problem (cp-load store (cp-str head 0 "receiptA"))
           (cp-load store (cp-str head 0 "receiptB")) (rt-pins cfg root until)) "retention/pair-verified"))))

;; An expired but cryptographically intact head may be re-replicated without
;; dispatching inference. A safety margin avoids expiring between refresh and
;; the controller's subsequent archive/prepare/once steps.
(defn- rt-admitted-head? [cfg :vector-i64 head :vector-i64] :bool
  (and (rt-intact-head? cfg head) (> (cp-num head 0 "until") (rt-now))))

;; Read once and validate before publishing: candidateHead is an intermediate
;; file, not authority to change the accepted checkpoint or consumed request.
(defn- rt-publish-candidate [cfg :vector-i64 root :string next-at :i64 request :string] :bool
  (let [path (cp-str cfg 0 "candidateHead")]
    (if (not (cp-exists? path)) false
      (let [envelope (cp-read path) head (rt-open-head cfg envelope)]
        (and (rt-admitted-head? cfg head) (= (cp-str head 0 "checkpoint") root)
             (= (cp-num head 0 "nextAt") next-at) (= (cp-str head 0 "request") request)
             (rt-save (cp-str cfg 0 "head") envelope))))))

(defn- rt-refresh-decision [intact :bool until :i64 now :i64] :string
  (cond (not intact) "resident/head-refused"
        (> until (+ now 900000)) "resident/retention-ready"
        :else "resident/retention-refresh-needed"))

;; GitHub-enabled MTP residents checkpoint only a classified projection of
;; the runtime. Socket, authorizationFile and endpoint remain host-local.
;; Pins describe operator-selected artifacts; they do not attest the peer.
(defn- rt-public-environment? [cfg :vector-i64 runtime :vector-i64 env :vector-i64] :bool
  (and (json-canonical? env) (= (json-kind env 0) 1) (= (json-count env 0) 14)
       (= (cp-str env 0 "kind") "itonami.profile-environment-public/2")
       (json-canonical? runtime) (pr-local-mtp? runtime) (= (cp-str runtime 0 "profile") "awai-growth-steward")
       (= (cp-str env 0 "profile") (cp-str runtime 0 "profile"))
       (= (digest-problem (cp-str env 0 "profileDigest")) "oci/ok")
       (= (cp-str env 0 "profileDigest") (cp-str cfg 0 "profile"))
       (= (cp-str env 0 "profileDigest") (cp-str runtime 0 "profileDigest"))
       (= (cp-str env 0 "roleDigest") (cp-str runtime 0 "roleDigest"))
       (= (cp-str env 0 "workDigest") (cp-str runtime 0 "workDigest"))
       (= (cp-str env 0 "contextDigest") (cp-str runtime 0 "contextDigest"))
       (= (cp-str env 0 "source") (cp-str runtime 0 "source")) (cp-hex? (cp-str env 0 "source") 40)
       (>= (cp-num env 0 "maxTokens") 64) (<= (cp-num env 0 "maxTokens") 768)
       (= (cp-num env 0 "maxTokens") (cp-num runtime 0 "maxTokens"))
       (= (cp-str env 0 "model") (cp-str runtime 0 "model")) (not (= (cp-str env 0 "model") ""))
       (= (field-problem (cp-str env 0 "model")) "enroll/ok")
       (= (cp-str env 0 "task") (cp-str cfg 0 "task")) (= (cp-str env 0 "task") (cp-str runtime 0 "task"))
       (= (cp-str env 0 "rail") "murakumo") (= (cp-str runtime 0 "rail") "murakumo")
       (= (cp-str env 0 "tools") "none") (= (cp-str runtime 0 "tools") "none")
       (= (digest-problem (cp-str env 0 "roleDigest")) "oci/ok")
       (= (digest-problem (cp-str env 0 "workDigest")) "oci/ok")
       (= (digest-problem (cp-str env 0 "contextDigest")) "oci/ok")
       (= (digest-problem (cp-str env 0 "modelArtifactDigest")) "oci/ok")
       (= (digest-problem (cp-str env 0 "mtpArtifactDigest")) "oci/ok")
       (= (cp-str env 0 "modelArtifactDigest") (cp-str cfg 0 "modelArtifactDigest"))
       (= (cp-str env 0 "mtpArtifactDigest") (cp-str cfg 0 "mtpArtifactDigest"))))

(defn- rt-runtime [cfg :vector-i64] :vector-i64
  (cp-read (if (= (cp-str cfg 0 "archiveAck") "")
             (cp-str cfg 0 "environmentFile") (cp-str cfg 0 "runtimeFile"))))

(defn- rt-pins-ok? [cfg :vector-i64] :bool
  (let [env (cp-read (cp-str cfg 0 "environmentFile")) policy (cp-read (cp-str cfg 0 "policyFile"))]
    (and (= (cp-cid env) (cp-str cfg 0 "environment")) (= (cp-cid policy) (cp-str cfg 0 "policy"))
         (or (= (cp-str cfg 0 "archiveAck") "")
             (and (cp-safe-absolute? (cp-str cfg 0 "runtimeFile"))
                  (= (cp-cid (rt-runtime cfg)) (cp-str cfg 0 "runtime"))
                  (rt-public-environment? cfg (rt-runtime cfg) env))))))

(defn- rt-refresh [cfg :vector-i64] :string
  (let [path (cp-str cfg 0 "head") head (rt-read-head cfg path)
        problem (if (rt-pins-ok? cfg) (rt-refresh-decision (rt-intact-head? cfg head) (cp-num head 0 "until") (rt-now)) "resident/runtime-pins-refused")]
    (if (not (= problem "resident/retention-refresh-needed")) problem
      (if (and (rt-replicate cfg (cp-str head 0 "checkpoint") (cp-num head 0 "nextAt") (cp-str head 0 "request"))
               (rt-publish-candidate cfg (cp-str head 0 "checkpoint") (cp-num head 0 "nextAt") (cp-str head 0 "request"))
               (rt-admitted-head? cfg (rt-read-head cfg path))) "resident/replicas-refreshed" "resident/replica-unavailable"))))

;; An optional host-provisioned private acknowledgement directory gates each
;; next turn on confirmed GitHub archival of the current admitted checkpoint.
;; The file is a local trust boundary, not a remote lease or a signed receipt.
(defn- rt-archive-ack? [path :string root :string] :bool
  (if (= path "") true
    (if (not (cp-exists? path)) false
      (let [ack (cp-read path)]
        (and (json-canonical? ack) (= (json-kind ack 0) 1) (= (json-count ack 0) 4)
          (= (cp-str ack 0 "kind") "itonami.github-archive-ack/1")
          (= (cp-str ack 0 "checkpoint") root) (cp-hex? (cp-str ack 0 "tree") 40)
          (> (cp-num ack 0 "until") (rt-now)) (<= (cp-num ack 0 "until") (+ (rt-now) 900000)))))))

;; Describe only a currently verified, replica-admitted head. A signed epoch and
;; parent are archive parameters, not an independent lease or new head grant.
(defn- rt-archive [cfg :vector-i64] :string
  (let [path (cp-str cfg 0 "head") head (rt-read-head cfg path)
        store (cp-str cfg 0 "store") root (cp-str head 0 "checkpoint")
        b (if (cp-block? store root) (cp-load store root) (vector-alloc 0)) p (cp-payload b)]
    (if (or (= (cp-str cfg 0 "archiveAck") "") (not (cp-safe-absolute? store))
            (not (rt-admitted-head? cfg head))
            (not (rt-pins-ok? cfg)))
      "resident/archive-refused"
      (str "resident/archive " root " " (cp-str b p "did") " " (cp-str cfg 0 "profile")
                   " " (cp-str cfg 0 "policy") " " (cp-str cfg 0 "environment") " " (cp-num b p "epoch")
                   " " (cp-str b p "parent") " " (cp-str cfg 0 "task") " " store " " (cp-str cfg 0 "archiveAck")))))

;; Archive an admitted head under the resident's local lock, then publish the
;; acknowledgement only after readback and a second admission check. The host
;; supplies a fresh, private work path and pinned GitHub executable/repository.
;; Failure or unknown outcome is returned to the caller without retry.
(defn- rt-archive-native [cfg :vector-i64 work :string repo :string gh :string] :string
  (let [descriptor (rt-archive cfg)
        root (ln-field descriptor 1) author (ln-field descriptor 2) profile (ln-field descriptor 3)
        policy (ln-field descriptor 4) environment (ln-field descriptor 5) epoch-text (ln-field descriptor 6)
        parent (ln-field descriptor 7) task (ln-field descriptor 8) store (ln-field descriptor 9) ack (ln-field descriptor 10)
        exact (str "resident/archive " root " " author " " profile " " policy " " environment " " epoch-text
                   " " parent " " task " " store " " ack)]
    (if (or (not (= descriptor exact)) (not (cp-safe-absolute? ack))
            (= work ack) (= work (str ack ".tmp"))) "resident-archive/head-refused"
      (let [result (ga-archive work store root author profile policy environment (cp-int epoch-text) parent task repo gh)
            tree (ln-field result 2) outcome (ln-field result 3)
            valid (and (cp-hex? tree 40) (or (= outcome "acknowledged") (= outcome "unacknowledged"))
                       (= result (str "archive/stored " root " " tree " " outcome)))
            now (rt-now) current (= (rt-archive cfg) descriptor)
            tmp (str ack ".tmp")
            until (if (and (> now 0) (<= now 9223372036853875807)) (+ now 900000) 0)
            body (cp-bytes (str "{\"checkpoint\":\"" root "\",\"kind\":\"itonami.github-archive-ack/1\",\"tree\":\""
                                tree "\",\"until\":" until "}"))
            prepared (and valid current (> until 0)
                          (cp-absent? tmp) (cp-write tmp body))
            moved (if prepared (cp-fs "L" tmp ack) "0")
            synced (if (= moved "1") (cp-fs "M" (cp-parent-dir ack) "") "0")]
        (if (= synced "1") (str "resident-archive/confirmed " root " " tree)
          "resident-archive/unconfirmed")))))

(defn- rt-capture [cfg :vector-i64 repo :string epoch :i64 parent :string next :i64] :string
  (let [list (str (cp-str cfg 0 "runtimeRoot") "/untracked.json") summary (str (cp-str cfg 0 "runtimeRoot") "/summary.txt")
        saved (and (cp-write list (cp-bytes (str "[\"outputs/" next ".json\"]")))
                   (cp-write summary (cp-bytes (str "Verified read-only resident proposal turn " next "; no tools dispatched.\n"))))
        args (str (cp-str cfg 0 "checkpointBinary") (cp-a) "capture" (cp-a) repo (cp-a) (cp-str cfg 0 "store")
          (cp-a) (cp-str cfg 0 "key") (cp-a) repo "/profile/itonami.edn" (cp-a) (cp-str cfg 0 "policyFile")
          (cp-a) (cp-str cfg 0 "environmentFile") (cp-a) summary (cp-a) list (cp-a) epoch (cp-a) parent (cp-a) (cp-str cfg 0 "task"))
        result (if saved (cp-spawn args) "") first (cp-line (cp-out result))]
    (if (and (cp-ok? result) (= (ln-field first 0) "checkpoint/created")) (ln-field first 1) "")))

;; A valid dispatch budget cannot replace checking the input promise after
;; inference or the potentially slow capture/replica round. Keep the proposal
;; when either the deadline or the independently re-learned lease is lost.
(defn- rt-post-problem [cfg :vector-i64 head :vector-i64 lease :vector-i64 fresh :vector-i64 now :i64] :string
  (cond (<= (cp-num head 0 "until") now) "resident/retention-expired-proposal-retained"
        (or (not (= (cp-text lease) (cp-text fresh)))
            (not (= (recovery-lease-problem fresh (cp-str cfg 0 "task") (cp-str cfg 0 "node")
                      (cp-num lease 0 "epoch") now) "recovery/lease-admitted"))) "resident/lease-lost"
        :else "resident/admission-held"))

(defn- rt-turn [cfg :vector-i64 head :vector-i64 lease :vector-i64 request :string] :string
  (let [store (cp-str cfg 0 "store") root (cp-str head 0 "checkpoint") checkpoint (cp-load store root)
        dest (str (cp-str cfg 0 "runtimeRoot") "/checkouts/" (rt-now))
        restored (cp-materialize store checkpoint dest)]
    (if (not (= restored "checkpoint/restored")) restored
      (let [next (cp-num (cp-read (str dest "/state.json")) 0 "next")
            next-at (+ (rt-now) (cp-num cfg 0 "intervalMs"))
            status (rt-status cfg "inference")
            result (pr-step-resident dest (rt-runtime cfg) (cp-str cfg 0 "cache") next
                     (rf-budget (cp-num lease 0 "until") (cp-num head 0 "until") (rt-now)))
            fresh (rt-lease cfg (cp-num lease 0 "epoch"))
            post (rt-post-problem cfg head lease fresh (rt-now))]
        (cond (not (= (ln-field result 0) "profile/step-completed")) result
              (not (= post "resident/admission-held")) post
              :else
              (let [successor (rt-capture cfg dest (cp-num lease 0 "epoch") root next)
                    copied (and (not (= successor "")) (rt-replicate cfg successor next-at request))
                    final (if copied (rt-lease cfg (cp-num lease 0 "epoch")) (vector-alloc 0))
                    post-final (rt-post-problem cfg head lease final (rt-now))]
                (cond (not copied) "resident/proposal-retained"
                      (not (= post-final "resident/admission-held")) post-final
                      (rt-publish-candidate cfg successor next-at request)
                      (str "resident/published " next " " successor)
                      :else "resident/head-publication-failed")))))))

(defn- rt-cycle [cfg :vector-i64] :string
  (let [head-path (cp-str cfg 0 "head") head-status (cp-fs "D" head-path "")
        head-present (= head-status "1") head (rt-read-head cfg head-path)
        root (if head-present (cp-str head 0 "checkpoint") (cp-str cfg 0 "bootstrap"))
        request-path (cp-str cfg 0 "request") request-status (cp-fs "D" request-path "") present (= request-status "1")
        request (rt-request-id present (if present (cp-read request-path) (vector-alloc 0))
                               (cp-str head 0 "request"))]
    (cond (not (or (= head-status "0") (= head-status "1"))) "resident/head-unknown"
          ;; A writer may have stopped during request replacement. Do not
          ;; turn the old request into a periodic run while its successor is
          ;; unresolved; only an explicit absent result permits progress.
          (not (= (cp-fs "D" (str request-path ".tmp") "") "0")) "resident/request-unknown"
          (not (or (= request-status "0") (= request-status "1"))) "resident/request-unknown"
          (= request "") "resident/request-refused"
          (not (rt-pins-ok? cfg)) "resident/runtime-pins-refused"
          (not (cp-block? (cp-str cfg 0 "store") root)) "resident/missing-checkpoint"
          (not (rt-root? cfg (cp-load (cp-str cfg 0 "store") root))) "resident/checkpoint-refused"
          ;; Do not turn an invalid checkpoint or replica receipts into
          ;; a newly admitted head. Bootstrap has no prior head; an existing
          ;; head may be refreshed only after its full contract is intact.
          (and head-present (not (rt-intact-head? cfg head))) "resident/head-refused"
          (not (rt-admitted-head? cfg head))
          (if (and (rt-replicate cfg root (if head-present (cp-num head 0 "nextAt") 0)
                      (if head-present (cp-str head 0 "request") "none"))
                   (rt-publish-candidate cfg root (if head-present (cp-num head 0 "nextAt") 0)
                     (if head-present (cp-str head 0 "request") "none"))) "resident/replicas-refreshed" "resident/replica-unavailable")
          (not (rt-archive-ack? (cp-str cfg 0 "archiveAck") root)) "resident/archive-pending"
          (not (rt-due? head request (rt-now))) "resident/idle"
          :else (let [root-data (cp-load (cp-str cfg 0 "store") root)
                      lease (rt-current-lease cfg (cp-num root-data (cp-payload root-data) "epoch"))]
                  (if (= (vector-count lease) 0) "resident/quorum-unavailable" (rt-turn cfg head lease request))))))

;; A host-provisioned head path identifies the local writer domain. Keep the
;; inode fixed for the lifetime of every participant. This lock is local only:
;; it is neither a lease nor a distributed fence, and shared caches or heads
;; reachable through different configured paths still require host isolation.
(defn- rt-serialized [cfg :vector-i64 operation :string] :string
  (let [head (cp-str cfg 0 "head") lock (str head ".resident-lockfile")]
    (if (not (and (cp-safe-absolute? head)
                  (= (typed-cap-call 35 :string :string (str lock "FLOCK_SEP")) "1")))
      "resident/local-writer-busy"
      (let [result (cond (= operation "cycle") (rt-cycle cfg)
                         (= operation "refresh") (rt-refresh cfg)
                         (= operation "archive") (rt-archive cfg)
                         (= operation "archive-native") (rt-archive-native cfg (cp-arg 2) (cp-arg 3) (cp-arg 4))
                         :else "resident/command-refused")
            status (if (= operation "cycle") (rt-status cfg result) 0)
            released (= (typed-cap-call 35 :string :string (str lock "UNLOCK_SEP")) "1")]
        (if released result "resident/local-unlock-failed")))))

;; A configured file must never be allowed to replace the lock inode. The
;; host must also avoid hard links, aliases and out-of-band changes to it.
(defn- rt-lock-config-safe? [cfg :vector-i64 config-path :string] :bool
  (let [head (cp-str cfg 0 "head") lock (str head ".resident-lockfile")]
    (and (cp-safe-absolute? head)
         (not (= lock config-path))
         (not (= lock (cp-str cfg 0 "store")))
         (not (= lock (cp-str cfg 0 "runtimeRoot")))
         (not (= lock (cp-str cfg 0 "status")))
         (not (= lock (cp-str cfg 0 "candidateHead")))
         (not (= lock (cp-str cfg 0 "request")))
         (not (= lock (cp-str cfg 0 "leaseFile")))
         (not (= lock (cp-str cfg 0 "key")))
         (not (= lock (cp-str cfg 0 "tokenFile")))
         (not (= lock (cp-str cfg 0 "policyFile")))
         (not (= lock (cp-str cfg 0 "environmentFile")))
         (not (= lock (cp-str cfg 0 "runtimeFile")))
         (not (= lock (cp-str cfg 0 "archiveAck"))))))

;; Only known successful cycles may be scheduled again. Every refusal or
;; uncertain side effect exits so the host can reconcile it before another run.
(defn- rt-cycle-ok? [result :string] :bool
  (or (= result "resident/idle") (= result "resident/replicas-refreshed")
      (and (= (ln-field result 0) "resident/published")
           (> (ln-int (ln-field result 1)) 0) (cp-raw? (ln-field result 2))
           (= result (str "resident/published " (ln-field result 1) " " (ln-field result 2))))))

(defn- rt-once [cfg :vector-i64 operation :string] :i64
  (let [result (rt-serialized cfg operation) logged (cp-say result)
        ok (cond (= operation "cycle") (rt-cycle-ok? result)
                 (= operation "refresh") (or (= result "resident/retention-ready") (= result "resident/replicas-refreshed"))
                 (= operation "archive") (= (ln-field result 0) "resident/archive")
                 (= operation "archive-native") (= (ln-field result 0) "resident-archive/confirmed")
                 :else false)]
    (if ok 0 1)))

(defn profile-resident-main [] :i64
  (let [cfg (cp-read (cp-arg 1)) archive-field (json-member cfg 0 "archiveAck")
        ack (cp-str cfg 0 "archiveAck")]
    (if (or (not (json-canonical? cfg)) (not (rt-lock-config-safe? cfg (cp-arg 1)))
            (not (= (cp-str cfg 0 "kind") "itonami.profile-resident/1"))
            (not (= (cp-num cfg 0 "intervalMs") 86400000))
            (and (>= archive-field 0)
                 (or (not (= (json-kind cfg archive-field) 3)) (not (cp-safe-absolute? ack))
                     (= ack (cp-arg 1)) (= ack (cp-str cfg 0 "head")) (= ack (cp-str cfg 0 "store"))
                     (= ack (cp-str cfg 0 "status")) (= ack (cp-str cfg 0 "candidateHead"))
                     (= ack (cp-str cfg 0 "request")) (= ack (cp-str cfg 0 "leaseFile"))
                     (= ack (cp-str cfg 0 "key")) (= ack (cp-str cfg 0 "tokenFile"))
                     (= ack (cp-str cfg 0 "policyFile")) (= ack (cp-str cfg 0 "environmentFile"))
                     (= ack (cp-str cfg 0 "runtimeFile"))))
            (not (rf-voters? (cp-str cfg 0 "voters"))) (= (lease-token (cp-str cfg 0 "tokenFile")) "")
            (not (= (ri-show (cp-str cfg 0 "key")) (str "identity/did " (cp-str cfg 0 "authorB")))))
      (let [x (cp-say "resident/config-refused")] 2)
      (if (= (cp-arg 0) "refresh") (rt-once cfg "refresh")
      (if (= (cp-arg 0) "archive") (rt-once cfg "archive")
      (if (= (cp-arg 0) "archive-native") (rt-once cfg "archive-native")
      (if (= (cp-arg 0) "once")
        (rt-once cfg "cycle")
      (if (not (= (cp-arg 0) "run")) (let [x (cp-say "resident/command-refused")] 2)
      (loop [i 0]
        (let [result (arena-scope
                       (let [r (rt-serialized cfg "cycle") event (cp-say r)]
                         (if (rt-cycle-ok? r) 0 1)))
              z (if (= result 0)
                  (loop [k 0] (if (>= k 10) true (if (pr-pause) (recur (+ k 1)) false))) false)]
          (if z (recur (+ i 1)) 2)))))))))))
