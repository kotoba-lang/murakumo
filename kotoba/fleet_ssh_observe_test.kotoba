;; Native unity fixture: compose tunnel_core, fleet_ssh_observe, then this
;; source; export main. No network or process capability is used by this test.
(ns murakumo.fleet-ssh-observe-test (:export [main]))
(defn main [] :i64
  (let [node "benjamin" ip "100.75.169.8" key "/tmp/keys/id" known "/tmp/known-hosts"
        valid (observe-inputs? node ip key known)
        rejects (and (not (observe-inputs? "" ip key known))
          (not (observe-inputs? "-evil" ip key known))
          (not (observe-inputs? "a@b" ip key known))
          (not (observe-inputs? node "100.128.1.1" key known))
          (not (observe-inputs? node "100.075.1.1" key known))
          (not (observe-inputs? node "100.75.999.1" key known))
          (not (observe-inputs? node "100.75.1" key known))
          (not (observe-inputs? node ip "/tmp/ARG_SEPbad" known))
          (not (observe-inputs? node ip "/tmp/../id" known))
          (= (observe-ssh-request node ip key known "arbitrary") "")
          (= (observe-result "0\nhello") "")
          (= (observe-result "1\nhello__murakumo_rc=0\n") "")
          (= (observe-result "0\nhello\u001b[31m__murakumo_rc=0\n") "")
          (= (observe-result "0\nhello__murakumo_rc=7\n") "")
          (= (observe-reply-reason "124\npartial secret") "transport-exit-124")
          (= (observe-reply-reason "255\n") "transport-exit-255")
          (= (observe-reply-reason "01\n") "host-response-invalid")
          (= (observe-reply-reason "0\nno marker") "remote-output-unknown")
          (= (observe-reply-reason "0\nhello__murakumo_rc=0\n") "ok")
          (= (observe-memory-swap "17179869184\n") "")
          (= (observe-memory-swap "17179869184\ntotal = 1M used = 0M free = 1M") "")
          (= (observe-memory-swap "17179869184\ntotal = 1M used = 0M free = 1M\nextra\n") "")
          (= (observe-memory-swap "0\ntotal = 1M used = 0M free = 1M\n") "")
          (= (observe-memory-swap "17x\ntotal = 1M used = 0M free = 1M\n") "")
          (= (observe-memory-swap "17179869184\ntotal = x used = 0M free = 1M\n") "")
          (= (observe-memory-swap "17179869184\ntotal = 1M used = 0M free = 1M extra\n") "")
          (not (= (observe-memory-swap "17179869184\ntotal = 1024.00M  used = 133.25M  free = 890.75M  (encrypted)\n") ""))
          (= (observe-memory-swap "17179869184\ntotal = 1M used = 0M free = 1M\n")
             "memory:\n17179869184\nswap:\ntotal = 1M used = 0M free = 1M\n")
          (not (= (observe-pressure "The system has 17179869184 bytes.\nSystem-wide memory free percentage: 66%\n") ""))
          (= (observe-pressure "System-wide memory free percentage: 101%\n") "")
          (= (observe-pressure "System-wide memory free percentage: 06%\n") "")
          (= (observe-pressure "System-wide memory free percentage: 6%\nSystem-wide memory free percentage: 6%\n") "")
          (= (observe-pressure "System-wide memory free percentage: 66%") "")
          (not (= (observe-disk "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3s1s1 239362496 12165916 18286632 40% /\n") ""))
          (= (observe-disk "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3 10 1 9 101% /\n") "")
          (= (observe-disk "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3 10 1 x 10% /\n") "")
          (= (observe-disk "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3 10 1 9 10% /other\n") "")
          (= (observe-disk "Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3 10 1 9 10% /\nextra\n") "")
          (= (observe-fixed-snapshot "414f533101000000000000000400000000000040000000000000e821000000000000181e00000000420000000010000003a2400000000000\n")
             "physical-memory-bytes: 17179869184\nswap-total-bytes: 1073741824\nswap-available-bytes: 568852480\nswap-used-bytes: 504889344\nmemorystatus-level: 66\ndisk-available-bytes: 17349750784\n")
          (= (observe-fixed-snapshot "414f533101000000000000000400000000000040000000000000e821000000000000181e00000000420000000010000003a2400000000000") "")
          (= (observe-fixed-snapshot "414f533101000000000000000400000000000040000000000000e821000000000000181e00000000ff0000000010000003a2400000000000\n") "")
          (= (observe-fixed-snapshot "414f533101000000000000000400000000000040000000000000e821000000000000181e00000000420000000010000003a240000000000G\n") "")
          (= (observe-fixed-snapshot "414f533101000000000000000000008000000040000000000000e821000000000000181e00000000420000000010000003a2400000000000\n") "")
          (= (observe-fixed-snapshot "414f533101000000000000000400000000000040000000000000e821000000000000181e00000000420000000000000003a2400000000000\n") "")
          (= (observe-fixed-snapshot "414f533101000000000000000400000000000040000000000000e821000000000000181e000000004200000000100000ffffffffffff1f00\n") "")
          (= (observe-fixed-snapshot "414f5331010000000000000004000000000000400000000000000080000000000000181e00000000420000000010000003a2400000000000\n") "")
          (not (= (observe-native-snapshot "__awai_memory__\n17179869184\ntotal = 0.00M used = 0.00M free = 0.00M (encrypted)\n__awai_pressure__\nSystem-wide memory free percentage: 90%\n__awai_disk__\nFilesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3 10 1 9 10% /\n") ""))
          (= (observe-native-snapshot "__awai_memory__\n17179869184\ntotal = 0.00M used = 0.00M free = 0.00M\n__awai_pressure__\nSystem-wide memory free percentage: 90%\n") "")
          (= (observe-native-snapshot "__awai_memory__\n17179869184\ntotal = 0.00M used = 0.00M free = 0.00M\n__awai_pressure__\nSystem-wide memory free percentage: 90%\n__awai_disk__\nFilesystem 1024-blocks Used Available Capacity Mounted on\n/dev/disk3 10 1 x 10% /\n") "")
          (= (observe-model-files node "") "")
          (= (observe-model-files node "Regular File 1 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/model.safetensors\n") "")
          (= (observe-model-files node "Regular File 1 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/model.safetensors\nSymbolic Link 2 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/mtp.safetensors\n") "")
          (= (observe-model-files node "Regular File 1 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/model.safetensors\nRegular File 0 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/mtp.safetensors\n") "")
          (= (observe-model-files node "Regular File 1 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/model.safetensors\nRegular File 2 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/mtp.safetensors\nextra\n") "")
          (not (= (observe-model-files node "Regular File 1 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/model.safetensors\nRegular File 2 /Users/benjamin/.murakumo/awai147-mtplx-bonsai/mtp.safetensors\n") ""))
          (= (observe-result "0\nhello__murakumo_rc=0\n") "hello"))
        request (observe-ssh-request node ip key known "memory-swap")
        fixed (and (>= (string-index-of request "StrictHostKeyChecking=yes") 0)
                   (>= (string-index-of request "GlobalKnownHostsFile=/dev/null") 0)
                   (>= (string-index-of request "VerifyHostKeyDNS=no") 0)
                   (>= (string-index-of request "UpdateHostKeys=no") 0)
                   (>= (string-index-of request "HostKeyAlias=benjamin") 0)
                   (>= (string-index-of request "/usr/sbin/sysctl -n hw.memsize vm.swapusage") 0)
                   (>= (string-index-of (observe-ssh-request node ip key known "native-snapshot") "/Users/benjamin/.murakumo/bin/fleet-host-observer") 0)
                   (>= (string-index-of (observe-ssh-request node ip key known "model-files") "/usr/bin/stat -f '%HT %z %N'") 0)
                   (>= (string-index-of (observe-ssh-request node ip key known "disk") "/bin/df -Pk /") 0))]
    (if (and valid rejects fixed) 0 1)))
