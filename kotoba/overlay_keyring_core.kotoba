(ns overlay-keyring-core
  (:schemas {;; T5.2 native guest record wire for multi-scalar keyring inputs
             :keyring/epoch-in [:record :keyring/epoch-in
                                [[:seconds :i64] [:rotation-seconds :i64]]]
             :keyring/key-id-in [:record :keyring/key-id-in
                                 [[:overlay :string] [:epoch :i64]]]
             :keyring/derive-in [:record :keyring/derive-in
                                 [[:operator-seed :string] [:overlay :string] [:epoch :i64]]]})
  (:export [default-rotation-seconds epoch key-id-input derive-key-input
            digit-char nat-str i64-str
            seed-sep key-id-mid derive-key-mid
            key-id-hex-len type-key type-rotation]))

;; W6 pure-planner oracle — murakumo.overlay.keyring scalar/preimage core.
;; Residual seed/key-id seps + type tokens dual-source; preimages recompose.
;; SHA-256 kid/key hashing stays host (identity/sha256-hex).
;; Parity: test/murakumo/overlay_keyring_kotoba_parity_test.clj

(defn default-rotation-seconds [] :i64 86400)

(defn key-id-hex-len [] :i64 16)

;; ── residual preimage seps + type tokens ─────────────────────────────

(defn seed-sep [] :string
  ;; between operator-seed / overlay / epoch segments
  ":")

(defn key-id-mid [] :string
  ;; overlay + mid + epoch preimage for kid hash
  ":key:")

(defn derive-key-mid [] :string
  ;; overlay + mid + epoch in derive-key preimage
  ":murakumo-overlay-key:")

(defn type-key [] :string
  "murakumo.overlay.key")

(defn type-rotation [] :string
  "murakumo.overlay.key-rotation")

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn epoch [x [:ref :keyring/epoch-in]] :i64
  ;; T5.2 native: single epoch-in record.
  (quot (record-get x :seconds) (record-get x :rotation-seconds)))

(defn key-id-input [x [:ref :keyring/key-id-in]] :string
  ;; T5.2 native: single key-id-in record.
  (string-concat (record-get x :overlay)
                 (string-concat (key-id-mid) (i64-str (record-get x :epoch)))))

(defn derive-key-input [x [:ref :keyring/derive-in]] :string
  ;; T5.2 native: single derive-in record.
  (string-concat
   (record-get x :operator-seed)
   (string-concat
    (seed-sep)
    (string-concat
     (record-get x :overlay)
     (string-concat (derive-key-mid) (i64-str (record-get x :epoch)))))))
