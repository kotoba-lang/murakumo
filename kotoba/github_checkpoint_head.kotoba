;; Conditional GitHub checkpoint head candidate. Compose after
;; github_checkpoint_archive.kotoba and its pinned closure. A Git ref is not a
;; lease: an independently authorized host must validate authority, hold the
;; expected head and fence effects at their actual sinks. Never auto-retry an
;; unknown result. The host isolates paths, credentials, Git/GH and egress.
(ns murakumo.github-checkpoint-head (:export [github-checkpoint-head-main github-checkpoint-head-restore-main]))

(defn- gh-head-text [task :string cid :string] :string
  (str "{\"checkpoint\":\"" cid "\",\"kind\":\"itonami.github-head/1\",\"task\":\"" task "\"}"))

;; Refuse unexpected files, modes and symlinks in the independently pinned
;; head. This does not replace the host's protection against path aliases.
(defn- gh-head-tree? [dir :string rev :string] :bool
  (let [r (cp-git dir (str "ls-tree" (cp-a) "-r" (cp-a) rev))
        out (cp-out r) n (string-length out)
        blob (if (= n 63) (string-substring out 12 52) "")]
    (and (cp-ok? r) (cp-hex? blob 40)
         (= out (str "100644 blob " blob "\thead.json\n")))))

;; rev-parse REV^ alone only checks the first parent of a merge. A completed
;; advancement must have exactly one parent and that parent must be the
;; independently expected commit. Compare the complete parent listing.
(defn- gh-single-parent? [dir :string rev :string tip :string expected :string] :bool
  (if (or (not (cp-hex? tip 40)) (not (cp-hex? expected 40))) false
    (let [r (cp-git dir (str "rev-list" (cp-a) "--parents" (cp-a) "-n" (cp-a) "1" (cp-a) rev))]
      (and (cp-ok? r) (= (cp-out r) (str tip " " expected "\n"))))))

;; The operator must provision the initial ref and independently pin its full
;; commit ID and checkpoint. Each successor has one Git parent and an exact
;; expected checkpoint parent. A normal non-force push makes concurrent children
;; of the same expected commit mutually exclusive only while the remote ref is
;; monotonic and cannot be deleted or rewound by another principal. A normal
;; push is not an exact expected-OID CAS if the remote is rewound after fetch.
;; The host must independently enforce that policy and valid lease authority.
;; Archive verification occurs first. A verified readback of the exact new
;; commit is required even if the push returned success; a different or
;; unavailable head stays unknown.
(defn- gh-advance [work :string store :string cid :string author :string profile :string policy :string environment :string
                   epoch :i64 parent :string task :string repo :string gh :string expected :string] :string
  (cond (or (not (cp-safe-absolute? work)) (not (cp-safe-absolute? store))
            (ga-path-overlap? work store) (not (cp-safe-absolute? gh)) (not (ga-repo? repo))
            (not (cp-hex? expected 40)) (not (cp-raw? parent)) (not (cp-raw? cid))
            (not (ga-verified? store cid author profile policy environment epoch parent task))) "head/input-refused"
        (not (= (cp-fs "I" work "") "1")) "head/work-exists-or-unavailable"
        (not (= (cp-fs "H" work "700") "1")) "head/work-permissions"
        :else
        (let [archive (ga-archive (str work "/archive") store cid author profile policy environment epoch parent task repo gh)]
          (if (not (= (string-index-of archive (str "archive/stored " cid " ")) 0)) "head/archive-unconfirmed"
            (let [dir (str work "/head") ref (str "refs/heads/itonami/head/" (sha256-hex (cp-bytes task)))
                  remote (str "https://github.com/" repo ".git") old (gh-head-text task parent)
                  new (gh-head-text task cid) created (= (cp-fs "I" dir "") "1")
                  init (if created (cp-git dir "initARG_SEP--quietARG_SEP--template=") "refused")
                  fetched (if (and (cp-ok? init) (ga-config-safe? dir))
                            (ga-git dir (str "fetch" (cp-a) "--quiet" (cp-a) "--no-tags" (cp-a) remote (cp-a) ref)) "refused")
                  previous (if (cp-ok? fetched) (cp-git dir "rev-parseARG_SEPFETCH_HEAD") "refused")
                  shape (and (cp-ok? previous) (= (cp-line (cp-out previous)) expected) (gh-head-tree? dir "FETCH_HEAD"))
                  content (if shape (cp-git dir "showARG_SEPFETCH_HEAD:head.json") "refused")
                  checkout (if (and (cp-ok? content) (= (cp-out content) old))
                             (cp-git dir "checkoutARG_SEP--quietARG_SEP--detachARG_SEPFETCH_HEAD") "refused")
                  written (and (cp-ok? checkout) (cp-write (str dir "/head.json") (cp-bytes new)))
                  add (if written (cp-git dir "addARG_SEP--ARG_SEPhead.json") "refused")
                  commit (if (cp-ok? add) (cp-git dir "commitARG_SEP--quietARG_SEP-mARG_SEPAdvance checkpoint head") "refused")
                  tip-r (if (cp-ok? commit) (cp-git dir "rev-parseARG_SEPHEAD") "refused")
                  tip (cp-line (cp-out tip-r))
                  parent-ok (and (cp-ok? tip-r) (gh-single-parent? dir "HEAD" tip expected))]
              (if (not (and parent-ok
                            (gh-head-tree? dir "HEAD"))) "head/precondition-or-staging-refused"
                (let [push (ga-git dir (str "push" (cp-a) "--quiet" (cp-a) remote (cp-a) "HEAD:" ref))
                      check (str work "/check") made (= (cp-fs "I" check "") "1")
                      ci (if made (cp-git check "initARG_SEP--quietARG_SEP--template=") "refused")
                      cf (if (and (cp-ok? ci) (ga-config-safe? check))
                           (ga-git check (str "fetch" (cp-a) "--quiet" (cp-a) "--no-tags" (cp-a) remote (cp-a) ref)) "refused")
                      got (if (cp-ok? cf) (cp-git check "rev-parseARG_SEPFETCH_HEAD") "refused")
                      fsck (if (and (cp-ok? got) (= (cp-line (cp-out got)) tip))
                             (cp-git check "fsckARG_SEP--fullARG_SEP--strict") "refused")
                      readback (if (and (cp-ok? fsck) (gh-head-tree? check "FETCH_HEAD"))
                                 (cp-git check "showARG_SEPFETCH_HEAD:head.json") "refused")
                      back-parent (and (cp-ok? readback) (gh-single-parent? check "FETCH_HEAD" tip expected))]
                  (if (and back-parent (= (cp-out readback) new))
                    (str "head/advanced " cid " " tip " " (if (cp-ok? push) "acknowledged" "unacknowledged"))
                    "head/conflict-or-unknown"))))))))

(defn github-checkpoint-head-main [] :i64
  (let [result (gh-advance (cp-arg 0) (cp-arg 1) (cp-arg 2) (cp-arg 3) (cp-arg 4) (cp-arg 5) (cp-arg 6)
                           (cp-int (cp-arg 7)) (cp-arg 8) (cp-arg 9) (cp-arg 10) (cp-arg 11) (cp-arg 12))
        out (cp-say result)]
    (if (= (string-index-of result "head/advanced ") 0) 0 1)))

;; Read only a host-pinned head commit, then independently verify the archive
;; and signed closure using ga-restore. The commit pin must come from an
;; authority outside the Git ref; this function does not establish freshness,
;; lease ownership or permission to execute the restored data.
(defn- gh-restore [work :string dest :string expected :string task :string author :string profile :string
                   policy :string environment :string repo :string gh :string] :string
  (cond (or (not (cp-safe-absolute? work)) (not (cp-safe-absolute? dest))
            (ga-path-overlap? work dest) (ga-path-overlap? work (str dest ".partial"))
            (not (cp-safe-absolute? gh)) (not (ga-repo? repo)) (not (cp-hex? expected 40))
            (= task "") (not (= (field-problem task) "enroll/ok"))
            (= author "") (not (= (field-problem author) "enroll/ok"))
            (not (= (digest-problem profile) "oci/ok")) (not (cp-raw? policy)) (not (cp-raw? environment))
            (not (cp-absent? dest)) (not (cp-absent? (str dest ".partial"))) ) "head-restore/input-refused"
        (not (ga-private? gh repo)) "head-restore/private-repository-unverified"
        (not (= (cp-fs "I" work "") "1")) "head-restore/work-exists-or-unavailable"
        (not (= (cp-fs "H" work "700") "1")) "head-restore/work-permissions"
        :else
        (let [head (str work "/head") remote (str "https://github.com/" repo ".git")
              href (str "refs/heads/itonami/head/" (sha256-hex (cp-bytes task)))
              made (= (cp-fs "I" head "") "1")
              init (if made (cp-git head "initARG_SEP--quietARG_SEP--template=") "refused")
              fetch (if (and (cp-ok? init) (ga-config-safe? head))
                      (ga-git head (str "fetch" (cp-a) "--quiet" (cp-a) "--no-tags" (cp-a) remote (cp-a) href)) "refused")
              id (if (cp-ok? fetch) (cp-git head "rev-parseARG_SEPFETCH_HEAD") "refused")
              fsck (if (and (cp-ok? id) (= (cp-line (cp-out id)) expected) (gh-head-tree? head "FETCH_HEAD"))
                     (cp-git head "fsckARG_SEP--fullARG_SEP--strict") "refused")
              content (if (cp-ok? fsck) (cp-git head "showARG_SEPFETCH_HEAD:head.json") "refused")
              h (if (cp-ok? content) (cp-bytes (cp-out content)) (vector-alloc 0))
              cid (if (and (json-valid? h) (json-canonical? h) (= (json-kind h 0) 1) (= (json-count h 0) 3))
                    (cp-str h 0 "checkpoint") "")]
          (if (not (and (cp-raw? cid) (= (cp-text h) (gh-head-text task cid)))) "head-restore/head-refused"
            (let [meta (str work "/meta") aref (str "refs/heads/itonami/archive/" cid)
                  made-meta (= (cp-fs "I" meta "") "1")
                  mi (if made-meta (cp-git meta "initARG_SEP--quietARG_SEP--template=") "refused")
                  mf (if (and (cp-ok? mi) (ga-config-safe? meta))
                       (ga-git meta (str "fetch" (cp-a) "--quiet" (cp-a) "--no-tags" (cp-a) remote (cp-a) aref)) "refused")
                  mc (if (cp-ok? mf) (cp-git meta "fsckARG_SEP--fullARG_SEP--strict") "refused")
                  show (if (cp-ok? mc) (cp-git meta "showARG_SEPFETCH_HEAD:manifest.json") "refused")
                  m (if (cp-ok? show) (cp-bytes (cp-out show)) (vector-alloc 0))
                  valid (and (<= (vector-count m) 8192) (json-valid? m) (= (json-kind m 0) 1))
                  epoch (if valid (cp-num m 0 "epoch") -1)
                  parent (if valid (cp-str m 0 "parent") "")
                  manifest (cp-bytes (str "{\"author\":\"" author "\",\"environment\":\"" environment
                    "\",\"epoch\":" epoch ",\"kind\":\"itonami.github-checkpoint-archive/1\",\"parent\":\"" parent
                    "\",\"policy\":\"" policy "\",\"profile\":\"" profile "\",\"root\":\"" cid "\",\"task\":\"" task "\"}"))]
              (if (not (and valid (> epoch 0) (or (= parent "root") (cp-raw? parent)) (ga-manifest-matches? m manifest)))
                "head-restore/manifest-refused"
                (let [r (ga-restore (str work "/restore") dest cid author profile policy environment epoch parent task repo gh)
                      prefix (str "archive-restore/restored " cid " ")
                      tree (if (= (string-index-of r prefix) 0) (string-substring r (string-length prefix) (string-length r)) "")]
                  (if (cp-hex? tree 40) (str "head-restore/restored " cid " " expected " " tree)
                    "head-restore/archive-or-materialize-refused"))))))))

(defn github-checkpoint-head-restore-main [] :i64
  (let [result (gh-restore (cp-arg 0) (cp-arg 1) (cp-arg 2) (cp-arg 3) (cp-arg 4) (cp-arg 5)
                           (cp-arg 6) (cp-arg 7) (cp-arg 8) (cp-arg 9))
        out (cp-say result)]
    (if (= (string-index-of result "head-restore/restored ") 0) 0 1)))
