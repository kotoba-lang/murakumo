(ns dash-state-core
  (:export [short-hosted-cid health-class-of interval-sleep-ms clamp-at
            take-last-start append-new-len cap-count recent-take-n
            digit-char nat-str i64-str
            digit-val? digit-of parse-digits-go parse-digits trim-ws parse-links
            probe-line-key probe-line-value
            content-type-json content-type-html http-ok-status
            health-from-present health-ok-label health-down-label
            health-url mesh-log-path
            probe-h-prefix probe-l-clause probe-p-clause
            probe-command
            short-hosted-cid-max-len short-cid-max-len
            hosted-join-sep
            default-dashboard-port default-dashboard-interval
            default-dashboard-port-str default-dashboard-interval-str
            join-append hosted-append
            snapshot-record-type]))

;; W6 pure-planner oracle — murakumo.dash.state display / probe pure helpers.
;; Map/vector reducers (placements, selected-snapshot, render-html, probe-lines
;; fold, parse-hosted split) stay cljc.
;; parse-links: trim + digits → i64 (0 on empty/non-digit), matching host catch.
;; probe-line-key/value: H:/L:/P: line shape for probe-lines host fold.
;; probe-command shell string dual-source (compose pure fragments; SSH exec host).
;; dashboard defaults + hosted-join-sep dual-source for hosted-summary / CLI opts.
;; join-append / hosted-append: pure fold steps for hosted-summary; host still
;; walks hosted CID collections after short-hosted-cid projection.
;; snapshot-record-type: atproto $type / collection NSID for fleet snapshot records.
;; Parity: test/murakumo/dash_state_kotoba_parity_test.clj

(defn short-hosted-cid-max-len [] :i64 18)

(defn short-cid-max-len [] :i64 14)

(defn short-hosted-cid [cid :string] :string
  (let [n (string-byte-length cid)
        max (short-hosted-cid-max-len)
        end (if (< n max) n max)]
    (string-substring cid 0 end)))

(defn health-class-of [health :string] :string
  (if (string=? health "ok")
    "ok"
    "down"))

(defn interval-sleep-ms [seconds :i64] :i64
  (* 1000 seconds))

(defn clamp-at [requested-at :i64 history-count :i64] :i64
  ;; cljc: (min (max 0 (or requested-at 0)) (max 0 (dec history-count)))
  ;; Callers pass 0 for nil requested-at.
  (let [req (if (< requested-at 0) 0 requested-at)
        hi (if (< history-count 1) 0 (- history-count 1))]
    (if (< req hi) req hi)))

(defn take-last-start [len :i64 cap :i64] :i64
  ;; start index for (take-last cap items) on a seq of length len
  (if (< cap 1)
    len
    (let [s (- len cap)]
      (if (< s 0) 0 s))))

(defn append-new-len [len :i64 add :i64] :i64
  (if (< add 0) len (+ len add)))

(defn cap-count [len :i64 cap :i64] :i64
  ;; length after take-last cap
  (if (< cap 1)
    0
    (if (< len cap) len cap)))

(defn recent-take-n [n :i64 default-n :i64] :i64
  ;; cljc recent-alerts default 6
  (if (< n 0) default-n n))

;; ── digit / parse-links (tunnel_core pattern; 0 on bad for links) ─────

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn digit-val? [c :string] :bool
  (if (string=? c "0") true
    (if (string=? c "1") true
      (if (string=? c "2") true
        (if (string=? c "3") true
          (if (string=? c "4") true
            (if (string=? c "5") true
              (if (string=? c "6") true
                (if (string=? c "7") true
                  (if (string=? c "8") true
                    (if (string=? c "9") true false)))))))))))

(defn digit-of [c :string] :i64
  (if (string=? c "0") 0
    (if (string=? c "1") 1
      (if (string=? c "2") 2
        (if (string=? c "3") 3
          (if (string=? c "4") 4
            (if (string=? c "5") 5
              (if (string=? c "6") 6
                (if (string=? c "7") 7
                  (if (string=? c "8") 8
                    (if (string=? c "9") 9 0)))))))))))

(defn trim-ws [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (string=? (string-substring s 0 1) " ")
        (trim-ws (string-substring s 1 n))
        (if (string=? (string-substring s (- n 1) n) " ")
          (trim-ws (string-substring s 0 (- n 1)))
          s)))))

(defn parse-digits-go [s :string acc :i64] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      acc
      (let [c (string-substring s 0 1)]
        (if (digit-val? c)
          (parse-digits-go (string-substring s 1 n)
                           (+ (* acc 10) (digit-of c)))
          -1)))))

(defn parse-digits [s :string] :i64
  ;; -1 if empty or non-digit
  (let [t (trim-ws s)
        n (string-byte-length t)]
    (if (= n 0)
      -1
      (parse-digits-go t 0))))

(defn parse-links [s :string] :i64
  ;; cljc: (try (Integer/parseInt (trim (or s "0"))) (catch _ 0))
  ;; empty / non-digit → 0 (not -1)
  (let [raw (if (string=? s "") "0" s)
        n (parse-digits raw)]
    (if (< n 0) 0 n)))

(defn probe-line-key [line :string] :string
  ;; "H:..." → "H"; short or missing colon → ""
  (let [n (string-byte-length line)]
    (if (< n 2)
      ""
      (if (string=? (string-substring line 1 2) ":")
        (string-substring line 0 1)
        ""))))

(defn probe-line-value [line :string] :string
  (let [k (probe-line-key line)
        n (string-byte-length line)]
    (if (string=? k "")
      ""
      (string-substring line 2 n))))

(defn content-type-json [] :string "application/json")
(defn content-type-html [] :string "text/html; charset=utf-8")
(defn http-ok-status [] :i64 200)

(defn health-ok-label [] :string "ok")
(defn health-down-label [] :string "down")

(defn health-from-present [present :bool] :string
  ;; present true when health-json non-nil. Profile 5: real :bool.
  (if present
    (health-ok-label)
    (health-down-label)))

;; ── residual probe-command shell fragments ───────────────────────────

(defn mesh-log-path [] :string
  "~/.murakumo/mesh.log")

(defn health-url [port :i64] :string
  ;; http://localhost:{port}/health
  (string-concat
   "http://localhost:"
   (string-concat (i64-str port) "/health")))

(defn probe-h-prefix [] :string
  "echo \"H:$(curl -s -m4 ")

(defn probe-l-clause [] :string
  ;; "; echo \"L:$(grep 'peer connected' ~/.murakumo/mesh.log 2>/dev/null | …)\""
  (string-concat
   ")\"; echo \"L:$(grep 'peer connected' "
   (string-concat
    (mesh-log-path)
    " 2>/dev/null | grep -o '12D3[A-Za-z0-9]*' | sort -u | wc -l | tr -d ' ')\"")))

(defn probe-p-clause [] :string
  (string-concat
   "; echo \"P:$(grep 'trigger: executed' "
   (string-concat
    (mesh-log-path)
    " 2>/dev/null | grep -oE 'bafy[a-z0-9]{40,}' | sort -u | tr '\\n' ',')\"")))

(defn probe-command [port :i64] :string
  ;; Host-exec shell string for one dashboard probe round-trip.
  ;; Compose pure fragments; byte-stable with murakumo.dash.state mirror.
  (string-concat
   (probe-h-prefix)
   (string-concat
    (health-url port)
    (string-concat
     " 2>/dev/null"
     (string-concat (probe-l-clause) (probe-p-clause))))))

;; ── residual dashboard defaults + hosted-summary join ────────────────

(defn hosted-join-sep [] :string
  ;; space between short-hosted-cid in hosted-summary
  " ")

(defn default-dashboard-port [] :i64 8899)

(defn default-dashboard-interval [] :i64 15)

(defn default-dashboard-port-str [] :string
  ;; CLI default when port arg absent
  "8899")

(defn default-dashboard-interval-str [] :string
  ;; CLI default when interval arg absent
  "15")

;; ── residual hosted-summary join fold steps ──────────────────────────

(defn join-append [acc :string sep :string next :string] :string
  ;; empty acc ⇒ first item only (no leading sep)
  (if (string=? acc "")
    next
    (string-concat acc (string-concat sep next))))

(defn hosted-append [acc :string next :string] :string
  ;; host reduce over short-hosted-cid strings for hosted-summary
  (join-append acc (hosted-join-sep) next))

;; ── residual atproto collection / record $type ───────────────────────

(defn snapshot-record-type [] :string
  ;; $type + persist snapshot-collection NSID
  "com.murakumo.fleet.snapshot")
