;; Synthetic ADI2 records: these vectors do not authenticate a host.
(ns murakumo.fleet-flint-directory-inventory-test (:export [test-flint-directory-inventory test-flint-parent-frame]))

(defn test-flint-directory-inventory [] :bool
  (let [        root (str "41444932a40100007f000000000000007b000000000000000b00000000000000000000000000000024000b0008636f6e" "6669672e6a736f6e000000000c00000000000000000000000000000024000e0008746f6b656e697a65722e6a736f6e00" "0d0000000000000000000000000000002c00150008746f6b656e697a65725f636f6e6669672e6a736f6e00000e000000" "0000000000000000000000002c00130008636861745f74656d706c6174652e6a696e6a61000000000f00000000000000" "00000000000000002c0016000867656e65726174696f6e5f636f6e6669672e6a736f6e00100000000000000000000000" "0000000034001c00086d6f64656c2e7361666574656e736f72732e696e6465782e6a736f6e0000001100000000000000" "000000000000000028001100086d6f64656c2e7361666574656e736f7273000012000000000000000000000000000000" "2c00130008657870657274732e7361666574656e736f7273000000001300000000000000000000000000000020000800" "042e6b6170697473610000001400000000000000000000000000000018000100042e0000150000000000000000000000" "0000000018000200042e2e00\n")
        child (str "41444932540000007f000000000000007c000000000000000b00000000000000000000000000000024000d00086d616e" "69666573742e6a736f6e00000c00000000000000000000000000000018000100042e00000d0000000000000000000000" "0000000018000200042e2e00\n")
        receipt (str "41444932d40100007f000000000000007b000000000000000b00000000000000000000000000000024000b0008636f6e" "6669672e6a736f6e000000000c00000000000000000000000000000024000e0008746f6b656e697a65722e6a736f6e00" "0d0000000000000000000000000000002c00150008746f6b656e697a65725f636f6e6669672e6a736f6e00000e000000" "0000000000000000000000002c00130008636861745f74656d706c6174652e6a696e6a61000000000f00000000000000" "00000000000000002c0016000867656e65726174696f6e5f636f6e6669672e6a736f6e00100000000000000000000000" "0000000034001c00086d6f64656c2e7361666574656e736f72732e696e6465782e6a736f6e0000001100000000000000" "000000000000000028001100086d6f64656c2e7361666574656e736f7273000012000000000000000000000000000000" "2c00130008657870657274732e7361666574656e736f7273000000001300000000000000000000000000000020000800" "042e6b6170697473610000001400000000000000000000000000000018000100042e0000150000000000000000000000" "0000000018000200042e2e001600000000000000000000000000000030001800082e617761692d6d6f64656c2d726563" "656970742e6a736f6e000000\n")
        extra (str "41444932c40100007f000000000000007b000000000000000b00000000000000000000000000000024000b0008636f6e" "6669672e6a736f6e000000000c00000000000000000000000000000024000e0008746f6b656e697a65722e6a736f6e00" "0d0000000000000000000000000000002c00150008746f6b656e697a65725f636f6e6669672e6a736f6e00000e000000" "0000000000000000000000002c00130008636861745f74656d706c6174652e6a696e6a61000000000f00000000000000" "00000000000000002c0016000867656e65726174696f6e5f636f6e6669672e6a736f6e00100000000000000000000000" "0000000034001c00086d6f64656c2e7361666574656e736f72732e696e6465782e6a736f6e0000001100000000000000" "000000000000000028001100086d6f64656c2e7361666574656e736f7273000012000000000000000000000000000000" "2c00130008657870657274732e7361666574656e736f7273000000001300000000000000000000000000000020000800" "042e6b6170697473610000001400000000000000000000000000000018000100042e0000150000000000000000000000" "0000000018000200042e2e00160000000000000000000000000000002000070008756e6f776e656400000000\n")
        duplicate (str "41444932c80100007f000000000000007b000000000000000b00000000000000000000000000000024000b0008636f6e" "6669672e6a736f6e000000000c00000000000000000000000000000024000e0008746f6b656e697a65722e6a736f6e00" "0d0000000000000000000000000000002c00150008746f6b656e697a65725f636f6e6669672e6a736f6e00000e000000" "0000000000000000000000002c00130008636861745f74656d706c6174652e6a696e6a61000000000f00000000000000" "00000000000000002c0016000867656e65726174696f6e5f636f6e6669672e6a736f6e00100000000000000000000000" "0000000034001c00086d6f64656c2e7361666574656e736f72732e696e6465782e6a736f6e0000001100000000000000" "000000000000000028001100086d6f64656c2e7361666574656e736f7273000012000000000000000000000000000000" "2c00130008657870657274732e7361666574656e736f7273000000001300000000000000000000000000000020000800" "042e6b6170697473610000001400000000000000000000000000000018000100042e0000150000000000000000000000" "0000000018000200042e2e001600000000000000000000000000000024000b0008636f6e6669672e6a736f6e00000000" "\n")
        wrongtype (str "41444932a40100007f000000000000007b000000000000000b00000000000000000000000000000024000b000a636f6e" "6669672e6a736f6e000000000c00000000000000000000000000000024000e0008746f6b656e697a65722e6a736f6e00" "0d0000000000000000000000000000002c00150008746f6b656e697a65725f636f6e6669672e6a736f6e00000e000000" "0000000000000000000000002c00130008636861745f74656d706c6174652e6a696e6a61000000000f00000000000000" "00000000000000002c0016000867656e65726174696f6e5f636f6e6669672e6a736f6e00100000000000000000000000" "0000000034001c00086d6f64656c2e7361666574656e736f72732e696e6465782e6a736f6e0000001100000000000000" "000000000000000028001100086d6f64656c2e7361666574656e736f7273000012000000000000000000000000000000" "2c00130008657870657274732e7361666574656e736f7273000000001300000000000000000000000000000020000800" "042e6b6170697473610000001400000000000000000000000000000018000100042e0000150000000000000000000000" "0000000018000200042e2e00\n")
        missing (str "414449328c0100007f000000000000007b000000000000000b00000000000000000000000000000024000b0008636f6e" "6669672e6a736f6e000000000c00000000000000000000000000000024000e0008746f6b656e697a65722e6a736f6e00" "0d0000000000000000000000000000002c00150008746f6b656e697a65725f636f6e6669672e6a736f6e00000e000000" "0000000000000000000000002c00130008636861745f74656d706c6174652e6a696e6a61000000000f00000000000000" "00000000000000002c0016000867656e65726174696f6e5f636f6e6669672e6a736f6e00100000000000000000000000" "0000000034001c00086d6f64656c2e7361666574656e736f72732e696e6465782e6a736f6e0000001100000000000000" "000000000000000028001100086d6f64656c2e7361666574656e736f7273000012000000000000000000000000000000" "2c00130008657870657274732e7361666574656e736f7273000000001300000000000000000000000000000020000800" "042e6b6170697473610000001400000000000000000000000000000018000100042e0000\n")
        dev "7f00000000000000" root-ino "7b00000000000000" child-ino "7c00000000000000"]
    (and (flint-bound-inventory? root true false dev root-ino)
         (flint-bound-inventory? child false false dev child-ino)
         (flint-bound-inventory? receipt true true dev root-ino)
         (not (flint-bound-inventory? root true true dev root-ino))
         (not (flint-bound-inventory? receipt true false dev root-ino))
         (not (flint-bound-inventory? child false true dev child-ino))
         (not (flint-bound-inventory? extra true false dev root-ino))
         (not (flint-bound-inventory? duplicate true false dev root-ino))
         (not (flint-bound-inventory? wrongtype true false dev root-ino))
         (not (flint-bound-inventory? missing true false dev root-ino))
         (not (flint-bound-inventory? root true false dev child-ino)))))

(defn test-flint-parent-frame [] :bool
  (let [dev "7f00000000000000" root "7b00000000000000" child "7c00000000000000"
        frame (str "4144503100000000" dev root dev child "\n")]
    (and (flint-parent-frame? frame dev root dev child)
         (not (flint-parent-frame? frame dev root dev root))
         (not (flint-parent-frame? frame dev root "7e00000000000000" child))
         (not (flint-parent-frame? (str "4144503200000000" dev root dev child "\n") dev root dev child))
         (not (flint-parent-frame? (str "4144503101000000" dev root dev child "\n") dev root dev child))
         (not (flint-parent-frame? (str "4144503100000000" dev root dev child) dev root dev child)))))
