;; Validate a captured agent-step result before putting stdout in the existing
;; checkpoint block store. The expected DID/job are independent host pins;
;; neither a signature nor this block write is a live lease or archive grant.
;; Compose after fleet_job_node and git_checkpoint. The trusted host must own
;; both the capture tree and block store exclusively throughout this operation;
;; path-based metadata and reads do not bind against a concurrent replacement.
(ns murakumo.fleet-job-output (:export [job-output-main job-output-proof-verify-main]))

(defn- jo-once? [s :string key :string] :bool
  (let [line (str "\n" key " ") all (str "\n" s) i (string-index-of all line)]
    (and (>= i 0) (< (string-index-of (string-substring all (+ i (string-length line)) (string-length all)) line) 0))))

;; Strict unpadded base64url; re-encoding below rejects nonzero trailing bits.
(defn- jo-decode [s :string] :vector-i64
  (if (> (string-length s) 21846) (vector-alloc 0)
    (loop [i 0 acc 0 bits 0 out []]
      (if (= i (string-length s)) out
        (let [digit (string-index-of (en-b64) (string-substring s i (+ i 1)))]
          (if (< digit 0) (vector-alloc 0)
            (let [a (+ (* acc 64) digit) b (+ bits 6)]
              (if (>= b 8)
                (let [left (- b 8) v (u64-shift-right a left)]
                  (recur (+ i 1) (bit-and a (- (i64-shift-left 1 left) 1)) left (vector-conj out v)))
                (recur (+ i 1) a b out)))))))))

(defn- jo-verdict [log :string did :string job :string] :string
  (let [receipt (jn-line log "receipt ") sig (jn-line log "signature ")
        encoded (jn-line log "output-base64url ") b (jn-bytes receipt)
        output (jo-decode encoded) output-cid (cp-cid output)]
    (cond (or (not (jo-once? log "receipt")) (not (jo-once? log "signature"))
              (not (jo-once? log "output-base64url"))) "job-output/missing-or-duplicate"
          (or (not (= (did-key-problem did) "enroll/ok")) (not (jn-attempt-id? job))) "job-output/pins"
          (or (not (json-valid? b)) (not (json-canonical? b)) (not (= (json-kind b 0) 1))
              (not (= (json-count b 0) 8))) "job-output/receipt"
          (or (not (= (cp-str b 0 "kind") "itonami.agent-step-receipt/1"))
              (not (= (cp-str b 0 "did") did)) (not (= (cp-str b 0 "job") job))
              (not (= (cp-num b 0 "exit") 0)) (< (cp-num b 0 "at") 1)
              (< (cp-num b 0 "epoch") 1) (= (cp-str b 0 "node") "")) "job-output/binding"
          (not (= (statement-problem did receipt sig) "enroll/ok")) "job-output/signature"
          (or (> (vector-count output) 16384) (not (= (en-b64-encode output) encoded))
              (not (= (cp-str b 0 "output") output-cid))) "job-output/content"
          :else "job-output/verified")))

;; Bound existing block reads before cp-write can do any whole-file read.
;; Exclusive ownership is required: size rechecks alone do not prevent races.
(defn- jo-put [store :string b :vector-i64] :string
  (let [cid (cp-cid b) path (str store "/" cid) exists (cp-fs "D" path "")
        size (if (= exists "1") (cp-size path) -1)
        prior (if (and (= exists "1") (>= size 0) (<= size 16384)) (cp-range path 0 size) (vector-alloc 0))
        good (cond (> (vector-count b) 16384) false
                   (= exists "0") (cp-write path b)
                   (= exists "1") (and (= size (vector-count b)) (= (vector-count prior) size)
                                        (= (cp-size path) size) (= (cp-cid prior) cid))
                   :else false)]
    ;; A matching pre-existing block may be a visible but unsynced remnant of
    ;; an interrupted writer. Sync the file itself before syncing its parent.
    (if (and (<= (vector-count b) 16384) good (= (cp-fs "M" path "") "1")
             (= (cp-fs "M" store "") "1")) cid "")))

(defn job-output-main [] :i64
  (let [logpath (jn-arg 0) did (jn-arg 1) job (jn-arg 2) store (jn-arg 3)
        size (if (jn-attempt-root? logpath) (cp-size logpath) -1)]
    (if (or (not (jn-attempt-root? store)) (not (jn-private-dir? store)) (< size 1) (> size 65536))
      (let [x (jn-say "job-output/config-refused")] 2)
      (let [raw (cp-range logpath 0 size)
            log (cp-text raw)
            verdict (if (and (= (vector-count raw) size) (= (cp-size logpath) size))
                      (jo-verdict log did job) "job-output/read-unknown")]
        (if (not (= verdict "job-output/verified")) (let [x (jn-say verdict)] 1)
          (let [bytes (jo-decode (jn-line log "output-base64url ")) cid (jo-put store bytes)
                receipt (jn-line log "receipt ") sig (jn-line log "signature ")
                proof (cp-bytes (str "{\"kind\":\"itonami.job-output-proof/1\",\"receipt\":" receipt
                                     ",\"signature\":\"" sig "\"}"))
                proof-cid (if (= cid "") "" (jo-put store proof))]
            ;; Both blocks must be synchronized before returning either CID.
            ;; An unknown partial write stays in the private store for host
            ;; reconciliation, never treated as a published checkpoint.
            (if (= proof-cid "") (let [x (jn-say "job-output/store-unknown")] 1)
              (jn-say (str "job-output/stored " cid " " proof-cid)))))))))

;; Re-verify host-pinned proof and output after a separate restore. This proves
;; their signature and CID binding only; a host must still establish the
;; live lease and independently verify the checkpoint/archive readback.
(defn- jo-block [store :string cid :string] :vector-i64
  (let [path (str store "/" cid) size (if (cp-raw? cid) (cp-size path) -1)
        bytes (if (and (>= size 0) (<= size 16384)) (cp-range path 0 size) (vector-alloc 0))]
    (if (and (>= size 0) (<= size 16384) (= (vector-count bytes) size)
             (= (cp-size path) size) (= (cp-cid bytes) cid)) bytes (vector-alloc 0))))

(defn- jo-block? [store :string cid :string bytes :vector-i64] :bool
  (let [size (if (cp-raw? cid) (cp-size (str store "/" cid)) -1)]
    (and (>= size 0) (<= size 16384) (= size (vector-count bytes)) (= (cp-cid bytes) cid))))

(defn- jo-proof-verdict [proof :vector-i64 output :vector-i64 did :string job :string] :string
  (let [receipt-index (if (json-valid? proof) (json-member proof 0 "receipt") -1)
        valid (and (> (vector-count proof) 0) (json-canonical? proof)
                   (= (json-kind proof 0) 1) (= (json-count proof 0) 3)
                   (= (cp-str proof 0 "kind") "itonami.job-output-proof/1")
                   (>= receipt-index 0) (= (json-kind proof receipt-index) 1))
        receipt (if valid (cp-json proof receipt-index) "")
        sig (if valid (cp-str proof 0 "signature") "")
        log (str "receipt " receipt "\nsignature " sig "\noutput-base64url " (en-b64-encode output) "\n")]
    (if valid (jo-verdict log did job) "job-output/proof-invalid")))

(defn job-output-proof-verify-main [] :i64
  (let [store (jn-arg 0) output-cid (jn-arg 1) proof-cid (jn-arg 2) did (jn-arg 3) job (jn-arg 4)]
    (if (or (not (jn-attempt-root? store)) (not (jn-private-dir? store))
            (not (cp-raw? output-cid)) (not (cp-raw? proof-cid)))
      (let [x (jn-say "job-output/proof-config-refused")] 2)
      (let [proof (jo-block store proof-cid) output (jo-block store output-cid)
            valid (and (jo-block? store proof-cid proof) (jo-block? store output-cid output))
            verdict (if valid (jo-proof-verdict proof output did job) "job-output/proof-invalid")]
        (if (= verdict "job-output/verified")
          (let [x (jn-say "job-output/proof-verified")] 0)
          (let [x (jn-say verdict)] 1))))))
