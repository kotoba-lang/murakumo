;; Experimental native staging for a pinned, uncompressed USTAR asset blob.
;; Compose after sha2.core, fleet_oci_layout and fleet_model_digest. The host
;; supplies an exclusive private directory and prevents path aliases/writers.
;; Failure leaves a private incomplete directory for explicit reconciliation.
(ns murakumo.fleet-model-assets (:export [model-assets-stage-main model-artifact-stage-main model-artifact-publish-main model-artifact-recover-main]))

(defn- ta-fs [op :string path :string tail :string] :string
  (let [r (typed-cap-call 35 :string :string (ol-frame op path tail))]
    (if (and (>= (string-byte-length r) 5) (= (string-substring r 0 5) "\u0000FS2\u0000"))
      (string-substring r 5 (string-length r)) "")))
(defn- ta-parent [p :string] :string
  (loop [i (- (string-length p) 1)]
    (if (< i 1) "/" (if (= (string-substring p i (+ i 1)) "/") (string-substring p 0 i) (recur (- i 1))))))
(defn- ta-trim-slash [p :string] :string
  (let [n (string-length p)]
    (if (and (> n 1) (= (string-substring p (- n 1) n) "/")) (string-substring p 0 (- n 1)) p)))
(defn- ta-overlap? [a :string b :string] :bool
  ;; The path validator permits a trailing slash. Normalize it before
  ;; comparing directory boundaries so /layout/ cannot contain /layout/out
  ;; while being treated as a separate tree. Callers still exclude aliases.
  (let [x (ta-trim-slash a) y (ta-trim-slash b)]
    (or (= x "") (= y "") (= x "/") (= y "/") (= x y)
        (= (string-index-of x (str y "/")) 0) (= (string-index-of y (str x "/")) 0))))
(defn- ta-read [path :string offset :i64 count :i64] :vector-i64
  (let [r (typed-cap-call 35 :string :bytes (ol-frame "E" path (str (ol-dec offset) ":" (ol-dec count))))]
    (if (and (= (bytes-count r) (+ count 5)) (= (bytes-at r 0) 0) (= (bytes-at r 1) 70)
             (= (bytes-at r 2) 83) (= (bytes-at r 3) 50) (= (bytes-at r 4) 0))
      (vector-i64-from-bytes (bytes-slice r 5 (+ count 5))) (vector-alloc 0))))

;; B/C replies must echo every written byte. FS2 operates in the private host
;; scope; arbitrary guests do not acquire this authority.
(defn- ta-write [path :string data :vector-i64 count :i64 first :bool] :bool
  (let [prefix (vector-i64-from-bytes (string-to-utf8 (ol-frame (if first "B" "C") path "")))
        n (vector-count prefix)
        body (loop [i 0 out (vector-alloc (+ n count))]
               (if (= i (+ n count)) out
                 (recur (+ i 1) (vector-assoc! out i (if (< i n) (vector-at prefix i) (vector-at data (- i n)))))))
        r (typed-cap-call 35 :bytes :bytes (bytes-from-vector-i64 body))]
    (and (= (bytes-count r) (+ count 5)) (= (bytes-at r 0) 0) (= (bytes-at r 1) 70)
         (= (bytes-at r 2) 83) (= (bytes-at r 3) 50) (= (bytes-at r 4) 0)
         (loop [i 0] (if (= i count) true
           (and (= (bytes-at r (+ i 5)) (vector-at data i)) (recur (+ i 1))))))))

(defn- ta-zero? [b :vector-i64 start :i64 end :i64] :bool
  (loop [i start] (if (= i end) true (and (= (vector-at b i) 0) (recur (+ i 1))))))
(defn- ta-name? [b :vector-i64 s :string] :bool
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (and (< n 100) (loop [i 0]
      (if (= i 100) true
        (and (= (vector-at b i) (if (< i n) (vector-at v i) 0)) (recur (+ i 1))))))))
(defn- ta-name [id :i64] :string
  (case id 0 "config.json" 1 "tokenizer.json" 2 "tokenizer_config.json" 3 "chat_template.jinja"
    4 "hadamard.json" 5 "mtplx_runtime.json" 6 "model.safetensors.index.json" 7 "MTPLX_PACK_MANIFEST.json"
    8 "generation_config.json" 9 "preprocessor_config.json" 10 "processor_config.json"
    11 "video_preprocessor_config.json" 12 "LICENSE" 13 "NOTICE.txt" 14 "README.md" ""))
(defn- ta-id [b :vector-i64] :i64
  (loop [i 0] (if (= i 15) -1 (if (ta-name? b (ta-name i)) i (recur (+ i 1))))))

;; Strict octal field; reject base-256, overflow and digits after a terminator.
(defn- ta-octal [b :vector-i64 start :i64 end :i64] :i64
  (loop [i start value 0 seen false ended false]
    (if (= i end) (if seen value -1)
      (let [c (vector-at b i)]
        (cond (or (= c 0) (= c 32)) (recur (+ i 1) value seen (or ended seen))
              (or ended (< c 48) (> c 55) (> value (quot (- 67108864 (- c 48)) 8))) -1
              :else (recur (+ i 1) (+ (* value 8) (- c 48)) true false))))))
(defn- ta-checksum [b :vector-i64] :i64
  (loop [i 0 sum 0]
    (if (= i 512) sum
      (recur (+ i 1) (+ sum (if (and (>= i 148) (< i 156)) 32 (vector-at b i)))))))
(defn- ta-header? [b :vector-i64] :bool
  (and (= (vector-count b) 512) (= (vector-at b 257) 117) (= (vector-at b 258) 115)
       (= (vector-at b 259) 116) (= (vector-at b 260) 97) (= (vector-at b 261) 114)
       (= (vector-at b 262) 0) (= (vector-at b 263) 48) (= (vector-at b 264) 48)
       (or (= (vector-at b 156) 48) (= (vector-at b 156) 0))
       (ta-zero? b 157 257) (ta-zero? b 345 500)
       (= (ta-octal b 148 156) (ta-checksum b))))

;; File data is hashed exactly as read, including zero padding, then written
;; to the private stage. A hash failure never yields a successful stage.
(defn- ta-file [source :string stage :string start :i64 size :i64 work :vector-i64 k :vector-i64] :bool
  (let [padded (* (quot (+ size 511) 512) 512)]
    (loop [offset 0 first true]
      (if (= offset padded)
        (and (= (ta-fs "H" stage "600") "1") (= (ta-fs "M" stage "") "1"))
        (let [count (if (> (- padded offset) 65536) 65536 (- padded offset))
              useful (if (> (- size offset) count) count (if (> (- size offset) 0) (- size offset) 0))
              ok (arena-scope
                   (let [data (ta-read source (+ start offset) count)]
                     (and (= (vector-count data) count) (ta-zero? data useful count)
                          (md-blocks work data count k)
                          (if (> useful 0) (ta-write stage data useful first) true))))]
          (and ok (recur (+ offset count) (if (> useful 0) false first))))))))

(defn- ta-walk [source :string stage :string size :i64 work :vector-i64] :bool
  (let [k (s2-k) summary (vector-alloc 3)]
    (loop [offset 0 seen 0 zeros 0]
      (if (= offset size)
        (and (>= zeros 2) (= (bit-and seen 255) 255) (md-pad work (vector-alloc 0) 0 0 size k))
        (let [read-ok (arena-scope
                        (let [header (ta-read source offset 512)]
                          (if (not (= (vector-count header) 512)) false
                            (let [hashed (md-blocks work header 512 k)
                                  zero (ta-zero? header 0 512)
                                  id (if zero -1 (ta-id header)) n (if zero 0 (ta-octal header 124 136))
                                  valid (or zero (ta-header? header))
                                  a (vector-assoc! summary 0 (if zero 0 1))
                                  b (vector-assoc! summary 1 id) c (vector-assoc! summary 2 n)]
                              (and hashed valid)))))
              zero (= (vector-at summary 0) 0) id (vector-at summary 1) n (vector-at summary 2)
              padded (if (and (> n 0) (<= n 16777216)) (* (quot (+ n 511) 512) 512) -1)
              next (+ offset 512 padded)]
          (cond (not read-ok) false
                zero (recur (+ offset 512) seen (+ zeros 1))
                (or (> zeros 0) (< id 0) (< padded 0) (> next size)
                    (not (= (bit-and seen (i64-shift-left 1 id)) 0))) false
                (ta-file source (str stage "/" (ta-name id)) (+ offset 512) n work k)
                (recur next (bit-or seen (i64-shift-left 1 id)) 0)
                :else false))))))

(defn- ta-stage [source :string stage :string digest :string size :i64] :string
  (let [entry (if (md-path? source) (typed-cap-call 35 :string :string (ol-frame "O" source "")) "")
        meta (if (and (md-regular? entry) (= (ol-size entry 67108864) size))
               (typed-cap-call 35 :string :string (ol-frame "F" source "")) "")]
    (if (or (not (md-path? source)) (not (md-path? stage))
            (= (string-substring stage (- (string-length stage) 1) (string-length stage)) "/")
            (ta-overlap? source stage)
            (not (= (digest-problem digest) "oci/ok")) (< size 1024) (> size 67108864) (not (= (rem size 512) 0))
            (not (md-regular? entry)) (not (= (ol-size entry 67108864) size))
            (not (md-regular? meta)) (not (= (ol-size meta 67108864) size)) (not (= (ta-fs "D" stage "") "0")))
      "assets/input-refused"
      (if (not (and (= (ta-fs "I" stage "") "1") (= (ta-fs "H" stage "700") "1")
                    (= (ta-fs "M" (ta-parent stage) "") "1")))
        "assets/staging-unknown"
        (let [work (s2-work (s2-iv 8)) ok (ta-walk source stage size work)
              after (typed-cap-call 35 :string :string (ol-frame "F" source ""))
              actual (if ok (str "sha256:" (hex (s2-out work 8))) "")
              result (if (and ok (= after meta) (= actual digest) (= (ta-fs "M" stage "") "1"))
                       "assets/staged" "assets/staging-unknown")]
          result)))))

(defn model-assets-stage-main [] :i64
  (let [result (if (= (md-arg 4) "") (ta-stage (md-arg 0) (md-arg 1) (md-arg 2) (md-decimal (md-arg 3))) "assets/input-refused")
        x (md-out result)]
    (if (= result "assets/staged") 0 (if (= result "assets/input-refused") 2 1))))

;; Copy and hash the exact same chunks, including the final SHA-256 padding.
;; This makes a completed stage reflect the pinned bytes without reading the
;; large source twice. It does not seal the destination after this function.
(defn- tw-copy [source :string dest :string digest :string size :i64] :bool
  (let [entry (if (md-path? source) (typed-cap-call 35 :string :string (ol-frame "O" source "")) "")
        meta (if (and (md-regular? entry) (= (ol-size entry 17179869184) size))
               (typed-cap-call 35 :string :string (ol-frame "F" source "")) "")]
    (if (or (not (md-path? dest)) (not (md-regular? meta)) (not (= (ol-size meta 17179869184) size))
            (< size 1) (> size 17179869184) (not (= (ta-fs "D" dest "") "0"))) false
      (let [work (s2-work (s2-iv 8)) k (s2-k)
            copied (loop [offset 0]
                     (if (= offset size) true
                       (let [remaining (- size offset) count (if (> remaining 65536) 65536 remaining)
                             last (= (+ offset count) size)
                             ok (arena-scope
                                  (let [data (ta-read source offset count) whole (* (quot count 64) 64)]
                                    (and (= (vector-count data) count) (md-blocks work data whole k)
                                         (if last (md-pad work data whole (- count whole) size k) true)
                                         (ta-write dest data count (= offset 0)))))]
                         (and ok (recur (+ offset count))))))
            after (typed-cap-call 35 :string :string (ol-frame "F" source ""))
            actual (if copied (str "sha256:" (hex (s2-out work 8))) "")]
        (and copied (= meta after) (= actual digest)
             (= (ta-fs "H" dest "600") "1") (= (ta-fs "M" dest "") "1"))))))

;; The pinned OCI manifest and asset layer are checked before any directory
;; is created. Each weight is then copied and hashed once into the stage.
;; The caller owns/isolates the layout and the target throughout this flow.
(defn- ma-stage-checked [layout :string base :string base-size :i64 mtp :string mtp-size :i64
                        assets :string size :i64 stage :string] :string
  (let [staged (ta-stage (ol-blob-path layout assets) stage assets size)]
    (if (not (= staged "assets/staged")) staged
      (if (and (tw-copy (ol-blob-path layout base) (str stage "/model.safetensors") base base-size)
               (tw-copy (ol-blob-path layout mtp) (str stage "/mtp.safetensors") mtp mtp-size)
               (= (ta-fs "M" stage "") "1"))
        "model-artifact/staged" "model-artifact/staging-unknown"))))

(defn model-artifact-stage-main [] :i64
  (let [layout (md-arg 0) base (md-arg 3) base-size (md-decimal (md-arg 4))
        mtp (md-arg 5) mtp-size (md-decimal (md-arg 6)) assets (md-arg 7) size (md-decimal (md-arg 8)) stage (md-arg 9)
        result (if (or (not (= (md-arg 10) "")) (not (md-path? layout)) (not (md-path? stage))
                       (= (string-substring stage (- (string-length stage) 1) (string-length stage)) "/")
                       (ta-overlap? layout stage) (< size 1024) (> size 67108864) (not (= (rem size 512) 0))
                       (not (= (ta-fs "D" stage "") "0"))) "model-artifact/input-refused"
                 (let [checked (ma-check layout (md-arg 1) (md-decimal (md-arg 2))
                                         base base-size mtp mtp-size assets size false)]
                   (if (not (= checked "model-artifact/descriptors-observed")) checked
                     (ma-stage-checked layout base base-size mtp mtp-size assets size stage))))
        x (md-out result)]
    (if (= result "model-artifact/staged") 0 1)))

;; A private local publication journal. Intent must be durable before stage
;; creation; T is a host-provided atomic no-replace rename, not an emulation
;; using D followed by replacing rename. Any uncertainty stops for reconciliation.
(defn- mp-save [path :string value :string] :bool
  (let [b (vector-i64-from-bytes (string-to-utf8 value))]
    (and (= (ta-fs "D" path "") "0") (ta-write path b (vector-count b) true)
         (= (ta-fs "H" path "600") "1") (= (ta-fs "M" path "") "1"))))

(defn- mp-intent [manifest :string stage :string dest :string] :string
  (str "awai-model-publish/1\n" manifest "\n" stage "\n" dest "\n"))
(defn- mp-receipt [manifest :string manifest-size :i64 base :string base-size :i64 mtp :string mtp-size :i64
                  assets :string size :i64] :string
  (str "{\"assets\":\"" assets "\",\"assetsSize\":" size
       ",\"base\":\"" base "\",\"baseSize\":" base-size
       ",\"kind\":\"awai.model-stage-receipt/1\",\"manifest\":\"" manifest
       "\",\"manifestSize\":" manifest-size ",\"mtp\":\"" mtp "\",\"mtpSize\":" mtp-size "}"))

(defn model-artifact-publish-main [] :i64
  (let [layout (md-arg 0) manifest (md-arg 1) manifest-size (md-decimal (md-arg 2))
        base (md-arg 3) base-size (md-decimal (md-arg 4)) mtp (md-arg 5) mtp-size (md-decimal (md-arg 6))
        assets (md-arg 7) size (md-decimal (md-arg 8)) stage (md-arg 9) dest (md-arg 10)
        intent (str dest ".intent") done (str dest ".complete")
        valid (and (= (md-arg 11) "") (md-path? layout) (md-path? stage) (md-path? dest)
                   (md-path? intent) (md-path? done)
                   (not (= (string-substring stage (- (string-length stage) 1) (string-length stage)) "/"))
                   (not (= (string-substring dest (- (string-length dest) 1) (string-length dest)) "/"))
                   (= (ta-parent stage) (ta-parent dest))
                   (not (ta-overlap? layout stage)) (not (ta-overlap? layout dest))
                   (not (ta-overlap? layout intent)) (not (ta-overlap? layout done))
                   (not (ta-overlap? stage dest)) (not (ta-overlap? stage intent)) (not (ta-overlap? stage done))
                   (>= size 1024) (<= size 67108864) (= (rem size 512) 0)
                   (= (ta-fs "D" stage "") "0") (= (ta-fs "D" dest "") "0")
                   (= (ta-fs "D" intent "") "0") (= (ta-fs "D" done "") "0"))
        checked (if valid (ma-check layout manifest manifest-size base base-size mtp mtp-size assets size false)
                  "model-artifact/input-refused")
        result (if (not (= checked "model-artifact/descriptors-observed")) checked
                 (let [intent-body (mp-intent manifest stage dest)
                       prepared (and (mp-save intent intent-body) (= (ta-fs "M" (ta-parent dest) "") "1"))]
                   (if (not prepared) "model-artifact/publication-unknown"
                     (let [staged (ma-stage-checked layout base base-size mtp mtp-size assets size stage)
                           receipt (mp-receipt manifest manifest-size base base-size mtp mtp-size assets size)]
                       (if (and (= staged "model-artifact/staged")
                                (mp-save (str stage "/.awai-model-receipt.json") receipt)
                                (= (ta-fs "M" stage "") "1")
                                (= (ta-fs "T" stage dest) "1")
                                (= (ta-fs "M" (ta-parent dest) "") "1")
                                (= (ta-fs "T" intent done) "1")
                                (= (ta-fs "M" (ta-parent dest) "") "1"))
                         "model-artifact/published" "model-artifact/publication-unknown")))))
        x (md-out result)]
    (if (= result "model-artifact/published") 0 1)))

;; Recovery checks only a completed rename, never copies or dispatches work.
;; It cannot enumerate arbitrary extra directory entries. The host must keep
;; the directory private and exclude writers, aliases and unknown entries for
;; its entire lifetime, including across a crash. This is not loader approval.
(defn- mp-mode? [path :string mode :string kind :string] :bool
  (let [meta (ta-fs "U" path "") n (string-length meta) space (string-index-of meta " ")]
    (and (> space 0) (>= n 2) (= (string-substring meta 0 space) mode)
         (= (string-substring meta (- n 2) n) (str " " kind)))))
(defn- mp-exact? [path :string text :string] :bool
  (let [actual (ma-read path 2048) expected (vector-i64-from-bytes (string-to-utf8 text))
        n (vector-count expected)]
    (and (mp-mode? path "384" "0") (ol-read-ok? actual) (= (vector-count actual) n)
         (loop [i 0] (if (= i n) true (and (= (vector-at actual i) (vector-at expected i)) (recur (+ i 1))))))))

(defn- tv-file [source :string dest :string start :i64 size :i64 work :vector-i64 k :vector-i64] :bool
  (let [padded (* (quot (+ size 511) 512) 512)
        entry (if (md-path? dest) (typed-cap-call 35 :string :string (ol-frame "O" dest "")) "")
        before (if (and (md-regular? entry) (= (ol-size entry 16777216) size) (mp-mode? dest "384" "0"))
                 (typed-cap-call 35 :string :string (ol-frame "F" dest "")) "")]
    (if (or (not (md-regular? before)) (not (= (ol-size before 16777216) size))) false
      (let [ok (loop [offset 0]
                 (if (= offset padded) true
                   (let [count (if (> (- padded offset) 65536) 65536 (- padded offset))
                         useful (if (> (- size offset) count) count (if (> (- size offset) 0) (- size offset) 0))
                         same (arena-scope
                                (let [src (ta-read source (+ start offset) count)
                                      out (if (> useful 0) (ta-read dest offset useful) (vector-alloc 0))]
                                  (and (= (vector-count src) count) (= (vector-count out) useful)
                                       (ta-zero? src useful count) (md-blocks work src count k)
                                       (loop [i 0] (if (= i useful) true
                                         (and (= (vector-at src i) (vector-at out i)) (recur (+ i 1))))))))]
                     (and same (recur (+ offset count))))))
            after (typed-cap-call 35 :string :string (ol-frame "F" dest ""))]
        (and ok (= before after) (= (ta-fs "M" dest "") "1"))))))

;; Return the asset mask only after the full archive digest and every staged
;; asset match. -1 is failure; a host must still bind directory identity and
;; its independently obtained inventory to this same private scope.
(defn- tv-walk-mask [source :string dest :string size :i64 digest :string] :i64
  (let [work (s2-work (s2-iv 8)) k (s2-k) summary (vector-alloc 3)]
    (loop [offset 0 seen 0 zeros 0]
      (if (= offset size)
        (if (and (>= zeros 2) (= (bit-and seen 255) 255)
                 (loop [i 0] (if (= i 15) true
                   (and (or (not (= (bit-and seen (i64-shift-left 1 i)) 0))
                            (= (ta-fs "D" (str dest "/" (ta-name i)) "") "0")) (recur (+ i 1)))))
                 (md-pad work (vector-alloc 0) 0 0 size k)
                 (= (str "sha256:" (hex (s2-out work 8))) digest)) seen -1)
        (let [read-ok (arena-scope
                        (let [header (ta-read source offset 512)]
                          (if (not (= (vector-count header) 512)) false
                            (let [hashed (md-blocks work header 512 k) zero (ta-zero? header 0 512)
                                  id (if zero -1 (ta-id header)) n (if zero 0 (ta-octal header 124 136))
                                  valid (or zero (ta-header? header))
                                  a (vector-assoc! summary 0 (if zero 0 1))
                                  b (vector-assoc! summary 1 id) c (vector-assoc! summary 2 n)]
                              (and hashed valid)))))
              zero (= (vector-at summary 0) 0) id (vector-at summary 1) n (vector-at summary 2)
              padded (if (and (> n 0) (<= n 16777216)) (* (quot (+ n 511) 512) 512) -1)
              next (+ offset 512 padded)]
          (cond (not read-ok) -1
                zero (recur (+ offset 512) seen (+ zeros 1))
                (or (> zeros 0) (< id 0) (< padded 0) (> next size)
                    (not (= (bit-and seen (i64-shift-left 1 id)) 0))) -1
                (tv-file source (str dest "/" (ta-name id)) (+ offset 512) n work k)
                (recur next (bit-or seen (i64-shift-left 1 id)) 0)
                :else -1))))))


(defn- tv-walk [source :string dest :string size :i64 digest :string] :bool
  (>= (tv-walk-mask source dest size digest) 0))

(defn model-artifact-recover-main [] :i64
  (let [layout (md-arg 0) manifest (md-arg 1) manifest-size (md-decimal (md-arg 2))
        base (md-arg 3) base-size (md-decimal (md-arg 4)) mtp (md-arg 5) mtp-size (md-decimal (md-arg 6))
        assets (md-arg 7) size (md-decimal (md-arg 8)) stage (md-arg 9) dest (md-arg 10)
        intent (str dest ".intent") done (str dest ".complete")
        valid (and (= (md-arg 11) "") (md-path? layout) (md-path? stage) (md-path? dest)
                   (md-path? intent) (md-path? done)
                   (not (= (string-substring stage (- (string-length stage) 1) (string-length stage)) "/"))
                   (not (= (string-substring dest (- (string-length dest) 1) (string-length dest)) "/"))
                   (= (ta-parent stage) (ta-parent dest))
                   (not (ta-overlap? layout stage)) (not (ta-overlap? layout dest))
                   (not (ta-overlap? layout intent)) (not (ta-overlap? layout done))
                   (not (ta-overlap? stage dest)) (not (ta-overlap? stage intent)) (not (ta-overlap? stage done))
                   (>= size 1024) (<= size 67108864) (= (rem size 512) 0)
                   (= (ta-fs "D" stage "") "0") (= (ta-fs "D" dest "") "1"))
        is (if valid (ta-fs "D" intent "") "?") ds (if valid (ta-fs "D" done "") "?")
        marker (if (and (= is "1") (= ds "0")) intent (if (and (= is "0") (= ds "1")) done ""))
        expected-intent (mp-intent manifest stage dest)
        receipt (mp-receipt manifest manifest-size base base-size mtp mtp-size assets size)
        preflight (and valid (not (= marker "")) (mp-mode? dest "448" "1") (mp-exact? marker expected-intent)
                       (mp-exact? (str dest "/.awai-model-receipt.json") receipt))
        checked (if preflight (ma-check layout manifest manifest-size base base-size mtp mtp-size assets size false) "")
        result (if (not (= checked "model-artifact/descriptors-observed")) "model-artifact/recovery-unknown"
                 (let [base-path (str dest "/model.safetensors") mtp-path (str dest "/mtp.safetensors")
                       asset-path (ol-blob-path layout assets)
                       verified (and (mp-mode? base-path "384" "0") (mp-mode? mtp-path "384" "0")
                                     (= (md-observe base-path base base-size) "model/digest-observed")
                                     (= (md-observe mtp-path mtp mtp-size) "model/digest-observed")
                                     (= (ta-fs "M" base-path "") "1") (= (ta-fs "M" mtp-path "") "1")
                                     (tv-walk asset-path dest size assets) (= (ta-fs "M" (str dest "/.awai-model-receipt.json") "") "1")
                                     (= (ta-fs "M" dest "") "1") (= (ta-fs "M" (ta-parent dest) "") "1"))]
                   (if (not verified) "model-artifact/recovery-unknown"
                     (if (= marker intent)
                       (if (and (= (ta-fs "T" intent done) "1") (= (ta-fs "M" (ta-parent dest) "") "1"))
                         "model-artifact/recovered" "model-artifact/recovery-unknown")
                       (if (and (= (ta-fs "M" done "") "1") (= (ta-fs "M" (ta-parent dest) "") "1"))
                         "model-artifact/recovered" "model-artifact/recovery-unknown")))))
        x (md-out result)]
    (if (= result "model-artifact/recovered") 0 1)))
