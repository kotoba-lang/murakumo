(ns infer-plan-core
  (:schemas {;; T5.2 native guest record wire: multi-scalar node/strategy inputs.
             :plan/node-cap [:record :plan/node-cap
                             [[:mem :i64] [:os :i64] [:head :i64]
                              [:wired [:option :i64]]]]
             :plan/strategy-in [:record :plan/strategy-in
                                [[:link-gbps :i64] [:ranks :i64]
                                 [:experts :i64] [:kv-heads :i64]]]
             :plan/model [:record :plan/model
                          [[:layers :i64] [:dense :i64] [:frac-milli :i64]]]
             ;; one assignment row: span of layers + whether it fits its node
             :plan/row [:record :plan/row [[:span :i64] [:fits :i64]]]
             ;; partition fold state. `:at` is the layer boundary — the previous
             ;; cut on the way in, the new cut on the way out — so one record
             ;; serves both directions of the host fold.
             :plan/cut [:record :plan/cut [[:at :i64] [:acc :i64]]]
             ;; exclusive layer ends for a 2- or 3-node ring (hi2 is 0 for 2)
             :plan/ends [:record :plan/ends [[:hi0 :i64] [:hi1 :i64] [:hi2 :i64]]]
             ;; T5.2 residual multi-arg pure → single guest records
             :plan/weights3 [:record :plan/weights3
                             [[:total :i64] [:w0 :i64] [:w1 :i64] [:w2 :i64]]]
             :plan/pair [:record :plan/pair [[:a :i64] [:b :i64]]]
             :plan/triple [:record :plan/triple [[:a :i64] [:b :i64] [:c :i64]]]
             ;; T5.2 residual: largest-remainder bump tournament
             :plan/bump-cmp [:record :plan/bump-cmp
                             [[:rem-a :i64] [:idx-a :i64]
                              [:rem-b :i64] [:idx-b :i64]]]
             :plan/ok-for [:record :plan/ok-for
                           [[:active :bool] [:bumped :bool]]]
             :plan/bump3-in [:record :plan/bump3-in
                             [[:ok-t :bool] [:ok-m :bool] [:ok-p :bool]
                              [:rt :i64] [:rm :i64] [:rp :i64]]]
             ;; T5.2 residual: weight+model partition surface
             :plan/wm [:record :plan/wm
                       [[:weight-bytes :i64] [:layers :i64]
                        [:dense :i64] [:frac-milli :i64]]]
             :plan/wm-i [:record :plan/wm-i
                         [[:weight-bytes :i64] [:layers :i64]
                          [:dense :i64] [:frac-milli :i64] [:i :i64]]]
             :plan/wm-range [:record :plan/wm-range
                             [[:weight-bytes :i64] [:layers :i64]
                              [:dense :i64] [:frac-milli :i64]
                              [:lo :i64] [:hi :i64]]]
             :plan/wm-adv [:record :plan/wm-adv
                           [[:weight-bytes :i64] [:layers :i64]
                            [:dense :i64] [:frac-milli :i64]
                            [:lo :i64] [:acc :i64] [:target :i64]]]
             :plan/wm-u1 [:record :plan/wm-u1
                          [[:weight-bytes :i64] [:layers :i64]
                           [:dense :i64] [:frac-milli :i64] [:u0 :i64]]]
             :plan/wm-u2 [:record :plan/wm-u2
                          [[:weight-bytes :i64] [:layers :i64]
                           [:dense :i64] [:frac-milli :i64]
                           [:u0 :i64] [:u1 :i64]]]
             :plan/wm-u3 [:record :plan/wm-u3
                          [[:weight-bytes :i64] [:layers :i64]
                           [:dense :i64] [:frac-milli :i64]
                           [:u0 :i64] [:u1 :i64] [:u2 :i64]]]
             :plan/wm-asg [:record :plan/wm-asg
                           [[:weight-bytes :i64] [:layers :i64]
                            [:dense :i64] [:frac-milli :i64]
                            [:lo :i64] [:hi :i64] [:usable :i64]]]
             :plan/wm-step [:record :plan/wm-step
                            [[:weight-bytes :i64] [:layers :i64]
                             [:dense :i64] [:frac-milli :i64]
                             [:at :i64] [:acc :i64]
                             [:cum-usable :i64] [:total-usable :i64]]]
             :plan/ul [:record :plan/ul
                       [[:weight-bytes :i64] [:layers :i64]]]
             :plan/dense-units [:record :plan/dense-units
                                [[:layers :i64] [:dense :i64]
                                 [:frac-milli :i64]]]
             :plan/band [:record :plan/band
                         [[:lo :i64] [:hi-cap :i64] [:layer-b :i64]
                          [:acc :i64] [:target :i64]]]
             ;; T5.2 residual: ends + idx multi-arg → single guest record
             :plan/ends-idx [:record :plan/ends-idx
                             [[:hi0 :i64] [:hi1 :i64] [:hi2 :i64] [:idx :i64]]]})
  (:export [gib default-os-reserve default-headroom usable-bytes choose-strategy-name
            plan-lr-l0 plan-lr-l1 plan-lr-l2
            plan-fits-total? span-fits?
            uniform-layer-bytes dense-units-milli moe-layer-bytes
            model-record model-layers model-dense model-frac-milli
            layer-byte-at layer-wsum partition-target
            advance-hi est-bytes-range partition-3-ends
            assignment-span plan-fits-3 ok-mark
            pick-max-idx-3 moe-capacity-ok
            digit-char nat-str i64-str
            bytes-to-gib-milli bytes-to-gib-floor layers-range-str
            mem-gib-milli usable-gib-milli est-gib-milli
            partition-1-end plan-fits-1
            partition-2-ends plan-fits-2
            asg-row-record asg-row-span asg-row-fits
            pick-max-idx-2 ends-at ends-lo ends-hi
            cut-state partition-step partition-step-hi partition-step-acc
            partition-last fits-and]))

;; W6 pure-planner oracle — murakumo.infer.plan usable-bytes + choose-strategy
;; + plan largest-remainder (no per-pool floor) for fixed 3 ranks + fits gates
;; + integer partition-layers walk for fixed 1/2/3 nodes over layer weights.
;; + partition-step host-fold for n>3 rings (lo/acc → hi/new-acc per node).
;; Host attaches node ids when assembling plan maps from pure ends/spans/fits.
;; plan-fits-1/2/3: pure go/no-go for fixed n-node integer partition.
;; asg-row-pack: span+fits for one assignment (host pairs with node id).
;; pick-max-idx-3 / moe-capacity-ok: mlx-moe single-node pick + fits gate.
;; report GiB helpers: milli/floor of bytes/GiB + layers-range-str for plan/report rows.
;;
;; Layer weights use milli-fixed dense-frac (default 100 = 0.1) matching
;; uniform-layer-bytes / moe-layer-bytes scalars. Cumulative targets use
;; integer quot (wsum * cum-usable / total) — matches cljc doubles when
;; layer bytes stay integer and targets align (uniform + typical MoE cases).
;;
;; model-record = [:ref :plan/model] {layers, dense, frac-milli} (T5.3).
;; partition-2-ends / partition-3-ends → [:ref :plan/ends] exclusive layer ends.
;; partition-step: [:ref :plan/cut] + cum + total → the next cut;
;;   last node uses partition-last. (T5.3: records, no packs left here.)
;; Parity: test/murakumo/infer_plan_kotoba_parity_test.clj

(defn gib [] :i64 1073741824)

(defn default-os-reserve [] :i64 3758096384)

(defn default-headroom [] :i64 1342177280)

(defn rem64 [a :i64 b :i64] :i64
  (- a (* (quot a b) b)))

(defn usable-bytes [n [:ref :plan/node-cap]] :i64
  ;; Profile 5: wired is [:option :i64] (none = no wired cap). No -1 sentinel.
  ;; T5.2 native guest record: mem/os/head/wired on one input.
  (let [mem (record-get n :mem)
        os (record-get n :os)
        head (record-get n :head)
        wired (record-get n :wired)
        ceil0 (- mem os)
        ceil1 (if-some [w wired]
                (if (< w ceil0) w ceil0)
                ceil0)
        left (- ceil1 head)]
    (if (< left 0) 0 left)))

(defn choose-strategy-name [s [:ref :plan/strategy-in]] :string
  ;; T5.2 native guest record: link/ranks/experts/kv-heads on one input.
  (let [link-gbps (record-get s :link-gbps)
        ranks (record-get s :ranks)
        experts (record-get s :experts)
        kv-heads (record-get s :kv-heads)
        fast (if (< link-gbps 20) 0 1)
        div (if (< ranks 1) 0 (if (= 0 (rem64 kv-heads ranks)) 1 0))]
    (if (if (= fast 1) (if (= div 1) 1 0) 0)
      "tensor"
      (if (if (= fast 1) (if (< ranks experts) 1 0) 0)
        "expert"
        "pipeline"))))

;; T5.3 is complete for this module: no base-65536 packing remains.

(defn better-bump? [x [:ref :plan/bump-cmp]] :bool
  ;; higher rem wins; lower index wins ties (plan.cljc sort key [(- frac) i])
  (let [rem-a (record-get x :rem-a)
        idx-a (record-get x :idx-a)
        rem-b (record-get x :rem-b)
        idx-b (record-get x :idx-b)]
    (if (< rem-b rem-a)
      true
      (if (< rem-a rem-b)
        false
        (if (< idx-a idx-b) true false)))))

(defn pick-bump-3 [x [:ref :plan/bump3-in]] :i64
  (let [ok-t (record-get x :ok-t)
        ok-m (record-get x :ok-m)
        ok-p (record-get x :ok-p)
        rt (record-get x :rt)
        rm (record-get x :rm)
        rp (record-get x :rp)]
    (if ok-t
      (if ok-m
        (let [win-tm (if (better-bump?
                          (record-new [:ref :plan/bump-cmp] rt 0 rm 1)) 0 1)
              r-win (if (= win-tm 0) rt rm)
              i-win win-tm]
          (if ok-p
            (if (better-bump?
                 (record-new [:ref :plan/bump-cmp] r-win i-win rp 2)) win-tm 2)
            win-tm))
        (if ok-p
          (if (better-bump?
               (record-new [:ref :plan/bump-cmp] rt 0 rp 2)) 0 2)
          0))
      (if ok-m
        (if ok-p
          (if (better-bump?
               (record-new [:ref :plan/bump-cmp] rm 1 rp 2)) 1 2)
          1)
        (if ok-p 2 -1)))))

(defn ok-for [x [:ref :plan/ok-for]] :bool
  ;; active lane with positive weight and not yet bumped this remainder pass
  (if (record-get x :active)
    (if (record-get x :bumped) false true)
    false))

(defn weight-pos? [w :i64] :bool
  (if (< 0 w) true false))

(defn plan-lr-record [w [:ref :plan/weights3]]
  [:record :plan/lanes [[:l0 :i64] [:l1 :i64] [:l2 :i64]]]
  ;; plan.cljc largest-remainder without rebalance per-active floor:
  ;; floor(total*w_i/sumw) + remainder seats by fractional rank.
  ;; T5.2 residual: total+weights on one record.
  (let [total (record-get w :total)
        w0 (record-get w :w0)
        w1 (record-get w :w1)
        w2 (record-get w :w2)
        a0 (weight-pos? w0)
        a1 (weight-pos? w1)
        a2 (weight-pos? w2)
        sumw (+ w0 (+ w1 w2))]
    (if (if (= total 0) 1 (if (= sumw 0) 1 0))
      (record-new [:record :plan/lanes [[:l0 :i64] [:l1 :i64] [:l2 :i64]]] 0 0 0)
      (let [p0 (* total w0)
            p1 (* total w1)
            p2 (* total w2)
            f0 (quot p0 sumw)
            f1 (quot p1 sumw)
            f2 (quot p2 sumw)
            r0 (rem64 p0 sumw)
            r1 (rem64 p1 sumw)
            r2 (rem64 p2 sumw)
            assigned (+ f0 (+ f1 f2))
            extra (- total assigned)
            rems (record-new [:record :plan/lanes [[:l0 :i64] [:l1 :i64] [:l2 :i64]]] r0 r1 r2)
            b0 (if (< 0 extra)
                 (pick-bump-3 (record-new [:ref :plan/bump3-in] (ok-for (record-new [:ref :plan/ok-for] a0 false)) (ok-for (record-new [:ref :plan/ok-for] a1 false)) (ok-for (record-new [:ref :plan/ok-for] a2 false)) r0 r1 r2))
                 -1)
            t0 (if (= b0 0) true false)
            m0 (if (= b0 1) true false)
            p0b (if (= b0 2) true false)
            b1 (if (< 1 extra)
                 (pick-bump-3 (record-new [:ref :plan/bump3-in] (ok-for (record-new [:ref :plan/ok-for] a0 t0)) (ok-for (record-new [:ref :plan/ok-for] a1 m0)) (ok-for (record-new [:ref :plan/ok-for] a2 p0b)) r0 r1 r2))
                 -1)
            t1 (if (= b1 0) true t0)
            m1 (if (= b1 1) true m0)
            p1b (if (= b1 2) true p0b)
            b2 (if (< 2 extra)
                 (pick-bump-3 (record-new [:ref :plan/bump3-in] (ok-for (record-new [:ref :plan/ok-for] a0 t1)) (ok-for (record-new [:ref :plan/ok-for] a1 m1)) (ok-for (record-new [:ref :plan/ok-for] a2 p1b)) r0 r1 r2))
                 -1)
            bump0 (if (if (= b0 0) 1 (if (= b1 0) 1 (if (= b2 0) 1 0))) 1 0)
            bump1 (if (if (= b0 1) 1 (if (= b1 1) 1 (if (= b2 1) 1 0))) 1 0)
            bump2 (if (if (= b0 2) 1 (if (= b1 2) 1 (if (= b2 2) 1 0))) 1 0)]
        (record-new [:record :plan/lanes [[:l0 :i64] [:l1 :i64] [:l2 :i64]]] (+ f0 bump0) (+ f1 bump1) (+ f2 bump2))))))

;; Public lane projections (T5.3). No pack crosses the boundary.

(defn plan-lr-l0 [w [:ref :plan/weights3]] :i64
  (record-get (plan-lr-record w) :l0))

(defn plan-lr-l1 [w [:ref :plan/weights3]] :i64
  (record-get (plan-lr-record w) :l1))

(defn plan-lr-l2 [w [:ref :plan/weights3]] :i64
  (record-get (plan-lr-record w) :l2))

(defn plan-fits-total? [p [:ref :plan/pair]] :bool
  ;; cljc plan :fits? partial — total usable ≥ model weights
  ;; T5.2: a=total-usable b=weight-bytes. Profile 5: :bool.
  (if (< (record-get p :a) (record-get p :b)) false true))

(defn span-fits? [p [:ref :plan/pair]] :bool
  ;; cljc :fits? per assignment (<= est usable)
  ;; T5.2: a=est-bytes b=usable. Profile 5: :bool.
  (if (< (record-get p :b) (record-get p :a)) false true))

(defn uniform-layer-bytes [x [:ref :plan/ul]] :i64
  ;; dense-layers=0 case of layer-weights (each layer equal)
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)]
    (if (< layers 1) 0 (quot weight-bytes layers))))

(defn dense-units-milli [x [:ref :plan/dense-units]] :i64
  ;; units = dense*frac + (layers-dense) in milli-layer units
  ;; dense-frac-milli = 100 → 0.1 default
  (let [layers (record-get x :layers)
        dense (record-get x :dense)
        dense-frac-milli (record-get x :frac-milli)
        d (if (< dense 0) 0 (if (< layers dense) layers dense))
        rest (- layers d)]
    (+ (* d dense-frac-milli) (* rest 1000))))

(defn moe-layer-bytes [x [:ref :plan/wm]] :i64
  ;; bytes per MoE-bearing layer (not dense): weight / units
  (let [weight-bytes (record-get x :weight-bytes)
        units (dense-units-milli
               (record-new [:ref :plan/dense-units]
                           (record-get x :layers)
                           (record-get x :dense)
                           (record-get x :frac-milli)))]
    (if (< units 1) 0 (quot (* weight-bytes 1000) units))))

(defn model-record [layers :i64 dense :i64 dense-frac-milli :i64] [:ref :plan/model]
  ;; T5.3: the model shape is a named record, not pack3(layers, dense, frac).
  ;; Threaded through 16 signatures as `mp [:ref :plan/model]` — a schema
  ;; reference, so the descriptor is declared once on the ns form.
  (record-new [:ref :plan/model] layers dense dense-frac-milli))

(defn model-layers [mp [:ref :plan/model]] :i64
  (record-get mp :layers))

(defn model-dense [mp [:ref :plan/model]] :i64
  (record-get mp :dense))

(defn model-frac-milli [mp [:ref :plan/model]] :i64
  (record-get mp :frac-milli))

(defn dense-layer-bytes [x [:ref :plan/wm]] :i64
  ;; f * moe-bytes via milli: (moe * frac-milli) / 1000
  (let [dense-frac-milli (record-get x :frac-milli)
        moe (moe-layer-bytes x)]
    (quot (* moe dense-frac-milli) 1000)))

(defn layer-byte-at [x [:ref :plan/wm-i]] :i64
  ;; integer form of (nth (layer-weights model) i)
  (let [layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        i (record-get x :i)
        w (record-new [:ref :plan/wm]
                      (record-get x :weight-bytes) layers dense frac)
        d (if (< dense 0) 0 (if (< layers dense) layers dense))]
    (if (< i d)
      (dense-layer-bytes w)
      (moe-layer-bytes w))))

(defn layer-wsum [x [:ref :plan/wm]] :i64
  ;; sum of integer layer-byte-at over all layers (closed form)
  (let [layers (record-get x :layers)
        dense (record-get x :dense)
        d (if (< dense 0) 0 (if (< layers dense) layers dense))
        rest (- layers d)
        moe (moe-layer-bytes x)
        db (dense-layer-bytes x)]
    (+ (* d db) (* rest moe))))

(defn partition-target [x [:ref :plan/triple]] :i64
  ;; cljc: (* wsum (/ (double cum) total)) as integer quot
  ;; T5.2: a=wsum b=cum-usable c=total-usable
  (let [wsum (record-get x :a)
        cum-usable (record-get x :b)
        total-usable (record-get x :c)]
    (if (< total-usable 1)
      0
      (quot (* wsum cum-usable) total-usable))))

(defn min2 [p [:ref :plan/pair]] :i64
  (if (< (record-get p :a) (record-get p :b))
    (record-get p :a) (record-get p :b)))

(defn max2 [p [:ref :plan/pair]] :i64
  (if (< (record-get p :a) (record-get p :b))
    (record-get p :b) (record-get p :a)))

(defn clamp-nonneg [n :i64] :i64
  (if (< n 0) 0 n))

(defn est-bytes-range [x [:ref :plan/wm-range]] :i64
  ;; closed-form sum of layer-byte-at over [lo, hi) — dense then moe bands
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        lo (record-get x :lo)
        hi (record-get x :hi)
        w (record-new [:ref :plan/wm] weight-bytes layers dense frac)
        d (if (< dense 0) 0 (if (< layers dense) layers dense))
        moe (moe-layer-bytes w)
        db (dense-layer-bytes w)
        lo2 (if (< lo 0) 0 lo)
        hi2 (if (< hi lo2) lo2 (if (< layers hi) layers hi))
        dense-lo lo2
        dense-hi (min2 (record-new [:ref :plan/pair] hi2 d))
        dense-n (clamp-nonneg (- dense-hi dense-lo))
        moe-lo (max2 (record-new [:ref :plan/pair] lo2 d))
        moe-hi hi2
        moe-n (clamp-nonneg (- moe-hi moe-lo))]
    (+ (* dense-n db) (* moe-n moe))))

(defn advance-in-band [x [:ref :plan/band]] :i64
  ;; closed-form: how far can we go in a constant-byte band [lo, hi-cap)
  ;; while keeping acc + layer-b * k <= target
  (let [lo (record-get x :lo)
        hi-cap (record-get x :hi-cap)
        layer-b (record-get x :layer-b)
        acc (record-get x :acc)
        target (record-get x :target)]
    (if (if (< lo hi-cap) (if (< 0 layer-b) 1 0) 0)
      (let [room (- target acc)
            kmax (if (< room 0) 0 (quot room layer-b))
            hi (+ lo kmax)]
        (if (< hi-cap hi) hi-cap hi))
      lo)))

(defn advance-hi [x [:ref :plan/wm-adv]] :i64
  ;; two-band closed form matching cljc inner cut loop
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        lo (record-get x :lo)
        acc (record-get x :acc)
        target (record-get x :target)
        w (record-new [:ref :plan/wm] weight-bytes layers dense frac)
        d (if (< dense 0) 0 (if (< layers dense) layers dense))
        moe (moe-layer-bytes w)
        db (dense-layer-bytes w)
        lo0 (if (< lo 0) 0 (if (< layers lo) layers lo))]
    (if (< lo0 d)
      (let [hi-d (advance-in-band
                  (record-new [:ref :plan/band] lo0 d db acc target))
            acc-d (+ acc (est-bytes-range
                          (record-new [:ref :plan/wm-range]
                                      weight-bytes layers dense frac lo0 hi-d)))]
        (if (< hi-d d)
          hi-d
          (advance-in-band
           (record-new [:ref :plan/band] d layers moe acc-d target))))
      (advance-in-band
       (record-new [:ref :plan/band] lo0 layers moe acc target)))))

(defn partition-3-ends [x [:ref :plan/wm-u3]]
  [:ref :plan/ends]
  ;; exclusive layer ends for 3 ring nodes (last end = layers).
  ;; Mirrors plan.cljc partition-layers loop for count(nodes)=3.
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        u0 (record-get x :u0)
        u1 (record-get x :u1)
        u2 (record-get x :u2)
        w (record-new [:ref :plan/wm] weight-bytes layers dense frac)
        total (+ u0 (+ u1 u2))
        wsum (layer-wsum w)]
    (if (= total 0)
      (record-new [:ref :plan/ends] 0 0 layers)
      (let [t0 (partition-target (record-new [:ref :plan/triple] wsum u0 total))
            t1 (partition-target (record-new [:ref :plan/triple] wsum (+ u0 u1) total))
            hi0 (advance-hi (record-new [:ref :plan/wm-adv]
                                        weight-bytes layers dense frac 0 0 t0))
            acc0 (est-bytes-range (record-new [:ref :plan/wm-range]
                                              weight-bytes layers dense frac 0 hi0))
            hi1 (advance-hi (record-new [:ref :plan/wm-adv]
                                        weight-bytes layers dense frac hi0 acc0 t1))
            hi2 layers]
        (record-new [:ref :plan/ends] hi0 hi1 hi2)))))

(defn assignment-span [p [:ref :plan/pair]] :i64
  ;; T5.2: a=lo b=hi
  (let [lo (record-get p :a)
        hi (record-get p :b)]
    (if (< hi lo) 0 (- hi lo))))

(defn plan-fits-3 [x [:ref :plan/wm-u3]] :i64
  ;; cljc plan :fits? for 3-node ring using integer partition-3-ends
  ;; total usable ≥ weights AND every positive-span assignment fits its usable
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        u0 (record-get x :u0)
        u1 (record-get x :u1)
        u2 (record-get x :u2)
        ends (partition-3-ends x)
        hi0 (record-get ends :hi0)
        hi1 (record-get ends :hi1)
        hi2 (record-get ends :hi2)
        lo0 0
        lo1 hi0
        lo2 hi1
        s0 (assignment-span (record-new [:ref :plan/pair] lo0 hi0))
        s1 (assignment-span (record-new [:ref :plan/pair] lo1 hi1))
        s2 (assignment-span (record-new [:ref :plan/pair] lo2 hi2))
        e0 (est-bytes-range (record-new [:ref :plan/wm-range]
                                        weight-bytes layers dense frac lo0 hi0))
        e1 (est-bytes-range (record-new [:ref :plan/wm-range]
                                        weight-bytes layers dense frac lo1 hi1))
        e2 (est-bytes-range (record-new [:ref :plan/wm-range]
                                        weight-bytes layers dense frac lo2 hi2))
        f0 (if (= s0 0) true (span-fits? (record-new [:ref :plan/pair] e0 u0)))
        f1 (if (= s1 0) true (span-fits? (record-new [:ref :plan/pair] e1 u1)))
        f2 (if (= s2 0) true (span-fits? (record-new [:ref :plan/pair] e2 u2)))
        spans-ok (if f0 (if f1 (if f2 true false) false) false)
        total (+ u0 (+ u1 u2))
        total-ok (plan-fits-total? (record-new [:ref :plan/pair] total weight-bytes))]
    (if (if total-ok (if spans-ok true false) false) 1 0)))

(defn partition-1-end [mp [:ref :plan/model]] :i64
  ;; single-node ring: exclusive end is always layers
  (model-layers mp))

(defn plan-fits-1 [x [:ref :plan/wm-u1]] :i64
  ;; cljc plan :fits? for 1-node (whole stack on one rank)
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        u0 (record-get x :u0)
        mp (record-new [:ref :plan/model] layers dense frac)
        nlayers (partition-1-end mp)
        s0 (assignment-span (record-new [:ref :plan/pair] 0 nlayers))
        e0 (est-bytes-range (record-new [:ref :plan/wm-range]
                                        weight-bytes layers dense frac 0 nlayers))
        f0 (if (= s0 0) true (span-fits? (record-new [:ref :plan/pair] e0 u0)))
        total-ok (plan-fits-total? (record-new [:ref :plan/pair] u0 weight-bytes))]
    (if (if total-ok (if f0 true false) false) 1 0)))

(defn partition-2-ends [x [:ref :plan/wm-u2]]
  [:ref :plan/ends]
  ;; exclusive layer ends for 2 ring nodes; hi2 stays 0
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        u0 (record-get x :u0)
        u1 (record-get x :u1)
        w (record-new [:ref :plan/wm] weight-bytes layers dense frac)
        total (+ u0 u1)
        wsum (layer-wsum w)]
    (if (= total 0)
      (record-new [:ref :plan/ends] 0 layers 0)
      (let [t0 (partition-target (record-new [:ref :plan/triple] wsum u0 total))
            hi0 (advance-hi (record-new [:ref :plan/wm-adv]
                                        weight-bytes layers dense frac 0 0 t0))
            hi1 layers]
        (record-new [:ref :plan/ends] hi0 hi1 0)))))

(defn plan-fits-2 [x [:ref :plan/wm-u2]] :i64
  ;; cljc plan :fits? for 2-node ring using integer partition-2-ends
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        u0 (record-get x :u0)
        u1 (record-get x :u1)
        ends (partition-2-ends x)
        hi0 (record-get ends :hi0)
        hi1 (record-get ends :hi1)
        lo0 0
        lo1 hi0
        s0 (assignment-span (record-new [:ref :plan/pair] lo0 hi0))
        s1 (assignment-span (record-new [:ref :plan/pair] lo1 hi1))
        e0 (est-bytes-range (record-new [:ref :plan/wm-range]
                                        weight-bytes layers dense frac lo0 hi0))
        e1 (est-bytes-range (record-new [:ref :plan/wm-range]
                                        weight-bytes layers dense frac lo1 hi1))
        f0 (if (= s0 0) true (span-fits? (record-new [:ref :plan/pair] e0 u0)))
        f1 (if (= s1 0) true (span-fits? (record-new [:ref :plan/pair] e1 u1)))
        spans-ok (if f0 (if f1 true false) false)
        total (+ u0 u1)
        total-ok (plan-fits-total? (record-new [:ref :plan/pair] total weight-bytes))]
    (if (if total-ok (if spans-ok true false) false) 1 0)))

(defn ends-at [x [:ref :plan/ends-idx]] :i64
  ;; exclusive end at idx; hi fields + idx on one guest record (T5.2 residual)
  (let [idx (record-get x :idx)]
    (if (= idx 0)
      (record-get x :hi0)
      (if (= idx 1) (record-get x :hi1) (record-get x :hi2)))))

(defn ends-lo [x [:ref :plan/ends-idx]] :i64
  ;; lo of assignment idx (idx 0 → 0)
  (let [idx (record-get x :idx)]
    (if (= idx 0)
      0
      (ends-at (record-new [:ref :plan/ends-idx]
                           (record-get x :hi0)
                           (record-get x :hi1)
                           (record-get x :hi2)
                           (- idx 1))))))

(defn ends-hi [x [:ref :plan/ends-idx]] :i64
  (ends-at x))

(defn asg-row-record [x [:ref :plan/wm-asg]]
  [:ref :plan/row]
  ;; pure assignment numeric row (T5.3: a record, not pack3). Host adds :node id.
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        lo (record-get x :lo)
        hi (record-get x :hi)
        usable (record-get x :usable)
        sp (assignment-span (record-new [:ref :plan/pair] lo hi))
        est (est-bytes-range (record-new [:ref :plan/wm-range]
                                         weight-bytes layers dense frac lo hi))
        fit (if (= sp 0) 1 (if (span-fits? (record-new [:ref :plan/pair] est usable)) 1 0))]
    (record-new [:ref :plan/row] sp fit)))

(defn asg-row-span [row [:ref :plan/row]] :i64
  (record-get row :span))

(defn asg-row-fits [row [:ref :plan/row]] :i64
  (record-get row :fits))

(defn cut-state [p [:ref :plan/pair]] [:ref :plan/cut]
  ;; state for the partition-step host fold (T5.3: a record, not pack3)
  ;; T5.2: a=at b=acc
  (record-new [:ref :plan/cut] (record-get p :a) (record-get p :b)))

(defn partition-step [x [:ref :plan/wm-step]] [:ref :plan/cut]
  ;; one non-last ring node: cut the next boundary from the current one.
  ;; The result's `:at` is the next step's `:at` — same record either way.
  ;; Host: cum-usable = sum usable[0..i] inclusive; last node uses partition-last.
  (let [weight-bytes (record-get x :weight-bytes)
        layers (record-get x :layers)
        dense (record-get x :dense)
        frac (record-get x :frac-milli)
        lo (record-get x :at)
        acc (record-get x :acc)
        cum-usable (record-get x :cum-usable)
        total-usable (record-get x :total-usable)
        w (record-new [:ref :plan/wm] weight-bytes layers dense frac)
        wsum (layer-wsum w)
        target (partition-target
                (record-new [:ref :plan/triple] wsum cum-usable total-usable))
        hi (advance-hi (record-new [:ref :plan/wm-adv]
                                   weight-bytes layers dense frac lo acc target))
        new-acc (+ acc (est-bytes-range
                        (record-new [:ref :plan/wm-range]
                                    weight-bytes layers dense frac lo hi)))]
    (record-new [:ref :plan/cut] hi new-acc)))

(defn partition-step-hi [step [:ref :plan/cut]] :i64
  (record-get step :at))

(defn partition-step-acc [step [:ref :plan/cut]] :i64
  (record-get step :acc))

(defn partition-last [mp [:ref :plan/model]] :i64
  ;; last ring node exclusive end is always layers
  (model-layers mp))

(defn fits-and [p [:ref :plan/pair]] :i64
  ;; fold positive-span fits across assignments
  ;; T5.2: a=acc-fits b=row-fits
  (if (if (= (record-get p :a) 1) (if (= (record-get p :b) 1) 1 0) 0) 1 0))

(defn ok-mark [fits :i64] :string
  ;; cljc report :ok
  (if (= fits 1) "✓" "✗"))

(defn pick-max-idx-2 [p [:ref :plan/pair]] :i64
  ;; highest first; ties keep earlier index
  ;; T5.2 residual: a,b on one record
  (if (< (record-get p :a) (record-get p :b)) 1 0))

(defn pick-max-idx-3 [t [:ref :plan/triple]] :i64
  ;; cljc sort-by (comp - :usable): highest first; ties keep earlier index
  ;; T5.2 residual tournament multi-arg
  (let [a (record-get t :a)
        b (record-get t :b)
        c (record-get t :c)]
    (if (if (< a b) 0 (if (< a c) 0 1))
      0
      (if (if (< b c) 0 1)
        1
        2))))

(defn moe-capacity-ok [cap :i64] :i64
  ;; cljc moe/plan :fits? (boolean cap) — nil/0 capacity ⇒ false
  (if (< cap 1) 0 1))

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))


(defn bytes-to-gib-milli [bytes :i64] :i64
  ;; cljc plan/report: (/ (double bytes) GiB) as milli-GiB (floor)
  ;; exact for whole-GiB sizes; sub-GiB floors to 0 milli when < GiB/1000
  (if (< bytes 0)
    0
    (quot (* bytes 1000) (gib))))

(defn bytes-to-gib-floor [bytes :i64] :i64
  ;; whole GiB floor
  (if (< bytes 0)
    0
    (quot bytes (gib))))

(defn layers-range-str [p [:ref :plan/pair]] :string
  ;; display form for :layers [lo hi) — "lo..hi"
  ;; T5.2: a=lo b=hi
  (string-concat (i64-str (record-get p :a))
                 (string-concat ".." (i64-str (record-get p :b)))))

(defn mem-gib-milli [mem-bytes :i64] :i64
  ;; cljc report :mem-gib
  (bytes-to-gib-milli mem-bytes))

(defn usable-gib-milli [n [:ref :plan/node-cap]] :i64
  ;; usable-bytes then milli-GiB. T5.2: same node-cap record.
  (bytes-to-gib-milli (usable-bytes n)))

(defn est-gib-milli [est-bytes :i64] :i64
  ;; cljc report :est-gib
  (bytes-to-gib-milli est-bytes))
