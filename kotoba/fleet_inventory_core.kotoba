(ns fleet-inventory-core
  (:schemas {:fleet/ports [:record :fleet/ports
                          [[:node-port [:option :i64]] [:fleet-port [:option :i64]]]]
;; T5.2 native guest record wire
             :fleet/selector-name [:record :fleet/selector-name
                                   [[:sel :string] [:name :string]]]})
  (:export [default-control-port digit-char nat-str i64-str
            resolve-port health-url selector-is-all?
            selector-wants-name? line-has-offline?
            selector-all offline-token
            health-url-prefix health-url-path
            selector-join-sep]))

;; Product Value ABI v1 pure oracle — murakumo.fleet.inventory.
;; resolve-port uses [:option :i64] (no has-node/has-fleet sentinels).
;; selector-is-all?: empty string ≡ cljc nil selector.
;; Residual selector/offline/health URL tokens dual-source; helpers recompose.
;; T5.2: multi-scalar selector inputs take single guest records.
;; Parity: test/murakumo/fleet_inventory_kotoba_parity_test.clj

(defn default-control-port [] :i64 8077)

;; ── residual selector / offline / health URL tokens ──────────────────

(defn selector-all [] :string
  ;; CLI selector that selects every node (nil/empty also means all)
  "all")

(defn offline-token [] :string
  ;; tailscale status column marker for offline peers
  "offline")

(defn health-url-prefix [] :string
  "http://localhost:")

(defn health-url-path [] :string
  "/health")

(defn selector-join-sep [] :string
  ;; between node names in selector CSV; pad sides for exact-token match
  ",")

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn resolve-port [x [:ref :fleet/ports]] :i64
  ;; cljc: (or (:port node) (:fleet/port fleet) 8077)
  ;; T5.2 native: option ports in-record.
  (if-some [p (record-get x :node-port)]
    p
    (if-some [f (record-get x :fleet-port)]
      f
      (default-control-port))))

(defn health-url [port :i64] :string
  ;; cljc: (str "http://localhost:" port "/health")
  (string-concat
   (health-url-prefix)
   (string-concat (string-from-i64 port) (health-url-path))))

(defn selector-is-all? [sel :string] :bool
  ;; cljc: (or (nil? sel) (= sel "all")) — empty string ≡ nil
  ;; Profile 5: :bool.
  (if (string=? sel "")
    true
    (string=? sel (selector-all))))

(defn selector-wants-name? [x [:ref :fleet/selector-name]] :bool
  ;; Exact comma-token match: pad both sides so substrings can't false-hit.
  ;; Profile 5: :bool. T5.2 native: sel+name.
  (let [sel (record-get x :sel)
        name (record-get x :name)
        sep (selector-join-sep)]
    (string-contains?
         (string-concat sep (string-concat sel sep))
         (string-concat sep (string-concat name sep)))))

(defn line-has-offline? [line :string] :bool
  ;; cljc parse-tailscale-status online?: (not (str/includes? line "offline"))
  ;; Profile 5: :bool.
  (string-contains? line (offline-token)))
