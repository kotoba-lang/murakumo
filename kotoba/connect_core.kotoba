(ns connect-core
  (:export [default-class-name node-class-name
            serves-read? serves-live? serves-plane?
            class-native plane-read plane-live]))

;; W6 pure-planner oracle — murakumo.connect decision core (low priority).
;; class-transports / set intersection stay host-projected into :bool flags.
;; Profile 5: http?/common? are real :bool (not [:option :i64] presence).
;; Residual class/plane name tokens dual-source; helpers recompose.
;; empty default-class string ⇒ class-native. node-class empty ⇒ use default.
;; plane: plane-read | plane-live | other.
;; Parity: test/murakumo/connect_kotoba_parity_test.clj

;; ── residual class / plane name tokens ───────────────────────────────

(defn class-native [] :string
  ;; default node class when connect omits :default-class
  "native")

(defn plane-read [] :string
  ;; :read plane name — host projects :http presence
  "read")

(defn plane-live [] :string
  ;; :live plane name — host projects live-transport intersection
  "live")

(defn default-class-name [default-class :string] :string
  ;; cljc: (or (:default-class connect) :native) → name string
  (if (string=? default-class "")
    (class-native)
    default-class))

(defn node-class-name [node-class :string default-class :string] :string
  ;; cljc: (or (:class node) (default-class connect))
  (if (string=? node-class "")
    (default-class-name default-class)
    node-class))

(defn serves-read? [http? :bool] :bool
  ;; cljc :read plane — host projects presence of :http as real :bool.
  http?)

(defn serves-live? [common? :bool] :bool
  ;; cljc :live — host projects non-empty live-transport intersection as :bool.
  common?)

(defn serves-plane? [plane :string
                     http? :bool
                     common? :bool] :bool
  ;; Profile 5: plane gate; http?/common? are real :bool (not option-i64).
  (if (string=? plane (plane-read))
    (serves-read? http?)
    (if (string=? plane (plane-live))
      (serves-live? common?)
      false)))
