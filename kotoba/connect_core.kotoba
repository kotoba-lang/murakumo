(ns connect-core
  (:export [default-class-name node-class-name
            serves-read? serves-live? serves-plane?]))

;; Product Value ABI v1 pure oracle — murakumo.connect decision core.
;; serves-read? / serves-live? / serves-plane? use [:option :string]
;; for host-projected transport presence (no has-http / has-common sentinels).
;; class-transports / set intersection stay host-projected into options.
;; empty default-class string ⇒ "native". node-class empty ⇒ use default.
;; plane: "read" | "live" | other.
;; Parity: test/murakumo/connect_kotoba_parity_test.clj

(defn default-class-name [default-class :string] :string
  ;; cljc: (or (:default-class connect) :native) → name string
  (if (string=? default-class "")
    "native"
    default-class))

(defn node-class-name [node-class :string default-class :string] :string
  ;; cljc: (or (:class node) (default-class connect))
  (if (string=? node-class "")
    (default-class-name default-class)
    node-class))

(defn serves-read? [http [:option :string]] :i64
  ;; cljc :read plane — (some #{:http} read-transports)
  ;; host passes some "http" when present, else none
  (if-some [_ http] 1 0))

(defn serves-live? [common [:option :string]] :i64
  ;; cljc :live — non-empty intersection of live transports
  ;; host passes some transport name when intersection non-empty
  (if-some [_ common] 1 0))

(defn serves-plane? [plane :string http [:option :string] common [:option :string]] :i64
  (if (string=? plane "read")
    (serves-read? http)
    (if (string=? plane "live")
      (serves-live? common)
      0)))
