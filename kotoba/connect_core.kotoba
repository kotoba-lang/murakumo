(ns connect-core
  (:export [default-class-name node-class-name
            serves-read? serves-live? serves-plane?]))

;; W6 pure-planner oracle — murakumo.connect decision core (low priority).
;; class-transports / set intersection stay host-projected into optional flags.
;; Product Value ABI v1: optional i64 flags (no has-http / has-common sentinels).
;; empty default-class string ⇒ "native". node-class empty ⇒ use default.
;; plane: "read" | "live" | other.
;; Parity: test/murakumo/connect_kotoba_parity_test.clj

(defn default-class-name [default-class :string] :string
  ;; cljc: (or (:default-class connect) :native) → name string
  (if (string=? default-class "")
    "native"
    default-class))

(defn node-class-name [node-class :string default-class :string] :string
  ;; cljc: (or (:class node) (default-class connect))
  (if (string=? node-class "")
    (default-class-name default-class)
    node-class))

(defn serves-read? [http? [:option :i64]] :i64
  ;; cljc :read plane — host projects presence of :http as some(1)
  (if-some [_ http?] 1 0))

(defn serves-live? [common? [:option :i64]] :i64
  ;; cljc :live — host projects non-empty live-transport intersection as some(1)
  (if-some [_ common?] 1 0))

(defn serves-plane? [plane :string
                     http? [:option :i64]
                     common? [:option :i64]] :i64
  (if (string=? plane "read")
    (serves-read? http?)
    (if (string=? plane "live")
      (serves-live? common?)
      0)))
