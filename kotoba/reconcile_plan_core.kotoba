(ns reconcile-plan-core
  (:schemas {;; T5.3: placement pick result is a record, not a mixed radix pack.
             :reconcile/targets [:record :reconcile/targets
                                 [[:first :i64] [:second :i64] [:count :i64]]]
             ;; T5.3 + profile 5: pairwise name-order flags are :bool (not 0/1 i64).
             :reconcile/name-order [:record :reconcile/name-order
                                    [[:n01 :bool] [:n02 :bool] [:n12 :bool]]]})
  (:export [default-replicas desired deficit watch-sleep-ms action-name
            better-target? first-of-2 first-of-3
            name-order-record
            pick-targets-2-record pick-targets-3-first
            targets-first targets-second targets-count
            blank? missing-manifest? action-is-satisfied? action-is-place?
            default-watch-seconds starts-with?
            flag-is-dry-run? flag-is-apply? flag-is-watch? flag-is-snapshot?
            flag-is-dash? watch-seconds snapshot-value
            digit-val? digit-of-go digit-of parse-digits-go parse-digits trim-ws
            flag-dry-run flag-apply flag-watch flag-watch-eq-prefix
            flag-snapshot-prefix flag-dash-prefix
            action-satisfied action-place action-over action-blocked
            action-needs-build
            reconcile-record-type]))

;; Product Value ABI v1 pure oracle — murakumo.reconcile.plan scalar + pick.
;; desired / action-name use [:option …] (no has-replicas / has-cid sentinels).
;; has-misplaced was unused in action-name and is dropped from the guest ABI.
;; eligible-nodes / observed-hosts / reconcile-app maps / parse-flags fold stay cljc.
;; flag/action/missing-manifest pure helpers dual-source for CLI shell.
;; flag tokens + action name tokens SSoT; classifiers/value extract recompose.
;; reconcile-record-type: atproto $type / collection NSID for fleet reconcile records.
;; pick-targets: pure sort-by [load, name] for fixed 2/3 free candidates.
;; name order projected by host: name-a-before-b true if name(a) <= name(b).
;; For 3-way: name-order record {n01,n02,n12} :bool if name(i) <= name(j).
;; T5.3: pick result is [:ref :reconcile/targets]; name-bits bit-pack is gone.
;; T5.3 complete for this module: no base-N / bit packs remain.
;; Profile 5: name-order / better-target? tie-break flags are :bool.
;; Parity: test/murakumo/reconcile_plan_kotoba_parity_test.clj

(defn default-replicas [] :i64 1)

(defn desired [replicas [:option :i64]] :i64
  ;; cljc: (or replicas 1)
  (if-some [r replicas]
    r
    1))

(defn deficit [desired-n :i64 running :i64] :i64
  (let [d (- desired-n running)]
    (if (< d 0) 0 d)))

(defn watch-sleep-ms [seconds :i64] :i64
  (* 1000 seconds))

(defn action-satisfied [] :string "satisfied")
(defn action-place [] :string "place")
(defn action-over [] :string "over")
(defn action-blocked [] :string "blocked")
(defn action-needs-build [] :string "needs-build")

(defn action-name [cid [:option :string] running :i64 desired-n :i64
                   free-candidates :i64] :string
  (let [def-n (deficit desired-n running)]
    (if-some [_ cid]
      (if (< desired-n running)
        (action-over)
        (if (= def-n 0)
          (action-satisfied)
          (if (< free-candidates 1)
            (action-blocked)
            (action-place))))
      (action-needs-build))))

(defn better-target? [load-a :i64 load-b :i64 name-a-before-b :bool] :bool
  ;; cljc sort-by (juxt load identity): lower load first; ties by name ascending
  ;; name-a-before-b true means name(a) <= name(b) so a wins ties
  (if (< load-a load-b)
    true
    (if (< load-b load-a)
      false
      name-a-before-b)))

(defn first-of-2 [load0 :i64 load1 :i64 name0-before-1 :bool] :i64
  (if (better-target? load0 load1 name0-before-1) 0 1))

(defn name-order-record [n01 :bool n02 :bool n12 :bool] [:ref :reconcile/name-order]
  (record-new [:ref :reconcile/name-order] n01 n02 n12))

(defn first-of-3 [load0 :i64 load1 :i64 load2 :i64
                  names [:ref :reconcile/name-order]] :i64
  (let [n01 (record-get names :n01)
        n02 (record-get names :n02)
        n12 (record-get names :n12)
        w01 (first-of-2 load0 load1 n01)]
    (if (= w01 0)
      (if (better-target? load0 load2 n02) 0 2)
      (if (better-target? load1 load2 n12) 1 2))))

(defn targets-record [first :i64 second :i64 count :i64] [:ref :reconcile/targets]
  (record-new [:ref :reconcile/targets] first second count))

(defn targets-first [t [:ref :reconcile/targets]] :i64
  (record-get t :first))

(defn targets-second [t [:ref :reconcile/targets]] :i64
  (record-get t :second))

(defn targets-count [t [:ref :reconcile/targets]] :i64
  (record-get t :count))

(defn pick-targets-2-record [load0 :i64 load1 :i64 name0-before-1 :bool n :i64]
  [:ref :reconcile/targets]
  ;; take min(n,2) from two candidates sorted by load then name
  (if (< n 1)
    (targets-record 0 0 0)
    (let [f (first-of-2 load0 load1 name0-before-1)
          s (if (= f 0) 1 0)]
      (if (= n 1)
        (targets-record f 0 1)
        (targets-record f s 2)))))

(defn pick-targets-3-first [load0 :i64 load1 :i64 load2 :i64
                            names [:ref :reconcile/name-order]] :i64
  ;; first target among 3 free candidates (n>=1). For n>1 host may re-call
  ;; on remaining pair via pick-targets-2-record.
  (first-of-3 load0 load1 load2 names))

(defn blank? [s :string] :bool
  (let [n (string-byte-length s)]
    (if (= n 0)
      true
      (if (ws? (string-substring s 0 1))
        (blank? (string-substring s 1 n))
        false))))

(defn missing-manifest? [manifest :string] :bool
  ;; cljc: (str/blank? (str manifest)) — host passes "" for nil
  (blank? manifest))

(defn action-is-satisfied? [action :string] :bool
  (if (string=? action (action-satisfied)) true false))

(defn action-is-place? [action :string] :bool
  (if (string=? action (action-place)) true false))

(defn default-watch-seconds [] :i64 30)

(defn starts-with? [s :string prefix :string] :bool
  (let [n (string-byte-length s)
        p (string-byte-length prefix)]
    (if (< n p)
      false
      (if (string=? (string-substring s 0 p) prefix) true false))))

;; CLI flag tokens (SSoT for classifiers + value extract)

(defn flag-dry-run [] :string "--dry-run")
(defn flag-apply [] :string "--apply")
(defn flag-watch [] :string "--watch")
(defn flag-watch-eq-prefix [] :string "--watch=")
(defn flag-snapshot-prefix [] :string "--snapshot=")
(defn flag-dash-prefix [] :string "--")

(defn flag-is-dry-run? [a :string] :bool
  (if (string=? a (flag-dry-run)) true false))

(defn flag-is-apply? [a :string] :bool
  (if (string=? a (flag-apply)) true false))

(defn flag-is-watch? [a :string] :bool
  ;; bare --watch or --watch=N
  (starts-with? a (flag-watch)))

(defn flag-is-snapshot? [a :string] :bool
  (starts-with? a (flag-snapshot-prefix)))

(defn flag-is-dash? [a :string] :bool
  (starts-with? a (flag-dash-prefix)))

(defn ws? [c :string] :bool
  (if (string=? c " ")
    true
    (if (string=? c "\n")
      true
      (if (string=? c "\t")
        true
        (if (string=? c "\r") true false)))))

(defn trim-ws [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (if (ws? (string-substring s 0 1))
        (trim-ws (string-substring s 1 n))
        (if (ws? (string-substring s (- n 1) n))
          (trim-ws (string-substring s 0 (- n 1)))
          s)))))

(defn digit-val? [c :string] :bool
  (if (= (string-byte-length c) 1)
    (if (string-contains? "0123456789" c) true false)
    false))

(defn digit-of-go [digits :string c :string i :i64] :i64
  (let [n (string-byte-length digits)]
    (if (< i n)
      (if (string=? (string-substring digits i (+ i 1)) c)
        i
        (digit-of-go digits c (+ i 1)))
      0)))

(defn digit-of [c :string] :i64
  (digit-of-go "0123456789" c 0))

(defn parse-digits-go [s :string acc :i64] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      acc
      (let [c (string-substring s 0 1)]
        (if (digit-val? c)
          (parse-digits-go (string-substring s 1 n)
                           (+ (* acc 10) (digit-of c)))
          -1)))))

(defn parse-digits [s :string] :i64
  (let [t (trim-ws s)
        n (string-byte-length t)]
    (if (= n 0)
      -1
      (parse-digits-go t 0))))

(defn watch-seconds [a :string] :i64
  ;; "--watch" → 30; "--watch=5" → 5; bad digits → 30 default
  (if (string=? a (flag-watch))
    (default-watch-seconds)
    (if (starts-with? a (flag-watch-eq-prefix))
      (let [n (string-byte-length a)
            plen (string-byte-length (flag-watch-eq-prefix))
            v (parse-digits (string-substring a plen n))]
        (if (< v 0)
          (default-watch-seconds)
          v))
      (default-watch-seconds))))

(defn snapshot-value [a :string] :string
  ;; "--snapshot=PATH" → PATH; else ""
  (if (starts-with? a (flag-snapshot-prefix))
    (let [n (string-byte-length a)
          plen (string-byte-length (flag-snapshot-prefix))]
      (string-substring a plen n))
    ""))

;; ── residual atproto collection / record $type ───────────────────────

(defn reconcile-record-type [] :string
  ;; $type + persist reconcile-collection NSID
  "com.murakumo.fleet.reconcile")
