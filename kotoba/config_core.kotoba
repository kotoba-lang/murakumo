(ns config-core
  (:export [default-fleet-path default-connect-path default-cloud-path
            default-kotoba-dir pinned-bin-dir release-bin-dir
            kotoba-server-bin local-kotoba-bin pinned-wit-dir runtime-wit-dir
            build-manifest-path peers-path launchd-template-path
            kotoba-bin resolve-local-bin resolve-wit-dir
            kotoba-dir-from
            default-cloud-url default-api-url default-text-backend-url
            default-image-checkpoint default-infer-local-url
            default-kotoba-cli-bin]))

;; W6 pure-planner oracle — murakumo.config path resolution core (medium).
;; EDN parse/file I/O and env map folds stay cljc/host.
;; kotoba-dir-from: empty override ⇒ default under home (cljc nil/absent env).
;; pinned-exists / pinned-wit-exists: 0/1.
;; Ops residual default URL/string constants dual-source (post #147 inject).
;; Parity: test/murakumo/config_kotoba_parity_test.clj

(defn default-fleet-path [] :string "fleet.edn")
(defn default-connect-path [] :string "connect.edn")
(defn default-cloud-path [] :string "cloud.edn")

;; ── residual ops config defaults (exact-name getenv leave values) ──

(defn default-cloud-url [] :string
  "https://api.murakumo.cloud")

(defn default-api-url [] :string
  "https://api.murakumo.cloud")

(defn default-text-backend-url [] :string
  "http://localhost:11434")

(defn default-image-checkpoint [] :string
  "animagine-xl-4.0.safetensors")

(defn default-infer-local-url [] :string
  "http://localhost:11434/v1")

(defn default-kotoba-cli-bin [] :string
  "kotoba")

(defn default-kotoba-dir [home :string] :string
  (string-concat
   home
   "/github/com-junkawasaki/orgs/com-junkawasaki/kotoba"))

(defn kotoba-dir-from [override :string home :string] :string
  ;; cljc: (or MURAKUMO_KOTOBA_DIR (default-kotoba-dir HOME))
  (if (string=? override "")
    (default-kotoba-dir home)
    override))

(defn pinned-bin-dir [user-dir :string] :string
  (string-concat user-dir "/bin"))

(defn release-bin-dir [kotoba-dir :string] :string
  (string-concat kotoba-dir "/target/aarch64-apple-darwin/release"))

(defn kotoba-server-bin [bin-dir :string] :string
  (string-concat bin-dir "/kotoba-server"))

(defn local-kotoba-bin [bin-dir :string] :string
  (string-concat bin-dir "/kotoba"))

(defn pinned-wit-dir [user-dir :string] :string
  (string-concat (pinned-bin-dir user-dir) "/wit"))

(defn runtime-wit-dir [kotoba-dir :string] :string
  (string-concat kotoba-dir "/crates/kotoba-runtime/wit"))

(defn build-manifest-path [user-dir :string] :string
  (string-concat (pinned-bin-dir user-dir) "/BUILD.edn"))

(defn peers-path [] :string
  ".murakumo-peers.edn")

(defn launchd-template-path [] :string
  "deploy/com.murakumo.kotoba-mesh.plist.tmpl")

(defn kotoba-bin [user-dir :string pinned-exists :i64] :string
  (if (= pinned-exists 1)
    (string-concat (pinned-bin-dir user-dir) "/kotoba")
    "kotoba"))

(defn resolve-local-bin [user-dir :string kotoba-dir :string
                         pinned-exists :i64 murakumo-bin :string] :string
  ;; cljc: pinned → MURAKUMO_BIN → release-bin-dir
  (if (= pinned-exists 1)
    (pinned-bin-dir user-dir)
    (if (string=? murakumo-bin "")
      (release-bin-dir kotoba-dir)
      murakumo-bin)))

(defn resolve-wit-dir [user-dir :string kotoba-dir :string
                       pinned-wit-exists :i64] :string
  (if (= pinned-wit-exists 1)
    (pinned-wit-dir user-dir)
    (runtime-wit-dir kotoba-dir)))
