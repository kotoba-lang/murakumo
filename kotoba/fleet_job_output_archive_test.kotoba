;; Compose after fleet_job_output_archive.
(ns murakumo.fleet-job-output-archive-test (:export [test-job-output-archive]))

(defn test-job-output-archive [] :bool
  (let [cid "bafkreibuoymhi5lbxktszxduuzmekq2qpbqd7mz66w2cowz4memgb4dna"
        tree "0123456789abcdef0123456789abcdef01234567"]
    (and (ga-manifest-size? 10 10 false)
         (not (ga-manifest-size? 11 10 false))
         (ga-manifest-size? 11 10 true)
         (not (ga-manifest-size? 12 10 true))
         (not (ga-manifest-size? -1 10 true))
         (not (ga-manifest-size? 0 0 true))
         (not (ga-manifest-size? 8193 8193 true))
         (jo-archive-result? (str "archive/stored " cid " " tree " acknowledged") cid)
         (jo-archive-result? (str "archive/stored " cid " " tree " unacknowledged") cid)
         (not (jo-archive-result? (str "archive/stored " cid " " tree " acknowledged extra") cid))
         (not (jo-archive-result? (str "archive/stored other " tree " acknowledged") cid))
         (not (jo-archive-result? (str "archive/stored " cid " bad acknowledged") cid))
         (jo-restore-fetch-result? (str "archive-restore/fetched " cid " " tree) cid)
         (not (jo-restore-fetch-result? (str "archive-restore/fetched other " tree) cid))
         (not (jo-restore-fetch-result? (str "archive-restore/fetched " cid " " tree " extra") cid)))))
