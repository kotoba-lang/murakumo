(ns infer-credits-core
  (:export [default-per-token head-num head-den protocol-num protocol-den
            token-cost cut pool memory-time-weight
            charge-allow? balance-after-spend
            unit-cost job-cost-2 job-cost-3
            share-floor share-pack-2 settle-pool-shares-2
            mt-sum-2 mt-sum-3]))

;; W6 pure-planner oracle — murakumo.infer.credits integer core (medium).
;; Float share folds use floor quot; host may apply remainder policy.
;; multi-unit job-cost: sum of integer unit×price (throws stay host).
;; settle-pool-shares-2: floor shares of pool by memory-time weights.
;; Parity: test/murakumo/infer_credits_kotoba_parity_test.clj

(defn default-per-token [] :i64 1)

(defn head-num [] :i64 1)
(defn head-den [] :i64 10)
(defn protocol-num [] :i64 1)
(defn protocol-den [] :i64 20)

(defn token-cost [price :i64 tokens :i64] :i64
  (* price tokens))

(defn unit-cost [price :i64 n :i64] :i64
  ;; generic unit×price (images, video-seconds, …)
  (* price n))

(defn job-cost-2 [p0 :i64 n0 :i64 p1 :i64 n1 :i64] :i64
  (+ (* p0 n0) (* p1 n1)))

(defn job-cost-3 [p0 :i64 n0 :i64 p1 :i64 n1 :i64 p2n :i64] :i64
  ;; p2n packs p2 + n2*B — too lossy. Use sum of two + third via unit-cost host-side.
  ;; Arity 5: p0 n0 p1 n1 extra where extra = p2*n2 precomputed by host.
  (+ (+ (* p0 n0) (* p1 n1)) p2n))

(defn cut [total :i64 num :i64 den :i64] :i64
  (quot (* total num) den))

(defn pool [total :i64 treasury :i64 head :i64] :i64
  (- total (+ treasury head)))

(defn memory-time-weight [est-bytes :i64 duration-ms :i64 span :i64] :i64
  (if (< span 1)
    0
    (* est-bytes duration-ms)))

(defn mt-sum-2 [w0 :i64 w1 :i64] :i64
  (+ w0 w1))

(defn mt-sum-3 [w0 :i64 w1 :i64 w2 :i64] :i64
  (+ w0 (+ w1 w2)))

(defn share-floor [pool-amt :i64 w :i64 sumw :i64] :i64
  ;; cljc (* pool (/ w sumw)) as floor for integer conservation lower bound
  (if (< sumw 1)
    0
    (quot (* pool-amt w) sumw)))

(defn share-pack-2 [pool-amt :i64 w0 :i64 w1 :i64] :i64
  (let [sumw (+ w0 w1)
        s0 (share-floor pool-amt w0 sumw)
        s1 (share-floor pool-amt w1 sumw)
        B 65536]
    ;; pack s0 + s1*B — shares may exceed B for large pools; tests use small
    (+ s0 (* s1 B))))

(defn settle-pool-shares-2 [total :i64 w0 :i64 w1 :i64] :i64
  ;; default head 1/10 protocol 1/20 → pool, then floor shares
  (let [tr (cut total 1 20)
        hd (cut total 1 10)
        pl (pool total tr hd)]
    (share-pack-2 pl w0 w1)))

(defn charge-allow? [balance :i64 cost :i64] :i64
  (if (< balance cost) 0 1))

(defn balance-after-spend [balance :i64 cost :i64] :i64
  (let [left (- balance cost)]
    (if (< left 0) 0 left)))
