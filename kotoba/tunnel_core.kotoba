(ns tunnel-core
  (:schemas {;; T5.2 native guest record wire
             :tunnel/scp [:record :tunnel/scp [[:host :string] [:dest :string]]]
             :tunnel/ports [:record :tunnel/ports
                            [[:local-port :i64] [:remote-port :i64]]]
             :tunnel/forward [:record :tunnel/forward
                              [[:local-port :i64] [:remote-port :i64] [:host :string]]]
             :tunnel/exit [:record :tunnel/exit
                           [[:has-rc :bool] [:rc :i64] [:ssh-exit :i64]]]
             ;; T5.2 residual: digit-scanner multi-arg
             :tunnel/digits-go [:record :tunnel/digits-go
                                [[:s :string] [:acc :i64]]]})
  (:export [default-connect-timeout-s default-control-persist-s rc-marker
            digit-char nat-str i64-str
            wrap-cmd connect-timeout-opt control-path-opt control-persist-opt
            scp-dest close-master-control-opt
            ensure-forward-command replace-forward-command remote-curl-command
            marker-prefix? strip-marker-digits
            batch-mode-opt strict-host-key-opt control-master-opt
            digit-val? parse-digits trim-ws
            pick-exit trim-err err-ws?
            ssh-bin scp-bin o-flag O-flag exit-ctl
            pgrep-bin pkill-bin f-flag fN-flag L-flag
            null-redirect or-sep settle-sleep pkill-suffix
            localhost-colon curl-prefix curl-stderr-redirect
            forward-spec ssh-forward-prefix]))

;; W6 pure-planner oracle — murakumo.tunnel string core (SSH host-forever,
;; pure argv/shell contract still oracle-eligible).
;; parse-rc: host splits lines; guest classifies marker + parse-digits for rc.
;; conn-opts vector assembly stays cljc (host concatenates pure -o fragments).
;; ssh/scp bin + -o/-O/exit flags dual-source.
;; ensure/replace-forward + remote-curl compose from pure fragments.
;; Parity: test/murakumo/tunnel_kotoba_parity_test.clj

(defn default-connect-timeout-s [] :i64 8)
(defn default-control-persist-s [] :i64 30)
(defn rc-marker [] :string "__murakumo_rc=")

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn wrap-cmd [cmd :string] :string
  (let [a (string-concat "( " cmd)
        b (string-concat a "\n); __mrc=$?; echo \"")
        c (string-concat b (rc-marker))]
    (string-concat c "$__mrc\"")))

(defn connect-timeout-opt [seconds :i64] :string
  (string-concat "ConnectTimeout=" (i64-str seconds)))

(defn control-path-opt [path :string] :string
  (string-concat "ControlPath=" path))

(defn control-persist-opt [seconds :i64] :string
  (string-concat "ControlPersist=" (string-concat (i64-str seconds) "s")))

(defn scp-dest [s [:ref :tunnel/scp]] :string
  (string-concat (record-get s :host) (string-concat ":" (record-get s :dest))))

(defn close-master-control-opt [control-path :string] :string
  (string-concat "ControlPath=" control-path))

(defn marker-prefix? [line :string] :bool
  ;; Profile 5: rc marker prefix gate as :bool.
  (let [m (rc-marker)
        n (string-byte-length m)
        ln (string-byte-length line)]
    (if (< ln n)
      false
      (if (string=? (string-substring line 0 n) m) true false))))

(defn strip-marker-digits [line :string] :string
  (let [m (rc-marker)
        n (string-byte-length m)
        ln (string-byte-length line)]
    (if (< ln n)
      ""
      (string-substring line n ln))))

(defn batch-mode-opt [] :string
  "BatchMode=yes")

(defn strict-host-key-opt [] :string
  "StrictHostKeyChecking=accept-new")

(defn control-master-opt [] :string
  "ControlMaster=auto")

(defn digit-val? [c :string] :bool
  ;; true if single char is ASCII digit
  (if (= (string-byte-length c) 1)
    (if (string-contains? "0123456789" c) true false)
    false))

(defn digit-of [c :string] :i64
  (if (string=? c "0") 0
    (if (string=? c "1") 1
      (if (string=? c "2") 2
        (if (string=? c "3") 3
          (if (string=? c "4") 4
            (if (string=? c "5") 5
              (if (string=? c "6") 6
                (if (string=? c "7") 7
                  (if (string=? c "8") 8
                    (if (string=? c "9") 9 -1)))))))))))

(defn trim-ws [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (let [c0 (string-substring s 0 1)]
        (if (if (string=? c0 " ")
              1
              (if (string=? c0 "\t") 1 0))
          (trim-ws (string-substring s 1 n))
          (let [c1 (string-substring s (- n 1) n)]
            (if (if (string=? c1 " ")
                  1
                  (if (string=? c1 "\t") 1 0))
              (trim-ws (string-substring s 0 (- n 1)))
              s)))))))

(defn parse-digits-go [x [:ref :tunnel/digits-go]] :i64
  ;; T5.2 residual: s+acc on one guest record
  (let [s (record-get x :s)
        acc (record-get x :acc)
        n (string-byte-length s)]
    (if (= n 0)
      acc
      (let [c (string-substring s 0 1)
            d (digit-of c)]
        (if (< d 0)
          -1
          (parse-digits-go (record-new [:ref :tunnel/digits-go]
                                       (string-substring s 1 n)
                                       (+ (* acc 10) d))))))))

(defn parse-digits [s :string] :i64
  ;; cljc Long/parseLong digits after marker; -1 if empty/non-digit
  (let [t (trim-ws s)
        n (string-byte-length t)]
    (if (= n 0)
      -1
      (parse-digits-go (record-new [:ref :tunnel/digits-go] t 0)))))

(defn pick-exit [e [:ref :tunnel/exit]] :i64
  ;; cljc sh-result: (if (some? rc) rc exit)
  ;; Profile 5: has-rc is a real :bool presence flag (not 0/1 i64).
  ;; T5.2 native record.
  (if (record-get e :has-rc) (record-get e :rc) (record-get e :ssh-exit)))

(defn err-ws? [c :string] :bool
  (if (string=? c " ")
    true
    (if (string=? c "\n")
      true
      (if (string=? c "\t")
        true
        (if (string=? c "\r") true false)))))

(defn trim-err [err :string] :string
  ;; host str/trim on err
  (let [n (string-byte-length err)]
    (if (= n 0)
      err
      (if (err-ws? (string-substring err 0 1))
        (trim-err (string-substring err 1 n))
        (if (err-ws? (string-substring err (- n 1) n))
          (trim-err (string-substring err 0 (- n 1)))
          err)))))

;; ── residual ssh/scp argv bin+flag fragments ─────────────────────────

(defn ssh-bin [] :string "ssh")
(defn scp-bin [] :string "scp")
(defn o-flag [] :string "-o")
(defn O-flag [] :string "-O")
(defn exit-ctl [] :string "exit")

;; ── residual forward/curl shell fragments ────────────────────────────

(defn pgrep-bin [] :string "pgrep")
(defn pkill-bin [] :string "pkill")
(defn f-flag [] :string "-f")
(defn fN-flag [] :string "-fN")
(defn L-flag [] :string "-L")
(defn null-redirect [] :string " >/dev/null 2>&1")
(defn or-sep [] :string " || ")
(defn settle-sleep [] :string "sleep 0.3; ")
(defn pkill-suffix [] :string " 2>/dev/null; ")
(defn localhost-colon [] :string ":localhost:")
(defn curl-prefix [] :string "curl -s -m 5 ")
(defn curl-stderr-redirect [] :string " 2>/dev/null")

(defn forward-spec [p [:ref :tunnel/ports]] :string
  ;; "{local}:localhost:{remote}"
  ;; T5.2 native record.
  (string-concat
   (i64-str (record-get p :local-port))
   (string-concat (localhost-colon) (i64-str (record-get p :remote-port)))))

(defn ssh-forward-prefix [] :string
  ;; "ssh -o BatchMode=yes -fN -L "
  (string-concat
   (ssh-bin)
   (string-concat
    " "
    (string-concat
     (o-flag)
     (string-concat
      " "
      (string-concat
       (batch-mode-opt)
       (string-concat
        " "
        (string-concat
         (fN-flag)
         (string-concat
          " "
          (string-concat (L-flag) " "))))))))))

(defn ensure-forward-command [f [:ref :tunnel/forward]] :string
  ;; pgrep -f '{spec} {host}' >/dev/null 2>&1 || ssh -o BatchMode=yes -fN -L {spec} {host}
  ;; T5.2 native record.
  (let [local-port (record-get f :local-port)
        remote-port (record-get f :remote-port)
        host (record-get f :host)
        spec (forward-spec (record-new [:ref :tunnel/ports] local-port remote-port))
        probe (string-concat
               (pgrep-bin)
               (string-concat
                " "
                (string-concat
                 (f-flag)
                 (string-concat
                  " '"
                  (string-concat
                   spec
                   (string-concat
                    " "
                    (string-concat host "'")))))))]
    (string-concat
     probe
     (string-concat
      (null-redirect)
      (string-concat
       (or-sep)
       (string-concat
        (ssh-forward-prefix)
        (string-concat spec (string-concat " " host))))))))

(defn replace-forward-command [f [:ref :tunnel/forward]] :string
  ;; pkill + sleep + ssh forward (see host). T5.2 native record.
  (let [local-port (record-get f :local-port)
        remote-port (record-get f :remote-port)
        host (record-get f :host)
        lp (i64-str local-port)
        spec (forward-spec (record-new [:ref :tunnel/ports] local-port remote-port))
        kill (string-concat
              (pkill-bin)
              (string-concat
               " "
               (string-concat
                (f-flag)
                (string-concat
                 " '"
                 (string-concat lp ":localhost'")))))]
    (string-concat
     kill
     (string-concat
      (pkill-suffix)
      (string-concat
       (settle-sleep)
       (string-concat
        (ssh-forward-prefix)
        (string-concat spec (string-concat " " host))))))))

(defn remote-curl-command [url :string] :string
  (string-concat
   (curl-prefix)
   (string-concat url (curl-stderr-redirect))))
