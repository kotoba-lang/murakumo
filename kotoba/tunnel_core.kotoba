(ns tunnel-core
  (:export [default-connect-timeout-s default-control-persist-s rc-marker
            digit-char nat-str i64-str
            wrap-cmd connect-timeout-opt control-path-opt control-persist-opt
            scp-dest close-master-control-opt
            ensure-forward-command replace-forward-command remote-curl-command
            marker-prefix? strip-marker-digits
            batch-mode-opt strict-host-key-opt control-master-opt
            digit-val? parse-digits trim-ws]))

;; W6 pure-planner oracle — murakumo.tunnel string core (SSH host-forever,
;; pure argv/shell contract still oracle-eligible).
;; parse-rc: host splits lines; guest classifies marker + parse-digits for rc.
;; conn-opts vector assembly stays cljc (host concatenates pure -o fragments).
;; Parity: test/murakumo/tunnel_kotoba_parity_test.clj

(defn default-connect-timeout-s [] :i64 8)
(defn default-control-persist-s [] :i64 30)
(defn rc-marker [] :string "__murakumo_rc=")

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

(defn wrap-cmd [cmd :string] :string
  (let [a (string-concat "( " cmd)
        b (string-concat a "\n); __mrc=$?; echo \"")
        c (string-concat b (rc-marker))]
    (string-concat c "$__mrc\"")))

(defn connect-timeout-opt [seconds :i64] :string
  (string-concat "ConnectTimeout=" (i64-str seconds)))

(defn control-path-opt [path :string] :string
  (string-concat "ControlPath=" path))

(defn control-persist-opt [seconds :i64] :string
  (string-concat "ControlPersist=" (string-concat (i64-str seconds) "s")))

(defn scp-dest [host :string dest :string] :string
  (string-concat host (string-concat ":" dest)))

(defn close-master-control-opt [control-path :string] :string
  (string-concat "ControlPath=" control-path))

(defn ensure-forward-command [local-port :i64 remote-port :i64 host :string] :string
  (let [lp (i64-str local-port)
        rp (i64-str remote-port)
        a (string-concat "pgrep -f '" lp)
        b (string-concat a ":localhost:")
        c (string-concat b rp)
        d (string-concat c " ")
        e (string-concat d host)
        f (string-concat e "' >/dev/null 2>&1 || ssh -o BatchMode=yes -fN -L ")
        g (string-concat f lp)
        h (string-concat g ":localhost:")
        i (string-concat h rp)]
    (string-concat i (string-concat " " host))))

(defn replace-forward-command [local-port :i64 remote-port :i64 host :string] :string
  (let [lp (i64-str local-port)
        rp (i64-str remote-port)
        a (string-concat "pkill -f '" lp)
        b (string-concat a ":localhost' 2>/dev/null; sleep 0.3; ssh -o BatchMode=yes -fN -L ")
        c (string-concat b lp)
        d (string-concat c ":localhost:")
        e (string-concat d rp)]
    (string-concat e (string-concat " " host))))

(defn remote-curl-command [url :string] :string
  (string-concat "curl -s -m 5 " (string-concat url " 2>/dev/null")))

(defn marker-prefix? [line :string] :i64
  (let [m (rc-marker)
        n (string-byte-length m)
        ln (string-byte-length line)]
    (if (< ln n)
      0
      (if (string=? (string-substring line 0 n) m) 1 0))))

(defn strip-marker-digits [line :string] :string
  (let [m (rc-marker)
        n (string-byte-length m)
        ln (string-byte-length line)]
    (if (< ln n)
      ""
      (string-substring line n ln))))

(defn batch-mode-opt [] :string
  "BatchMode=yes")

(defn strict-host-key-opt [] :string
  "StrictHostKeyChecking=accept-new")

(defn control-master-opt [] :string
  "ControlMaster=auto")

(defn digit-val? [c :string] :i64
  ;; 1 if single char is ASCII digit
  (if (= (string-byte-length c) 1)
    (if (string-contains? "0123456789" c) 1 0)
    0))

(defn digit-of [c :string] :i64
  (if (string=? c "0") 0
    (if (string=? c "1") 1
      (if (string=? c "2") 2
        (if (string=? c "3") 3
          (if (string=? c "4") 4
            (if (string=? c "5") 5
              (if (string=? c "6") 6
                (if (string=? c "7") 7
                  (if (string=? c "8") 8
                    (if (string=? c "9") 9 -1)))))))))))

(defn trim-ws [s :string] :string
  (let [n (string-byte-length s)]
    (if (= n 0)
      s
      (let [c0 (string-substring s 0 1)]
        (if (if (string=? c0 " ")
              1
              (if (string=? c0 "\t") 1 0))
          (trim-ws (string-substring s 1 n))
          (let [c1 (string-substring s (- n 1) n)]
            (if (if (string=? c1 " ")
                  1
                  (if (string=? c1 "\t") 1 0))
              (trim-ws (string-substring s 0 (- n 1)))
              s)))))))

(defn parse-digits-go [s :string acc :i64] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      acc
      (let [c (string-substring s 0 1)
            d (digit-of c)]
        (if (< d 0)
          -1
          (parse-digits-go (string-substring s 1 n) (+ (* acc 10) d)))))))

(defn parse-digits [s :string] :i64
  ;; cljc Long/parseLong digits after marker; -1 if empty/non-digit
  (let [t (trim-ws s)
        n (string-byte-length t)]
    (if (= n 0)
      -1
      (parse-digits-go t 0))))