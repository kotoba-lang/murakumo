(ns secret-core
  (:export [token-secret-name token-secret-env
            service-token-name service-token-env
            metrics-token-name metrics-token-env
            quic-cert-path-name quic-cert-path-env
            quic-key-path-name quic-key-path-env
            max-env-name max-path-ref
            blank? ws? valid-env-var-name? valid-path-ref-unix?
            env-for-secret-name known-secret-name?
            reply-tag classify-fetched
            secret-error-code secret-error-message
            reply-is-value?
            class-value class-not-found class-empty class-fetch class-unknown
            error-code-prefix
            msg-empty msg-not-found msg-fetch msg-unknown
            pem-begin-marker]))

;; W6 pure-planner oracle — murakumo.secret name/policy core.
;; env-fetch / map-fetch / kagi-fetch / System.getenv stay host.
;; Residual reply class / error message / pem-begin tokens dual-source;
;; classify-fetched / reply-tag / secret-error-* recompose from those SSoTs.
;; valid-path-ref-unix?: absolute = leading / (clj File/isAbsolute host-projected
;; via same string rules for POSIX paths used in tests).
;; Parity: test/murakumo/secret_kotoba_parity_test.clj

(defn token-secret-name [] :string "murakumo-token")
(defn token-secret-env [] :string "MURAKUMO_TOKEN_SECRET")
(defn service-token-name [] :string "murakumo-service-token")
(defn service-token-env [] :string "MURAKUMO_SERVICE_TOKEN")
(defn metrics-token-name [] :string "murakumo-metrics-token")
(defn metrics-token-env [] :string "MURAKUMO_METRICS_TOKEN")
(defn quic-cert-path-name [] :string "murakumo-quic-cert-path")
(defn quic-cert-path-env [] :string "MURAKUMO_QUIC_CERT")
(defn quic-key-path-name [] :string "murakumo-quic-key-path")
(defn quic-key-path-env [] :string "MURAKUMO_QUIC_KEY")

(defn max-env-name [] :i64 256)
(defn max-path-ref [] :i64 1024)

;; ── residual reply class + error message tokens ──────────────────────

(defn class-value [] :string
  ;; kit-shaped success class / :tag value
  "value")

(defn class-not-found [] :string
  "not-found")

(defn class-empty [] :string
  "empty")

(defn class-fetch [] :string
  ;; getter/fn-fetch failure class
  "fetch")

(defn class-unknown [] :string
  "unknown")

(defn error-code-prefix [] :string
  ;; host keywordizes "secret/empty" etc.
  "secret/")

(defn msg-empty [] :string "empty")
(defn msg-not-found [] :string "not found")
(defn msg-fetch [] :string "getter failed")
(defn msg-unknown [] :string "unknown")

(defn pem-begin-marker [] :string
  ;; path-ref must not embed PEM bodies
  "-----BEGIN")

(defn ws? [c :string] :bool
  (if (string=? c " ")
    true
    (if (string=? c "\n")
      true
      (if (string=? c "\t")
        true
        (if (string=? c "\r") true false)))))

(defn blank? [s :string] :bool
  (let [n (string-byte-length s)]
    (if (= n 0)
      true
      (if (ws? (string-substring s 0 1))
        (blank? (string-substring s 1 n))
        false))))

(defn valid-env-var-name? [env-name :string] :bool
  ;; cljc: not blank, no * / \\ space, length ≤ 256
  (if (blank? env-name)
    false
    (if (< (max-env-name) (string-byte-length env-name))
      false
      (if (string-contains? env-name "*")
        false
        (if (string-contains? env-name "/")
          false
          (if (string-contains? env-name "\\")
            false
            (if (string-contains? env-name " ") false true)))))))

(defn valid-path-ref-unix? [p :string] :bool
  ;; cljc valid-path-ref? for POSIX absolute paths (leading /)
  (if (blank? p)
    false
    (if (< (max-path-ref) (string-byte-length p))
      false
      (if (string-contains? p "\0")
        false
        (if (string-contains? p (pem-begin-marker))
          false
          (if (string-contains? p "*")
            false
            (let [n (string-byte-length p)]
              (if (< n 1)
                false
                (if (string=? (string-substring p 0 1) "/") true false)))))))))

(defn known-secret-name? [name :string] :i64
  (if (string=? name (token-secret-name))
    1
    (if (string=? name (service-token-name))
      1
      (if (string=? name (metrics-token-name))
        1
        (if (string=? name (quic-cert-path-name))
          1
          (if (string=? name (quic-key-path-name)) 1 0))))))

(defn env-for-secret-name [name :string] :string
  ;; known-env-secrets lookup; empty ≡ unknown
  (if (string=? name (token-secret-name))
    (token-secret-env)
    (if (string=? name (service-token-name))
      (service-token-env)
      (if (string=? name (metrics-token-name))
        (metrics-token-env)
        (if (string=? name (quic-cert-path-name))
          (quic-cert-path-env)
          (if (string=? name (quic-key-path-name))
            (quic-key-path-env)
            ""))))))

(defn reply-tag [kind :string] :string
  ;; kit-shaped :tag bare names for value | not-found | empty | fetch
  (if (string=? kind (class-value))
    (class-value)
    (if (string=? kind (class-not-found))
      (class-not-found)
      (if (string=? kind (class-empty))
        (class-empty)
        (if (string=? kind (class-fetch))
          (class-fetch)
          (class-unknown))))))

(defn classify-fetched [missing :i64 blank :i64] :string
  ;; map-fetch / fn-fetch pure classification of host-projected presence
  (if (= missing 1)
    (class-not-found)
    (if (= blank 1)
      (class-empty)
      (class-value))))

(defn secret-error-code [class :string] :string
  ;; map classify-fetched class → :secret/* bare name for host keyword
  (if (string=? class (class-empty))
    (string-concat (error-code-prefix) (class-empty))
    (if (string=? class (class-not-found))
      (string-concat (error-code-prefix) (class-not-found))
      (if (string=? class (class-fetch))
        (string-concat (error-code-prefix) (class-fetch))
        (string-concat (error-code-prefix) (class-unknown))))))

(defn secret-error-message [class :string] :string
  (if (string=? class (class-empty))
    (msg-empty)
    (if (string=? class (class-not-found))
      (msg-not-found)
      (if (string=? class (class-fetch))
        (msg-fetch)
        (msg-unknown)))))

(defn reply-is-value? [class :string] :i64
  (if (string=? class (class-value)) 1 0))
