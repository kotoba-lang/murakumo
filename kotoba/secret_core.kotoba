(ns secret-core
  (:export [token-secret-name token-secret-env
            service-token-name service-token-env
            metrics-token-name metrics-token-env
            quic-cert-path-name quic-cert-path-env
            quic-key-path-name quic-key-path-env
            max-env-name max-path-ref
            blank? ws? valid-env-var-name? valid-path-ref-unix?
            env-for-secret-name known-secret-name?
            reply-tag classify-fetched]))

;; W6 pure-planner oracle — murakumo.secret name/policy core.
;; env-fetch / map-fetch / kagi-fetch / System.getenv stay host.
;; valid-path-ref-unix?: absolute = leading / (clj File/isAbsolute host-projected
;; via same string rules for POSIX paths used in tests).
;; Parity: test/murakumo/secret_kotoba_parity_test.clj

(defn token-secret-name [] :string "murakumo-token")
(defn token-secret-env [] :string "MURAKUMO_TOKEN_SECRET")
(defn service-token-name [] :string "murakumo-service-token")
(defn service-token-env [] :string "MURAKUMO_SERVICE_TOKEN")
(defn metrics-token-name [] :string "murakumo-metrics-token")
(defn metrics-token-env [] :string "MURAKUMO_METRICS_TOKEN")
(defn quic-cert-path-name [] :string "murakumo-quic-cert-path")
(defn quic-cert-path-env [] :string "MURAKUMO_QUIC_CERT")
(defn quic-key-path-name [] :string "murakumo-quic-key-path")
(defn quic-key-path-env [] :string "MURAKUMO_QUIC_KEY")

(defn max-env-name [] :i64 256)
(defn max-path-ref [] :i64 1024)

(defn ws? [c :string] :i64
  (if (string=? c " ")
    1
    (if (string=? c "\n")
      1
      (if (string=? c "\t")
        1
        (if (string=? c "\r") 1 0)))))

(defn blank? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      1
      (if (= (ws? (string-substring s 0 1)) 1)
        (blank? (string-substring s 1 n))
        0))))

(defn valid-env-var-name? [env-name :string] :i64
  ;; cljc: not blank, no * / \\ space, length ≤ 256
  (if (= (blank? env-name) 1)
    0
    (if (< (max-env-name) (string-byte-length env-name))
      0
      (if (string-contains? env-name "*")
        0
        (if (string-contains? env-name "/")
          0
          (if (string-contains? env-name "\\")
            0
            (if (string-contains? env-name " ") 0 1)))))))

(defn valid-path-ref-unix? [p :string] :i64
  ;; cljc valid-path-ref? for POSIX absolute paths (leading /)
  (if (= (blank? p) 1)
    0
    (if (< (max-path-ref) (string-byte-length p))
      0
      (if (string-contains? p "\0")
        0
        (if (string-contains? p "-----BEGIN")
          0
          (if (string-contains? p "*")
            0
            (let [n (string-byte-length p)]
              (if (< n 1)
                0
                (if (string=? (string-substring p 0 1) "/") 1 0)))))))))

(defn known-secret-name? [name :string] :i64
  (if (string=? name (token-secret-name))
    1
    (if (string=? name (service-token-name))
      1
      (if (string=? name (metrics-token-name))
        1
        (if (string=? name (quic-cert-path-name))
          1
          (if (string=? name (quic-key-path-name)) 1 0))))))

(defn env-for-secret-name [name :string] :string
  ;; known-env-secrets lookup; empty ≡ unknown
  (if (string=? name (token-secret-name))
    (token-secret-env)
    (if (string=? name (service-token-name))
      (service-token-env)
      (if (string=? name (metrics-token-name))
        (metrics-token-env)
        (if (string=? name (quic-cert-path-name))
          (quic-cert-path-env)
          (if (string=? name (quic-key-path-name))
            (quic-key-path-env)
            ""))))))

(defn reply-tag [kind :string] :string
  ;; kit-shaped :tag bare names for value | not-found | empty | fetch
  (if (string=? kind "value")
    "value"
    (if (string=? kind "not-found")
      "not-found"
      (if (string=? kind "empty")
        "empty"
        (if (string=? kind "fetch") "fetch" "unknown")))))

(defn classify-fetched [missing :i64 blank :i64] :string
  ;; map-fetch / fn-fetch pure classification of host-projected presence
  (if (= missing 1)
    "not-found"
    (if (= blank 1)
      "empty"
      "value")))
