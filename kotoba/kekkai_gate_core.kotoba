(ns kekkai-gate-core
  (:schemas {;; T5.2 native guest record wire
             :kekkai/denial [:record :kekkai/denial
                             [[:name :string] [:status :string]]]})
  (:export [default-ledger-path strip-trailing-newlines parse-status-out
            authorized? denial-line-of default-kekkai-dir-under
            cli-bin cli-alias-flag cli-main-flag cli-main-ns
            status-authorized status-unknown
            denial-prefix denial-mid denial-suffix
            kekkai-dir-suffix]))

;; W6 pure-planner oracle cutover first slice (murakumo-pure-planners-v1).
;; Portable string core of murakumo.kekkai.gate. No capabilities.
;; Guest profile: string=? / string-contains? still yield :i64 (0/1) words
;; interior; product predicates (authorized?) return profile-5 :bool.
;; Residual status/denial-line/dir tokens dual-source; helpers recompose.
;; cli-argv fragments dual-source for host vector assembly.
;; T5.2: multi-scalar denial inputs take single guest records.
;; Parity: test/murakumo/kekkai_gate_kotoba_parity_test.clj

(defn default-ledger-path [] :string
  "kekkai-tailnet.edn")

;; ── residual status / denial-line / dir tokens ───────────────────────

(defn status-authorized [] :string
  ;; admitted membership status in the kekkai ledger
  "authorized")

(defn status-unknown [] :string
  ;; empty subprocess output / absent ledger node
  "unknown")

(defn denial-prefix [] :string
  "[kekkai] ")

(defn denial-mid [] :string
  ": not authorized (")

(defn denial-suffix [] :string
  ") — excluded from fleet ops")

(defn kekkai-dir-suffix [] :string
  ;; default sibling checkout under HOME
  "/github/com-junkawasaki/orgs/kotoba-lang/kekkai")

(defn strip-trailing-newlines [s :string] :string
  (string-replace-all s "\n" ""))

(defn parse-status-out [out :string] :string
  (let [s (strip-trailing-newlines out)]
    (if (string=? s "")
      (status-unknown)
      s)))

(defn authorized? [status :string] :bool
  ;; Profile 5: real :bool predicate (not 0/1 i64).
  (string=? status (status-authorized)))

(defn denial-line-of [x [:ref :kekkai/denial]] :string
  ;; T5.2 native: name+status
  (string-concat
   (denial-prefix)
   (string-concat
    (record-get x :name)
    (string-concat
     (denial-mid)
     (string-concat (record-get x :status) (denial-suffix))))))

(defn default-kekkai-dir-under [home :string] :string
  (string-concat home (kekkai-dir-suffix)))

(defn cli-bin [] :string "clojure")

(defn cli-alias-flag [] :string "-M")

(defn cli-main-flag [] :string "-m")

(defn cli-main-ns [] :string "kekkai.cli")
