(defn test-payload [] :bool
  (and (= (topology-payload-problem (tv-p-ok)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-no-slash)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-8797)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-disabled)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-extra-field)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-no-roles)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-model-128)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-model-64-pairs)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-two-nodes)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-no-replicas)) "topology/ok")
       (= (topology-payload-problem (tv-p-ok-two-replicas)) "topology/ok")
       (= (topology-payload-problem (tv-p-revision-zero)) "topology/invalid-structure")
       (= (topology-payload-problem (tv-p-nodes-empty)) "topology/invalid-structure")
       (= (topology-payload-problem (tv-p-nodes-missing)) "topology/invalid-structure")
       (= (topology-payload-problem (tv-p-nodes-object)) "topology/invalid-structure")
       (= (topology-payload-problem (tv-p-gateways-17)) "topology/invalid-structure")
       (= (topology-payload-problem (tv-p-nodes-duplicate)) "topology/duplicate-identity")
       (= (topology-payload-problem (tv-p-gateways-duplicate)) "topology/duplicate-identity")
       (= (topology-payload-problem (tv-p-name-underscore)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-name-empty)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-name-number)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-https)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-port-8000)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-no-port)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-private-10)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-second-128)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-octet-256)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-path)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-query)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-userinfo)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-url-loopback)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-enabled-string)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-gateway-url)) "topology/invalid-endpoint")
       (= (topology-payload-problem (tv-p-owner-short)) "topology/invalid-roles")
       (= (topology-payload-problem (tv-p-owner-upper)) "topology/invalid-roles")
       (= (topology-payload-problem (tv-p-owner-missing)) "topology/invalid-roles")
       (= (topology-payload-problem (tv-p-roles-9)) "topology/invalid-roles")
       (= (topology-payload-problem (tv-p-role-audio)) "topology/invalid-roles")
