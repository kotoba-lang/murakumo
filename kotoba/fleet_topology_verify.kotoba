(defn- tv-trust-dup [] :string "op1=did:key:z6MktwupdmLXVVqTzCw4i46r4uGyosGXRnR3XjN4Zq7oMMsw,opx=did:key:z6MktwupdmLXVVqTzCw4i46r4uGyosGXRnR3XjN4Zq7oMMsw")

(defn test-topology [] :bool
  (and (= (topology-verdict (tv-doc-single) (tv-trust1) 1 6) "topology/ok")
       (= (topology-revision (tv-doc-single)) 7)
       (= (topology-verdict (tv-doc-single) (tv-trust1) 1 7) "intent/not-advancing")
       (= (topology-verdict (tv-doc-quorum) (tv-trust3) 2 6) "topology/ok")
       (= (topology-verdict (tv-doc-one-of-two) (tv-trust3) 2 6) "topology/needs-signatures")
       (= (topology-verdict (tv-doc-one-of-two) (tv-trust3) 1 6) "topology/ok")
       ;; the signature is over revision 7; the payload says 8
       (= (topology-verdict (tv-doc-tampered) (tv-trust1) 1 6) "topology/needs-signatures")
       ;; op3's signature under op1's id counts for nobody
       (= (topology-verdict (tv-doc-mislabeled) (tv-trust3) 1 6) "topology/needs-signatures")
       (= (topology-verdict (tv-doc-duplicate-payload) (tv-trust1) 1 6) "topology/not-strict-json")
       (= (topology-verdict (tv-doc-float) (tv-trust1) 1 6) "topology/not-canonical-domain")
       ;; one key counts once, legacy and entry together
       (= (topology-verdict (tv-doc-same-key-twice) (tv-trust3) 2 6) "topology/needs-signatures")
       (= (topology-verdict (tv-doc-schema-2) (tv-trust1) 1 6) "topology/schema")
       ;; signed by op1, but validate! refuses its endpoint
       (= (topology-verdict (tv-doc-signed-bad-endpoint) (tv-trust1) 1 6) "topology/invalid-endpoint")
       (= (topology-verdict (tv-doc-single) (tv-trust-dup) 1 6) "topology/bad-trust")
       (= (topology-verdict (tv-doc-single) (tv-trust1) 2 6) "topology/bad-trust")
       (= (topology-verdict (tv-doc-single) "" 1 6) "topology/bad-trust")
       (= (topology-verdict (tv-bytes "{\"signature\":\"x\"}") (tv-trust1) 1 6) "topology/no-payload")))

