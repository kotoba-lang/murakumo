;; murakumo.fleet-topology-verify -- the operator-signed topology (L1 of
;; ADR-2610071730, src/murakumo/infer/replicated_topology.cljk) verified in a
;; static image (Linear JUN-287; com-junkawasaki/root ADR-2610222140 §1).
;;
;;   topology-verdict  document bytes, the trust, a threshold and the
;;                     revision held now -> "topology/ok" or the first
;;                     refusal, in this order:
;;     1. over 262144 bytes (replicated_topology bounded!)  topology/too-large
;;     2. not strict JSON (jcs.reader)                       topology/not-strict-json
;;     3. no "payload" object                                topology/no-payload
;;     4. the payload has no canonical form here             topology/not-canonical-domain
;;     5. a malformed trust or threshold                     topology/bad-trust
;;     6. fewer than threshold DISTINCT trusted keys signed the canonical
;;        payload                                            topology/needs-signatures
;;     7. schema is not 1                                    topology/schema
;;     8. the payload fails replicated_topology validate!    topology-payload-problem's
;;        reason: invalid-structure, duplicate-identity, invalid-endpoint,
;;        invalid-roles or invalid-policy
;;     9. the revision does not advance (fleet_intent_core's revision-verdict)
;;   topology-revision the payload's revision, -1 when there is none
;;
;; As replicated_topology's verify! does: the signed bytes are the canonical
;; re-encoding of the payload (`encoded`: keys sorted, no spaces), not the
;; bytes as they arrive, so they are rebuilt with json-canonical-bytes. A
;; legacy "signature" counts for whichever trusted key it verifies against;
;; each "signatures" entry {key, signature} counts for its own key id; a key
;; counts once however often it signed. The trust is "id=did:key,..." (1..8
;; entries, distinct ids and keys): the operators' keys as did:key, the form
;; the host derives from its PEM files once.
;;
;; topology-payload-problem is validate! with allow-loopback false: structure,
;; duplicate identities, endpoints, owner-ids and roles, resilience policy, in
;; validate!'s order. Its endpoint check is a strict subset of endpoint?'s
;; WHATWG URL parsing (see tv-endpoint?).
;;
;; Composition order: sha2.core, ed25519.selfhost, jcs.reader, tsukasa
;; ledger_core and node_state, fleet_node_enrollment, fleet_intent_core, this
;; file. docs/topology-verify.md has the gate.
(ns murakumo.fleet-topology-verify
  (:export [topology-verdict topology-revision topology-payload-problem test-topology test-payload]))

(defn- tv-bytes [s :string] :vector-i64 (vector-i64-from-bytes (string-to-utf8 s)))

(defn- tv-root [b :vector-i64] :i64
  (loop [i 0] (if (and (< i (vector-count b)) (let [c (vector-at b i)] (or (= c 32) (= c 9) (= c 10) (= c 13)))) (recur (+ i 1)) i)))

;; trust entries "id=did" separated by ","
(defn- tv-count [trust :string] :i64
  (let [b (tv-bytes trust)]
    (if (= (vector-count b) 0) 0
      (loop [i 0 n 1] (if (= i (vector-count b)) n (recur (+ i 1) (if (= (vector-at b i) 44) (+ n 1) n)))))))

;; part 0: the id, part 1: the did, of entry k
(defn- tv-part [trust :string k :i64 part :i64] :string
  (let [b (tv-bytes trust)]
    (loop [i 0 e 0 start 0 eq -1]
      (let [c (if (< i (vector-count b)) (vector-at b i) 44)]
        (cond (= c 44)
              (if (= e k)
                (if (< eq 0) "" (if (= part 0) (string-substring trust start eq) (string-substring trust (+ eq 1) i)))
                (if (>= i (vector-count b)) "" (recur (+ i 1) (+ e 1) (+ i 1) -1)))
              (and (= c 61) (< eq 0)) (recur (+ i 1) e start i)
              :else (recur (+ i 1) e start eq))))))

(defn- tv-trust-ok? [trust :string] :bool
  (let [n (tv-count trust)]
    (and (>= n 1) (<= n 8)
         (loop [x 0]
           (if (= x n) true
             (let [id (tv-part trust x 0) did (tv-part trust x 1)]
               (if (and (> (string-length id) 0) (= (did-key-problem did) "enroll/ok")
                        (loop [y 0] (if (= y x) true (if (or (= (tv-part trust y 0) id) (= (tv-part trust y 1) did)) false (recur (+ y 1))))))
                 (recur (+ x 1)) false)))))))

(defn- tv-text [b :vector-i64 obj :i64 key :string] :string
  (let [v (json-member b obj key)] (if (and (>= v 0) (= (json-kind b v) 3)) (json-string b v) "")))

;; did the key id/did sign text, through the legacy signature or its own entry?
(defn- tv-signed? [b :vector-i64 root :i64 id :string did :string text :string] :bool
  (let [legacy (tv-text b root "signature")
        sigs (json-member b root "signatures")]
    (or (and (> (string-length legacy) 0) (= (statement-problem did text legacy) "enroll/ok"))
        (and (>= sigs 0) (= (json-kind b sigs) 2)
             (loop [k 0]
               (let [e (json-element b sigs k)]
                 (cond (< e 0) false
                       (and (= (json-kind b e) 1) (= (tv-text b e "key") id)
                            (= (statement-problem did text (tv-text b e "signature")) "enroll/ok")) true
                       :else (recur (+ k 1)))))))))

(defn topology-revision [doc :vector-i64] :i64
  (if (not (json-valid? doc)) -1
    (let [p (json-member doc (tv-root doc) "payload") r (if (>= p 0) (json-member doc p "revision") -1)]
      (if (and (>= r 0) (json-int-ok? doc r)) (json-int doc r) -1))))

;; ---------------------------------------------------------------------------
;; replicated_topology validate!, with allow-loopback false (the voter's and
;; resident's default)

(defn- tv-skip [b :vector-i64 i :i64] :i64
  (loop [j i] (if (and (< j (vector-count b)) (let [c (vector-at b j)] (or (= c 32) (= c 9) (= c 10) (= c 13)))) (recur (+ j 1)) j)))

;; UTF-16 code units of the UTF-8 bytes [s, e), as JavaScript's count
(defn- tv-u16 [b :vector-i64 s :i64 e :i64] :i64
  (loop [i s n 0] (if (>= i e) n (let [c (vector-at b i)] (recur (+ i 1) (cond (and (>= c 128) (<= c 191)) n (>= c 240) (+ n 2) :else (+ n 1)))))))

;; a string value's length in UTF-16 code units, -1 when it is not a string
(defn- tv-str-len [b :vector-i64 v :i64] :i64
  (if (or (< v 0) (not (= (json-kind b v) 3))) -1 (let [d (json-string-bytes b v)] (tv-u16 d 0 (vector-count d)))))

;; [A-Za-z0-9-]+
(defn- tv-name-ok? [s :string] :bool
  (let [b (tv-bytes s)]
    (and (> (vector-count b) 0)
         (loop [i 0] (if (= i (vector-count b)) true
                       (let [c (vector-at b i)]
                         (if (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 45)) (recur (+ i 1)) false)))))))

;; [a-f0-9-]{36}
(defn- tv-owner-ok? [s :string] :bool
  (let [b (tv-bytes s)]
    (and (= (vector-count b) 36)
         (loop [i 0] (if (= i 36) true
                       (let [c (vector-at b i)]
                         (if (or (and (>= c 97) (<= c 102)) (and (>= c 48) (<= c 57)) (= c 45)) (recur (+ i 1)) false)))))))

;; the k-th of the dot-separated octets of h: decimal 0..255 without a leading
;; zero, or -1
(defn- tv-octet [h :string k :i64] :i64
  (let [b (tv-bytes h)]
    (loop [i 0 part 0 start 0]
      (let [end (or (= i (vector-count b)) (= (vector-at b i) 46))]
        (cond (and end (= part k))
              (let [n (- i start)]
                (if (or (< n 1) (> n 3) (and (> n 1) (= (vector-at b start) 48))) -1
                  (loop [j start v 0]
                    (if (= j i) (if (> v 255) -1 v)
                      (let [c (vector-at b j)] (if (and (>= c 48) (<= c 57)) (recur (+ j 1) (+ (* v 10) (- c 48))) -1))))))
              (= i (vector-count b)) -1
              end (recur (+ i 1) (+ part 1) (+ i 1))
              :else (recur (+ i 1) part start))))))

(defn- tv-dots [h :string] :i64
  (let [b (tv-bytes h)] (loop [i 0 n 0] (if (= i (vector-count b)) n (recur (+ i 1) (if (= (vector-at b i) 46) (+ n 1) n))))))

;; endpoint?: "http://" a.b.c.d ":" 8796 or 8797, then "/" or nothing, with
;; a = 100 and 64 <= b <= 127 (the tailnet). This is a subset of what endpoint?
;; accepts through WHATWG URL parsing, which also normalizes, e.g., an
;; upper-case scheme or an octal octet; those are refused here.
(defn- tv-endpoint? [url :string] :bool
  (and (= (string-index-of url "http://") 0)
       (let [r (string-substring url 7 (string-length url)) k (string-index-of r ":")]
         (and (> k 0)
              (let [h (string-substring r 0 k) p (string-substring r (+ k 1) (string-length r))]
                (and (or (= p "8796") (= p "8797") (= p "8796/") (= p "8797/"))
                     (= (tv-dots h) 3) (= (tv-octet h 0) 100)
                     (>= (tv-octet h 1) 64) (<= (tv-octet h 1) 127)
                     (>= (tv-octet h 2) 0) (>= (tv-octet h 3) 0)))))))

;; an entry's identity for the duplicate check, as (map :node entries): the
;; node value's canonical bytes, "" for nil (absent, null or not an object)
(defn- tv-ident [b :vector-i64 e :i64] :string
  (let [v (if (= (json-kind b e) 1) (json-member b e "node") -1)]
    (if (or (< v 0) (= (json-kind b v) 7)) "" (string-from-utf8 (bytes-from-vector-i64 (json-canonical-bytes b v))))))

(defn- tv-unique? [b :vector-i64 arr :i64] :bool
  (let [n (json-count b arr)]
    (loop [i 0 j 1]
      (cond (>= i n) true
            (>= j n) (recur (+ i 1) (+ i 2))
            (= (tv-ident b (json-element b arr i)) (tv-ident b (json-element b arr j))) false
            :else (recur i (+ j 1))))))

(defn- tv-boolean? [b :vector-i64 v :i64] :bool (and (>= v 0) (or (= (json-kind b v) 5) (= (json-kind b v) 6))))

;; every entry: a name, an endpoint and a boolean enabled
(defn- tv-entries-ok? [b :vector-i64 arr :i64] :bool
  (loop [k 0]
    (let [e (json-element b arr k)]
      (cond (< e 0) true
            (and (= (json-kind b e) 1) (tv-name-ok? (tv-text b e "node")) (tv-endpoint? (tv-text b e "url"))
                 (tv-boolean? b (json-member b e "enabled")))
            (recur (+ k 1))
            :else false))))

;; a role: kind text or image, a model of 1..128 UTF-16 code units
(defn- tv-role-ok? [b :vector-i64 r :i64] :bool
  (and (= (json-kind b r) 1)
       (let [kind (tv-text b r "kind")] (or (= kind "text") (= kind "image")))
       (let [n (tv-str-len b (json-member b r "model"))] (and (>= n 1) (<= n 128)))))

(defn- tv-roles-ok? [b :vector-i64 rs :i64] :bool
  (loop [j 0] (let [r (json-element b rs j)] (cond (< r 0) true (tv-role-ok? b r) (recur (+ j 1)) :else false))))

;; every node: an owner-id, at most 8 roles, each well formed
(defn- tv-nodes-roles-ok? [b :vector-i64 arr :i64] :bool
  (loop [k 0]
    (let [e (json-element b arr k)
          rs (if (>= e 0) (json-member b e "roles") -1)]
      (cond (< e 0) true
            (and (tv-owner-ok? (tv-text b e "owner-id")) (>= rs 0) (= (json-kind b rs) 2) (<= (json-count b rs) 8) (tv-roles-ok? b rs))
            (recur (+ k 1))
            :else false))))

;; policies.minimum-replicas: an object whose every key has 1..128 UTF-16
;; code units and whose every value is an integer 1..256. jcs.reader keys
;; carry no escapes, so a key's bytes lie between its quotes.
(defn- tv-replicas-ok? [b :vector-i64 o :i64] :bool
  (loop [i (tv-skip b (+ o 1))]
    (cond (= (vector-at b i) 125) true
          (not (= (vector-at b i) 34)) false
          :else
          (let [ks (+ i 1)
                ke (loop [j ks] (if (= (vector-at b j) 34) j (recur (+ j 1))))
                v (tv-skip b (+ (tv-skip b (+ ke 1)) 1))
                nxt (tv-skip b (json-end b v))
                n (tv-u16 b ks ke)]
            (cond (not (and (>= n 1) (<= n 128) (= (json-kind b v) 4) (json-int-ok? b v) (>= (json-int b v) 1) (<= (json-int b v) 256))) false
                  (= (vector-at b nxt) 44) (recur (tv-skip b (+ nxt 1)))
                  :else true)))))

;; validate!'s refusals, in its order, for a document whose payload is an
;; object of strict JSON
(defn topology-payload-problem [doc :vector-i64] :string
  (let [p (json-member doc (tv-root doc) "payload")
        rv (json-member doc p "revision") ns (json-member doc p "nodes") gs (json-member doc p "gateways")
        pol (json-member doc p "policies")
        mr (if (and (>= pol 0) (= (json-kind doc pol) 1)) (json-member doc pol "minimum-replicas") -1)]
    (cond (not (and (>= rv 0) (= (json-kind doc rv) 4) (json-int-ok? doc rv) (> (json-int doc rv) 0)
                    (>= ns 0) (= (json-kind doc ns) 2) (>= (json-count doc ns) 1) (<= (json-count doc ns) 256)
                    (>= gs 0) (= (json-kind doc gs) 2) (>= (json-count doc gs) 1) (<= (json-count doc gs) 16)))
          "topology/invalid-structure"
          (not (tv-unique? doc ns)) "topology/duplicate-identity"
          (not (tv-entries-ok? doc ns)) "topology/invalid-endpoint"
          (not (tv-unique? doc gs)) "topology/duplicate-identity"
          (not (tv-entries-ok? doc gs)) "topology/invalid-endpoint"
          (not (tv-nodes-roles-ok? doc ns)) "topology/invalid-roles"
          (not (and (>= mr 0) (= (json-kind doc mr) 1) (tv-replicas-ok? doc mr))) "topology/invalid-policy"
          :else "topology/ok")))

(defn topology-verdict [doc :vector-i64 trust :string threshold :i64 current :i64] :string
  (cond (> (vector-count doc) 262144) "topology/too-large"
        (not (json-valid? doc)) "topology/not-strict-json"
        :else
        (let [root (tv-root doc) p (json-member doc root "payload")]
          (if (or (< p 0) (not (= (json-kind doc p) 1))) "topology/no-payload"
            (let [cb (json-canonical-bytes doc p)]
              (cond (= (vector-count cb) 0) "topology/not-canonical-domain"
                    (or (not (tv-trust-ok? trust)) (< threshold 1) (> threshold (tv-count trust))) "topology/bad-trust"
                    :else
                    (let [text (string-from-utf8 (bytes-from-vector-i64 cb))
                          n (loop [x 0 n 0]
                              (if (= x (tv-count trust)) n
                                (recur (+ x 1) (if (tv-signed? doc root (tv-part trust x 0) (tv-part trust x 1) text) (+ n 1) n))))
                          s (json-member doc p "schema")]
                      (cond (< n threshold) "topology/needs-signatures"
                            (not (and (>= s 0) (json-int-ok? doc s) (= (json-int doc s) 1))) "topology/schema"
                            (not (= (topology-payload-problem doc) "topology/ok")) (topology-payload-problem doc)
                            :else (let [v (revision-verdict current (topology-revision doc))]
                                    (if (= v "intent/ok") "topology/ok" v))))))))))

;; ---------------------------------------------------------------------------
;; test-topology: documents serialized with unsorted keys and spaces, signed
;; over the canonical payload by OpenSSL 3 with RFC 8032 keys 1-3
;; (docs/evidence/topology-vectors-20261023.py).

(defn- tv-doc-single [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\"}"))
(defn- tv-doc-quorum [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signatures\": [{\"key\": \"op2\", \"signature\": \"PLQ-jyZRUu_hB3-hbmO64XnqvuPj_tkaq_0LOYoZf5oUOIlQD-xB9Gip0QberAEc2GZZQ7clHmUlo7WQm_C0Cw\"}, {\"key\": \"op1\", \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\"}]}"))
(defn- tv-doc-one-of-two [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signatures\": [{\"key\": \"op1\", \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\"}]}"))
(defn- tv-doc-tampered [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 8, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\"}"))
(defn- tv-doc-mislabeled [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signatures\": [{\"key\": \"op1\", \"signature\": \"HS-NlQetL6JXb79EpC0wwZuMwW5JjZR2BAATgoeMVjFWf5_p-l9TOJ1VqODy5qCUp1TpwQcxJL4C9bg1Cm2FAw\"}]}"))
(defn- tv-doc-duplicate-payload [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 8, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\"}"))
(defn- tv-doc-float [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}, \"weight\": 0.5}, \"signature\": \"6bFuhSq6pDOqhENX0Rm2ZZPzNU6TbraXv5zXvDy_MkniHSoC9cr5AkBny6JKIPZfltttzN1681pIvaIaD-8IBw\"}"))
(defn- tv-doc-same-key-twice [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\", \"signatures\": [{\"key\": \"op1\", \"signature\": \"eN2z9Zt2ASZITkcK7WzV_55DvQtIfFDH6vHz3NQDXNanAgps7rQ6WH2NcxOf1WiJNKUTEXSsZS_N9oL4QcjcAw\"}]}"))
(defn- tv-doc-schema-2 [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 2, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8796/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signature\": \"ZDgEjVgQ5JnykhuG0e5KdLHI1opQPihpwjGGq7TOOuRLvTbtbzgvxBWAM_FvBKCKHEwrVesv41O4Lv4TfpKTDw\"}"))
(defn- tv-doc-signed-bad-endpoint [] :vector-i64 (tv-bytes "{\"payload\": {\"schema\": 1, \"revision\": 7, \"nodes\": [{\"node\": \"b70\", \"url\": \"http://100.64.0.10:8000/\", \"enabled\": true, \"owner-id\": \"01234567-89ab-cdef-0123-456789abcdef\", \"roles\": [{\"kind\": \"text\", \"model\": \"m1\"}]}], \"gateways\": [{\"node\": \"gw\", \"url\": \"http://100.64.0.1:8796/\", \"enabled\": true}], \"policies\": {\"minimum-replicas\": {\"m1\": 1}}}, \"signature\": \"uSqGXSXKiIWWwaOp332pPHNHz9SUCJWFbaZXeRDBXjwa8AWkQMwQmmuCK9s1nyPjWn6Hnuoxx1tytTZ3H80vAw\"}"))
