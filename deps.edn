{:paths ["src" "resources"]
 :deps {io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/edn.git"
         :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}
        
        io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}
        io.github.kotoba-lang/http {:git/sha "2de805b4bb275e145437928081f7d0d80373b5f3"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        babashka/process {:mvn/version "0.6.23"}
        ;; Edge model/protocol contract. The host kernel remains llama.cpp;
        ;; inference -> torch -> num owns wire/resource/byte admission.
        ;; b7fc5c04 is the first inference tip carrying
        ;; kotodama.inference.runtime/performance, which murakumo.infer.profile
        ;; calls. #353 asked for c07c2c78; that commit is NOT reachable from
        ;; inference's default branch (compare -> diverged, behind_by 1) -- it
        ;; was the head of the closed PR kotoba-lang/inference#26, whose content
        ;; landed on inference main instead.
        io.github.kotoba-lang/inference
        {:git/sha "b7fc5c04221f401d299a47bcf74e048fa4384b65"}
        io.github.kotoba-lang/abi
        {:git/sha "848c035f7d1ac850ddc2391baa70a2f15e6c4401"}
        ;; kotoba-lang/ed25519 was renamed to kotoba-lang/org-ietf-ed25519.
        ;; The redirect kept the old coordinate resolving, but tools.deps
        ;; dedupes by the coordinate SYMBOL -- and org-w3-did and
        ;; org-w3-vc-bitstring-status-list already name the repository by its
        ;; current name, so this file was putting ed25519.core on the classpath
        ;; twice from two checkouts. Same sha: one repository, one revision.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        ;; Enrolment and release admission: murakumo is the fleet plane, so it
        ;; consumes aiueos's decisions rather than restating them (aiueos's own
        ;; rule -- enforcement layers import aiueos, never the reverse), names
        ;; device keys with the library that owns the did:key envelope, and
        ;; reads revocation with the library that owns the status-list format.
        ;; None of the three is reimplemented here.
        io.github.kotoba-lang/aiueos
        {:git/sha "0bd6e3ab49a3679a72777edd3e465ff58713f5b5"}
        io.github.kotoba-lang/org-w3-did
        {:git/sha "c430e98024675a0873f49889049b4909e85fa860"}
        io.github.kotoba-lang/org-w3-vc-bitstring-status-list
        {:git/sha "9a1e874950674c2ba0ab3cfbb383098130f65fa4"}
        ;; W6 product-shell oracle authority: execute precompiled pure-planner
        ;; KIR (resources/murakumo/oracle/*.kir.edn). Compiler stays :test-only;
        ;; this is the thin runtime side of the dual-source cutover.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         ;; Advanced with the test-only amu pin below: they are one unit.
         :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}
        tech.kwik/kwik {:mvn/version "0.10.10"}
        org.bouncycastle/bcpkix-jdk18on {:mvn/version "1.78.1"}
        ;; witness-quorum's pre-commit orchestrator, wired onto overlay QUIC
        ;; in murakumo.overlay.witness-transport (ADR-2607110300 Phase 2),
        ;; plus reputation (Phase 4). Pin advanced to the ADR-2608055000 G1
        ;; merge, which removed slashing.clj: a quorum verdict now moves
        ;; reputation and never bond, `write-with-witnesses-precommit-and-slash`
        ;; became `-and-record`, and the result carries `:outcomes` instead of
        ;; `:slashed`. murakumo.overlay.witness-write is the only caller, and
        ;; it is updated in the same change -- the previous pin (e6fe9b7, #4)
        ;; still has the old names, so this pin and that file move together.
        io.github.kotoba-lang/witness-quorum
        {:git/sha "73fef67a3c6ea7621a96c786fbfd998c12a730d0"}
        ;; kekkai's TailnetGovernor/CoordinationActor, for the treasury/
        ;; release + witness/dispute end-to-end glue (ADR-2607110300 Phase 3,
        ;; murakumo.overlay.witness-treasury). JVM-only, same as
        ;; witness-write/witness-transport -- not part of the bb-portable
        ;; CLI path (bb.edn's test task excludes this, same reason as the
        ;; kwik/witness-quorum-dependent overlay code).
        io.github.kotoba-lang/kekkai
        {:git/sha "87a16440ce48d9fe6ee9645e452354181c97e5e5"}}
 :aliases
 {;; Operator start is Kotoba, not a Clojure alias:
  ;;   kotoba run kotoba/desired.kotoba
  ;;   kotoba run kotoba/factory.kotoba
  ;;   kotoba run kotoba/quic_driver.kotoba
  ;;   kotoba run kotoba/quic_cert.kotoba
  ;; There is no kotoba -M. :desired / :factory / :quic-* aliases are gone.
  ;; Leftover Java (kekkai seal, Ed25519 issue, kwik/BouncyCastle listen)
  ;; stays in src/ as a library gap — not a start path.
  ;;
  ;; offline workspace dev — pin witness-quorum/kekkai to local checkouts
  :dev {:override-deps
        {io.github.kotoba-lang/inference {:local/root "../inference"}
         io.github.kotoba-lang/torch {:local/root "../torch"}
         io.github.kotoba-lang/num {:local/root "../num"}
         io.github.kotoba-lang/witness-quorum {:local/root "../witness-quorum"}
         io.github.kotoba-lang/kekkai {:local/root "../kekkai"}}}
  ;; Regenerate resources/murakumo/oracle/*.kir.edn from kotoba/*_core.kotoba:
  ;;   clojure -M:test:gen
  ;; ADR-260731-w6-t62 documents `-M:test -m murakumo.kotoba-oracle-gen`, which
  ;; does not work: command-line main opts are APPENDED to an alias's
  ;; :main-opts rather than replacing them, so the -m reaches
  ;; cognitect.test-runner as an unknown option. A later alias's :main-opts
  ;; does win, hence this one — it carries no deps of its own and must be
  ;; combined with :test.
  :gen {:main-opts ["-m" "murakumo.kotoba-oracle-gen"]}
  ;; :gen is leftover JVM KIR rewrite (clojure -M:test:gen). It is not Kotoba
  ;; operator start and is not claimed as kotoba compile.
  ;; Fleet CI ships this repository without west siblings. Keep the HA gate
  ;; focused on the distributed inference control plane and its generated
  ;; systemd/watchdog artifacts; the broad :test suite remains the local
  ;; integration qualification path.
  ;; The two injected host clients are folded in HERE (not left to a
  ;; combined `-M:fleet-infer-test:babashka-client-host` invocation): the
  ;; fleet gate runner asserts `grep ':fleet-infer-test' deps.edn` and runs
  ;; exactly `-M:fleet-infer-test`, so an alias that needs another alias
  ;; present can never be satisfied by this runner. Folding keeps ONE
  ;; self-sufficient alias for both consumers (gh CI composes aliases, the
  ;; fleet runs one).
  ;;
  ;; #357 also meant to name a second namespace here,
  ;; murakumo.host-adapter-load-test. That file does not exist in this tree,
  ;; and cognitect.test-runner accepts `-n` for a namespace it cannot find
  ;; SILENTLY: measured 2026-09-06, `-n murakumo.infer-test` alone and
  ;; `-n murakumo.infer-test -n murakumo.host-adapter-load-test` both print
  ;; "Ran 17 tests containing 78 assertions. 0 failures, 0 errors." and both
  ;; exit 0. Naming it would make this gate look like it covers the adapter
  ;; smoke while covering nothing, so it is not named until the file lands.
  :fleet-infer-test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.babashka/http-client {:mvn/version "0.4.23"}
                http-kit/http-kit {:mvn/version "2.8.1"}}
   :main-opts ["-m" "cognitect.test-runner" "-n" "murakumo.infer-test"]}
  ;; Leftover JVM test path for the kwik/witness-quorum-dependent overlay
  ;; library (not an operator start). Default CI is kotoba compile / kotoba
  ;; run; this alias is leftover-jvm workflow_dispatch only.
  :test {;; cloud-murakumo/src is TEST-ONLY, for the API-key parity gate
         ;; (murakumo.apikey-parity-test): keys minted here must be byte-identical
         ;; to, and accepted by, the namespace that actually VERIFIES them. A
         ;; sibling path rather than a dep — if the checkout is absent tools.deps
         ;; just skips it and the parity assertions skip loudly, which is right:
         ;; a missing sibling is an environment gap, not a defect here.
         :extra-paths ["test" "../../network-awai/cloud-murakumo/src"]
         ;; kotoba-lang/compiler (hosted in the amu repository) is TEST-ONLY: the
         ;; W6 pure-planner oracle parity gate and the native qualification
         ;; sweep. abi is overridden so component/wit loads cleanly in the test
         ;; JVM.
         ;;
         ;; This abi pin does NOT have to match amu's own. Advancing it to
         ;; amu's (32ee84b) was tried and reverted: measured 2026-08-11, it
         ;; alone breaks component_authority and overlay_witness -- sign-event
         ;; rejects with :invalid-signing-input through
         ;; abi/valid-component-authority-event?. With abi held here and kir +
         ;; amu advanced, those namespaces are 0 failures and the native
         ;; qualification sweep is 35/35. The kir advance and the amu advance
         ;; are the migration; the abi advance is a separate one nobody has
         ;; done.
         :override-deps
         {io.github.kotoba-lang/abi
          {:git/url "https://github.com/kotoba-lang/abi.git"
           :git/sha "34415ce9bf2b8d37d5bc8259ba7e00f5d091eb44"}}
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; tender-native is the leftover JVM host for kexe
                      ;; artifacts (not operator start). It sits in :test
                      ;; rather than :native because a one-core canary
                      ;; (murakumo.native-canary-test) used to ride the old
                      ;; default suite: measured 2026-08-12, NOTHING invoked
                      ;; the opt-in alias -- this repo has no entry in
                      ;; scripts/fleet-ci/gates.edn. Default CI is now job
                      ;; kotoba-operator (kotoba compile wasm+web, file-on-disk,
                      ;; guest-run). Leftover JVM is leftover-jvm.yml,
                      ;; workflow_dispatch only. `oracle/open-native!` resolves
                      ;; it at call time, so nothing that only runs the
                      ;; interpreter inherits it. The full 735-export sweep
                      ;; stays opt-in.
                      io.github.kotoba-lang/tender-native
                      {:git/url "https://github.com/kotoba-lang/tender-native.git"
                       :git/sha "1915ee10a0a2af7edd252e7a0ffd67c0d4c3a167"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       ;; Profile 5 (compiler#451): comparisons/predicates are
                       ;; :bool; record :bool fields + and/or/not compose.
                       ;; compiler#453/#454: every synthesized name is
                       ;; deterministic, so shipped KIR can be compared raw.
                       ;; compiler#455: binding-some joined the same scheme, so
                       ;; the shipped KIR carries __kotoba_binding-some_N.
                       ;; compiler option-string-in-record: if-some over
                       ;; record-get of [:option :string] (T5.2 gap close).
                       ;; amu 1e21a1f types string=? / string-contains? as
                       ;; :bool (e78241d still typed them :i64).
                       :git/sha "1e21a1f56613d7d4c7628af1945ebf1cf7862ff3"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; Host-injection alias for kotoba-lang/http's Layer 3 host adapters
  ;; (kotoba.lang.http.host.babashka / .httpkit). 7c5c7b9 moved
  ;; org.babashka/http-client and http-kit OUT of top-level :deps per the
  ;; http repo's own contract: "Fleet CLIs run under Babashka, which bundles
  ;; this client. On plain JVM, add org.babashka/http-client through
  ;; :babashka-client-host — not top-level." (http @ 8642997efe — was 719a2103
  ;; whose httpkit host could not load: kotoba-lang/http#3)
  ;; src/kotoba/lang/http/host/babashka.cljc line 1; the alias itself lives
  ;; in that repo's deps.edn.) Leftover JVM tests use this alias on
  ;; workflow_dispatch only (not default CI). Without it every namespace that requires
  ;; kotoba.lang.http.host.babashka (infer/gateway, infer/media,
  ;; infer/relay_worker, infer/orchestrate) dies at load with
  ;; FileNotFoundException: babashka/http_client — measured as the main-CI
  ;; red chain from 2026-08-30 02:18 through run 33359825251 (08-31 05:14Z).
  ;; http-kit host consumers (dash, relay_server) are only exercised through
  ;; code paths the excluded overlay suites drive, but the adapter namespace
  ;; is loadable the same way, so this alias carries both clients. Supply
  ;; them with:
  ;;
  ;;   clojure -M:test:babashka-client-host
  ;;
  ;; NOT top-level: an injected host stays out of libraries that never open a
  ;; socket, which is the point of the Layer 3 host-injection design.
  :babashka-client-host
  {:extra-deps {org.babashka/http-client {:mvn/version "0.4.23"}
                http-kit/http-kit {:mvn/version "2.8.1"}}}
  ;; The same cores, RUN on the host ISA rather than accepted by the backend.
  ;; Combine with :test, which carries amu:
  ;;
  ;;   leftover: clojure -M:test:native
  ;;
  ;; Not operator start. tender-native is a leftover JVM host for kexe
  ;; artifacts in the oracle qualification sweep. Operator native, when
  ;; emitted, is bin/amu compile --target aarch64-macos --jvm-free of
  ;; kotoba/desired.kotoba or kotoba/factory.kotoba — not a *_core.kotoba.
  ;; Linux kexe-verify is HOLD; this alias does not emit a release kexe.
  :native {:extra-paths ["test-native"]
           :main-opts ["-m" "cognitect.test-runner" "-d" "test-native"]}}}
