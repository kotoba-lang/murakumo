  {:name command-token,
   :params [a],
   :result :string,
   :effects #{},
   :body
   (if
    (is-cmd-plan? a)
    (cmd-plan)
    (if
     (is-cmd-records? a)
     (cmd-records)
     (if
      (is-cmd-routes? a)
      (cmd-routes)
      (if
       (is-cmd-dial? a)
       (cmd-dial)
       (if
        (is-cmd-connect? a)
        (cmd-connect)
        (if
         (is-cmd-relay? a)
         (cmd-relay)
         (if (is-cmd-bootstrap? a) (cmd-bootstrap) ""))))))),
