       :engine/head-middle
       [[:rpc-csv :string] [:strategy :string] [:tsplit :string]]]
      h
      :strategy)
     tensor-csv
     (record-get
      [:record
       :engine/head-middle
       [[:rpc-csv :string] [:strategy :string] [:tsplit :string]]]
      h
      :tsplit)]
    (string-concat
     " --rpc "
     (string-concat
      rpc-csv
      (string-concat
       " --split-mode "
       (string-concat
        (split-mode-name strategy)
        (string-concat " --tensor-split " tensor-csv)))))),
   :param-types [[:ref :engine/head-middle]]}
