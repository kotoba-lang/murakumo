      h
      :bin-dir)
     model-path
     (record-get
      [:record
       :engine/head-front
       [[:bin-dir :string] [:model-path :string]]]
      h
      :model-path)]
    (string-concat
     bin-dir
     (string-concat "/llama-server -m " model-path))),
   :param-types [[:ref :engine/head-front]]}
  {:name rpc-csv-2,
   :params [ep0 ep1],
