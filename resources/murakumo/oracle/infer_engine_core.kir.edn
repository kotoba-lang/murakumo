  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name split-mode-name,
   :params [strategy],
   :result :string,
   :effects #{},
   :body (if (string=? strategy "tensor") "row" "layer"),
   :param-types [:string]}
  {:name endpoint,
   :params [e],
   :result :string,
   :effects #{},
   :body
   (string-concat
    (record-get
     [:record :engine/endpoint [[:host :string] [:port :i64]]]
     e
     :host)
    (string-concat
     ":"
     (i64-str
      (record-get
       [:record :engine/endpoint [[:host :string] [:port :i64]]]
       e
       :port)))),
   :param-types [[:ref :engine/endpoint]]}
  {:name rpc-server-cmd,
   :params [c],
   :result :string,
   :effects #{},
   :body
   (let
    [bin-dir
     (record-get
      [:record
       :engine/rpc-server
       [[:bin-dir :string]
        [:port :i64]
        [:device :string]
        [:cache :bool]
        [:cache-dir :string]]]
      c
      :bin-dir)
     port
     (record-get
      [:record
       :engine/rpc-server
       [[:bin-dir :string]
        [:port :i64]
        [:device :string]
        [:cache :bool]
        [:cache-dir :string]]]
      c
      :port)
     device
     (record-get
      [:record
       :engine/rpc-server
       [[:bin-dir :string]
        [:port :i64]
        [:device :string]
        [:cache :bool]
        [:cache-dir :string]]]
      c
      :device)
     cache
     (record-get
      [:record
       :engine/rpc-server
       [[:bin-dir :string]
        [:port :i64]
        [:device :string]
        [:cache :bool]
        [:cache-dir :string]]]
      c
      :cache)
     cache-dir
     (record-get
      [:record
       :engine/rpc-server
       [[:bin-dir :string]
        [:port :i64]
        [:device :string]
        [:cache :bool]
        [:cache-dir :string]]]
      c
      :cache-dir)
     base
     (string-concat
      bin-dir
      (string-concat
       "/rpc-server -H 0.0.0.0 -p "
       (string-concat (i64-str port) (string-concat " -d " device))))]
    (if
     cache
     (if
      (string=? cache-dir "")
      (string-concat base " -c")
      (string-concat base (string-concat " -c " cache-dir)))
     base)),
   :param-types [[:ref :engine/rpc-server]]}
  {:name embed-head-front,
   :params [bin-dir model-path pooling ctx],
   :result :string,
   :effects #{},
   :body
   (string-concat
    bin-dir
    (string-concat
     "/llama-server -m "
     (string-concat
      model-path
      (string-concat
       " --embedding --pooling "
       (string-concat
        pooling
        (string-concat " -ngl 999 -c " (i64-str ctx))))))),
   :param-types [:string :string :string :i64]}
  {:name embed-head-back,
   :params [parallel port],
   :result :string,
   :effects #{},
   :body
   (string-concat
    " --parallel "
    (string-concat
     (i64-str parallel)
     (string-concat " --host 0.0.0.0 --port " (i64-str port)))),
   :param-types [:i64 :i64]}
  {:name mlx-moe-bin,
   :params [venv],
   :result :string,
   :effects #{},
   :body
   (if
    (string=? venv "")
    "mlx-moe"
    (string-concat venv "/bin/mlx-moe")),
   :param-types [:string]}
  {:name mlx-moe-front,
   :params [venv model-repo port],
   :result :string,
   :effects #{},
   :body
   (string-concat
    (mlx-moe-bin venv)
    (string-concat
     " serve "
     (string-concat
      model-repo
      (string-concat " --host 0.0.0.0 --port " (i64-str port))))),
   :param-types [:string :string :i64]}
  {:name opt-i64-flag,
   :params [flag val present],
   :result :string,
   :effects #{},
   :body
   (if
    present
    (string-concat flag (string-concat " " (i64-str val)))
    ""),
   :param-types [:string :i64 :bool]}
  {:name opt-str-flag,
   :params [flag val present],
   :result :string,
   :effects #{},
   :body (if present (string-concat flag (string-concat " " val)) ""),
   :param-types [:string :string :bool]}
  {:name tensor-split-3,
   :params [s0 s1 s2],
   :result :string,
   :effects #{},
   :body
   (string-concat
    (i64-str s0)
    (string-concat
     ","
     (string-concat (i64-str s1) (string-concat "," (i64-str s2))))),
   :param-types [:i64 :i64 :i64]}
  {:name mlx-launch-front,
   :params [venv hosts-file model-repo max-tokens],
   :result :string,
   :effects #{},
   :body
   (string-concat
    venv
    (string-concat
     "/bin/mlx.launch --hosts "
     (string-concat
      hosts-file
      (string-concat
       " --backend ring "
       (string-concat
        venv
        (string-concat
         "/bin/mlx_lm.generate -- --model "
         (string-concat
          model-repo
          (string-concat
           " --pipeline --max-tokens "
           (i64-str max-tokens))))))))),
   :param-types [:string :string :string :i64]}
