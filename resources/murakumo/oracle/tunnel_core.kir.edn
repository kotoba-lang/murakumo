  {:name marker-prefix?,
   :params [line],
   :result :bool,
   :effects #{},
   :body
   (let
    [m
     (rc-marker)
     n
     (string-byte-length m)
     ln
     (string-byte-length line)]
    (if
     (< ln n)
     false
     (if (string=? (string-substring line 0 n) m) true false))),
   :param-types [:string]}
  {:name strip-marker-digits,
   :params [line],
   :result :string,
   :effects #{},
   :body
   (let
    [m
     (rc-marker)
     n
     (string-byte-length m)
     ln
     (string-byte-length line)]
    (if (< ln n) "" (string-substring line n ln))),
   :param-types [:string]}
