  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name wrap-cmd,
   :params [cmd],
   :result :string,
   :effects #{},
   :body
   (let
    [a
     (string-concat "( " cmd)
     b
     (string-concat a "\n); __mrc=$?; echo \"")
     c
     (string-concat b (rc-marker))]
    (string-concat c "$__mrc\"")),
   :param-types [:string]}
