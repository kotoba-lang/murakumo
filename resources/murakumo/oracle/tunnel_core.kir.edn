  {:name digit-val?,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (= (string-byte-length c) 1)
    (if (string-contains? "0123456789" c) 1 0)
    0),
   :param-types [:string]}
  {:name digit-of,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? c "0")
    0
    (if
     (string=? c "1")
     1
     (if
      (string=? c "2")
      2
      (if
       (string=? c "3")
       3
       (if
        (string=? c "4")
        4
        (if
         (string=? c "5")
         5
         (if
          (string=? c "6")
          6
          (if
           (string=? c "7")
           7
           (if (string=? c "8") 8 (if (string=? c "9") 9 -1)))))))))),
   :param-types [:string]}
  {:name trim-ws,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (let
      [c0 (string-substring s 0 1)]
      (if
       (if (string=? c0 " ") 1 (if (string=? c0 "\t") 1 0))
       (trim-ws (string-substring s 1 n))
       (let
        [c1 (string-substring s (- n 1) n)]
        (if
         (if (string=? c1 " ") 1 (if (string=? c1 "\t") 1 0))
         (trim-ws (string-substring s 0 (- n 1)))
         s)))))),
   :param-types [:string]}
  {:name parse-digits-go,
   :params [s acc],
   :result :i64,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     acc
     (let
      [c (string-substring s 0 1) d (digit-of c)]
      (if
       (< d 0)
       -1
       (parse-digits-go (string-substring s 1 n) (+ (* acc 10) d)))))),
   :param-types [:string :i64]}
  {:name parse-digits,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [t (trim-ws s) n (string-byte-length t)]
    (if (= n 0) -1 (parse-digits-go t 0))),
   :param-types [:string]}
  {:name pick-exit,
   :params [has-rc rc ssh-exit],
   :result :i64,
   :effects #{},
   :body (if (= has-rc 1) rc ssh-exit),
   :param-types [:i64 :i64 :i64]}
  {:name err-ws?,
   :params [c],
   :result :bool,
   :effects #{},
   :body
   (if
    (string=? c " ")
    true
    (if
     (string=? c "\n")
     true
     (if (string=? c "\t") true (if (string=? c "\r") true false)))),
   :param-types [:string]}
  {:name trim-err,
   :params [err],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length err)]
    (if
     (= n 0)
     err
     (if
      (err-ws? (string-substring err 0 1))
      (trim-err (string-substring err 1 n))
      (if
       (err-ws? (string-substring err (- n 1) n))
       (trim-err (string-substring err 0 (- n 1)))
       err)))),
   :param-types [:string]}
