  {:name capacity,
   :params [node-slots slots-per cores],
   :result :i64,
   :effects #{},
   :body
   (if
    (< node-slots 0)
    (if (< slots-per 0) (if (< cores 0) 1 cores) slots-per)
    node-slots),
   :param-types [:i64 :i64 :i64]}
  {:name slots,
   :params [budget-slots node-slots slots-per max-slots cores],
   :result :i64,
   :effects #{},
   :body
   (if
    (< budget-slots 0)
    (let
     [cap
      (capacity node-slots slots-per cores)
      m
      (if (< max-slots 0) 8 max-slots)
      capped
      (if (< cap m) cap m)]
     (if (< capped 1) 1 capped))
    budget-slots),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name failed?,
   :params [exit timeout error],
   :result :i64,
   :effects #{},
   :body
   (let
    [binding-some__1 error]
    (if
     (option-some?-of [:option :string] binding-some__1)
     (let [_ (option-value-of [:option :string] binding-some__1 "")] 1)
     (if
      (= timeout 1)
      1
      (let
       [binding-some__2 exit]
       (if
        (option-some?-of [:option :i64] binding-some__2)
        (let
         [e (option-value-of [:option :i64] binding-some__2 0)]
         (if (= e 0) 0 1))
        1))))),
   :param-types [[:option :i64] :i64 [:option :string]]}
  {:name can-retry?,
   :params [attempt max-attempts],
   :result :i64,
   :effects #{},
   :body (if (< attempt max-attempts) 1 0),
   :param-types [:i64 :i64]}
  {:name rem2,
   :params [n],
   :result :i64,
   :effects #{},
   :body (- n (* (quot n 2) 2)),
   :param-types [:i64]}
  {:name bit?-safe,
   :params [flags mask],
   :result :i64,
   :effects #{},
   :body (if (= 0 (rem2 (quot flags mask))) 0 1),
   :param-types [:i64 :i64]}
  {:name task-eligible?,
   :params [flags mem-bytes min-mem],
   :result :i64,
   :effects #{},
   :body
   (let
    [online
     (bit?-safe flags 1)
     labels
     (bit?-safe flags 2)
     roles
     (bit?-safe flags 4)
     not-ex
     (bit?-safe flags 8)
     allow
     (bit?-safe flags 16)
     mem-ok
     (if (< mem-bytes min-mem) 0 1)]
    (if
     (= online 0)
     0
     (if
      (= labels 0)
      0
      (if
       (= roles 0)
       0
       (if (= not-ex 0) 0 (if (= allow 0) 0 mem-ok)))))),
   :param-types [:i64 :i64 :i64]}
  {:name fill-milli,
   :params [assigned slots],
   :result :i64,
   :effects #{},
   :body (if (< slots 1) 0 (quot (* assigned 1000) slots)),
   :param-types [:i64 :i64]}
  {:name better-fill?,
   :params [fill0 fill1],
   :result :i64,
   :effects #{},
   :body (if (< fill0 fill1) 1 0),
   :param-types [:i64 :i64]}
  {:name better-task-score?,
   :params [fill0 load0 _memneg0 fill1 load1],
   :result :i64,
   :effects #{},
   :body
   (if
    (< fill0 fill1)
    1
    (if
     (< fill1 fill0)
     0
     (if (< load0 load1) 1 (if (< load1 load0) 0 2)))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name better-mem?,
   :params [memneg0 memneg1 name-ord0 name-ord1],
   :result :i64,
   :effects #{},
   :body
   (if
    (< memneg0 memneg1)
    1
    (if (< memneg1 memneg0) 0 (if (< name-ord0 name-ord1) 1 0))),
   :param-types [:i64 :i64 :i64 :i64]}
  {:name wave-of,
   :params [used slots],
   :result :i64,
   :effects #{},
   :body (if (< slots 1) 0 (quot used slots)),
   :param-types [:i64 :i64]}
  {:name slot-of,
   :params [used slots],
   :result :i64,
   :effects #{},
   :body (if (< slots 1) 0 (- used (* (quot used slots) slots))),
   :param-types [:i64 :i64]}
  {:name load-after-assign,
   :params [used],
   :result :i64,
   :effects #{},
   :body (+ used 1),
   :param-types [:i64]}
  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name rem64,
   :params [a b],
   :result :i64,
   :effects #{},
   :body (- a (* (quot a b) b)),
   :param-types [:i64 :i64]}
  {:name pad4,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (let
    [m (if (< n 0) 0 n) d (rem64 m 10000)]
    (if
     (< d 10)
     (string-concat "000" (i64-str d))
     (if
      (< d 100)
      (string-concat "00" (i64-str d))
      (if (< d 1000) (string-concat "0" (i64-str d)) (i64-str d))))),
   :param-types [:i64]}
  {:name task-id,
   :params [i],
   :result :string,
   :effects #{},
   :body (string-concat "t-" (pad4 i)),
   :param-types [:i64]}
