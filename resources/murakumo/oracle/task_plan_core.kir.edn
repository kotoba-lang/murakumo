   :param-types [:i64]}
  {:name exclude-append-marker,
   :params [],
   :result :i64,
   :effects #{},
   :body 1,
   :param-types []}
  {:name pick-task-idx-2,
   :params [ok0 ok1 fill0 fill1 load-pack],
   :result :i64,
   :effects #{},
   :body
   (let
    [B 65536 load0 (rem64 load-pack B) load1 (quot load-pack B)]
    (if
     (= ok0 0)
     (if (= ok1 0) -1 1)
     (if
      (= ok1 0)
      0
      (let
       [b (better-task-score? fill0 load0 0 fill1 load1)]
       (if (= b 2) 0 (if (= b 1) 0 1)))))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name assign-task-step-2,
   :params [load0 load1 ok0 ok1 score-pack],
   :result :i64,
   :effects #{},
   :body
   (let
    [B
     65536
     fill0
     (rem64 score-pack B)
     fill1
     (quot score-pack B)
     p
     (if
      (= ok0 0)
      (if (= ok1 0) -1 1)
      (if
       (= ok1 0)
       0
       (let
        [b (better-task-score? fill0 load0 0 fill1 load1)]
        (if (= b 2) 0 (if (= b 1) 0 1)))))
     code
     (if (< p 0) 0 (+ p 1))
     n0
     (if (= p 0) (+ load0 1) load0)
     n1
     (if (= p 1) (+ load1 1) load1)]
    (+ code (+ (* n0 B) (* n1 (* B B))))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name pick-task-fold-step,
   :params [has-champ ok-i better-c-i],
   :result :i64,
   :effects #{},
   :body
   (if
    (= has-champ 0)
    (if (= ok-i 0) 0 1)
    (if (= ok-i 0) 2 (if (= better-c-i 1) 1 2))),
   :param-types [:i64 :i64 :i64]}
  {:name load-inc-if,
   :params [load picked],
   :result :i64,
   :effects #{},
   :body (if (= picked 0) load (+ load 1)),
   :param-types [:i64 :i64]}
  {:name challenger-wins?,
   :params [fill-c load-c fill-i load-i],
   :result :i64,
   :effects #{},
   :body
   (let
    [b (better-task-score? fill-c load-c 0 fill-i load-i)]
    (if (= b 0) 1 0)),
   :param-types [:i64 :i64 :i64 :i64]}
  {:name assign-task-pick-3,
   :params [ok-pack fill-pack load-pack],
   :result :i64,
   :effects #{},
   :body
   (let
    [B
     65536
     ok0
     (rem64 ok-pack B)
     ok1
     (rem64 (quot ok-pack B) B)
     ok2
     (quot ok-pack (* B B))
     f0
     (rem64 fill-pack B)
     f1
     (rem64 (quot fill-pack B) B)
     f2
     (quot fill-pack (* B B))
     l0
     (rem64 load-pack B)
     l1
     (rem64 (quot load-pack B) B)
     l2
     (quot load-pack (* B B))
     p01
     (if
      (= ok0 0)
      (if (= ok1 0) -1 1)
      (if
       (= ok1 0)
       0
       (let
        [b (better-task-score? f0 l0 0 f1 l1)]
        (if (= b 2) 0 (if (= b 1) 0 1)))))
     fc
     (if (= p01 0) f0 (if (= p01 1) f1 0))
     lc
     (if (= p01 0) l0 (if (= p01 1) l1 0))
     win2
     (if (< p01 0) 0 (challenger-wins? fc lc f2 l2))]
    (if
     (< p01 0)
     (if (= ok2 0) -1 2)
     (if (= ok2 0) p01 (if (= win2 1) 2 p01)))),
   :param-types [:i64 :i64 :i64]}
  {:name apply-task-pick-3,
   :params [load-pack pick],
   :result :i64,
   :effects #{},
   :body
   (let
    [B
     65536
     l0
     (rem64 load-pack B)
     l1
     (rem64 (quot load-pack B) B)
     l2
     (quot load-pack (* B B))
     n0
     (load-inc-if l0 (if (= pick 0) 1 0))
     n1
     (load-inc-if l1 (if (= pick 1) 1 0))
     n2
     (load-inc-if l2 (if (= pick 2) 1 0))]
    (+ n0 (+ (* n1 B) (* n2 (* B B))))),
   :param-types [:i64 :i64]}
  {:name assign-task-step-3,
   :params [load-pack ok-pack fill-pack],
   :result :i64,
   :effects #{},
   :body
   (let
    [p
     (assign-task-pick-3 ok-pack fill-pack load-pack)
     code
     (if (< p 0) 0 (+ p 1))
     nload
     (apply-task-pick-3 load-pack p)]
    (+ code (* 4 nload))),
   :param-types [:i64 :i64 :i64]}
  {:name nearest-rank-idx,
   :params [n p-milli],
   :result :i64,
   :effects #{},
   :body
   (if
    (< n 1)
    -1
    (let
     [raw
      (quot (* p-milli n) 1000)
      hi
      (- n 1)
      idx
      (if (< raw 0) 0 raw)]
     (if (< hi idx) hi idx))),
   :param-types [:i64 :i64]}
  {:name summary-retried,
   :params [attempts finals],
   :result :i64,
   :effects #{},
   :body (let [d (- attempts finals)] (if (< d 0) 0 d)),
   :param-types [:i64 :i64]}
  {:name speedup-milli,
   :params [task-ms wall-ms],
   :result :i64,
   :effects #{},
   :body
   (if
    (if (< wall-ms 1) 1 (if (< task-ms 1) 1 0))
    0
    (quot (* task-ms 1000) wall-ms)),
   :param-types [:i64 :i64]}
  {:name max2,
