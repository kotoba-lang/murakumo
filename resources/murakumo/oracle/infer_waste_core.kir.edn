   :params [floor working-set cap],
   :result :i64,
   :effects #{},
   :body
   (let
    [b3
     (+ floor (* 3 working-set))
     b2
     (+ floor (* 2 working-set))
     b1
     (+ floor working-set)]
    (if
     (< cap 1)
     b3
     (if
      (<= b3 cap)
      b3
      (if (<= b2 cap) b2 (if (<= b1 cap) b1 floor))))),
