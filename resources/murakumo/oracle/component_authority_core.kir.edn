   :effects #{},
   :body (+ seq 1),
   :param-types [:i64]}
  {:name command-op,
   :params [op],
   :result :string,
   :effects #{},
   :body
   (if
    (string=? op (op-place))
    (op-place)
    (if (string=? op (op-revoke)) (op-revoke) (op-unknown))),
   :param-types [:string]}
  {:name event-kind,
