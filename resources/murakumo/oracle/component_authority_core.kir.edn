  {:name ws?,
   :params [c],
   :result :bool,
   :effects #{},
   :body
   (if
    (string=? c " ")
    true
    (if
     (string=? c "\n")
     true
     (if (string=? c "\t") true (if (string=? c "\r") true false)))),
   :param-types [:string]}
  {:name blank?,
   :params [s],
   :result :bool,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     true
     (if
      (ws? (string-substring s 0 1))
      (blank? (string-substring s 1 n))
      false))),
   :param-types [:string]}
  {:name identifier-len-ok?,
   :params [x],
   :result :bool,
   :effects #{},
   :body
   (if
    (record-get
     [:record :cauth/id-len [[:is-blank :bool] [:byte-len :i64]]]
     x
     :is-blank)
    false
    (if
     (<
      (max-identifier-bytes)
      (record-get
       [:record :cauth/id-len [[:is-blank :bool] [:byte-len :i64]]]
       x
       :byte-len))
     false
     true)),
   :param-types [[:ref :cauth/id-len]]}
  {:name identifier?,
   :params [s],
   :result :bool,
   :effects #{},
   :body
   (identifier-len-ok?
    (record-new
     [:record :cauth/id-len [[:is-blank :bool] [:byte-len :i64]]]
     (blank? s)
     (string-byte-length s))),
   :param-types [:string]}
  {:name place-epoch,
   :params [current-or-zero],
   :result :i64,
   :effects #{},
   :body (if (= current-or-zero 0) 1 current-or-zero),
   :param-types [:i64]}
  {:name revoke-epoch,
   :params [current-or-zero],
   :result :i64,
   :effects #{},
   :body (+ current-or-zero 1),
   :param-types [:i64]}
  {:name next-sequence,
   :params [seq],
