  {:name action-name,
   :params [cid running desired-n free-candidates],
   :result :string,
   :effects #{},
   :body
   (let
    [def-n (deficit desired-n running)]
    (let
     [binding-some__2 cid]
     (if
      (option-some?-of [:option :string] binding-some__2)
      (let
       [_ (option-value-of [:option :string] binding-some__2 "")]
       (if
        (< desired-n running)
        (action-over)
        (if
         (= def-n 0)
         (action-satisfied)
         (if (< free-candidates 1) (action-blocked) (action-place)))))
      (action-needs-build)))),
   :param-types [[:option :string] :i64 :i64 :i64]}
  {:name better-target?,
   :params [load-a load-b name-a-before-b],
   :result :i64,
   :effects #{},
   :body
   (if (< load-a load-b) 1 (if (< load-b load-a) 0 name-a-before-b)),
   :param-types [:i64 :i64 :i64]}
  {:name first-of-2,
   :params [load0 load1 name0-before-1],
   :result :i64,
   :effects #{},
   :body (if (= (better-target? load0 load1 name0-before-1) 1) 0 1),
   :param-types [:i64 :i64 :i64]}
  {:name name-order-record,
   :params [n01 n02 n12],
   :result [:ref :reconcile/name-order],
   :effects #{},
   :body
   (record-new
    [:record
     :reconcile/name-order
     [[:n01 :i64] [:n02 :i64] [:n12 :i64]]]
    n01
    n02
    n12),
   :param-types [:i64 :i64 :i64]}
  {:name first-of-3,
   :params [load0 load1 load2 names],
   :result :i64,
   :effects #{},
   :body
   (let
    [n01
     (record-get
      [:record
       :reconcile/name-order
       [[:n01 :i64] [:n02 :i64] [:n12 :i64]]]
      names
      :n01)
     n02
     (record-get
      [:record
       :reconcile/name-order
       [[:n01 :i64] [:n02 :i64] [:n12 :i64]]]
      names
      :n02)
     n12
     (record-get
      [:record
       :reconcile/name-order
       [[:n01 :i64] [:n02 :i64] [:n12 :i64]]]
      names
      :n12)
     w01
     (first-of-2 load0 load1 n01)]
    (if
     (= w01 0)
     (if (= (better-target? load0 load2 n02) 1) 0 2)
     (if (= (better-target? load1 load2 n12) 1) 1 2))),
   :param-types [:i64 :i64 :i64 [:ref :reconcile/name-order]]}
  {:name targets-record,
   :params [first second count],
   :result [:ref :reconcile/targets],
   :effects #{},
   :body
   (record-new
    [:record
     :reconcile/targets
     [[:first :i64] [:second :i64] [:count :i64]]]
    first
    second
    count),
   :param-types [:i64 :i64 :i64]}
  {:name targets-first,
   :params [t],
   :result :i64,
   :effects #{},
   :body
   (record-get
    [:record
     :reconcile/targets
     [[:first :i64] [:second :i64] [:count :i64]]]
    t
    :first),
   :param-types [[:ref :reconcile/targets]]}
  {:name targets-second,
