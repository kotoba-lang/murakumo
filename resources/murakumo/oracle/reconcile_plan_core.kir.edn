  {:name action-name,
   :params [cid running desired-n free-candidates],
   :result :string,
   :effects #{},
   :body
   (let
    [def-n
     (deficit
      (record-new
       [:record :reconcile/deficit [[:desired :i64] [:running :i64]]]
       desired-n
       running))]
    (let
     [__kotoba_binding-some_2 cid]
     (if
      (option-some?-of [:option :string] __kotoba_binding-some_2)
      (let
       [_
        (option-value-of [:option :string] __kotoba_binding-some_2 "")]
       (if
        (< desired-n running)
        (action-over)
        (if
         (= def-n 0)
         (action-satisfied)
         (if (< free-candidates 1) (action-blocked) (action-place)))))
      (action-needs-build)))),
   :param-types [[:option :string] :i64 :i64 :i64]}
  {:name better-target?,
   :params [load-a load-b name-a-before-b],
   :result :bool,
   :effects #{},
   :body
   (if
    (< load-a load-b)
    true
    (if (< load-b load-a) false name-a-before-b)),
   :param-types [:i64 :i64 :bool]}
