   :param-types [:string]}
  {:name ws?,
   :params [c],
   :result :bool,
   :effects #{},
   :body
   (if
    (string=? c " ")
    true
    (if
     (string=? c "\n")
     true
     (if (string=? c "\t") true (if (string=? c "\r") true false)))),
   :param-types [:string]}
  {:name trim-ws,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (if
      (ws? (string-substring s 0 1))
      (trim-ws (string-substring s 1 n))
      (if
       (ws? (string-substring s (- n 1) n))
       (trim-ws (string-substring s 0 (- n 1)))
       s)))),
   :param-types [:string]}
  {:name digit-val?,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (= (string-byte-length c) 1)
    (if (string-contains? "0123456789" c) 1 0)
    0),
   :param-types [:string]}
  {:name digit-of-go,
   :params [digits c i],
   :result :i64,
   :effects #{},
   :body
   (let
    [n (string-byte-length digits)]
    (if
     (< i n)
     (if
      (string=? (string-substring digits i (+ i 1)) c)
      i
      (digit-of-go digits c (+ i 1)))
     0)),
   :param-types [:string :string :i64]}
  {:name digit-of,
   :params [c],
   :result :i64,
   :effects #{},
   :body (digit-of-go "0123456789" c 0),
   :param-types [:string]}
  {:name parse-digits-go,
   :params [s acc],
   :result :i64,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     acc
     (let
      [c (string-substring s 0 1)]
      (if
       (= (digit-val? c) 0)
       -1
       (parse-digits-go
        (string-substring s 1 n)
        (+ (* acc 10) (digit-of c))))))),
   :param-types [:string :i64]}
  {:name parse-digits,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [t (trim-ws s) n (string-byte-length t)]
    (if (= n 0) -1 (parse-digits-go t 0))),
   :param-types [:string]}
  {:name watch-seconds,
   :params [a],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? a (flag-watch))
    (default-watch-seconds)
    (if
     (= (starts-with? a (flag-watch-eq-prefix)) 1)
     (let
      [n
       (string-byte-length a)
       plen
       (string-byte-length (flag-watch-eq-prefix))
       v
       (parse-digits (string-substring a plen n))]
      (if (< v 0) (default-watch-seconds) v))
     (default-watch-seconds))),
   :param-types [:string]}
  {:name snapshot-value,
   :params [a],
   :result :string,
   :effects #{},
   :body
   (if
    (= (starts-with? a (flag-snapshot-prefix)) 1)
    (let
     [n
      (string-byte-length a)
      plen
      (string-byte-length (flag-snapshot-prefix))]
     (string-substring a plen n))
    ""),
   :param-types [:string]}
  {:name reconcile-record-type,
   :params [],
   :result :string,
   :effects #{},
   :body "com.murakumo.fleet.reconcile",
   :param-types []}],
