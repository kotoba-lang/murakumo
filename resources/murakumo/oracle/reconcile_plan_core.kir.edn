  {:name desired,
   :params [replicas],
   :result :i64,
   :effects #{},
   :body
   (let
    [binding-some__1 replicas]
    (if
     (option-some?-of [:option :i64] binding-some__1)
     (let [r (option-value-of [:option :i64] binding-some__1 0)] r)
     1)),
   :param-types [[:option :i64]]}
  {:name deficit,
   :params [desired-n running],
   :result :i64,
   :effects #{},
   :body (let [d (- desired-n running)] (if (< d 0) 0 d)),
   :param-types [:i64 :i64]}
  {:name watch-sleep-ms,
   :params [seconds],
