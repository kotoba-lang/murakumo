  {:name deficit,
   :params [d],
   :result :i64,
   :effects #{},
   :body
   (let
    [gap
     (-
      (record-get
       [:record :reconcile/deficit [[:desired :i64] [:running :i64]]]
       d
       :desired)
      (record-get
       [:record :reconcile/deficit [[:desired :i64] [:running :i64]]]
       d
       :running))]
    (if (< gap 0) 0 gap)),
   :param-types [[:ref :reconcile/deficit]]}
