  {:name starts-with?,
   :params [x],
   :result :bool,
   :effects #{},
   :body
   (let
    [s
     (record-get
      [:record :reconcile/starts-with [[:s :string] [:prefix :string]]]
      x
      :s)
     prefix
     (record-get
      [:record :reconcile/starts-with [[:s :string] [:prefix :string]]]
      x
      :prefix)
     n
     (string-byte-length s)
     p
     (string-byte-length prefix)]
    (if
     (< n p)
     false
     (if (string=? (string-substring s 0 p) prefix) true false))),
   :param-types [[:ref :reconcile/starts-with]]}
