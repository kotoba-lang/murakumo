  {:name pick-targets-2-record,
   :params [load0 load1 name0-before-1 n],
   :result [:ref :reconcile/targets],
   :effects #{},
   :body
   (if
    (< n 1)
    (targets-record 0 0 0)
    (let
     [f (first-of-2 load0 load1 name0-before-1) s (if (= f 0) 1 0)]
     (if (= n 1) (targets-record f 0 1) (targets-record f s 2)))),
   :param-types [:i64 :i64 :bool :i64]}
  {:name pick-targets-3-first,
   :params [load0 load1 load2 names],
   :result :i64,
   :effects #{},
   :body (first-of-3 load0 load1 load2 names),
   :param-types [:i64 :i64 :i64 [:ref :reconcile/name-order]]}
  {:name blank?,
   :params [s],
   :result :bool,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     true
     (if
      (ws? (string-substring s 0 1))
      (blank? (string-substring s 1 n))
      false))),
   :param-types [:string]}
