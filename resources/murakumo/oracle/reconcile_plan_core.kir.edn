  {:name first-of-3,
   :params [load0 load1 load2 names],
   :result :i64,
   :effects #{},
   :body
   (let
    [n01
     (record-get
      [:record
       :reconcile/name-order
       [[:n01 :bool] [:n02 :bool] [:n12 :bool]]]
      names
      :n01)
     n02
     (record-get
      [:record
       :reconcile/name-order
       [[:n01 :bool] [:n02 :bool] [:n12 :bool]]]
      names
      :n02)
     n12
     (record-get
      [:record
       :reconcile/name-order
       [[:n01 :bool] [:n02 :bool] [:n12 :bool]]]
      names
      :n12)
     w01
     (first-of-2 load0 load1 n01)]
    (if
     (= w01 0)
     (if (better-target? load0 load2 n02) 0 2)
     (if (better-target? load1 load2 n12) 1 2))),
   :param-types [:i64 :i64 :i64 [:ref :reconcile/name-order]]}
