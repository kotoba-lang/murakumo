  {:name default-port-for-kind,
   :params [kind],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? kind (kind-quic))
    (default-quic-port)
    (if
     (string=? kind (kind-relay))
     (default-relay-port)
     (if
      (if
       (string=? kind (kind-webrtc))
       1
       (if (string=? kind (kind-webtransport)) 1 0))
      (default-web-port)
      0))),
   :param-types [:string]}
  {:name known-adapter?,
   :params [name],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? name (adapter-relay))
    1
    (if
     (string=? name (adapter-quic))
     1
     (if
      (string=? name (adapter-webrtc))
      1
      (if
       (string=? name (adapter-webtransport))
       1
       (if (string=? name (adapter-relay-client)) 1 0))))),
   :param-types [:string]}
  {:name adapter-kind,
   :params [name],
   :result :string,
   :effects #{},
   :body
   (if
    (string=? name (adapter-relay))
    (adapter-kind-relay-runtime)
    (if
     (string=? name (adapter-quic))
     (adapter-kind-quic)
     (if
      (string=? name (adapter-webrtc))
      (adapter-kind-webrtc)
      (if
       (string=? name (adapter-webtransport))
       (adapter-kind-webtransport)
       (if
        (string=? name (adapter-relay-client))
        (adapter-kind-relay)
        ""))))),
   :param-types [:string]}
  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name endpoint-kind,
   :params [endpoint],
   :result :string,
   :effects #{},
   :body
   (if
    (= (starts-with? endpoint (scheme-quic)) 1)
    (kind-quic)
    (if
     (= (starts-with? endpoint (scheme-webrtc)) 1)
     (kind-webrtc)
     (if
      (= (starts-with? endpoint (scheme-relay)) 1)
      (kind-relay)
      (if
       (= (starts-with? endpoint (scheme-webtransport)) 1)
       (kind-webtransport)
       (kind-other))))),
   :param-types [:string]}
  {:name find-scheme-end,
   :params [s i n],
   :result :i64,
   :effects #{},
   :body
   (if
    (< (+ i 2) n)
    (if
     (if
      (string=? (string-substring s i (+ i 1)) ":")
      (if
       (string=? (string-substring s (+ i 1) (+ i 2)) "/")
       (if (string=? (string-substring s (+ i 2) (+ i 3)) "/") 1 0)
       0)
      0)
     (+ i 3)
     (find-scheme-end s (+ i 1) n))
    -1),
   :param-types [:string :i64 :i64]}
  {:name find-host-end,
   :params [s i n],
   :result :i64,
   :effects #{},
   :body
   (if
    (< i n)
    (let
     [c (string-substring s i (+ i 1))]
     (if
      (if (string=? c ":") 1 (if (string=? c "/") 1 0))
      i
      (find-host-end s (+ i 1) n)))
    n),
   :param-types [:string :i64 :i64]}
  {:name scheme-prefix-host,
   :params [url],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length url) start (find-scheme-end url 0 n)]
    (if
     (< start 0)
     ""
     (let
      [end (find-host-end url start n)]
      (if (< start end) (string-substring url start end) "")))),
   :param-types [:string]}],
