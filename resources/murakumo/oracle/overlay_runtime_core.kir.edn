   :params [s prefix],
   :result :i64,
   :effects #{},
   :body
   (let
    [n (string-byte-length s) p (string-byte-length prefix)]
    (if
     (< n p)
     0
     (if (string=? (string-substring s 0 p) prefix) 1 0))),
