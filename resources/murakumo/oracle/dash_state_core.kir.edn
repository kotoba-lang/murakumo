 :functions
 [{:name short-hosted-cid-max-len,
   :params [],
   :result :i64,
   :effects #{},
   :body 18,
   :param-types []}
  {:name short-cid-max-len,
   :params [],
   :result :i64,
   :effects #{},
   :body 14,
   :param-types []}
  {:name short-hosted-cid,
   :params [cid],
   :result :string,
   :effects #{},
   :body
   (let
    [n
     (string-byte-length cid)
     max
     (short-hosted-cid-max-len)
     end
     (if (< n max) n max)]
    (string-substring cid 0 end)),
   :param-types [:string]}
  {:name health-class-of,
   :params [health],
   :result :string,
   :effects #{},
   :body (if (string=? health "ok") "ok" "down"),
   :param-types [:string]}
  {:name interval-sleep-ms,
   :params [seconds],
   :result :i64,
   :effects #{},
   :body (* 1000 seconds),
   :param-types [:i64]}
  {:name clamp-at,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [requested-at
     (record-get
      [:record
       :dash/clamp
       [[:requested-at :i64] [:history-count :i64]]]
      x
      :requested-at)
     history-count
     (record-get
      [:record
       :dash/clamp
       [[:requested-at :i64] [:history-count :i64]]]
      x
      :history-count)
     req
     (if (< requested-at 0) 0 requested-at)
     hi
     (if (< history-count 1) 0 (- history-count 1))]
    (if (< req hi) req hi)),
   :param-types [[:ref :dash/clamp]]}
  {:name take-last-start,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [len
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :a)
     cap
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :b)]
    (if (< cap 1) len (let [s (- len cap)] (if (< s 0) 0 s)))),
   :param-types [[:ref :dash/pair-i64]]}
  {:name append-new-len,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [len
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :a)
     add
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :b)]
    (if (< add 0) len (+ len add))),
   :param-types [[:ref :dash/pair-i64]]}
  {:name cap-count,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [len
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :a)
     cap
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :b)]
    (if (< cap 1) 0 (if (< len cap) len cap))),
   :param-types [[:ref :dash/pair-i64]]}
  {:name recent-take-n,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [n
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :a)
     default-n
     (record-get [:record :dash/pair-i64 [[:a :i64] [:b :i64]]] x :b)]
    (if (< n 0) default-n n)),
   :param-types [[:ref :dash/pair-i64]]}
  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name digit-val?,
   :params [c],
   :result :bool,
   :effects #{},
   :body
   (if
    (string=? c "0")
    true
    (if
     (string=? c "1")
     true
     (if
      (string=? c "2")
      true
      (if
       (string=? c "3")
       true
       (if
        (string=? c "4")
        true
        (if
         (string=? c "5")
         true
         (if
          (string=? c "6")
          true
          (if
           (string=? c "7")
           true
           (if (string=? c "8") true (string=? c "9")))))))))),
   :param-types [:string]}
  {:name digit-of,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? c "0")
    0
    (if
     (string=? c "1")
     1
     (if
      (string=? c "2")
      2
      (if
       (string=? c "3")
       3
       (if
        (string=? c "4")
        4
        (if
         (string=? c "5")
         5
         (if
          (string=? c "6")
          6
          (if
           (string=? c "7")
           7
           (if (string=? c "8") 8 (if (string=? c "9") 9 0)))))))))),
   :param-types [:string]}
  {:name trim-ws,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (if
      (string=? (string-substring s 0 1) " ")
      (trim-ws (string-substring s 1 n))
      (if
       (string=? (string-substring s (- n 1) n) " ")
       (trim-ws (string-substring s 0 (- n 1)))
       s)))),
   :param-types [:string]}
  {:name parse-digits-go,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [s
     (record-get
      [:record :dash/digits-go [[:s :string] [:acc :i64]]]
      x
      :s)
     acc
     (record-get
      [:record :dash/digits-go [[:s :string] [:acc :i64]]]
      x
      :acc)
     n
     (string-byte-length s)]
    (if
     (= n 0)
     acc
     (let
      [c (string-substring s 0 1)]
      (if
       (digit-val? c)
       (parse-digits-go
        (record-new
         [:record :dash/digits-go [[:s :string] [:acc :i64]]]
         (string-substring s 1 n)
         (+ (* acc 10) (digit-of c))))
       -1)))),
   :param-types [[:ref :dash/digits-go]]}
  {:name parse-digits,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [t (trim-ws s) n (string-byte-length t)]
    (if
     (= n 0)
     -1
     (parse-digits-go
      (record-new
       [:record :dash/digits-go [[:s :string] [:acc :i64]]]
       t
       0)))),
   :param-types [:string]}
  {:name parse-links,
   :params [s],
   :result :i64,
   :effects #{},
   :body
   (let
    [raw (if (string=? s "") "0" s) n (parse-digits raw)]
    (if (< n 0) 0 n)),
   :param-types [:string]}
  {:name probe-line-key,
   :params [line],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length line)]
    (if
     (< n 2)
     ""
     (if
      (string=? (string-substring line 1 2) ":")
      (string-substring line 0 1)
      ""))),
   :param-types [:string]}
  {:name probe-line-value,
   :params [line],
   :result :string,
   :effects #{},
   :body
   (let
    [k (probe-line-key line) n (string-byte-length line)]
    (if (string=? k "") "" (string-substring line 2 n))),
   :param-types [:string]}
