  {:name join-append,
   :params [x],
   :result :string,
   :effects #{},
   :body
   (let
    [acc
     (record-get
      [:record
       :dash/join
       [[:acc :string] [:sep :string] [:next :string]]]
      x
      :acc)
     sep
     (record-get
      [:record
       :dash/join
       [[:acc :string] [:sep :string] [:next :string]]]
      x
      :sep)
     next
     (record-get
      [:record
       :dash/join
       [[:acc :string] [:sep :string] [:next :string]]]
      x
      :next)]
    (if
     (string=? acc "")
     next
     (string-concat acc (string-concat sep next)))),
   :param-types [[:ref :dash/join]]}
  {:name hosted-append,
   :params [x],
   :result :string,
   :effects #{},
   :body
   (join-append
    (record-new
     [:record
      :dash/join
      [[:acc :string] [:sep :string] [:next :string]]]
     (record-get
      [:record :dash/hosted [[:acc :string] [:next :string]]]
      x
      :acc)
     (hosted-join-sep)
     (record-get
      [:record :dash/hosted [[:acc :string] [:next :string]]]
      x
      :next))),
   :param-types [[:ref :dash/hosted]]}
