  {:name starts-with?,
   :params [s prefix],
   :result :bool,
   :effects #{},
   :body
   (let
    [n (string-byte-length s) p (string-byte-length prefix)]
    (if
     (< n p)
     false
     (if (string=? (string-substring s 0 p) prefix) true false))),
