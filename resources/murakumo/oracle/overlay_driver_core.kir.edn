  {:name endpoint-kind,
   :params [endpoint],
   :result :string,
   :effects #{},
   :body
   (if
    (starts-with? endpoint (scheme-quic))
    (kind-quic)
    (if
     (starts-with? endpoint (scheme-webrtc))
     (kind-webrtc)
     (if
      (starts-with? endpoint (scheme-https))
      (kind-webtransport)
      (if
       (starts-with? endpoint (scheme-relay))
       (kind-relay)
       (kind-unknown))))),
   :param-types [:string]}
  {:name option-name,
   :params [flag],
   :result :string,
   :effects #{},
   :body
   (let
    [n
     (string-byte-length flag)
     p
     (string-byte-length (flag-dash-prefix))]
    (if
     (< n p)
     ""
     (if
      (starts-with? flag (flag-dash-prefix))
      (string-substring flag p n)
      flag))),
   :param-types [:string]}
  {:name command-is-dial?,
   :params [command],
