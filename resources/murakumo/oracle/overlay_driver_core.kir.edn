  {:name dial-ok-reason,
   :params [is-dial missing-count],
   :result :string,
   :effects #{},
   :body
   (if
    is-dial
    (if (< 0 missing-count) (reason-missing-options) (reason-ok))
    (reason-unknown-command)),
   :param-types [:bool :i64]}],
