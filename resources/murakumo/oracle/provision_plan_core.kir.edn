  {:name ws?,
   :params [c],
   :result :bool,
   :effects #{},
   :body
   (if
    (string=? c " ")
    true
    (if
     (string=? c "\n")
     true
     (if (string=? c "\t") true (if (string=? c "\r") true false)))),
   :param-types [:string]}
  {:name trim,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (if
      (ws? (string-substring s 0 1))
      (trim (string-substring s 1 n))
      (if
       (ws? (string-substring s (- n 1) n))
       (trim (string-substring s 0 (- n 1)))
       s)))),
   :param-types [:string]}
  {:name live-link-count-output,
   :params [out],
   :result :string,
   :effects #{},
