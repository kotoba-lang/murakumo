  {:name alnum-char?,
   :params [c],
   :result :bool,
   :effects #{},
   :body
   (if
    (string-contains?
     "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
     c)
    true
    false),
   :param-types [:string]}
  {:name find-prefix-at,
   :params [x],
   :result :i64,
   :effects #{},
   :body
   (let
    [s
     (record-get
      [:record
       :provision/prefix-at
       [[:s :string] [:prefix :string] [:i :i64]]]
      x
      :s)
     prefix
     (record-get
      [:record
       :provision/prefix-at
       [[:s :string] [:prefix :string] [:i :i64]]]
      x
      :prefix)
     i
     (record-get
      [:record
       :provision/prefix-at
       [[:s :string] [:prefix :string] [:i :i64]]]
      x
      :i)
     n
     (string-byte-length s)
     p
     (string-byte-length prefix)]
    (if
     (let
      [__kotoba_or_2 (= p 0)]
      (if __kotoba_or_2 __kotoba_or_2 (> (+ i p) n)))
     -1
     (if
      (string=? (string-substring s i (+ i p)) prefix)
      i
      (find-prefix-at
       (record-new
        [:record
         :provision/prefix-at
         [[:s :string] [:prefix :string] [:i :i64]]]
        s
        prefix
        (+ i 1)))))),
   :param-types [[:ref :provision/prefix-at]]}
  {:name take-alnum,
   :params [x],
   :result :string,
   :effects #{},
   :body
   (let
    [s
     (record-get
      [:record
       :provision/take-alnum
       [[:s :string] [:i :i64] [:acc :string]]]
      x
      :s)
     i
     (record-get
      [:record
       :provision/take-alnum
       [[:s :string] [:i :i64] [:acc :string]]]
      x
      :i)
     acc
     (record-get
      [:record
       :provision/take-alnum
       [[:s :string] [:i :i64] [:acc :string]]]
      x
      :acc)
     n
     (string-byte-length s)]
    (if
     (>= i n)
     acc
     (let
      [c (string-substring s i (+ i 1))]
      (if
       (alnum-char? c)
       (take-alnum
        (record-new
         [:record
          :provision/take-alnum
          [[:s :string] [:i :i64] [:acc :string]]]
         s
         (+ i 1)
