  {:name peer-id-log-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "grep -ho '"
    (string-concat
     (peer-id-did-pattern)
     "' ~/.murakumo/mesh.log 2>/dev/null | tail -1")),
   :param-types []}
  {:name live-link-count-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "grep 'kotoba-net: peer connected' ~/.murakumo/mesh.log 2>/dev/null | grep -o '"
    (string-concat (peer-id-body-pattern) "' | sort -u | wc -l")),
   :param-types []}
  {:name ws?,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? c " ")
    1
    (if
     (string=? c "\n")
     1
     (if (string=? c "\t") 1 (if (string=? c "\r") 1 0)))),
   :param-types [:string]}
  {:name trim,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (if
      (= (ws? (string-substring s 0 1)) 1)
      (trim (string-substring s 1 n))
      (if
       (= (ws? (string-substring s (- n 1) n)) 1)
       (trim (string-substring s 0 (- n 1)))
       s)))),
   :param-types [:string]}
  {:name live-link-count-output,
   :params [out],
   :result :string,
   :effects #{},
   :body (trim out),
   :param-types [:string]}
