  {:name join-append,
   :params [j],
   :result :string,
   :effects #{},
   :body
   (let
    [acc
     (record-get
      [:record
       :provision/join
       [[:acc :string] [:sep :string] [:next :string]]]
      j
      :acc)
     sep
     (record-get
      [:record
       :provision/join
       [[:acc :string] [:sep :string] [:next :string]]]
      j
      :sep)
     next
     (record-get
      [:record
       :provision/join
       [[:acc :string] [:sep :string] [:next :string]]]
      j
      :next)]
    (if
     (string=? acc "")
     next
     (string-concat acc (string-concat sep next)))),
   :param-types [[:ref :provision/join]]}
