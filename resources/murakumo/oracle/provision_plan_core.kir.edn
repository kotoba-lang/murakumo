     (plist-label)
     " >/dev/null 2>&1 && echo running || echo stopped")),
   :param-types []}
  {:name did-key-prefix,
   :params [],
   :result :string,
   :effects #{},
   :body "did:key:",
   :param-types []}
  {:name peer-id-body-prefix,
   :params [],
   :result :string,
   :effects #{},
   :body "12D3",
   :param-types []}
  {:name peer-id-body-pattern,
   :params [],
   :result :string,
   :effects #{},
