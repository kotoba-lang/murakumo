      :node-port)]
    (if
     (option-some?-of [:option :i64] __kotoba_binding-some_1)
     (let
      [p (option-value-of [:option :i64] __kotoba_binding-some_1 0)]
      p)
     (let
      [__kotoba_binding-some_2
       (record-get
        [:record
         :provision/p2p-ports
         [[:node-port [:option :i64]] [:fleet-port [:option :i64]]]]
