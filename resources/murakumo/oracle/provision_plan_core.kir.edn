{:format :kotoba.kir/v4,
 :signature nil,
 :functions
 [{:name plist-label,
   :params [],
   :result :string,
   :effects #{},
   :body "com.murakumo.kotoba-mesh",
   :param-types []}
  {:name remote-bin,
   :params [],
   :result :string,
   :effects #{},
   :body "$HOME/.murakumo/bin",
   :param-types []}
  {:name remote-store,
   :params [],
   :result :string,
   :effects #{},
   :body "$HOME/.murakumo/store",
   :param-types []}
  {:name ssh-rsync-options,
   :params [],
   :result :string,
   :effects #{},
   :body "ssh -o BatchMode=yes -o ConnectTimeout=8",
   :param-types []}
  {:name peer-advertise-wait-ms,
   :params [],
   :result :i64,
   :effects #{},
   :body 8000,
   :param-types []}
  {:name default-p2p-port,
   :params [],
   :result :i64,
   :effects #{},
   :body 4001,
   :param-types []}
  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name blank?,
   :params [s],
   :result :i64,
   :effects #{},
   :body (if (string=? s "") 1 0),
   :param-types [:string]}
  {:name operator-seed-missing?,
   :params [seed],
   :result :i64,
   :effects #{},
   :body (blank? seed),
   :param-types [:string]}
  {:name resolve-p2p-port,
   :params [node-port fleet-port],
   :result :i64,
   :effects #{},
   :body
   (let
    [binding-some__1 node-port]
    (if
     (option-some?-of [:option :i64] binding-some__1)
     (let [p (option-value-of [:option :i64] binding-some__1 0)] p)
     (let
      [binding-some__2 fleet-port]
      (if
       (option-some?-of [:option :i64] binding-some__2)
       (let [f (option-value-of [:option :i64] binding-some__2 0)] f)
       4001)))),
   :param-types [[:option :i64] [:option :i64]]}
  {:name multiaddr,
   :params [ip port],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "/ip4/"
    (string-concat
     ip
     (string-concat
      "/udp/"
      (string-concat (i64-str port) "/quic-v1")))),
   :param-types [:string :i64]}
  {:name webrtc-port,
   :params [p2p-port],
   :result :i64,
   :effects #{},
   :body (+ p2p-port 100),
   :param-types [:i64]}
  {:name mesh-binary-status-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   "test -x $HOME/.murakumo/bin/kotoba-server && echo installed || echo absent",
   :param-types []}
  {:name remote-store-command,
   :params [],
   :result :string,
   :effects #{},
   :body "mkdir -p $HOME/.murakumo/bin $HOME/.murakumo/store",
   :param-types []}
  {:name launch-status-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "sudo launchctl print system/"
    (string-concat
     (plist-label)
     " >/dev/null 2>&1 && echo running || echo stopped")),
   :param-types []}
  {:name peer-id-log-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   "grep -ho 'did:key:12D3[A-Za-z0-9]*' ~/.murakumo/mesh.log 2>/dev/null | tail -1",
   :param-types []}
  {:name live-link-count-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   "grep 'kotoba-net: peer connected' ~/.murakumo/mesh.log 2>/dev/null | grep -o '12D3[A-Za-z0-9]*' | sort -u | wc -l",
   :param-types []}
  {:name ws?,
   :params [c],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? c " ")
    1
    (if
     (string=? c "\n")
     1
     (if (string=? c "\t") 1 (if (string=? c "\r") 1 0)))),
   :param-types [:string]}
  {:name trim,
   :params [s],
   :result :string,
   :effects #{},
   :body
   (let
    [n (string-byte-length s)]
    (if
     (= n 0)
     s
     (if
      (= (ws? (string-substring s 0 1)) 1)
      (trim (string-substring s 1 n))
      (if
       (= (ws? (string-substring s (- n 1) n)) 1)
       (trim (string-substring s 0 (- n 1)))
       s)))),
   :param-types [:string]}
  {:name live-link-count-output,
   :params [out],
   :result :string,
   :effects #{},
   :body (trim out),
   :param-types [:string]}
  {:name launch-up-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "sudo launchctl bootstrap system /Library/LaunchDaemons/"
    (string-concat
     (plist-label)
     (string-concat
      ".plist 2>/dev/null; sudo launchctl kickstart -k system/"
      (plist-label)))),
   :param-types []}
  {:name launch-down-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat "sudo launchctl bootout system/" (plist-label)),
   :param-types []}
  {:name reprovision-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "sudo launchctl bootout system/"
    (string-concat
     (plist-label)
     (string-concat
      " 2>/dev/null || true; sleep 1; sudo launchctl bootstrap system /Library/LaunchDaemons/"
      (string-concat
       (plist-label)
       (string-concat
        ".plist 2>/dev/null || true; sudo launchctl kickstart -k system/"
        (plist-label)))))),
   :param-types []}
  {:name watchdog-label,
   :params [],
   :result :string,
   :effects #{},
   :body "com.murakumo.kotoba-mesh-watchdog",
   :param-types []}
  {:name watchdog-reprovision-command,
   :params [],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "sudo launchctl bootout system/"
    (string-concat
     (watchdog-label)
     (string-concat
      " 2>/dev/null || true; sleep 1; sudo launchctl bootstrap system /Library/LaunchDaemons/"
      (string-concat
       (watchdog-label)
       (string-concat
        ".plist 2>/dev/null || true; sudo launchctl kickstart -k system/"
        (watchdog-label)))))),
   :param-types []}],
 :oracle-value nil,
 :schema-identities nil,
 :exports
 [plist-label
  remote-bin
  remote-store
  ssh-rsync-options
  peer-advertise-wait-ms
  default-p2p-port
  digit-char
  nat-str
  i64-str
  operator-seed-missing?
  resolve-p2p-port
  multiaddr
  webrtc-port
  mesh-binary-status-command
  remote-store-command
  launch-status-command
  peer-id-log-command
  live-link-count-command
  live-link-count-output
  launch-up-command
  launch-down-command
  reprovision-command
  watchdog-label
  watchdog-reprovision-command],
