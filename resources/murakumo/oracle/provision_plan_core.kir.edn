  {:name digit-char,
   :params [d],
   :result :string,
   :effects #{},
   :body (string-substring "0123456789" d (+ d 1)),
   :param-types [:i64]}
  {:name nat-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if
    (< n 10)
    (digit-char n)
    (string-concat
     (nat-str (quot n 10))
     (digit-char (- n (* (quot n 10) 10))))),
   :param-types [:i64]}
  {:name i64-str,
   :params [n],
   :result :string,
   :effects #{},
   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name blank?,
   :params [s],
   :result :i64,
   :effects #{},
   :body (if (string=? s "") 1 0),
   :param-types [:string]}
  {:name operator-seed-missing?,
   :params [seed],
   :result :i64,
   :effects #{},
   :body (blank? seed),
   :param-types [:string]}
  {:name resolve-p2p-port,
   :params [node-port fleet-port],
   :result :i64,
   :effects #{},
   :body
   (let
    [binding-some__1 node-port]
    (if
     (option-some?-of [:option :i64] binding-some__1)
     (let [p (option-value-of [:option :i64] binding-some__1 0)] p)
     (let
      [binding-some__2 fleet-port]
      (if
       (option-some?-of [:option :i64] binding-some__2)
       (let [f (option-value-of [:option :i64] binding-some__2 0)] f)
       4001)))),
   :param-types [[:option :i64] [:option :i64]]}
  {:name multiaddr,
   :params [ip port],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "/ip4/"
    (string-concat
     ip
     (string-concat
      "/udp/"
      (string-concat (i64-str port) "/quic-v1")))),
   :param-types [:string :i64]}
  {:name webrtc-port,
   :params [p2p-port],
   :result :i64,
   :effects #{},
   :body (+ p2p-port 100),
   :param-types [:i64]}
  {:name mesh-binary-status-command,
