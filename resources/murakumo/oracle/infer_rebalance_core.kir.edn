        [:video :i64]
        [:audio :i64]
        [:postproc :i64]]]
      d
      :image)
     v
     (record-get
      [:record
       :rebalance/demand
       [[:text :i64]
        [:image :i64]
        [:video :i64]
        [:audio :i64]
        [:postproc :i64]]]
      d
      :video)
     a
     (record-get
      [:record
       :rebalance/demand
       [[:text :i64]
        [:image :i64]
        [:video :i64]
        [:audio :i64]
        [:postproc :i64]]]
      d
      :audio)
     p
     (record-get
      [:record
       :rebalance/demand
       [[:text :i64]
        [:image :i64]
        [:video :i64]
        [:audio :i64]
        [:postproc :i64]]]
      d
      :postproc)]
    (if
     (= class-code 1)
     (demand-record (+ t 1) i v a p)
     (if
      (= class-code 2)
      (demand-record t (+ i 1) v a p)
      (if
       (= class-code 3)
       (demand-record t i (+ v 1) a p)
       (if
        (= class-code 4)
        (demand-record t i v (+ a 1) p)
        (if (= class-code 5) (demand-record t i v a (+ p 1)) d)))))),
   :param-types [[:ref :rebalance/demand] :i64]}
