  {:name classify-run-flags,
   :params [images video audio swarm tokens],
   :result :i64,
   :effects #{},
   :body
   (let
    [__kotoba_binding-some_1 images]
    (if
     (option-some?-of [:option :string] __kotoba_binding-some_1)
     (let
      [_
       (option-value-of [:option :string] __kotoba_binding-some_1 "")]
      2)
     (let
      [__kotoba_binding-some_2 video]
      (if
       (option-some?-of [:option :string] __kotoba_binding-some_2)
       (let
        [_
         (option-value-of
          [:option :string]
          __kotoba_binding-some_2
          "")]
        3)
       (let
        [__kotoba_binding-some_3 audio]
        (if
         (option-some?-of [:option :string] __kotoba_binding-some_3)
         (let
          [_
           (option-value-of
            [:option :string]
            __kotoba_binding-some_3
            "")]
          4)
         (let
          [__kotoba_binding-some_4 swarm]
          (if
           (option-some?-of [:option :string] __kotoba_binding-some_4)
           (let
            [_
             (option-value-of
              [:option :string]
              __kotoba_binding-some_4
              "")]
            5)
           (let
            [__kotoba_binding-some_5 tokens]
            (if
             (option-some?-of
              [:option :string]
              __kotoba_binding-some_5)
             (let
              [_
               (option-value-of
                [:option :string]
                __kotoba_binding-some_5
                "")]
              1)
             0)))))))))),
   :param-types
