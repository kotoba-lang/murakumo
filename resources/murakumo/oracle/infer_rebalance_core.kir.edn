   :body
   (if (< n 0) (string-concat "-" (nat-str (- 0 n))) (nat-str n)),
   :param-types [:i64]}
  {:name pool-code,
   :params [name],
   :result :i64,
   :effects #{},
   :body
   (if
    (string=? name "text-pool")
    0
    (if
     (string=? name "media-pool")
     1
     (if (string=? name "postproc-pool") 2 -1))),
   :param-types [:string]}
  {:name pool-name,
   :params [code],
   :result :string,
   :effects #{},
   :body
   (if
    (= code 0)
    "text-pool"
    (if
     (= code 1)
     "media-pool"
     (if (= code 2) "postproc-pool" "unknown"))),
   :param-types [:i64]}
  {:name seat-of,
   :params [code st sm sp],
   :result :i64,
   :effects #{},
   :body (if (= code 0) st (if (= code 1) sm sp)),
   :param-types [:i64 :i64 :i64 :i64]}
  {:name before-pool?,
   :params [ia ib st sm sp],
   :result :bool,
   :effects #{},
   :body
   (let
    [sa (seat-of ia st sm sp) sb (seat-of ib st sm sp)]
    (if
     (< sb sa)
     true
     (if (< sa sb) false (if (< ia ib) true false)))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
  {:name seat-order-record,
   :params [st sm sp],
   :result [:ref :rebalance/order],
   :effects #{},
   :body
   (let
    [p0
     (if (before-pool? 0 1 st sm sp) 0 1)
     p1
     (if (before-pool? 0 1 st sm sp) 1 0)
     q1
     (if (before-pool? p1 2 st sm sp) p1 2)
     q2
     (if (before-pool? p1 2 st sm sp) 2 p1)
     r0
     (if (before-pool? p0 q1 st sm sp) p0 q1)
     r1
     (if (before-pool? p0 q1 st sm sp) q1 p0)]
    (record-new
     [:record :rebalance/order [[:i0 :i64] [:i1 :i64] [:i2 :i64]]]
     r0
     r1
     q2)),
   :param-types [:i64 :i64 :i64]}
  {:name order-nth,
   :params [ord n],
   :result :i64,
   :effects #{},
   :body
   (if
    (= n 0)
    (record-get
     [:record :rebalance/order [[:i0 :i64] [:i1 :i64] [:i2 :i64]]]
     ord
     :i0)
    (if
     (= n 1)
     (record-get
      [:record :rebalance/order [[:i0 :i64] [:i1 :i64] [:i2 :i64]]]
      ord
      :i1)
     (record-get
      [:record :rebalance/order [[:i0 :i64] [:i1 :i64] [:i2 :i64]]]
      ord
      :i2))),
   :param-types [[:ref :rebalance/order] :i64]}
  {:name take-end,
   :params [start k remaining],
   :result :i64,
   :effects #{},
   :body (min2 remaining (+ start k)),
   :param-types [:i64 :i64 :i64]}
  {:name take-count,
   :params [start end],
   :result :i64,
   :effects #{},
   :body (max2 0 (- end start)),
   :param-types [:i64 :i64]}
  {:name pipeline-note,
   :params [text-n usable],
   :result :string,
   :effects #{},
   :body
   (string-concat
    "text pool sharded as a "
    (string-concat
     (i64-str text-n)
     (string-concat
      "-way pipeline (~"
      (string-concat
       (i64-str (* usable text-n))
       (string-concat
        "GB effective, ceiling "
        (string-concat (i64-str (shard-ceiling-gb)) "GB/node)")))))),
   :param-types [:i64 :i64]}
  {:name rebalance-reason-detail,
   :params [code move-count],
   :result :string,
   :effects #{},
   :body
   (if
    (= code 2)
    (string-concat
     (i64-str move-count)
     " node(s) re-placed by demand shift")
    (rebalance-reason-name code)),
   :param-types [:i64 :i64]}],
