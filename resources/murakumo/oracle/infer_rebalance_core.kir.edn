   :result :i64,
   :effects #{},
   :body
   (let
    [raw
     (- ram-gb 6)
     floored
     (if (< raw 0) 0 raw)
     ceil
     (shard-ceiling-gb)]
    (if (< floored ceil) floored ceil)),
   :param-types [:i64]}
  {:name pool-for-class,
   :params [cls],
   :result :string,
   :effects #{},
   :body
   (if
    (string=? cls "text")
    "text-pool"
    (if
     (string=? cls "postproc")
     "postproc-pool"
     (if
      (if
       (string=? cls "image")
       1
       (if (string=? cls "video") 1 (if (string=? cls "audio") 1 0)))
      "media-pool"
      "text-pool"))),
   :param-types [:string]}
  {:name rem64,
   :params [a b],
   :result :i64,
   :effects #{},
   :body (- a (* (quot a b) b)),
   :param-types [:i64 :i64]}
  {:name weight-pos?,
   :params [w],
   :result :bool,
   :effects #{},
   :body (if (< 0 w) true false),
   :param-types [:i64]}
  {:name count-active,
   :params [wt wm wp],
   :result :i64,
   :effects #{},
   :body
   (+
    (if (weight-pos? wt) 1 0)
    (+ (if (weight-pos? wm) 1 0) (if (weight-pos? wp) 1 0))),
   :param-types [:i64 :i64 :i64]}
  {:name min2,
   :params [a b],
