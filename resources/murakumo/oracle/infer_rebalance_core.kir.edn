  {:name demand-inc,
   :params [d class-code],
   :result [:ref :rebalance/demand],
   :effects #{},
   :body
   (let
    [t
     (record-get
      [:record
       :rebalance/demand
       [[:text :i64]
        [:image :i64]
        [:video :i64]
        [:audio :i64]
