  {:name better-bump?,
   :params [rem-a idx-a rem-b idx-b],
   :result :bool,
   :effects #{},
   :body
   (if
    (< rem-b rem-a)
    true
    (if (< rem-a rem-b) false (if (< idx-a idx-b) true false))),
   :param-types [:i64 :i64 :i64 :i64]}
  {:name pick-bump-3,
   :params [ok-t ok-m ok-p rems],
   :result :i64,
   :effects #{},
   :body
   (let
    [rt
     (record-get
      [:record
       :rebalance/lanes
       [[:text :i64] [:media :i64] [:postproc :i64]]]
      rems
      :text)
     rm
     (record-get
      [:record
       :rebalance/lanes
       [[:text :i64] [:media :i64] [:postproc :i64]]]
      rems
      :media)
     rp
     (record-get
      [:record
       :rebalance/lanes
       [[:text :i64] [:media :i64] [:postproc :i64]]]
      rems
      :postproc)]
    (if
     ok-t
     (if
      ok-m
      (let
       [win-tm
        (if (better-bump? rt 0 rm 1) 0 1)
        r-win
        (if (= win-tm 0) rt rm)
        i-win
        win-tm]
       (if ok-p (if (better-bump? r-win i-win rp 2) win-tm 2) win-tm))
      (if ok-p (if (better-bump? rt 0 rp 2) 0 2) 0))
     (if
      ok-m
      (if ok-p (if (better-bump? rm 1 rp 2) 1 2) 1)
      (if ok-p 2 -1)))),
   :param-types
   [:bool
    :bool
    :bool
    [:record
     :rebalance/lanes
     [[:text :i64] [:media :i64] [:postproc :i64]]]]}
  {:name ok-for,
   :params [active bumped],
   :result :bool,
   :effects #{},
   :body (if active (if bumped false true) false),
   :param-types [:bool :bool]}
  {:name seats-record,
   :params [total wt wm wp floor],
   :result
   [:record
    :rebalance/lanes
    [[:text :i64] [:media :i64] [:postproc :i64]]],
   :effects #{},
   :body
   (let
    [at
     (weight-pos? wt)
     am
     (weight-pos? wm)
     ap
     (weight-pos? wp)
     n-active
     (count-active wt wm wp)]
    (if
     (if (= total 0) 1 (if (= n-active 0) 1 0))
     (record-new
      [:record
       :rebalance/lanes
       [[:text :i64] [:media :i64] [:postproc :i64]]]
      0
      0
      0)
     (let
      [eff-floor
       (min2 floor (quot total n-active))
       bt
       (if at eff-floor 0)
       bm
       (if am eff-floor 0)
       bp
       (if ap eff-floor 0)
       left0
       (- total (+ bt (+ bm bp)))
       left
       (max2 0 left0)
       sumw
       (+ (if at wt 0) (+ (if am wm 0) (if ap wp 0)))
       pt
       (if at (* left wt) 0)
       pm
       (if am (* left wm) 0)
       pp
       (if ap (* left wp) 0)
       ft
       (if at (quot pt sumw) 0)
       fm
       (if am (quot pm sumw) 0)
       fp
       (if ap (quot pp sumw) 0)
       rt
       (if at (rem64 pt sumw) 0)
       rm
       (if am (rem64 pm sumw) 0)
       rp
       (if ap (rem64 pp sumw) 0)
       assigned
       (+ ft (+ fm fp))
       extra
       (- left assigned)
       rems
       (record-new
        [:record
         :rebalance/lanes
         [[:text :i64] [:media :i64] [:postproc :i64]]]
        rt
        rm
        rp)
       b0
       (if
        (< 0 extra)
        (pick-bump-3
         (ok-for at false)
         (ok-for am false)
         (ok-for ap false)
         rems)
        -1)
       bt0
       (if (= b0 0) true false)
       bm0
       (if (= b0 1) true false)
       bp0
       (if (= b0 2) true false)
       b1
       (if
        (< 1 extra)
        (pick-bump-3
         (ok-for at bt0)
         (ok-for am bm0)
         (ok-for ap bp0)
         rems)
        -1)
       bt1
       (if (= b1 0) true bt0)
       bm1
       (if (= b1 1) true bm0)
       bp1
       (if (= b1 2) true bp0)
       b2
       (if
        (< 2 extra)
        (pick-bump-3
         (ok-for at bt1)
         (ok-for am bm1)
         (ok-for ap bp1)
         rems)
        -1)
       bump-t
       (if (if (= b0 0) 1 (if (= b1 0) 1 (if (= b2 0) 1 0))) 1 0)
       bump-m
       (if (if (= b0 1) 1 (if (= b1 1) 1 (if (= b2 1) 1 0))) 1 0)
       bump-p
       (if (if (= b0 2) 1 (if (= b1 2) 1 (if (= b2 2) 1 0))) 1 0)
       st
       (+ bt (+ ft bump-t))
       sm
       (+ bm (+ fm bump-m))
       sp
       (+ bp (+ fp bump-p))]
      (record-new
       [:record
        :rebalance/lanes
        [[:text :i64] [:media :i64] [:postproc :i64]]]
       st
       sm
       sp)))),
   :param-types [:i64 :i64 :i64 :i64 :i64]}
