;; ノードの排他資源クラス — 生成ジョブの入場を決める**唯一の宣言**。
;;
;; ── なぜ要るのか ──
;;
;; ノードは「同時に 1 つしか載らないもの」を持っている。gad の APU は memory を
;; CPU と GPU で共有していて、**MiniMax-H3(~43GB)と Wan 5B は同時に載らない**。
;; この事実は 2026-08-14 まで 2 か所に、どちらも宣言でない形で存在していた:
;;
;;   1. ComfyUI 自身の queue —— 1 prompt ずつしか実行しないので、結果として
;;      直列化する。**偶然であって保証ではない**（instance が 2 つある時点で
;;      2 本同時に走りうる）
;;   2. `comfy_yield_sibling` —— 相方が抱えている torch memory を測り、
;;      8GB 以上なら **相方の systemd unit を再起動する**手続き
;;
;; どちらも「この資源は 1 つしかない」とは言っていない。言っていないので、
;; generation API は submit のたびに無条件でスレッドを起こし、その全部が
;; ComfyUI の queue と APU の memory を取り合っていた。
;;
;; 実測 2026-08-14: 20 ページの連続生成が、別セッションの farm 作業と衝突して
;; 2 ページ続けて落ちた。片方は入場拒否（120 秒待って `sibling ComfyUI still
;; has a running job`）、もう片方は**走行中に相方から H3 を止められて**
;; `Connection refused`。どちらもこの宣言があれば「待ち」になっていた。
;;
;; ── 何をここに書くか ──
;;
;; **判断はここに、機構はノードに。** ノードの Python はこの表を引いて数えるだけで、
;; 「何と何が排他か」を自分では決めない（aiueos の kernel が
;; decision-free な機構だけを持つのと同じ分担、ADR-2607241100 D6）。
;;
;; 台数を足す・モデルを足すときに書き換えるのはこのファイルであって、
;; ノードのコードではない。

{:doc "generation ジョブが取り合う、ノード上の排他資源"

 :classes
 {:apu/video
  {:doc "1 つの APU に同時に載せられる video モデルの本数。ComfyUI の
         instance 数ではなく **memory の本数**なので、instance を増やしても
         増えない —— 増やしたのが 2026-08-10 の 2 インスタンス並走で、
         そこで容量が 2 になったと誤解されうる形になった。"
   :capacity 1
   ;; **この宣言が縛れるのは、この API を通ったジョブだけ。** ComfyUI へ直接
   ;; 投げられた仕事（render farm はそう動かされている）は入場キューから見えない。
   ;; 実測 2026-08-14: こちらの queue が空(running 0 / depth {})なのに submit が
   ;; `sibling ComfyUI still has a running job` で落ちた。
   ;; :comfy-any = 起動前に ComfyUI 側の busy も見る（拒否ではなく待ちにする）。
   :external-busy-check :comfy-any
   ;; ノードごとに違うなら :capacity-by-node で上書きする。
   ;; 単一 GPU で VRAM に収まりきるノードが来たらここが 2 以上になる。
   :capacity-by-node {"gad" 1}}}

 ;; どのモデルがどのクラスを占めるか。**ここに無いモデルはクラスを取らない**
 ;; （= 排他されない）。image / voice / motion は video の memory を取らないので
 ;; 意図的に空にしてある —— 取るようになったら、その時ここに足す。
 :model-class
 {"minimax-h3"        :apu/video
  "wan2.2-ti2v-5b"    :apu/video
  "wan-dancer-14b"    :apu/video
  "ltx-2.3"           :apu/video
  "hunyuanvideo-1.5"  :apu/video}

 ;; hosted なモデルは他人の GPU で走るので、こちらの資源を取らない。
 ;; （`spec["host"] == "fal"` はノード側で判定する。ここは名前を持たない）
 :hosted-take-no-class true

 ;; 運転上のタイムアウト。**1800 秒という定数は、fleet 自身の既定モデルが
 ;; その中で終われない値だった**（実測: 640×640/124f/20steps で 38 分 04 秒、
 ;; ADR-2608100600 は 175f で 100.6 分）。モデルごとの実測点から伸ばす。
 ;;
 ;; ⚠ **frames に対して線形ではない**（実測: frames 0.71 倍で s/step 0.39 倍）。
 ;; ここでは線形で見積もる —— タイムアウトは過大に見積もる側が安全だから。
 ;; 「速さの推定値」としてここを引用しないこと。
 :deadline
 {:default-s 1800
  :by-model
  {"minimax-h3" {:measured-s 6038 :at-frames 175 :at-steps 20
                 :safety 2.0
                 :note "ADR-2608100600 の実測点。640×640/124f では 2284 秒だった
                        （2026-08-14）が、こちらは 1 点なので大きい方を基準にする"}}}}
