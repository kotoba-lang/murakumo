(ns murakumo.node-cli
  "Distribution entry for the existing nbb resident; not a native runtime migration."
  (:require [murakumo.infer.poll-worker :as worker]
            [murakumo.bench :as bench]
            [murakumo.fleet-ps :as fleet-ps]
            [cacao.edge.mint :as mint]
            [kotoba.lang.text :as str]
            ["node:fs" :as fs] ["node:path" :as path]
            ["node:os" :as os] ["node:crypto" :as crypto]))

(defn help []
  (println "Murakumo node CLI\n\n  murakumo node init                      Create a private device identity\n  murakumo node doctor --model ID         Check local model and identity (read-only)\n  murakumo node check --model ID          Enroll + verify heartbeat; do not take jobs\n  murakumo node join --model ID           Serve Community jobs until Ctrl-C\n  murakumo node earnings                  Show earned and payable device credits\n  murakumo node payout --credits N --to 0xADDRESS\n                                          Request an operator-approved payout\n\nOptions: --name NAME --local-url http://127.0.0.1:11434/v1\n         --base https://api.murakumo.cloud\nNode.js 22+, a running OpenAI-compatible model server and network access are required.\nInstallation does not download models or start a service. Community enrollment\nmay remain pending admission; a heartbeat alone does not prove job eligibility.")
  (println "\n  murakumo fleet ps [--node N] [--json]   What each fleet node runs: model servers
                                          (ctx, KV, slots), co-resident processes, units")
  (println "\n  murakumo bench nodes                    List tailnet nodes (name, ip, online)\n  murakumo bench run --node N --model P --engine llama|diffuse\n  murakumo bench ledger [--limit N]       Show the append-only measurement ledger\n\nMeasurements record argv, the model's bytes and hash, the host's memory and the\nengine's own output. Nothing here enrols a node or publishes a number.\n  murakumo bench --help"))

(defn identity-path []
  (or (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
      (.join path (or (aget js/process.env "MURAKUMO_NODE_HOME")
                      (.join path (.homedir os) ".local" "share" "murakumo-node"))
             "identity.json")))
(defn- checked-identity [raw]
  (let [pem (or (.-privateKey raw) (.-privateKeyPem raw))
        did (.-did raw)]
    (when-not (and (string? pem) (string? did))
      (throw (js/Error. "Device identity is missing its DID or private key.")))
    (let [private (.createPrivateKey crypto pem)
          _ (when-not (= "ed25519" (.-asymmetricKeyType private))
              (throw (js/Error. "Device identity key must be Ed25519.")))
          public (.export (.createPublicKey crypto private)
                          #js {:format "der" :type "spki"})
          raw-public (.subarray public (- (.-length public) 32))]
      (when-not (= did (mint/did-key-from-raw-ed25519-pub raw-public))
        (throw (js/Error. "Device identity DID does not match its private key."))))
    #js {:did did :privateKey pem}))
(defn identity []
  (let [p (identity-path)]
    (when (and (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
               (not (.isAbsolute path p)))
      (throw (js/Error. "MURAKUMO_NODE_IDENTITY_FILE must be absolute.")))
    (when (and (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
               (not (.existsSync fs p)))
      (throw (js/Error. "Externally provisioned device identity is missing.")))
    (when (.existsSync fs p)
      (let [fd (.openSync fs p (bit-or (.-O_RDONLY (.-constants fs))
                                     (.-O_NOFOLLOW (.-constants fs))))]
        (try
          (let [st (.fstatSync fs fd)]
            (when (or (not (.isFile st)) (not= 0 (bit-and (.-mode st) 63)))
              (throw (js/Error. "Device identity must be a private regular file (chmod 600).")))
            (try (checked-identity (js/JSON.parse (.readFileSync fs fd "utf8")))
                 (catch :default _ (throw (js/Error. "Device identity file is invalid or does not match its DID; restore your private backup.")))))
          (finally (.closeSync fs fd)))))))
(defn init! []
  (when (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
    (throw (js/Error. "Externally provisioned identity is managed by the installer; do not run node init.")))
  (if-let [id (identity)]
    (println "Identity already exists:" (.-did id))
    (let [kp (.generateKeyPairSync crypto "ed25519")
          pub (.export (.-publicKey kp) #js {:format "der" :type "spki"})
          raw (.subarray pub (- (.-length pub) 32))
          did (mint/did-key-from-raw-ed25519-pub raw)
          pem (.export (.-privateKey kp) #js {:format "pem" :type "pkcs8"})
          p (identity-path)]
      (.mkdirSync fs (.dirname path p) #js {:recursive true :mode 448})
      (.writeFileSync fs p (js/JSON.stringify #js {:did did :privateKey pem}) #js {:mode 384 :flag "wx"})
      (println "Device identity created:" did)
      (println "Private key stays on this PC. Next: murakumo node doctor --model <served-model-id>"))))
(defn utc [ms] (.replace (.toISOString (js/Date. ms)) #"\.\d{3}Z$" "Z"))
(defn mint!
  ([id base] (mint! id base []))
  ([id base resources]
   (mint/mint (.-did id)
              #(js/Promise.resolve (.sign crypto nil % (.-privateKey id)))
              {:domain (.-host (js/URL. base)) :aud base
               :nonce (.randomUUID crypto) :iat (utc (js/Date.now))
               :exp (utc (+ (js/Date.now) 3600000))
               :resources resources})))
(defn fail! [message] (println message) (set! (.-exitCode js/process) 1))
(defn options [args]
  (when (or (odd? (count args))
            (some (fn [[k v]] (or (not (contains? #{"--model" "--name" "--local-url" "--base" "--trust-tier"} k))
                                 (str/starts-with? v "--"))) (partition 2 args)))
    (throw (js/Error. "Unknown option or missing value. Use murakumo node --help.")))
  (worker/parse-args args))
(defn control-base [value]
  (let [base (str/replace (or value "https://api.murakumo.cloud") #"/+$" "")
        u (js/URL. base)]
    (when-not (or (= "https:" (.-protocol u))
                  (and (= "http:" (.-protocol u))
                       (contains? #{"localhost" "127.0.0.1" "[::1]"} (.-hostname u))))
      (throw (js/Error. "The control plane must use HTTPS (HTTP is allowed only on loopback).")))
    (when (or (seq (.-username u)) (seq (.-password u))
              (not= "/" (.-pathname u))
              (seq (.-search u)) (seq (.-hash u)))
      (throw (js/Error. "The control plane base must contain only a scheme and host.")))
    base))
(defn payout-options [args command]
  (let [allowed (if (= command "earnings") #{"--base"}
                    #{"--base" "--credits" "--to"})]
    (when (or (odd? (count args))
              (some (fn [[k v]]
                      (or (not (contains? allowed k)) (str/starts-with? v "--")))
                    (partition 2 args)))
      (throw (js/Error. "Unknown payout option or missing value.")))
    (worker/parse-args args)))
(defn payout-command! [command args]
  (let [opts (payout-options args command)
        base (control-base (:base opts))
        id (identity)]
    (when-not id
      (throw (js/Error. "Run murakumo node init or configure MURAKUMO_NODE_IDENTITY_FILE first.")))
    (if (= command "earnings")
      (-> (js/fetch (str base "/infer/payout?did="
                         (js/encodeURIComponent (.-did id)))
                    #js {:signal (js/AbortSignal.timeout 30000)})
          (.then (fn [response]
                   (if (.-ok response)
                     (-> (.json response)
                         (.then (fn [body]
                                  (let [account (.-account body)
                                        policy (.-policy body)]
                                    (println "Device DID:" (.-did id))
                                    (println "Earned credits:" (aget account "earned"))
                                    (println "Payable credits:" (aget account "payable"))
                                    (println "Minimum request:" (aget policy "minimum-credits"))))))
                     (fail! (str "Earnings lookup refused (HTTP " (.-status response) ")."))))))
      (let [credits-text (:credits opts)
            credits (when (and (string? credits-text)
                               (re-matches #"[1-9][0-9]*" credits-text))
                      (js/Number credits-text))
            to (:to opts)]
        (when-not (and (js/Number.isSafeInteger credits) (pos? credits))
          (throw (js/Error. "--credits must be a positive whole number of credits.")))
        (when-not (and (string? to) (re-matches #"0x[0-9a-fA-F]{40}" to))
          (throw (js/Error. "--to must be a 20-byte 0x-prefixed EVM address.")))
        (-> (mint! id base [(str "murakumo:payout?to=" to
                                 "&credits=" credits)])
            (.then (fn [session]
                     (js/fetch (str base "/infer/payout/request")
                               #js {:method "POST"
                                    :headers #js {"content-type" "application/json"
                                                  "authorization" (str "CACAO " (:cacao-b64 session))}
                                    :body (js/JSON.stringify
                                           #js {:did (.-did id) :credits credits :to to})
                                    :signal (js/AbortSignal.timeout 30000)})))
            (.then (fn [response]
                     (-> (.json response)
                         (.then (fn [body]
                                  (if (= 201 (.-status response))
                                    (do (println "Payout request:" (or (.-payout-id body) "submitted"))
                                        (println "Awaiting operator approval; no transfer has occurred."))
                                    (fail! (str "Payout request refused (HTTP "
                                                (.-status response) "): "
                                                (or (.-error body) "unknown"))))))))))))))
(defn run! [command opts]
  (let [base (control-base (:base opts))
        local (str/replace (or (:local-url opts) "http://127.0.0.1:11434/v1") #"/+$" "")
        model (:model opts)
        id (identity)
        env (js->clj js/process.env)
        auth (worker/control-auth opts env)]
    (when-not (and (string? model) (not (str/blank? model)))
      (throw (js/Error. "Specify --model exactly as returned by the local /v1/models endpoint.")))
    (-> (worker/probe-readiness-with-fetch! js/fetch local (worker/local-auth-token opts env) model)
        (.then (fn [probe]
                 (println "Local model:" (if (:ready? probe) "ready" "not ready") "(HTTP" (:status probe) ")")
                 (println "Device authentication:" (if (or auth id) "configured" "missing; run murakumo node init"))
                 (cond
                   (not (:ready? probe)) (fail! "Start the local model server and use its exact model ID before joining.")
                   (not (or auth id)) (fail! "Run murakumo node init, then repeat this command.")
                   (= command "doctor") (println "Preflight passed. No registration or inference was performed.")
                   :else
                   (let [opts (assoc opts :base base :local-url local :check (= command "check"))]
                     (if auth
                       (worker/-main opts)
                       (-> (mint! id base)
                           (.then (fn [token]
                                    (let [current (atom (:cacao-b64 token))]
                                      (when (= command "join")
                                        (.unref (js/setInterval
                                                 #(-> (mint! id base)
                                                      (.then (fn [t] (reset! current (:cacao-b64 t))))
                                                      (.catch (fn [_] (println "Device session renewal failed."))))
                                                 1800000)))
                                      (worker/-main (assoc opts :did (.-did id) :cacao #(deref current)))))))))))))))

(let [;; kbb passes the script's own args as *command-line-args* (process.argv
      ;; still holds kbb's --classpath and the script path); the bundled release
      ;; (`node node.mjs …`) has none, and its args start at argv[2].
      argv (vec (or (seq *command-line-args*) (array-seq (.slice js/process.argv 2))))
      [prefix command & args] argv]
  (try
    (cond
      (or (nil? prefix) (= prefix "--help")) (help)
      ;; `bench` is measured-only and never enrols: it dispatches into its own
      ;; namespace so a bench run cannot reach the node's identity or the
      ;; control plane. Its exit code is the command's, not this dispatcher's.
      (= prefix "bench")
      (let [code (bench/run-command command args)]
        (when (not= 0 code) (set! (.-exitCode js/process) code))
        (when (nil? command) (set! (.-exitCode js/process) 1)))
      ;; `fleet` is read-only: it ssh-reads each node and never enrols or writes.
      (= prefix "fleet")
      (-> (fleet-ps/run-command command args)
          (.then (fn [code] (when (not= 0 code) (set! (.-exitCode js/process) code)))))
      (= command "--help") (help)
      (not= prefix "node") (fail! "Use: murakumo node --help or murakumo bench --help")
      (= command "init") (init!)
      (contains? #{"earnings" "payout"} command)
      (-> (payout-command! command args)
          (.catch (fn [_] (fail! "Payout operation failed. Check the network, device identity and request; no credentials are printed."))))
      (contains? #{"doctor" "check" "join"} command)
      (-> (run! command (options args))
          (.catch (fn [_] (fail! "Node operation failed. Check the local server, network and device identity; no credentials are printed."))))
      :else (fail! "Unknown command. Use: murakumo node --help"))
    (catch :default e (fail! (.-message e)))))
