(ns murakumo.node-cli
  "Distribution entry for the existing nbb resident; not a native runtime migration."
  (:require [murakumo.infer.poll-worker :as worker]
            [murakumo.bench :as bench]
            [murakumo.fleet-ps :as fleet-ps]
            [murakumo.health :as health]
            [murakumo.device-claim :as claim]
            [cacao.edge.mint :as mint]
            [kotoba.lang.text :as str]
            ["node:fs" :as fs] ["node:path" :as path]
            ["node:os" :as os] ["node:crypto" :as crypto]))

(defn help []
  (println "Murakumo node CLI\n\n  murakumo node init                      Create a private device identity\n  murakumo node claim-once                Answer one pending buyer claim challenge\n  murakumo node doctor --model ID         Check local model and identity (read-only)\n  murakumo node check --model ID          Enroll + verify heartbeat; do not take jobs\n  murakumo node qualify --model ID        Run the local model through Community admission\n  murakumo node join --model ID           Serve Community jobs until Ctrl-C\n  murakumo node earnings                  Show earned and payable device credits\n  murakumo node payout --credits N --to 0xADDRESS\n                                          Request an operator-approved payout\n\nOptions: --name NAME --local-url http://127.0.0.1:11434/v1\n         --base https://api.murakumo.cloud\n         --authn https://auth.murakumo.cloud\n         --idle-only (join: accept new jobs only when host load and free RAM allow)\nNode.js 22+ and network access are required. Model checks and Community jobs also\nrequire a running OpenAI-compatible model server. Installation does not download\nmodels or start a service. Run check, then qualify before joining Community jobs;\na heartbeat alone does not prove job eligibility.")
  (println "\n  murakumo fleet ps [--node N] [--json]   What each fleet node runs: model servers
                                          (ctx, KV, slots), co-resident processes, units")
  (println "  Payout also requires --owner-token-file /absolute/private/path from the buyer's device page.")
  (println "\n  murakumo bench nodes                    List tailnet nodes (name, ip, online)\n  murakumo bench run --node N --model P --engine llama|diffuse\n  murakumo bench ledger [--limit N]       Show the append-only measurement ledger\n\nMeasurements record argv, the model's bytes and hash, the host's memory and the\nengine's own output. Nothing here enrols a node or publishes a number.\n  murakumo bench --help")
  (println "\n  murakumo health check [--canary]        Probe every fleet node + the gateway, score it, record it\n  murakumo health slo | history            Availability, flapping and canary drift from the ledger\n  murakumo health heal [--apply]           Plan (or run) the one guarded self-heal\n  murakumo health --help"))

(defn identity-path []
  (or (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
      (.join path (or (aget js/process.env "MURAKUMO_NODE_HOME")
                      (.join path (.homedir os) ".local" "share" "murakumo-node"))
             "identity.json")))
(defn- checked-identity [raw]
  (let [pem (or (.-privateKey raw) (.-privateKeyPem raw))
        did (.-did raw)]
    (when-not (and (string? pem) (string? did))
      (throw (js/Error. "Device identity is missing its DID or private key.")))
    (let [private (.createPrivateKey crypto pem)
          _ (when-not (= "ed25519" (.-asymmetricKeyType private))
              (throw (js/Error. "Device identity key must be Ed25519.")))
          public (.export (.createPublicKey crypto private)
                          #js {:format "der" :type "spki"})
          raw-public (.subarray public (- (.-length public) 32))]
      (when-not (= did (mint/did-key-from-raw-ed25519-pub raw-public))
        (throw (js/Error. "Device identity DID does not match its private key."))))
    #js {:did did :privateKey pem}))
(defn identity []
  (let [p (identity-path)]
    (when (and (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
               (not (.isAbsolute path p)))
      (throw (js/Error. "MURAKUMO_NODE_IDENTITY_FILE must be absolute.")))
    (when (and (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
               (not (.existsSync fs p)))
      (throw (js/Error. "Externally provisioned device identity is missing.")))
    (when (.existsSync fs p)
      (let [fd (.openSync fs p (bit-or (.-O_RDONLY (.-constants fs))
                                     (.-O_NOFOLLOW (.-constants fs))))]
        (try
          (let [st (.fstatSync fs fd)]
            (when (or (not (.isFile st)) (not= 0 (bit-and (.-mode st) 63)))
              (throw (js/Error. "Device identity must be a private regular file (chmod 600).")))
            (try (checked-identity (js/JSON.parse (.readFileSync fs fd "utf8")))
                 (catch :default _ (throw (js/Error. "Device identity file is invalid or does not match its DID; restore your private backup.")))))
          (finally (.closeSync fs fd)))))))
(defn init! []
  (when (aget js/process.env "MURAKUMO_NODE_IDENTITY_FILE")
    (throw (js/Error. "Externally provisioned identity is managed by the installer; do not run node init.")))
  (if-let [id (identity)]
    (println "Identity already exists:" (.-did id))
    (let [kp (.generateKeyPairSync crypto "ed25519")
          pub (.export (.-publicKey kp) #js {:format "der" :type "spki"})
          raw (.subarray pub (- (.-length pub) 32))
          did (mint/did-key-from-raw-ed25519-pub raw)
          pem (.export (.-privateKey kp) #js {:format "pem" :type "pkcs8"})
          p (identity-path)]
      (.mkdirSync fs (.dirname path p) #js {:recursive true :mode 448})
      (.writeFileSync fs p (js/JSON.stringify #js {:did did :privateKey pem}) #js {:mode 384 :flag "wx"})
      (println "Device identity created:" did)
      (println "Private key stays on this PC. Next: murakumo node doctor --model <served-model-id>"))))
(defn utc [ms] (.replace (.toISOString (js/Date. ms)) #"\.\d{3}Z$" "Z"))
(defn mint!
  ([id base] (mint! id base []))
  ([id base resources] (mint! id base resources 3600000))
  ([id base resources ttl-ms]
   (mint/mint (.-did id)
              #(js/Promise.resolve (.sign crypto nil % (.-privateKey id)))
              {:domain (.-host (js/URL. base)) :aud base
               :nonce (.randomUUID crypto) :iat (utc (js/Date.now))
               :exp (utc (+ (js/Date.now) ttl-ms))
               :resources resources})))
(defn fail! [message] (println message) (set! (.-exitCode js/process) 1))
(defn options [args]
  (let [idle-only? (some #{"--idle-only"} args)
        args (vec (remove #{"--idle-only"} args))]
  (when (or (odd? (count args))
            (some (fn [[k v]] (or (not (contains? #{"--model" "--name" "--local-url" "--base" "--authn" "--trust-tier"} k))
                                 (str/starts-with? v "--"))) (partition 2 args)))
    (throw (js/Error. "Unknown option or missing value. Use murakumo node --help.")))
  (assoc (worker/parse-args args) :idle-only (boolean idle-only?))))
(defn control-base [value]
  (let [base (str/replace (or value "https://api.murakumo.cloud") #"/+$" "")
        u (js/URL. base)]
    (when-not (or (= "https:" (.-protocol u))
                  (and (= "http:" (.-protocol u))
                       (contains? #{"localhost" "127.0.0.1" "[::1]"} (.-hostname u))))
      (throw (js/Error. "The control plane must use HTTPS (HTTP is allowed only on loopback).")))
    (when (or (seq (.-username u)) (seq (.-password u))
              (not= "/" (.-pathname u))
              (seq (.-search u)) (seq (.-hash u)))
      (throw (js/Error. "The control plane base must contain only a scheme and host.")))
    base))
(defn claim-once! [args]
  (when-not (or (empty? args)
                (and (= 2 (count args)) (= "--site" (first args))))
      (throw (js/Error. "Use murakumo node claim-once [--site https://localhost:PORT].")))
  (let [site (control-base (or (second args) "https://murakumo.cloud"))
        _ (when-not (or (= site "https://murakumo.cloud")
                        (str/starts-with? site "https://127.0.0.1:")
                        (str/starts-with? site "https://localhost:")
                        (str/starts-with? site "http://127.0.0.1:")
                        (str/starts-with? site "http://localhost:"))
            (throw (js/Error. "Claim service must be murakumo.cloud or local loopback.")))
        id (identity)]
    (when-not id
      (throw (js/Error. "Device identity is missing; factory-provision this device first.")))
    (-> (claim/once! js/fetch #(js/Date.now) site id)
        (.then (fn [{:keys [outcome exit-code]}]
                 (println "Claim response:" (name outcome))
                 (when (not= 0 exit-code) (set! (.-exitCode js/process) exit-code)))))))
(defn- fetch-node-grant! [id authn-base]
  (-> (mint! id authn-base ["murakumo://node-token"] 240000)
      (.then (fn [proof]
               (js/fetch (str authn-base "/v1/murakumo/node-token")
                         #js {:method "POST"
                              :headers #js {"content-type" "application/json"}
                              :body (js/JSON.stringify #js {:cacao_b64 (:cacao-b64 proof)})
                              :signal (js/AbortSignal.timeout 30000)})))
      (.then (fn [response]
               (-> (.json response)
                   (.then (fn [body]
                            (let [token (.-token body)
                                  expires-at (js/Date.parse (.-expiresAt body))]
                              (if (and (= 201 (.-status response))
                                       (string? token)
                                       (re-matches #"[A-Za-z0-9_-]{80,8192}" token)
                                       (= "Biscuit" (.-tokenType body))
                                       (= (.-did id) (.-holder body))
                                       (number? expires-at)
                                       (> expires-at (+ (js/Date.now) 60000)))
                                {:token token :expires-at expires-at}
                                (throw (js/Error. (str "Node authorization refused (HTTP "
                                                        (.-status response) ")."))))))))))))
(defn- qualification-post! [base token path body]
  (-> (js/fetch (str base path)
                #js {:method "POST"
                     :headers #js {"content-type" "application/json"
                                   "authorization" (str "Biscuit " token)}
                     :body (js/JSON.stringify
                            (clj->js body :keyword-fn
                                     (fn [k] (if-let [ns (namespace k)]
                                               (str ns "/" (name k)) (name k)))))
                     :signal (js/AbortSignal.timeout 30000)})
      (.then (fn [response]
               (-> (.json response)
                   (.then (fn [body]
                            {:status (.-status response)
                             :body (js->clj body :keywordize-keys true)})))))))

(defn- qualification-answer! [local local-token model item]
  (let [prompt (:prompt item)
        limit (:max-tokens item)]
    (when-not (and (string? prompt) (integer? limit) (<= 1 limit 128))
      (throw (js/Error. "The qualification challenge is malformed.")))
    (-> (worker/run-completion-with-fetch! js/fetch local local-token model prompt limit)
        (.then (fn [outcome]
                 (when-not (:ok outcome)
                   (throw (js/Error. "The local model did not complete a qualification item.")))
                 (let [usage (get-in outcome [:response :usage])]
                   (cond-> {:item/id (:id item)
                            :answer/text (:text outcome)
                            :answer/ms (:ms outcome)}
                     (integer? (:prompt_tokens usage))
                     (assoc :answer/prompt-tokens (:prompt_tokens usage))
                     (integer? (:completion_tokens usage))
                     (assoc :answer/generated-tokens (:completion_tokens usage)))))))))

(defn- qualify! [id base token local local-token model node-name]
  (-> (qualification-post! base token "/infer/qualification/challenge"
                           {:node/name node-name :node/did (.-did id) :model model})
      (.then (fn [{:keys [status body]}]
               (when-not (= 201 status)
                 (throw (js/Error. (str "Qualification challenge refused (HTTP " status
                                       "). Run node check before qualify."))))
               (let [qid (:id body)
                     items (:items body)]
                 (when-not (and (string? qid) (= 5 (count items)))
                   (throw (js/Error. "The qualification challenge is incomplete.")))
                 (-> (reduce (fn [answers item]
                               (.then answers
                                      (fn [rows]
                                        (-> (qualification-answer! local local-token model item)
                                            (.then #(conj rows %))))))
                             (js/Promise.resolve []) items)
                     (.then (fn [answers]
                              (qualification-post! base token "/infer/qualification/result"
                                                   {:qualification/id qid :did (.-did id)
                                                    :answers answers})))))))
      (.then (fn [{:keys [status body]}]
               (if (and (= 200 status) (= "accepted" (:verdict body))
                        (contains? #{"accepted" :accepted}
                                   (get-in body [:node :admission])))
                 (println "Community qualification accepted. This model may receive eligible public jobs.")
                 (do (println "Community qualification was not accepted (HTTP" status ").")
                     (when-let [failed (get-in body [:evidence :failed])]
                       (println "Failed items:" (pr-str failed)))
                     (set! (.-exitCode js/process) 1)))))))
(defn payout-options [args command]
  (let [allowed (if (= command "earnings") #{"--base"}
                    #{"--base" "--credits" "--to" "--owner-token-file"})]
    (when (or (odd? (count args))
              (some (fn [[k v]]
                      (or (not (contains? allowed k)) (str/starts-with? v "--")))
                    (partition 2 args)))
      (throw (js/Error. "Unknown payout option or missing value.")))
    (worker/parse-args args)))
(defn- owner-payout-token [file]
  (when-not (and (string? file) (.isAbsolute path file))
    (throw (js/Error. "--owner-token-file must be an absolute path to a private file.")))
  (let [fd (.openSync fs file (bit-or (.-O_RDONLY (.-constants fs))
                                  (.-O_NOFOLLOW (.-constants fs))))]
    (try
      (let [st (.fstatSync fs fd)
            token (str/trim (.readFileSync fs fd "utf8"))]
        (when-not (and (.isFile st) (= 0 (bit-and (.-mode st) 63))
                       (re-matches #"mk1\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+" token))
          (throw (js/Error. "Owner authorization file must be private (chmod 600) and contain a valid token.")))
        token)
      (finally (.closeSync fs fd)))))
(defn payout-command! [command args]
  (let [opts (payout-options args command)
        base (control-base (:base opts))
        id (identity)]
    (when-not id
      (throw (js/Error. "Run murakumo node init or configure MURAKUMO_NODE_IDENTITY_FILE first.")))
    (if (= command "earnings")
      (-> (js/fetch (str base "/infer/payout?did="
                         (js/encodeURIComponent (.-did id)))
                    #js {:signal (js/AbortSignal.timeout 30000)})
          (.then (fn [response]
                   (if (.-ok response)
                     (-> (.json response)
                         (.then (fn [body]
                                  (let [account (.-account body)
                                        policy (.-policy body)]
                                    (println "Device DID:" (.-did id))
                                    (println "Earned credits:" (aget account "earned"))
                                    (println "Payable credits:" (aget account "payable"))
                                    (println "Minimum request:" (aget policy "minimum-credits"))))))
                     (fail! (str "Earnings lookup refused (HTTP " (.-status response) ")."))))))
      (let [credits-text (:credits opts)
            credits (when (and (string? credits-text)
                               (re-matches #"[1-9][0-9]*" credits-text))
                      (js/Number credits-text))
            to (:to opts)
            owner-token (owner-payout-token (:owner-token-file opts))]
        (when-not (and (js/Number.isSafeInteger credits) (pos? credits))
          (throw (js/Error. "--credits must be a positive whole number of credits.")))
        (when-not (and (string? to) (re-matches #"0x[0-9a-fA-F]{40}" to))
          (throw (js/Error. "--to must be a 20-byte 0x-prefixed EVM address.")))
        (-> (mint! id base [(str "murakumo:payout?to=" to
                                 "&credits=" credits)])
            (.then (fn [session]
                     (js/fetch (str base "/infer/payout/request")
                               #js {:method "POST"
                                    :headers #js {"content-type" "application/json"
                                                  "authorization" (str "CACAO " (:cacao-b64 session))
                                                  "x-murakumo-owner-payout" owner-token}
                                    :body (js/JSON.stringify
                                           #js {:did (.-did id) :credits credits :to to})
                                    :signal (js/AbortSignal.timeout 30000)})))
            (.then (fn [response]
                     (-> (.json response)
                         (.then (fn [body]
                                  (if (= 201 (.-status response))
                                    (do (println "Payout request:" (or (aget body "payout-id") "submitted"))
                                        (println "Awaiting operator approval; no transfer has occurred."))
                                    (fail! (str "Payout request refused (HTTP "
                                                (.-status response) "): "
                                                (or (.-error body) "unknown"))))))))))))))
(defn run! [command opts]
  (let [base (control-base (:base opts))
        local (str/replace (or (:local-url opts) "http://127.0.0.1:11434/v1") #"/+$" "")
        model (:model opts)
        id (identity)
        env (js->clj js/process.env)
        auth (worker/control-auth opts env)]
    (when-not (and (string? model) (not (str/blank? model)))
      (throw (js/Error. "Specify --model exactly as returned by the local /v1/models endpoint.")))
    (-> (worker/probe-readiness-with-fetch! js/fetch local (worker/local-auth-token opts env) model)
        (.then (fn [probe]
                 (println "Local model:" (if (:ready? probe) "ready" "not ready") "(HTTP" (:status probe) ")")
                 (println "Device authentication:" (if (or auth id) "configured" "missing; run murakumo node init"))
                 (cond
                   (not (:ready? probe)) (fail! "Start the local model server and use its exact model ID before joining.")
                   (not (or auth id)) (fail! "Run murakumo node init, then repeat this command.")
                   (= command "doctor") (println "Preflight passed. No registration or inference was performed.")
                   (= command "qualify")
                   (if-not id
                     (fail! "Community qualification requires this device's private identity.")
                     (let [authn-base (control-base (or (:authn opts)
                                                        (aget js/process.env "MURAKUMO_AUTHN_BASE")
                                                        "https://auth.murakumo.cloud"))
                           node-name (or (:name opts) (some-> (.hostname os) (str/split #"\.") first)
                                         "murakumo-node")]
                       (when-not (worker/valid-node-name? node-name)
                         (throw (js/Error. "The node name is invalid.")))
                       (-> (fetch-node-grant! id authn-base)
                           (.then (fn [grant]
                                    (qualify! id base (:token grant) local
                                              (worker/local-auth-token opts env) model node-name))))))
                   :else
                   (let [opts (assoc opts :base base :local-url local :check (= command "check"))]
                     (if auth
                       (worker/-main opts)
                       (let [authn-base (control-base (or (:authn opts)
                                                          (aget js/process.env "MURAKUMO_AUTHN_BASE")
                                                          "https://auth.murakumo.cloud"))]
                         (-> (fetch-node-grant! id authn-base)
                             (.then (fn [grant]
                                      (let [current (atom grant)
                                            credential (fn []
                                                         (let [{:keys [token expires-at]} @current]
                                                           (when-not (and token
                                                                          (> expires-at (+ (js/Date.now) 30000)))
                                                             (throw (js/Error. "Node authorization expired.")))
                                                           token))]
                                        (when (= command "join")
                                          (.unref (js/setInterval
                                                   #(when (< (:expires-at @current)
                                                             (+ (js/Date.now) 300000))
                                                      (-> (fetch-node-grant! id authn-base)
                                                          (.then (fn [next-grant]
                                                                   (reset! current next-grant)))
                                                          (.catch (fn [_]
                                                                    (println "Device authorization renewal failed.")))))
                                                   60000)))
                                        (worker/-main (assoc opts :did (.-did id)
                                                             :biscuit credential)))))))))))))))

(let [;; kbb passes the script's own args as *command-line-args* (process.argv
      ;; still holds kbb's --classpath and the script path); the bundled release
      ;; (`node node.mjs …`) has none, and its args start at argv[2].
      argv (vec (or (seq *command-line-args*) (array-seq (.slice js/process.argv 2))))
      [prefix command & args] argv]
  (try
    (cond
      (or (nil? prefix) (= prefix "--help")) (help)
      ;; `bench` is measured-only and never enrols: it dispatches into its own
      ;; namespace so a bench run cannot reach the node's identity or the
      ;; control plane. Its exit code is the command's, not this dispatcher's.
      (= prefix "bench")
      (let [code (bench/run-command command args)]
        (when (not= 0 code) (set! (.-exitCode js/process) code))
        (when (nil? command) (set! (.-exitCode js/process) 1)))
      ;; `fleet` is read-only: it ssh-reads each node and never enrols or writes.
      (= prefix "fleet")
      (-> (fleet-ps/run-command command args)
          (.then (fn [code] (when (not= 0 code) (set! (.-exitCode js/process) code)))))
      ;; `health` probes and assesses the fleet; its one write is a guarded mesh
      ;; restart behind --apply, and it has no path to the node identity either.
      (= prefix "health")
      (let [code (health/run-command command args)]
        (when (and (number? code) (not= 0 code)) (set! (.-exitCode js/process) code)))
      (= command "--help") (help)
      (not= prefix "node") (fail! "Use: murakumo node, bench, fleet or health --help")
      (= command "init") (init!)
      (= command "claim-once")
      (-> (claim-once! args)
          (.catch (fn [_] (fail! "Claim response failed. Check the site, device identity and network."))))
      (contains? #{"earnings" "payout"} command)
      (-> (payout-command! command args)
          (.catch (fn [_] (fail! "Payout operation failed. Check the network, device identity and request; no credentials are printed."))))
      (contains? #{"doctor" "check" "qualify" "join"} command)
      (-> (run! command (options args))
          (.catch (fn [error]
                    (fail! (if (= command "qualify")
                             (str "Community qualification failed: " (.-message error))
                             "Node operation failed. Check the local server, network and device identity; no credentials are printed.")))))
      :else (fail! "Unknown command. Use: murakumo node --help"))
    (catch :default e (fail! (.-message e)))))
