;; ADR-260929 M3/M5 evidence: Phase 1 (live federated search) vs Phase 2 (own
;; index) on a fixed query set. Crawls the corpus ON A NODE (polite: 1 s/host),
;; indexes it there, then queries both.
;;   MURAKUMO_REPO=$PWD kbb --classpath "src:test" scripts/web-recall-bench.cljk <ssh-host> [out.edn]
(ns web-recall-bench
  (:require [cljs.reader :as reader]
            [murakumo.web.dispatch :as d]
            [murakumo.web.host :as host]
            [murakumo.web.search :as search]))

(def fs (js/require "fs"))

(defn recall-at [ranked expected k] (if (some #{expected} (take k ranked)) 1 0))
(defn rr [ranked expected] (if-let [i (first (keep-indexed (fn [i u] (when (= u expected) i)) ranked))] (/ 1.0 (inc i)) 0.0))

(let [[node-host out] *command-line-args*
      data (reader/read-string (.readFileSync fs "docs/evidence/web-recall-queries.edn" "utf8"))
      url-of (fn [t] (str "https://en.wikipedia.org/wiki/" t))
      cfg {:host node-host}
      c (d/call! (assoc cfg :timeout-ms 600000) :crawl
                 {:job-id "recall-crawl"
                  :plan {:seeds (mapv url-of (:corpus data)) :max-pages 30 :max-depth 0
                         :delay-ms 1000 :scope :same-host}})
      _ (when-not (:ok c) (println "CRAWL REFUSED" (pr-str c)) (.exit js/process 2))
      mcid (get-in c [:ok :manifest-cid])
      ix (d/call! cfg :index {:job-id "recall-index" :manifest-cid mcid :shards 16})
      _ (when-not (:ok ix) (println "INDEX REFUSED" (pr-str ix)) (.exit js/process 2))
      root (get-in ix [:ok :root-cid])
      seed (.toString (.randomBytes (js/require "crypto") 32) "hex")
      base-env (host/env {:store-dir (str (.tmpdir (js/require "os")) "/mw-recall") :seed-hex seed :node-did "did:local:bench"})
      ;; Phase 1 backend sets compared: real keyless indexes, a private SearXNG, and both
      p1-sets {:wiki+hn [(host/wikipedia {:name :wikipedia-en}) (host/hn-algolia {:name :hn})]
               :searxng [(host/modal-searxng {:name :searxng})]
               :all [(host/wikipedia {:name :wikipedia-en}) (host/hn-algolia {:name :hn})
                     (host/modal-searxng {:name :searxng})]}
      p1-key (keyword (or (nth *command-line-args* 2 nil) "wiki+hn"))
      penv (assoc base-env :backends (get p1-sets p1-key))
      rows (mapv (fn [[q expected-title]]
                   (let [expected (url-of expected-title)
                         p2 (d/call! cfg :index-search {:job-id "recall-q" :root-cid root :query q :k 10})
                         p2u (mapv :url (get-in p2 [:ok :results :results]))
                         p1 (search/search! penv {:job-id "recall-p1" :query q :k 10})
                         p1u (mapv :url (get-in p1 [:ok :results :results]))]
                     {:q q :expected expected
                      :p1-error (:refused p1) :p2-error (:refused p2)
                      :p1 {:r1 (recall-at p1u expected 1) :r3 (recall-at p1u expected 3) :r5 (recall-at p1u expected 5) :rr (rr p1u expected)}
                      :p2 {:r1 (recall-at p2u expected 1) :r3 (recall-at p2u expected 3) :r5 (recall-at p2u expected 5) :rr (rr p2u expected)}}))
                 (:queries data))
      n (count rows)
      avg (fn [ph k] (/ (reduce + (map #(get-in % [ph k]) rows)) (double n)))
      summary {:p1-backends p1-key :n n :corpus-pages (get-in ix [:ok :docs]) :index-counts (get-in ix [:ok :counts])
               :p1 (into {} (map (fn [k] [k (avg :p1 k)]) [:r1 :r3 :r5 :rr]))
               :p2 (into {} (map (fn [k] [k (avg :p2 k)]) [:r1 :r3 :r5 :rr]))
               :p1-errors (count (filter :p1-error rows)) :p2-errors (count (filter :p2-error rows))}]
  (println (pr-str summary))
  (doseq [r rows :when (or (zero? (get-in r [:p2 :r5])) (zero? (get-in r [:p1 :r5])))]
    (println "MISS p1@5=" (get-in r [:p1 :r5]) "p2@5=" (get-in r [:p2 :r5]) (:expected r)))
  (when out (.writeFileSync fs out (pr-str {:summary summary :rows rows :root-cid root :manifest-cid mcid}))))
