;; Health of every node in web-nodes.edn. Exit 0 only if all are reachable and healthy.
;;   kbb --classpath "src:test" scripts/web-fleet-health.cljk [web-nodes.edn]
(ns web-fleet-health
  (:require [cljs.reader :as reader]
            [murakumo.web.dispatch :as d]))

(let [fs (js/require "fs")
      file (or (first *command-line-args*) "web-nodes.edn")
      nodes (:nodes (reader/read-string (.readFileSync fs file "utf8")))
      rows (mapv (fn [{:keys [host app zone] :as cfg}]
                   (let [r (d/call! cfg :health {})]
                     (if-let [ok (:ok r)]
                       {:host (or host app) :zone zone :healthy? (:healthy? ok) :did (:node-did ok)
                        :store (:store ok) :free-gib (some-> (:free-bytes ok) (/ 1073741824.0) (js/Math.floor))
                        :pending (:pending-puts ok) :problems (:problems ok)}
                       {:host (or host app) :zone zone :healthy? false :error (or (:refused r) :unknown) :detail (:detail r)})))
                 nodes)]
  (doseq [r rows] (println (pr-str r)))
  (let [bad (remove :healthy? rows)]
    (println (str (count rows) " nodes, " (count bad) " unhealthy"))
    (when (seq bad) (.exit js/process 1))))
