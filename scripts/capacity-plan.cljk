;; scripts/capacity-plan — compute the fleet capacity plan from the measured
;; corpus and record it.
;;
;;   nbb --classpath "$(nbb <root>/scripts/cljk-classpath.cljk src:<text>/src)" \
;;       scripts/capacity-plan.cljk                # print summary + plan EDN
;;   ... --write                                    # also write resources/murakumo/capacity-plan.edn
;;   ... --publish                                  # also POST to api.murakumo.cloud/infer/placement
;;
;; The corpus is resources/murakumo/capacity-observations.edn; the planner is
;; murakumo.infer.capacity. Nothing here decides — it reads, computes, prints,
;; and records. `--publish` appends the plan to the fleet's placement event
;; stream (the same stream murakumo.infer.orchestrate writes), so the console
;; and the reconcile path read one record. Exit 2 when the corpus cannot be
;; read or the plan is not EDN-serialisable — a plan that could not be
;; computed must not look like a plan that was.
(ns capacity-plan
  (:require [murakumo.infer.capacity :as cap]
            [cljs.reader :as reader]
            ["node:fs" :as fs]
            ["node:path" :as path]))

(def corpus-path "resources/murakumo/capacity-observations.edn")
(def plan-path "resources/murakumo/capacity-plan.edn")
(def publish-url "https://api.murakumo.cloud/infer/placement")

(defn- fail! [msg] (println (str "REFUSED: " msg)) (js/process.exit 2))

(defn -main []
  (let [args (set *command-line-args*)
        corpus (try (reader/read-string (fs/readFileSync corpus-path "utf8"))
                    (catch :default e (fail! (str "corpus unreadable: " (.-message e)))))
        plan (cap/plan corpus)
        record (assoc plan
                      :placement/reason "capacity plan from measured corpus (murakumo.infer.capacity)"
                      :placement/corpus corpus-path
                      :placement/computed-at (.toISOString (js/Date.)))
        edn (pr-str record)]
    (when-not (= record (reader/read-string edn)) (fail! "plan does not round-trip through the reader"))
    (println (cap/summary plan))
    (println)
    (when (contains? args "--write")
      (fs/mkdirSync (path/dirname plan-path) #js {:recursive true})
      (fs/writeFileSync plan-path (str ";; GENERATED by scripts/capacity-plan.cljk from " corpus-path
                                       " — do not edit; re-measure the corpus.\n" edn "\n"))
      (println "wrote" plan-path))
    (if (contains? args "--publish")
      (-> (js/fetch publish-url #js {:method "POST"
                                     :headers #js {"content-type" "application/json"}
                                     :body (js/JSON.stringify (clj->js record))})
          (.then (fn [r] (-> (.text r) (.then (fn [t] (println "published" (.-status r) (subs t 0 200))
                                                 (js/process.exit (if (= 201 (.-status r)) 0 1)))))))
          (.catch (fn [e] (println "publish failed:" (str e)) (js/process.exit 1))))
      (when-not (contains? args "--write") (println edn)))))

(-main)
