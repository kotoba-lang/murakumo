(ns murakumo.plane-test
  (:require [cljs.reader :as reader]
            [kotoba.test :refer [deftest is]]
            [murakumo.plane :as plane]))

(def fs (js/require "fs"))
(def path (js/require "path"))

(def registry (reader/read-string (.readFileSync fs "resources/murakumo/planes.edn" "utf8")))

(defn- src-namespaces
  "Every namespace under src/, from its file path (the repo's ns-per-file layout)."
  []
  (letfn [(walk [d] (mapcat (fn [n] (let [f (.join path d n)]
                                       (if (.isDirectory (.statSync fs f)) (walk f) [f])))
                            (js->clj (.readdirSync fs d))))]
    (->> (walk "src")
         (keep #(second (re-matches #"src/(.+)\.clj[kcs]" %)))
         (map #(-> % (.replace (js/RegExp. "/" "g") ".") (.replace (js/RegExp. "_" "g") "-")))
         distinct sort vec)))

(deftest the-registry-is-valid
  (is (:ok (plane/validate registry)) (pr-str (:refused (plane/validate registry)))))

(deftest one-plane-one-subdomain
  (let [hosts (filter string? (map (comp :host :plane/gate) (:planes registry)))]
    (is (= (count hosts) (count (distinct hosts)))))
  (is (= {:refused {:registry :duplicate-gate-host}}
         (plane/validate (update registry :planes conj
                                 (assoc (plane/by-id registry :web) :plane/id :web-2))))))

(deftest every-namespace-has-exactly-one-owner-and-no-prefix-is-stale
  (let [nss (src-namespaces)]
    (is (> (count nss) 150) "the walk found the source tree")
    (is (empty? (remove #(plane/owner registry %) nss)))
    (is (= [] (plane/stale-prefixes registry nss)))
    (is (= :web (plane/owner registry "murakumo.web.origin")))
    (is (= :generation (plane/owner registry "murakumo.infer.media")) "longest prefix wins over murakumo.infer")
    (is (= :inference (plane/owner registry "murakumo.infer.join")))
    (is (= :jobs (plane/owner registry "murakumo.ci.worker")))
    (is (= :core (plane/owner registry "murakumo.enroll")))
    (is (= :core (plane/owner registry "murakumo.webhook")) "a prefix matches whole segments only")
    (is (nil? (plane/owner registry "other.ns")))))

(deftest a-node-runs-what-its-capabilities-and-opt-ins-allow
  (is (= [:inference :generation :storage] (plane/eligible-planes registry {:capabilities #{:accelerator :disk}})))
  (is (= [] (plane/eligible-planes registry {:capabilities #{:egress}})) "web needs the operator's opt-in")
  (is (= [:web] (plane/eligible-planes registry {:capabilities #{:egress} :opt-in #{:web}})))
  (is (= [:jobs] (plane/eligible-planes registry {:capabilities #{:wasm}})))
  (is (not-any? #{:lease :app} (plane/eligible-planes registry {:capabilities plane/capabilities :opt-in #{:lease :web}}))
      "planned planes run nowhere"))

(deftest bad-descriptors-are-named
  (is (= [:plane/settlement] (plane/plane-problems (assoc (plane/by-id registry :web) :plane/settlement :usd))))
  (is (= [:plane/requires] (plane/plane-problems (assoc (plane/by-id registry :web) :plane/requires #{:root}))))
  (is (= [:plane/missing-keys :plane/opt-in?] (plane/plane-problems (dissoc (plane/by-id registry :web) :plane/opt-in?)))))
