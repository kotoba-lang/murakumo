(ns murakumo.artifact-store-test
  (:require [kotoba.lang.error :as kerror] [kotoba.io :as kio] [kotoba.test :refer [deftest is]]
            [bonsai.object :as object]
            [bonsai.repo :as repo]
            [murakumo.artifact-store :as store]))

(deftest verified-filesystem-cas-roundtrip
  (let [root (str (kio/temp-dir
                   "murakumo-cas"))
        bytes (.getBytes "artifact")
        cid (second (object/write-blob (repo/empty-repo) bytes))
        cas (store/adapter root)]
    (is (= cid ((:put! cas) cid bytes)))
    (is (= "artifact" (String. ^bytes ((:get cas) cid))))
    (is (= cid ((:put! cas) cid bytes)))
    (is (thrown? kerror/ExceptionInfo ((:put! cas) cid (.getBytes "tampered"))))
    (is (thrown? kerror/ExceptionInfo (store/path root "../../escape")))))
