(ns murakumo.filecoin-tier-e2e-test
  "End-to-end check of the murakumo -> filecoin-cas process boundary: the real
  curl transport against a real sidecar process (../filecoin-cas).

  Skipped, loudly, unless MURAKUMO_FILECOIN_E2E is set, so the ordinary suite
  never spawns processes or touches the network:

    MURAKUMO_FILECOIN_E2E=memory      kbb -M:test -n murakumo.filecoin-tier-e2e-test
    MURAKUMO_FILECOIN_E2E=calibration kbb -M:test -n murakumo.filecoin-tier-e2e-test

  `memory` uses the sidecar's in-RAM network. `calibration` needs
  ../filecoin-cas/.filecoin-cas/calibration.key (see filecoin-cas
  scripts/roundtrip.cljk) and takes minutes: the object goes to Filecoin and is
  read back through it into a second, empty local store."
  (:require [kotoba.io :as kio]
            [kotoba.test :refer [deftest is async]]
            [multiformats.core :as mf]
            [murakumo.artifact-store :as store]
            [murakumo.filecoin-tier :as tier]
            ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as nodepath]))

(def cas-dir (.resolve nodepath "../filecoin-cas"))

(defn- start-sidecar!
  "Spawn the service; resolve {:child :url} once it prints its listening line."
  [{:keys [port token-file state-dir calibration?]}]
  (js/Promise.
    (fn [resolve reject]
      (let [env (js/Object.assign #js {} js/process.env
                                  #js {:FILECOIN_CAS_PORT (str port)
                                       :FILECOIN_CAS_STATE_DIR state-dir
                                       :FILECOIN_CAS_TOKEN_FILE token-file})
            _ (when calibration?
                (aset env "FILECOIN_CAS_CHAIN" "calibration")
                (aset env "FILECOIN_CAS_KEY_FILE"
                      (.join nodepath cas-dir ".filecoin-cas/calibration.key")))
            args (cond-> ["--backend" "sci" "bin/filecoin-cas-server.cljk"]
                   (not calibration?) (conj "--memory-network"))
            child (.spawn cp "kbb" (to-array args) #js {:cwd cas-dir :env env})
            buf (atom "")]
        (.on (.-stdout child) "data"
             (fn [d]
               (swap! buf str (.toString d))
               (when-let [[_ url] (re-find #":listening \"([^\"]+)\"" @buf)]
                 (resolve {:child child :url url}))))
        (.on (.-stderr child) "data" (fn [d] (js/process.stderr.write d)))
        (.on child "exit" (fn [code] (reject (js/Error. (str "sidecar exited " code)))))))))

(defn- poll-stored!
  "Resolve when the tier reports `cid` :stored (the sidecar drains every 15 s)."
  [cfg cid deadline]
  (js/Promise.
    (fn [resolve reject]
      (letfn [(step []
                (let [r ((:transport cfg) {:method "GET" :path (str "/status/" cid)})]
                  (cond
                    (and (= 200 (:status r))
                         (re-find #":state :stored" (str (:body r))))
                    (resolve true)
                    (> (js/Date.now) deadline) (reject (js/Error. "not stored in time"))
                    :else (js/setTimeout step 3000))))]
        (step)))))

(defn- run-e2e! [calibration?]
  (let [tmp (.mkdtempSync fs (.join nodepath (.tmpdir os) "mkfc-e2e-"))
        token-file (.join nodepath tmp "token")
        bad-token-file (.join nodepath tmp "bad")
        _ (.writeFileSync fs token-file "e2e-token-not-a-secret\n" #js {:mode 0600})
        _ (.writeFileSync fs bad-token-file "wrong\n" #js {:mode 0600})
        port (+ 20000 (rand-int 20000))
        sidecar (atom nil)]
    (-> (start-sidecar! {:port port :token-file token-file
                         :state-dir (.join nodepath tmp "state") :calibration? calibration?})
        (.then
          (fn [{:keys [child url]}]
            (reset! sidecar child)
            (let [env {"MURAKUMO_FILECOIN_CAS_URL" url
                       "MURAKUMO_FILECOIN_CAS_TOKEN_FILE" token-file}
                  base (assoc (tier/config-from-env #(get env %)) :timeout-s 60)
                  errors (atom [])
                  cfg (assoc base
                             :transport (tier/curl-transport base)
                             :on-error #(swap! errors conj %))
                  ;; every byte value, 256 KiB: proves the curl path is binary safe
                  data (let [b (js/Buffer.alloc (* 256 1024))]
                         (dotimes [i (.-length b)] (aset b i (mod i 256)))
                         b)
                  cid (mf/cidv1-raw data)
                  a (tier/wrap (store/adapter (str (kio/temp-dir "mk-a"))) cfg)
                  b (tier/wrap (store/adapter (str (kio/temp-dir "mk-b"))) cfg)
                  wrong (tier/curl-transport (assoc base :token-file bad-token-file))]
              ((:put! a) cid data)
              (is (empty? @errors) "put! accepted by the tier")
              (is (tier/remote-known? cfg cid) "tier reports the object")
              (is (= 401 (:status (wrong {:method "GET" :path "/health"})))
                  "a wrong token is refused")
              (-> (poll-stored! cfg cid (+ (js/Date.now) (if calibration? 600000 60000)))
                  (.then (fn [_]
                           (let [got ((:get b) cid)]
                             (is (some? got) "cold read into an empty local store")
                             (when got
                               (is (= cid (mf/cidv1-raw got)) "bytes verify against the CID")
                               (is (= (.-length data) (alength got)) "same length"))
                             (is (empty? @errors) (str "no tier errors: " (pr-str @errors))))))))))
        (.finally (fn []
                    (some-> @sidecar (.kill))
                    (.rmSync fs tmp #js {:recursive true :force true}))))))

(deftest murakumo-to-filecoin-cas-round-trip
  (let [mode (aget js/process.env "MURAKUMO_FILECOIN_E2E")]
    (if (empty? mode)
      (println "SKIPPED murakumo.filecoin-tier-e2e-test (set MURAKUMO_FILECOIN_E2E=memory|calibration)")
      (async done
        (-> (run-e2e! (= "calibration" mode))
            (.catch (fn [e] (is (nil? e) (str "e2e failed: " (.-message e)))))
            (.finally done))))))
