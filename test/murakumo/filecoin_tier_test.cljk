(ns murakumo.filecoin-tier-test
  (:require [kotoba.io :as kio]
            [kotoba.test :refer [deftest is]]
            [bonsai.object :as object]
            [bonsai.repo :as repo]
            [murakumo.artifact-store :as store]
            [murakumo.filecoin-tier :as tier]))

(defn- cid-of [bytes] (second (object/write-blob (repo/empty-repo) bytes)))
(defn- text [bytes] (when bytes (String. ^bytes bytes)))

(defn- fake-tier
  "A transport standing in for the filecoin-cas service. `objects` is an atom
  cid -> bytes; `calls` records requests; `mode` :ok | :down | :corrupt."
  [objects mode]
  (let [calls (atom [])]
    {:calls calls
     :transport
     (fn [{:keys [method path body] :as req}]
       (swap! calls conj (select-keys req [:method :path]))
       (if (= :down mode)
         {:status 0 :error "connection refused"}
         (let [[_ kind cid] (re-matches #"/(obj|status)/(.+)" path)]
           (cond
             (and (= "PUT" method) (= "obj" kind))
             (do (swap! objects assoc cid body) {:status 202})
             (and (= "GET" method) (= "obj" kind))
             (if-let [b (get @objects cid)]
               {:status 200 :body (if (= :corrupt mode) (.getBytes "tampered") b)}
               {:status 404})
             (and (= "GET" method) (= "status" kind))
             {:status (if (contains? @objects cid) 200 404)}
             :else {:status 400}))))}))

(defn- new-local [] (store/adapter (str (kio/temp-dir "murakumo-tier"))))

(deftest wrap-is-identity-without-config
  (let [local (new-local)]
    (is (identical? local (tier/wrap local nil)))
    (is (nil? (tier/config-from-env (constantly nil))))
    (is (nil? (tier/config-from-env (constantly ""))))))

(deftest endpoint-must-be-https-or-loopback
  (is (= "http://127.0.0.1:8788" (tier/endpoint! "http://127.0.0.1:8788/")))
  (is (= "http://localhost:9" (tier/endpoint! "http://localhost:9")))
  (is (= "https://cas.example.org" (tier/endpoint! "https://cas.example.org")))
  (is (thrown? Throwable (tier/endpoint! "http://cas.example.org")))
  (is (thrown? Throwable (tier/endpoint! "http://127.0.0.1.evil.example.org")))
  (is (thrown? Throwable (tier/endpoint! "ftp://127.0.0.1"))))

(deftest curl-argv-keeps-the-token-off-the-command-line
  (let [argv (tier/curl-argv {:method "PUT" :url "http://127.0.0.1:8788/obj/bafx"
                              :header-file "/tmp/h" :out-file "/tmp/o" :timeout-s 9})]
    (is (= "curl" (first argv)))
    (is (some #{"@/tmp/h"} argv) "token read from a file")
    (is (some #{"--data-binary"} argv))
    (is (= "http://127.0.0.1:8788/obj/bafx" (last argv)))
    (is (not-any? #(re-find #"Bearer" %) argv)))
  (let [argv (tier/curl-argv {:method "GET" :url "http://127.0.0.1:1/x" :out-file "/tmp/o"})]
    (is (not-any? #{"--data-binary"} argv))
    (is (not-any? #{"-H"} argv))))

(deftest put-writes-locally-then-offers-to-the-tier
  (let [objects (atom {}) {:keys [transport calls]} (fake-tier objects :ok)
        cas (tier/wrap (new-local) {:transport transport})
        bytes (.getBytes "artifact") cid (cid-of bytes)]
    (is (= cid ((:put! cas) cid bytes)))
    (is (= "artifact" (text ((:get cas) cid))))
    (is (= "artifact" (text (get @objects cid))))
    (is (= [{:method "PUT" :path (str "/obj/" cid)}] @calls)
        "the local hit on get never reaches the tier")))

(deftest a-mismatched-put-throws-and-never-reaches-the-tier
  (let [objects (atom {}) {:keys [transport calls]} (fake-tier objects :ok)
        cas (tier/wrap (new-local) {:transport transport})
        cid (cid-of (.getBytes "real"))]
    (is (thrown? Throwable ((:put! cas) cid (.getBytes "fake"))))
    (is (empty? @calls))
    (is (empty? @objects))))

(deftest tier-outage-does-not-fail-put-and-is-reported
  (let [objects (atom {}) {:keys [transport]} (fake-tier objects :down)
        errors (atom [])
        cas (tier/wrap (new-local) {:transport transport :on-error #(swap! errors conj %)})
        bytes (.getBytes "kept locally") cid (cid-of bytes)]
    (is (= cid ((:put! cas) cid bytes)))
    (is (= "kept locally" (text ((:get cas) cid))))
    (is (= 1 (count @errors)))
    (is (= cid (:filecoin-put-failed (first @errors))))))

(deftest local-miss-falls-back-to-the-tier-and-caches-locally
  (let [bytes (.getBytes "cold object") cid (cid-of bytes)
        objects (atom {cid bytes}) {:keys [transport calls]} (fake-tier objects :ok)
        cas (tier/wrap (new-local) {:transport transport})]
    (is (= "cold object" (text ((:get cas) cid))))
    (is (= 1 (count @calls)))
    (is (= "cold object" (text ((:get cas) cid))) "now served locally")
    (is (= 1 (count @calls)) "no second remote read")))

(deftest unknown-and-unreachable-read-as-a-miss
  (let [cid (cid-of (.getBytes "nobody has this"))
        errors (atom [])
        up (tier/wrap (new-local) {:transport (:transport (fake-tier (atom {}) :ok))})
        down (tier/wrap (new-local) {:transport (:transport (fake-tier (atom {}) :down))
                                     :on-error #(swap! errors conj %)})]
    (is (nil? ((:get up) cid)))
    (is (nil? ((:get down) cid)))
    (is (= cid (:filecoin-get-failed (first @errors))))))

(deftest corrupt-tier-bytes-are-rejected-and-never-cached
  (let [bytes (.getBytes "genuine") cid (cid-of bytes)
        objects (atom {cid bytes}) errors (atom [])
        local (new-local)
        cas (tier/wrap local {:transport (:transport (fake-tier objects :corrupt))
                              :on-error #(swap! errors conj %)})]
    (is (nil? ((:get cas) cid)))
    (is (nil? ((:get local) cid)) "nothing was written locally")
    (is (= cid (:filecoin-get-rejected (first @errors))))))

(deftest backfill-sends-only-what-the-tier-lacks
  (let [root (str (kio/temp-dir "murakumo-backfill"))
        local (store/adapter root)
        a (.getBytes "already there") b (.getBytes "missing one")
        ca (cid-of a) cb (cid-of b)
        objects (atom {ca a}) {:keys [transport]} (fake-tier objects :ok)
        cfg {:transport transport}]
    ((:put! local) ca a)
    ((:put! local) cb b)
    (is (= #{ca cb} (set (tier/local-cids root))))
    (is (= {:sent 1 :skipped 1 :failed 0} (tier/backfill! cfg root (:get local))))
    (is (= "missing one" (text (get @objects cb))))
    (is (= {:sent 0 :skipped 2 :failed 0} (tier/backfill! cfg root (:get local))))))
