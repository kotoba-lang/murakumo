(ns murakumo.web-provision-test
  (:require [kotoba.test :refer [deftest is]]
            [murakumo.web.provision :as p]))

(def good {"yataverse.url" "https://kotobase.net"
           "yataverse.authn.edn" "{:tenant-id \"t_abc123\" :storage \"blocks\"}"
           "yataverse.sa-token" "kb_sa_0123abcXYZ"})

(deftest a-valid-set-is-accepted-and-trimmed
  (is (= good (:ok (p/validate-files (assoc good "yataverse.url" "  https://kotobase.net\n")))))
  (is (:ok (p/validate-files {"yataverse.auth-cmd" "[\"/usr/local/bin/mint\" \"--aud\" \"x\"]"})))
  (is (:ok (p/validate-files {"backends.edn" "[{:kind :wikipedia :name :wp}]"}))))

(deftest only-the-named-files-can-be-written
  (doseq [k ["../node.key" "node.key" "store/x" "yataverse.url/../../x" "/etc/passwd" "bundle/web_node.cljs" ""]]
    (is (= {k :file/not-allowed} (:refused (p/validate-files {k "https://kotobase.net"}))) k)))

(deftest values-must-have-the-right-shape
  (is (= :yataverse.url/not-https-origin (get-in (p/validate-files {"yataverse.url" "http://kotobase.net"}) [:refused "yataverse.url"])))
  (is (= :yataverse.url/not-https-origin (get-in (p/validate-files {"yataverse.url" "https://a.example/x"}) [:refused "yataverse.url"])))
  (is (= :yataverse.sa-token/bad-shape (get-in (p/validate-files {"yataverse.sa-token" "not-a-secret"}) [:refused "yataverse.sa-token"])))
  (is (= :yataverse.authn.edn/no-tenant-id (get-in (p/validate-files {"yataverse.authn.edn" "{:storage \"x\"}"}) [:refused "yataverse.authn.edn"])))
  (is (= :yataverse.auth-cmd/not-an-argv-vector (get-in (p/validate-files {"yataverse.auth-cmd" "rm -rf /"}) [:refused "yataverse.auth-cmd"])))
  (is (= :yataverse.prefix/bad (get-in (p/validate-files {"yataverse.prefix" "/../"}) [:refused "yataverse.prefix"]))))

(deftest sizes-and-control-characters-are-refused
  (is (= :file/too-large (get-in (p/validate-files {"backends.edn" (apply str (repeat 5000 "a"))}) [:refused "backends.edn"])))
  (is (= :file/control-characters (get-in (p/validate-files {"backends.edn" "a\u0000b"}) [:refused "backends.edn"])))
  (is (= :file/empty (get-in (p/validate-files {"zone.edn" "   "}) [:refused "zone.edn"])))
  (is (= :file/not-a-string (get-in (p/validate-files {"zone.edn" 42}) [:refused "zone.edn"])))
  (is (= {"*" :files/none} (:refused (p/validate-files {})))))

(deftest refusals-never-contain-the-value
  (let [secret "kb_sa_TOPSECRETVALUE"
        r (p/validate-files {"yataverse.sa-token" (str secret "\u0000")})]
    (is (not (re-find #"TOPSECRET" (pr-str r))))
    (let [r2 (p/validate-files {"yataverse.authn.edn" (str "{:storage \"" secret "\"}")})]
      (is (not (re-find #"TOPSECRET" (pr-str r2)))))))

(deftest put-configured-needs-a-url-and-one-authorization-source
  (is (true? (p/put-configured? ["yataverse.url" "yataverse.authn.edn" "yataverse.sa-token"])))
  (is (true? (p/put-configured? ["yataverse.url" "yataverse.auth-cmd"])))
  (is (false? (p/put-configured? ["yataverse.url"])))
  (is (false? (p/put-configured? ["yataverse.url" "yataverse.authn.edn"])))
  (is (false? (p/put-configured? ["yataverse.sa-token" "yataverse.authn.edn"]))))
